<view wx:if="{{visible}}" class="image-editor" style="{{chromeStyle}}" catchtouchmove="holdOverlay">
  <view class="image-editor-header"><button class="image-editor-button image-editor-cancel {{busy ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" bindtap="cancel" disabled="{{busy}}" aria-label="{{activeTool ? '放弃尚未应用的调整并返回图片总览' : '取消图片编辑'}}">取消</button><text class="image-editor-title">{{activeTool === 'filters' ? '滤镜' : activeTool === 'adjust' ? '调节' : activeTool === 'text' ? '文字' : activeTool === 'sticker' ? '贴纸' : '编辑图片'}}</text></view>
  <view class="image-editor-preview">
    <image wx:if="{{files.length}}" class="image-editor-image" src="{{files[selected].path}}" mode="aspectFit" data-path="{{files[selected].path}}" data-generation="{{generation}}" binderror="imagePreviewFailed" aria-label="第{{selected + 1}}张图片预览"/>
    <text wx:else class="image-editor-empty">图片已移除，请返回重新选择</text>
  </view>
  <scroll-view class="image-editor-lower {{activeTool || effectDirty || error ? 'image-editor-lower--expanded' : ''}}" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" aria-label="图片编辑工具，可上下滑动">
    <view class="image-editor-lower-content">
    <scroll-view wx:if="{{!activeTool}}" class="image-editor-strip" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" aria-label="已选图片，横向滑动查看">
      <view class="image-editor-thumbnails"><button wx:for="{{files}}" wx:key="path" class="image-editor-button image-editor-thumbnail {{selected === index ? 'image-editor-thumbnail--selected' : ''}} {{busy || effectDirty ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" data-index="{{index}}" bindtap="selectImage" disabled="{{busy || effectDirty}}" aria-label="选择第{{index + 1}}张图片{{index === 0 && files.length > 1 ? (additional ? '，本批首图，仅调整新选图片顺序' : '，首图') : ''}}" aria-pressed="{{selected === index}}"><image src="{{item.path}}" mode="aspectFill"/><text wx:if="{{index === 0 && files.length > 1}}" class="image-editor-cover">{{additional ? '本批首图' : '首图'}}</text></button></view>
    </scroll-view>
    <scroll-view wx:if="{{files.length}}" class="image-editor-tool-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="image-editor-tools">
        <button wx:if="{{canEdit}}" class="image-editor-button image-editor-tool {{busy || effectDirty ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" bindtap="editImage" disabled="{{busy || effectDirty}}">编辑</button><button wx:if="{{canCrop}}" class="image-editor-button image-editor-tool {{busy || effectDirty ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" bindtap="cropImage" disabled="{{busy || effectDirty}}">方形裁剪</button>
        <block wx:if="{{canCanvas}}"><button class="image-editor-button image-editor-tool {{activeTool === 'filters' ? 'image-editor-tool--active' : ''}} {{busy ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" data-tool="filters" bindtap="toggleTool" disabled="{{busy}}">滤镜</button><button class="image-editor-button image-editor-tool {{activeTool === 'adjust' ? 'image-editor-tool--active' : ''}} {{busy ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" data-tool="adjust" bindtap="toggleTool" disabled="{{busy}}">调节</button><button class="image-editor-button image-editor-tool {{activeTool === 'text' ? 'image-editor-tool--active' : ''}} {{busy ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" data-tool="text" bindtap="toggleTool" disabled="{{busy}}">文字</button><button class="image-editor-button image-editor-tool {{activeTool === 'sticker' ? 'image-editor-tool--active' : ''}} {{busy ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" data-tool="sticker" bindtap="toggleTool" disabled="{{busy}}">贴纸</button></block>
        <button wx:if="{{files.length > 1}}" class="image-editor-button image-editor-tool {{busy || effectDirty || selected === 0 ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" bindtap="setCover" disabled="{{busy || effectDirty || selected === 0}}" aria-label="{{additional ? '设为本批首图，仅调整新选图片顺序' : '设为投稿首图'}}">{{additional ? '本批首图' : '设为首图'}}</button><button class="image-editor-button image-editor-tool {{busy || effectDirty ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" bindtap="removeImage" disabled="{{busy || effectDirty}}">移除</button>
      </view>
    </scroll-view>
    <view wx:if="{{files.length && activeTool && canCanvas}}" class="image-editor-panel">
      <view wx:if="{{activeTool === 'filters'}}" class="image-editor-options"><button wx:for="{{filters}}" wx:key="value" class="image-editor-button image-editor-option {{filter === item.value ? 'image-editor-option--selected' : ''}} {{busy ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" data-value="{{item.value}}" bindtap="changeFilter" disabled="{{busy}}" aria-pressed="{{filter === item.value}}">{{item.label}}</button></view>
      <view wx:elif="{{activeTool === 'adjust'}}" class="image-editor-adjustments">
        <view class="image-editor-slider"><text>亮度</text><slider min="-100" max="100" step="1" value="{{brightness}}" data-field="brightness" bindchange="changeAdjustment" disabled="{{busy}}" activeColor="#d8c5e4" backgroundColor="#454047" block-size="20" aria-label="亮度"/><text>{{brightness}}</text></view>
        <view class="image-editor-slider"><text>对比</text><slider min="-100" max="100" step="1" value="{{contrast}}" data-field="contrast" bindchange="changeAdjustment" disabled="{{busy}}" activeColor="#d8c5e4" backgroundColor="#454047" block-size="20" aria-label="对比度"/><text>{{contrast}}</text></view>
        <view class="image-editor-slider"><text>饱和</text><slider min="-100" max="100" step="1" value="{{saturation}}" data-field="saturation" bindchange="changeAdjustment" disabled="{{busy}}" activeColor="#d8c5e4" backgroundColor="#454047" block-size="20" aria-label="饱和度"/><text>{{saturation}}</text></view>
      </view>
      <block wx:elif="{{activeTool === 'text'}}"><input class="image-editor-text-input" value="{{overlayText}}" bindinput="changeOverlayText" placeholder="添加文字，最多30字" placeholder-style="color:#a79daa" disabled="{{busy}}" maxlength="-1" adjust-position="{{true}}" cursor-spacing="20" aria-label="图片文字，最多30字"/><view class="image-editor-options image-editor-colors"><button wx:for="{{colors}}" wx:key="*this" class="image-editor-button image-editor-color {{overlayColor === item ? 'image-editor-color--selected' : ''}} {{busy ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" style="--swatch:{{item}}" data-value="{{item}}" bindtap="changeOverlayColor" disabled="{{busy}}" aria-label="{{index === 0 ? '白色文字' : index === 1 ? '深色文字' : '紫色文字'}}" aria-pressed="{{overlayColor === item}}"><view/></button></view></block>
      <view wx:elif="{{activeTool === 'sticker'}}" class="image-editor-options"><button class="image-editor-button image-editor-option {{!sticker ? 'image-editor-option--selected' : ''}} {{busy ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" data-value="" bindtap="changeSticker" disabled="{{busy}}" aria-pressed="{{!sticker}}">无</button><button wx:for="{{stickers}}" wx:key="*this" class="image-editor-button image-editor-option image-editor-sticker {{sticker === item ? 'image-editor-option--selected' : ''}} {{busy ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" data-value="{{item}}" bindtap="changeSticker" disabled="{{busy}}" aria-label="{{item}}贴纸" aria-pressed="{{sticker === item}}">{{item}}</button></view>
      <view wx:if="{{activeTool === 'text' || activeTool === 'sticker'}}" class="image-editor-options image-editor-positions"><button wx:for="{{positions}}" wx:key="value" class="image-editor-button image-editor-option {{overlayPosition === item.value ? 'image-editor-option--selected' : ''}} {{busy ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" data-value="{{item.value}}" bindtap="changeOverlayPosition" disabled="{{busy}}" aria-pressed="{{overlayPosition === item.value}}">{{item.label}}</button></view>
    </view>
    <text wx:if="{{error}}" class="image-editor-error" aria-live="polite">{{error}}</text>
    </view>
  </scroll-view>
  <view class="image-editor-footer"><text wx:if="{{files.length > 1}}" class="image-editor-count" aria-label="第{{selected + 1}}张，共{{files.length}}张">{{selected + 1}} / {{files.length}}</text><button class="image-editor-button image-editor-next {{busy || !files.length ? 'image-editor-button--disabled' : ''}}" hover-class="image-editor-pressed" hover-stay-time="80" bindtap="confirm" disabled="{{busy || !files.length}}" loading="{{busy}}" aria-label="{{busy ? '正在处理图片' : activeTool ? '完成当前工具调整并返回图片总览' : '确认图片并进入内容编辑'}}">{{busy ? '处理中…' : activeTool ? '完成' : '下一步'}}</button></view>
  <canvas wx:if="{{canCanvas}}" type="2d" id="communityImageEffectCanvas" class="image-editor-canvas" aria-hidden="{{true}}"/>
</view>
