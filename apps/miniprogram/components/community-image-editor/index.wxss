.image-editor{position:fixed;z-index:160;top:0;right:0;bottom:0;left:0;display:flex;flex-direction:column;overflow:hidden;background:#101010;color:#fff;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
.image-editor-button{box-sizing:border-box;display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;margin:0;padding:0;border:0;border-radius:12px;background:transparent;color:#e9e5ec;font-family:inherit;font-weight:400;line-height:1.4;text-align:center}
.image-editor-button::after{border:0}.image-editor-pressed{opacity:.72}
.image-editor-header{position:relative;z-index:2;flex:none;display:flex;align-items:center;justify-content:center;box-sizing:border-box;height:var(--cisme-topbar-height,88px);padding:var(--cisme-status-bar,44px) var(--cisme-nav-side,106px) 0 64px}
.image-editor-title{font-size:16px;font-weight:500;white-space:nowrap}
.image-editor-cancel{position:absolute;left:10px;top:var(--cisme-back-top,44px);min-width:44px;min-height:44px;margin:0;padding:0 8px;border:0;background:transparent;color:#fff;font-size:15px}
.image-editor-preview{position:relative;z-index:0;display:flex;flex:1;align-items:center;justify-content:center;min-height:0;height:0;overflow:hidden}
.image-editor-image{width:100%;height:100%}.image-editor-empty{padding:24px;color:#bbb;font-size:14px;text-align:center;line-height:1.6}
.image-editor-lower{position:relative;z-index:1;flex:none;box-sizing:border-box;width:100%;height:156px;background:#181818}.image-editor-lower--expanded{height:40vh}.image-editor-lower-content{padding-top:16px;padding-bottom:8px}.image-editor-strip{box-sizing:border-box;width:100%;height:80px;white-space:nowrap}
.image-editor-thumbnails{display:inline-flex;gap:10px;padding:4px 20px}.image-editor-thumbnail{position:relative;flex:none;box-sizing:border-box;width:68px;height:68px;min-width:44px;min-height:44px;margin:0;padding:0;border:2px solid transparent;border-radius:10px;overflow:hidden;background:#292929;line-height:1}
.image-editor-thumbnail--selected{border-color:#d8c5e4}.image-editor-thumbnail image{display:block;width:100%;height:100%}.image-editor-cover{position:absolute;left:0;bottom:0;padding:3px 5px;border-radius:0 5px 0 0;background:rgba(0,0,0,.7);color:#fff;font-size:10px;line-height:1.2}
.image-editor-tool-scroll{box-sizing:border-box;width:100%;height:60px;white-space:nowrap}.image-editor-tools{display:inline-flex;gap:4px;padding:8px 14px}.image-editor-tool{flex:none;min-width:52px;min-height:44px;padding:8px 10px;background:transparent;color:#ddd;font-size:13px;line-height:1.4}.image-editor-tool--active{color:#eddef5;background:#302934}
.image-editor-panel{padding:2px 20px 0}.image-editor-options{display:flex;align-items:center;justify-content:center;gap:8px}.image-editor-option{display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:52px;min-height:44px;margin:0;padding:8px 12px;border:1px solid #4a434e;border-radius:12px;background:#242126;color:#ddd;font-size:13px;line-height:1.4}.image-editor-option--selected{border-color:#d8c5e4;color:#eddef5;background:#342b39}.image-editor-sticker{font-size:23px}
.image-editor-slider{display:flex;align-items:center;gap:10px;min-height:44px;color:#ddd;font-size:12px}.image-editor-slider slider{flex:1;min-width:0;margin:4px 0}.image-editor-slider>text:first-child{flex:none;width:28px}.image-editor-slider>text:last-child{flex:none;width:28px;text-align:right}
.image-editor-text-input{box-sizing:border-box;width:100%;min-height:44px;padding:10px 12px;border:1px solid #4a434e;border-radius:10px;color:#fff;background:#242126;font-size:15px;line-height:1.5}.image-editor-colors{margin:6px 0}.image-editor-color{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:44px;height:44px;margin:0;padding:8px;border:1px solid transparent;border-radius:50%;background:transparent}.image-editor-color view{width:24px;height:24px;border:1px solid #928898;border-radius:50%;background:var(--swatch)}.image-editor-color--selected{border-color:#d8c5e4}.image-editor-positions{margin-top:6px}
.image-editor-fixed-actions{position:relative;z-index:2;flex:none;padding:4px 20px 0;background:#181818}.image-editor-effect-actions{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:8px;margin-top:8px;padding:0 2px}.image-editor-effect-action{min-height:44px;padding:8px 10px;background:transparent;color:#b8adbe;font-size:12px}.image-editor-apply{min-width:72px;min-height:44px;padding:8px 16px;border:1px solid #756181;border-radius:22px;background:#302637;color:#eadcf2;font-size:13px}.image-editor-pending{display:block;padding:4px 2px 8px;color:#b8adbe;font-size:12px;line-height:1.4}.image-editor-canvas{position:absolute;top:0;left:-2000px;width:1px;height:1px;opacity:0;pointer-events:none}
.image-editor-error{display:block;padding:4px 20px 10px;color:#f2b6bb;font-size:13px;line-height:1.5;word-break:break-word}
.image-editor-footer{position:relative;z-index:2;flex:none;display:flex;align-items:center;justify-content:flex-end;gap:18px;padding:12px 20px calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 14px);background:#181818}.image-editor-count{flex:none;margin-right:auto;color:#b0a7b7;font-size:12px}
.image-editor-next{min-width:112px;min-height:46px;padding:12px 22px;border:0;border-radius:24px;background:#d8c5e4;color:#30213a;font-size:15px;line-height:1.4}
.image-editor-button--disabled{background:transparent!important;color:#83798c!important;box-shadow:none!important;opacity:1!important}
.image-editor-option.image-editor-button--disabled{border-color:#39333f!important;background:#211e25!important;color:#857b8d!important}.image-editor-option--selected.image-editor-button--disabled{border-color:#6a5876!important;background:#2c2433!important;color:#b5a3c0!important}
.image-editor-thumbnail.image-editor-button--disabled{background:#292929!important;opacity:.55!important}.image-editor-color.image-editor-button--disabled{opacity:.45!important}
.image-editor-apply.image-editor-button--disabled{border-color:#3a3340!important;background:#242027!important;color:#8d7c98!important}.image-editor-next.image-editor-button--disabled{background:#44364e!important;color:#ad99b8!important}
