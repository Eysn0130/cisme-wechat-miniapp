:host{display:block}.address-form{margin-top:10rpx}.address-form__head{display:flex;align-items:flex-start;justify-content:space-between;gap:22rpx;margin-top:18rpx}.address-form__head-copy{flex:1;min-width:0}.address-form__title,.address-form__meta,.quick-fill__title,.quick-fill__meta,.parse-state__summary,.parse-state__warning,.field-error,.field-help,.default-row__title,.default-row__meta,.conflict-state__title,.conflict-state__copy{display:block}.address-form__title{color:var(--cisme-ink,#352a3a);font-size:var(--cisme-text-action,16px);font-weight:600;line-height:1.4}.address-form__meta{margin-top:6rpx;color:var(--cisme-muted,#75697a);font-size:var(--cisme-text-small,12px);line-height:1.5}
button{box-sizing:border-box;margin:0;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif}button::after{border:0}.text-action,.utility-button,.label-option,.form-button{display:flex;align-items:center;justify-content:center;height:44px;min-width:44px;padding:0 12px;line-height:20px}.button-label,.text-action text,.utility-button text{display:block;line-height:20px;transform:translateY(-.25px)}.text-action{flex:none;padding:0 4px;border:0;color:var(--cisme-plum,#56306f);background:transparent;font-size:var(--cisme-text-small,12px)}.is-disabled{opacity:.45}.text-action:active,.utility-button:active,.label-option:active,.form-button:active{opacity:.78;transform:translateY(1px)}
.quick-fill{margin-top:24rpx;padding:24rpx;border:1rpx solid rgba(86,48,111,.1);border-radius:22rpx;background:var(--cisme-page,#f7f2f8)}.quick-fill__title{color:var(--cisme-ink,#352a3a);font-size:var(--cisme-text-body,14px);font-weight:600;line-height:1.4}.quick-fill__meta{margin-top:5rpx;color:var(--cisme-muted,#75697a);font-size:var(--cisme-text-small,12px);line-height:1.5}.quick-fill__input{box-sizing:border-box;width:100%;height:176rpx;min-height:176rpx;margin-top:18rpx;padding:18rpx 20rpx;border:1px solid var(--cisme-muted,#75697a);border-radius:var(--cisme-radius-control,16rpx);color:var(--cisme-ink,#352a3a);background:var(--cisme-card,#fff);font-size:var(--cisme-text-action,16px);line-height:1.55}.quick-fill__actions,.conflict-state__actions{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:14rpx}.utility-button{border:1rpx solid rgba(86,48,111,.16);border-radius:14rpx;color:var(--cisme-plum,#56306f);background:rgba(255,255,255,.82);font-size:var(--cisme-text-body,14px)}.utility-button--accent{border-color:rgba(86,48,111,.24);background:#eadff0}.parse-state{margin-top:14rpx;padding:16rpx 18rpx;border-radius:14rpx;color:var(--cisme-plum,#56306f);background:rgba(255,255,255,.7);font-size:var(--cisme-text-small,12px);line-height:1.55}.parse-state--failed{color:var(--cisme-danger,#9a3d55);background:#f8e8ed}.parse-state__warning{margin-top:5rpx;color:var(--cisme-muted,#75697a)}
.field-label{display:block;margin-top:24rpx;color:var(--cisme-ink,#352a3a);font-size:var(--cisme-text-body,14px);line-height:1.5}.field-input{box-sizing:border-box;width:100%;min-height:44px;margin-top:10rpx;padding:10px 12px;border:1px solid var(--cisme-muted,#75697a);border-radius:var(--cisme-radius-control,16rpx);color:var(--cisme-ink,#352a3a);background:var(--cisme-card,#fff);font-size:var(--cisme-text-action,16px);line-height:22px}.field-textarea{min-height:92px}.field-input--error{border-color:var(--cisme-danger,#9a3d55);background:#fff8fa}.field-error{margin-top:7rpx;color:var(--cisme-danger,#9a3d55);font-size:var(--cisme-text-small,12px);line-height:1.45}.field-help{margin-top:7rpx;color:var(--cisme-muted,#75697a);font-size:var(--cisme-text-small,12px);line-height:1.45}.picker-value{display:flex;align-items:center;justify-content:space-between;color:var(--cisme-ink,#352a3a)}.picker-value--empty{color:var(--cisme-muted,#75697a)}.picker-caret{flex:none;width:14px;height:14px;margin-left:12rpx}
.label-options{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:10rpx}.label-option{width:100%;border:1rpx solid rgba(86,48,111,.14);border-radius:14rpx;color:var(--cisme-muted,#75697a);background:#fbf9fb;font-size:var(--cisme-text-body,14px)}.label-option--selected{border-color:#6b4a79;color:#fff;background:#644675;box-shadow:inset 0 0 0 1rpx rgba(255,255,255,.18)}.default-row{display:flex;align-items:center;justify-content:space-between;gap:22rpx;margin-top:26rpx;padding-top:24rpx;border-top:1rpx solid rgba(78,47,91,.09)}.default-row__copy{flex:1;min-width:0}.default-row__title{color:var(--cisme-ink,#352a3a);font-size:var(--cisme-text-action,16px);font-weight:500;line-height:1.4}.default-row__meta{margin-top:5rpx;color:var(--cisme-muted,#75697a);font-size:var(--cisme-text-small,12px);line-height:1.45}.default-row switch{flex:none}
.conflict-state{margin-top:22rpx;padding:20rpx;border:1rpx solid rgba(153,74,103,.2);border-radius:18rpx;background:#f8e8ed}.conflict-state__title{color:var(--cisme-danger,#9a3d55);font-size:var(--cisme-text-body,14px);font-weight:600}.conflict-state__copy{margin-top:6rpx;color:var(--cisme-danger,#9a3d55);font-size:var(--cisme-text-small,12px);line-height:1.5}.form-actions{display:grid;grid-template-columns:1fr 1.5fr;gap:14rpx;margin-top:28rpx}.safe-actions{padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 4px)}.form-button{width:100%;border-radius:22px;font-size:var(--cisme-text-action,16px);font-weight:500}.form-button--secondary{border:1rpx solid rgba(86,48,111,.16);color:var(--cisme-plum,#56306f);background:#f1eaf4}.form-button--primary{border:0;color:#fff;background:linear-gradient(135deg,#6f4a7e,#4f2d67);box-shadow:0 9rpx 20rpx rgba(74,43,88,.2)}

.field-placeholder{color:var(--cisme-muted,#75697a)}
