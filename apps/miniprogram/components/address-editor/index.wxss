:host{display:block}.address-form{margin-top:10rpx}.address-form__head{display:flex;align-items:flex-start;justify-content:space-between;gap:22rpx;margin-top:18rpx}.address-form__head-copy{flex:1;min-width:0}.address-form__title,.address-form__meta,.quick-fill__title,.quick-fill__meta,.parse-state__summary,.parse-state__warning,.field-error,.field-help,.default-row__title,.default-row__meta,.conflict-state__title,.conflict-state__copy{display:block}.address-form__title{color:#403545;font-size:27rpx;font-weight:600;line-height:1.4}.address-form__meta{margin-top:6rpx;color:#817687;font-size:22rpx;line-height:1.5}
button{box-sizing:border-box;margin:0;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif}button::after{border:0}.text-action,.utility-button,.label-option,.form-button{display:flex;align-items:center;justify-content:center;height:44px;min-width:44px;padding:0 12px;line-height:20px}.button-label,.text-action text,.utility-button text{display:block;line-height:20px;transform:translateY(-.25px)}.text-action{flex:none;padding:0 4px;border:0;color:#694577;background:transparent;font-size:12px}.is-disabled{opacity:.45}.text-action:active,.utility-button:active,.label-option:active,.form-button:active{opacity:.78;transform:translateY(1px)}
.quick-fill{margin-top:24rpx;padding:24rpx;border:1rpx solid rgba(86,48,111,.1);border-radius:22rpx;background:linear-gradient(145deg,rgba(248,243,250,.95),rgba(239,230,244,.78))}.quick-fill__title{color:#493851;font-size:26rpx;font-weight:600;line-height:1.4}.quick-fill__meta{margin-top:5rpx;color:#847788;font-size:22rpx;line-height:1.5}.quick-fill__input{box-sizing:border-box;width:100%;height:176rpx;min-height:176rpx;margin-top:18rpx;padding:18rpx 20rpx;border:1rpx solid rgba(86,48,111,.14);border-radius:16rpx;color:#352d39;background:rgba(255,255,255,.8);font-size:27rpx;line-height:1.55}.quick-fill__actions,.conflict-state__actions{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:14rpx}.utility-button{border:1rpx solid rgba(86,48,111,.16);border-radius:14rpx;color:#60416d;background:rgba(255,255,255,.82);font-size:24rpx}.utility-button--accent{border-color:rgba(86,48,111,.24);background:#eadff0}.parse-state{margin-top:14rpx;padding:16rpx 18rpx;border-radius:14rpx;color:#624d6a;background:rgba(255,255,255,.7);font-size:22rpx;line-height:1.55}.parse-state--failed{color:#8d3150;background:#f8e8ed}.parse-state__warning{margin-top:5rpx;color:#806d85}
.field-label{display:block;margin-top:24rpx;color:#5e5263;font-size:25rpx;line-height:1.5}.field-input{box-sizing:border-box;width:100%;min-height:44px;margin-top:10rpx;padding:10px 12px;border:1rpx solid rgba(86,48,111,.14);border-radius:16rpx;color:#352d39;background:#fbf9fb;font-size:27rpx;line-height:22px}.field-textarea{min-height:92px}.field-input--error{border-color:#a95d77;background:#fff8fa}.field-error{margin-top:7rpx;color:#994a67;font-size:22rpx;line-height:1.45}.field-help{margin-top:7rpx;color:#795e84;font-size:22rpx;line-height:1.45}.picker-value{display:flex;align-items:center;justify-content:space-between;color:#403545}.picker-value--empty{color:#9a919e}.picker-caret{flex:none;margin-left:12rpx;color:#8e7897;font-size:36rpx;line-height:1}
.label-options{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:10rpx}.label-option{width:100%;border:1rpx solid rgba(86,48,111,.14);border-radius:14rpx;color:#6f6474;background:#fbf9fb;font-size:24rpx}.label-option--selected{border-color:#6b4a79;color:#fff;background:#644675;box-shadow:inset 0 0 0 1rpx rgba(255,255,255,.18)}.default-row{display:flex;align-items:center;justify-content:space-between;gap:22rpx;margin-top:26rpx;padding-top:24rpx;border-top:1rpx solid rgba(78,47,91,.09)}.default-row__copy{flex:1;min-width:0}.default-row__title{color:#403545;font-size:27rpx;font-weight:500;line-height:1.4}.default-row__meta{margin-top:5rpx;color:#817687;font-size:23rpx;line-height:1.45}.default-row switch{flex:none}
.conflict-state{margin-top:22rpx;padding:20rpx;border:1rpx solid rgba(153,74,103,.2);border-radius:18rpx;background:#f8e8ed}.conflict-state__title{color:#7f3451;font-size:25rpx;font-weight:600}.conflict-state__copy{margin-top:6rpx;color:#8b6070;font-size:22rpx;line-height:1.5}.form-actions{display:grid;grid-template-columns:1fr 1.5fr;gap:14rpx;margin-top:28rpx}.safe-actions{padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 4px)}.form-button{width:100%;border-radius:22px;font-size:16px;font-weight:500}.form-button--secondary{border:1rpx solid rgba(86,48,111,.16);color:#563d64;background:#f1eaf4}.form-button--primary{border:0;color:#fff;background:linear-gradient(135deg,#6f4a7e,#4f2d67);box-shadow:0 9rpx 20rpx rgba(74,43,88,.2)}
