    <view class="section-headline"><view class="section-title">收货地址</view><button class="text-button {{busy||navigating||addressReadOnly?'text-button--disabled':''}}" bindtap="editAddresses" disabled="{{busy||navigating||addressReadOnly}}">管理地址</button></view>
    <view wx:if="{{addresses.length}}" class="address-options"><button wx:for="{{addresses}}" wx:key="id" data-id="{{item.id}}" bindtap="selectAddress" disabled="{{busy||loading||syncError||navigating||addressReadOnly}}" class="address-option {{selectedAddressId===item.id?'address-option--active':''}} {{busy||loading||syncError||navigating||addressReadOnly?'control--disabled':''}}"><view><text class="coupon-heading">{{item.recipientName}} · {{item.phone}}</text><text>{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</text></view><text>{{selectedAddressId===item.id?'已选择':''}}</text></button></view><view wx:else class="state">{{addressEmptyCopy || '添加收货地址后即可下单。'}}</view>
