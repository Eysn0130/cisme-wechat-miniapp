.credit-moment{position:fixed;inset:0;z-index:1600;display:flex;align-items:center;justify-content:center;pointer-events:none;color:#422652;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;animation:credit-presence 160ms ease-out both;}
.credit-moment__shade{position:absolute;inset:0;background:rgba(42,24,53,.23);}
.credit-moment__card{position:relative;box-sizing:border-box;width:292px;max-width:calc(100% - 64px);padding:24px;overflow:hidden;border-radius:26px;text-align:center;background:#fbf4ff;box-shadow:0 20px 54px rgba(46,25,64,.23);animation:credit-arrive 320ms cubic-bezier(.16,1,.3,1) both;}
.credit-moment__silk{position:absolute;inset:0;width:100%;height:100%;opacity:.22;}.credit-moment__light{position:absolute;inset:-35%;background:radial-gradient(ellipse at 18% 30%,rgba(198,226,223,.5),transparent 45%),radial-gradient(ellipse at 90% 60%,rgba(215,179,230,.53),transparent 55%),linear-gradient(115deg,transparent 37%,rgba(255,245,213,.68) 49%,transparent 61%);animation:credit-lustre 900ms 180ms cubic-bezier(.16,1,.3,1) both;}
.credit-moment__seal{position:relative;width:92px;height:92px;margin:0 auto 14px;perspective:650px;}.credit-moment__opal{width:92px;height:92px;}.credit-moment--spinning .credit-moment__opal{animation:credit-spin 620ms cubic-bezier(.15,.5,.2,1) both;}.credit-moment__check{position:absolute;left:32px;top:32px;width:28px;height:28px;animation:credit-check 170ms cubic-bezier(.16,1,.3,1) both;}
.credit-moment__title,.credit-moment__status{position:relative;display:block;font-size:18px;line-height:1.5;font-weight:500;}.credit-moment__credit{position:relative;display:flex;align-items:baseline;justify-content:center;gap:4px;margin:10px 0 4px;font-variant-numeric:lining-nums tabular-nums;}
.credit-moment__plus{font-size:30px;font-weight:400;}.credit-moment__number{min-width:1ch;font-size:64px;font-weight:600;letter-spacing:-1.5px;line-height:1.05;text-align:right;}.credit-moment__number--final{display:none;}.credit-moment__status{color:#70527e;font-size:14px;}.credit-moment__credit--compact .credit-moment__number{font-size:48px;}.credit-moment__credit--compact .credit-moment__plus{font-size:22px;}
.credit-moment__glints{position:absolute;top:72px;left:50%;width:0;height:0;}.credit-moment__glint{position:absolute;width:2px;height:7px;border-radius:2px;background:#ac89bc;opacity:0;animation:credit-glint 620ms 600ms ease-out both;--credit-x:65px;--credit-y:-35px;--credit-rotation:30deg;}.credit-moment__glint--1{--credit-x:78px;--credit-y:21px;--credit-rotation:70deg;background:#bc9b65;}.credit-moment__glint--2{--credit-x:-63px;--credit-y:-34px;--credit-rotation:-25deg;background:#bc9b65;}.credit-moment__glint--3{--credit-x:-76px;--credit-y:22px;--credit-rotation:-70deg;background:#6f9b98;}
.credit-moment--leaving{animation:credit-leave 200ms ease-in both;}
@keyframes credit-presence{from{opacity:0;}to{opacity:1;}}@keyframes credit-arrive{from{transform:scale(.96);opacity:.6;}to{transform:scale(1);opacity:1;}}@keyframes credit-lustre{from{transform:translateX(-24%) rotate(-8deg);}to{transform:translateX(16%) rotate(4deg);}}
@keyframes credit-spin{0%{transform:rotateY(0deg) rotate(-10deg);}70%{transform:rotateY(685deg) rotate(2deg);}100%{transform:rotateY(720deg) rotate(0deg);}}@keyframes credit-check{from{opacity:0;transform:scale(.6);clip-path:inset(0 100% 0 0);}to{opacity:1;transform:scale(1);clip-path:inset(0 0 0 0);}}
@keyframes credit-glint{0%{transform:translate(0,0) scale(.4);opacity:0;}22%{opacity:.85;}100%{transform:translate(var(--credit-x),var(--credit-y)) rotate(var(--credit-rotation));opacity:0;}}@keyframes credit-leave{from{opacity:1;}to{opacity:0;}}
.credit-moment--reduced,.credit-moment--reduced .credit-moment__card,.credit-moment--reduced .credit-moment__light,.credit-moment--reduced .credit-moment__opal,.credit-moment--reduced .credit-moment__check{animation:none;}.credit-moment--reduced .credit-moment__glints{display:none;}
@media(prefers-reduced-motion:reduce){.credit-moment,.credit-moment__card,.credit-moment__light,.credit-moment__opal,.credit-moment__check{animation:none;}.credit-moment__glints,.credit-moment__number--counted{display:none;}.credit-moment__number--final{display:block;}}
