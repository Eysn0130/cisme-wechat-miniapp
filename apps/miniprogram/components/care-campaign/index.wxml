<view id="campaign-frame" class="campaign {{reducedMotion ? 'campaign--reduced' : ''}}" aria-label="爱格荣品牌与产品">
  <swiper class="campaign__swiper" current="{{current}}" autoplay="{{false}}" circular="{{true}}" duration="{{duration}}" easing-function="easeInOutCubic" bindchange="changed" bindanimationfinish="animationFinished" bindtouchstart="touchStart" bindtouchend="touchEnd" bindtouchcancel="touchCancel">
    <swiper-item wx:for="{{slides}}" wx:key="id" aria-hidden="{{index !== current}}">
      <view class="campaign__slide" data-index="{{index}}" bindtap="activate" aria-role="button" aria-label="{{item.heading}}{{item.price ? '，' + item.price : ''}}，{{item.action}}">
        <image wx:if="{{item.requested && !item.imageFailed}}" class="campaign__photo {{item.imageLoaded ? 'campaign__photo--ready' : ''}}" src="{{item.image}}" mode="aspectFill" data-index="{{index}}" data-key="{{item.imageKey}}" data-attempt="{{item.imageAttempt}}" bindload="imageLoaded" binderror="imageFailed" aria-hidden="true"/>
        <image wx:if="{{item.imageFailed}}" class="campaign__fallback" src="/assets/icons/spray-bottle-plum.svg" mode="aspectFit" aria-hidden="true"/>
        <view class="campaign__copy">
          <image class="campaign__brand" src="/assets/commerce/aigerong-wordmark-v1.png" mode="aspectFit" aria-hidden="true"/>
          <view class="campaign__headline"><text>{{item.heading}}</text><text wx:if="{{item.price}}" class="campaign__price">{{item.price}}</text></view>
          <view class="campaign__action"><text>{{item.action}}</text><image src="/assets/icons/caret-right-muted.svg" mode="aspectFit" aria-hidden="true"/></view>
        </view>
      </view>
      <button wx:if="{{item.imageFailed && index === current}}" class="campaign__retry" data-index="{{index}}" catchtap="retryImage" disabled="{{suspended}}">重试图片</button>
    </swiper-item>
  </swiper>
  <view class="campaign__controls">
    <view class="campaign__indicators" aria-hidden="true"><view wx:for="{{slides}}" wx:key="id" class="campaign__dot {{index === current ? 'campaign__dot--active' : ''}}"/></view>
    <button wx:if="{{!reducedMotion}}" class="campaign__pause" catchtap="togglePause" disabled="{{suspended}}" aria-label="{{paused ? '恢复自动轮播' : '暂停自动轮播'}}"><image src="{{paused ? '/assets/icons/play-plum.svg' : '/assets/icons/pause-plum.svg'}}" mode="aspectFit" aria-hidden="true"/></button>
  </view>
</view>
