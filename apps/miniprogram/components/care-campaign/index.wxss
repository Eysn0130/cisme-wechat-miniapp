:host{display:block}
.campaign{position:relative;height:var(--cisme-campaign-height,62vw);min-height:180px;max-height:268px;overflow:hidden;background:#fff;border-bottom-left-radius:50% 22px;border-bottom-right-radius:50% 22px}
.campaign__swiper,.campaign__slide{width:100%;height:100%}.campaign__slide{position:relative;background:#fff}
.campaign__photo{position:absolute;inset:0;width:100%;height:100%;opacity:0;transition:opacity 180ms ease-out}.campaign__photo--ready{opacity:1}
.campaign__copy{position:absolute;z-index:1;top:12%;bottom:23%;left:7%;display:flex;flex-direction:column;justify-content:center;width:44%;color:#30243b;text-align:left}
.campaign__brand{display:block;flex:none;width:100%;height:22px;margin-bottom:18px;object-position:left center}
.campaign__headline{font-size:1.3125rem;font-weight:400;line-height:1.4;overflow-wrap:break-word}.campaign__price{display:inline-block;margin-left:6px;font-variant-numeric:lining-nums tabular-nums;white-space:nowrap}
.campaign__action{display:flex;align-items:center;gap:5px;min-height:44px;margin-top:12px;color:#56306f;font-size:.9375rem;line-height:1.4}.campaign__action image{flex:none;width:14px;height:14px}
.campaign__controls{position:absolute;z-index:2;bottom:22px;left:7%;display:flex;align-items:center;gap:8px;height:44px}
.campaign__indicators{display:flex;align-items:center;gap:8px;height:44px}.campaign__dot{width:5px;height:5px;border-radius:50%;background:#cec7d2}.campaign__dot--active{background:#654080}
.campaign__pause{display:flex;align-items:center;justify-content:center;flex:none;width:44px;height:44px;margin:0;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none}.campaign__pause::after{border:0}.campaign__pause image{width:13px;height:13px;opacity:.7}
.campaign__fallback{position:absolute;right:13%;top:26%;width:68px;height:96px;opacity:.18}.campaign__retry{position:absolute;z-index:3;right:8%;bottom:24px;min-height:44px;margin:0;padding:0 6px;border:0;border-radius:0;color:#684c7a;background:transparent;box-shadow:none;font-size:.75rem}.campaign__retry::after{border:0}
.campaign--reduced .campaign__photo{transition:none}
@media(min-height:880px) and (max-width:600px){.campaign{max-height:none;border-bottom-left-radius:50% 26px;border-bottom-right-radius:50% 26px}.campaign__copy{width:46%}.campaign__brand{margin-bottom:20px}.campaign__headline{font-size:1.5rem}.campaign__action{font-size:1rem}}
@media(max-height:740px){.campaign{height:48vw;min-height:150px;max-height:186px}.campaign__brand{height:18px;margin-bottom:12px}.campaign__headline{font-size:1.125rem}.campaign__action{margin-top:4px;font-size:.8125rem}.campaign__controls{bottom:8px}.campaign__copy{top:5%;bottom:23%}}
@media(max-height:600px){.campaign{height:41vw;min-height:128px;max-height:150px}.campaign__brand{height:15px;margin-bottom:6px}.campaign__headline{font-size:1rem}.campaign__action{font-size:.75rem;min-height:36px}.campaign__controls{bottom:2px}.campaign__copy{bottom:25%}}
@media(prefers-reduced-motion:reduce){.campaign__photo{transition:none}}
