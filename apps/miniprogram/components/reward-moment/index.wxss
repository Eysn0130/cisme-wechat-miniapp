.reward-moment{position:fixed;inset:0;z-index:1500;display:flex;align-items:center;justify-content:center;color:#f8f0e8;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;}
.reward-moment__shade{position:absolute;inset:0;background:rgba(29,19,36,.44);animation:ticket-shade 180ms ease-out both;}
.reward-moment__card{position:relative;display:flex;flex-direction:column;box-sizing:border-box;width:690rpx;max-width:calc(100% - 48rpx);height:1230rpx;max-height:calc(100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 40px);overflow:hidden;border-radius:28rpx;filter:drop-shadow(0 22rpx 28rpx rgba(34,16,42,.3));animation:ticket-arrive 520ms cubic-bezier(.16,1,.3,1) both;}
.reward-moment__surface{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;}.reward-moment__sheen{position:absolute;inset:0;pointer-events:none;background:linear-gradient(114deg,transparent 36%,rgba(240,224,251,.14) 48%,rgba(255,255,255,.26) 50%,transparent 63%);transform:translateX(120%);animation:ticket-light 900ms 100ms cubic-bezier(.16,1,.3,1) both;}
.reward-moment__scroll{position:relative;flex:1;min-height:0;height:0;}.reward-moment__content{box-sizing:border-box;padding:50rpx 34rpx 24rpx;text-align:center;}.reward-moment__brand{display:block;margin-left:.28em;margin-bottom:102rpx;font-family:Georgia,"Songti SC",serif;font-size:40rpx;line-height:1.4;letter-spacing:.28em;color:#ede2ef;}
.reward-moment__title{display:block;font-family:"Songti SC","Noto Serif CJK SC",serif;font-size:64rpx;font-weight:600;line-height:1.3;letter-spacing:.025em;}.reward-moment__copy{display:block;margin-top:18rpx;color:#f1e4ec;font-size:30rpx;line-height:1.5;letter-spacing:.035em;}
.reward-moment__products{position:relative;height:390rpx;overflow:hidden;margin:26rpx -12rpx 12rpx;animation:ticket-products 650ms 100ms cubic-bezier(.16,1,.3,1) both;}.reward-moment__bottles{display:block;width:100%;height:100%;}.reward-moment__labels{display:flex;justify-content:space-between;gap:24rpx;text-align:center;}.reward-moment__labels view{flex:1;min-width:0;}.reward-moment__set{display:block;font-family:"Songti SC",serif;font-size:32rpx;line-height:1.4;}.reward-moment__spec{display:block;margin-top:6rpx;font-size:25rpx;line-height:1.4;font-variant-numeric:tabular-nums;letter-spacing:.02em;color:#f1e4ec;}
.reward-moment__footer{position:relative;flex-shrink:0;padding:20rpx 38rpx 52rpx;}.reward-moment__terms{display:flex;align-items:center;justify-content:center;gap:20rpx;margin-bottom:18rpx;padding-top:14rpx;border-top:1rpx dashed rgba(235,218,241,.45);font-size:26rpx;line-height:1.5;letter-spacing:.08em;color:#eee0ef;}
.reward-moment__primary,.reward-moment__later{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;margin:0;padding:18rpx 24rpx;border:0;font-size:34rpx;line-height:1.35;}.reward-moment__primary{min-height:96rpx;border-radius:22rpx;color:#43274f;background:#f1e6f0;box-shadow:0 5rpx 16rpx rgba(24,10,34,.13);font-weight:600;}.reward-moment__primary--pressed{background:#e4d4e5;transform:scale(.985);}.reward-moment__later{min-height:86rpx;margin-top:8rpx;background:transparent;color:#f2e8f0;font-weight:400;font-size:30rpx;}.reward-moment__later--pressed{opacity:.75;}
.reward-moment__card--redeemed{height:1080rpx;}.reward-moment__products--single{width:70%;height:390rpx;margin:30rpx auto 14rpx;}.reward-moment__products--single .reward-moment__bottles{position:absolute;top:0;width:200%;max-width:none;height:100%;}.reward-moment__bottles--moisture{left:0;}.reward-moment__bottles--dandruff{left:-100%;}.reward-moment__fallback{width:100%;height:100%;}.reward-moment__name{display:block;margin:16rpx auto;font-size:28rpx;line-height:1.5;color:#f1e4ec;}
@keyframes ticket-shade{from{opacity:0;}to{opacity:1;}}@keyframes ticket-arrive{from{opacity:.55;transform:translateY(24rpx) rotate(-1deg) scale(.97);}to{opacity:1;transform:translateY(0) rotate(0) scale(1);}}@keyframes ticket-light{from{transform:translateX(-110%);opacity:.3;}70%{opacity:1;}to{transform:translateX(120%);opacity:0;}}@keyframes ticket-products{from{opacity:.3;transform:translateY(12rpx);}to{opacity:1;transform:translateY(0);}}
.reward-moment--still .reward-moment__card,.reward-moment--still .reward-moment__shade,.reward-moment--still .reward-moment__products{animation:none;}.reward-moment--still .reward-moment__sheen{display:none;}@media(prefers-reduced-motion:reduce){.reward-moment__card,.reward-moment__shade,.reward-moment__products{animation:none;}.reward-moment__sheen{display:none;}}
@media(max-height:680px){.reward-moment__content{padding-top:36rpx;}.reward-moment__brand{margin-bottom:70rpx;}.reward-moment__title{font-size:58rpx;}.reward-moment__products{height:304rpx;}.reward-moment__footer{padding-top:12rpx;}.reward-moment__card--redeemed .reward-moment__products{height:320rpx;}}
