:host{--care-ink:#2f2149;--care-plum:#56306f;--care-muted:#75697a;}
.care-onboarding-dialog,.care-onboarding-close,.care-onboarding-content,.care-onboarding-heading,.care-onboarding-option,.care-onboarding-footer,.care-onboarding-main,.care-onboarding-previous,.care-onboarding-skip,.care-onboarding-retry,.care-onboarding-decline{box-sizing:border-box;}
.care-onboarding-root{position:fixed;inset:0;z-index:1100;color:var(--care-ink);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;}
.care-onboarding-mask{position:absolute;inset:0;background:rgba(37,22,46,.22);animation:care-mask-in 220ms ease both;}
.care-onboarding-dialog{position:absolute;top:calc(var(--cisme-topbar-height,64px) + 10px);right:16px;bottom:calc(var(--cisme-safe-bottom,0px) + 14px);left:16px;display:flex;flex-direction:column;max-width:460px;max-height:790px;margin:0 auto;overflow:hidden;border:1px solid rgba(255,255,255,.88);border-radius:28px;background:#fffcff;box-shadow:0 18px 48px rgba(47,33,73,.16);animation:care-dialog-in 240ms cubic-bezier(.16,1,.3,1) both;}
.care-onboarding-photo{position:relative;flex:none;height:125px;overflow:hidden;background:#eee4f2;}
.care-onboarding-photo-image{position:absolute;top:-510px;width:100%;height:850px;opacity:.85;}
.care-onboarding-brand{position:absolute;right:0;bottom:16px;left:0;text-align:center;font-family:Georgia,"Times New Roman",serif;font-size:1.75rem;letter-spacing:4px;}
.care-onboarding-close{position:absolute;top:12px;right:12px;display:flex;align-items:center;justify-content:center;width:44px;height:44px;padding:10px;border:0;border-radius:50%;background:rgba(255,252,255,.9);}
.care-onboarding-close image{width:22px;height:22px;}
.care-onboarding-heading{display:flex;flex:none;align-items:center;justify-content:space-between;gap:12px;padding:18px 22px 0;font-size:.875rem;line-height:1.4;}
.care-onboarding-heading-title{padding-left:10px;border-left:4px solid var(--care-plum);font-weight:600;}
.care-onboarding-heading-progress{color:var(--care-muted);font-variant-numeric:tabular-nums;}
.care-onboarding-scroll{flex:1;min-height:0;height:0;}
.care-onboarding-content{padding:20px 22px 12px;}
.care-onboarding-question{margin:0 0 16px;font-family:"Songti SC","STSong",serif;font-size:1.6875rem;font-weight:600;line-height:1.4;overflow-wrap:anywhere;}
.care-onboarding-form{animation:care-question-in 180ms ease both;}
.care-onboarding-intro,.care-onboarding-consent{display:block;color:var(--care-muted);font-size:.875rem;line-height:1.75;}
.care-onboarding-consent{color:#51435b;font-size:.9375rem;line-height:1.9;}
.care-onboarding-selection{display:block;margin:20px 0 12px;color:#67546f;font-size:.8125rem;line-height:1.5;}
.care-onboarding-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;}
.care-onboarding-options--list{grid-template-columns:minmax(0,1fr);}
.care-onboarding-option{display:flex;align-items:center;justify-content:center;gap:8px;min-width:0;min-height:49px;margin:0;padding:12px 8px;border:1px solid #c9b3d3;border-radius:12px;color:var(--care-ink);background:#fffcff;font-size:.9375rem;font-weight:500;line-height:1.5;transition:transform 120ms ease,background-color 120ms ease,border-color 120ms ease;}
.care-onboarding-option text{min-width:0;overflow-wrap:anywhere;}
.care-onboarding-option image{flex:none;width:17px;height:17px;}
.care-onboarding-option.is-selected{border-color:var(--care-plum);color:#fff;background:var(--care-plum);}
.care-onboarding-pressed{transform:scale(.98);}
.care-onboarding-footer{display:flex;flex:none;align-items:center;gap:10px;padding:12px 22px 22px;}
.care-onboarding-main{display:flex;flex:1;align-items:center;justify-content:center;min-height:50px;margin:0;padding:12px 18px;border:0;border-radius:999px;color:#fff;background:var(--care-plum);font-size:1rem;font-weight:500;line-height:1.5;transition:transform 120ms ease;}
.care-onboarding-main--disabled{color:#fff;background:#8a7499;opacity:.85;}
.care-onboarding-previous,.care-onboarding-skip,.care-onboarding-retry,.care-onboarding-decline{display:flex;align-items:center;justify-content:center;min-height:44px;margin:0;padding:10px 8px;border:0;color:var(--care-plum);background:transparent;font-size:.875rem;line-height:1.5;}
.care-onboarding-skip{margin:10px auto 0;}
.care-onboarding-previous{flex:none;min-width:60px;}
.care-onboarding-choices{display:flex;flex-direction:column;gap:8px;margin-top:22px;}
.care-onboarding-decline{border:1px solid #c9b3d3;border-radius:999px;}
.care-onboarding-note{display:block;margin-top:18px;color:var(--care-muted);font-size:.8125rem;line-height:1.6;}
.care-onboarding-error{margin-top:14px;color:#9a3d55;font-size:.875rem;line-height:1.65;}
.care-onboarding-retry{justify-content:flex-start;padding-left:0;}
.care-onboarding-state{padding:24px 0;color:var(--care-muted);font-size:.9375rem;line-height:1.7;}
button::after{border:0;}
.care-onboarding--reduced .care-onboarding-mask,.care-onboarding--reduced .care-onboarding-dialog,.care-onboarding--reduced .care-onboarding-form{animation:none;}
.care-onboarding--reduced button{transition:none;transform:none!important;}
@keyframes care-mask-in{from{opacity:0;}to{opacity:1;}}
@keyframes care-dialog-in{from{opacity:0;transform:translateY(10px) scale(.985);}to{opacity:1;transform:translateY(0) scale(1);}}
@keyframes care-question-in{from{opacity:.3;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}
@media(max-height:740px){.care-onboarding-photo{height:76px;}.care-onboarding-brand{bottom:12px;font-size:1.5rem;}.care-onboarding-content{padding-top:14px;}.care-onboarding-question{font-size:1.5rem;}.care-onboarding-selection{margin-top:14px;}.care-onboarding-footer{padding-bottom:14px;}}
@media(max-width:350px){.care-onboarding-dialog{right:10px;left:10px;}.care-onboarding-heading{padding-right:16px;padding-left:16px;}.care-onboarding-content{padding-right:16px;padding-left:16px;}.care-onboarding-footer{padding-right:16px;padding-left:16px;}.care-onboarding-option{font-size:.875rem;}}
@media(prefers-reduced-motion:reduce){.care-onboarding-mask,.care-onboarding-dialog,.care-onboarding-form{animation:none;}.care-onboarding-root button{transition:none;transform:none!important;}}

.care-birthday-field{margin-top:20px;padding-top:16px;border-top:1px solid rgba(86,53,102,.1)}
.care-birthday-label{display:block;color:#423149;font-size:15px;line-height:1.5}.care-birthday-label text{color:#8a7b91;font-size:12px}
.care-birthday-value{display:flex;justify-content:space-between;align-items:center;min-height:48px;margin-top:8px;padding:0 14px;border:1px solid rgba(86,53,102,.12);border-radius:12px;background:#faf7fb;color:#50375f;font-size:15px}
.care-birthday-clear{min-height:44px;margin:4px 0 0;padding:0;background:transparent;color:#795987;text-align:left;font-size:13px}
.member-setup{padding:10px 0 14px;}.member-setup .care-onboarding-question{display:block;text-align:center;}
.member-setup__avatar{display:flex;flex-direction:column;align-items:center;gap:12px;margin:26px auto;padding:0 18px;min-height:44px;border:0;background:transparent;color:var(--care-plum);font-size:14px;line-height:1.5;}
.member-setup__avatar image{width:86px;height:86px;border-radius:50%;background:#f0e7f5;box-shadow:0 5px 14px rgba(74,43,91,.1);}.member-setup__avatar text{min-height:32px;line-height:32px;}
.member-setup__name{display:flex;align-items:center;gap:18px;min-height:54px;padding:0 2px;border-bottom:1px solid #d4c4dc;color:var(--care-ink);font-size:15px;}
.member-setup__name input{flex:1;min-width:0;height:52px;font-size:16px;color:var(--care-ink);}.member-setup__name input::placeholder{color:#786582;}
.member-setup__submit{margin-top:30px;}.member-setup__canvas{position:fixed;left:-512px;top:-512px;width:256px;height:256px;pointer-events:none;}
@media(max-height:740px){.member-setup{padding:0;}.member-setup__avatar{gap:8px;margin:16px auto;}.member-setup__avatar image{width:72px;height:72px;}.member-setup__avatar text{min-height:24px;line-height:24px;}.member-setup__submit{margin-top:24px;}}
