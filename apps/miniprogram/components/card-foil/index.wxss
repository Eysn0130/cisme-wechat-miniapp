.foil{position:absolute;z-index:1;inset:0;overflow:hidden;border-radius:inherit;pointer-events:none;contain:paint}.foil__material,.foil__reflection,.foil__sweep{position:absolute;pointer-events:none}.foil__material{inset:0;background:linear-gradient(116deg,transparent 8%,rgba(231,223,253,.12) 22%,rgba(216,240,239,.16) 32%,rgba(249,235,213,.13) 44%,transparent 57%,rgba(229,216,249,.11) 74%,transparent 89%);opacity:.35}.foil__reflection{inset:-30% -45%;background:linear-gradient(119deg,transparent 25%,rgba(224,241,245,.26) 39%,rgba(247,234,254,.42) 44%,rgba(254,246,220,.34) 49%,rgba(230,225,249,.25) 54%,transparent 68%);opacity:.11;transition:transform 80ms linear,opacity 180ms ease-out}.foil--active .foil__reflection{opacity:.28}.foil__sweep{top:-45%;left:-65%;width:48%;height:200%;opacity:0;background:linear-gradient(100deg,transparent 16%,rgba(220,244,241,.18) 36%,rgba(255,246,219,.28) 48%,rgba(241,226,251,.2) 59%,transparent 80%);transform:translate3d(0,0,0) skewX(-16deg)}.foil__sweep--intro{animation:foil-arrive 760ms cubic-bezier(.16,1,.3,1) both}.foil__sweep--flash{animation:foil-touch 640ms cubic-bezier(.16,1,.3,1) both}.foil__edge{position:absolute;top:1px;left:12%;right:12%;height:1px;opacity:.45;background:linear-gradient(90deg,transparent,rgba(238,239,253,.8) 30%,rgba(250,237,211,.85) 60%,transparent)}.foil--member{bottom:30%}.foil--member .foil__material{opacity:.24}.foil--member .foil__reflection{opacity:.10}.foil--member.foil--active .foil__reflection{opacity:.28}.foil--member .foil__sweep{background:linear-gradient(100deg,transparent 14%,rgba(223,242,245,.14) 36%,rgba(254,242,218,.2) 48%,rgba(236,218,249,.16) 59%,transparent 80%)}.foil--member.foil--sweeping .foil__reflection{opacity:.06}.foil--quiet{opacity:.18}.foil--quiet .foil__sweep{display:none}.foil--still .foil__sweep{display:none;animation:none}.foil--still .foil__reflection{transform:none!important;transition:none;opacity:.06!important}
@keyframes foil-arrive{0%{opacity:0;transform:translate3d(0,0,0) skewX(-16deg)}18%{opacity:.5}70%{opacity:.5}100%{opacity:0;transform:translate3d(360%,0,0) skewX(-16deg)}}@keyframes foil-touch{0%{opacity:0;transform:translate3d(0,0,0) skewX(-16deg)}16%{opacity:.5}68%{opacity:.5}100%{opacity:0;transform:translate3d(360%,0,0) skewX(-16deg)}}
@media(prefers-reduced-motion:reduce){.foil__sweep{display:none;animation:none}.foil__reflection{transform:none!important;transition:none;opacity:.06!important}}
