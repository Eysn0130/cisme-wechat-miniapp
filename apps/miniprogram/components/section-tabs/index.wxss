.section-tabs{display:block;width:100%;min-width:0;white-space:nowrap}.section-tabs__row{display:inline-flex;align-items:center;gap:12rpx;min-width:100%;min-height:44px}.section-tabs__tab{box-sizing:border-box;display:flex;flex:none;flex-direction:column;align-items:center;justify-content:center;min-width:44px;min-height:44px;margin:0;padding:0 16rpx;border:0;border-radius:0;background:transparent;box-shadow:none;color:#716a77;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:30rpx;font-weight:400;line-height:1.25;transition:opacity 120ms ease-out}.section-tabs__tab::before,.section-tabs__tab::after{display:none;content:none;border:0;box-shadow:none}.section-tabs__tab--active{color:#54366b;font-family:'Songti SC','STSong',serif;font-weight:600}.section-tabs__label{display:block;line-height:1.25}.section-tabs__marker{flex:none;width:24px;height:2px;margin-top:4px;border:0;border-radius:2px;background:transparent}.section-tabs__marker--active{background:#673b56}.section-tabs__tab--disabled{opacity:.45}.section-tabs__tab--pressed{opacity:.72}@media(prefers-reduced-motion:reduce){.section-tabs__tab{transition:none}}
