<view class="management-ui management-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back {{navigating?'control--disabled':''}}" bindtap="back" disabled="{{navigating}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">订单管理</text></view><view class="page page--stack management-orders-page"><view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在加载订单…"><view class="page-read-loading__indicator"/></view><view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="load">重试</button></view><view class="management-order-list" aria-label="{{refreshing?'订单列表，正在核验':'订单列表'}}"><button wx:for="{{items}}" wx:key="id" class="management-order-row {{!coreReady||navigating?'control--disabled':''}}" data-id="{{item.id}}" bindtap="open" disabled="{{!coreReady||navigating}}"><view class="management-order-row__head"><strong>{{item.orderNumber}}</strong><text>{{item.statusLabel}}</text></view><small>{{item.createdLabel}}</small><small wx:if="{{item.wechatReceipt}}">{{item.wechatReceipt.label}}</small><view class="management-order-row__foot"><text>{{item.summary}}</text><strong>¥{{item.totalYuan}}</strong><image src="/assets/icons/caret-right-muted.svg"/></view></button></view><view wx:if="{{!loading&&!error&&!items.length}}" class="state">当前没有订单记录。</view><button wx:if="{{nextCursor}}" class="secondary {{!coreReady||loadingMore?'secondary--disabled':''}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{!coreReady||loadingMore}}">加载更多</button></view></view>
