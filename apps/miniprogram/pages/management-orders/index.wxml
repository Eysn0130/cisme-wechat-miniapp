<view class="management-ui management-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back {{navigating?'control--disabled':''}}" bindtap="back" disabled="{{navigating}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">订单管理</text></view><view class="page page--stack management-orders-page"><view class="management-orders-tools"><view class="management-orders-links"><text>{{totalCount === null ? '商品订单' : '共 ' + totalCount + ' 笔'}}</text><button wx:if="{{canRewards}}" class="text-button {{navigating || !coreReady ? 'control--disabled' : ''}}" bindtap="openRewards" disabled="{{navigating || !coreReady}}">礼品领取订单 <text>›</text></button></view><section-tabs items="{{stages}}" value="{{stage}}" label="订单状态" bindchange="selectStage" disabled="{{navigating}}"/><view class="management-order-dates"><picker mode="date" value="{{from}}" end="{{through}}" data-field="from" bindchange="selectDate" disabled="{{navigating}}"><view>{{from || '开始日期'}}</view></picker><text>—</text><picker mode="date" value="{{through}}" start="{{from}}" data-field="through" bindchange="selectDate" disabled="{{navigating}}"><view>{{through || '结束日期'}}</view></picker><button class="text-button {{navigating || (!from && !through) ? 'control--disabled' : ''}}" bindtap="clearDates" disabled="{{navigating || (!from && !through)}}">清除</button></view></view><view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在加载订单…"><view class="page-read-loading__indicator"/></view><view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="load">重试</button></view><view class="management-order-list" aria-label="{{refreshing?'订单列表，正在核验':'订单列表'}}"><button wx:for="{{items}}" wx:key="id" class="management-order-row {{!coreReady||navigating?'control--disabled':''}}" data-id="{{item.id}}" bindtap="open" disabled="{{!coreReady||navigating}}"><view class="management-order-row__head"><strong>{{item.orderNumber}}</strong><text>{{item.statusLabel}}</text></view><small>{{item.createdLabel}}</small><small wx:if="{{item.wechatReceipt}}">{{item.wechatReceipt.label}}</small><view class="management-order-row__foot"><text>{{item.summary}}</text><strong>¥{{item.totalYuan}}</strong><image src="/assets/icons/caret-right-muted.svg"/></view></button></view><view wx:if="{{!loading&&!error&&!items.length}}" class="state">当前没有订单记录。</view><button wx:if="{{nextCursor}}" class="secondary {{!coreReady||loadingMore?'secondary--disabled':''}} {{!coreReady||loadingMore ? 'control--disabled' : ''}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{!coreReady||loadingMore}}">加载更多</button></view></view>
