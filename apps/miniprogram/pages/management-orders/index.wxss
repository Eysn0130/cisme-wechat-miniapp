.management-orders-page{background:#f7f2f8}.management-order-list{display:grid;gap:16rpx;margin-top:28rpx}.management-order-row{width:100%;padding:22rpx;border:1rpx solid var(--cisme-line);border-radius:26rpx;background:#fff;text-align:left}.management-order-row__head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.management-order-row__head strong{overflow:hidden;font-size:24rpx;font-weight:500;text-overflow:ellipsis}.management-order-row__head text{flex:none;padding:6rpx 12rpx;border-radius:999rpx;color:#674d72;background:#efe7f1;font-size:21rpx}.management-order-row small{display:block;margin-top:9rpx;color:var(--cisme-muted);font-size:21rpx}.management-order-row__foot{display:flex;align-items:center;margin-top:16rpx;padding-top:15rpx;border-top:1rpx solid var(--cisme-line)}.management-order-row__foot text{display:-webkit-box;min-width:0;flex:1;overflow:hidden;color:var(--cisme-ink);font-size:24rpx;-webkit-box-orient:vertical;-webkit-line-clamp:1}.management-order-row__foot strong{flex:none;margin-left:12rpx;font-size:28rpx;font-weight:500}.management-order-row__foot image{width:25rpx;height:25rpx;margin-left:10rpx}.privacy-note{display:flex;gap:14rpx;margin-top:24rpx;padding:20rpx;border-radius:22rpx;background:#eee7f0;color:#6d6171;font-size:23rpx;line-height:1.55}.privacy-note image{width:30rpx;height:30rpx;flex:none}
