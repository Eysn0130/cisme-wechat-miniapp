.rights-page{padding-bottom:calc(env(safe-area-inset-bottom) + 40px)}.rights-card{padding:20px;display:flex;flex-direction:column;gap:16px;line-height:1.7;font-size:14px}.rights-title{font-size:18px;font-weight:600}.rights-intro{gap:8px;padding:18px 20px}.rights-intro text{line-height:1.55}.rights-contact{align-self:flex-start;justify-content:flex-start;min-height:44px;margin:0;padding:0;border:0;border-radius:0;background:transparent;font-weight:500}.rights-form{gap:10px;padding:18px 20px}.rights-form-label{color:var(--cisme-ink);font-size:14px;font-weight:500;line-height:1.4}.rights-picker{display:flex;align-items:center;min-height:44px;box-sizing:border-box;padding:10px 12px;border:1rpx solid var(--cisme-line);border-radius:12px;background:#faf7fa;color:#56306f}.rights-input{width:100%;height:112px;box-sizing:border-box;background:#faf7fa;border:1px solid #e5dce8;border-radius:12px;padding:12px}.rights-input-hint{color:var(--cisme-muted);font-size:12px;line-height:1.5}.rights-meta{font-size:12px;line-height:1.6;color:#776b7e;word-break:break-all}
.rights-export{display:flex;flex-direction:column;gap:8px;padding:12px;border-radius:12px;background:#faf7fa;word-break:break-all}
.rights-reply-actions{display:flex;gap:10px;align-items:center}.rights-reply-actions button{min-height:44px;flex:1;display:flex;align-items:center;justify-content:center}

.rights-refresh{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;min-height:44px;margin:12px 0 0;padding:10px 16px;border:1rpx solid #d8c9dd;border-radius:12px;background:#fff;color:#56306f;font-size:14px;line-height:1.4;text-align:center;white-space:normal}
.rights-records-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px}.rights-records-head .rights-refresh{width:auto;margin:0;padding:8px 12px;border:0;background:transparent}
.rights-copy-id{align-self:flex-start;display:flex;align-items:center;min-height:44px;margin:0;padding:0 12px;font-size:12px;line-height:1.4}
