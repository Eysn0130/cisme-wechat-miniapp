@import "../../styles/list-tokens.wxss";
.rights-page{padding-right:var(--cisme-page-gutter);padding-left:var(--cisme-page-gutter);padding-bottom:calc(var(--cisme-safe-bottom,0px) + var(--cisme-space-6));gap:var(--cisme-space-3)}
.rights-card{padding:var(--cisme-space-4);display:flex;flex-direction:column;gap:var(--cisme-space-3);border:1rpx solid var(--cisme-line);border-radius:var(--cisme-radius-card);background:var(--cisme-card);color:var(--cisme-ink);line-height:1.65;font-size:var(--cisme-text-body);overflow-wrap:anywhere}
.rights-title{font-size:var(--cisme-text-action);font-weight:500;line-height:1.5;min-width:0}
.rights-intro{display:flex;flex-direction:column;align-items:flex-end;gap:var(--cisme-space-2)}
.rights-contact{min-height:var(--cisme-hit-target);margin:0;padding:0 var(--cisme-space-2);background:transparent;font-weight:400}
.rights-form{gap:var(--cisme-space-3)}
.rights-form-label{color:var(--cisme-ink);font-size:var(--cisme-text-body);line-height:1.5}
.rights-picker{display:flex;align-items:center;justify-content:space-between;gap:var(--cisme-space-3);min-height:var(--cisme-hit-target);padding:var(--cisme-space-3);border:1px solid var(--cisme-muted);border-radius:var(--cisme-radius-control);background:var(--cisme-card);color:var(--cisme-ink);font-size:var(--cisme-text-action);line-height:1.5}
.rights-picker__value{flex:1;min-width:0;overflow-wrap:anywhere}
.rights-picker__caret{flex:none;width:14px;height:14px;transform:rotate(90deg)}
.rights-input{width:100%;height:128px;min-height:var(--cisme-hit-target);padding:var(--cisme-space-3);border:1px solid var(--cisme-muted);border-radius:var(--cisme-radius-control);background:var(--cisme-card);color:var(--cisme-ink);font-size:var(--cisme-text-action);line-height:1.6;box-sizing:border-box}
.rights-placeholder,.rights-input-hint,.rights-meta{color:var(--cisme-muted);font-size:var(--cisme-text-small);line-height:1.6;overflow-wrap:anywhere}
.rights-input--error{border-color:var(--cisme-danger)}
.rights-form-error,.rights-consent-error{color:var(--cisme-danger);font-size:var(--cisme-text-body);line-height:1.6}
.rights-consent-error .text-button{padding-left:0;justify-content:flex-start}
.rights-form .primary{margin-top:var(--cisme-space-2)}
.rights-form .rights-destructive{background:var(--cisme-danger);color:var(--cisme-on-plum);box-shadow:none}
.rights-export{display:flex;flex-direction:column;gap:var(--cisme-space-2);padding:var(--cisme-space-3);border-radius:var(--cisme-radius-control);background:var(--cisme-page);overflow-wrap:anywhere}
.rights-reply-actions{display:flex;gap:var(--cisme-space-2);align-items:center;flex-wrap:wrap}
.rights-reply-actions button{min-height:var(--cisme-hit-target);flex:1;display:flex;align-items:center;justify-content:center}
.rights-refresh{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;min-height:var(--cisme-hit-target);margin:var(--cisme-space-3) 0 0;padding:var(--cisme-space-2) var(--cisme-space-3);border:1rpx solid var(--cisme-line);border-radius:var(--cisme-radius-control);background:var(--cisme-card);color:var(--cisme-plum);font-size:var(--cisme-text-body);line-height:1.5;text-align:center;white-space:normal}
.rights-records-head{display:flex;align-items:center;justify-content:space-between;gap:var(--cisme-space-3);margin-top:var(--cisme-space-3)}
.rights-records-head .rights-refresh{width:auto;margin:0;border:0;background:transparent}
.rights-record-title{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--cisme-space-3);flex-wrap:wrap}
.rights-status{padding:var(--cisme-space-1) var(--cisme-space-2);border-radius:var(--cisme-radius-control);background:var(--cisme-lilac);color:var(--cisme-plum);font-size:var(--cisme-text-small);line-height:1.5}
.rights-history{display:flex;flex-direction:column;gap:var(--cisme-space-2)}
.rights-loading{padding:var(--cisme-space-3) 0;color:var(--cisme-muted);font-size:var(--cisme-text-body);line-height:1.6}
.rights-copy-id{align-self:flex-start;display:flex;align-items:center;min-height:var(--cisme-hit-target);margin:0;padding:0 var(--cisme-space-2);font-size:var(--cisme-text-small);line-height:1.5}
