<view class="chrome-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">隐私与数据权利</text></view><view class="page page--stack rights-page"><view class="glass rights-card"><view class="rights-title">管理你的数据</view><block wx:if="{{legalIdentity}}"><text>{{legalIdentity.operator}} · 隐私政策 {{legalIdentity.version}}</text><text>联系渠道：{{legalIdentity.contact}}</text></block><text wx:else>联系信息暂未加载。</text><text>{{closedRights ? '可继续处理历史隐私请求，工作人员会在受理记录回复。' : '可申请查阅、更正、删除数据或注销账号；进度显示在下方。'}}</text><text>请勿填写密码、身份证号等敏感信息。</text></view><block wx:if="{{authenticated}}"><view class="glass rights-card"><picker range="{{labels}}" value="{{selected}}" bindchange="choose" disabled="{{busy}}"><view class="rights-picker">请求类型：{{labels[selected]}} ▾</view></picker><textarea wx:if="{{labels[selected] !== '申请注销账号'}}" class="rights-input" value="{{message}}" bindinput="input" maxlength="2000" disabled="{{busy}}" placeholder="请说明你希望处理的数据或遇到的问题" aria-label="请求说明"/><button class="primary {{busy ? 'primary--disabled' : ''}}" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{labels[selected] === '申请注销账号' ? '申请注销账号' : '提交请求'}}</button></view><view wx:if="{{notice}}" class="state">{{notice}}</view><view wx:if="{{error}}" class="state state--error">{{error}}</view><view class="rights-title">受理记录</view><button class="text-button rights-refresh {{loading ? 'text-button--disabled' : ''}}" bindtap="load" disabled="{{loading}}">{{loading ? '正在加载…' : '刷新记录'}}</button><view wx:if="{{!loading && !records.length}}" class="state">暂无受理记录</view><view wx:for="{{records}}" wx:key="id" class="glass rights-card"><view class="rights-title">{{item.label}} · {{item.statusLabel}}</view><text>{{item.message}}</text><view wx:if="{{item.replyHistory.length}}" class="rights-history"><text class="rights-meta">近期处理往来</text><view wx:for="{{item.replyHistory}}" wx:for-item="entry" wx:key="version"><text user-select="true">{{entry.actor === 'member' ? '我的补充' : '工作人员'}}：{{entry.body}}</text></view></view><block wx:if="{{item.status === 'responded' && item.waitingOn === 'member'}}"><button wx:if="{{replyFor !== item.id}}" class="secondary" data-id="{{item.id}}" bindtap="startReply">补充信息</button><view wx:else class="rights-export"><textarea class="rights-input" value="{{replyDraft}}" bindinput="editReply" maxlength="2000" auto-height adjust-position disabled="{{replyBusy}}" placeholder="补充工作人员需要的信息" aria-label="补充隐私请求信息"/><view class="rights-reply-actions"><button class="text-button {{replyBusy ? 'text-button--disabled' : ''}}" bindtap="cancelReply" disabled="{{replyBusy}}">取消</button><button class="secondary {{replyBusy ? 'secondary--disabled' : ''}}" bindtap="sendReply" loading="{{replyBusy}}" disabled="{{replyBusy}}">提交补充</button></view></view></block><text wx:if="{{item.executionSummary}}">{{item.executionSummary}}</text><block wx:if="{{item.execution && item.execution.downloadAvailable}}"><text class="rights-meta">副本目前只包含会员资料，其他记录可在原页面查看或继续申请。</text><button class="secondary" data-id="{{item.id}}" bindtap="viewExport">查看资料副本</button><button class="text-button" data-id="{{item.id}}" bindtap="revokeExport">撤销这份副本</button></block><view wx:if="{{visibleExport && visibleExport.requestId === item.id}}" class="rights-export"><text>姓名：{{visibleExport.displayName}}</text><text>微信号：{{visibleExport.wechatHandle}}</text><text class="rights-meta">离开页面后清除显示。</text></view><text class="rights-meta" user-select="true">编号 {{item.id}}</text></view><view wx:if="{{moreError}}" class="state state--error" aria-live="polite">{{moreError}}</view><button wx:if="{{nextCursor}}" class="text-button rights-refresh {{loadingMore || loading ? 'text-button--disabled' : ''}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore || loading}}">{{loadingMore ? '正在加载后续记录…' : '加载更多记录'}}</button></block><block wx:else><view class="state">登录后可提交请求并查看处理进度。</view><button class="primary" bindtap="login">登录并提交账号请求</button></block><button wx:if="{{!closedRights}}" class="secondary {{supportOpening ? 'secondary--disabled' : ''}}" bindtap="openSupport" disabled="{{supportOpening}}">联系小程序客服</button></view></view>
