<view class="chrome-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">隐私与数据权利</text></view><view class="page page--stack rights-page"><view class="glass rights-card rights-intro"><view class="rights-title">个人信息申请</view><text>{{closedRights ? '注销后仍可在这里申请处理历史资料，并查看处理回复。' : '选择需要处理的事项，提交后可在本页查看进度和回复。'}}</text><button wx:if="{{!closedRights && authenticated}}" class="text-button rights-contact {{supportOpening ? 'text-button--disabled' : ''}}" bindtap="openSupport" disabled="{{supportOpening}}">需要协助？通过客服申请</button><button wx:if="{{!authenticated}}" class="text-button rights-contact" open-type="contact">无法登录？联系微信客服</button></view><button wx:if="{{closedRights && authenticated}}" class="secondary" bindtap="openHistoricalOrders">查看历史订单与售后</button><view wx:if="{{closedRights && historicalBalance}}" class="glass rights-card"><view class="rights-title">历史权益</view><text>可核对金额 ¥{{historicalBalance.available}} · 待确认 ¥{{historicalBalance.pending}}</text><text wx:if="{{historicalBalance.held !== '0.00'}}">处理中 ¥{{historicalBalance.held}}</text><text class="rights-meta">如需处理，请在下方提交申请；金额以最终核对结果为准。</text></view><view wx:if="{{notice}}" class="state" aria-live="polite">{{notice}}</view><view wx:if="{{error}}" class="state state--error" aria-live="polite">{{error}}</view><block wx:if="{{authenticated}}"><view class="glass rights-card rights-form"><text class="rights-form-label">申请事项</text><picker range="{{labels}}" value="{{selected}}" bindchange="choose" disabled="{{busy||replyBusy||exportBusy}}" aria-label="申请事项"><view class="rights-picker">{{labels[selected]}} ▾</view></picker><picker wx:if="{{!closedRights && labels[selected] === '删除个人信息'}}" range="{{deleteScopes}}" value="{{deleteScopeIndex}}" bindchange="chooseDeleteScope" disabled="{{busy||replyBusy||exportBusy}}"><view class="rights-picker">处理范围：{{deleteScopes[deleteScopeIndex]}} ▾</view></picker><text wx:if="{{!closedRights && labels[selected] === '删除个人信息' && deleteScopeIndex === 0}}" class="rights-meta">清除昵称、手机号、头像和地址；交易记录按必要期限保留。</text><text wx:if="{{!closedRights && labels[selected] === '撤回个人信息处理同意' && consentsLoading}}" class="rights-meta">正在读取可撤回的授权…</text><picker wx:if="{{!closedRights && labels[selected] === '撤回个人信息处理同意' && consentGrants.length}}" range="{{consentGrants}}" range-key="label" value="{{consentGrantIndex}}" bindchange="chooseConsentGrant" disabled="{{busy||replyBusy||exportBusy}}"><view class="rights-picker">撤回授权：{{consentGrants[consentGrantIndex].label}} ▾</view></picker><text wx:if="{{!closedRights && labels[selected] === '撤回个人信息处理同意' && consentGrants.length}}" class="rights-meta">选中后立即停止该授权的后续使用；历史传播仍需核对。</text><text wx:if="{{labels[selected] !== '申请注销账号' && (closedRights || labels[selected] !== '删除个人信息' || deleteScopeIndex === 1) && (labels[selected] !== '撤回个人信息处理同意' || (!consentGrants.length && !consentsLoading))}}" class="rights-form-label">申请说明（必填）</text><textarea wx:if="{{labels[selected] !== '申请注销账号' && (closedRights || labels[selected] !== '删除个人信息' || deleteScopeIndex === 1) && (labels[selected] !== '撤回个人信息处理同意' || (!consentGrants.length && !consentsLoading))}}" class="rights-input" value="{{message}}" bindinput="input" maxlength="2000" disabled="{{busy||replyBusy||exportBusy}}" placeholder="{{labels[selected] === '更正个人信息' ? '如需更正昵称或微信号，请填写“昵称：新昵称”或“微信号：新微信号”' : '请说明你希望处理的数据或遇到的问题'}}" aria-label="申请说明"/><text wx:if="{{labels[selected] !== '申请注销账号' && (closedRights || labels[selected] !== '删除个人信息' || deleteScopeIndex === 1) && (labels[selected] !== '撤回个人信息处理同意' || (!consentGrants.length && !consentsLoading))}}" class="rights-input-hint">请勿填写密码、身份证号或他人的信息。</text><button class="primary {{busy||replyBusy||exportBusy||consentsLoading ? 'primary--disabled' : ''}}" bindtap="submit" loading="{{busy}}" disabled="{{busy||replyBusy||exportBusy||consentsLoading}}">{{labels[selected] === '申请注销账号' ? '申请注销账号' : (!closedRights && labels[selected] === '删除个人信息' && deleteScopeIndex === 0 ? '清除账户资料' : '提交申请')}}</button></view><view class="rights-records-head"><view class="rights-title">申请进度</view><button class="text-button rights-refresh {{loading ? 'text-button--disabled' : ''}}" bindtap="load" disabled="{{loading}}">{{loading ? '正在加载…' : '刷新'}}</button></view><view wx:if="{{!loading && recordsLoaded && !records.length}}" class="state">还没有申请记录。选择上方事项并提交后，可在这里查看进度。</view><view wx:for="{{records}}" wx:key="id" class="glass rights-card"><view class="rights-title">{{item.label}} · {{item.statusLabel}}</view><text>{{item.message}}</text><text wx:if="{{item.responseSummary}}" user-select="true">处理结果：{{item.responseSummary}}</text><view wx:if="{{item.replyHistory.length}}" class="rights-history"><text class="rights-meta">近期处理往来</text><view wx:for="{{item.replyHistory}}" wx:for-item="entry" wx:key="version"><text user-select="true">{{entry.actor === 'member' ? '我的补充' : '工作人员'}}：{{entry.body}}</text></view></view><block wx:if="{{item.status === 'responded' && item.waitingOn === 'member'}}"><button wx:if="{{replyFor !== item.id}}" class="secondary {{busy||replyBusy||exportBusy ? 'secondary--disabled' : ''}}" data-id="{{item.id}}" bindtap="startReply" disabled="{{busy||replyBusy||exportBusy}}">补充信息</button><view wx:else class="rights-export"><textarea class="rights-input" value="{{replyDraft}}" bindinput="editReply" maxlength="2000" auto-height adjust-position disabled="{{busy||replyBusy||exportBusy}}" placeholder="补充工作人员需要的信息" aria-label="补充申请信息"/><view class="rights-reply-actions"><button class="text-button {{busy||replyBusy||exportBusy ? 'text-button--disabled' : ''}}" bindtap="cancelReply" disabled="{{busy||replyBusy||exportBusy}}">取消</button><button class="secondary {{busy||replyBusy||exportBusy ? 'secondary--disabled' : ''}}" bindtap="sendReply" loading="{{replyBusy}}" disabled="{{busy||replyBusy||exportBusy}}">提交补充</button></view></view></block><text wx:if="{{item.executionSummary}}">{{item.executionSummary}}</text><view wx:if="{{item.execution && item.execution.unavailableMedia && item.execution.unavailableMedia.length}}" class="rights-export"><text class="rights-meta">{{item.execution.unavailableMediaCount || item.execution.unavailableMedia.length}} 项素材未包含在副本中。</text><view wx:for="{{item.execution.unavailableMedia}}" wx:for-item="asset" wx:for-index="assetIndex" wx:key="id"><button wx:if="{{item.execution.downloadAvailable && (asset.reason === 'inline_copy_size_limit' || asset.reason === 'video_requires_separate_copy')}}" class="secondary {{busy||replyBusy||exportBusy ? 'secondary--disabled' : ''}}" data-request-id="{{item.id}}" data-media-id="{{asset.id}}" bindtap="viewSupplementary" loading="{{exportBusy && exportRequestId===item.id}}" disabled="{{busy||replyBusy||exportBusy}}">获取补充{{asset.mimeType === 'video/mp4' ? '视频' : '图片'}} {{assetIndex + 1}}</button></view><text class="rights-meta">仍无法读取原文件时，请另提交申请说明。</text></view><block wx:if="{{item.execution && item.execution.downloadAvailable && !item.resumePlaceholder}}"><text wx:if="{{item.execution.scope==='member_profile_only'}}" class="rights-meta">这份副本仅含会员资料；其他资料可继续申请。</text><text wx:else class="rights-meta">发送前请确认接收人；已发送的文件无法收回。</text><button class="secondary {{busy||replyBusy||exportBusy ? 'secondary--disabled' : ''}}" loading="{{exportBusy && exportRequestId===item.id}}" data-id="{{item.id}}" bindtap="viewExport" disabled="{{busy||replyBusy||exportBusy}}">{{item.execution.scope==='member_portable_copy_v1'?'发送数据副本':'查看资料副本'}}</button><button class="text-button {{busy||replyBusy||exportBusy ? 'text-button--disabled' : ''}}" data-id="{{item.id}}" bindtap="revokeExport" disabled="{{busy||replyBusy||exportBusy}}">撤销副本访问</button></block><text wx:if="{{item.execution && item.execution.scope==='member_portable_copy_v1' && item.status==='failed' && item.execution.lastErrorCode === 'PRIVACY_EXPORT_TOO_LARGE'}}" class="rights-meta">副本过大，无法自动生成。请复制申请编号，选择“其他隐私咨询”说明所需资料。</text><button wx:if="{{item.execution && item.execution.scope==='member_portable_copy_v1' && item.status==='failed' && item.execution.lastErrorCode !== 'PRIVACY_EXPORT_TOO_LARGE'}}" class="secondary {{busy||replyBusy||exportBusy ? 'secondary--disabled' : ''}}" data-id="{{item.id}}" bindtap="retryExport" disabled="{{busy||replyBusy||exportBusy}}">重试生成副本</button><view wx:if="{{visibleParts && visibleParts.requestId === item.id}}" class="rights-export"><text class="rights-meta">共 {{visibleParts.partCount}} 卷。请保存每页校验清单，再逐卷发送；全部收齐后才是完整副本。</text><view class="rights-reply-actions"><button class="text-button {{visibleParts.manifestPageNumber <= 1 || exportBusy ? 'text-button--disabled' : ''}}" data-step="-1" bindtap="changeManifestPage" disabled="{{visibleParts.manifestPageNumber <= 1 || exportBusy}}">上一页</button><text>校验清单 {{visibleParts.manifestPageNumber}} / {{visibleParts.manifestPageCount}}</text><button class="text-button {{visibleParts.manifestPageNumber >= visibleParts.manifestPageCount || exportBusy ? 'text-button--disabled' : ''}}" data-step="1" bindtap="changeManifestPage" disabled="{{visibleParts.manifestPageNumber >= visibleParts.manifestPageCount || exportBusy}}">下一页</button></view><button class="secondary {{busy||replyBusy||exportBusy ? 'secondary--disabled' : ''}}" bindtap="sendManifestPage" loading="{{exportBusy && exportRequestId===item.id}}" disabled="{{busy||replyBusy||exportBusy}}">发送本页校验清单</button><view class="rights-reply-actions"><button class="text-button {{visibleParts.partNumber <= 1 || exportBusy ? 'text-button--disabled' : ''}}" data-step="-1" bindtap="changePart" disabled="{{visibleParts.partNumber <= 1 || exportBusy}}">上一卷</button><text>第 {{visibleParts.partNumber}} / {{visibleParts.partCount}} 卷</text><button class="text-button {{visibleParts.partNumber >= visibleParts.partCount || exportBusy ? 'text-button--disabled' : ''}}" data-step="1" bindtap="changePart" disabled="{{visibleParts.partNumber >= visibleParts.partCount || exportBusy}}">下一卷</button></view><button class="secondary {{busy||replyBusy||exportBusy ? 'secondary--disabled' : ''}}" bindtap="sendPart" loading="{{exportBusy && exportRequestId===item.id}}" disabled="{{busy||replyBusy||exportBusy}}">发送本卷</button></view><view wx:if="{{visibleExport && visibleExport.requestId === item.id}}" class="rights-export"><text>姓名：{{visibleExport.displayName}}</text><text>微信号：{{visibleExport.wechatHandle}}</text><text class="rights-meta">离开页面后清除显示。</text></view><button class="text-button rights-copy-id" data-id="{{item.id}}" bindtap="copyRequestId" aria-label="复制申请编号">申请编号 · {{item.shortId}}</button></view><view wx:if="{{moreError}}" class="state state--error" aria-live="polite">{{moreError}}</view><button wx:if="{{nextCursor}}" class="text-button rights-refresh {{loadingMore || loading ? 'text-button--disabled' : ''}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore || loading}}">{{loadingMore ? '正在加载后续记录…' : '加载更多记录'}}</button></block><block wx:else><view class="state">登录后可提交申请并查看处理进度。</view><button class="primary" bindtap="login">登录后继续</button></block></view></view>
