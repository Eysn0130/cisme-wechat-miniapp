<view class="chrome-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">隐私与数据权利</text></view><view class="page page--stack rights-page"><view class="glass rights-card"><view class="rights-title">管理你的数据</view><block wx:if="{{legalIdentity}}"><text>{{legalIdentity.operator}} · 隐私政策 {{legalIdentity.version}}</text><text>联系渠道：{{legalIdentity.contact}}</text></block><text wx:else>联系信息暂未加载，可使用页面底部的微信反馈。</text><text>可申请查阅、更正、删除数据或注销账号。进度与处理结果会显示在下方。</text><text>请勿填写密码、身份证号等敏感信息。</text></view><block wx:if="{{authenticated}}"><view class="glass rights-card"><picker range="{{labels}}" value="{{selected}}" bindchange="choose" disabled="{{busy}}"><view class="rights-picker">请求类型：{{labels[selected]}} ▾</view></picker><textarea class="rights-input" value="{{message}}" bindinput="input" maxlength="2000" disabled="{{busy}}" placeholder="请说明你希望处理的数据或遇到的问题" aria-label="请求说明"/><button class="primary {{busy ? 'primary--disabled' : ''}}" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交请求</button></view><view wx:if="{{notice}}" class="state">{{notice}}</view><view wx:if="{{error}}" class="state state--error">{{error}}</view><view class="rights-title">受理记录</view><button class="text-button rights-refresh {{loading ? 'text-button--disabled' : ''}}" bindtap="load" disabled="{{loading}}">{{loading ? '正在加载…' : '刷新记录'}}</button><view wx:if="{{!loading && !records.length}}" class="state">暂无受理记录</view><view wx:for="{{records}}" wx:key="id" class="glass rights-card"><view class="rights-title">{{item.label}} · {{item.statusLabel}}</view><text>{{item.message}}</text><text wx:if="{{item.response}}">回复：{{item.response}}</text><text wx:if="{{item.latestMemberReply}}">我的补充：{{item.latestMemberReply.body}}</text><block wx:if="{{item.status === 'responded' && item.waitingOn === 'member'}}"><button wx:if="{{replyFor !== item.id}}" class="secondary" data-id="{{item.id}}" bindtap="startReply">补充信息</button><view wx:else class="rights-export"><textarea class="rights-input" value="{{replyDraft}}" bindinput="editReply" maxlength="2000" auto-height adjust-position disabled="{{replyBusy}}" placeholder="补充工作人员需要的信息" aria-label="补充隐私请求信息"/><view class="rights-reply-actions"><button class="text-button {{replyBusy ? 'text-button--disabled' : ''}}" bindtap="cancelReply" disabled="{{replyBusy}}">取消</button><button class="secondary {{replyBusy ? 'secondary--disabled' : ''}}" bindtap="sendReply" loading="{{replyBusy}}" disabled="{{replyBusy}}">提交补充</button></view></view></block><text wx:if="{{item.executionSummary}}">{{item.executionSummary}}</text><block wx:if="{{item.execution && item.execution.downloadAvailable}}"><text class="rights-meta">副本目前只包含会员资料，其他记录可在原页面查看或继续申请。</text><button class="secondary" data-id="{{item.id}}" bindtap="viewExport">查看资料副本</button><button class="text-button" data-id="{{item.id}}" bindtap="revokeExport">撤销这份副本</button></block><view wx:if="{{visibleExport && visibleExport.requestId === item.id}}" class="rights-export"><text>姓名：{{visibleExport.displayName}}</text><text>微信号：{{visibleExport.wechatHandle}}</text><text class="rights-meta">离开页面后清除显示。</text></view><text class="rights-meta" user-select="true">编号 {{item.id}}</text></view><view wx:if="{{moreError}}" class="state state--error" aria-live="polite">{{moreError}}</view><button wx:if="{{nextCursor}}" class="text-button rights-refresh {{loadingMore || loading ? 'text-button--disabled' : ''}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore || loading}}">{{loadingMore ? '正在加载后续记录…' : '加载更多记录'}}</button></block><block wx:else><view class="state">登录后可查看账号请求记录；也可通过微信反馈联系我们。</view><button class="primary" bindtap="login">登录并提交账号请求</button></block><button class="secondary" open-type="feedback">通过微信反馈联系运营方</button><text class="rights-meta">也可从右上角“…”进入“反馈与投诉”。</text></view></view>
