<view class="management-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">商品管理</text></view><view class="page page--stack catalog-page">
  <view class="catalog-head"><view><text class="eyebrow">FIRST-PARTY CATALOG</text><view class="page-title">商品、资质与库存</view></view><button class="primary catalog-add {{navigating ? 'primary--disabled' : ''}}" bindtap="create" disabled="{{navigating}}">新建商品</button></view>
  <view class="catalog-notice"><image src="/assets/icons/shield-check-plum.svg"/><text>资质确认与上架需分别完成。待支付订单功能仅在开放时可用。</text></view>
  <view wx:if="{{loading}}" class="state">正在读取服务端目录…</view>
  <view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="load">重试</button></view>
  <view class="catalog-list"><button wx:for="{{items}}" wx:key="productId" class="catalog-row {{navigating ? 'control--disabled' : ''}}" data-id="{{item.productId}}" bindtap="open" disabled="{{navigating}}"><image class="catalog-row__image" src="{{item.image || '/assets/cisme/community-card-purple-bottle-v1.jpg'}}" mode="aspectFill"/><view class="catalog-row__body"><strong>{{item.name}}</strong><small>{{item.code}} · {{item.sourceKind}}</small><view class="catalog-row__states"><text>{{item.qualificationLabel}}</text><text>{{item.publicationLabel}}</text><text>{{item.priceYuan}}</text><text>库存 {{item.stockOnHand}}</text><text wx:if="{{item.variants[0].reservedQuantity}}">预留 {{item.variants[0].reservedQuantity}}</text></view></view><image class="catalog-row__caret" src="/assets/icons/caret-right-muted.svg"/></button></view>
  <view wx:if="{{!loading && !error && !items.length}}" class="state">当前没有商品。可新建一个草稿开始维护。</view>
  <button wx:if="{{nextCursor}}" class="secondary {{loadingMore ? 'control--disabled' : ''}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
</view></view>
