<view class="management-ui management-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">商品管理</text></view><view class="page page--stack catalog-page">
  <view class="catalog-head"><view><view class="page-title">在售与草稿</view></view><button wx:if="{{canCreate}}" class="primary catalog-add {{loading||navigating ? 'primary--disabled' : ''}}" bindtap="create" disabled="{{loading||navigating}}">新建商品</button></view>

  <view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在加载商品列表…"><view class="page-read-loading__indicator"/></view>
  <view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="load">重试</button></view>
  <view class="catalog-list"><button wx:for="{{items}}" wx:key="productId" class="catalog-row {{navigating ? 'control--disabled' : ''}}" data-id="{{item.productId}}" bindtap="open" disabled="{{navigating}}"><image class="catalog-row__image" src="{{item.image || '/assets/icons/spray-bottle-plum.svg'}}" mode="aspectFill"/><view class="catalog-row__body"><strong>{{item.name}}</strong><small>{{item.code}}<text wx:if="{{item.sourceKind === 'synthetic_test'}}"> · 测试商品</text><text wx:elif="{{item.sourceKind === 'legacy_preview'}}"> · 历史预览</text></small><view class="catalog-row__states"><text>{{item.qualificationLabel}}</text><text>{{item.publicationLabel}}</text><text>{{item.priceYuan}}</text><text>库存 {{item.stockOnHand}}</text><text wx:if="{{item.variants[0].reservedQuantity}}">预留 {{item.variants[0].reservedQuantity}}</text></view></view><image class="catalog-row__caret" src="/assets/icons/caret-right-muted.svg"/></button></view>
  <view wx:if="{{!loading && !error && !items.length}}" class="state">{{canCreate?'暂无商品，可新建草稿。':'当前没有可查看的商品。'}}</view>
  <button wx:if="{{nextCursor}}" class="secondary {{loadingMore ? 'control--disabled' : ''}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
</view></view>
