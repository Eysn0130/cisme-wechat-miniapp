.catalog-page{background:#f7f2f8}.catalog-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24rpx}.catalog-add{flex:none;width:auto;min-width:180rpx;padding:0 24rpx}.catalog-notice{display:flex;gap:14rpx;margin:28rpx 0;padding:22rpx;border-radius:24rpx;background:#ece5ef;color:#6f6573;font-size:23rpx;line-height:1.5}.catalog-notice image{width:30rpx;height:30rpx;flex:none}.catalog-list{display:grid;gap:18rpx}.catalog-row{display:flex;align-items:center;width:100%;padding:18rpx;border:1rpx solid rgba(84,56,96,.08);border-radius:28rpx;background:#fff;text-align:left}.catalog-row__image{width:132rpx;height:132rpx;border-radius:20rpx;background:#eee7ef}.catalog-row__body{display:flex;flex:1;min-width:0;flex-direction:column;margin-left:20rpx}.catalog-row__body strong{overflow:hidden;font-size:28rpx;font-weight:500;text-overflow:ellipsis;white-space:nowrap}.catalog-row__body small{margin-top:5rpx;color:#8b818e;font-size:20rpx}.catalog-row__states{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:15rpx}.catalog-row__states text{padding:6rpx 10rpx;border-radius:999rpx;background:#f2ebf4;color:#634d6e;font-size:20rpx}.catalog-row__caret{width:26rpx;height:26rpx;margin-left:10rpx}
