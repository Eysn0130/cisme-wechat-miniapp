@import "../../styles/sheet-dismiss.wxss";
page{--cisme-text-micro:.6875rem;--cisme-text-small:.75rem;--cisme-text-body:.875rem;--cisme-text-action:1rem}
.home-page{position:fixed;inset:0;z-index:1;width:100vw;height:100vh;overflow:hidden;color:#30233d;background:linear-gradient(180deg,#f1eaf7,#f5eff8)}
.home-platform{position:absolute;z-index:4;top:var(--cisme-menu-top,48px);left:var(--cisme-nav-side,100px);right:var(--cisme-nav-side,100px);height:var(--cisme-menu-height,32px);display:flex;align-items:center;justify-content:center;pointer-events:none;overflow:visible}
.brand-wordmark{flex:none;color:#302044;font:1.375rem/1 Georgia,"Times New Roman",serif;letter-spacing:.14em}
.home-support{position:absolute;z-index:5;top:var(--cisme-back-top,44px);left:20px;display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin:0;padding:0;border:0;border-radius:50%;background:#f7f5f8;box-shadow:none}.home-support image{width:22px;height:22px}.home-support__badge{position:absolute;top:-3px;right:-6px;display:flex;align-items:center;justify-content:center;min-width:16px;height:16px;padding:0 4px;border:2px solid #fff;border-radius:999px;color:#fff;background:#8d3150;font-size:.625rem;line-height:1}
.home-scroll{position:absolute;z-index:2;top:calc(var(--cisme-topbar-height,88px) + 4px);left:0;right:0;bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 168px);width:100%;height:calc(100vh - var(--cisme-topbar-height,88px) - var(--cisme-safe-bottom,env(safe-area-inset-bottom)) - 172px);background:transparent}
.home-header-surface{position:absolute;top:0;right:0;left:0;height:calc(var(--cisme-topbar-height,88px) + 20px);background:#fff}
.home-composition{display:flex;flex-direction:column;min-height:calc(100vh - var(--cisme-topbar-height,88px) - var(--cisme-safe-bottom,env(safe-area-inset-bottom)) - 172px)}
.care-console{display:flex;flex:1 0 auto;flex-direction:column;justify-content:space-between;position:relative;top:auto;left:auto;bottom:auto;width:auto;min-height:0;margin:0;padding:24px 7% 14px;text-align:center;overflow:visible;animation:none}
.centered-date{min-height:20px;margin:0;color:#75697a;font-size:.8125rem;line-height:1.5}
.centered-title{margin-top:12px;color:#321d48;font-size:2rem;font-weight:600;line-height:1.25}
.centered-copy{margin-top:12px;color:#75697a;font-size:.875rem;line-height:1.5}.centered-copy text{display:block}
.centered-products{display:flex;align-items:stretch;justify-content:center;min-height:64px;margin-top:24px}
.centered-product{display:flex;flex:1;min-width:0;max-width:50%;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:0 5px;color:#65516f;font-size:.875rem;line-height:1.4}.centered-product--divided{border-left:1rpx solid rgba(86,48,111,.15)}.centered-product image{flex:none;width:22px;height:26px}
.care-cta{display:flex;align-items:center;justify-content:center;width:100%;min-height:50px;height:auto;margin:24px auto 0;padding:12px 14px;border:0;border-radius:999px;color:#fff;background:linear-gradient(100deg,#66367b,#56306f);box-shadow:none;text-shadow:none;transition:opacity 140ms ease-out,transform 140ms ease-out}.care-cta__label{font-size:1.0625rem;font-weight:500;line-height:1.4;letter-spacing:0}.care-cta--pressed{opacity:.9;transform:scale(.985)}
.centered-continuity{display:flex;flex-direction:column;gap:5px;min-height:22px;margin:14px 0 0;color:#75697a;font-size:.875rem;line-height:1.55}.centered-continuity__number{color:#56306f;font-weight:500;font-variant-numeric:lining-nums tabular-nums}.centered-reward{color:#56306f;font-size:.8125rem}
.care-signal,.care-signal--centered{position:absolute;z-index:3;left:8%;right:8%;bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 88px);display:flex;align-items:center;gap:9px;min-height:58px;width:auto;margin:0;padding:8px 12px;border:0;border-radius:32px;background:rgba(255,252,255,.88);box-shadow:none}.care-signal__icon{flex:none;width:20px;height:20px}.care-signal__copy{flex:1;min-width:0;text-align:left}.care-signal__title{display:block;color:#514358;font-size:.8125rem;font-weight:500;line-height:1.5}.care-signal__details{display:flex;flex:none;align-items:center;justify-content:center;gap:2px;min-width:44px;min-height:44px;margin:0 -4px 0 0;padding:0 2px;border:0;border-radius:0;background:transparent;color:#56306f;font-size:.8125rem;font-weight:600;line-height:1.4}.care-signal__details image{width:14px;height:14px}.care-signal__details--pressed{opacity:.7}
.home-authority-state{margin:28px auto;color:#75697a;font-size:.875rem;line-height:1.6}
.home-care-skeleton__date{width:116px;height:14px;margin:3px auto 18px;border-radius:4px;background:var(--cisme-load-bone,#eee7f2)}.home-care-skeleton__products{display:flex;justify-content:center;gap:25px;height:64px;margin-top:24px}.home-care-skeleton__products view{width:68px;height:56px;border-radius:8px;background:var(--cisme-load-bone,#eee7f2)}.home-care-skeleton__action{height:50px;margin-top:24px;border-radius:999px;background:var(--cisme-load-bone,#eee7f2)}
.home-error{position:absolute;z-index:20;left:8%;right:8%;bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 156px);padding:14px 16px;border-radius:14px;color:#8d3150;background:#f8e8ed;text-align:center;font-size:.8125rem}.home-error__copy{display:block;line-height:1.55}.home-error .text-button{min-height:44px;margin-top:6px}
@media(max-height:740px){.care-console{padding-top:14px}.centered-title{margin-top:8px;font-size:1.75rem}.centered-products{margin-top:14px;min-height:56px}.centered-product{gap:6px;font-size:.8125rem}.care-cta{margin-top:14px;min-height:48px}.centered-continuity{margin-top:10px;font-size:.8125rem}}
@media(max-height:600px){.care-console{padding-top:12px}.centered-date{font-size:.75rem;min-height:18px}.centered-title{font-size:1.625rem;margin-top:8px}.centered-products{margin-top:14px;min-height:52px}.centered-product{font-size:.75rem;gap:5px}.centered-product image{width:18px;height:22px}.care-cta{margin-top:16px;min-height:44px;padding:10px 12px}.care-cta__label{font-size:.9375rem}.centered-continuity{margin-top:10px}}
.home-page--reduced .care-cta{transition:none}
@media(prefers-reduced-motion:reduce){.care-cta{transition:none}}
@media(min-height:880px) and (max-width:600px){
  .home-page{--cisme-campaign-height:67vw}
  .brand-wordmark{font-size:1.5rem}
  .care-console{padding:26px 7% 16px}
  .centered-title,.centered-products,.care-cta,.centered-continuity{margin-top:0}
  .centered-date,.care-signal__title,.care-signal__details{font-size:.9375rem}
  .centered-title{font-size:2.25rem}
  .centered-products{min-height:76px}
  .centered-product,.centered-continuity{font-size:1rem}
  .centered-product image{width:26px;height:32px}
  .care-cta{min-height:56px}.care-cta__label{font-size:1.25rem}
}
@media(min-height:741px) and (max-height:830px){.care-console{padding-top:18px}.centered-products{margin-top:18px;min-height:56px}.care-cta{margin-top:18px;min-height:48px}.centered-continuity{margin-top:12px}}

.care-session { position:fixed; z-index:80; top:0; right:0; bottom:0; left:0; display:flex; align-items:flex-end; justify-content:center; padding-top:120rpx; background:rgba(37,24,43,.42); opacity:0; pointer-events:none; -webkit-backdrop-filter:blur(10rpx); transform:translateZ(0); transition:opacity 200ms ease-out; }
.care-session--visible { opacity:1; pointer-events:auto; }
.care-session__sheet { width:100%; max-height:calc(100vh - 120rpx); padding:14rpx 32rpx calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 34rpx); overflow-y:auto; border:1rpx solid rgba(255,255,255,.88); border-radius:48rpx 48rpx 0 0; background:linear-gradient(180deg,rgba(253,250,253,.98),rgba(246,239,248,.99)); box-shadow:0 -30rpx 80rpx rgba(46,27,55,.2); opacity:.7; transform:translate3d(0,58rpx,0) scale(.975); transform-origin:50% 100%; transition:transform 320ms cubic-bezier(.16,1,.3,1),opacity 200ms ease-out; }
.care-session--visible .care-session__sheet { opacity:1; transform:translate3d(0,0,0) scale(1); }
.care-session--closing .care-session__sheet { transition-duration:260ms,180ms; }
.care-session__handle { width:68rpx; height:8rpx; margin:0 auto 18rpx; border-radius:999rpx; background:rgba(91,70,99,.2); }
.care-session__topline { display:flex; align-items:center; justify-content:space-between; min-height:var(--cisme-hit-target); }
.care-session__summary { display:flex; align-items:center; gap:16rpx; }
.care-session__milestone { color:#7c6688; font:600 var(--cisme-text-small)/1.2 Georgia,"Times New Roman",serif; letter-spacing:4rpx; }
.care-session__progress { display:flex; align-items:center; justify-content:center; min-width:72rpx; height:42rpx; padding:0 14rpx; border-radius:999rpx; color:#624b6d; background:#eee5f2; font-size:var(--cisme-text-micro); line-height:1; }
.session-rail { position:relative; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:18rpx; margin:22rpx 2rpx 0; }
.session-rail__line { position:absolute; top:34rpx; right:10%; left:10%; height:2rpx; overflow:hidden; background:rgba(91,64,105,.16); }
.session-node { position:relative; z-index:1; display:flex; align-items:center; flex-direction:column; color:#9a8f9d; }
.session-node__disc { display:flex; align-items:center; justify-content:center; width:68rpx; height:68rpx; border:1rpx solid rgba(95,73,105,.18); border-radius:50%; background:#f1eaf3; transition:transform 260ms cubic-bezier(.16,1,.3,1),background 220ms ease,box-shadow 220ms ease; }
.session-node__code { font:var(--cisme-text-small)/1 Georgia,"Times New Roman",serif; }
.session-node__check { width:28rpx; height:28rpx; }
.session-node__label { margin-top:8rpx; font-size:var(--cisme-text-micro); line-height:1.3; }
.session-node.is-current { color:#56386a; }
.session-node.is-current .session-node__disc { color:#fff; border-color:#634677; background:#634677; box-shadow:0 8rpx 22rpx rgba(70,45,82,.18),0 0 0 5rpx rgba(99,70,119,.1); animation:session-current-breathe 2.4s ease-in-out infinite; }
.session-node.is-done { color:#6c5278; }
.session-node.is-done .session-node__disc { color:#fff; border-color:#846d90; background:#846d90; }
.session-node.is-just-done .session-node__disc { animation:check-disc-pop 420ms cubic-bezier(.2,1.4,.35,1) both; }
.session-node.is-just-done .session-node__check { animation:check-mark-draw 320ms 80ms cubic-bezier(.16,1,.3,1) both; }
.session-step { margin-top:34rpx; padding:32rpx; border:1rpx solid rgba(255,255,255,.9); border-radius:36rpx; background:rgba(255,255,255,.68); box-shadow:inset 0 2rpx 12rpx rgba(255,255,255,.8),0 14rpx 38rpx rgba(66,43,75,.07); animation:care-step-in 220ms ease-out both; }
.session-step__eyebrow,.session-step__title,.session-step__instruction { display:block; }
.session-step__eyebrow { color:#927f9a; font:600 var(--cisme-text-micro)/1.3 Georgia,"Times New Roman",serif; letter-spacing:4rpx; }
.session-step__title { margin-top:14rpx; color:#3c2948; font-family:"Songti SC","STSong",serif; font-size:42rpx; font-weight:400; line-height:1.3; }
.session-step__instruction { margin-top:18rpx; color:#665d69; font-size:var(--cisme-text-body); line-height:1.8; }
.session-step__cue { display:flex; align-items:center; gap:12rpx; margin-top:22rpx; padding:18rpx 20rpx; border-radius:24rpx; color:#634d6d; background:#eee5f2; font-size:var(--cisme-text-small); line-height:1.5; }
.session-step__cue-icon { flex:none; width:32rpx; height:32rpx; }
.session-primary { display:flex; align-items:center; justify-content:center; width:100%; min-height:104rpx; margin-top:24rpx; border-radius:999rpx; color:#fff; background:linear-gradient(180deg,#76548b,#402851); box-shadow:inset 0 2rpx 5rpx rgba(255,255,255,.42),0 14rpx 30rpx rgba(57,35,68,.18); font-size:var(--cisme-text-action); line-height:1.25; }
.session-footnote { display:block; margin:16rpx 20rpx 0; color:#918794; font-size:var(--cisme-text-micro); line-height:1.55; text-align:center; }
.session-assessment { padding-bottom:24rpx; }
.session-complete { display:flex; align-items:center; gap:14rpx; margin-bottom:26rpx; color:#61466e; font-size:var(--cisme-text-small); font-weight:500; }
.session-complete__ring { display:flex; align-items:center; justify-content:center; width:52rpx; height:52rpx; border-radius:50%; background:#eee4f2; box-shadow:0 0 0 6rpx rgba(110,79,128,.08); animation:completion-ring-in 460ms cubic-bezier(.2,1.4,.35,1) both; }
.session-complete__icon { width:28rpx; height:28rpx; animation:check-mark-draw 320ms 100ms cubic-bezier(.16,1,.3,1) both; }
.assessment-list { display:grid; gap:12rpx; margin-top:24rpx; }
.assessment-option { display:flex; align-items:center; justify-content:space-between; width:100%; min-height:100rpx; padding:18rpx 20rpx; border:1rpx solid rgba(91,64,105,.12); border-radius:26rpx; color:#4c3b52; background:rgba(244,238,246,.72); text-align:left; }
.assessment-option__title,.assessment-option__note { display:block; }
.assessment-option__title { font-size:var(--cisme-text-body); font-weight:500; line-height:1.4; }
.assessment-option__note { margin-top:6rpx; color:#75697a; font-size:var(--cisme-text-small); line-height:1.4; }
.assessment-option__check { display:flex; align-items:center; justify-content:center; flex:none; width:44rpx; height:44rpx; margin-left:18rpx; border:1rpx solid rgba(96,69,111,.25); border-radius:50%; color:transparent; }
.assessment-option__check-icon { width:24rpx; height:24rpx; }
.assessment-option.is-selected { border-color:rgba(92,62,112,.42); background:#eadff0; box-shadow:0 8rpx 20rpx rgba(71,47,83,.08); }
.assessment-option.is-selected .assessment-option__check { color:#fff; border-color:#67467b; background:#67467b; }
.care-session--reduced,
.care-session--reduced .care-session__sheet,
.care-session--reduced .session-step,
.care-session--reduced .session-node__disc,
.care-session--reduced .session-node__check,
.care-session--reduced .session-complete__ring,
.care-session--reduced .session-complete__icon { animation:none; transition:none; }

@keyframes care-step-in { from { opacity:.55; transform:translateY(10rpx); } to { opacity:1; transform:translateY(0); } }
@keyframes session-current-breathe { 0%,100% { transform:scale(1); } 50% { transform:scale(1.055); } }
@keyframes check-disc-pop { 0% { opacity:.55; transform:scale(.55); } 58% { opacity:1; transform:scale(1.15); } 100% { opacity:1; transform:scale(1); } }
@keyframes check-mark-draw { from { opacity:0; transform:scale(.2) rotate(-16deg); } to { opacity:1; transform:scale(1) rotate(0); } }
@keyframes completion-ring-in { from { opacity:0; transform:scale(.55); } to { opacity:1; transform:scale(1); } }

/* Recovery stays inside the native sheet; other navigation remains available. */
.session-error { margin: 12rpx 0; padding: 16rpx 20rpx; border: 1rpx solid rgba(91,64,105,.18); border-radius: 20rpx; font-size: var(--cisme-text-micro); line-height: 1.5; }
.session-error text { display: block; }
.session-error .text-button { margin-top: 8rpx; min-height: var(--cisme-hit-target); }
.session-usage { margin-top: 16rpx; }
.usage-products { display: flex; flex-direction: column; gap: 14rpx; margin-top: 24rpx; }
.usage-product { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 112rpx; margin: 0; padding: 20rpx 24rpx; border: 2rpx solid #e7dfea; border-radius: 24rpx; color: #403347; background: #fff; text-align: left; line-height: 1.4; transition: background 180ms ease, border-color 180ms ease; }
.usage-product.is-selected { border-color: #876b98; background: #f0e8f4; }
.usage-product__copy { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.usage-product__name { font-size: var(--cisme-text-body); font-weight: 500; }
.usage-product__hint { margin-top: 6rpx; color: #75697b; font-size: var(--cisme-text-small); }
.usage-product__check { display: flex; flex: none; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; margin-left: 24rpx; border: 2rpx solid #bcaec5; border-radius: 12rpx; }
.is-selected .usage-product__check { border-color: #6b4e7d; background: #6b4e7d; }
.usage-product__check image { width: 28rpx; height: 28rpx; }
.usage-note-label { display: flex; align-items: baseline; gap: 12rpx; margin: 26rpx 0 14rpx; color: #493b51; font-size: var(--cisme-text-body); }
.usage-note-label__optional { color: #81728a; font-size: var(--cisme-text-small); }
.usage-note { box-sizing: border-box; width: 100%; height: 144rpx; padding: 20rpx 24rpx; border: 1rpx solid #e3dae8; border-radius: 24rpx; color: #493b51; background: #fff; font-size: var(--cisme-text-body); line-height: 1.6; }
.home-page--reduced .usage-product { transition: none; }
/* Approved product-focused composition; all primary content shares one axis. */

.guest-care-steps {
  display:flex; flex-direction:column; width:100%; max-width:460px; margin:18px auto 0; padding:4px 14px;
  border-radius:var(--cisme-radius-card); background:var(--cisme-surface); text-align:left;
}
.guest-care-step {
  display:flex; align-items:baseline; gap:12px; padding:10px 0;
  border-bottom:1rpx solid var(--cisme-line);
}
.guest-care-step__label { flex:none; color:var(--cisme-plum); font-size:var(--cisme-text-body); font-weight:600; }
.guest-care-step__instruction { flex:1; min-width:0; color:var(--cisme-ink); font-size:var(--cisme-text-small); line-height:1.6; }
