.home-page {
  position: fixed;
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  color: #2f2149;
  background: #e9e1ee;
}

.home-background {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  animation: home-background-breathe 18s cubic-bezier(.45, 0, .55, 1) infinite alternate;
  transform-origin: 58% 45%;
}

.care-console {
  position: absolute;
  z-index: 2;
  top: 22.8%;
  left: 7.4%;
  width: 85.2%;
  text-align: center;
  animation: care-console-enter 420ms cubic-bezier(.16, 1, .3, 1) both;
}

.brand-wordmark {
  color: #322249;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 54rpx;
  line-height: 1;
  letter-spacing: 7rpx;
}

.care-greeting {
  margin: 52rpx 0 30rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 58rpx;
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: 4rpx;
  overflow-wrap: anywhere;
  white-space: normal;
}

.care-greeting--long { font-size: 42rpx; line-height: 1.22; letter-spacing: 2rpx; }
.care-greeting--very-long { font-size: 32rpx; line-height: 1.25; letter-spacing: 1rpx; }

.home-authority-state {
  margin: 84rpx auto 0;
  color: #62586a;
  font-size: 28rpx;
  line-height: 1.6;
  letter-spacing: 2rpx;
}
.home-auth-retry { display:flex; margin:16rpx auto 0; }

.today-marker {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #75697a;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.today-marker__line {
  width: 68rpx;
  height: 1rpx;
  background: rgba(94, 78, 103, .25);
}

.protocol-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  width: 100%;
  min-height: 100rpx;
  margin-top: 24rpx;
  padding: 0;
  border: 0;
  color: #2f2149;
  background: transparent;
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 400;
}

.protocol-title__copy { min-width:0; text-align:left; }
.protocol-title__hint { display:block; max-width:440rpx; margin-top:8rpx; overflow:hidden; color:#7d7281; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif; font-size:var(--cisme-text-small); line-height:1.45; text-overflow:ellipsis; white-space:nowrap; }

.protocol-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border: 1rpx solid rgba(255, 255, 255, .65);
  border-radius: 50%;
  background: rgba(213, 201, 230, .31);
  box-shadow: inset 0 2rpx 12rpx rgba(255, 255, 255, .7), 0 6rpx 16rpx rgba(75, 50, 96, .06);
}

.protocol-icon__asset {
  width: 48rpx;
  height: 48rpx;
  opacity: .68;
}

.protocol-number {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 50rpx;
}

.care-cta {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82%;
  height: 120rpx;
  min-height: 120rpx;
  margin: 40rpx auto 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, .88);
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(180deg, rgba(122, 88, 145, .55), rgba(57, 29, 77, .96) 56%, rgba(78, 44, 102, .95));
  box-shadow: inset 0 3rpx 8rpx rgba(255, 255, 255, .84), inset 0 -12rpx 25rpx rgba(26, 9, 44, .35), 0 16rpx 30rpx rgba(55, 30, 82, .22), 0 0 0 4rpx rgba(129, 94, 153, .3), 0 0 0 7rpx rgba(255, 255, 255, .55);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", sans-serif;
  font-size: 20px;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 5rpx rgba(22, 8, 37, .45);
  transition: opacity 180ms ease, transform 180ms cubic-bezier(.16, 1, .3, 1), box-shadow 220ms ease;
}

.care-cta__highlight {
  position: absolute;
  top: 3rpx;
  right: 16%;
  left: 16%;
  height: 2rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .72);
  opacity: .78;
  animation: care-cta-highlight 3.8s ease-in-out infinite;
}

.care-cta:active { transform: scale(.982); }

.care-cta__label {
  position: relative;
  z-index: 1;
  display: block;
  color: #fff;
  font-size: 20px;
  font-weight: 400;
  line-height: 25px;
  transform: translateY(1px);
}

.protocol-rail {
  position: relative;
  display: flex;
  width: 96%;
  height: 166rpx;
  margin: 0 auto;
  padding: 14rpx 20rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, .64);
  border-radius: 74rpx;
  background: rgba(248, 245, 249, .34);
  box-shadow: inset 0 2rpx 22rpx rgba(255, 255, 255, .62), 0 9rpx 19rpx rgba(69, 45, 85, .08);
}

.protocol-line {
  position: absolute;
  top: 44rpx;
  left: 12%;
  right: 12%;
  height: 1rpx;
  overflow: hidden;
  background: rgba(101, 88, 106, .26);
}

.protocol-line__fill,
.session-rail__fill {
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, #8d75a0, #573769);
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 320ms cubic-bezier(.16, 1, .3, 1);
}

.protocol-step {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  padding: 0;
  border: 0;
  color: #716a75;
  background: transparent;
  line-height:1;
}

.step-code {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border: 1rpx solid rgba(103, 88, 108, .33);
  border-radius: 50%;
  background: rgba(242, 237, 244, .7);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 32rpx;
}

.step-label {
  margin-top: 8rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
}

.step-state {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 26rpx;
  margin-top: 8rpx;
  border: 1rpx solid rgba(97, 85, 102, .35);
  border-radius: 50%;
  color: transparent;
  font-size: var(--cisme-text-micro);
}
.step-state__icon { width:20rpx; height:20rpx; }

.protocol-step.is-active,
.protocol-step.is-done {
  color: #412758;
}

.protocol-step.is-active .step-code {
  border-color: #796092;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, .62), 0 0 0 6rpx rgba(103, 71, 124, .22);
}

.protocol-step.is-active .step-state {
  border-color: #5c3d76;
  color: #5c3d76;
}

.protocol-step.is-active .step-state__icon {
  animation: active-drop-breathe 2.4s ease-in-out infinite;
}

.protocol-step.is-done .step-state {
  border-color: #66427f;
  color: #fff;
  background: #66427f;
}

.protocol-step.is-done .step-code {
  border-color: rgba(103, 71, 124, .48);
  background: rgba(237, 228, 241, .9);
}

.protocol-step.is-just-done .step-state {
  animation: check-disc-pop 420ms cubic-bezier(.2, 1.4, .35, 1) both;
}

.protocol-step.is-just-done .step-state__icon {
  animation: check-mark-draw 320ms 80ms cubic-bezier(.16, 1, .3, 1) both;
}

.care-signal {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  width: 88%;
  min-height: 82rpx;
  margin: 34rpx auto 0;
  padding: 14rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, .55);
  border-radius: 28rpx;
  color: #655a69;
  background: rgba(248, 245, 249, .28);
  box-shadow: inset 0 1rpx 10rpx rgba(255, 255, 255, .45);
  text-align: left;
}

.care-signal__icon {
  flex: none;
  width: 38rpx;
  height: 38rpx;
}

.care-signal__copy { min-width: 0; }
.care-signal__title,
.care-signal__meta { display: block; }
.care-signal__title { color:#514358; font-size:24rpx; font-weight:500; line-height:1.35; }
.care-signal__meta { margin-top:3rpx; color:#7f7483; font-size:20rpx; line-height:1.4; }

.home-error {
  position: absolute;
  z-index: 20;
  left: 38rpx;
  right: 38rpx;
  bottom: calc(var(--cisme-safe-bottom, env(safe-area-inset-bottom)) + 142rpx);
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  color: #8d3150;
  background: rgba(248, 232, 237, .92);
  text-align: center;
}

.home-error__copy { display:block; line-height:1.55; }
.home-error .text-button { display:flex; width:100%; margin:12rpx auto 0; }

@media (max-height: 700px) {
  .care-console { top: 17.2%; }
  .care-greeting { margin-top: 24rpx; font-size: 46rpx; }
  .care-cta { min-height: 92rpx; margin-top: 18rpx; }
  .protocol-rail { height: 124rpx; }
  .step-code { width:58rpx; height:58rpx; }
  .protocol-line { top:38rpx; }
  .step-label { margin-top:4rpx; }
  .step-state { width:22rpx; height:22rpx; margin-top:4rpx; }
  .care-signal { min-height:66rpx; margin-top:14rpx; padding:8rpx 18rpx; }
  .care-signal__meta { display:none; }
}

.home-support{position:absolute;z-index:3;top:var(--cisme-menu-top,48px);left:28rpx;display:flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:1rpx solid rgba(255,255,255,.86);border-radius:50%;background:rgba(255,255,255,.72);box-shadow:0 8rpx 24rpx rgba(50,31,62,.09)}.home-support image{width:40rpx;height:40rpx}.home-support__badge{position:absolute;top:-5rpx;right:-9rpx;display:flex;align-items:center;justify-content:center;min-width:30rpx;height:30rpx;padding:0 8rpx;border:3rpx solid #f5eef6;border-radius:999rpx;color:#fff;background:#8d3150;font-size:20rpx;line-height:1}

.care-session { position:fixed; z-index:80; top:0; right:0; bottom:0; left:0; display:flex; align-items:flex-end; justify-content:center; padding-top:120rpx; background:rgba(37,24,43,.42); opacity:0; pointer-events:none; -webkit-backdrop-filter:blur(10rpx); transform:translateZ(0); transition:opacity 200ms ease-out; }
.care-session--visible { opacity:1; pointer-events:auto; }
.care-session__sheet { width:100%; max-height:calc(100vh - 120rpx); padding:14rpx 32rpx calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 34rpx); overflow-y:auto; border:1rpx solid rgba(255,255,255,.88); border-radius:48rpx 48rpx 0 0; background:linear-gradient(180deg,rgba(253,250,253,.98),rgba(246,239,248,.99)); box-shadow:0 -30rpx 80rpx rgba(46,27,55,.2); opacity:.7; transform:translate3d(0,58rpx,0) scale(.975); transform-origin:50% 100%; transition:transform 320ms cubic-bezier(.16,1,.3,1),opacity 200ms ease-out; }
.care-session--visible .care-session__sheet { opacity:1; transform:translate3d(0,0,0) scale(1); }
.care-session--closing .care-session__sheet { transition-duration:260ms,180ms; }
.care-session__handle { width:68rpx; height:8rpx; margin:0 auto 18rpx; border-radius:999rpx; background:rgba(91,70,99,.2); }
.care-session__topline { display:flex; align-items:center; justify-content:space-between; min-height:var(--cisme-hit-target); }
.care-session__summary { display:flex; align-items:center; gap:16rpx; }
.care-session__milestone { color:#7c6688; font:600 var(--cisme-text-small)/1.2 Georgia,"Times New Roman",serif; letter-spacing:4rpx; }
.care-session__progress { display:flex; align-items:center; justify-content:center; min-width:72rpx; height:42rpx; padding:0 14rpx; border-radius:999rpx; color:#624b6d; background:#eee5f2; font-size:var(--cisme-text-micro); line-height:1; }
.care-session__close { display:flex; align-items:center; justify-content:center; min-width:64px; height:44px; padding:0 20rpx; border-radius:999rpx; color:#604b68; background:rgba(232,222,236,.76); font-size:var(--cisme-text-small); line-height:1; }
.session-rail { position:relative; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:18rpx; margin:22rpx 2rpx 0; }
.session-rail__line { position:absolute; top:34rpx; right:10%; left:10%; height:2rpx; overflow:hidden; background:rgba(91,64,105,.16); }
.session-node { position:relative; z-index:1; display:flex; align-items:center; flex-direction:column; color:#9a8f9d; }
.session-node__disc { display:flex; align-items:center; justify-content:center; width:68rpx; height:68rpx; border:1rpx solid rgba(95,73,105,.18); border-radius:50%; background:#f1eaf3; transition:transform 260ms cubic-bezier(.16,1,.3,1),background 220ms ease,box-shadow 220ms ease; }
.session-node__code { font:var(--cisme-text-small)/1 Georgia,"Times New Roman",serif; }
.session-node__check { width:28rpx; height:28rpx; }
.session-node__label { margin-top:8rpx; font-size:var(--cisme-text-micro); line-height:1.3; }
.session-node.is-current { color:#56386a; }
.session-node.is-current .session-node__disc { color:#fff; border-color:#634677; background:#634677; box-shadow:0 8rpx 22rpx rgba(70,45,82,.18),0 0 0 5rpx rgba(99,70,119,.1); animation:session-current-breathe 2.4s ease-in-out infinite; }
.session-node.is-done { color:#6c5278; }
.session-node.is-done .session-node__disc { color:#fff; border-color:#846d90; background:#846d90; }
.session-node.is-just-done .session-node__disc { animation:check-disc-pop 420ms cubic-bezier(.2,1.4,.35,1) both; }
.session-node.is-just-done .session-node__check { animation:check-mark-draw 320ms 80ms cubic-bezier(.16,1,.3,1) both; }
.session-step { margin-top:34rpx; padding:32rpx; border:1rpx solid rgba(255,255,255,.9); border-radius:36rpx; background:rgba(255,255,255,.68); box-shadow:inset 0 2rpx 12rpx rgba(255,255,255,.8),0 14rpx 38rpx rgba(66,43,75,.07); animation:care-step-in 220ms ease-out both; }
.session-step__eyebrow,.session-step__title,.session-step__instruction { display:block; }
.session-step__eyebrow { color:#927f9a; font:600 var(--cisme-text-micro)/1.3 Georgia,"Times New Roman",serif; letter-spacing:4rpx; }
.session-step__title { margin-top:14rpx; color:#3c2948; font-family:"Songti SC","STSong",serif; font-size:42rpx; font-weight:400; line-height:1.3; }
.session-step__instruction { margin-top:18rpx; color:#665d69; font-size:var(--cisme-text-body); line-height:1.8; }
.session-step__cue { display:flex; align-items:center; gap:12rpx; margin-top:22rpx; padding:18rpx 20rpx; border-radius:24rpx; color:#634d6d; background:#eee5f2; font-size:var(--cisme-text-small); line-height:1.5; }
.session-step__cue-icon { flex:none; width:32rpx; height:32rpx; }
.session-primary { display:flex; align-items:center; justify-content:center; width:100%; min-height:104rpx; margin-top:24rpx; border-radius:999rpx; color:#fff; background:linear-gradient(180deg,#76548b,#402851); box-shadow:inset 0 2rpx 5rpx rgba(255,255,255,.42),0 14rpx 30rpx rgba(57,35,68,.18); font-size:var(--cisme-text-action); line-height:1.25; }
.session-footnote { display:block; margin:16rpx 20rpx 0; color:#918794; font-size:var(--cisme-text-micro); line-height:1.55; text-align:center; }
.session-assessment { padding-bottom:24rpx; }
.session-complete { display:flex; align-items:center; gap:14rpx; margin-bottom:26rpx; color:#61466e; font-size:var(--cisme-text-small); font-weight:500; }
.session-complete__ring { display:flex; align-items:center; justify-content:center; width:52rpx; height:52rpx; border-radius:50%; background:#eee4f2; box-shadow:0 0 0 6rpx rgba(110,79,128,.08); animation:completion-ring-in 460ms cubic-bezier(.2,1.4,.35,1) both; }
.session-complete__icon { width:28rpx; height:28rpx; animation:check-mark-draw 320ms 100ms cubic-bezier(.16,1,.3,1) both; }
.assessment-list { display:grid; gap:12rpx; margin-top:24rpx; }
.assessment-option { display:flex; align-items:center; justify-content:space-between; width:100%; min-height:100rpx; padding:18rpx 20rpx; border:1rpx solid rgba(91,64,105,.12); border-radius:26rpx; color:#4c3b52; background:rgba(244,238,246,.72); text-align:left; }
.assessment-option__title,.assessment-option__note { display:block; }
.assessment-option__title { font-size:var(--cisme-text-body); font-weight:500; line-height:1.4; }
.assessment-option__note { margin-top:6rpx; color:#75697a; font-size:var(--cisme-text-small); line-height:1.4; }
.assessment-option__check { display:flex; align-items:center; justify-content:center; flex:none; width:44rpx; height:44rpx; margin-left:18rpx; border:1rpx solid rgba(96,69,111,.25); border-radius:50%; color:transparent; }
.assessment-option__check-icon { width:24rpx; height:24rpx; }
.assessment-option.is-selected { border-color:rgba(92,62,112,.42); background:#eadff0; box-shadow:0 8rpx 20rpx rgba(71,47,83,.08); }
.assessment-option.is-selected .assessment-option__check { color:#fff; border-color:#67467b; background:#67467b; }
.home-page--reduced .home-background,
.home-page--reduced .care-console,
.home-page--reduced .care-cta__highlight,
.home-page--reduced .protocol-step,
.home-page--reduced .step-state,
.home-page--reduced .step-state__icon,
.care-session--reduced,
.care-session--reduced .care-session__sheet,
.care-session--reduced .session-step,
.care-session--reduced .session-node__disc,
.care-session--reduced .session-node__check,
.care-session--reduced .session-complete__ring,
.care-session--reduced .session-complete__icon { animation:none; transition:none; }

@keyframes care-step-in { from { opacity:.55; transform:translateY(10rpx); } to { opacity:1; transform:translateY(0); } }
@keyframes home-background-breathe { from { transform:scale(1); } to { transform:scale(1.018); } }
@keyframes care-console-enter { from { opacity:0; transform:translateY(18rpx); } to { opacity:1; transform:translateY(0); } }
@keyframes care-cta-highlight { 0%,100% { opacity:.45; transform:scaleX(.7); } 50% { opacity:.88; transform:scaleX(1); } }
@keyframes active-drop-breathe { 0%,100% { opacity:.68; transform:scale(.84); } 50% { opacity:1; transform:scale(1); } }
@keyframes session-current-breathe { 0%,100% { transform:scale(1); } 50% { transform:scale(1.055); } }
@keyframes check-disc-pop { 0% { opacity:.55; transform:scale(.55); } 58% { opacity:1; transform:scale(1.15); } 100% { opacity:1; transform:scale(1); } }
@keyframes check-mark-draw { from { opacity:0; transform:scale(.2) rotate(-16deg); } to { opacity:1; transform:scale(1) rotate(0); } }
@keyframes completion-ring-in { from { opacity:0; transform:scale(.55); } to { opacity:1; transform:scale(1); } }

/* Recovery stays inside the native sheet; other navigation remains available. */
.session-error { margin: 12rpx 0; padding: 16rpx 20rpx; border: 1rpx solid rgba(91,64,105,.18); border-radius: 20rpx; font-size: var(--cisme-text-micro); line-height: 1.5; }
.session-error text { display: block; }
.session-error .text-button { margin-top: 8rpx; min-height: 72rpx; }
