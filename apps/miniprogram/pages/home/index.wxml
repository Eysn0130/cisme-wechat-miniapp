<page-meta root-font-size="system"/>
<view class="home-page {{reducedMotion ? 'home-page--reduced' : ''}}" style="{{chromeStyle}}">
  <button class="home-support {{accountOpening || sessionMounted || onboardingOpen ? 'control--disabled' : ''}}" bindtap="openSupport" disabled="{{accountOpening || sessionMounted || onboardingOpen}}" aria-hidden="{{sessionMounted || onboardingOpen}}" aria-label="打开 CISME 客服{{supportState === 'ready' ? (supportUnread ? '，有 ' + supportUnread + ' 条未读消息' : '，没有未读消息') : supportState === 'error' ? '，未读数量暂未确认' : '，未读数量同步中'}}"><image src="/assets/icons/chat-circle-plum.svg" mode="aspectFit"/><text wx:if="{{supportUnread}}" class="home-support__badge">{{supportUnread > 99 ? '99+' : supportUnread}}</text></button>
  <image class="home-background" src="/assets/cisme/cisme-home-background-v1.jpg" mode="aspectFill" />
  <view class="care-console care-console--centered" aria-hidden="{{sessionMounted || onboardingOpen}}">
    <view class="brand-wordmark">CISME</view>
    <block wx:if="{{authorityAvailable || needsAuthentication}}">
      <view class="centered-date">{{centerDate}}</view>
      <view class="centered-title">{{centerTitle}}</view>
      <view class="centered-copy"><text wx:for="{{centerCopy}}" wx:key="*this">{{item}}</text></view>
      <view class="centered-products" aria-label="{{usageToday ? '今天实际用过的产品' : '可记录的护理产品'}}">
        <view wx:for="{{centerProducts}}" wx:key="id" class="centered-product {{index > 0 ? 'centered-product--divided' : ''}}"><image src="/assets/icons/drop-active.svg" mode="aspectFit" aria-hidden="true"/><text>{{item.label}}</text></view>
      </view>
      <button class="care-cta {{loading || working || activationConfirming || sessionMounted || onboardingOpen || (!authorityAvailable && !needsAuthentication) || !view.actionable ? 'control--disabled' : ''}}" loading="{{working}}" disabled="{{loading || working || activationConfirming || sessionMounted || onboardingOpen || (!authorityAvailable && !needsAuthentication) || !view.actionable}}" bindtap="primaryAction" hover-class="care-cta--pressed"><text class="care-cta__label">{{working ? '正在提交…' : mutationState === 'unknown' ? '重试操作' : centerAction}}</text></button>
      <view wx:if="{{usageReady && !needsAuthentication}}" class="centered-continuity" aria-live="polite"><text wx:if="{{rewardLabel}}" class="centered-reward">{{rewardLabel}}</text><text>已连续记录 <text class="centered-continuity__number">{{usageStreak}}</text> 天</text></view>
    </block>
    <view wx:elif="{{loading}}" class="home-authority-state" aria-live="polite">正在加载护理安排…</view>
    <view wx:else class="home-authority-state" aria-live="assertive">护理状态暂不可用，请重试。</view>
  </view>
  <view class="care-signal care-signal--centered" aria-hidden="{{sessionMounted || onboardingOpen}}" aria-live="polite">
    <image class="care-signal__icon" src="{{view.signalIcon}}" mode="aspectFit" aria-hidden="true"/>
    <view class="care-signal__copy"><strong class="care-signal__title">{{needsAuthentication ? '你的护理记录' : usageReady ? (usageToday ? '今日的护理已记录' : '今天还没有护理记录') : loading ? '护理记录同步中' : '今日记录暂未确认'}}</strong><text class="care-signal__meta">{{needsAuthentication ? '登录后，为你保存' : usageReady ? (usageToday ? '用过的产品与感受，都已保存' : '往日的护理，都为你保存') : '可从详情回看已保存的记录'}}</text></view>
    <button class="care-signal__details {{accountOpening || sessionMounted || onboardingOpen ? 'control--disabled' : ''}}" bindtap="openRecords" disabled="{{accountOpening || sessionMounted || onboardingOpen}}" hover-class="care-signal__details--pressed" aria-label="{{needsAuthentication ? '登录后查看护理记录' : '查看护理记录详情'}}"><text>详情</text><image src="/assets/icons/caret-right-muted.svg" mode="aspectFit" aria-hidden="true"/></button>
  </view>
  <view wx:if="{{error && !sessionMounted}}" class="home-error" aria-live="assertive"><text class="home-error__copy">{{error}}</text><button class="text-button" bindtap="retryLoad">刷新状态</button><button wx:if="{{mutationState === 'unknown'}}" class="text-button {{working || loading ? 'control--disabled' : ''}}" bindtap="retryCareMutation" disabled="{{working || loading}}">重试操作</button></view>

  <view wx:if="{{sessionMounted}}" class="care-session {{sessionVisible ? 'care-session--visible' : ''}} {{sessionClosing ? 'care-session--closing' : ''}} {{reducedMotion ? 'care-session--reduced' : ''}}" catchtap="closeCareSession" aria-label="本次护理步骤" aria-role="dialog" aria-modal="true">
    <view class="care-session__sheet" catchtap="stopPropagation">
      <view class="care-session__handle"></view>
      <view class="care-session__topline"><view class="care-session__summary"><text class="care-session__milestone">{{sessionLabel}}</text><text wx:if="{{sessionStage !== 'usage'}}" class="care-session__progress" aria-live="polite">{{sessionProgressLabel}}</text></view><button class="care-session__close sheet-dismiss {{working ? 'control--disabled' : ''}}" bindtap="closeCareSession" disabled="{{working}}" aria-label="关闭本次护理">关闭</button></view>
      <view wx:if="{{error || mutationState === 'unknown'}}" class="session-error" aria-live="assertive">
        <text>{{error || '保存结果尚未确认，请先查看最新记录。'}}</text>
        <button class="text-button {{working || loading ? 'control--disabled' : ''}}" bindtap="retryLoad" disabled="{{working || loading}}">刷新记录</button>
        <button wx:if="{{mutationState === 'unknown'}}" class="text-button {{working || loading ? 'control--disabled' : ''}}" bindtap="retryCareMutation" disabled="{{working || loading}}">重试保存</button>
      </view>
      <view wx:if="{{sessionStage !== 'usage'}}" class="session-rail">
        <view class="session-rail__line"><view class="session-rail__fill" style="{{sessionProgressStyle}}"></view></view>
        <view wx:for="{{sessionSteps}}" wx:key="code" class="session-node {{item.done ? 'is-done' : ''}} {{item.current ? 'is-current' : ''}} {{item.justDone ? 'is-just-done' : ''}}"><view class="session-node__disc"><image wx:if="{{item.done}}" class="session-node__check" src="/assets/icons/check-white.svg" mode="aspectFit"/><text wx:else class="session-node__code">{{item.code}}</text></view><small class="session-node__label">{{item.label}}</small></view>
      </view>
      <block wx:if="{{sessionStage === 'usage'}}">
        <view class="session-usage">
          <strong class="session-step__title">今天，如何照顾头皮？</strong>
          <text class="session-step__instruction">选择今天用过的产品，可多选。</text>
          <view class="usage-products" aria-label="今日使用产品，可多选">
            <button wx:for="{{productOptions}}" wx:key="id" class="usage-product {{item.selected ? 'is-selected' : ''}} {{working || mutationState === 'unknown' ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="toggleCareProduct" disabled="{{working || mutationState === 'unknown'}}" aria-role="checkbox" aria-checked="{{item.selected}}">
              <view class="usage-product__copy"><text class="usage-product__name">{{item.label}}</text><text class="usage-product__hint">{{item.hint}}</text></view>
              <view class="usage-product__check"><image wx:if="{{item.selected}}" src="/assets/icons/check-white.svg" mode="aspectFit"/></view>
            </button>
          </view>
          <view class="usage-note-label"><text>护理感受</text><text class="usage-note-label__optional">选填</text></view>
          <textarea class="usage-note" value="{{sessionNote}}" bindinput="careNoteInput" maxlength="500" placeholder="留下一点今天的感受…" disabled="{{working || mutationState === 'unknown'}}" cursor-spacing="28" aria-label="护理感受，选填，最多500字"/>
        </view>
        <button class="session-primary {{!sessionProducts.length || working || mutationState === 'unknown' ? 'control--disabled' : ''}}" bindtap="continueCareUsage" disabled="{{!sessionProducts.length || working || mutationState === 'unknown'}}" loading="{{working}}">{{working ? '正在保存…' : sessionCycleDue ? '继续四步护理' : sessionSubmitLabel}}</button>
        <text class="session-footnote">{{sessionCycleDue ? '完成四步并记录护理后感受，一起保存本次护理。' : '同一天调整记录不会重复获得打卡积分。'}}</text>
      </block>
      <block wx:elif="{{sessionStage === 'steps'}}">
        <view class="session-step" aria-live="polite">
          <text class="session-step__eyebrow">{{sessionStep.eyebrow}} · STEP {{sessionStep.code}}</text>
          <strong class="session-step__title">{{sessionStep.title}}</strong>
          <text class="session-step__instruction">{{sessionStep.instruction}}</text>
          <view class="session-step__cue"><image class="session-step__cue-icon" src="/assets/icons/check-circle-plum.svg" mode="aspectFit"/><text>{{sessionStep.cue}}</text></view>
        </view>
        <button class="session-primary" bindtap="advanceCareStep">{{sessionStepIndex === 3 ? '完成步骤，记录感受' : '完成本步，继续'}}</button>
        <text class="session-footnote">持续不适时，请停止使用并咨询专业人士。</text>
      </block>
      <block wx:else>
        <view class="session-step session-assessment" aria-live="polite">
          <view class="session-complete"><view class="session-complete__ring"><image class="session-complete__icon" src="/assets/icons/check-plum.svg" mode="aspectFit"/></view><text>四步护理已完成</text></view>
          <text class="session-step__eyebrow">AFTER CARE</text>
          <strong class="session-step__title">护理后感觉如何？</strong>
          <text class="session-step__instruction">记录这次护理后的感受。</text>
          <view class="assessment-list">
            <button wx:for="{{assessments}}" wx:key="value" class="assessment-option {{sessionAssessment === item.value ? 'is-selected' : ''}} {{working || mutationState === 'unknown' ? 'control--disabled' : ''}}" data-value="{{item.value}}" disabled="{{working || mutationState === 'unknown'}}" bindtap="selectAssessment"><view><strong class="assessment-option__title">{{item.label}}</strong><small class="assessment-option__note">{{item.note}}</small></view><view class="assessment-option__check"><image wx:if="{{sessionAssessment === item.value}}" class="assessment-option__check-icon" src="/assets/icons/check-white.svg" mode="aspectFit"/></view></button>
          </view>
        </view>
        <button class="session-primary {{!sessionAssessment || working || mutationState === 'unknown' ? 'control--disabled' : ''}}" loading="{{working}}" disabled="{{!sessionAssessment || working || mutationState === 'unknown'}}" bindtap="submitCareSession">{{working ? '正在保存…' : mutationState === 'unknown' ? '保存结果待确认' : sessionSubmitLabel}}</button>
        <text class="session-footnote">完成时间、四个步骤和本次感受将保存到护理记录。<text wx:if="{{care}}">积分以对应护理任务的规则为准。</text></text>
      </block>
    </view>
  </view>
  <care-onboarding id="care-onboarding" wx:if="{{onboardingOpen}}" required="{{true}}" bindcomplete="completeOnboarding"/>
</view>
