.task-page { padding-right:24rpx; padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 164rpx); padding-left:24rpx; background:linear-gradient(180deg,#f6f0f8,#fbf8fb); }
.task-page--has-error { padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 280rpx); }
.task-hero { position:relative; min-height:386rpx; padding:46rpx; overflow:hidden; border:1rpx solid rgba(255,255,255,.32); border-radius:54rpx; color:#fff; background:radial-gradient(circle at 86% 12%,rgba(255,255,255,.18),transparent 30%),linear-gradient(145deg,#6d4f84,#3b244f 76%); box-shadow:0 22rpx 46rpx rgba(55,31,71,.18); }
.task-hero__orb { position:absolute; top:-94rpx; right:-70rpx; width:270rpx; height:270rpx; border:1rpx solid rgba(255,255,255,.12); border-radius:50%; }
.task-hero__eyebrow { color:rgba(255,255,255,.82); font-size:var(--cisme-text-small); line-height:1.5; letter-spacing:2rpx; }
.task-hero__title { width:82%; margin-top:30rpx; font-family:"Songti SC","STSong",serif; font-size:46rpx; font-weight:400; line-height:1.25; }
.task-hero__state { margin-top:12rpx; color:rgba(255,255,255,.76); font-size:var(--cisme-text-small); line-height:1.5; }
.task-hero__reward { display:flex; align-items:baseline; gap:10rpx; margin-top:50rpx; }.task-hero__reward-value { font-family:Georgia,"Times New Roman",serif; font-size:58rpx; font-weight:400; line-height:1; }.task-hero__reward-unit { color:rgba(255,255,255,.82); font-size:var(--cisme-text-small); line-height:1.5; }
.task-section { margin-top:24rpx; padding:30rpx; border-radius:46rpx; }
.task-section__title { margin-bottom:28rpx; color:#3b2d42; font-family:"Songti SC","STSong",serif; font-size:29rpx; }
.task-step { display:flex; align-items:center; gap:20rpx; padding:22rpx 0; }
.task-step__index { display:flex; align-items:center; justify-content:center; flex:0 0 auto; width:45rpx; height:45rpx; border:1rpx solid rgba(86,48,111,.18); border-radius:50%; color:#56306f; background:#f0e7f3; font:var(--cisme-text-small) Georgia,serif; }
.task-step__title,.task-step__meta { display:block; }
.task-step__title { color:#3b2d42; font-size:26rpx; font-weight:400; }
.task-step__meta { margin-top:5rpx; color:#8a7f8e; font-size:var(--cisme-text-body); line-height:1.6; }
.task-requirement { display:flex; align-items:flex-start; gap:13rpx; padding:14rpx 0; color:#6f6574; font-size:var(--cisme-text-body); line-height:1.6; }
.task-requirement__icon { flex:0 0 auto; width:26rpx; height:26rpx; margin-top:2rpx; }
.task-notice { display:flex; align-items:flex-start; gap:17rpx; margin-top:24rpx; padding:24rpx 27rpx; border-radius:38rpx; color:#6c5d72; background:rgba(234,224,239,.7); font-size:var(--cisme-text-body); line-height:1.6; }
.task-notice__icon { flex:0 0 auto; width:34rpx; height:34rpx; margin-top:2rpx; }
.task-action { position:fixed; z-index:30; right:20rpx; bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 16rpx); left:20rpx; padding:20rpx 0 0; background:linear-gradient(180deg,rgba(247,243,248,0),rgba(247,243,248,.97) 36%); }
.task-action__button { min-height:50px; margin-top:0; }
.task-action__error { margin:0 10rpx 14rpx; padding:16rpx 20rpx; border-radius:22rpx; color:#74434f; background:rgba(249,232,237,.96); font-size:var(--cisme-text-small); line-height:1.5; }
.task-action__error-title,.task-action__error-copy { display:block; }
.task-error-scene { min-height:520rpx; margin-top:18rpx; }
.task-error-action { margin-top:0; }
