<page-meta root-font-size="system"/>
<view capture-bind:tap="dismissNativeKeyboardOnTap" class="{{management?'management-ui':''}} aftersale-shell {{reducedMotion || !motionActive ? 'loading--still' : ''}}" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back {{busy?'control--disabled':''}}" bindtap="back" disabled="{{busy}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">{{management?'售后管理':'订单售后'}}</text></view>
<view wx:if="{{!management}}" class="buyer-case-page">
  <view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在核对售后记录"><view class="page-read-loading__indicator"/></view>
  <view wx:if="{{error || notice}}" class="buyer-case-feedback" aria-live="polite">
    <text>{{error || notice}}</text>
    <button wx:if="{{error || notice==='售后进度暂未更新，请稍后重试。'}}" class="text-button {{busy || loading ? 'control--disabled' : ''}}" bindtap="retry" disabled="{{busy || loading}}">重试</button>
  </view>
  <view wx:if="{{needsReconcile || locked}}" class="case-recovery">
    <text>上次操作待确认</text>
    <view class="case-recovery__actions">
      <button wx:if="{{locked}}" class="text-button {{!coreReady || busy || loading ? 'control--disabled' : ''}}" bindtap="submit" disabled="{{!coreReady || busy || loading}}">重试上次操作</button>
      <button class="text-button {{!coreReady || busy || loading ? 'control--disabled' : ''}}" bindtap="reconcile" disabled="{{!coreReady || busy || loading}}">核对原记录</button>
    </view>
  </view>

  <block wx:if="{{coreReady && !selected}}">
    <view wx:if="{{!items.length}}" class="buyer-case-feedback">暂无售后记录</view>
    <button wx:for="{{items}}" wx:key="id" class="case-summary {{busy || locked ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="open" disabled="{{busy || locked}}">
      <view class="case-summary__head"><text class="case-summary__status">{{item.label}}</text><text class="case-summary__amount">¥{{item.amountLabel}}</text></view>
      <text class="case-summary__product">{{item.productSummary}}</text>
      <view class="case-summary__foot">
        <text>{{item.kind==='return_refund'?'退货退款':'仅退款'}}</text>
        <view class="case-summary__date"><text>{{item.dateLabel}}</text><image src="/assets/icons/caret-right-muted.svg" class="case-summary__arrow" aria-hidden="true"/></view>
      </view>
    </button>
    <button wx:if="{{nextCursor}}" class="text-button case-more {{busy || locked ? 'control--disabled' : ''}}" bindtap="next" disabled="{{busy || locked}}">查看更多</button>
    <button wx:if="{{orderId && !hasOpenCase}}" class="primary {{busy || locked || needsReconcile ? 'primary--disabled' : ''}}" bindtap="chooseOrderItems" disabled="{{busy || locked || needsReconcile}}"><text class="action-label">{{items.length?'申请剩余商品售后':'选择售后商品'}}</text></button>
  </block>

  <block wx:if="{{coreReady && selected}}">
    <view class="buyer-case-summary">
      <view class="buyer-case-heading">
        <text class="buyer-case-status" aria-role="heading">{{selected.label}}</text>
        <text class="buyer-case-amount">¥{{selected.amountLabel}}</text>
      </view>
      <text class="buyer-case-meta">{{selected.kind==='return_refund'?'退货退款':'仅退款'}}</text>
      <text wx:if="{{selected.state==='awaiting_instruction' && !selected.terminal}}" class="buyer-case-instruction">收到退货地址后再寄出。</text>
      <text wx:if="{{selected.exceptionResolution && !selected.terminal}}" class="buyer-case-instruction">无需寄回，等待退款处理。</text>
    </view>

    <view class="case-section buyer-case-products">
      <text class="case-section__title">本次商品</text>
      <view wx:for="{{selected.lines}}" wx:key="lineId" class="case-product">
        <view class="case-product__text">
          <text class="case-product__name">{{item.productName}}</text>
          <text wx:if="{{item.specification}}" class="case-muted">{{item.specification}}</text>
        </view>
        <text class="case-product__quantity">× {{item.quantity}}</text>
      </view>
      <view wx:if="{{selected.reasonLabel}}" class="buyer-case-reason"><text class="buyer-case-reason__label">申请原因</text><text class="buyer-case-reason__value">{{selected.reasonLabel}}</text></view>
    </view>

    <view wx:if="{{selected.state==='awaiting_return' && !selected.terminal && selected.returnDestination || selected.returnTracking}}" class="case-section">
      <text class="case-section__title">{{selected.state==='awaiting_return' && !selected.terminal ? '退货地址' : '退货物流'}}</text>
      <block wx:if="{{selected.state==='awaiting_return' && !selected.terminal && selected.returnDestination}}">
        <text class="case-body" user-select>{{selected.returnDestination.recipientName}} · {{selected.returnDestination.phone}}</text>
        <text class="case-body" user-select>{{selected.returnDestination.region}} {{selected.returnDestination.address}}</text>
        <text class="case-muted">{{selected.returnDestination.freightPayer==='merchant'?'商家承担运费':selected.returnDestination.freightPayer==='member'?'你承担运费':'运费待确认'}}</text>
        <text wx:if="{{selected.returnDestination.instructions}}" class="case-body">{{selected.returnDestination.instructions}}</text>
      </block>
      <text wx:if="{{selected.returnTracking}}" class="case-body" user-select>{{selected.returnCarrier}} · {{selected.returnTracking}}</text>
      <text wx:if="{{selected.returnRouteReviewRequired}}" class="case-warning">已按旧地址寄件，客服正在核对。</text>
      <text wx:if="{{selected.routeReviewOutcome && !selected.terminal}}" class="case-muted">{{selected.routeReviewOutcome==='carrier_contacted'?'已联系承运商':selected.routeReviewOutcome==='rerouted'?'已协调转寄':'已妥善收到'}}</text>
    </view>

    <view wx:if="{{available.length}}" id="buyer-aftersale-action" class="case-section buyer-case-actions">
      <text wx:if="{{selected.state==='awaiting_return' || selected.state==='need_info'}}" class="case-section__title">{{selected.state==='awaiting_return'?'填写退货运单':'补充说明'}}</text>
      <textarea data-keyboard-field="input" hold-keyboard="{{false}}" show-confirm-bar="{{false}}" confirm-type="return" wx:if="{{selected.state==='need_info'}}" aria-label="补充说明" placeholder="填写要补充的信息" maxlength="500" value="{{note}}" data-field="note" bindinput="edit" disabled="{{busy || locked || needsReconcile}}"/>
      <block wx:if="{{selected.state==='awaiting_return'}}">
        <picker wx:if="{{shipmentOptions.length>1}}" aria-label="实际使用的退货地址" range="{{shipmentOptions}}" value="{{shipmentIndex}}" bindchange="chooseShipmentInstruction" disabled="{{busy || locked || needsReconcile}}"><view class="buyer-case-choice">第 {{shipmentInstruction.version}} 版退货地址<image src="/assets/icons/caret-right-muted.svg" aria-hidden="true"/></view></picker>
        <view wx:if="{{!shipmentInstruction}}" class="buyer-case-feedback">
          <text>退货地址暂不可用</text>
          <button class="text-button {{busy || loading ? 'control--disabled' : ''}}" bindtap="retry" disabled="{{busy || loading}}">刷新</button>
        </view>
        <text wx:elif="{{selected.returnDestination && shipmentInstruction.version!==selected.returnDestination.version}}" class="case-body" user-select>{{shipmentInstruction.recipientName}} · {{shipmentInstruction.phone}} · {{shipmentInstruction.region}} {{shipmentInstruction.address}}</text>
        <input data-keyboard-field="input" hold-keyboard="{{false}}" aria-label="退货快递公司" placeholder="快递公司" value="{{carrier}}" maxlength="80" data-field="carrier" bindinput="edit" disabled="{{busy || locked || needsReconcile}}"/>
        <input data-keyboard-field="input" hold-keyboard="{{false}}" aria-label="退货运单号" placeholder="运单号" value="{{tracking}}" maxlength="64" data-field="tracking" bindinput="edit" disabled="{{busy || locked || needsReconcile}}"/>
      </block>
      <block wx:for="{{available}}" wx:key="action">
        <button wx:if="{{item.action==='ship_return' || item.action==='provide_info'}}" class="primary {{busy || locked || needsReconcile ? 'primary--disabled' : ''}}" data-action="{{item.action}}" bindtap="submit" disabled="{{busy || locked || needsReconcile}}" loading="{{busy}}"><text class="action-label">{{item.label}}</text></button>
        <button wx:else class="text-button buyer-case-cancel {{busy || locked || needsReconcile ? 'control--disabled' : ''}}" data-action="{{item.action}}" bindtap="submit" disabled="{{busy || locked || needsReconcile}}">{{item.action==='report_old_route'?'已按旧地址寄出':item.label}}</button>
      </block>
    </view>

    <view wx:if="{{selected.buyerTimeline.length}}" class="case-section buyer-case-history">
      <text class="case-section__title">处理记录</text>
      <view class="buyer-case-timeline">
        <view wx:for="{{selected.buyerTimeline}}" wx:key="id" class="buyer-case-step {{item.complete ? 'buyer-case-step--complete' : ''}} {{index + 1 === selected.buyerTimeline.length ? 'buyer-case-step--last' : ''}}">
          <view wx:if="{{index + 1 < selected.buyerTimeline.length}}" class="buyer-case-step__line" aria-hidden="true"></view>
          <view class="buyer-case-step__mark" aria-hidden="true"></view>
          <view class="buyer-case-step__content">
            <view class="buyer-case-step__head"><text>{{item.label}}</text><text wx:if="{{item.date}}" class="buyer-case-step__date">{{item.date}}</text></view>
            <text wx:if="{{item.note}}" class="case-muted buyer-case-step__note">{{item.note}}</text>
          </view>
        </view>
      </view>
      <text wx:if="{{selected.historyTruncated}}" class="case-muted">仅显示最近的处理记录</text>
    </view>

    <view class="buyer-case-links">
      <button class="buyer-case-link {{busy || loading || locked ? 'control--disabled' : ''}}" bindtap="openOrder" disabled="{{busy || loading || locked}}">
        <text>查看订单</text><text wx:if="{{selected.orderNumber}}" class="buyer-case-link__hint">{{selected.orderNumber}}</text><image src="/assets/icons/caret-right-muted.svg" aria-hidden="true"/>
      </button>
      <button wx:if="{{selected.supportConversationId}}" class="buyer-case-link buyer-case-link--divider {{busy || loading || locked ? 'control--disabled' : ''}}" bindtap="openChat" disabled="{{busy || loading || locked}}">
        <text>{{selected.resolved?'查看售后对话':'联系售后'}}</text><image src="/assets/icons/caret-right-muted.svg" aria-hidden="true"/>
      </button>
    </view>
  </block>
</view>
<view wx:if="{{management}}" class="aftersale-workbench">
 <view wx:if="{{!selected}}" class="case-tabs"><section-tabs items="{{stages}}" item-key="value" value="{{stage}}" label="售后状态" disabled="{{loading||busy||locked}}" bindchange="selectStage"/></view>
 <view class="case-toolbar"><button wx:if="{{selected}}" class="text-button {{busy||locked||loading?'control--disabled':''}}" bindtap="list" disabled="{{busy||locked||loading}}">返回列表</button><text wx:elif="{{attentionLabel}}">{{attentionLabel}}</text><text wx:elif="{{coreReady}}">共 {{totalCount}} 单</text><view wx:elif="{{loading}}" class="loading-bone case-skeleton case-skeleton--count"/><view class="case-toolbar__actions"><button wx:if="{{attentionLabel&&!selected}}" class="text-button {{loading||busy||locked?'control--disabled':''}}" bindtap="clearAttention" disabled="{{loading||busy||locked}}">全部</button><button class="text-button {{loading||busy?'control--disabled':''}}" bindtap="retry" disabled="{{loading||busy}}">刷新</button></view></view>
 <view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button {{loading||busy?'control--disabled':''}}" bindtap="retry" disabled="{{loading||busy}}">重试</button></view>
 <view wx:if="{{notice&&!actionId}}" class="case-notice" aria-live="polite">{{notice}}</view>
 <view wx:if="{{needsReconcile||locked}}" class="case-recovery"><text>上次操作待核对</text><view class="case-recovery__actions"><button wx:if="{{locked}}" class="text-button {{!coreReady||busy||loading?'control--disabled':''}}" bindtap="submit" disabled="{{!coreReady||busy||loading}}">重试原操作</button><button class="text-button {{!coreReady||busy||loading?'control--disabled':''}}" bindtap="reconcile" disabled="{{!coreReady||busy||loading}}">核对记录</button></view></view>
 <view wx:if="{{loading&&!coreReady}}" class="case-loading" aria-role="status" aria-label="正在获取售后记录"><view wx:for="{{[1,2,3]}}" wx:key="*this" class="case-loading__row"><view class="loading-bone case-skeleton case-skeleton--status"/><view class="loading-bone case-skeleton case-skeleton--title"/><view class="loading-bone case-skeleton case-skeleton--copy"/></view></view>
 <block wx:if="{{coreReady&&!selected}}">
  <view wx:if="{{!items.length}}" class="case-empty"><text>{{stage==='all'?'暂无售后申请':'暂无此状态的售后'}}</text><button wx:if="{{stage!=='all'}}" class="text-button {{busy||loading?'control--disabled':''}}" data-stage="all" bindtap="selectStage" disabled="{{busy||loading}}">查看全部</button></view>
  <button wx:for="{{items}}" wx:key="id" class="case-summary {{busy||locked||loading||needsReconcile?'control--disabled':''}}" data-id="{{item.id}}" bindtap="open" disabled="{{busy||locked||loading||needsReconcile}}" aria-label="{{item.productSummary}}，{{item.label}}，退款金额{{item.amountLabel}}元">
   <view class="case-summary__head"><text class="case-summary__status {{item.resolved?'case-summary__status--done':''}}">{{item.label}}</text><text class="case-summary__amount">¥{{item.amountLabel}}</text></view>
   <text class="case-summary__product">{{item.productSummary||'查看申请商品'}}</text>
   <text class="case-summary__reason">{{item.reason||'七日无理由'}}</text>
   <view class="case-summary__foot"><text>{{item.kind==='return_refund'?'退货退款':'仅退款'}}<text wx:if="{{item.fulfillmentLabel}}"> · {{item.fulfillmentLabel}}</text></text><text class="case-summary__date">{{item.dateLabel}}<image src="/assets/icons/caret-right-muted.svg" class="case-summary__arrow"/></text></view>
  </button>
  <button wx:if="{{nextCursor}}" class="text-button case-more {{loading||busy||locked?'control--disabled':''}}" bindtap="next" disabled="{{loading||busy||locked}}">查看更多</button>
 </block>
 <block wx:if="{{coreReady&&selected}}">
  <view class="case-overview"><view class="case-overview__head"><text class="case-overview__status">{{selected.label}}</text><text class="case-overview__amount">¥{{selected.amountLabel}}</text></view><view class="case-overview__meta"><text>{{selected.kind==='return_refund'?'退货退款':'仅退款'}}<text wx:if="{{selected.fulfillmentLabel}}"> · {{selected.fulfillmentLabel}}</text></text><text>{{selected.dateLabel}}</text></view>
   <view class="case-order"><text class="case-order__number" user-select>{{selected.orderNumber||selected.id}}</text><button wx:if="{{selected.orderNumber}}" class="text-button {{busy||loading?'control--disabled':''}}" bindtap="copyOrder" disabled="{{busy||loading}}">复制</button><button wx:if="{{canOrder}}" class="text-button {{busy||loading||locked?'control--disabled':''}}" bindtap="openOrder" disabled="{{busy||loading||locked}}">订单</button></view>
  </view>
  <view class="case-section"><text class="case-section__title">申请内容</text><view wx:for="{{selected.lines}}" wx:key="lineId" class="case-product"><view class="case-product__text"><text class="case-product__name">{{item.productName}}</text><text class="case-muted">{{item.skuLabel}}</text></view><text class="case-product__quantity">×{{item.quantity}}</text></view><text class="case-reason">{{selected.reason||'七日无理由'}}</text></view>
  <view wx:if="{{selected.returnDestination||selected.returnTracking||selected.qualityResult||selected.exceptionResolution}}" class="case-section"><text class="case-section__title">退货信息</text><block wx:if="{{selected.returnDestination}}"><text class="case-body" user-select>{{selected.returnDestination.recipientName}} · {{selected.returnDestination.phone}}</text><text class="case-body" user-select>{{selected.returnDestination.region}} {{selected.returnDestination.address}}</text><text class="case-muted">{{selected.returnDestination.freightPayer==='merchant'?'商家承担运费':'会员承担运费'}} · 第 {{selected.returnDestination.version}} 版地址</text><text wx:if="{{selected.returnDestination.instructions}}" class="case-body">{{selected.returnDestination.instructions}}</text></block><text wx:if="{{selected.returnTracking}}" class="case-body" user-select>{{selected.returnCarrier}} · {{selected.returnTracking}}</text><text wx:if="{{selected.shippedInstructionVersion}}" class="case-muted">按第 {{selected.shippedInstructionVersion}} 版地址寄回</text><text wx:if="{{selected.returnRouteReviewRequired}}" class="case-warning">旧地址寄件，请协助核对</text><text wx:if="{{selected.routeReviewOutcome}}" class="case-muted">{{selected.routeReviewOutcome==='carrier_contacted'?'已联系承运商':selected.routeReviewOutcome==='rerouted'?'已协调转寄':'已妥善收到'}}</text><text wx:if="{{selected.qualityResult}}" class="case-body">质检{{selected.qualityResult==='sellable'?'可售':'不可售'}}</text><text wx:if="{{selected.exceptionResolution}}" class="case-muted" user-select>无需寄回 · {{selected.exceptionResolution.evidenceReference}}</text></view>
  <text wx:if="{{management && selected.restockedQuantity}}" class="case-muted">已回库 {{selected.restockedQuantity}} 件</text>
  <text wx:if="{{management && selected.partialBeforeDispatch}}" class="case-muted">未交寄订单需退款全部未退款商品。请联系买家更新申请。</text>
  <view class="case-section case-decision"><text wx:if="{{selected.canReview===false}}" class="case-muted">本人的售后需由其他管理员处理</text><button wx:for="{{available}}" wx:key="action" class="{{index===0?'case-primary':'text-button'}} {{item.action==='reject'?'case-danger':''}} {{busy||loading||locked||needsReconcile?'control--disabled':''}}" data-action="{{item.action}}" bindtap="prepareAction" disabled="{{busy||loading||locked||needsReconcile}}">{{item.label}}</button><button wx:if="{{canFinance&&selected.refund&&(selected.refund.requiresAttention||selected.refund.channelState==='abnormal')}}" class="text-button {{busy||loading||locked?'control--disabled':''}}" bindtap="openFinance" disabled="{{busy||loading||locked}}">查看退款异常</button><button wx:if="{{canChat && !selected.resolved && selected.canReview!==false}}" class="text-button {{busy||loading||locked?'control--disabled':''}}" bindtap="openChat" disabled="{{busy||loading||locked}}">联系用户</button></view>
  <view class="case-section"><text class="case-section__title">处理记录</text><view wx:for="{{selected.events}}" wx:key="version" class="case-history"><view class="case-history__head"><text>{{item.actionLabel}}</text><text class="case-muted case-history__date">{{item.dateLabel}}</text></view><text class="case-muted">{{item.note}}</text></view><text wx:if="{{selected.historyTruncated}}" class="case-muted">最近 100 条记录</text></view>
 </block>
</view>
<view wx:if="{{management&&actionId}}" class="case-sheet-mask" bindtap="closeAction" catchtouchmove="swallow"><view class="case-sheet" catchtap="swallow" aria-role="dialog" aria-modal="{{true}}" aria-label="{{actionTitle}}"><view class="case-sheet__head"><text>{{actionTitle}}</text><button class="text-button {{busy||locked?'control--disabled':''}}" bindtap="closeAction" disabled="{{busy||locked}}">关闭</button></view><scroll-view class="case-sheet__scroll" style="height:{{actionId==='send_return_instruction'?'50vh':actionNoteRequired?'36vh':'24vh'}}" scroll-y enhanced show-scrollbar="{{false}}"><view class="case-sheet__body"><view class="case-sheet__summary"><text class="case-sheet__product">{{selected.productSummary}}</text><text class="case-sheet__amount">¥{{selected.amountLabel}}</text></view>
 <text wx:if="{{actionId==='request_refund' || actionId==='approve_pending_refund'}}" class="case-muted">{{selected.fulfillment.canRefundWithoutReturn?'未发货，无需寄回。':'按本次售后金额退款。'}}{{actionDirectRefund?'确认后将提交原路退款。':'提交后等待退款复核。'}}</text>
 <block wx:if="{{actionId==='send_return_instruction'}}"><input data-keyboard-field="input" hold-keyboard="{{false}}" aria-label="退货收件人" placeholder="收件人" data-field="recipientName" value="{{recipientName}}" bindinput="edit" maxlength="80" disabled="{{busy||locked}}"/><input data-keyboard-field="input" hold-keyboard="{{false}}" aria-label="退货收件电话" type="number" placeholder="联系电话" data-field="returnPhone" value="{{returnPhone}}" bindinput="edit" maxlength="20" disabled="{{busy||locked}}"/><input data-keyboard-field="input" hold-keyboard="{{false}}" aria-label="退货收件地区" placeholder="省、市、区" data-field="returnRegion" value="{{returnRegion}}" bindinput="edit" maxlength="100" disabled="{{busy||locked}}"/><textarea data-keyboard-field="input" hold-keyboard="{{false}}" show-confirm-bar="{{false}}" confirm-type="return" aria-label="退货详细地址" placeholder="详细地址" data-field="returnAddress" value="{{returnAddress}}" bindinput="edit" maxlength="300" disabled="{{busy||locked}}"/><picker aria-label="退货运费承担方" range="{{freightOptions}}" value="{{freightIndex}}" bindchange="chooseFreight" disabled="{{busy||locked}}"><view class="choice">{{freightOptions[freightIndex]}}</view></picker><input data-keyboard-field="input" hold-keyboard="{{false}}" aria-label="退货备注" placeholder="寄回备注（选填）" data-field="returnInstructions" value="{{returnInstructions}}" bindinput="edit" maxlength="500" disabled="{{busy||locked}}"/></block>
 <picker wx:if="{{actionId==='inspect_return'}}" aria-label="质检结果" range="{{qualityOptions}}" value="{{qualityIndex}}" bindchange="chooseQuality" disabled="{{busy||locked}}"><view class="choice">{{qualityOptions[qualityIndex]}}</view></picker>
 <picker wx:if="{{actionId==='resolve_old_route'}}" aria-label="旧址退货处理结果" range="{{routeOutcomeOptions}}" value="{{routeOutcomeIndex}}" bindchange="chooseRouteOutcome" disabled="{{busy||locked}}"><view class="choice">{{routeOutcomeOptions[routeOutcomeIndex]}}</view></picker>
 <block wx:if="{{actionId==='approve_refund_without_return'}}"><picker aria-label="无需寄回情形" range="{{exceptionOptions}}" value="{{exceptionIndex}}" bindchange="chooseException" disabled="{{busy||locked}}"><view class="choice">{{exceptionOptions[exceptionIndex]}}</view></picker><input data-keyboard-field="input" hold-keyboard="{{false}}" aria-label="例外依据编号" placeholder="物流或客服记录编号" data-field="exceptionEvidence" value="{{exceptionEvidence}}" bindinput="edit" maxlength="200" disabled="{{busy||locked}}"/></block>
 <text wx:if="{{actionId==='reject'||actionId==='request_info'}}" class="case-muted">这段说明会发到用户的客服会话。</text>
 <textarea data-keyboard-field="input" hold-keyboard="{{false}}" show-confirm-bar="{{false}}" confirm-type="return" wx:if="{{actionNoteRequired}}" aria-label="{{actionId==='reject'?'拒绝原因':'处理说明'}}" placeholder="{{actionId==='reject'?'填写拒绝原因':'填写处理说明'}}" data-field="note" value="{{note}}" bindinput="edit" maxlength="500" disabled="{{busy||locked}}"/>
 <text wx:if="{{notice}}" class="case-warning" aria-live="polite">{{notice}}</text></view></scroll-view><view class="case-sheet__footer"><button class="case-primary {{busy||loading||locked||needsReconcile?'control--disabled':''}}" bindtap="submitPrepared" disabled="{{busy||loading||locked||needsReconcile}}" loading="{{busy}}">{{actionTitle}}</button></view></view></view>
</view>
