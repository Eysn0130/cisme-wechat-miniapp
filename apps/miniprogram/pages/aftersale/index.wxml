<view class="aftersale-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back {{busy?'control--disabled':''}}" bindtap="back" disabled="{{busy}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">{{management?'售后管理':'订单售后'}}</text></view>
<view class="page page--stack">
 <view wx:if="{{loading}}" class="state">正在核对售后记录…</view>
 <view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button {{busy?'control--disabled':''}}" bindtap="retry" disabled="{{busy}}">重新核验</button></view>
 <view wx:if="{{notice}}" class="state" aria-live="polite">{{notice}}</view>
 <view wx:if="{{coreReady}}" class="case-card"><text class="muted">申请、收件、质检与退款分别记录。请勿在收件信息确认前寄出；退款以支付渠道核验成功为准。</text><button class="secondary {{busy||loading?'control--disabled':''}}" bindtap="retry" disabled="{{busy||loading}}">刷新案件事实</button></view>
 <view wx:if="{{needsReconcile||locked}}" class="state"><text>上次操作需要核对。再次提交使用原请求；离开页面后的填写内容不会保留。</text><button wx:if="{{locked}}" class="secondary {{!coreReady||busy||loading?'control--disabled':''}}" bindtap="submit" disabled="{{!coreReady||busy||loading}}">重试原请求</button><button class="secondary {{!coreReady||busy||loading?'control--disabled':''}}" bindtap="reconcile" disabled="{{!coreReady||busy||loading}}">已核对原记录</button></view>
 <block wx:if="{{coreReady&&!selected}}">
  <view wx:if="{{!items.length}}" class="state">当前没有售后记录。</view>
  <button wx:for="{{items}}" wx:key="id" class="case-row {{busy||locked?'control--disabled':''}}" data-id="{{item.id}}" bindtap="open" disabled="{{busy||locked}}"><text>{{item.label}} · ¥{{item.amountLabel}}</text><text class="muted">{{item.kind==='return_refund'?'退货退款':'仅退款'}} · {{item.reason}}</text><text class="muted">查看案件与处理记录</text></button>
  <button wx:if="{{nextCursor}}" class="secondary {{busy||locked?'control--disabled':''}}" bindtap="next" disabled="{{busy||locked}}">下一页</button>
  <view wx:if="{{!management&&orderId}}" class="case-card"><text class="case-title">发起整单售后</text><text class="muted">首发按本单全部商品受理；已有案件请在原记录中继续。质量问题与七日无理由退货分别人工核对，不以“拆封”自动拒绝。</text>
   <picker range="{{kindOptions}}" value="{{kindIndex}}" bindchange="chooseKind" disabled="{{busy||locked||needsReconcile}}"><view class="choice">{{kindOptions[kindIndex]}} · 点击选择</view></picker>
   <textarea aria-label="售后原因" placeholder="请说明问题，请勿填写密码或付款信息" maxlength="500" value="{{note}}" data-field="note" bindinput="edit" disabled="{{busy||locked||needsReconcile}}"/>
   <button class="primary {{busy||locked||needsReconcile?'primary--disabled':''}}" bindtap="submit" disabled="{{busy||locked||needsReconcile}}" loading="{{busy}}">提交售后申请</button>
  </view>
 </block>
 <block wx:if="{{coreReady&&selected}}">
  <view class="case-card"><text class="case-title">{{selected.label}}</text><text class="case-copy">{{selected.kind==='return_refund'?'退货退款':'仅退款'}} · ¥{{selected.amountLabel}}</text><text class="case-copy">{{selected.reason}}</text>
   <text wx:for="{{selected.lines}}" wx:key="lineId" class="muted">{{item.productName}} · {{item.skuLabel}} × {{item.quantity}}</text>
   <block wx:if="{{selected.returnDestination}}"><text class="case-title">本案确认的收件信息</text><text class="case-copy" user-select>{{selected.returnDestination.recipientName}} · {{selected.returnDestination.phone}}
{{selected.returnDestination.address}}</text></block>
   <text wx:if="{{selected.returnTracking}}" class="case-copy" user-select>退货物流：{{selected.returnCarrier}} · {{selected.returnTracking}}</text>
   <text wx:if="{{selected.qualityResult}}" class="muted">质检：{{selected.qualityResult==='sellable'?'可售':'不可售'}}。质检本身不等于已退款或已回补库存。</text>
   <text wx:if="{{selected.refund&&!selected.resolved}}" class="muted">退款尚未核验成功，请继续核对独立退款记录。渠道受理不等于退款到账。</text>
   <button class="secondary {{busy||locked?'control--disabled':''}}" bindtap="list" disabled="{{busy||locked}}">返回案件列表</button>
  </view>
  <view wx:if="{{available.length}}" class="case-card"><text class="case-title">{{management?'记录处理事实':'继续处理'}}</text><textarea aria-label="处理说明" placeholder="填写本次说明或补充材料摘要" maxlength="500" value="{{note}}" data-field="note" bindinput="edit" disabled="{{busy||locked||needsReconcile}}"/>
   <block wx:if="{{!management&&selected.state==='awaiting_return'}}"><input aria-label="退货快递公司" placeholder="退货快递公司" value="{{carrier}}" maxlength="80" data-field="carrier" bindinput="edit" disabled="{{busy||locked||needsReconcile}}"/><input aria-label="退货运单号" placeholder="实际退货运单号" value="{{tracking}}" maxlength="64" data-field="tracking" bindinput="edit" disabled="{{busy||locked||needsReconcile}}"/></block>
   <picker wx:if="{{management&&selected.state==='return_received'}}" range="{{qualityOptions}}" value="{{qualityIndex}}" bindchange="chooseQuality" disabled="{{busy||locked||needsReconcile}}"><view class="choice">质检结果：{{qualityOptions[qualityIndex]}} · 点击选择</view></picker>
   <button wx:for="{{available}}" wx:key="action" class="secondary {{busy||locked||needsReconcile?'control--disabled':''}}" data-action="{{item.action}}" bindtap="submit" disabled="{{busy||locked||needsReconcile}}" loading="{{busy}}">{{item.label}}</button>
  </view>
  <view class="case-card"><text class="case-title">处理记录</text><view wx:for="{{selected.events}}" wx:key="version" class="event"><text class="case-copy">{{item.note}}</text><text class="muted">第 {{item.version}} 次记录 · {{item.createdAt}}</text></view><text wx:if="{{selected.historyTruncated}}" class="muted">显示最近 100 条，较早记录仍由服务端保留。</text></view>
 </block>
</view></view>
