<view class="{{management?'management-ui':''}} aftersale-shell {{reducedMotion || !motionActive ? 'loading--still' : ''}}" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back {{busy?'control--disabled':''}}" bindtap="back" disabled="{{busy}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">{{management?'售后管理':'订单售后'}}</text></view>
<view wx:if="{{!management}}" class="page page--stack">
 <view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在核对售后记录…"><view class="page-read-loading__indicator"/></view>
 <view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button {{busy?'control--disabled':''}}" bindtap="retry" disabled="{{busy}}">重试</button></view>
 <view wx:if="{{notice}}" class="state" aria-live="polite">{{notice}}</view>
 <view wx:if="{{coreReady}}" class="case-card"><text class="muted">{{selected&&selected.kind==='return_refund'?'收到本案退货指引后再寄出。':'售后进度会在这里更新。'}}</text><button class="secondary {{busy||loading?'control--disabled':''}}" bindtap="retry" disabled="{{busy||loading}}">刷新售后进度</button></view>
 <view wx:if="{{coreReady&&attentionLabel}}" class="case-card"><text class="case-title">{{attentionLabel}}</text><button class="secondary {{busy||loading?'control--disabled':''}}" bindtap="clearAttention" disabled="{{busy||loading}}">查看全部售后</button></view>
 <view wx:if="{{needsReconcile||locked}}" class="state"><text>上次操作待确认，请重试原申请</text><button wx:if="{{locked}}" class="secondary {{!coreReady||busy||loading?'control--disabled':''}}" bindtap="submit" disabled="{{!coreReady||busy||loading}}">重试上次操作</button><button class="secondary {{!coreReady||busy||loading?'control--disabled':''}}" bindtap="reconcile" disabled="{{!coreReady||busy||loading}}">已核对原记录</button></view>
 <block wx:if="{{coreReady&&!selected}}">
  <view wx:if="{{!items.length}}" class="state">还没有售后记录</view>
  <button wx:for="{{items}}" wx:key="id" class="case-row {{busy||locked?'control--disabled':''}}" data-id="{{item.id}}" bindtap="open" disabled="{{busy||locked}}"><text>{{item.label}} · ¥{{item.amountLabel}}</text><text class="muted">{{item.kind==='return_refund'?'退货退款':'仅退款'}} · {{item.reason||'七日无理由退货'}}</text><text class="muted">查看详情</text></button>
  <button wx:if="{{nextCursor}}" class="secondary {{busy||locked?'control--disabled':''}}" bindtap="next" disabled="{{busy||locked}}">下一页</button>
  <view wx:if="{{!management&&orderId}}" class="case-card"><text class="case-title">{{hasOpenCase?'本次售后处理中':items.length?'申请剩余商品售后':'申请订单售后'}}</text><text class="muted">{{hasOpenCase?'处理完成后，可回订单申请剩余商品售后。':'在订单中选择本次申请的商品和数量。'}}</text>
   <button wx:if="{{!hasOpenCase}}" class="primary {{busy||locked||needsReconcile?'primary--disabled':''}} {{busy||locked||needsReconcile?'control--disabled':''}}" bindtap="chooseOrderItems" disabled="{{busy||locked||needsReconcile}}">返回订单选择商品</button>
  </view>
 </block>
 <block wx:if="{{coreReady&&selected}}">
  <view class="case-card"><text class="case-title">{{selected.label}}</text><text class="case-copy">售后编号 {{selected.id}}</text><text class="case-copy">{{selected.kind==='return_refund'?'退货退款':'仅退款'}} · ¥{{selected.amountLabel}}</text><text class="case-copy">{{selected.reason||'七日无理由退货'}}</text>
   <text wx:if="{{selected.state==='awaiting_instruction'}}" class="muted">退货地址待确认，请先不要寄出</text>
   <text wx:for="{{selected.lines}}" wx:key="lineId" class="muted">{{item.productName}} · {{item.skuLabel}} × {{item.quantity}}</text>
   <block wx:if="{{selected.returnDestination}}"><text class="case-title">当前退货地址 · 第 {{selected.returnDestination.version}} 版</text><text class="case-copy" user-select>{{selected.returnDestination.recipientName}} · {{selected.returnDestination.phone}}
{{selected.returnDestination.region}} {{selected.returnDestination.address}}</text><text class="muted">退货寄件运费：{{selected.returnDestination.freightPayer==='merchant'?'商家承担':selected.returnDestination.freightPayer==='member'?'你承担':'请与客服确认'}}</text><text wx:if="{{selected.returnDestination.instructions}}" class="muted">{{selected.returnDestination.instructions}}</text></block>
   <text wx:if="{{selected.returnTracking}}" class="case-copy" user-select>退货物流：{{selected.returnCarrier}} · {{selected.returnTracking}}</text>
   <text wx:if="{{selected.shippedInstructionVersion}}" class="muted">实际寄件依据：第 {{selected.shippedInstructionVersion}} 版退货指引。</text>
   <text wx:if="{{selected.returnRouteReviewRequired}}" class="muted">按旧版指引寄件，待客服协助。</text>
   <text wx:if="{{selected.routeReviewOutcome}}" class="muted">旧地址处理：{{selected.routeReviewOutcome==='carrier_contacted'?'已联系承运商':selected.routeReviewOutcome==='rerouted'?'已协调转寄':'已妥善收到'}}。寄件依据已保留。</text>
   <text wx:if="{{selected.qualityResult}}" class="muted">质检：{{selected.qualityResult==='sellable'?'可售':'不可售'}}</text>
   <text wx:if="{{selected.exceptionResolution}}" class="muted">已确认无需寄回，请等待退款处理。</text>
   <text wx:if="{{management&&selected.exceptionResolution}}" class="muted" user-select>处理依据：{{selected.exceptionResolution.evidenceReference}}</text>

   <button class="secondary {{busy||locked?'control--disabled':''}}" bindtap="list" disabled="{{busy||locked}}">返回案件列表</button>
   <button wx:if="{{selected.supportConversationId}}" class="secondary {{busy?'control--disabled':''}}" bindtap="openChat" disabled="{{busy}}">{{management?'在客服会话中处理':'打开本案客服会话'}}</button>
  </view>
  <view wx:if="{{available.length}}" class="case-card"><text class="case-title">{{management?'处理售后':'继续处理'}}</text><textarea aria-label="处理说明" placeholder="填写本次说明或补充材料摘要" maxlength="500" value="{{note}}" data-field="note" bindinput="edit" disabled="{{busy||locked||needsReconcile}}"/>
   <block wx:if="{{!management&&selected.state==='awaiting_return'}}"><picker aria-label="实际寄件所用退货指引" range="{{shipmentOptions}}" value="{{shipmentIndex}}" bindchange="chooseShipmentInstruction" disabled="{{busy||locked||needsReconcile}}"><view class="choice">实际使用的指引：{{shipmentOptions[shipmentIndex]}} · 点击选择</view></picker><text wx:if="{{shipmentInstruction}}" class="muted" user-select>对应收件信息：{{shipmentInstruction.recipientName}} · {{shipmentInstruction.phone}} · {{shipmentInstruction.region}} {{shipmentInstruction.address}}</text><text wx:if="{{shipmentInstruction && selected.returnDestination && shipmentInstruction.version!==selected.returnDestination.version}}" class="muted">你选择了旧版有效指引。登记运单后会通知客服核对并协助处理。</text><input aria-label="退货快递公司" placeholder="退货快递公司" value="{{carrier}}" maxlength="80" data-field="carrier" bindinput="edit" disabled="{{busy||locked||needsReconcile}}"/><input aria-label="退货运单号" placeholder="实际退货运单号" value="{{tracking}}" maxlength="64" data-field="tracking" bindinput="edit" disabled="{{busy||locked||needsReconcile}}"/></block>
   <picker wx:if="{{management&&selected.state==='return_received'}}" aria-label="质检结果" range="{{qualityOptions}}" value="{{qualityIndex}}" bindchange="chooseQuality" disabled="{{busy||locked||needsReconcile}}"><view class="choice">质检结果：{{qualityOptions[qualityIndex]}} · 点击选择</view></picker>
   <picker wx:if="{{management&&selected.canReviewOldRoute}}" aria-label="旧地址处理结果" range="{{routeOutcomeOptions}}" value="{{routeOutcomeIndex}}" bindchange="chooseRouteOutcome" disabled="{{busy||locked||needsReconcile}}"><view class="choice">{{routeOutcomeOptions[routeOutcomeIndex]}}</view></picker>
   <block wx:if="{{management&&!selected.exceptionResolution&&(selected.state==='requested'||selected.state==='need_info'||selected.state==='awaiting_instruction'||selected.state==='awaiting_return'||selected.state==='return_in_transit')&&(selected.kind==='return_refund'||selected.claimBasis==='delivery_issue'||selected.claimBasis==='missing_item')}}">
    <picker aria-label="无需寄回例外类型" range="{{exceptionOptions}}" value="{{exceptionIndex}}" bindchange="chooseException" disabled="{{busy||locked||needsReconcile}}"><view class="choice">{{exceptionOptions[exceptionIndex]}} · 点击选择</view></picker>
    <input aria-label="例外处理依据编号" placeholder="物流或客服记录编号" value="{{exceptionEvidence}}" maxlength="200" data-field="exceptionEvidence" bindinput="edit" disabled="{{busy||locked||needsReconcile}}"/>
   </block>
   <button wx:for="{{available}}" wx:key="action" class="secondary {{busy||locked||needsReconcile?'control--disabled':''}}" data-action="{{item.action}}" bindtap="submit" disabled="{{busy||locked||needsReconcile}}" loading="{{busy}}">{{item.label}}</button>
  </view>
  <view class="case-card"><text class="case-title">处理记录</text><view wx:for="{{selected.events}}" wx:key="version" class="event"><text class="case-copy">{{item.note}}</text><text class="muted">第 {{item.version}} 次记录 · {{item.createdAt}}</text></view><text wx:if="{{selected.historyTruncated}}" class="muted">显示最近 100 条，更多记录可联系客服。</text></view>
 </block>
</view>
<view wx:if="{{management}}" class="aftersale-workbench">
 <view wx:if="{{!selected}}" class="case-tabs"><section-tabs items="{{stages}}" item-key="value" value="{{stage}}" label="售后状态" disabled="{{loading||busy||locked}}" bindchange="selectStage"/></view>
 <view class="case-toolbar"><button wx:if="{{selected}}" class="text-button {{busy||locked||loading?'control--disabled':''}}" bindtap="list" disabled="{{busy||locked||loading}}">返回列表</button><text wx:elif="{{attentionLabel}}">{{attentionLabel}}</text><text wx:elif="{{coreReady}}">共 {{totalCount}} 单</text><view wx:elif="{{loading}}" class="loading-bone case-skeleton case-skeleton--count"/><view class="case-toolbar__actions"><button wx:if="{{attentionLabel&&!selected}}" class="text-button {{loading||busy||locked?'control--disabled':''}}" bindtap="clearAttention" disabled="{{loading||busy||locked}}">全部</button><button class="text-button {{loading||busy?'control--disabled':''}}" bindtap="retry" disabled="{{loading||busy}}">刷新</button></view></view>
 <view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button {{loading||busy?'control--disabled':''}}" bindtap="retry" disabled="{{loading||busy}}">重试</button></view>
 <view wx:if="{{notice&&!actionId}}" class="case-notice" aria-live="polite">{{notice}}</view>
 <view wx:if="{{needsReconcile||locked}}" class="case-recovery"><text>上次操作待核对</text><view class="case-recovery__actions"><button wx:if="{{locked}}" class="text-button {{!coreReady||busy||loading?'control--disabled':''}}" bindtap="submit" disabled="{{!coreReady||busy||loading}}">重试原操作</button><button class="text-button {{!coreReady||busy||loading?'control--disabled':''}}" bindtap="reconcile" disabled="{{!coreReady||busy||loading}}">核对记录</button></view></view>
 <view wx:if="{{loading&&!coreReady}}" class="case-loading" aria-role="status" aria-label="正在获取售后记录"><view wx:for="{{[1,2,3]}}" wx:key="*this" class="case-loading__row"><view class="loading-bone case-skeleton case-skeleton--status"/><view class="loading-bone case-skeleton case-skeleton--title"/><view class="loading-bone case-skeleton case-skeleton--copy"/></view></view>
 <block wx:if="{{coreReady&&!selected}}">
  <view wx:if="{{!items.length}}" class="case-empty"><text>{{stage==='all'?'暂无售后申请':'暂无此状态的售后'}}</text><button wx:if="{{stage!=='all'}}" class="text-button {{busy||loading?'control--disabled':''}}" data-stage="all" bindtap="selectStage" disabled="{{busy||loading}}">查看全部</button></view>
  <button wx:for="{{items}}" wx:key="id" class="case-summary {{busy||locked||loading||needsReconcile?'control--disabled':''}}" data-id="{{item.id}}" bindtap="open" disabled="{{busy||locked||loading||needsReconcile}}" aria-label="{{item.productSummary}}，{{item.label}}，退款金额{{item.amountLabel}}元">
   <view class="case-summary__head"><text class="case-summary__status {{item.resolved?'case-summary__status--done':''}}">{{item.label}}</text><text class="case-summary__amount">¥{{item.amountLabel}}</text></view>
   <text class="case-summary__product">{{item.productSummary||'查看申请商品'}}</text>
   <text class="case-summary__reason">{{item.reason||'七日无理由'}}</text>
   <view class="case-summary__foot"><text>{{item.kind==='return_refund'?'退货退款':'仅退款'}}<text wx:if="{{item.fulfillmentLabel}}"> · {{item.fulfillmentLabel}}</text></text><text class="case-summary__date">{{item.dateLabel}}<image src="/assets/icons/caret-right-muted.svg" class="case-summary__arrow"/></text></view>
  </button>
  <button wx:if="{{nextCursor}}" class="text-button case-more {{loading||busy||locked?'control--disabled':''}}" bindtap="next" disabled="{{loading||busy||locked}}">查看更多</button>
 </block>
 <block wx:if="{{coreReady&&selected}}">
  <view class="case-overview"><view class="case-overview__head"><text class="case-overview__status">{{selected.label}}</text><text class="case-overview__amount">¥{{selected.amountLabel}}</text></view><view class="case-overview__meta"><text>{{selected.kind==='return_refund'?'退货退款':'仅退款'}}<text wx:if="{{selected.fulfillmentLabel}}"> · {{selected.fulfillmentLabel}}</text></text><text>{{selected.dateLabel}}</text></view>
   <view class="case-order"><text class="case-order__number" user-select>{{selected.orderNumber||selected.id}}</text><button wx:if="{{selected.orderNumber}}" class="text-button {{busy||loading?'control--disabled':''}}" bindtap="copyOrder" disabled="{{busy||loading}}">复制</button><button wx:if="{{canOrder}}" class="text-button {{busy||loading||locked?'control--disabled':''}}" bindtap="openOrder" disabled="{{busy||loading||locked}}">订单</button></view>
  </view>
  <view class="case-section"><text class="case-section__title">申请内容</text><view wx:for="{{selected.lines}}" wx:key="lineId" class="case-product"><view class="case-product__text"><text class="case-product__name">{{item.productName}}</text><text class="case-muted">{{item.skuLabel}}</text></view><text class="case-product__quantity">×{{item.quantity}}</text></view><text class="case-reason">{{selected.reason||'七日无理由'}}</text></view>
  <view wx:if="{{selected.returnDestination||selected.returnTracking||selected.qualityResult||selected.exceptionResolution}}" class="case-section"><text class="case-section__title">退货信息</text><block wx:if="{{selected.returnDestination}}"><text class="case-body" user-select>{{selected.returnDestination.recipientName}} · {{selected.returnDestination.phone}}</text><text class="case-body" user-select>{{selected.returnDestination.region}} {{selected.returnDestination.address}}</text><text class="case-muted">{{selected.returnDestination.freightPayer==='merchant'?'商家承担运费':'会员承担运费'}} · 第 {{selected.returnDestination.version}} 版地址</text><text wx:if="{{selected.returnDestination.instructions}}" class="case-body">{{selected.returnDestination.instructions}}</text></block><text wx:if="{{selected.returnTracking}}" class="case-body" user-select>{{selected.returnCarrier}} · {{selected.returnTracking}}</text><text wx:if="{{selected.shippedInstructionVersion}}" class="case-muted">按第 {{selected.shippedInstructionVersion}} 版地址寄回</text><text wx:if="{{selected.returnRouteReviewRequired}}" class="case-warning">旧地址寄件，请协助核对</text><text wx:if="{{selected.routeReviewOutcome}}" class="case-muted">{{selected.routeReviewOutcome==='carrier_contacted'?'已联系承运商':selected.routeReviewOutcome==='rerouted'?'已协调转寄':'已妥善收到'}}</text><text wx:if="{{selected.qualityResult}}" class="case-body">质检{{selected.qualityResult==='sellable'?'可售':'不可售'}}</text><text wx:if="{{selected.exceptionResolution}}" class="case-muted" user-select>无需寄回 · {{selected.exceptionResolution.evidenceReference}}</text></view>
  <text wx:if="{{management && selected.restockedQuantity}}" class="case-muted">已回库 {{selected.restockedQuantity}} 件</text>
  <text wx:if="{{management && selected.partialBeforeDispatch}}" class="case-muted">未交寄订单需退款全部未退款商品。请联系买家更新申请。</text>
  <view class="case-section case-decision"><text wx:if="{{selected.canReview===false}}" class="case-muted">本人的售后需由其他管理员处理</text><button wx:for="{{available}}" wx:key="action" class="{{index===0?'case-primary':'text-button'}} {{item.action==='reject'?'case-danger':''}} {{busy||loading||locked||needsReconcile?'control--disabled':''}}" data-action="{{item.action}}" bindtap="prepareAction" disabled="{{busy||loading||locked||needsReconcile}}">{{item.label}}</button><button wx:if="{{canFinance&&selected.refund&&(selected.refund.requiresAttention||selected.refund.channelState==='abnormal')}}" class="text-button {{busy||loading||locked?'control--disabled':''}}" bindtap="openFinance" disabled="{{busy||loading||locked}}">查看退款异常</button><button wx:if="{{canChat && selected.canReview!==false}}" class="text-button {{busy||loading||locked?'control--disabled':''}}" bindtap="openChat" disabled="{{busy||loading||locked}}">联系用户</button></view>
  <view class="case-section"><text class="case-section__title">处理记录</text><view wx:for="{{selected.events}}" wx:key="version" class="case-history"><view class="case-history__head"><text>{{item.actionLabel}}</text><text class="case-muted case-history__date">{{item.dateLabel}}</text></view><text class="case-muted">{{item.note}}</text></view><text wx:if="{{selected.historyTruncated}}" class="case-muted">最近 100 条记录</text></view>
 </block>
</view>
<view wx:if="{{management&&actionId}}" class="case-sheet-mask" bindtap="closeAction" catchtouchmove="swallow"><view class="case-sheet" catchtap="swallow" aria-role="dialog" aria-modal="{{true}}" aria-label="{{actionTitle}}"><view class="case-sheet__head"><text>{{actionTitle}}</text><button class="text-button {{busy||locked?'control--disabled':''}}" bindtap="closeAction" disabled="{{busy||locked}}">关闭</button></view><scroll-view class="case-sheet__scroll" style="height:{{actionId==='send_return_instruction'?'50vh':actionNoteRequired?'36vh':'24vh'}}" scroll-y enhanced show-scrollbar="{{false}}"><view class="case-sheet__body"><view class="case-sheet__summary"><text class="case-sheet__product">{{selected.productSummary}}</text><text class="case-sheet__amount">¥{{selected.amountLabel}}</text></view>
 <text wx:if="{{actionId==='request_refund' || actionId==='approve_pending_refund'}}" class="case-muted">{{selected.fulfillment.canRefundWithoutReturn?'未发货，无需寄回。':'按本次售后金额退款。'}}{{actionDirectRefund?'确认后将提交原路退款。':'提交后等待退款复核。'}}</text>
 <block wx:if="{{actionId==='send_return_instruction'}}"><input aria-label="退货收件人" placeholder="收件人" data-field="recipientName" value="{{recipientName}}" bindinput="edit" maxlength="80" disabled="{{busy||locked}}"/><input aria-label="退货收件电话" type="number" placeholder="联系电话" data-field="returnPhone" value="{{returnPhone}}" bindinput="edit" maxlength="20" disabled="{{busy||locked}}"/><input aria-label="退货收件地区" placeholder="省、市、区" data-field="returnRegion" value="{{returnRegion}}" bindinput="edit" maxlength="100" disabled="{{busy||locked}}"/><textarea aria-label="退货详细地址" placeholder="详细地址" data-field="returnAddress" value="{{returnAddress}}" bindinput="edit" maxlength="300" disabled="{{busy||locked}}"/><picker aria-label="退货运费承担方" range="{{freightOptions}}" value="{{freightIndex}}" bindchange="chooseFreight" disabled="{{busy||locked}}"><view class="choice">{{freightOptions[freightIndex]}}</view></picker><input aria-label="退货备注" placeholder="寄回备注（选填）" data-field="returnInstructions" value="{{returnInstructions}}" bindinput="edit" maxlength="500" disabled="{{busy||locked}}"/></block>
 <picker wx:if="{{actionId==='inspect_return'}}" aria-label="质检结果" range="{{qualityOptions}}" value="{{qualityIndex}}" bindchange="chooseQuality" disabled="{{busy||locked}}"><view class="choice">{{qualityOptions[qualityIndex]}}</view></picker>
 <picker wx:if="{{actionId==='resolve_old_route'}}" aria-label="旧址退货处理结果" range="{{routeOutcomeOptions}}" value="{{routeOutcomeIndex}}" bindchange="chooseRouteOutcome" disabled="{{busy||locked}}"><view class="choice">{{routeOutcomeOptions[routeOutcomeIndex]}}</view></picker>
 <block wx:if="{{actionId==='approve_refund_without_return'}}"><picker aria-label="无需寄回情形" range="{{exceptionOptions}}" value="{{exceptionIndex}}" bindchange="chooseException" disabled="{{busy||locked}}"><view class="choice">{{exceptionOptions[exceptionIndex]}}</view></picker><input aria-label="例外依据编号" placeholder="物流或客服记录编号" data-field="exceptionEvidence" value="{{exceptionEvidence}}" bindinput="edit" maxlength="200" disabled="{{busy||locked}}"/></block>
 <text wx:if="{{actionId==='reject'||actionId==='request_info'}}" class="case-muted">这段说明会发到用户的客服会话。</text>
 <textarea wx:if="{{actionNoteRequired}}" aria-label="{{actionId==='reject'?'拒绝原因':'处理说明'}}" placeholder="{{actionId==='reject'?'填写拒绝原因':'填写处理说明'}}" data-field="note" value="{{note}}" bindinput="edit" maxlength="500" disabled="{{busy||locked}}"/>
 <text wx:if="{{notice}}" class="case-warning" aria-live="polite">{{notice}}</text></view></scroll-view><view class="case-sheet__footer"><button class="case-primary {{busy||loading||locked||needsReconcile?'control--disabled':''}}" bindtap="submitPrepared" disabled="{{busy||loading||locked||needsReconcile}}" loading="{{busy}}">{{actionTitle}}</button></view></view></view>
</view>
