.aftersale-shell{min-height:100vh;background:#f7f2f8}.case-card{display:flex;flex-direction:column;gap:20rpx;padding:28rpx;background:#fff;border:1rpx solid var(--cisme-line);border-radius:24rpx;overflow-wrap:anywhere}.case-title{font-size:32rpx;font-weight:500}.muted{font-size:24rpx;line-height:1.65;color:var(--cisme-muted)}.case-copy{font-size:27rpx;line-height:1.7;white-space:pre-wrap}.case-row{width:100%;text-align:left;padding:24rpx;background:#fff;border:1rpx solid var(--cisme-line);border-radius:20rpx;display:flex;flex-direction:column;gap:12rpx;font-size:28rpx;line-height:1.6}.choice{min-height:44px;display:flex;align-items:center;font-size:27rpx;border-bottom:1rpx solid var(--cisme-line)}textarea{box-sizing:border-box;width:100%;min-height:180rpx;padding:18rpx;background:#faf7fb;border:1rpx solid var(--cisme-line);border-radius:12rpx;font-size:27rpx}input{box-sizing:border-box;min-height:44px;padding:0 18rpx;border:1rpx solid var(--cisme-line);border-radius:12rpx;font-size:27rpx}.primary,.secondary{width:100%;min-height:44px;display:flex;align-items:center;justify-content:center;border-radius:18rpx;font-size:27rpx}.primary{background:#705278;color:#fff}.secondary{background:#f1eaf3;color:#61486c}.event{display:flex;flex-direction:column;gap:8rpx;padding:20rpx 0;border-top:1rpx solid var(--cisme-line)}
.primary--disabled,.control--disabled{opacity:.45}
