@import "../../styles/management-workbench.wxss";
@import "../../styles/read-loading.wxss";
.aftersale-shell { min-height: 100vh; background: var(--cisme-page); }
.choice { min-height: var(--cisme-hit-target); display: flex; align-items: center; font-size: var(--cisme-text-body); border-bottom: 1rpx solid var(--cisme-line); }
.aftersale-shell textarea,
.aftersale-shell input {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--cisme-hit-target);
  padding: 10px 12px;
  border: 1rpx solid var(--cisme-line);
  border-radius: var(--cisme-radius-control);
  background: var(--cisme-card);
  font-size: var(--cisme-text-body);
}
.aftersale-shell textarea { min-height: 90px; }
.primary--disabled,.control--disabled{opacity:.45}

.buyer-case-page {
  box-sizing: border-box;
  max-width: 560px;
  margin: 0 auto;
  padding: calc(var(--cisme-topbar-height) + 24rpx) 30rpx calc(env(safe-area-inset-bottom) + 44rpx);
  color: var(--cisme-ink);
}

.buyer-case-summary { padding: 16rpx 4rpx 34rpx; }
.buyer-case-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 16rpx; }
.buyer-case-status { min-width: 0; font-size: 1.625rem; line-height: 1.22; font-weight: 630; }
.buyer-case-amount { flex: none; color: var(--cisme-plum); font-size: 1.625rem; line-height: 1.24; font-weight: 600; font-variant-numeric: tabular-nums; }
.buyer-case-meta,
.buyer-case-instruction { display: block; margin-top: 12rpx; color: var(--cisme-muted); font-size: .875rem; line-height: 1.5; }
.buyer-case-instruction { margin-top: 20rpx; color: var(--cisme-plum); }
.buyer-case-page .case-section { padding: 26rpx 4rpx; }
.buyer-case-page .case-product__name { overflow-wrap: anywhere; }
.buyer-case-reason {
  display: flex;
  gap: 20rpx;
  padding-top: 14rpx;
  color: var(--cisme-muted);
  font-size: var(--cisme-text-small);
  line-height: 1.6;
}
.buyer-case-reason__label { flex: none; }
.buyer-case-reason__value { min-width: 0; color: var(--cisme-ink); overflow-wrap: anywhere; }
.buyer-case-feedback {
  min-height: var(--cisme-hit-target);
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: var(--cisme-muted);
  font-size: var(--cisme-text-body);
  line-height: 1.5;
}
.buyer-case-feedback .text-button { flex: none; }
.buyer-case-choice { display: flex; align-items: center; justify-content: space-between; min-height: var(--cisme-hit-target); font-size: var(--cisme-text-body); color: var(--cisme-plum); }
.buyer-case-choice image,
.buyer-case-link image { width: 12px; height: 12px; flex: none; }
.buyer-case-actions .primary { margin: 4rpx 0 0; }
.buyer-case-actions .buyer-case-cancel { align-self: flex-start; margin: 0; padding-left: 0; }

.buyer-case-timeline { display: flex; flex-direction: column; }
.buyer-case-step {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  min-height: 40px;
  padding-bottom: 12rpx;
}
.buyer-case-step--last { min-height: 23px; padding-bottom: 0; }
.buyer-case-step__line {
  position: absolute;
  top: 12px;
  bottom: -8px;
  left: 4px;
  width: 1px;
  background: var(--cisme-line);
}
.buyer-case-step__mark {
  z-index: 1;
  box-sizing: border-box;
  flex: none;
  width: 9px;
  height: 9px;
  margin-top: 7px;
  border: 1px solid #8c7996;
  border-radius: 50%;
  background: var(--cisme-page);
}
.buyer-case-step__content { flex: 1; min-width: 0; }
.buyer-case-step__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0 16rpx; font-size: .875rem; line-height: 1.55; }
.buyer-case-step__date { color: var(--cisme-muted); font-size: .75rem; font-variant-numeric: tabular-nums; }
.buyer-case-step--complete .buyer-case-step__mark { border-color: var(--cisme-plum); background: var(--cisme-plum); }
.buyer-case-step--complete .buyer-case-step__head { color: var(--cisme-plum); font-weight: 600; }
.buyer-case-step__note { display: block; margin-top: 4rpx; }

.buyer-case-links { border-top: 1rpx solid var(--cisme-line); }
.buyer-case-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  min-height: var(--cisme-hit-target);
  padding: 8px 4rpx;
  border: 0;
  border-radius: 0;
  color: var(--cisme-plum);
  background: transparent;
  text-align: left;
  font-size: var(--cisme-text-body);
  line-height: 1.5;
  white-space: normal;
}
.buyer-case-link--divider { border-top: 1rpx solid var(--cisme-line); }
.buyer-case-link__hint { flex: 1; min-width: 0; text-align: right; color: var(--cisme-muted); font-size: var(--cisme-text-small); overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
@media (max-width: 350px) {
  .buyer-case-status, .buyer-case-amount { font-size: 1.375rem; }
}

/* The workbench uses the same native typography and tabs as the management centre. */
.aftersale-workbench{padding:var(--cisme-topbar-height) 28rpx calc(env(safe-area-inset-bottom) + 40rpx);min-height:100vh;color:var(--cisme-ink)}
.case-tabs{margin:12rpx -8rpx 0}.case-toolbar,.case-toolbar__actions{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.case-toolbar{min-height:64px;color:var(--cisme-muted);font-size:13px}.case-toolbar__actions{margin-left:auto;gap:12rpx}.case-toolbar .text-button{padding:0 8rpx}
.case-summary{width:100%;margin:0 0 20rpx;padding:26rpx 28rpx;text-align:left;display:flex;flex-direction:column;gap:12rpx;border:0;border-radius:24rpx;background:#fff;color:var(--cisme-ink);white-space:normal;box-shadow:0 3px 14px rgba(53,42,58,.035)}
.case-summary__head,.case-summary__foot,.case-overview__head,.case-overview__meta,.case-history__head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.case-summary__status{font-size:13px;color:var(--cisme-plum);font-weight:600}.case-summary__status--done{color:var(--cisme-muted)}.case-summary__amount{flex:none;font-size:18px;font-weight:600;font-variant-numeric:tabular-nums}.case-summary__product{font-size:16px;font-weight:500;line-height:1.55}.case-summary__reason{color:var(--cisme-muted);font-size:13px;line-height:1.6;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.case-summary__foot{padding-top:8rpx;color:var(--cisme-muted);font-size:12px;line-height:1.6}.case-summary__date{display:flex;align-items:center;flex:none}.case-summary__arrow{width:12px;height:12px;margin-left:12rpx}.case-more{width:100%;margin:16rpx 0}
.case-empty{min-height:45vh;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16rpx;color:var(--cisme-muted);font-size:14px}
.case-overview{padding:10rpx 4rpx 30rpx}.case-overview__status{font-size:20px;font-weight:600;line-height:1.45}.case-overview__amount{flex:none;font-size:26px;font-weight:600;line-height:1.4;font-variant-numeric:tabular-nums}.case-overview__meta{margin-top:14rpx;font-size:12px;color:var(--cisme-muted)}.case-order{display:flex;align-items:center;margin-top:16rpx;gap:8rpx;font-size:12px;color:var(--cisme-muted);overflow-wrap:anywhere}.case-order__number{flex:1;min-width:0}.case-order .text-button{flex:none;padding:0 8rpx}
.case-section{padding:28rpx 4rpx;border-top:1rpx solid var(--cisme-line);display:flex;flex-direction:column;gap:16rpx}.case-section__title{font-size:16px;font-weight:600;line-height:1.5}.case-product{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.case-product__text{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx}.case-product__name{font-size:14px;font-weight:500;line-height:1.6}.case-product__quantity{flex:none;font-size:14px;line-height:1.6;font-variant-numeric:tabular-nums}.case-reason,.case-body{font-size:14px;line-height:1.65;white-space:pre-wrap;overflow-wrap:anywhere}.case-reason{margin-top:4rpx}.case-muted{font-size:13px;line-height:1.65;color:var(--cisme-muted);white-space:pre-wrap;overflow-wrap:anywhere}
.case-decision{display:flex;flex-direction:row;flex-wrap:wrap;gap:8rpx 24rpx}.case-decision .case-primary{width:100%}.case-decision .text-button{padding:0;flex:none}.case-decision .case-danger{color:var(--cisme-danger)}.case-primary{display:flex;align-items:center;justify-content:center;width:100%;min-height:48px;margin:0;padding:20rpx 28rpx;border:0;border-radius:16rpx;color:#fff;background:var(--cisme-plum);font-size:16px;font-weight:500;line-height:1.5}.case-primary.control--disabled{color:#fff;background:#a99ab4;opacity:.65}.case-history{display:flex;flex-direction:column;gap:8rpx;padding:14rpx 0}.case-history__head{font-size:14px;line-height:1.5}.case-history__date{flex:none;font-size:12px}.case-notice,.case-warning{font-size:13px;color:var(--cisme-plum);line-height:1.65;overflow-wrap:anywhere}.case-notice{padding:12rpx 4rpx 24rpx}.case-recovery{padding:20rpx;background:var(--cisme-lilac);border-radius:16rpx;font-size:14px;line-height:1.6}.case-recovery__actions{display:flex;justify-content:flex-end;gap:20rpx}
.case-sheet-mask{position:fixed;inset:0;z-index:1000;display:flex;align-items:flex-end;background:rgba(35,23,45,.32)}.case-sheet{width:100%;max-height:calc(100vh - var(--cisme-topbar-height));display:flex;flex-direction:column;background:#fffcff;border-radius:28rpx 28rpx 0 0;overflow:hidden}.case-sheet__head{flex:none;display:flex;align-items:center;justify-content:space-between;padding:16rpx 28rpx 8rpx;font-size:20px;font-weight:600;gap:20rpx}.case-sheet__head .text-button{flex:none;font-weight:400}.case-sheet__scroll{height:48vh;min-height:160px;flex:auto}.case-sheet__body{display:flex;flex-direction:column;gap:24rpx;padding:20rpx 28rpx 32rpx}.case-sheet__summary{display:flex;align-items:flex-start;justify-content:space-between;gap:28rpx;font-size:14px;line-height:1.65}.case-sheet__product{flex:1;min-width:0}.case-sheet__amount{flex:none;font-weight:600;font-size:20px;font-variant-numeric:tabular-nums}.case-sheet__footer{flex:none;padding:16rpx 28rpx calc(env(safe-area-inset-bottom) + 24rpx)}.case-sheet input{border:0;border-bottom:1rpx solid var(--cisme-line);padding:0;background:transparent;border-radius:0}.case-sheet textarea{min-height:140rpx;border:0;background:var(--cisme-lilac);border-radius:12rpx;padding:20rpx}.case-sheet .choice{color:var(--cisme-plum)}
.case-loading__row{padding:28rpx;margin-bottom:20rpx;background:#fff;border-radius:24rpx}.case-skeleton{background:var(--cisme-load-bone,#eee7f2);border-radius:6rpx}.case-skeleton--count{width:90rpx;height:24rpx}.case-skeleton--status{width:160rpx;height:26rpx;margin-bottom:26rpx}.case-skeleton--title{width:78%;height:32rpx;margin-bottom:20rpx}.case-skeleton--copy{width:55%;height:24rpx}
@media(max-width:350px){.case-summary__foot{flex-wrap:wrap}.case-overview__head{align-items:flex-start}.case-overview__status{font-size:18px}.case-overview__amount{font-size:24px}}
