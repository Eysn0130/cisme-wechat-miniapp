<page-meta page-style="{{agreementOpen ? 'overflow: hidden;' : ''}}"/>
<view capture-bind:tap="dismissNativeKeyboardOnTap" class="chrome-root officer-root {{giftMode?'officer-root--gift':''}}" style="{{chromeStyle}}">
 <view class="topbar" aria-hidden="{{agreementOpen}}"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">{{giftMode?'体验装分享':referrerOnly?'我的推荐人':'分享官'}}</text></view>
 <view class="page page--stack officer-page" aria-hidden="{{agreementOpen}}">
  <view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在加载"><view class="page-read-loading__indicator"/></view>
  <view wx:if="{{error&&!sheet}}" class="officer-error"><text>{{error}}</text><button class="action-text {{loading||busy ? 'control--disabled' : ''}}" bindtap="retry" disabled="{{loading||busy}}">重试</button></view>
  <view wx:if="{{pending}}" class="officer-recovery"><text>上次操作待确认</text><view class="officer-actions"><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="recover" disabled="{{busy}}">查询结果</button><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="recover" data-abandon="{{true}}" disabled="{{busy}}">结束这次请求</button></view></view>
  <block wx:if="{{wallet}}">
   <block wx:if="{{giftMode}}">
    <block wx:if="{{wallet.canShare}}">
     <picker wx:if="{{giftActivities.length>1}}" range="{{giftActivities}}" range-key="title" value="{{giftActivityIndex}}" bindchange="chooseGiftActivity" disabled="{{loading||giftShareBusy}}"><view class="officer-gift-activity"><text>{{giftActivityTitle}}</text><image src="/assets/icons/caret-right-muted.svg"/></view></picker>
     <view class="officer-gift-intro"><text class="officer-gift-heading">旅行洗护礼遇</text><text class="officer-muted">净润与净屑 · 每人任选一套</text></view>
     <view wx:for="{{giftBundles}}" wx:key="code" class="officer-gift-card {{item.available?'':'officer-gift-card--empty'}}">
      <view class="officer-between"><text class="officer-strong">{{item.code==='moisture'?'净润洗护礼遇':'净屑洗护礼遇'}}</text><button class="action-text {{detailBusy?'control--disabled':''}}" data-code="{{item.code}}" bindtap="giftDetails" disabled="{{detailBusy}}" aria-label="{{item.name+'产品详情'}}">详情</button></view>
      <view class="officer-gift-product"><view class="officer-gift-photo"><image src="{{item.photo}}" mode="aspectFit"/><view wx:if="{{!item.available}}" class="officer-gift-soldout"><text>已领完</text></view></view><view class="officer-gift-copy"><text class="officer-gift-benefit">{{item.benefit}}</text><text>{{item.shampoo}} {{item.shampooMl}}mL</text><text>{{item.conditioner}} {{item.conditionerMl}}mL</text></view></view>
      <text class="officer-gift-state">{{item.available?'可领取':'已领完'}}</text>
     </view>
     <view wx:if="{{!giftActivities.length&&!loading}}" class="officer-empty">暂无开放的洗护礼遇</view>
    </block>
    <view wx:else class="officer-empty">当前分享官资格不可推广</view>
   </block>
   <block wx:elif="{{referrerOnly}}">
    <view class="officer-intro"><text class="officer-overline">CISME</text><text class="officer-heading">{{wallet.relation?wallet.relation.label:'尚未设置推荐人'}}</text><text wx:if="{{wallet.relation}}" class="officer-code">{{wallet.relation.code}}</text></view>
    <button class="primary {{busy||pending ? 'primary--disabled' : ''}}" data-sheet="referrer" bindtap="open" disabled="{{busy||pending}}">{{wallet.relation?'更换推荐人':'查找推荐人'}}</button>
    <text wx:if="{{wallet.pendingReferrer}}" class="officer-note">已选 {{wallet.pendingReferrer.label}}，首笔有效成交后生效。</text><text wx:else class="officer-note">更换只影响之后创建的订单。</text>
   </block>
   <block wx:else>
    <view class="officer-intro"><text wx:if="{{stateLabel&&wallet.officer.state!=='pending'&&!reviewApproved}}" class="officer-status">{{stateLabel}}</text>
     <block wx:if="{{!wallet.officer||wallet.officer.state==='rejected'}}">
      <text class="officer-heading">把喜欢，分享出去。</text>
      <view wx:if="{{wallet.qualification.met}}" class="officer-qualification officer-qualification--met">
       <view class="officer-qualification__mark-row" aria-hidden="true">
        <view class="officer-qualification__rule"/>
        <view class="officer-qualification__seal {{qualificationMotion==='achieved'?'officer-qualification__seal--achieved':''}}">
         <image class="officer-qualification__pearl" src="/assets/cisme/onboarding-pearl-seal-v1.png" mode="aspectFit"/>
         <view wx:if="{{qualificationMotion}}" class="officer-qualification__glint"><view class="officer-qualification__shine"/></view>
         <image class="officer-qualification__check" src="/assets/icons/check-plum.svg" mode="aspectFit"/>
        </view>
        <view class="officer-qualification__rule"/>
       </view>
       <text class="officer-qualification__completed" aria-live="polite">任务完成</text>
       <text class="officer-strong">购买精华套组 1 组</text>
       <text class="officer-muted">头皮紧致修护精华液 · ¥298</text>
      </view>
      <view wx:else class="officer-qualification officer-qualification--purchase">
       <image class="officer-qualification__product" src="/pages/sharing-officer/assets/qualifying-essence-set.jpg" mode="aspectFit" aria-hidden="true"/>
       <view class="officer-qualification__copy">
        <text class="officer-qualification__state">待完成</text>
        <text class="officer-strong">购买精华套组 1 组</text>
        <text class="officer-muted">头皮紧致修护精华液 · ¥298</text>
       </view>
      </view>
      <text wx:if="{{!qualificationPurchaseNeeded&&!wallet.canApply}}" class="officer-copy">申请暂未开放</text>
     </block>
     <block wx:elif="{{wallet.officer.state==='pending'||reviewApproved}}">
      <view class="officer-review {{reviewMotion?'officer-review--motion':''}} {{reviewApproved?'officer-review--approved':''}}">
       <view class="officer-qualification__mark-row" aria-hidden="true">
        <view class="officer-qualification__rule"/>
        <view class="officer-qualification__seal officer-review__seal">
         <view class="officer-review__material">
          <image class="officer-review__pearl" src="/pages/sharing-officer/assets/review-pearl.png" mode="aspectFit"/>
          <block wx:if="{{reviewMotion&&!reviewApproved}}">
           <view class="officer-review__inner-light"/>
           <view class="officer-review__orbit"><view class="officer-review__glow"/></view>
          </block>
         </view>
         <view wx:if="{{reviewApproved}}" class="officer-qualification__glint"><view class="officer-qualification__shine"/></view>
         <image class="officer-review__icon officer-review__clock" src="/assets/icons/clock-plum.svg" mode="aspectFit"/>
         <image wx:if="{{reviewApproved}}" class="officer-review__icon officer-review__check" src="/assets/icons/check-plum.svg" mode="aspectFit"/>
        </view>
        <view class="officer-qualification__rule"/>
       </view>
       <view class="officer-review__copy" aria-role="status" aria-live="polite">
        <text class="officer-review__title">{{reviewApproved?'已开通':'等待中'}}</text>
        <text wx:if="{{!reviewApproved}}" class="officer-review__caption">申请已提交</text>
       </view>
      </view>
     </block>
     <block wx:else><text class="officer-heading">每一份分享，<text class="officer-heading-line">都有回响。</text></text><view class="officer-between"><text class="officer-code">{{wallet.officer.referralCode}}</text><button class="action-text {{busy||pending ? 'control--disabled' : ''}}" data-sheet="payee" bindtap="open" disabled="{{busy||pending}}">收款资料</button></view></block>
     <button wx:if="{{wallet.officer.state==='terminated'&&wallet.canApply}}" class="primary {{busy||pending ? 'primary--disabled' : ''}}" data-sheet="apply" bindtap="open" disabled="{{busy||pending}}">重新申请</button>
     <text wx:if="{{wallet.officer.reviewReason&&(wallet.officer.state==='rejected'||wallet.officer.state==='suspended'||wallet.officer.state==='terminated')}}" class="officer-copy">{{wallet.officer.reviewReason}}</text>
    </view>
    <block wx:if="{{hasDashboard&&!reviewApproved}}">
     <view class="officer-metrics"><view><text class="officer-money">{{metrics.pendingCents}}</text><text>待结算 · 税前</text></view><view><text class="officer-money">{{metrics.availableCents}}</text><text>可结算 · 税前</text></view><view><text class="officer-money">{{metrics.settledNetCents}}</text><text>已到账 · 税后</text></view></view>
     <view wx:if="{{wallet.metrics.outstandingRecoveryCents}}" class="officer-warning">退款待核对冲回 ¥{{metrics.outstandingRecoveryCents}}</view>
     <section-tabs items="{{tabs}}" value="{{tab}}" bindchange="changeTab" disabled="{{busy||pending}}" label="分享官分类"/>
     <block wx:if="{{tab==='overview'}}"><button wx:if="{{wallet.canShare}}" class="officer-gift-entry {{busy||pending?'control--disabled':''}}" bindtap="openGiftSharing" disabled="{{busy||pending}}"><image src="/assets/cisme/travel-reward-share-v2.jpg" mode="aspectFill"/><view><text class="officer-strong">旅行洗护礼遇</text><text class="officer-muted">分享体验装</text></view><image class="officer-gift-chevron" src="/assets/icons/caret-right-muted.svg"/></button><view class="officer-between officer-section"><text>推广商品</text><text class="officer-muted">佣金 {{rate}}%</text></view>
      <button wx:for="{{products}}" wx:key="code" class="officer-product {{busy||pending||!wallet.canShare ? 'control--disabled' : ''}}" data-code="{{item.code}}" bindtap="promote" disabled="{{busy||pending||!wallet.canShare}}"><image src="{{item.displayImage}}" mode="aspectFill"/><view><text class="officer-strong">{{item.name}}</text><text class="officer-muted">{{item.price?'¥'+item.price:''}}</text></view><text class="officer-link">分享</text></button>
      <view wx:if="{{!products.length&&!loading}}" class="officer-empty">暂无可推广商品</view><button wx:if="{{moreProducts}}" class="action-text officer-more {{loading||busy ? 'control--disabled' : ''}}" bindtap="moreProducts" disabled="{{loading||busy}}">加载更多</button>
      <text class="officer-note">收货满 {{releaseDays}} 天、无进行中售后后可结算；按月由财务处理。</text>
     </block>
     <block wx:else><view wx:if="{{orderLineId}}" class="officer-between officer-section"><text>{{sourcePeriod}} 月结来源</text><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="clearSource" disabled="{{busy}}">查看全部</button></view><view wx:if="{{!items.length&&!loading}}" class="officer-empty">{{tab==='orders'?'还没有推广订单':'暂无结算记录'}}</view>
      <button wx:for="{{items}}" wx:key="id" class="officer-record {{busy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="detail" disabled="{{busy}}"><view class="officer-between"><text class="officer-strong">{{tab==='orders'?item.productName:item.period+' 月结'}}</text><text class="officer-link">{{item.label}}</text></view><view class="officer-between officer-muted"><text>{{item.date}}</text><text>{{tab==='orders'?'实付 ¥'+item.cash:'税前 ¥'+item.gross}}</text></view><view wx:if="{{tab==='orders'&&item.refundedMerchandiseCents}}" class="officer-muted">已退商品款 ¥{{item.refund}}</view><view wx:if="{{tab==='settlements'&&item.taxCents!==null}}" class="officer-between officer-muted"><text>扣税 ¥{{item.tax}}</text><text>{{item.state==='paid'?'实际到账':'预计实付'}} ¥{{item.net}}</text></view></button>
      <button wx:if="{{hasMore}}" class="action-text officer-more {{loading||busy ? 'control--disabled' : ''}}" bindtap="more" disabled="{{loading||busy}}">加载更多</button>
     </block>
    </block>
   </block>
  </block>
  <view wx:if="{{(wallet.canApply||qualificationPurchaseNeeded)&&!giftMode&&!referrerOnly&&tab==='overview'}}" class="officer-application">
   <view wx:if="{{agreement}}" class="officer-agreement-row">
    <button class="officer-agreement-check {{loading||busy||pending||!wallet.canApply||!agreement.effectiveOn ? 'control--disabled' : ''}}" bindtap="toggleAgreement" disabled="{{loading||busy||pending||!wallet.canApply||!agreement.effectiveOn}}" aria-role="checkbox" aria-checked="{{agreementChecked}}" aria-label="我已阅读并同意产品分享官合作协议"><view class="officer-agreement-check__mark {{agreementChecked ? 'officer-agreement-check__mark--on' : ''}}"><image wx:if="{{agreementChecked}}" src="/assets/icons/check-white.svg" aria-hidden="true"/></view></button>
    <text>我已阅读并同意</text>
    <button class="text-button officer-agreement-link {{loading||busy||pending ? 'control--disabled' : ''}}" bindtap="openAgreement" disabled="{{loading||busy||pending}}">《{{agreement.title}}》</button>
   </view>
   <button class="primary {{loading||busy||pending||qualificationOpening ? 'primary--disabled' : ''}}" data-sheet="apply" bindtap="open" disabled="{{loading||busy||pending||qualificationOpening}}">成为推荐官</button>
  </view>
 </view>
 <view wx:if="{{giftMode&&wallet.canShare&&giftActivities.length}}" class="officer-gift-footer"><text wx:if="{{giftError}}" class="officer-error">{{giftError}}</text><button wx:if="{{giftShare}}" class="primary {{loading||!giftAvailable?'primary--disabled':''}}" open-type="share" disabled="{{loading||!giftAvailable}}">分享这份礼遇</button><button wx:else class="primary {{loading||giftShareBusy||!giftAvailable?'primary--disabled':''}}" bindtap="retryGiftShare" loading="{{giftShareBusy}}" disabled="{{loading||giftShareBusy||!giftAvailable}}">{{!giftAvailable?'礼遇已领完':giftError?'重试分享':'准备分享'}}</button></view>
 <view wx:if="{{sheet}}" class="officer-mask" bindtap="close"><view class="officer-sheet" catchtap="stop"><view class="officer-sheet-head"><text>{{sheet==='apply'?'申请分享官':sheet==='payee'?'收款资料':sheet==='referrer'?'查找推荐人':sheet==='share'?'专属分享':'明细'}}</text><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="close" disabled="{{busy}}">关闭</button></view><scroll-view scroll-y class="officer-sheet-scroll" enhanced show-scrollbar="{{false}}">
  <block wx:if="{{sheet==='apply'}}"><label class="officer-field"><text>申请说明 · 选填</text><textarea data-keyboard-field="input" hold-keyboard="{{false}}" show-confirm-bar="{{false}}" confirm-type="return" value="{{note}}" maxlength="500" placeholder="简单介绍你的分享计划" data-field="note" bindinput="edit" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending ? 'primary--disabled' : ''}}" data-action="apply" bindtap="operate" loading="{{busy}}" disabled="{{busy||pending}}">提交申请</button></block>
  <block wx:elif="{{sheet==='payee'}}"><label class="officer-field"><text>收款人姓名</text><input data-keyboard-field="input" hold-keyboard="{{false}}" value="{{legalName}}" data-field="legalName" bindinput="edit" maxlength="80" disabled="{{busy||pending}}"/></label><label class="officer-field"><text>收款方式</text><input data-keyboard-field="input" hold-keyboard="{{false}}" value="{{channel}}" placeholder="如：银行转账" data-field="channel" bindinput="edit" maxlength="60" disabled="{{busy||pending}}"/></label><label class="officer-field"><text>收款账号</text><input data-keyboard-field="input" hold-keyboard="{{false}}" value="{{account}}" data-field="account" bindinput="edit" maxlength="160" disabled="{{busy||pending}}"/></label><text class="officer-note">仅用于公司财务结算；修改时请完整填写。</text><button class="primary {{busy||pending||!legalName||!channel||!account ? 'primary--disabled' : ''}}" data-action="payee" bindtap="operate" loading="{{busy}}" disabled="{{busy||pending||!legalName||!channel||!account}}">保存</button></block>
  <block wx:elif="{{sheet==='referrer'}}"><label class="officer-field"><text>用户编号</text><input data-keyboard-field="input" hold-keyboard="{{false}}" value="{{code}}" placeholder="输入12位用户编号" data-field="code" bindinput="edit" maxlength="12" disabled="{{busy||pending}}"/></label><button class="action-text {{busy||pending||code.length!==12 ? 'control--disabled' : ''}}" bindtap="previewReferrer" disabled="{{busy||pending||code.length!==12}}">查找用户</button><view wx:if="{{preview}}" class="officer-referrer"><text class="officer-strong">{{preview.label}}</text><text>{{preview.code}}</text><text class="officer-note">{{preview.eligible?(preview.onFirstValidOrder?'首笔有效成交后生效。':'更换后仅影响之后的订单。'):'该用户尚未开通分享官。'}}</text><button class="primary {{busy||pending||!preview.eligible ? 'primary--disabled' : ''}}" data-action="change_referrer" bindtap="operate" loading="{{busy}}" disabled="{{busy||pending||!preview.eligible}}">确认选择</button></view></block>
  <block wx:elif="{{sheet==='share'}}"><text class="officer-strong">{{selected.name}}</text><image wx:if="{{assets}}" class="officer-qr" src="{{assets.qrPath}}" mode="aspectFit" aria-label="专属商品小程序码"/><view wx:elif="{{busy}}" class="officer-empty">正在生成小程序码</view><button wx:if="{{share}}" class="primary {{busy ? 'primary--disabled' : ''}}" open-type="share" disabled="{{busy}}">分享给朋友</button><button wx:if="{{assets.urlLink}}" class="action-text officer-more" bindtap="copyLink">复制分享链接</button><text wx:if="{{assets&&!assets.urlAvailable}}" class="officer-note">外部链接暂不可用，可直接分享或使用小程序码。</text></block>
  <block wx:elif="{{sheet==='detail'&&selected}}"><block wx:if="{{tab==='orders'}}"><text class="officer-strong">{{selected.productName}}</text><text class="officer-note">{{selected.orderNumber}}</text><view class="officer-detail-row"><text>商品实付</text><text>¥{{selected.cash}}</text></view><view class="officer-detail-row"><text>退款</text><text>¥{{selected.refund}}</text></view><view class="officer-detail-row"><text>下单时佣金比例</text><text>{{selected.rate}}%</text></view><view class="officer-detail-row"><text>待结算 · 税前</text><text>¥{{selected.pending}}</text></view><view class="officer-detail-row"><text>可结算 · 税前</text><text>¥{{selected.available}}</text></view><view class="officer-detail-row"><text>已结算 · 税前</text><text>¥{{selected.settled}}</text></view><view wx:if="{{selected.outstandingRecoveryCents}}" class="officer-detail-row"><text>待核对冲回</text><text>¥{{selected.recovery}}</text></view><view class="officer-section">佣金记录</view><view wx:if="{{historyLoading}}" class="officer-note" aria-role="status">正在加载</view>
<view wx:for="{{history}}" wx:key="id" class="officer-history-record"><view class="officer-between"><text class="officer-strong">{{item.label}}</text><text wx:if="{{item.kind!=='payment_record'}}" class="officer-link">¥{{item.amount}}</text><text wx:else class="officer-link">{{item.stateLabel}}</text></view><text class="officer-muted">{{item.date}}</text>
 <block wx:if="{{item.kind==='payment_record'}}"><text class="officer-note">本单税前佣金 ¥{{item.orderGrossCents/100}} · {{item.period}} 月结</text><text class="officer-note">整笔月结税前 ¥{{item.gross}} · 扣税 {{item.settlementTaxCents===null?'待审核':'¥'+item.tax}} · {{item.state==='paid'?'实付':'预计实付'}} {{item.settlementNetCents===null?'待审核':'¥'+item.net}}</text></block>
 <text wx:if="{{item.kind==='recovery_record'}}" class="officer-note">实收 ¥{{item.received}} · 财务税务调整 ¥{{item.taxAdjustment}}</text><text wx:if="{{item.reference}}" class="officer-reference" user-select>{{item.reference}}</text>
</view><button wx:if="{{historyMore}}" class="action-text officer-more {{historyLoading ? 'control--disabled' : ''}}" bindtap="moreHistory" disabled="{{historyLoading}}">更早的记录</button>
</block>
   <block wx:else><text class="officer-strong">{{selected.period}} 月结 · {{selected.label}}</text><text wx:if="{{selected.paymentWindow&&selected.state!=='paid'}}" class="officer-note">计划发放 {{selected.paymentWindow.start}} 至 {{selected.paymentWindow.end}}</text><view class="officer-detail-row"><text>税前佣金</text><text>¥{{selected.gross}}</text></view><view class="officer-detail-row"><text>扣税</text><text>{{selected.taxCents===null?'待审核':'¥'+selected.tax}}</text></view><view class="officer-detail-row"><text>{{selected.state==='paid'?'实际到账':'预计实付'}}</text><text>{{selected.taxCents===null?'待审核':'¥'+selected.net}}</text></view><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="settlementOrders" disabled="{{busy}}">查看本次推广订单</button><text wx:if="{{selected.taxNote}}" class="officer-note">{{selected.taxNote}}</text><text wx:if="{{selected.paymentReference}}" class="officer-note">付款流水：{{selected.paymentReference}}</text></block>
  </block>
  <text wx:if="{{error}}" class="officer-error">{{error}}</text><view wx:if="{{pending}}" class="officer-actions"><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="recover" disabled="{{busy}}">查询上次操作</button><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="recover" data-abandon="{{true}}" disabled="{{busy}}">结束这次请求</button></view>
 </scroll-view></view></view>
 <view wx:if="{{agreementOpen}}" class="officer-agreement-overlay {{agreementClosing ? 'officer-agreement-overlay--closing' : ''}} {{agreementReduced ? 'officer-agreement-overlay--still' : ''}}">
  <view class="officer-agreement-scrim" catchtouchmove="stop" aria-hidden="true"/>
  <view class="officer-agreement-panel" aria-role="dialog" aria-modal="true" aria-label="{{agreement.title}}">
   <view class="officer-agreement-head">
    <text class="officer-agreement-title">{{agreement.title}}</text>
    <button class="officer-agreement-close" bindtap="closeAgreement" aria-label="关闭协议"><image src="/assets/icons/close-plum.svg" aria-hidden="true"/></button>
   </view>
   <scroll-view id="officer-agreement-scroll" class="officer-agreement-scroll" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}" lower-threshold="{{2}}" data-attempt="{{agreementAttempt}}" bindscrolltolower="agreementEnd" aria-label="协议全文">
    <view id="officer-agreement-body" class="officer-agreement-body">
     <view class="officer-agreement-cover"><text class="officer-agreement-brand">{{agreement.brand}}</text><text class="officer-agreement-subtitle">{{agreement.subtitle}}</text><text wx:for="{{agreement.tagline}}" wx:key="*this" class="officer-agreement-tagline">{{item}}</text><text wx:if="{{agreement.draftNotice}}" class="officer-agreement-draft">{{agreement.draftNotice}}</text></view>
     <view class="officer-agreement-parties"><text wx:for="{{agreement.parties}}" wx:key="*this" user-select="{{true}}">{{item}}</text></view>
     <text class="officer-agreement-intro" user-select="{{true}}">{{agreement.introduction}}</text>
     <view wx:for="{{agreement.sections}}" wx:for-item="section" wx:key="heading" class="officer-agreement-section">
      <text class="officer-agreement-h2">{{section.heading}}</text>
      <text wx:for="{{section.paragraphs}}" wx:key="text" class="officer-agreement-paragraph officer-agreement-paragraph--{{item.kind}}" user-select="{{true}}">{{item.kind==='bullet'?'• ':''}}{{item.text}}</text>
     </view>
     <view class="officer-agreement-end"><text wx:for="{{agreement.closing}}" wx:key="*this" user-select="{{true}}">{{item}}</text></view>
    </view>
   </scroll-view>
   <view class="officer-agreement-footer">
    <text wx:if="{{agreement.effectiveOn&&wallet.canApply&&!agreementAtEnd}}" class="officer-agreement-hint">请滑至协议末尾</text>
