@import '../../styles/sharing-officer.wxss';
.officer-qualification{display:flex;flex-direction:column;gap:12rpx;margin:28rpx 0;padding:24rpx 0;border-top:1rpx solid var(--cisme-line);border-bottom:1rpx solid var(--cisme-line)}.officer-qualification__head{display:flex;align-items:center;gap:14rpx;min-height:44px}.officer-qualification__icon{flex:none;width:24px;height:24px}.officer-qualification__state{margin-left:auto;flex:none;color:var(--cisme-plum);font-size:13px;font-weight:500}

.officer-qualification__icon--met,.officer-pending-icon{animation:qualification-confirm 420ms cubic-bezier(.16,1,.3,1) both}.officer-pending-icon{width:44px;height:44px;margin:28rpx 0 8rpx}@keyframes qualification-confirm{0%{transform:scale(.8);opacity:.55}100%{transform:scale(1);opacity:1}}@media(prefers-reduced-motion:reduce){.officer-qualification__icon--met,.officer-pending-icon{animation:none}}

.officer-gift-entry{display:flex;align-items:center;gap:16px;width:100%;padding:16px 0;margin:10px 0 24px;background:transparent;text-align:left;border-bottom:1rpx solid var(--cisme-line);border-radius:0}.officer-gift-entry>image{flex:none;width:64px;height:64px;border-radius:8px}.officer-gift-entry>view{flex:1;display:flex;flex-direction:column;gap:8px}.officer-gift-entry>.officer-gift-chevron{width:20px;height:20px}
.officer-root--gift .officer-page{padding-bottom:calc(120px + env(safe-area-inset-bottom))}.officer-gift-intro{display:flex;flex-direction:column;gap:14px;margin:16px 0 28px}.officer-gift-heading{font-size:26px;line-height:1.45;font-weight:600;color:var(--cisme-plum)}.officer-gift-heading>text{display:block}.officer-gift-card{margin-bottom:16px;padding:16px;background:#fffafd;border-radius:12px;box-shadow:0 6px 18px rgba(66,35,83,.06)}.officer-gift-card .officer-strong{font-size:18px;line-height:1.45}.officer-gift-card .action-text{flex:none;min-height:44px;margin:-8px -8px -8px 0;padding:0 8px}.officer-gift-product{display:flex;align-items:center;gap:14px;margin:14px 0}.officer-gift-photo{position:relative;flex:0 0 38%;height:144px}.officer-gift-photo>image{width:100%;height:100%}.officer-gift-copy{display:flex;flex-direction:column;gap:10px;min-width:0;flex:1;font-size:13px;line-height:1.5;color:#63546c}.officer-gift-benefit{font-size:15px;font-weight:600;color:var(--cisme-plum);margin-bottom:2px}.officer-gift-state{display:block;color:var(--cisme-plum);font-size:13px;padding-top:12px;border-top:1rpx solid var(--cisme-line)}.officer-gift-soldout{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(240,235,243,.65);border-radius:8px;font-size:16px;font-weight:600;color:#51425b}.officer-gift-card--empty .officer-gift-copy{opacity:.65}.officer-gift-footer{position:fixed;z-index:20;bottom:0;left:0;right:0;padding:12px 20px calc(16px + env(safe-area-inset-bottom));background:#faf6fc}.officer-gift-footer .officer-error{display:block;margin:0 0 10px}.officer-gift-activity{display:flex;align-items:center;justify-content:space-between;min-height:44px;color:var(--cisme-plum);font-size:14px}.officer-gift-activity>image{width:18px;height:18px}@media(max-width:360px){.officer-gift-product{gap:10px}.officer-gift-photo{height:132px}.officer-gift-copy{font-size:12px}.officer-gift-benefit{font-size:14px}}
.officer-gift-activity>image{transform:rotate(90deg)}
