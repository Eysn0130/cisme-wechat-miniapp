@import "../../styles/read-loading.wxss";
.product-nav{position:fixed;z-index:40;top:0;left:0;right:0;height:calc(var(--cisme-topbar-height,64px) + 52px);background:#f7f4f8}.product-topbar{background:#f7f4f8;border:0}.product-topbar .topbar__title{font-size:16px;letter-spacing:0}.product-topbar .topbar__back{border:0;background:transparent}
.product-tabs{display:flex;gap:32rpx;height:52px;margin-top:var(--cisme-topbar-height,64px);padding:0 30rpx;background:#f7f4f8}.product-tabs button{position:relative;min-width:54px;min-height:44px;margin:0;padding:0 8rpx 10rpx;border:0;border-radius:0;background:transparent;color:#807286;font-size:30rpx;line-height:1.4;display:flex;align-items:center;justify-content:center}.product-tabs button.is-active{color:#2f2149;font-weight:500}.product-tab__marker{position:absolute;bottom:8rpx;left:calc(50% - 20rpx);width:40rpx;height:4rpx;border-radius:4rpx;background:transparent;}
.product-page{min-height:100vh;padding-top:calc(var(--cisme-topbar-height,64px) + 52px);padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 100px);background:#f7f4f8}.product-gallery{position:relative;height:562.5rpx;background:#eee8f3}.product-cover,.product-gallery__open{width:100%;height:100%}.product-gallery__open{display:block;margin:0;padding:0;border:0;border-radius:0;background:transparent}.product-gallery__open image{width:100%;height:100%}.gallery-count{position:absolute;top:24rpx;right:24rpx;padding:7rpx 14rpx;border-radius:24rpx;color:#5e4c69;background:rgba(255,255,255,.8);font-size:21rpx;line-height:1.4}
.gallery-thumbs{width:100%;background:#f7f4f8;white-space:nowrap}.gallery-thumbs__list{display:inline-flex;gap:12rpx;padding:20rpx 28rpx}.gallery-thumb{flex:none;width:44px;min-height:44px;height:44px;margin:0;padding:3rpx;border:1px solid transparent;border-radius:8px;background:transparent}.gallery-thumb--active{border-color:#91729f;background:#fff}.gallery-thumb image{width:100%;height:100%}
.product-info{padding:24rpx 38rpx 38rpx;background:#fffcff}.product-price{display:flex;align-items:baseline;flex-wrap:wrap;gap:4rpx;color:#56306f;line-height:1.4}.product-qualifier{margin-right:8rpx;color:#7b6589;font-size:23rpx}.product-yen{font-size:30rpx}.product-amount{font-size:54rpx;font-weight:500;font-variant-numeric:tabular-nums}.product-name{display:block;margin-top:12rpx;color:#352a3a;font:500 44rpx/1.4 "Songti SC","STSong",serif}.product-subline{display:block;margin-top:14rpx;color:#6f5a7b;font-size:25rpx;line-height:1.8}.product-value,.product-policy,.product-policy-note{display:block;margin-top:8rpx;color:#796286;font-size:22rpx;line-height:1.8}.product-policy{margin-top:18rpx}.product-policy-note{font-size:21rpx}.product-selector{display:flex;align-items:center;justify-content:space-between;gap:18rpx;width:100%;min-height:60px;margin:16rpx 0 0;padding:28rpx 38rpx;border:0;border-radius:0;background:#fffcff;color:#594365;text-align:left;font-size:27rpx;line-height:1.5}.product-selector__value{display:block;margin-top:8rpx;color:#796286;font-size:22rpx}.product-selector image{flex:none;width:34rpx;height:34rpx}
.product-details{padding-top:38rpx}.product-section-title{display:block;padding:0 38rpx 24rpx;color:#4d355c;font:500 35rpx/1.5 "Songti SC","STSong",serif}.product-detail-image{display:block;width:100%;margin:0 0 3rpx;padding:0;border:0;border-radius:0;background:#eee8f3}.product-detail-image image{width:100%}.product-description{display:block;padding:0 38rpx 38rpx;color:#6f5a7b;font-size:27rpx;line-height:1.8;white-space:pre-wrap}.product-reviews{display:flex;flex-direction:column;min-height:calc(100vh - var(--cisme-topbar-height,64px) - 154px);padding:42rpx 0;background:#fffcff}.product-review-empty{display:flex;flex:1;align-items:center;justify-content:center;flex-direction:column;gap:20rpx;min-height:220px;color:#796786;font-size:25rpx}.product-review-empty image{width:54rpx;height:54rpx;opacity:.5}
.product-buybar{position:fixed;z-index:45;bottom:0;left:0;right:0;display:flex;align-items:center;gap:22rpx;padding:22rpx 28rpx calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 18rpx);background:rgba(255,252,255,.97)}.product-service{display:flex;align-items:center;justify-content:center;gap:10rpx;flex:none;min-width:78px;min-height:48px;margin:0;padding:0 24rpx;border:1rpx solid #d9cbdc;border-radius:48px;background:transparent;color:#61476f;font-size:25rpx;line-height:1.5}.product-service image{width:38rpx;height:38rpx}.product-buy{display:flex;flex:1;align-items:center;justify-content:center;min-height:48px;margin:0;padding:12rpx 22rpx;border:0;border-radius:48px;background:#56306f;color:#fff;font-size:30rpx;line-height:1.5}
.product-sheet-mask{position:fixed;z-index:90;top:0;left:0;right:0;bottom:0;display:flex;align-items:flex-end;background:rgba(44,27,59,.34)}.product-sheet{width:100%;max-height:88vh;padding:18rpx 38rpx calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 30rpx);overflow-y:auto;border-radius:44rpx 44rpx 0 0;background:#fffcff;color:#352a3a}.product-sheet__handle{width:60rpx;height:7rpx;margin:0 auto 10rpx;border-radius:7rpx;background:#dacde0}.product-sheet__head{display:flex;align-items:center;justify-content:space-between;min-height:44px;font:500 35rpx "Songti SC","STSong",serif}.product-sheet__head button{display:flex;align-items:center;justify-content:center;width:44px;min-height:44px;margin:0;padding:0;border:0;background:transparent}.product-sheet__head button image{width:40rpx;height:40rpx}.product-sheet__item{display:flex;align-items:center;gap:26rpx;margin:24rpx 0 36rpx}.product-sheet__cover{flex:none;width:164rpx;height:124rpx;border-radius:20rpx;background:#eee8f3}.product-sheet__name{font:500 30rpx/1.6 "Songti SC","STSong",serif}.product-sheet__item .product-amount{font-size:42rpx}.product-sheet__label{font-size:25rpx;color:#6c547a}.product-skus{display:flex;flex-wrap:wrap;gap:18rpx;margin-top:18rpx}.product-sku{display:flex;align-items:flex-start;justify-content:center;flex-direction:column;min-height:44px;margin:0;padding:20rpx 28rpx;border:1rpx solid #d9cbdc;border-radius:20rpx;background:#fff;color:#5b3c70;text-align:left;font-size:26rpx;line-height:1.7}.product-sku--active{border-color:#8e6ca2;background:#f2eaf7}.product-sku__gift{display:block;color:#80668e;font-size:22rpx}.product-quantity{display:flex;align-items:center;justify-content:space-between;min-height:48px;margin:36rpx 0 44rpx;color:#624d70;font-size:25rpx}.product-stepper{display:flex;align-items:center;gap:18rpx}.product-stepper button{display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin:0;padding:0;border:0;border-radius:9px;background:#f4eef8}.product-stepper button image{width:18px;height:18px}.product-stepper__value{min-width:26px;text-align:center;font-size:29rpx}.product-sheet__confirm{width:100%}.product-sheet__status{display:block;margin-bottom:18rpx;color:#796286;font-size:25rpx}
.product-sync{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:14rpx 38rpx;background:#eee4f2;color:#70597f;font-size:24rpx;line-height:1.6}.product-error{display:flex;flex-direction:column;gap:28rpx;margin:40rpx 28rpx;padding:38rpx;color:#6f5a7b;font-size:27rpx;line-height:1.8}.product-error__title{color:#352a3a;font:40rpx "Songti SC","STSong",serif}

.product-tab__marker--active{background:#704b76}
