.product-page { padding-right:0; padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 164rpx); padding-left:0; background:#f8f3f8; }.product-cover { width:100%; height:680rpx; }.product-content { position:relative; margin-top:-12rpx; padding:34rpx 28rpx 46rpx; border-radius:30rpx 30rpx 0 0; background:#f8f3f8; }.product-eyebrow { color:#6f6475; font:24rpx Georgia,serif; letter-spacing:5rpx; }.product-title { margin-top:13rpx; color:#392c40; font-family:"Songti SC","STSong",serif; font-size:40rpx; }.product-subtitle { margin-top:8rpx; color:#75697a; font-size:28rpx; }.product-price { margin-top:31rpx; color:#36293d; font:45rpx Georgia,"Times New Roman",serif; }.product-contract { margin-top:14rpx; padding:15rpx 18rpx; border-radius:20rpx; color:#6d5875; background:#ede2f1; font-size:24rpx; line-height:1.5; }
.product-facts { margin-top:24rpx; padding:7rpx 25rpx; border-radius:42rpx; }.product-fact { display:flex; align-items:center; gap:14rpx; min-height:81rpx; border-bottom:1rpx solid rgba(78,47,91,.1); color:#6f6573; font-size:var(--cisme-text-small); line-height:1.5; }.product-fact--last { border-bottom:0; }.product-fact__icon { flex:0 0 auto; width:30rpx; height:30rpx; }.product-note { margin-top:24rpx; color:#75697a; font-size:var(--cisme-text-small); line-height:1.5; }
.product-action { position:fixed; z-index:30; right:20rpx; bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 16rpx); left:20rpx; }.product-action__button { min-height:50px; margin:0; }.product-error-scene { min-height:520rpx; margin:18rpx 24rpx 0; }.product-error-action { margin-top:0; }
.product-page { padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 218rpx)); }
.product-price { display:flex; align-items:baseline; gap:8rpx; font:500 56rpx/1.15 -apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif; font-variant-numeric:lining-nums tabular-nums; }
.product-price__currency { font-size:34rpx; font-weight:400; }
.product-gallery { position:relative; height:680rpx; }
.gallery-arrow { position:absolute; z-index:2; top:calc(50% - 44rpx); display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; padding:0; border:1rpx solid rgba(255,255,255,.4); border-radius:50%; background:rgba(45,31,53,.24); }
.gallery-arrow__icon { width:40rpx; height:40rpx; }
.gallery-arrow--left { left:24rpx; }
.gallery-arrow--left .gallery-arrow__icon { transform:rotate(180deg); }
.gallery-arrow--right { right:24rpx; }
.gallery-count { position:absolute; right:28rpx; bottom:26rpx; padding:10rpx 16rpx; border-radius:24rpx; color:white; background:rgba(51,34,60,.38); font-size:22rpx; font-variant-numeric:tabular-nums; }
.product-fact__icon { flex:0 0 36rpx; width:36rpx; height:36rpx; }
.product-skus{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.product-sku{display:flex;align-items:flex-start;flex-direction:column;min-width:190rpx;min-height:88rpx;padding:14rpx 18rpx;border:1rpx solid var(--cisme-line);border-radius:20rpx;background:#fff;text-align:left}.product-sku strong{font-size:25rpx;font-weight:500}.product-sku small{margin-top:4rpx;color:var(--cisme-muted);font-size:21rpx}.product-sku--active{border-color:#765284;background:#f0e7f3}.product-sku--empty{opacity:.48}.product-quantity{display:flex;align-items:center;gap:16rpx;margin-top:18rpx}.product-quantity>text{margin-right:auto;color:var(--cisme-muted);font-size:25rpx}.product-quantity button{width:44px;height:44px;padding:0;border:1rpx solid var(--cisme-line);border-radius:50%;background:#fff;font-size:32rpx}.product-quantity strong{min-width:52rpx;text-align:center;font-size:29rpx}

.product-quantity button{display:flex;align-items:center;justify-content:center;flex:none;line-height:1}
.product-quantity__icon{width:18px;height:18px;flex:none}
