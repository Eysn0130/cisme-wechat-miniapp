.product-page { padding-right:0; padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 164rpx); padding-left:0; background:#f8f3f8; }.product-cover { width:100%; height:680rpx; }.product-content { position:relative; margin-top:-12rpx; padding:34rpx 28rpx 46rpx; border-radius:30rpx 30rpx 0 0; background:#f8f3f8; }.product-eyebrow { color:#6f6475; font:24rpx Georgia,serif; letter-spacing:5rpx; }.product-title { margin-top:13rpx; color:#392c40; font-family:"Songti SC","STSong",serif; font-size:40rpx; }.product-subtitle { margin-top:8rpx; color:#817687; font-size:28rpx; }.product-price { margin-top:31rpx; color:#36293d; font:45rpx Georgia,"Times New Roman",serif; }.product-contract { margin-top:14rpx; padding:15rpx 18rpx; border-radius:20rpx; color:#6d5875; background:#ede2f1; font-size:24rpx; line-height:1.5; }
.product-facts { margin-top:24rpx; padding:7rpx 25rpx; border-radius:42rpx; }.product-fact { display:flex; align-items:center; gap:14rpx; min-height:81rpx; border-bottom:1rpx solid rgba(78,47,91,.1); color:#6f6573; font-size:var(--cisme-text-small); line-height:1.5; }.product-fact--last { border-bottom:0; }.product-fact__icon { flex:0 0 auto; width:30rpx; height:30rpx; }.product-note { margin-top:24rpx; color:#8a7e8d; font-size:var(--cisme-text-small); line-height:1.5; }
.product-action { position:fixed; z-index:30; right:20rpx; bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 16rpx); left:20rpx; }.product-action__button { min-height:50px; margin:0; }.product-error-scene { min-height:520rpx; margin:18rpx 24rpx 0; }.product-error-action { margin-top:0; }
.product-page { padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 218rpx)); }
