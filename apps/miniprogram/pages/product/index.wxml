<page-meta root-font-size="system"/>
<view class="chrome-root" style="{{chromeStyle}}">
  <view class="product-nav"><view class="topbar product-topbar"><button class="topbar__back {{leaving ? 'control--disabled' : ''}}" bindtap="back" disabled="{{leaving}}" aria-label="返回商城"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">商品详情</text></view>
    <view class="product-tabs" aria-role="tablist"><button data-anchor="goods" bindtap="jumpAnchor" class="product-tab {{anchor==='goods'?'is-active':''}}" aria-role="tab" aria-selected="{{anchor==='goods'}}"><text>商品</text><view class="product-tab__marker {{anchor==='goods'?'product-tab__marker--active':''}}"/></button><button data-anchor="details" bindtap="jumpAnchor" class="product-tab {{anchor==='details'?'is-active':''}}" aria-role="tab" aria-selected="{{anchor==='details'}}"><text>详情</text><view class="product-tab__marker {{anchor==='details'?'product-tab__marker--active':''}}"/></button><button data-anchor="reviews" bindtap="jumpAnchor" class="product-tab {{anchor==='reviews'?'is-active':''}}" aria-role="tab" aria-selected="{{anchor==='reviews'}}"><text>评价</text><view class="product-tab__marker {{anchor==='reviews'?'product-tab__marker--active':''}}"/></button></view>
  </view>
  <view class="product-page">
    <view wx:if="{{loading && !item}}" class="page-read-loading" aria-role="status" aria-label="正在加载商品资料…"><view class="page-read-loading__indicator"/></view>
    <block wx:if="{{item}}">
      <view id="goods" class="product-gallery"><swiper class="product-cover" current="{{galleryIndex}}" circular="{{gallery.length>1}}" autoplay="{{false}}" duration="220" bindchange="galleryChange"><swiper-item wx:for="{{gallery}}" wx:for-item="photo" wx:key="src"><button class="product-gallery__open" bindtap="previewGallery" aria-label="放大查看：{{photo.label}}"><image src="{{photo.src}}" mode="aspectFit" bindload="imageLoaded"/></button></swiper-item></swiper><text class="gallery-count">{{galleryIndex+1}} / {{gallery.length}}</text></view>
      <scroll-view class="gallery-thumbs" scroll-x="{{true}}" show-scrollbar="{{false}}"><view class="gallery-thumbs__list"><button wx:for="{{gallery}}" wx:for-item="photo" wx:key="src" data-index="{{index}}" bindtap="selectGallery" class="gallery-thumb {{galleryIndex===index?'gallery-thumb--active':''}}" aria-label="图片{{index+1}}：{{photo.label}}" aria-pressed="{{galleryIndex===index}}"><image src="{{photo.src}}" mode="aspectFit"/></button></view></scroll-view>
      <view class="product-info"><view class="product-price"><text class="product-qualifier">{{item.qualifier}}</text><text class="product-yen">¥</text><text class="product-amount">{{item.displayPrice}}</text></view><text class="product-name">{{item.name}}</text><text class="product-subline">{{item.subtitle}}</text><text wx:if="{{item.materials.value}}" class="product-value">{{item.materials.value}}</text><text wx:if="{{item.materials}}" class="product-policy">小程序 3 倍积分 · 运费险 · 7 天无理由退货</text><text wx:if="{{item.materials}}" class="product-policy-note">活动与赠品以确认订单时的适用规则为准</text></view>
      <view wx:if="{{loading}}" class="product-sync" aria-live="polite">正在核对价格与库存…</view><view wx:if="{{error}}" class="product-sync" aria-live="polite"><text>{{error}}</text><button class="text-button" bindtap="load">重试</button></view>
      <button class="product-selector {{loading||navigating ? 'control--disabled' : ''}}" bindtap="openSku" disabled="{{loading||navigating}}"><view><text>{{selected?'已选':'选择规格与数量'}}</text><text wx:if="{{selected}}" class="product-selector__value">{{selectedSku.label}} · {{quantity}} 件</text><text wx:elif="{{!item.catalogBound}}" class="product-selector__value">{{item.materials.variant}}</text></view><image src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <view id="details" class="product-details"><text class="product-section-title">商品详情</text><button wx:for="{{details}}" wx:for-item="photo" wx:key="src" class="product-detail-image" data-src="{{photo.src}}" bindtap="previewDetail" aria-label="放大查看：{{photo.label}}"><image src="{{photo.src}}" mode="widthFix" style="height:{{photo.height*750/photo.width}}rpx" lazy-load="{{true}}" bindload="imageLoaded"/></button><text wx:if="{{!details.length}}" class="product-description">{{item.description || '成分与用法请参阅产品说明'}}</text></view>
      <view id="reviews" class="product-reviews"><text class="product-section-title">商品评价</text><view class="product-review-empty"><image src="/assets/icons/chat-circle-plum.svg" mode="aspectFit"/><text>暂无评价</text></view></view>
    </block>
    <view wx:if="{{!item && error}}" class="product-error" aria-live="assertive"><text class="product-error__title">{{errorTitle}}</text><text>{{error}}</text><button wx:if="{{errorKind==='load'}}" class="primary {{loading?'primary--disabled':''}}" disabled="{{loading}}" bindtap="load">重新加载商品资料</button><button class="secondary" bindtap="back">返回商城</button></view>
  </view>
  <view wx:if="{{item}}" class="product-buybar"><button class="product-service {{navigating ? 'control--disabled' : ''}}" bindtap="openSupport" disabled="{{navigating}}"><image src="/assets/icons/chat-circle-plum.svg" mode="aspectFit"/><text>客服</text></button><button class="primary product-buy {{loading||navigating||!item.purchaseEnabled?'primary--disabled':''}}" bindtap="buy" disabled="{{loading||navigating||!item.purchaseEnabled}}">{{loading?'正在更新':!item.purchaseEnabled?item.availability:selected?'立即购买':'选择规格'}}</button></view>
  <view wx:if="{{sheetOpen}}" class="product-sheet-mask" catchtap="closeSku"><view class="product-sheet" catchtap="stopPropagation"><view class="product-sheet__handle"/><view class="product-sheet__head"><text>选择规格与数量</text><button bindtap="closeSku" aria-label="关闭规格选择"><image src="/assets/icons/close-plum.svg" mode="aspectFit"/></button></view><view class="product-sheet__item"><image class="product-sheet__cover" src="{{gallery[0].src}}" mode="aspectFit"/><view><text class="product-sheet__name">{{item.name}}</text><view class="product-price"><text class="product-qualifier">{{item.qualifier}}</text><text class="product-yen">¥</text><text class="product-amount">{{item.displayPrice}}</text></view></view></view><text class="product-sheet__label">规格</text><view class="product-skus"><button wx:for="{{item.variants}}" wx:for-item="sku" wx:key="id" data-id="{{sku.id}}" bindtap="selectSku" disabled="{{!sku.active||!sku.inStock}}" class="product-sku {{draftSku.id===sku.id?'product-sku--active':''}} {{!sku.inStock?'control--disabled':''}} {{!sku.active||!sku.inStock ? 'control--disabled' : ''}}" aria-pressed="{{draftSku.id===sku.id}}"><text>{{sku.label}}</text><text wx:if="{{!sku.inStock}}">暂时缺货</text></button><view wx:if="{{!item.variants.length}}" class="product-sku product-sku--active"><text>{{item.materials.variant}}</text><text class="product-sku__gift">{{item.materials.gift}}</text></view></view><view class="product-quantity"><text>数量</text><view class="product-stepper"><button class="{{draftQuantity<=1 ? 'control--disabled' : ''}}" bindtap="decrease" disabled="{{draftQuantity<=1}}" aria-label="减少数量"><image src="/assets/icons/stepper-minus-plum.svg" mode="aspectFit"/></button><text class="product-stepper__value">{{draftQuantity}}</text><button class="{{!draftSku||draftQuantity>=draftSku.availableQuantity||draftQuantity>=99 ? 'control--disabled' : ''}}" bindtap="increase" disabled="{{!draftSku||draftQuantity>=draftSku.availableQuantity||draftQuantity>=99}}" aria-label="增加数量"><image src="/assets/icons/stepper-plus-plum.svg" mode="aspectFit"/></button></view></view><text wx:if="{{!item.purchaseEnabled}}" class="product-sheet__status">{{item.availability}}</text><button class="primary product-buy product-sheet__confirm {{!draftSku.inStock?'primary--disabled':''}}" bindtap="confirmSku" disabled="{{!draftSku.inStock}}">确认选择</button></view></view>
</view>
