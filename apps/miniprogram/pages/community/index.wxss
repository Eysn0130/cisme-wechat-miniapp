.community-page { padding:0 18rpx calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 166rpx); background:#f7f4f8; }
.community-head { position:sticky; z-index:20; top:0; margin:0 -18rpx; padding:calc(var(--cisme-status-bar,20px) + 24rpx) 38rpx 64rpx; border-radius:0 0 28rpx 28rpx; background:rgba(247,243,248,.94); -webkit-backdrop-filter:blur(20rpx); }
.community-title-row { display:flex; align-items:center; justify-content:space-between; gap:14rpx; padding-right:var(--cisme-nav-side,112rpx); }.community-wordmark { flex:none; color:#2f2149; font:50rpx Georgia,serif; letter-spacing:7rpx; }.community-wordmark__section { margin-left:7rpx; font-family:"Songti SC","STSong",serif; font-size:30rpx; letter-spacing:1rpx; }
.community-curation { padding:10rpx 17rpx; border-radius:999rpx; color:#684878; background:#eee4f2; font-size:var(--cisme-text-small); line-height:1.5; }
.community-mode { display:flex; align-items:flex-end; gap:82rpx; min-height:76rpx; margin-top:20rpx; color:#716a77; }.community-mode__active { position:relative; color:#54366b; font-family:"Songti SC","STSong",serif; font-size:34rpx; }.community-mode__line { position:absolute; right:0; bottom:-42rpx; left:0; height:5rpx; border-radius:999rpx; background:#654675; }.community-mode__meta { font-family:"Songti SC","STSong",serif; font-size:30rpx; }
.community-loading { margin:18rpx 8rpx 0; color:#756b79; font-size:24rpx; line-height:1.5; text-align:center; }
.community-sync-error { margin:18rpx 8rpx 0; }
.community-hero-card { position:relative; width:100%; height:476rpx; margin-top:36rpx; padding:0; overflow:hidden; border:0; border-radius:54rpx; color:#fff; background:#352a3a; text-align:left; box-shadow:0 18rpx 38rpx rgba(45,27,57,.14); }.community-hero-image { width:100%; height:100%; }.community-hero-shade { position:absolute; top:0; right:0; bottom:0; left:0; background:linear-gradient(90deg,rgba(20,15,24,.88),rgba(24,17,29,.44) 48%,rgba(20,14,24,.04)),linear-gradient(0deg,rgba(20,14,24,.72),transparent 52%); }
.community-hero-copy { position:absolute; top:64rpx; left:46rpx; width:49%; }.community-hero-copy__title { font-family:"Songti SC","STSong",serif; font-size:44rpx; line-height:1.36; letter-spacing:1rpx; }.community-hero-copy__excerpt { display:block; margin-top:12rpx; color:rgba(255,255,255,.82); font-family:"Songti SC","STSong",serif; font-size:24rpx; line-height:1.58; }
.featured-author { position:absolute; right:36rpx; bottom:100rpx; left:36rpx; display:flex; align-items:center; min-height:88rpx; gap:18rpx; }.featured-author__avatar { width:72rpx; height:72rpx; border:1rpx solid rgba(255,255,255,.72); border-radius:50%; }.featured-author__copy { flex:1; }.featured-author__name,.featured-author__label { display:block; }.featured-author__name { font-size:26rpx; font-weight:400; }.featured-author__label { margin-top:6rpx; color:rgba(255,255,255,.72); font-size:var(--cisme-text-small); line-height:1.5; }.hero-actions { position:absolute; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:flex-end; height:100rpx; padding:0 34rpx; gap:12rpx; border-top:1rpx solid rgba(255,255,255,.15); background:rgba(21,14,25,.18); }.hero-action-icon { width:30rpx; height:30rpx; filter:brightness(0) invert(1); }.hero-action-label { color:rgba(255,255,255,.82); font-size:var(--cisme-text-small); line-height:1.5; }
.invite { min-height:var(--cisme-hit-target); margin-top:18rpx; font-size:var(--cisme-text-small); }
.community-task-list { margin-top:24rpx; padding:10rpx 24rpx; border-radius:34rpx; }.community-task-list__head { display:flex; align-items:center; justify-content:space-between; min-height:52px; color:#4b3955; }.community-task-list__title { font-size:14px; font-weight:400; }.community-task-list__count { color:#817788; font-size:12px; }.community-task-row { display:flex; align-items:center; justify-content:space-between; gap:14rpx; width:100%; min-height:58px; padding:8px 0; border:0; border-top:1rpx solid rgba(78,47,91,.09); color:#56306f; background:transparent; font-size:12px; text-align:left; }.community-task-row__copy { min-width:0; flex:1; }.community-task-row__title,.community-task-row__status { display:block; }.community-task-row__title { overflow:hidden; color:#443649; font-size:12px; font-weight:400; text-overflow:ellipsis; white-space:nowrap; }.community-task-row__status { margin-top:4rpx; color:#817788; font-size:10px; }.community-task-row__action { flex:0 0 auto; max-width:180rpx; line-height:1.35; text-align:right; }
.community-notice { display:flex; align-items:flex-start; gap:11rpx; margin-top:20rpx; padding:17rpx 19rpx; border-radius:24rpx; color:#726779; background:rgba(236,225,241,.58); font-size:var(--cisme-text-small); line-height:1.5; }.community-notice__icon { flex:0 0 auto; width:27rpx; height:27rpx; margin-top:1rpx; }
.feed-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx 14rpx; margin-top:18rpx; }.feed-card { overflow:hidden; margin:0; padding:0; border-radius:42rpx; background:rgba(255,252,255,.82); text-align:left; line-height:1.4; }.feed-card__image { width:100%; height:438rpx; }.feed-card__body { padding:17rpx 16rpx 15rpx; }.feed-card__title { display:-webkit-box; overflow:hidden; font-family:"Songti SC","STSong",serif; font-size:28rpx; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.feed-card__meta { display:flex; align-items:center; gap:7rpx; margin-top:14rpx; color:#7c737f; font-size:var(--cisme-text-small); line-height:1.5; }.feed-card__avatar { width:35rpx; height:35rpx; border-radius:50%; }.feed-card__author { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.feed-card__meta-icon { width:22rpx; height:22rpx; }.feed-card__engagement { max-width:88rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

/* Mobile discovery puts every story in the same masonry feed. */
.feed-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16rpx; margin-top:12rpx; }
.feed-column { min-width:0; }
.feed-card { display:inline-block; width:100%; margin:0 0 18rpx; border-radius:24rpx; break-inside:avoid; vertical-align:top; }
.feed-card__image--compact { height:350rpx; }
.feed-card__title { font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:28rpx; font-weight:600; line-height:1.45; }
.feed-card__meta-icon,.feed-card__engagement { display:none; }

.community-mode__tab { margin:0; padding:0 24rpx; background:transparent; font-size:30rpx; color:inherit; border-radius:0; }
.community-mode__active { border-bottom:4rpx solid #673b56; font-weight:600; }
.review-card { padding:24rpx; margin:24rpx 0; }
.review-detail { display:block; margin:16rpx 0; }

.review-profile { display:flex; align-items:center; gap:22rpx; }
.review-profile-avatar { width:100rpx; height:100rpx; border-radius:50%; flex:none; }
