@import "../../styles/read-loading.wxss";
@import "../../styles/community-feed.wxss";
.community-page { padding:0 18rpx calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 166rpx); background:#f7f4f8; }
.community-head { position:sticky; z-index:20; top:0; margin:0 -18rpx; padding:calc(var(--cisme-status-bar,20px) + 24rpx) 38rpx 0; border-radius:0 0 28rpx 28rpx; background:rgba(247,243,248,.94); -webkit-backdrop-filter:blur(20rpx); }
.community-title-row { display:flex; align-items:center; justify-content:space-between; gap:14rpx; padding-right:var(--cisme-nav-side,112rpx); }.community-wordmark { flex:none; color:#2f2149; font:50rpx Georgia,serif; letter-spacing:7rpx; }.community-wordmark__section { margin-left:7rpx; font-family:"Songti SC","STSong",serif; font-size:30rpx; letter-spacing:1rpx; }
.community-curation { padding:10rpx 17rpx; border-radius:999rpx; color:#684878; background:#eee4f2; font-size:var(--cisme-text-small); line-height:1.5; }
.community-mode { display:flex; align-items:center; gap:12rpx; min-height:44px; margin-top:8rpx; color:#716a77; }
.community-loading { margin:18rpx 8rpx 0; color:#756b79; font-size:24rpx; line-height:1.5; text-align:center; }
.community-sync-error { margin:18rpx 8rpx 0; }
.community-hero-card { position:relative; width:100%; height:476rpx; margin-top:36rpx; padding:0; overflow:hidden; border:0; border-radius:54rpx; color:#fff; background:#352a3a; text-align:left; box-shadow:0 18rpx 38rpx rgba(45,27,57,.14); }.community-hero-image { width:100%; height:100%; }.community-hero-shade { position:absolute; top:0; right:0; bottom:0; left:0; background:linear-gradient(90deg,rgba(20,15,24,.88),rgba(24,17,29,.44) 48%,rgba(20,14,24,.04)),linear-gradient(0deg,rgba(20,14,24,.72),transparent 52%); }
.community-hero-copy { position:absolute; top:64rpx; left:46rpx; width:49%; }.community-hero-copy__title { font-family:"Songti SC","STSong",serif; font-size:44rpx; line-height:1.36; letter-spacing:1rpx; }.community-hero-copy__excerpt { display:block; margin-top:12rpx; color:rgba(255,255,255,.82); font-family:"Songti SC","STSong",serif; font-size:24rpx; line-height:1.58; }
.featured-author { position:absolute; right:36rpx; bottom:100rpx; left:36rpx; display:flex; align-items:center; min-height:88rpx; gap:18rpx; }.featured-author__avatar { width:72rpx; height:72rpx; border:1rpx solid rgba(255,255,255,.72); border-radius:50%; }.featured-author__copy { flex:1; }.featured-author__name,.featured-author__label { display:block; }.featured-author__name { font-size:26rpx; font-weight:400; }.featured-author__label { margin-top:6rpx; color:rgba(255,255,255,.72); font-size:var(--cisme-text-small); line-height:1.5; }.hero-actions { position:absolute; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:flex-end; height:100rpx; padding:0 34rpx; gap:12rpx; border-top:1rpx solid rgba(255,255,255,.15); background:rgba(21,14,25,.18); }.hero-action-icon { width:30rpx; height:30rpx; filter:brightness(0) invert(1); }.hero-action-label { color:rgba(255,255,255,.82); font-size:var(--cisme-text-small); line-height:1.5; }
.invite { min-height:var(--cisme-hit-target); margin-top:18rpx; font-size:var(--cisme-text-small); }
.community-notice { display:flex; align-items:flex-start; gap:11rpx; margin-top:20rpx; padding:17rpx 19rpx; border-radius:24rpx; color:#726779; background:rgba(236,225,241,.58); font-size:var(--cisme-text-small); line-height:1.5; }.community-notice__icon { flex:0 0 auto; width:27rpx; height:27rpx; margin-top:1rpx; }
.review-card { padding:24rpx; margin:24rpx 0; }
.review-detail { display:block; margin:16rpx 0; }

.review-profile { display:flex; align-items:center; gap:22rpx; }
.review-profile-avatar { width:100rpx; height:100rpx; border-radius:50%; flex:none; }
.review-report-heading{display:block;margin:30rpx 0 16rpx;color:#543f5f;font-size:29rpx;font-weight:600}.review-report-card .review-detail{display:block;margin-top:8rpx}.review-report-actions{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:16rpx}.review-report-actions button{min-height:var(--cisme-hit-target);margin:0;padding:0 18rpx;border:1rpx solid #ddcfe3;border-radius:14rpx;background:#fff;color:#684c73;font-size:23rpx;display:flex;align-items:center;justify-content:center;line-height:1.25}.review-report-actions .control--disabled{opacity:.52}
.community-publisher-mask { position:fixed; z-index:90; top:0; right:0; bottom:0; left:0; display:flex; align-items:flex-end; background:rgba(31,22,37,.3); }
.community-publisher-sheet { width:100%; max-height:85vh; padding:8px 22px calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 12px); overflow-y:auto; border-radius:20px 20px 0 0; background:#fff; color:var(--cisme-ink); }
.community-publisher-handle { width:32px; height:4px; margin:0 auto 4px; border-radius:4px; background:#e3dce7; }
.community-publisher-head { display:flex; align-items:center; justify-content:flex-end; min-height:44px; }
.community-publisher-title { font-size:18px; font-weight:500; line-height:1.5; }
.community-publisher-drafts { flex:none; min-width:var(--cisme-hit-target); min-height:var(--cisme-hit-target); margin:0; padding:0 8px; border:0; background:transparent; color:var(--cisme-plum); font-size:var(--cisme-text-body); line-height:1.5; }
.community-publisher-option { display:flex; align-items:center; justify-content:center; width:100%; min-height:60px; margin:0; padding:12px 0; border:0; border-bottom:1rpx solid var(--cisme-line); border-radius:0; background:transparent; color:var(--cisme-ink); font-size:18px; line-height:1.5; text-align:center; white-space:normal; }
.community-publisher-icon { display:flex; align-items:center; justify-content:center; flex:none; width:48px; height:48px; border-radius:14px; background:#f3eef6; }
.community-publisher-icon image { width:26px; height:26px; }
.community-publisher-caret { flex:none; margin-left:auto; color:var(--cisme-muted); font-size:24px; }
.community-publisher-status { margin:12px 0 0; padding:12px 14px; border-radius:12px; background:#f7f4f9; color:var(--cisme-ink); font-size:var(--cisme-text-body); line-height:1.6; word-break:break-word; }
.community-publisher-recovery { display:flex; align-items:center; justify-content:center; min-height:var(--cisme-hit-target); margin:8px 0 0; padding:8px 14px; border:1rpx solid var(--cisme-line); border-radius:24px; background:#fff; color:var(--cisme-plum); font-size:var(--cisme-text-body); line-height:1.5; }
.community-publisher-cancel { display:flex; align-items:center; justify-content:center; width:100%; min-height:50px; margin:12px 0 0; padding:10px; border:0; border-radius:14px; background:#f7f4f8; color:var(--cisme-ink); font-size:var(--cisme-text-action); line-height:1.5; }
.community-publisher-sheet .control--disabled { opacity:.45; }
