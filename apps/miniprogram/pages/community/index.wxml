<import src="../../templates/community-feed.wxml"/>
<view class="page community-page" style="{{chromeStyle}}">
  <view class="community-head">
    <view class="community-title-row"><view class="community-wordmark">CISME <text class="community-wordmark__section">社区</text></view><view class="community-curation">{{mode === 'following' ? '关注动态' : '品牌精选'}}</view></view>
    <view class="community-mode" aria-role="tablist" aria-label="社区内容分类">
      <button class="community-mode__tab {{mode === 'featured' ? 'community-mode__active' : ''}}" data-mode="featured" bindtap="selectMode" aria-role="tab" aria-selected="{{mode === 'featured'}}" aria-label="精选，{{mode === 'featured' ? '当前分类' : '未选中'}}"><text class="community-mode__label">精选</text><view class="community-mode__marker {{mode === 'featured' ? 'is-active' : ''}}" aria-hidden="true"/></button>
      <button class="community-mode__tab {{mode === 'following' ? 'community-mode__active' : ''}}" data-mode="following" bindtap="selectMode" aria-role="tab" aria-selected="{{mode === 'following'}}" aria-label="关注，{{mode === 'following' ? '当前分类' : '未选中'}}"><text class="community-mode__label">关注</text><view class="community-mode__marker {{mode === 'following' ? 'is-active' : ''}}" aria-hidden="true"/></button>
      <button wx:if="{{ugcFeedEnabled || socialPreviewEnabled}}" class="community-mode__tab {{mode === 'recommend' ? 'community-mode__active' : ''}}" data-mode="recommend" bindtap="selectMode" aria-role="tab" aria-selected="{{mode === 'recommend'}}" aria-label="推荐，{{mode === 'recommend' ? '当前分类' : '未选中'}}"><text class="community-mode__label">推荐</text><view class="community-mode__marker {{mode === 'recommend' ? 'is-active' : ''}}" aria-hidden="true"/></button>
      <button wx:if="{{canReview}}" class="community-mode__tab {{mode === 'review' ? 'community-mode__active' : ''}}" data-mode="review" bindtap="selectMode" aria-role="tab" aria-selected="{{mode === 'review'}}" aria-label="内容管理，{{mode === 'review' ? '当前分类' : '未选中'}}"><text class="community-mode__label">内容管理</text><view class="community-mode__marker {{mode === 'review' ? 'is-active' : ''}}" aria-hidden="true"/></button>
    </view>
  </view>

  <view wx:if="{{mode === 'review'}}" class="review-panel">
    <text wx:if="{{reviewBusy}}">正在加载内容管理列表…</text>
    <view wx:if="{{teamError}}" class="state state--error">{{teamError}}</view>
    <view wx:if="{{reviewNotice}}" class="state" aria-live="polite">{{reviewNotice}}</view>
    <button class="{{reviewBusy ? 'control--disabled' : ''}} text-button" bindtap="loadReview" disabled="{{reviewBusy}}">刷新列表</button>
    <view wx:for="{{profileReviewQueue}}" wx:key="member_id" class="glass review-card"><view class="review-profile"><image class="review-profile-avatar" src="{{item.avatar}}" mode="aspectFill"/><view><text>社区头像昵称待审核</text><text class="review-detail">{{item.display_name}}</text></view></view><button class="{{reviewBusy ? 'control--disabled' : ''}}" data-id="{{item.member_id}}" data-decision="approve" bindtap="reviewMemberProfile" disabled="{{reviewBusy}}">通过资料审核</button><button class="{{reviewBusy ? 'control--disabled' : ''}}" data-id="{{item.member_id}}" data-decision="reject" bindtap="reviewMemberProfile" disabled="{{reviewBusy}}">退回修改</button></view>
    <view wx:if="{{formalAppealQueue.length}}" class="review-report-heading">内容申诉 · {{appealTotal}} 条待复核</view>
    <view wx:for="{{formalAppealQueue}}" wx:key="id" class="glass review-card review-report-card">
      <text>下架申诉 · {{item.title || '图片护理故事'}}</text>
      <text wx:if="{{item.body}}" class="review-detail">{{item.body}}</text>
      <text class="review-detail">下架依据：{{item.hiddenReason || '请核对处理记录'}}</text>
      <text class="review-detail">作者说明：{{item.reason}}</text>
      <text wx:if="{{item.postState!=='hidden'}}" class="review-detail">内容状态已变化，请刷新核对。</text>
      <view class="review-report-actions"><button data-id="{{item.id}}" data-decision="restore" bindtap="decideFormalAppeal"
        class="{{reviewBusy || !ugcFeedEnabled || item.postState!=='hidden' || item.hiddenByMemberId===reviewActorId || item.hideReporterMemberId===reviewActorId || item.authorId===reviewActorId?'control--disabled':''}}"
        disabled="{{reviewBusy || !ugcFeedEnabled || item.postState!=='hidden' || item.hiddenByMemberId===reviewActorId || item.hideReporterMemberId===reviewActorId || item.authorId===reviewActorId}}">复核后恢复</button>
        <button data-id="{{item.id}}" data-decision="uphold" bindtap="decideFormalAppeal" class="{{reviewBusy || item.hiddenByMemberId===reviewActorId || item.hideReporterMemberId===reviewActorId || item.authorId===reviewActorId?'control--disabled':''}}" disabled="{{reviewBusy || item.hiddenByMemberId===reviewActorId || item.hideReporterMemberId===reviewActorId || item.authorId===reviewActorId}}">维持下架</button></view>
      <text wx:if="{{!ugcFeedEnabled}}" class="review-detail">公开发布未启用，暂不能恢复。</text>
    </view>
    <button wx:if="{{appealNextCursor}}" class="text-button {{appealLoadingMore?'control--disabled':''}}" bindtap="loadMoreAppeals" disabled="{{appealLoadingMore}}" loading="{{appealLoadingMore}}">加载更多申诉</button>
    <view wx:if="{{formalReportQueue.length}}" class="review-report-heading">内容举报 · {{reportTotal}} 条待处理</view>
    <view wx:for="{{formalReportQueue}}" wx:key="id" class="glass review-card review-report-card">
      <text>举报{{item.targetType==='post'?'帖子':item.targetType==='comment'?'评论':'用户'}} · {{reportCategoryLabels[item.category] || '类型待核对'}}</text>
      <text class="review-detail">{{item.targetSummary || '对象当前不可见，请核对举报信息'}}</text>
      <text wx:if="{{item.description}}" class="review-detail">举报说明：{{item.description}}</text>
      <view class="review-report-actions"><button wx:if="{{item.postId}}" data-id="{{item.id}}" bindtap="openReportTarget">查看内容</button>
        <button wx:if="{{item.targetType==='post'}}" data-id="{{item.id}}" data-decision="hide_post" bindtap="decideFormalReport" class="{{reviewBusy?'control--disabled':''}}" disabled="{{reviewBusy}}">核查后下架</button>
        <button wx:if="{{item.targetType==='comment'}}" data-id="{{item.id}}" data-decision="remove_comment" bindtap="decideFormalReport" class="{{reviewBusy?'control--disabled':''}}" disabled="{{reviewBusy}}">核查后移除</button>
        <button data-id="{{item.id}}" data-decision="dismiss" bindtap="decideFormalReport" class="{{reviewBusy?'control--disabled':''}}" disabled="{{reviewBusy}}">驳回举报</button></view>
      <text wx:if="{{item.targetType==='member'}}" class="review-detail">账号问题需另行核查，此处不能停用账号。</text>
    </view>
    <button wx:if="{{reportNextCursor}}" class="text-button {{reportLoadingMore?'control--disabled':''}}" bindtap="loadMoreReports" disabled="{{reportLoadingMore}}" loading="{{reportLoadingMore}}">加载更多举报</button>
    <text wx:if="{{!reviewBusy && !teamError && !profileReviewQueue.length && !formalReportQueue.length && !formalAppealQueue.length}}">当前没有待处理的资料或内容</text>
  </view>
  <block wx:if="{{mode !== 'review'}}">
  <view wx:if="{{mode === 'recommend' && (!loading || feedReady) && !displayFeedCount && !error}}" class="state">还没有已发布的护理故事，请稍后再来。</view>
  <view wx:if="{{mode === 'featured' && (!loading || feedReady) && !displayFeedCount && !error}}" class="state">还没有精选内容，请稍后再来。</view>
  <view wx:if="{{mode === 'following' && (!loading || feedReady) && !displayFeedCount && !error}}" class="state community-following-empty"><text>关注作者后，在这里看新动态。</text><button class="text-button" data-mode="featured" bindtap="selectMode">去精选发现作者</button></view>
  <view wx:if="{{loading && !feedReady && !displayFeedCount}}" class="page-read-loading" aria-role="status" aria-label="正在加载护理故事"><view class="page-read-loading__indicator"/></view>
  <view wx:if="{{error}}" class="state state--error community-sync-error" aria-live="assertive"><text class="state-error__copy">{{error}}</text><button class="text-button state-error__action" bindtap="load">重新加载</button></view>

  <template is="communityFeed" data="{{feedColumns, navigating}}"/>
  <view wx:if="{{moreError}}" class="state state--error" aria-live="polite"><text>{{moreError}}</text><button class="text-button {{formalLoadingMore ? 'control--disabled' : ''}}" bindtap="onReachBottom" disabled="{{formalLoadingMore}}">重试加载更多</button></view>
  <view wx:if="{{formalLoadingMore}}" class="community-loading" aria-live="polite">正在加载更多内容…</view>
  </block>
  <view wx:if="{{publishEntryOpen}}" class="community-publisher-mask" catchtap="closePublisherEntry" catchtouchmove="holdPublisherEntry">
    <view class="community-publisher-sheet" catchtap="holdPublisherEntry" aria-role="dialog" aria-modal="{{true}}" aria-label="选择创作方式">
      <view class="community-publisher-handle" aria-hidden="true"></view>
      <view class="community-publisher-head"><button class="community-publisher-drafts {{publishEntryBusy ? 'control--disabled' : ''}}" bindtap="openMyPosts" disabled="{{publishEntryBusy}}">我的投稿</button></view>
      <button class="community-publisher-option {{publishEntryBusy || !ugcDraftsEnabled ? 'control--disabled' : ''}}" data-source="album" bindtap="choosePublisherSource" disabled="{{publishEntryBusy || !ugcDraftsEnabled}}" loading="{{publishEntryBusy && publishEntrySource === 'album'}}" aria-label="从相册选择，最多9张图片"><text>从相册选择</text></button>
      <button class="community-publisher-option {{publishEntryBusy || !ugcDraftsEnabled ? 'control--disabled' : ''}}" data-source="camera" bindtap="choosePublisherSource" disabled="{{publishEntryBusy || !ugcDraftsEnabled}}" loading="{{publishEntryBusy && publishEntrySource === 'camera'}}" aria-label="相机，拍摄一张照片"><text>相机</text></button>
      <button class="community-publisher-option {{publishEntryBusy || !ugcDraftsEnabled ? 'control--disabled' : ''}}" data-source="text" bindtap="choosePublisherSource" disabled="{{publishEntryBusy || !ugcDraftsEnabled}}" aria-label="写文字，无需相册或相机权限"><text>写文字</text></button>
      <view wx:if="{{publishEntryError}}" class="community-publisher-status" aria-live="polite"><text>{{publishEntryError}}</text><button wx:if="{{publishEntryRecovery === 'settings'}}" class="community-publisher-recovery {{publishEntryBusy ? 'control--disabled' : ''}}" bindtap="openPublisherMediaSettings" disabled="{{publishEntryBusy}}">去设置</button><button wx:if="{{publishEntryRecovery === 'privacy'}}" class="community-publisher-recovery {{publishEntryBusy ? 'control--disabled' : ''}}" bindtap="retryPublisherMedia" disabled="{{publishEntryBusy}}">重新授权</button></view>
      <button class="community-publisher-cancel" bindtap="closePublisherEntry">取消</button>
    </view>
  </view>
</view>
