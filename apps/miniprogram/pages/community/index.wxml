<view class="page community-page" style="{{chromeStyle}}">
  <view class="community-head">
    <view class="community-title-row"><view class="community-wordmark">CISME <text class="community-wordmark__section">社区</text></view><view class="community-curation">品牌精选</view></view>
    <view class="community-mode" aria-role="tablist" aria-label="社区内容分类"><button class="community-mode__tab {{mode === 'featured' ? 'community-mode__active' : ''}}" data-mode="featured" bindtap="selectMode" aria-role="tab" aria-selected="{{mode === 'featured'}}" aria-label="精选，{{mode === 'featured' ? '当前分类' : '未选中'}}">精选</button><button wx:if="{{ugcFeedEnabled || socialPreviewEnabled}}" class="community-mode__tab {{mode === 'recommend' ? 'community-mode__active' : ''}}" data-mode="recommend" bindtap="selectMode" aria-role="tab" aria-selected="{{mode === 'recommend'}}" aria-label="推荐，{{mode === 'recommend' ? '当前分类' : '未选中'}}">推荐</button><button wx:if="{{ugcFeedEnabled || socialPreviewEnabled}}" class="community-mode__tab {{mode === 'following' ? 'community-mode__active' : ''}}" data-mode="following" bindtap="selectMode" aria-role="tab" aria-selected="{{mode === 'following'}}" aria-label="关注，{{mode === 'following' ? '当前分类' : '未选中'}}">关注</button><button wx:if="{{canReview}}" class="community-mode__tab {{mode === 'review' ? 'community-mode__active' : ''}}" data-mode="review" bindtap="selectMode" aria-role="tab" aria-selected="{{mode === 'review'}}" aria-label="审核，{{mode === 'review' ? '当前分类' : '未选中'}}">审核</button></view>
  </view>

  <view wx:if="{{ugcFeedEnabled && mode !== 'review'}}" class="community-search" aria-role="search">
    <input class="community-search__input" value="{{searchInput}}" bindinput="onSearchInput" bindconfirm="submitSearch" confirm-type="search" maxlength="80" placeholder="搜索护理故事或作者" aria-label="搜索护理故事或作者" />
    <button class="community-search__action {{loading ? 'control--disabled' : ''}}" bindtap="submitSearch" disabled="{{loading}}">搜索</button>
    <button wx:if="{{appliedSearch}}" class="community-search__clear" bindtap="clearSearch" aria-label="清除搜索并查看全部内容">清除</button>
  </view>

  <view wx:if="{{signedIn && mode !== 'review'}}" class="community-my-content"><button class="{{navigating ? 'control--disabled' : ''}}" bindtap="openMyPosts" disabled="{{navigating}}">我的内容与草稿 <text>查看 ›</text></button></view>

  <view wx:if="{{mode === 'review'}}" class="review-panel">
    <text wx:if="{{reviewBusy}}">正在同步审核状态…</text>
    <view wx:if="{{teamError}}" class="state state--error">{{teamError}}</view>
    <view wx:if="{{reviewNotice}}" class="state" aria-live="polite">{{reviewNotice}}</view>
    <button class="{{reviewBusy ? 'control--disabled' : ''}} text-button" bindtap="loadReview" disabled="{{reviewBusy}}">刷新审核列表</button>
    <view wx:for="{{profileReviewQueue}}" wx:key="member_id" class="glass review-card"><view class="review-profile"><image class="review-profile-avatar" src="{{item.avatar}}" mode="aspectFill"/><view><text>社区头像昵称待审核</text><text class="review-detail">{{item.display_name}}</text></view></view><button class="{{reviewBusy ? 'control--disabled' : ''}}" data-id="{{item.member_id}}" data-decision="approve" bindtap="reviewMemberProfile" disabled="{{reviewBusy}}">资料审核通过</button><button class="{{reviewBusy ? 'control--disabled' : ''}}" data-id="{{item.member_id}}" data-decision="reject" bindtap="reviewMemberProfile" disabled="{{reviewBusy}}">退回修改资料</button></view>
    <view wx:for="{{reviewQueue}}" wx:key="id" class="glass review-card"><text>待审核投稿 · {{item.platform_account}}</text><text class="review-detail">{{item.disclosure}}</text><button data-url="{{item.post_url}}" bindtap="copyPostUrl">复制原文链接核验</button><button class="{{reviewBusy ? 'control--disabled' : ''}}" data-id="{{item.id}}" data-decision="approve" bindtap="reviewSubmission" disabled="{{reviewBusy}}">审核通过</button><button class="{{reviewBusy ? 'control--disabled' : ''}}" data-id="{{item.id}}" data-decision="request_changes" bindtap="reviewSubmission" disabled="{{reviewBusy}}">要求补充</button><button class="{{reviewBusy ? 'control--disabled' : ''}}" data-id="{{item.id}}" data-decision="reject" bindtap="reviewSubmission" disabled="{{reviewBusy}}">拒绝</button></view>
    <view wx:for="{{publicationQueue}}" wx:key="id" class="glass review-card"><text>投稿已通过 · {{item.platform_account}}</text><text class="review-detail">{{item.visible ? '已进入推荐流' : item.publication_queued ? '正在发布' : !item.publication_enabled ? '公开发布尚未开放' : '待另一名审核员完成发布复核'}}</text><button data-url="{{item.post_url}}" bindtap="copyPostUrl">复制原文链接核验</button><button class="{{reviewBusy ? 'control--disabled' : ''}}" wx:if="{{item.publication_enabled && !item.visible && !item.publication_queued}}" data-id="{{item.id}}" bindtap="publishSubmission" disabled="{{reviewBusy}}">复核并发布到推荐</button></view>
    <view wx:for="{{formalReviewQueue}}" wx:key="id" class="glass review-card"><text>社区故事待处理 · {{item.image_count}} 张图片</text><text class="review-detail">{{item.title || item.body || '图片故事'}}</text><button data-id="{{item.id}}" bindtap="openFormalReview">查看并审核</button></view>
    <view wx:if="{{formalAppealQueue.length}}" class="review-report-heading">内容申诉 · {{appealTotal}} 条待复核</view>
    <view wx:for="{{formalAppealQueue}}" wx:key="id" class="glass review-card review-report-card">
      <text>下架申诉 · {{item.title || '图片护理故事'}}</text>
      <text wx:if="{{item.body}}" class="review-detail">{{item.body}}</text>
      <text class="review-detail">下架依据：{{item.hiddenReason || '请核对处理记录'}}</text>
      <text class="review-detail">作者说明：{{item.reason}}</text>
      <text wx:if="{{item.postState!=='hidden'}}" class="review-detail">内容状态已变化，请刷新核对。</text>
      <view class="review-report-actions"><button data-id="{{item.id}}" data-decision="restore" bindtap="decideFormalAppeal"
        class="{{reviewBusy || !ugcFeedEnabled || item.postState!=='hidden' || item.hiddenByMemberId===reviewActorId || item.hideReporterMemberId===reviewActorId || item.authorId===reviewActorId?'control--disabled':''}}"
        disabled="{{reviewBusy || !ugcFeedEnabled || item.postState!=='hidden' || item.hiddenByMemberId===reviewActorId || item.hideReporterMemberId===reviewActorId || item.authorId===reviewActorId}}">复核后恢复</button>
        <button data-id="{{item.id}}" data-decision="uphold" bindtap="decideFormalAppeal" class="{{reviewBusy || item.hiddenByMemberId===reviewActorId || item.hideReporterMemberId===reviewActorId || item.authorId===reviewActorId?'control--disabled':''}}" disabled="{{reviewBusy || item.hiddenByMemberId===reviewActorId || item.hideReporterMemberId===reviewActorId || item.authorId===reviewActorId}}">维持下架</button></view>
      <text wx:if="{{!ugcFeedEnabled}}" class="review-detail">公开发布未启用，暂不能恢复。</text>
    </view>
    <button wx:if="{{appealNextCursor}}" class="text-button {{appealLoadingMore?'control--disabled':''}}" bindtap="loadMoreAppeals" disabled="{{appealLoadingMore}}" loading="{{appealLoadingMore}}">加载更多申诉</button>
    <view wx:if="{{formalReportQueue.length}}" class="review-report-heading">内容举报 · {{reportTotal}} 条待处理</view>
    <view wx:for="{{formalReportQueue}}" wx:key="id" class="glass review-card review-report-card">
      <text>举报{{item.targetType==='post'?'帖子':item.targetType==='comment'?'评论':'用户'}} · {{item.category}}</text>
      <text class="review-detail">{{item.targetSummary || '对象当前不可见，请核对举报信息'}}</text>
      <text wx:if="{{item.description}}" class="review-detail">举报说明：{{item.description}}</text>
      <view class="review-report-actions"><button wx:if="{{item.postId}}" data-id="{{item.id}}" bindtap="openReportTarget">查看对象</button>
        <button wx:if="{{item.targetType==='post'}}" data-id="{{item.id}}" data-decision="hide_post" bindtap="decideFormalReport" class="{{reviewBusy?'control--disabled':''}}" disabled="{{reviewBusy}}">核查后下架</button>
        <button wx:if="{{item.targetType==='comment'}}" data-id="{{item.id}}" data-decision="remove_comment" bindtap="decideFormalReport" class="{{reviewBusy?'control--disabled':''}}" disabled="{{reviewBusy}}">核查后移除</button>
        <button data-id="{{item.id}}" data-decision="dismiss" bindtap="decideFormalReport" class="{{reviewBusy?'control--disabled':''}}" disabled="{{reviewBusy}}">驳回举报</button></view>
      <text wx:if="{{item.targetType==='member'}}" class="review-detail">账号处置需另行核查；这里不能直接停用账号。</text>
    </view>
    <button wx:if="{{reportNextCursor}}" class="text-button {{reportLoadingMore?'control--disabled':''}}" bindtap="loadMoreReports" disabled="{{reportLoadingMore}}" loading="{{reportLoadingMore}}">加载更多举报</button>
    <text wx:if="{{!reviewBusy && !teamError && !reviewQueue.length && !publicationQueue.length && !profileReviewQueue.length && !formalReviewQueue.length && !formalReportQueue.length && !formalAppealQueue.length}}">当前没有待处理的资料或内容</text>
  </view>
  <block wx:if="{{mode !== 'review'}}">
  <view wx:if="{{mode === 'recommend' && !loading && !displayFeedCount && !error}}" class="state">暂无审核发布的会员内容，可先浏览精选护理故事。</view>
  <view wx:if="{{mode === 'following' && !loading && !displayFeedCount}}" class="state">关注作者后，这里会显示他们公开的护理故事。可在故事详情中关注作者。</view>
  <view wx:if="{{loading}}" class="community-loading" aria-live="polite">正在加载护理故事…</view>
  <view wx:if="{{error}}" class="state state--error community-sync-error" aria-live="assertive"><text class="state-error__copy">{{error}}</text><button class="text-button state-error__action" bindtap="load">重新加载</button></view>

  <view wx:if="{{tasksLoading}}" class="community-loading" aria-live="polite">正在加载我的活动…</view>
  <view wx:elif="{{tasksError}}" class="state state--error" aria-live="assertive"><text class="state-error__copy">活动暂未加载，请重试。</text><button class="text-button state-error__action" bindtap="loadTasks">重新加载</button></view>
  <view wx:elif="{{tasks.length}}" class="glass community-task-list"><view class="community-task-list__head"><strong class="community-task-list__title">邀请活动</strong><small class="community-task-list__count">{{tasks.length}} 项</small></view><button wx:for="{{tasks}}" wx:key="id" class="community-task-row {{navigating ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="openInvite" disabled="{{navigating}}" aria-label="{{item.name || '邀请活动'}}，{{item.statusLabel}}，{{item.actionLabel}}"><view class="community-task-row__copy"><strong class="community-task-row__title">{{item.name || '护理邀请活动'}}</strong><small class="community-task-row__status">{{item.statusLabel}}</small></view><text class="community-task-row__action">{{item.actionLabel}}</text></button></view>
  <view class="feed-grid">
    <view wx:for="{{feedColumns}}" wx:for-item="column" wx:key="index" class="feed-column">
    <button wx:for="{{column}}" wx:key="id" class="feed-card glass {{navigating ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="openPost" disabled="{{navigating}}" aria-label="阅读护理故事：{{item.title}}">
      <image wx:if="{{item.image}}" class="feed-card__image {{item.compactImage ? 'feed-card__image--compact' : ''}}" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
      <view class="feed-card__body"><view class="card-title feed-card__title">{{item.title}}</view><view class="feed-card__meta"><image wx:if="{{item.avatar}}" class="feed-card__avatar" src="{{item.avatar}}" mode="aspectFill" lazy-load="{{true}}"/><text class="feed-card__author">{{item.author}}</text><image class="feed-card__meta-icon" src="/assets/icons/shield-check-plum.svg" mode="aspectFit"/><text class="feed-card__engagement">{{item.engagementLabel}}</text></view></view>
    </button>
    </view>
  </view>
  <view wx:if="{{moreError}}" class="state state--error" aria-live="polite"><text>{{moreError}}</text><button class="text-button {{formalLoadingMore ? 'control--disabled' : ''}}" bindtap="onReachBottom" disabled="{{formalLoadingMore}}">重试加载更多</button></view>
  <view wx:if="{{formalLoadingMore}}" class="community-loading" aria-live="polite">正在加载更多内容…</view>
  <view wx:if="{{mode === 'recommend' && appliedSearch && !loading && !displayFeedCount}}" class="state">没有找到相关护理故事或作者。试试其他关键词。</view>
  <view wx:if="{{mode === 'featured' && !loading}}" class="community-notice"><image class="community-notice__icon" src="/assets/icons/shield-check-plum.svg" mode="aspectFit"/><text>精选由 CISME 护理编辑部整理。大家分享的护理故事审核发布后，会出现在推荐栏目。</text></view>
  </block>
</view>
