.queue-shell{min-height:100vh;background:#f7f2f8}.queue-list{position:fixed;top:var(--cisme-topbar-height,calc(env(safe-area-inset-top) + 44px));right:0;bottom:0;left:0;padding:24rpx 28rpx}.queue-head{padding:12rpx 6rpx 22rpx}.queue-head strong,.queue-head text{display:block}.queue-head strong{margin-top:12rpx;color:#3c3041;font-size:36rpx;font-weight:500}.queue-head>text{margin-top:8rpx;color:#817788;font-size:24rpx}.queue-card{display:flex;align-items:center;gap:18rpx;width:100%;min-height:142rpx;margin-bottom:16rpx;padding:22rpx;border:1rpx solid rgba(84,56,96,.08);border-radius:28rpx;color:inherit;background:#fff;text-align:left}.queue-avatar{display:flex;align-items:center;justify-content:center;flex:none;width:80rpx;height:80rpx;border-radius:50%;color:#fff;background:#715584;font-size:30rpx}.queue-copy{flex:1;min-width:0}.queue-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.queue-row strong{overflow:hidden;font-size:28rpx;font-weight:500;text-overflow:ellipsis;white-space:nowrap}.queue-row small{flex:none;color:#9a909c;font-size:20rpx}.queue-message{display:block;margin-top:8rpx;overflow:hidden;color:#716775;font-size:24rpx;text-overflow:ellipsis;white-space:nowrap}.queue-meta{display:flex;gap:10rpx;margin-top:10rpx;color:#7a6c80;font-size:20rpx}.queue-status{padding:4rpx 10rpx;border-radius:999rpx;background:#eee7f1}.queue-status--waiting_human{color:#8d3150;background:#f8e8ed}.queue-status--human_active{color:#345f52;background:#e4f1ed}.queue-unread{display:flex;align-items:center;justify-content:center;flex:none;min-width:34rpx;height:34rpx;padding:0 9rpx;border-radius:999rpx;color:#fff;background:#8d3150;font-size:20rpx}.queue-more,.queue-end{padding:24rpx;color:#817788;text-align:center}.queue-end{height:60rpx}
