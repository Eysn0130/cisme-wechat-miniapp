@import "../../styles/management-workbench.wxss";
@import "../../styles/read-loading.wxss";
.queue-shell{min-height:100vh;background:#f7f2f8}.queue-list{position:fixed;top:var(--cisme-topbar-height,calc(env(safe-area-inset-top) + 44px));right:0;bottom:0;left:0;width:100%;padding:24rpx 28rpx}.queue-card{display:flex;align-items:center;gap:18rpx;width:100%;max-width:100%;min-width:0;min-height:142rpx;margin:0;padding:22rpx;border:1rpx solid rgba(84,56,96,.08);border-radius:28rpx;color:inherit;background:#fff;text-align:left}.queue-avatar{display:flex;align-items:center;justify-content:center;flex:none;width:80rpx;height:80rpx;border-radius:50%;color:#fff;background:#715584;font-size:30rpx}.queue-copy{flex:1;min-width:0;overflow:hidden}.queue-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-width:0}.queue-row strong{flex:1;min-width:0;overflow:hidden;font-size:28rpx;font-weight:500;text-overflow:ellipsis;white-space:nowrap}.queue-row small{flex:none;color:#776d7b;font-size:20rpx}.queue-message{display:block;margin-top:8rpx;overflow:hidden;color:#675d6b;font-size:24rpx;text-overflow:ellipsis;white-space:nowrap}.queue-meta{display:flex;gap:10rpx;margin-top:10rpx;color:#6f6275;font-size:20rpx}.queue-status{padding:4rpx 10rpx;border-radius:999rpx;background:#eee7f1}.queue-status--waiting_human{color:#8d3150;background:#f8e8ed}.queue-status--human_active{color:#345f52;background:#e4f1ed}.queue-unread{display:flex;align-items:center;justify-content:center;flex:none;min-width:34rpx;height:34rpx;padding:0 9rpx;border-radius:999rpx;color:#fff;background:#8d3150;font-size:20rpx}.queue-more,.queue-end{padding:24rpx;color:#75697a;text-align:center}.queue-end{height:calc(26rpx + env(safe-area-inset-bottom))}
.queue-avatar-wrap{position:relative;flex:none;width:80rpx;height:80rpx}.queue-avatar{overflow:hidden;background:#fffaff}.queue-avatar image{width:42rpx;height:42rpx}.queue-avatar--photo image{width:100%;height:100%}

.queue-row-shell {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  margin-bottom: 16rpx;
}
.queue-shell .queue-card {
  position: relative;
  transition: transform var(--cisme-motion-press) ease-out;
}
.queue-card--open {
  transform: translateX(-62px);
}
.queue-delete {
  position: absolute;
  inset: 0 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62px;
  min-height: 44px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: #f8e8ed;
}
.queue-delete image {
  width: 21px;
  height: 21px;
}
@media (prefers-reduced-motion: reduce) {
  .queue-shell .queue-card { transition: none; }
}
