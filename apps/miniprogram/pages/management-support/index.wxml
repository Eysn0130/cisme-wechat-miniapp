<view class="queue-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">客服工作台</text></view><scroll-view class="queue-list" scroll-y enhanced show-scrollbar="false" bindscrolltolower="loadMore">
 <view class="queue-head"><text class="eyebrow">MOBILE INBOX</text><strong>优先处理等待人工</strong><text>队列按待人工、未读、最近活动排序。</text></view><view wx:if="{{loading}}" class="state">正在同步客服队列…</view><view wx:if="{{!loading && !items.length && !error}}" class="state">当前没有客服会话。</view>
 <button wx:if="{{!loading}}" wx:for="{{items}}" wx:key="id" class="queue-card {{navigating ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="open" disabled="{{navigating}}" aria-label="打开 {{item.memberDisplayName}} 的客服会话，{{item.statusLabel}}{{item.teamUnreadCount ? '，' + item.unreadLabel + ' 条未读' : ''}}"><view class="queue-avatar">{{item.initial}}</view><view class="queue-copy"><view class="queue-row"><strong>{{item.memberDisplayName}}</strong><small>{{item.timeLabel}}</small></view><text class="queue-message">{{item.lastMessagePreview}}</text><view class="queue-meta"><text class="queue-status queue-status--{{item.status}}">{{item.statusLabel}}</text><text wx:if="{{item.priority !== 'normal'}}">{{item.priority === 'urgent' ? '紧急' : '高优先级'}}</text></view></view><text wx:if="{{item.teamUnreadCount}}" class="queue-unread">{{item.unreadLabel}}</text></button>
 <view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="retry">重试</button></view><view wx:if="{{loadingMore}}" class="queue-more">正在加载…</view><view class="queue-end"></view></scroll-view></view>
