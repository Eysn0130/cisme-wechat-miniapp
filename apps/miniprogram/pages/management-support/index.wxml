<view class="management-ui queue-shell" style="{{chromeStyle}}">
  <view class="topbar">
    <button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button>
    <text class="topbar__title">客服工作台</text>
  </view>
  <scroll-view class="queue-list" scroll-y enhanced show-scrollbar="{{false}}" bindscrolltolower="loadMore">
    <view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在加载客服会话…"><view class="page-read-loading__indicator"/></view>
    <view wx:if="{{!loading && !items.length && !error}}" class="state">当前没有客服会话。</view>
    <view wx:if="{{error}}" class="state state--error" aria-live="polite">{{error}}</view>
    <view wx:for="{{items}}" wx:key="id" class="queue-row-shell">
      <button wx:if="{{swipedId === item.id}}" class="queue-delete {{!!removingId ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="dismiss" disabled="{{!!removingId}}" aria-label="从工作台删除 {{item.memberDisplayName}} 的会话">
        <image src="/assets/icons/trash-danger.svg" mode="aspectFit" aria-hidden="true"/>
      </button>
      <button class="queue-card {{swipedId === item.id ? 'queue-card--open' : ''}} {{!coreReady || navigating || !!removingId ? 'control--disabled' : ''}}" data-id="{{item.id}}"
        bindtap="open" bindlongpress="revealActions" bindtouchstart="swipeStart" bindtouchend="swipeEnd" bindtouchcancel="swipeCancel" disabled="{{!coreReady || navigating || !!removingId}}"
        aria-label="打开 {{item.memberDisplayName}} 的会话{{item.memberBadgeLabel ? '，' + item.memberBadgeLabel : ''}}，{{item.statusLabel}}{{item.teamUnreadCount ? '，' + item.unreadLabel + ' 条未读' : ''}}。长按可显示操作">
        <view class="queue-avatar-wrap">
          <view class="queue-avatar {{item.memberAvatar !== '/assets/icons/user-circle-plum.svg' ? 'queue-avatar--photo' : ''}}"><image src="{{item.memberAvatar}}" mode="aspectFill" data-key="{{item.identityKey}}" binderror="onAvatarError" aria-hidden="true"/></view>
          <identity-badge wx:if="{{item.memberBadge}}" kind="{{item.memberBadge}}" size="{{30}}"/>
        </view>
        <view class="queue-copy">
          <view class="queue-row"><strong>{{item.memberDisplayName}}</strong><small>{{item.timeLabel}}</small></view>
          <text class="queue-message">{{item.lastMessagePreview}}</text>
          <view class="queue-meta"><text class="queue-status queue-status--{{item.status}}">{{item.statusLabel}}</text><text wx:if="{{item.priority !== 'normal'}}">{{item.priority === 'urgent' ? '紧急' : '高优先级'}}</text></view>
        </view>
        <text wx:if="{{item.teamUnreadCount}}" class="queue-unread">{{item.unreadLabel}}</text>
      </button>
    </view>
    <view wx:if="{{loadingMore}}" class="queue-more">正在加载…</view>
    <view class="queue-end"></view>
  </scroll-view>
</view>
