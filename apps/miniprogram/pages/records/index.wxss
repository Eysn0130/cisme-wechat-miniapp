.records-page { min-height:100vh; padding-top:calc(var(--cisme-status-bar,20px) + 16rpx); padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 150rpx); background:radial-gradient(circle at 80% 0,rgba(209,190,224,.5),transparent 25%),linear-gradient(180deg,#f8f4f9,#f3edf6); }
.records-hero { position:relative; min-height:470rpx; padding:48rpx 48rpx 40rpx; overflow:hidden; color:#fff; background:linear-gradient(145deg,#6d5481 0%,#3f2b50 60%,#2d2138); }
.records-hero-status { position:relative; z-index:1; display:flex; align-items:flex-start; justify-content:center; flex-direction:column; min-height:360rpx; gap:28rpx; }.records-hero-status strong { font-family:"Songti SC","STSong",serif; font-size:38rpx; font-weight:400; line-height:1.45; }
.records-hero__orb { position:absolute; z-index:0; top:80rpx; right:-124rpx; width:410rpx; height:410rpx; border:1rpx solid rgba(255,255,255,.22); border-radius:50%; box-shadow:0 0 0 46rpx rgba(255,255,255,.035),0 0 0 112rpx rgba(255,255,255,.025); }
.records-kicker { position:relative; z-index:1; display:flex; align-items:baseline; justify-content:space-between; padding-right:var(--cisme-nav-side,112rpx); }.records-wordmark { font:400 38rpx "Times New Roman",Georgia,serif; letter-spacing:5rpx; }.records-archive { color:rgba(255,255,255,.82); font-size:var(--cisme-text-small); line-height:1.5; }
.record-streak { position:absolute; z-index:1; top:134rpx; right:54rpx; display:flex; align-items:baseline; gap:16rpx; }.record-streak__count { font:400 124rpx/.88 "Times New Roman",Georgia,serif; }.record-streak__copy { display:flex; flex-direction:column; color:rgba(255,255,255,.82); line-height:1; }.record-streak__label { font-size:var(--cisme-text-small); }.record-streak__meta { margin-top:10rpx; color:rgba(255,255,255,.72); font:var(--cisme-text-micro)/1.45 "Times New Roman",Georgia,serif; letter-spacing:1rpx; }
.records-headline { position:relative; z-index:1; width:64%; margin-top:114rpx; font-family:"Songti SC","STSong",serif; font-size:48rpx; font-weight:400; line-height:1.55; }.records-headline__line { display:block; }.records-subline { position:relative; z-index:1; margin-top:18rpx; color:rgba(255,255,255,.66); font-size:28rpx; line-height:1.45; }
.records-content { position:relative; padding:24rpx; }.records-operation-status { margin:0 0 18rpx; color:#5d416f; font-size:var(--cisme-text-small); line-height:1.5; text-align:center; }.records-loading { padding:40rpx 28rpx; border-radius:44rpx; color:#817788; text-align:center; }
.milestone-card { padding:28rpx; border-radius:44rpx; }.milestone-head { display:flex; align-items:center; justify-content:space-between; gap:24rpx; }.milestone-kicker,.milestone-title { display:block; }.milestone-kicker { color:#94889a; font-size:var(--cisme-text-micro); font-weight:600; line-height:1; letter-spacing:3rpx; }.milestone-title { margin-top:8rpx; font-family:"Songti SC","STSong",serif; font-size:28rpx; font-weight:400; }.milestone-phase { flex:none; padding:10rpx 18rpx; border-radius:26rpx; color:#604574; background:#eee5f2; font-size:20rpx; line-height:1; }
.milestone-track { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14rpx; margin-top:26rpx; }.milestone-node { display:flex; align-items:center; justify-content:center; flex-direction:column; min-width:0; min-height:98rpx; border:1rpx solid rgba(98,71,115,.1); border-radius:30rpx; color:#8b7e91; background:rgba(242,237,245,.7); }.milestone-label { font-size:var(--cisme-text-small); font-weight:500; line-height:1; }.milestone-status { margin-top:8rpx; color:inherit; font-size:var(--cisme-text-micro); line-height:1.2; white-space:nowrap; }.milestone-node.is-done { color:#654878; background:#eee4f3; }.milestone-node.is-current { color:#fff; border-color:rgba(100,68,119,.28); background:#624678; box-shadow:0 10rpx 24rpx rgba(76,49,92,.15); }.cycle-summary { margin:20rpx 2rpx 0; color:#796f7d; font-size:var(--cisme-text-body); line-height:1.6; }
.cycle-controls { margin-top:28rpx; padding:28rpx; border-radius:44rpx; }.cycle-controls__title { color:#463849; font-family:"Songti SC","STSong",serif; font-size:28rpx; }.cycle-controls__copy { margin-top:14rpx; color:#776b7b; font-size:var(--cisme-text-small); line-height:1.5; }.cycle-controls__actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; margin-top:18rpx; }.cycle-button { display:flex; align-items:center; justify-content:center; min-height:var(--cisme-hit-target); border:1rpx solid rgba(99,68,118,.18); border-radius:34rpx; color:#5e4272; background:#eee5f2; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif; font-size:var(--cisme-text-small); line-height:1; }.cycle-button--single { grid-column:1/-1; width:100%; }.cycle-button--danger { color:#87536a; background:#f5e9ee; }.cycle-policy-note { display:flex; align-items:center; justify-content:center; min-height:var(--cisme-hit-target); color:#817788; font-size:var(--cisme-text-small); line-height:1.5; }
.record-list { margin-top:38rpx; }.record-list__head { display:flex; align-items:center; justify-content:space-between; min-height:var(--cisme-hit-target); }.record-list__title { font-family:"Songti SC","STSong",serif; font-size:30rpx; }.record-list__count { color:#817788; font-size:var(--cisme-text-small); line-height:1.5; }.record-row { display:grid; grid-template-columns:84rpx 1fr auto; align-items:center; gap:18rpx; min-height:140rpx; border-bottom:1rpx solid rgba(75,54,85,.08); }.record-index { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; border-radius:50%; color:#5f4271; background:rgba(233,224,238,.75); font:var(--cisme-text-small) Georgia,"Times New Roman",serif; }.record-row__title,.record-row__meta { display:block; }.record-row__title { font-size:var(--cisme-text-small); font-weight:400; }.record-row__meta,.record-row__time { margin-top:8rpx; color:#948a97; font-size:var(--cisme-text-small); line-height:1.5; }.records-actions { display:grid; margin-top:32rpx; }.records-home { display:flex; align-items:center; justify-content:center; gap:12rpx; min-height:var(--cisme-hit-target); border:1rpx solid rgba(255,255,255,.82); border-radius:44rpx; color:#54366b; background:rgba(236,226,242,.72); font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif; font-size:var(--cisme-text-small); line-height:1; }.records-home__icon { width:36rpx; height:36rpx; }
.records-empty { margin-top:20rpx; padding:58rpx 30rpx; border-radius:44rpx; text-align:center; }.records-empty__icon { width:62rpx; height:62rpx; margin:0 auto 20rpx; }.records-empty__title { font-family:"Songti SC","STSong",serif; font-size:34rpx; }.records-empty__copy { display:block; margin-top:12rpx; color:#817788; font-size:var(--cisme-text-body); line-height:1.6; }
