.activity-page{padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 56px));padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 90rpx);background:#f7f2f8}.activity-tabs{position:relative;display:flex;gap:0;margin-bottom:20rpx;padding:0;border-bottom:1rpx solid #e7ddea}.activity-tab{display:flex;align-items:center;justify-content:center;flex:1;min-width:0;min-height:48px;margin:0;padding:10px 4px;border:0;border-radius:0;background:transparent;color:#75697a;font-size:14px;line-height:1.3;transition:color 180ms ease}.activity-tab--active{color:#56306f;font-weight:600}.activity-tab--pressed{opacity:.65}.activity-tabs__indicator{position:absolute;left:0;bottom:-1rpx;display:flex;justify-content:center;width:20%;height:3px;pointer-events:none;transition:transform 200ms cubic-bezier(.2,.8,.2,1)}.activity-tabs__line{width:28px;height:3px;border-radius:3px;background:#56306f}.activity-count{padding:8rpx 0 18rpx;color:#786e7d;font-size:23rpx}.activity-state{padding:36rpx 12rpx;color:#6e6273;font-size:26rpx;line-height:1.55;text-align:center}.activity-state--error{color:#9a3f57}.activity-state button{width:100%;min-height:44px;margin-top:16px;padding:10px 16px;border:1rpx solid #dfd4e4;border-radius:12px;background:#fff;color:#56306f;font-size:14px;line-height:1.3}.activity-notice{padding:14rpx 18rpx;border-radius:12rpx;background:#eee5f1;color:#654570;font-size:24rpx}.activity-row{display:flex;flex-direction:column;gap:12rpx;margin-bottom:14rpx;padding:24rpx;border:1rpx solid #e7ddea;border-radius:18rpx;background:#fff}.activity-row__top{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.activity-row__title{flex:1;min-width:0;color:#47374f;font-size:28rpx;font-weight:600;line-height:1.45;word-break:break-word}.activity-row__body{color:#53485a;font-size:26rpx;line-height:1.55;word-break:break-word}.activity-row__time{color:#817686;font-size:22rpx}.activity-status{flex-shrink:0;color:#81578f;font-size:23rpx}.activity-row__actions{display:flex;flex-wrap:wrap;gap:12rpx}.activity-row__actions button,.activity-row--inline button{min-height:88rpx;margin:0;padding:0 22rpx;border:1rpx solid #dfd4e4;border-radius:14rpx;background:#fff;color:#684878;font-size:24rpx}.activity-row--inline{flex-direction:row;align-items:center;justify-content:space-between}.activity-row--inline .activity-row__title{font-weight:500}.activity-more{min-height:88rpx;margin:20rpx 0;border:1rpx solid #dfd4e4;border-radius:14rpx;background:#fff;color:#684878;font-size:25rpx}.control--disabled{opacity:.5}
.activity-row__actions button,.activity-row--inline button,.activity-state button,.activity-more{display:flex;align-items:center;justify-content:center;line-height:1.2}

.activity-state--empty{padding:56px 16px;color:#75697a;font-size:14px;line-height:1.6}
@media (prefers-reduced-motion: reduce){.activity-tab,.activity-tabs__indicator{transition:none}}
