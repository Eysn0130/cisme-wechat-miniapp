<page-meta root-font-size="system"/>
<import src="../../templates/recorded-commands.wxml"/>
<import src="../../templates/fulfillment-policy.wxml"/>
<view class="chrome-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back {{busy||navigating?'control--disabled':''}}" bindtap="back" disabled="{{busy||navigating}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">订单详情</text></view><view class="page page--stack detail-page {{!closedRights&&order.status==='pending_payment'&&isolatedPayment?'detail-page--payable':''}}"><view wx:if="{{loading && !order}}" class="page-read-loading" aria-role="status" aria-label="正在加载订单…"><view class="page-read-loading__indicator"/></view><view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button wx:if="{{invalidId}}" class="text-button" bindtap="back">返回</button><button wx:else class="text-button" bindtap="load">刷新状态</button></view>
<view wx:if="{{!closedRights && (runtimeState==='error'||runtimeMode==='test'||order.status==='pending_payment' && !isolatedPayment)}}" class="order-runtime" aria-live="polite"><text>{{runtimeCopy}}</text><button wx:if="{{runtimeState==='error'}}" class="text-button {{busy?'text-button--disabled':''}}" bindtap="retryRuntime" disabled="{{busy}}">重试连接</button></view>
<view wx:if="{{!closedRights && (recoveryLoading||recoveryError||recoveryRows.length)}}" class="state" aria-live="polite">
  <text wx:if="{{recoveryLoading}}">正在核对上次操作…</text><text wx:if="{{recoveryError}}">{{recoveryError}}</text>
  <view wx:for="{{recoveryRows}}" wx:key="key"><text>{{item.label}}</text>
    <button wx:if="{{item.recorded||item.retryable&&(item.kind==='cancel'||isolatedPayment)}}" class="text-button {{busy||!coreReady?'text-button--disabled':''}}" data-key="{{item.key}}" bindtap="resolveRecovery" disabled="{{busy||!coreReady}}">{{item.recorded?'已核对原记录':'重试最初确认的操作'}}</button>
    <text wx:if="{{!item.recorded&&!item.retryable}}">请联系客服核对，勿重复申请</text>
  </view>
  <button class="text-button {{busy||recoveryLoading?'text-button--disabled':''}}" bindtap="loadRecovery" disabled="{{busy||recoveryLoading}}">重新核对原操作</button>
</view>
<page-container wx:if="{{order}}" show="{{supportSheetOpen}}" position="bottom" duration="220" z-index="90" overlay="{{true}}" round="{{true}}" close-on-slide-down="{{false}}" bindclickoverlay="closeSupportSheet" bindbeforeleave="onSupportSheetLeave" overlay-style="background:rgba(30,20,36,.48)" custom-style="height:{{sheetKeyboardHeight ? sheetWritingHeight : sheetCase || sheetPreviousCase && !sheetReapplying ? sheetProgressHeight : sheetHeight}};bottom:{{sheetKeyboardHeight}}px;background:transparent;overflow:hidden;">
  <view class="support-sheet" aria-role="dialog" aria-modal="{{true}}" aria-label="订单售后" style="height:calc(100% - {{sheetKeyboardHeight}}px);transform:translateY({{sheetKeyboardHeight}}px)" catchtap="stopPropagation">
    <view class="support-sheet__header">
      <strong>{{sheetCase || sheetPreviousCase && !sheetReapplying ? '订单售后' : '申请售后'}}</strong>
      <button bindtap="closeSupportSheet" aria-label="关闭售后面板">关闭</button>
    </view>
    <view class="support-sheet__order">
      <text class="support-sheet__order-number" user-select>订单 {{order.orderNumber}}</text>
      <text class="support-sheet__order-status" wx:if="{{sheetFulfillment==='unshipped'}}">未发货</text>
      <text class="support-sheet__order-status" wx:elif="{{sheetFulfillment==='shipped'}}">{{shipment.noCourier?'已发货':'已交寄'}}</text>
    </view>
    <scroll-view class="support-sheet__body" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{sheetKeyboardHeight ? 'sheet-reason' : ''}}">
      <text wx:if="{{sheetLoading && !sheetCase && !sheetPreviousCase}}" class="support-sheet__notice" aria-live="polite">正在读取本单售后…</text>
      <view wx:if="{{sheetCase || sheetPreviousCase && !sheetReapplying}}" class="support-sheet__case">
        <button class="support-sheet__summary" bindtap="openFullAftersale">
          <view class="support-sheet__case-top"><strong class="support-sheet__case-status">{{sheetCaseLabel}}</strong><view class="support-sheet__view-case"><text>{{sheetCase.returnDestination && sheetCase.state==='awaiting_return'?'填写退货运单':sheetCase.state==='need_info'?'补充说明':'详情'}}</text><image src="/assets/icons/caret-right-muted.svg" aria-hidden="true"/></view></view>
          <view class="support-sheet__case-lines">
            <view wx:for="{{sheetCase ? sheetCase.lines : sheetPreviousCase.lines}}" wx:key="lineId" class="support-sheet__claim-line"><text>{{item.productName}}</text><text class="support-sheet__claim-quantity">{{item.skuLabel}} × {{item.quantity}}</text></view>
          </view>
          <view wx:if="{{sheetCaseAmount}}" class="support-sheet__amount"><text>{{sheetPreviousCase.resolved ? '退款金额' : '申请金额'}}</text><strong>¥{{sheetCaseAmount}}</strong></view>
        </button>
        <text wx:if="{{sheetPreviousCase.rejectionReason}}" class="support-sheet__decision">{{sheetPreviousCase.rejectionReason}}</text>
        <text wx:if="{{sheetCase.state==='awaiting_instruction'}}">收到退货指引后再寄回商品。</text>
        <view wx:if="{{sheetCase.returnDestination && sheetCase.state==='awaiting_return'}}" class="support-sheet__instruction">
          <text class="support-sheet__section-title">退货收件信息</text>
          <text user-select>{{sheetCase.returnDestination.recipientName}} · {{sheetCase.returnDestination.phone}}</text>
          <text user-select>{{sheetCase.returnDestination.region}} {{sheetCase.returnDestination.address}}</text>
          <text>{{sheetCase.returnDestination.freightPayer==='merchant'?'商家承担退货运费':sheetCase.returnDestination.freightPayer==='member'?'你承担退货运费':'请向客服确认退货运费'}}</text>
          <text wx:if="{{sheetCase.returnDestination.instructions}}">{{sheetCase.returnDestination.instructions}}</text>
          <button class="text-button {{!sheetCasesReady?'control--disabled':''}}" bindtap="copySheetReturnInstruction" disabled="{{!sheetCasesReady}}">复制收件信息</button>
        </view>
        <button wx:if="{{sheetPreviousCase && sheetHasRemaining && sheetCasesReady && sheetLinesReady}}" class="support-sheet__case-main" bindtap="startSheetReapply">重新申请</button>
      </view>
      <block wx:if="{{!sheetCase && sheetLinesReady && sheetHasRemaining && (!sheetPreviousCase || sheetReapplying || sheetAttempt)}}">
        <view class="support-sheet__selection">
          <text wx:if="{{!sheetWholeOrder}}" class="support-sheet__section-title">申请商品</text>
          <view wx:for="{{sheetAvailable}}" wx:key="lineId" wx:if="{{item.remainingQuantity > 0}}" class="support-sheet__selection-row">
            <image class="support-sheet__product-image" src="{{item.image || '/assets/icons/package-plum.svg'}}" mode="aspectFill"/>
            <view class="support-sheet__product">
              <text>{{item.productName}}</text>
              <text class="support-sheet__product-quantity">{{item.skuLabel}} · {{sheetWholeOrder ? item.remainingQuantity + ' 件' : '可申请 ' + item.remainingQuantity + ' 件'}}</text>
            </view>
            <view wx:if="{{!sheetWholeOrder}}" class="support-sheet__stepper">
              <button class="{{sheetSubmitting||sheetAttempt||item.selectedQuantity===0?'control--disabled':''}}" data-id="{{item.lineId}}" data-delta="-1" bindtap="chooseSheetQuantity" disabled="{{sheetSubmitting||sheetAttempt||item.selectedQuantity===0}}" aria-label="减少{{item.productName}}申请数量"><image class="support-sheet__stepper-icon" src="/assets/icons/stepper-minus-plum.svg" mode="aspectFit"/></button>
              <text aria-label="申请数量 {{item.selectedQuantity}}">{{item.selectedQuantity}}</text>
              <button class="{{sheetSubmitting||sheetAttempt||item.selectedQuantity===item.remainingQuantity?'control--disabled':''}}" data-id="{{item.lineId}}" data-delta="1" bindtap="chooseSheetQuantity" disabled="{{sheetSubmitting||sheetAttempt||item.selectedQuantity===item.remainingQuantity}}" aria-label="增加{{item.productName}}申请数量"><image class="support-sheet__stepper-icon" src="/assets/icons/stepper-plus-plum.svg" mode="aspectFit"/></button>
            </view>
          </view>
        </view>
        <view class="support-sheet__application">
          <picker aria-label="选择售后原因" range="{{sheetBasisOptions}}" value="{{sheetBasisIndex}}" bindchange="chooseSheetBasis" disabled="{{sheetSubmitting||sheetAttempt}}">
            <view class="support-sheet__field"><text class="support-sheet__field-label">售后原因</text><text class="{{sheetBasisIndex ? '' : 'support-sheet__placeholder'}}">{{sheetBasisIndex ? sheetBasisOptions[sheetBasisIndex] : '请选择'}}</text><image src="/assets/icons/caret-right-muted.svg" aria-hidden="true"/></view>
          </picker>
          <picker wx:if="{{!sheetFulfillment}}" aria-label="选择退款方式" range="{{sheetKindOptions}}" value="{{sheetKindIndex}}" bindchange="chooseSheetKind" disabled="{{sheetSubmitting||sheetAttempt}}">
            <view class="support-sheet__field"><text class="support-sheet__field-label">处理方式</text><text>{{sheetKindOptions[sheetKindIndex]}}</text><image src="/assets/icons/caret-right-muted.svg" aria-hidden="true"/></view>
          </picker>
          <text wx:elif="{{sheetBasisIndex || sheetFulfillment==='unshipped'}}" class="support-sheet__method">{{sheetFulfillment==='unshipped'?'无需寄回':sheetApplicationLabel}}</text>
          <view id="sheet-reason" class="support-sheet__reason-group">
            <text class="support-sheet__field-label">{{sheetBasisIndex===1?'补充说明（选填）':'问题说明'}}</text>
            <textarea class="support-sheet__reason {{sheetKeyboardHeight?'support-sheet__reason--focused':''}}" aria-label="{{sheetBasisIndex===1?'补充说明，选填':'售后说明'}}" value="{{sheetReason}}" maxlength="500" adjust-position="{{false}}" bindinput="editSheetReason" bindkeyboardheightchange="onSheetKeyboardHeightChange" disabled="{{sheetSubmitting||sheetAttempt}}"/>
          </view>
        </view>
      </block>
    </scroll-view>
    <view class="support-sheet__footer">
      <view wx:if="{{sheetError}}" class="support-sheet__error" aria-live="assertive">
        <text class="support-sheet__error-copy">{{sheetError}}</text>
        <button wx:if="{{!sheetCasesReady || !sheetLinesReady}}" class="text-button {{sheetLoading?'text-button--disabled':''}}" bindtap="loadSupportSheet" disabled="{{sheetLoading}}">重试加载</button>
      </view>
      <button wx:if="{{!sheetCase && sheetHasRemaining && (!sheetPreviousCase || sheetReapplying || sheetAttempt)}}" class="support-sheet__primary {{sheetSubmitting||sheetLoading||!sheetCasesReady||!sheetLinesReady?'control--disabled':''}}" bindtap="submitSheetAftersale" disabled="{{sheetSubmitting||sheetLoading||!sheetCasesReady||!sheetLinesReady}}" loading="{{sheetSubmitting}}">{{sheetAttempt?'重试原申请':'提交申请'}}</button>
      <button wx:if="{{!sheetKeyboardHeight}}" class="support-sheet__contact {{sheetSubmitting||navigating?'control--disabled':''}}" bindtap="openOrderSupport" disabled="{{sheetSubmitting||navigating}}">联系客服</button>
    </view>
  </view>
</page-container>

<block wx:if="{{order}}">
<view class="order-hero"><text class="order-hero__status" aria-role="heading" aria-label="{{!coreReady?'正在核对最新订单状态，暂不可操作':order.statusLabel}}">{{!coreReady?'正在核对 · '+order.statusLabel:order.statusLabel}}</text><text class="order-hero__copy" wx:if="{{closedRights && order.status==='pending_payment'}}">账号已注销，不能发起新付款；如已付款，请从本单售后联系客服核对。</text><text class="order-hero__copy" wx:elif="{{order.status==='pending_payment'&&runtimeMode==='formal'&&isolatedPayment}}">请于 {{order.expiresLabel}} 前付款</text><text class="order-hero__copy" wx:elif="{{order.status==='pending_payment'&&isolatedPayment}}">测试订单，不会实际扣款 · {{order.expiresLabel}} 到期</text><text class="order-hero__copy" wx:elif="{{order.status==='pending_payment'&&paymentRecovery}}">暂时无法付款，可查询已有付款结果。</text><text class="order-hero__copy" wx:elif="{{order.status==='pending_payment'}}">暂时无法付款 · {{order.expiresLabel}} 到期</text><text class="order-hero__number" user-select>订单号 {{order.orderNumber}}</text></view>
<view class="order-service">
  <view class="shipment-card" aria-live="polite">
    <view class="shipment-card__heading">
      <text class="detail-heading" aria-role="heading">物流与收货</text>
      <text wx:if="{{shipment && !shipmentLoading}}" class="shipment-card__state">{{shipment.stateLabel}}</text>
    </view>
    <text wx:if="{{shipmentLoading}}" class="detail-copy">正在读取物流…</text>
  <view wx:if="{{shipmentError}}" class="state state--error"><text>{{shipmentError}}</text><button class="text-button {{busy||!coreReady?'text-button--disabled':''}}" bindtap="loadShipment" disabled="{{busy||!coreReady}}">重试物流查询</button></view>
    <block wx:if="{{shipment && !shipmentLoading}}">
      <block wx:if="{{shipment.noCourier}}">
        <text class="shipment-card__carrier">{{shipment.carrierName}}</text>
        <text wx:if="{{shipment.shippedLabel}}" class="detail-copy">北京时间 {{shipment.shippedLabel}} 登记发货</text>
        <text wx:if="{{!shipment.receiptConfirmedAt && shipment.autoReceiptAt}}" class="detail-copy">{{shipment.wechatReceipt.inComplaint || shipment.wechatSyncState==='manual_review' || order.refundedCents>0 ? '自动收货待核对，可联系售后' : '发货满 7 天后自动确认收货'}}</text>
      </block>
      <block wx:else>
      <view wx:if="{{shipment.id}}" class="shipment-card__waybill">
        <view class="shipment-card__waybill-copy">
          <text class="shipment-card__carrier">{{shipment.carrierName}}</text>
          <text class="shipment-card__tracking" user-select>{{shipment.trackingNumber}}</text>
        </view>
        <button class="action-text shipment-card__copy {{!coreReady || shipmentLoading ? 'text-button--disabled' : ''}}" bindtap="copyWaybill" disabled="{{!coreReady || shipmentLoading}}" aria-label="复制运单号">复制</button>
      </view>
      <text wx:if="{{shipment.shippedLabel}}" class="detail-copy">北京时间 {{shipment.shippedLabel}} 交寄</text>
      <button wx:if="{{!closedRights && shipment.id && order.transactionSourceKind==='verified_commerce'}}" class="text-button shipment-card__details {{!coreReady||busy||shipmentLoading||trackingLoading?'text-button--disabled':''}}" bindtap="openLogistics" loading="{{trackingLoading}}" disabled="{{!coreReady||busy||shipmentLoading||trackingLoading}}">{{trackingLoading ? '正在打开物流…' : '查看物流详情'}}</button>
      <text wx:if="{{trackingError}}" class="receipt-status__error" aria-live="polite">{{trackingError}}</text>
      <button wx:if="{{!closedRights && trackingError && shipment.trackingNumber}}" class="text-button action-text {{!coreReady||busy||shipmentLoading||trackingLoading?'text-button--disabled':''}}" bindtap="loadTracking" disabled="{{!coreReady||busy||shipmentLoading||trackingLoading}}">查看轨迹</button>
      <view wx:if="{{tracking}}" class="receipt-status" aria-live="polite">
        <text class="receipt-status__label">物流轨迹</text>
        <text wx:if="{{!tracking.events.length}}" class="detail-copy">暂无轨迹更新</text>
        <view wx:for="{{tracking.events}}" wx:key="key"><text class="detail-copy">{{item.timeLabel}}</text><text class="detail-copy">{{item.message}}</text></view>
      </view>
  <view wx:if="{{shipment.id&&order.transactionSourceKind==='verified_commerce'}}" class="receipt-status" aria-live="polite"><text class="receipt-status__label">{{shipment.wechatReceipt?shipment.wechatReceipt.displayLabel:'微信记录：待核对'}}</text><text wx:if="{{shipment.wechatReceipt&&shipment.wechatReceipt.observedLabel}}" class="detail-copy">查询时间：{{shipment.wechatReceipt.observedLabel}}</text><text wx:if="{{receiptQueryLoading}}" class="detail-copy">正在更新微信记录…</text><text wx:if="{{receiptQueryError}}" class="receipt-status__error">{{receiptQueryError}}</text><text wx:if="{{shipment.receiptConfirmedAt && shipment.wechatReceipt.status!=='confirmed' && shipment.wechatReceipt.status!=='completed'}}" class="detail-copy">商城已记录收货</text><text wx:if="{{shipment.wechatReceipt&&shipment.wechatReceipt.inComplaint}}" class="detail-copy">本单有交易争议，请通过售后服务处理。</text></view>
  <text wx:if="{{!closedRights&&shipment.id&&order.transactionSourceKind==='verified_commerce'&&shipment.wechatReceipt&&shipment.wechatReceipt.canOpenComponent}}" class="detail-copy shipment-card__hint">收到全部商品后再确认；将打开微信官方确认页面。</text>
  <button wx:if="{{!closedRights&&shipment.id&&order.transactionSourceKind==='verified_commerce'&&shipment.wechatReceipt&&shipment.wechatReceipt.canOpenComponent}}" class="primary action-main shipment-card__primary {{busy||!coreReady||shipmentLoading||receiptQueryLoading?'primary--disabled':''}}" hover-class="action-pressed" bindtap="confirmWechatReceipt" disabled="{{busy||!coreReady||shipmentLoading||receiptQueryLoading}}" loading="{{receiptQueryLoading}}">确认收货</button>
  <button wx:if="{{!closedRights&&shipment.id&&order.transactionSourceKind==='verified_commerce'&&(!shipment.wechatReceipt||!shipment.wechatReceipt.canOpenComponent)}}" class="text-button action-text shipment-card__query {{busy||!coreReady||shipmentLoading||receiptQueryLoading?'text-button--disabled':''}}" hover-class="action-pressed" bindtap="refreshWechatReceipt" disabled="{{busy||!coreReady||shipmentLoading||receiptQueryLoading}}" loading="{{receiptQueryLoading}}">{{receiptQueryLoading?'正在查询…':receiptQueryError?'重试查询':shipment.wechatReceipt?'刷新微信记录':'查询微信记录'}}</button>
  <button wx:if="{{!closedRights&&shipment.id&&order.transactionSourceKind!=='verified_commerce'&&!shipment.receiptConfirmedAt}}" class="secondary action-secondary {{busy||!coreReady||shipmentLoading?'secondary--disabled':''}}" hover-class="action-pressed" bindtap="confirmReceipt" disabled="{{busy||!coreReady||shipmentLoading}}" loading="{{busy}}">记录已收到全部商品</button>
  <text wx:if="{{shipment.id&&order.transactionSourceKind!=='verified_commerce'&&shipment.receiptConfirmedAt}}" class="detail-copy">已记录收货</text>
      </block>
  </block></view>
  <button wx:if="{{order.status==='paid'}}" class="order-support {{busy||!coreReady||navigating?'text-button--disabled':''}}" hover-class="action-pressed" bindtap="openAftersale" disabled="{{busy||!coreReady||navigating}}">
    <text>{{order.aftersale ? '查看售后进度' : '售后服务'}}</text>
    <image src="/assets/icons/caret-right-muted.svg" mode="aspectFit" aria-hidden="true"/>
  </button>
</view>
<view class="order-receipt">
  <view class="order-lines">
    <view wx:for="{{order.lines}}" wx:key="id" class="line-item">
      <image class="line-item__image" src="{{item.image}}" mode="aspectFill" aria-hidden="true"/>
      <view class="line-item__description">
        <text class="line-item__name">{{item.productName}}</text>
        <text class="line-item__sku">{{item.skuLabel}} × {{item.quantity}}</text>
        <text wx:if="{{item.quantity > 1 || item.unitPriceYuan !== item.totalYuan}}" class="line-item__sku">单价 ¥{{item.unitPriceYuan}}</text>
      </view>
      <text class="line-item__price">¥{{item.totalYuan}}</text>
    </view>
  </view>
  <view class="money-card"><view><text>商品小计</text><strong>¥{{order.subtotalYuan}}</strong></view><view wx:if="{{order.couponDiscountCents>0}}"><text>体验正装券</text><strong>− ¥{{order.couponDiscountYuan}}</strong></view><view wx:if="{{order.memberDiscountCents>0&&(!order.couponDiscountCents||order.pointsSpent>0)}}"><text>{{order.pointsSpent>0?'积分抵扣（'+order.pointsSpent+'分）':'会员优惠'}}</text><strong>− ¥{{order.pointsDiscountYuan}}</strong></view><view><text>运费</text><strong>¥{{order.shippingYuan}}</strong></view><view class="money-total"><text>合计</text><strong>¥{{order.totalYuan}}</strong></view><view wx:if="{{order.creditTenderCents>0}}"><text>{{runtimeMode==='test'?'测试购物权益':'购物权益抵扣'}}</text><strong>− ¥{{order.creditYuan}}</strong></view><view wx:if="{{order.creditTenderCents>0}}" class="money-total"><text>{{runtimeMode==='test'?'模拟支付金额':'现金支付部分'}}</text><strong>¥{{order.cashYuan}}</strong></view></view>
</view>
<view class="order-section order-address">
  <text class="detail-heading" aria-role="heading">收货信息</text>
  <block wx:if="{{order.address}}">
    <text class="order-address__recipient" user-select>{{order.address.recipientName}} · {{order.address.phone}}</text>
    <text class="detail-copy" user-select>{{order.addressSummary}}</text>
  </block>
  <view wx:else class="order-address__empty">
    <text class="detail-copy">暂无收货信息</text>
    <button class="text-button order-address__help {{!coreReady||busy||navigating?'text-button--disabled':''}}" bindtap="openOrderSupport" disabled="{{!coreReady||busy||navigating}}" aria-label="就本单收货信息联系客服">联系客服</button>
  </view>
</view>
<view wx:if="{{order.fulfillmentPolicy}}" class="order-section order-policy">
  <template is="fulfillment-policy" data="{{policy:order.fulfillmentPolicy,open:fulfillmentOpen}}"/>
</view>
<view class="order-meta">
  <text>下单时间</text>
  <text user-select>{{order.createdLabel}}</text>
</view>
<view wx:if="{{refunds.length||refundError||refundLoading||order.status==='paid'&&runtimeMode==='test'}}" class="order-section refund-card">
  <view class="detail-heading">退款记录</view>
  <text wx:if="{{runtimeMode==='test'}}" class="refund-copy">测试订单，不涉及真实退款。</text>
  <button wx:if="{{!closedRights&&runtimeMode!=='formal'&&isolatedPayment&&!refundFormVisible}}" class="secondary" bindtap="showRefundForm">申请测试退款</button>
  <view wx:if="{{!closedRights&&runtimeMode!=='formal'&&isolatedPayment&&refundFormVisible}}" class="refund-form">
    <text class="refund-label">申请金额（元）</text><input type="digit" value="{{refundAmount}}" placeholder="如 20.00" bindinput="editRefundAmount" maxlength="11"/>
    <text class="refund-label">退款原因</text><textarea value="{{refundReason}}" placeholder="简要说明原因" bindinput="editRefundReason" maxlength="500" auto-height/>
    <view class="refund-actions"><button class="secondary {{busy?'secondary--disabled':''}}" bindtap="closeRefundForm" disabled="{{busy}}">取消填写</button><button class="primary {{busy?'primary--disabled':''}}" bindtap="submitRefund" loading="{{busy}}" disabled="{{busy}}">提交申请</button></view>
  </view>
  <view class="refund-history"><text>{{refundCountLabel}}</text><text wx:if="{{refundLoading}}">正在读取…</text></view>
  <view wx:for="{{refunds}}" wx:key="id" class="refund-row"><view><strong>¥{{item.amountLabel}}</strong><text>{{item.stateLabel}}</text></view><text wx:if="{{item.cashRefundCents!==null}}">原路现金 ¥{{item.cashLabel}} · 原批次权益 ¥{{item.creditLabel}}</text><text>{{item.reason}}</text></view>
  <view wx:if="{{refundError}}" class="state state--error"><text class="state-error__copy">{{refundError}}</text><button class="text-button state-error__action" bindtap="retryRefunds">重试</button></view>
  <button wx:if="{{refundCursor}}" class="secondary {{refundMoreLoading?'secondary--disabled':''}}" bindtap="loadMoreRefunds" loading="{{refundMoreLoading}}" disabled="{{refundMoreLoading}}">加载更多退款记录</button>
</view>
<view wx:if="{{actionStatus}}" class="state" aria-live="polite">{{actionStatus}}</view>
<view wx:if="{{actionError}}" class="state state--error" aria-live="assertive">{{actionError}}</view>
<view wx:if="{{!closedRights&&runtimeMode==='test'}}" class="payment-boundary order-section"><image src="/assets/icons/shield-check-plum.svg"/><text>{{runtimeMode==='formal'?(isolatedPayment?'确认订单后主动发起微信支付。':'正式交易暂未开放，请保留原单稍后核对。'):isolatedPayment?'测试订单仅模拟付款与退款，不涉及真实资金。':'微信付款暂未开放，请查看订单当前状态。'}}</text></view>
<view wx:if="{{!closedRights&&order.status==='pending_payment'}}" class="order-payment-actions">
  <button wx:if="{{paymentRecovery}}" class="text-button {{busy||!coreReady?'text-button--disabled':''}}" bindtap="recheckPayment" disabled="{{busy||!coreReady}}">查询付款结果</button>
  <button wx:if="{{order.transactionSourceKind!=='verified_commerce'||isolatedPayment}}" class="text-button order-payment-actions__cancel {{busy||!coreReady?'text-button--disabled':''}}" bindtap="cancel" loading="{{busy}}" disabled="{{busy||!coreReady}}">取消订单</button>
</view>
<view wx:if="{{!closedRights&&order.status==='pending_payment'&&isolatedPayment}}" class="order-paymentbar"><text class="order-paymentbar__amount">¥{{order.cashYuan}}</text><button class="primary action-main {{busy||!coreReady?'primary--disabled':''}}" hover-class="action-pressed" bindtap="preparePayment" disabled="{{busy||!coreReady}}" loading="{{busy}}">{{runtimeMode==='formal'?'微信支付':'测试支付'}}</button></view>
</block>
<view wx:if="{{coreReady}}" class="order-history"><button class="text-button order-history__toggle" bindtap="toggleRecordedHistory" aria-expanded="{{recordedHistoryOpen}}">{{recordedHistoryOpen?'收起处理记录':'查看处理记录'}}</button><template wx:if="{{recordedHistoryOpen}}" is="recorded-commands" data="{{recordedGroups,compact:true}}"/></view></view>
</view>

<points-celebration owner="{{rewardOwner}}" auto-receipts="{{true}}" enabled="{{!loading&&!qualificationPurchase}}"/>
<view wx:if="{{qualificationMoment}}" class="credit-moment officer-task-moment {{qualificationReduced?'credit-moment--reduced':'credit-moment--spinning'}}" aria-live="polite" aria-label="任务完成">
 <view class="credit-moment__shade" aria-hidden="true"/>
 <view class="credit-moment__card">
  <image class="credit-moment__silk" src="/assets/cisme/card-silk-v2.svg" mode="aspectFill" aria-hidden="true"/>
  <view class="credit-moment__light" aria-hidden="true"/>
  <view class="credit-moment__seal" aria-hidden="true">
   <image class="credit-moment__opal" src="/assets/cisme/onboarding-pearl-seal-v1.png" mode="aspectFit"/>
   <image class="credit-moment__check" src="/assets/icons/check-plum.svg" mode="aspectFit"/>
  </view>
  <text class="credit-moment__title">任务完成</text>
 </view>
</view>
