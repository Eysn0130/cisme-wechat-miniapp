<import src="../../templates/recorded-commands.wxml"/>
<view class="chrome-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back {{busy||navigating?'control--disabled':''}}" bindtap="back" disabled="{{busy||navigating}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">订单详情</text></view><view class="page page--stack detail-page"><view wx:if="{{loading}}" class="state">正在加载订单…</view><view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button wx:if="{{invalidId}}" class="text-button" bindtap="back">返回订单列表</button><button wx:else class="text-button" bindtap="load">刷新状态</button></view>
<view wx:if="{{runtimeState==='error'||runtimeMode==='test'||order.status==='pending_payment' && !isolatedPayment}}" class="state" aria-live="polite"><text>{{runtimeCopy}}</text><button wx:if="{{runtimeState==='error'}}" class="text-button {{busy?'text-button--disabled':''}}" bindtap="retryRuntime" disabled="{{busy}}">重试连接</button></view>
<view wx:if="{{recoveryLoading||recoveryError||recoveryRows.length}}" class="state" aria-live="polite">
  <text wx:if="{{recoveryLoading}}">正在核对上次操作…</text><text wx:if="{{recoveryError}}">{{recoveryError}}</text>
  <view wx:for="{{recoveryRows}}" wx:key="key"><text>{{item.label}}</text>
    <button wx:if="{{item.recorded||item.retryable&&(item.kind==='cancel'||isolatedPayment)}}" class="text-button {{busy||!coreReady?'text-button--disabled':''}}" data-key="{{item.key}}" bindtap="resolveRecovery" disabled="{{busy||!coreReady}}">{{item.recorded?'已核对原记录':'重试最初确认的操作'}}</button>
    <text wx:if="{{!item.recorded&&!item.retryable}}">原填写内容已清除，请联系客服核对；不要新建重复申请。</text>
  </view>
  <button class="text-button {{busy||recoveryLoading?'text-button--disabled':''}}" bindtap="loadRecovery" disabled="{{busy||recoveryLoading}}">重新核对原操作</button>
</view>
<page-container wx:if="{{order}}" show="{{supportSheetOpen}}" position="bottom" duration="220" z-index="90" overlay="{{true}}" round="{{true}}" close-on-slide-down="{{false}}" bindclickoverlay="closeSupportSheet" bindbeforeleave="onSupportSheetLeave" overlay-style="background:rgba(30,20,36,.48)" custom-style="height:78vh;max-height:calc(100vh - {{sheetKeyboardHeight}}px - 100rpx);bottom:{{sheetKeyboardHeight}}px;background:#fbf8fc;overflow:hidden;">
  <view class="support-sheet" catchtap="stopPropagation">
    <view class="support-sheet__header"><strong>售后客服</strong><view><button bindtap="expandSupport" aria-label="展开完整客服会话">展开</button><button bindtap="closeSupportSheet" aria-label="关闭客服面板">关闭</button></view></view>
    <view class="support-sheet__order"><text>订单 {{order.orderNumber}}</text><text>{{order.lines[0].productName}} · ¥{{order.totalYuan}}</text></view>
    <scroll-view class="support-sheet__body" scroll-y scroll-into-view="{{sheetCase||sheetConsulting?'sheet-last':''}}">
      <text wx:if="{{sheetLoading}}" class="support-sheet__notice">正在核对售后与会话…</text>
      <view wx:if="{{sheetError}}" class="support-sheet__error" aria-live="polite"><text>{{sheetError}}</text><button class="text-button {{sheetLoading?'text-button--disabled':''}}" bindtap="loadSupportSheet" disabled="{{sheetLoading}}">重试</button></view>
      <view wx:if="{{sheetCase}}" class="support-sheet__case">
        <strong>{{sheetCaseLabel}}</strong>
        <text>售后尾号 {{sheetCaseShortId}}</text><text wx:if="{{sheetRequestedLabel}}">申请时间 {{sheetRequestedLabel}}</text>
        <text wx:if="{{sheetCase.state==='awaiting_instruction'}}">客服正在核对本案收件信息，收到指引前无需寄回。</text>
        <view wx:if="{{sheetCase.returnDestination && sheetCase.state==='awaiting_return'}}" class="support-sheet__instruction"><strong>本单退货信息</strong><text user-select>{{sheetCase.returnDestination.recipientName}} · {{sheetCase.returnDestination.phone}}</text><text user-select>{{sheetCase.returnDestination.region}} {{sheetCase.returnDestination.address}}</text><text>{{sheetCase.returnDestination.freightPayer==='merchant'?'退货运费由商家承担':sheetCase.returnDestination.freightPayer==='member'?'退货运费由你承担':'退货运费请与客服确认'}}</text><text wx:if="{{sheetCase.returnDestination.instructions}}">{{sheetCase.returnDestination.instructions}}</text><button class="{{!sheetCasesReady?'control--disabled':''}}" bindtap="copySheetReturnInstruction" disabled="{{!sheetCasesReady}}">复制退货信息</button></view>
        <button bindtap="openFullAftersale">查看售后进度</button>
      </view>
      <view wx:if="{{!sheetCase && !sheetLoading}}" class="support-sheet__case"><text wx:if="{{sheetPreviousCase}}">{{sheetPreviousCase.resolved?(sheetHasRemaining?'上次退款已完成，可为剩余商品申请。':'上次退款已完成。'):sheetPreviousCase.state==='cancelled'?'上次申请已撤回，可重新申请。':'上次申请未通过，可重新申请或咨询客服。'}}</text><text wx:else>选择问题和商品后提交，我们会为你处理。</text><button wx:if="{{sheetPreviousCase}}" bindtap="openFullAftersale">查看历史记录</button></view>
      <text wx:if="{{!sheetCase && sheetLinesReady && !sheetHasRemaining}}" class="support-sheet__notice">本单商品已全部退款；仍有问题可联系客服。</text>
      <view wx:if="{{!sheetCase && !sheetConsulting && sheetLinesReady && sheetHasRemaining}}" class="support-sheet__selection"><text class="support-sheet__selection-title">本次申请的商品</text><view wx:for="{{sheetAvailable}}" wx:key="lineId" class="support-sheet__selection-row"><view><text>{{item.productName}}</text><text>{{item.skuLabel}} · 可申请 {{item.remainingQuantity}} 件</text></view><view class="support-sheet__stepper"><button class="{{sheetSubmitting||sheetAttempt||item.selectedQuantity===0?'control--disabled':''}}" data-id="{{item.lineId}}" data-delta="-1" bindtap="chooseSheetQuantity" disabled="{{sheetSubmitting||sheetAttempt||item.selectedQuantity===0}}" aria-label="减少申请数量"><image class="support-sheet__stepper-icon" src="/assets/icons/stepper-minus-plum.svg" mode="aspectFit"/></button><text>{{item.selectedQuantity}}</text><button class="{{sheetSubmitting||sheetAttempt||item.selectedQuantity===item.remainingQuantity?'control--disabled':''}}" data-id="{{item.lineId}}" data-delta="1" bindtap="chooseSheetQuantity" disabled="{{sheetSubmitting||sheetAttempt||item.selectedQuantity===item.remainingQuantity}}" aria-label="增加申请数量"><image class="support-sheet__stepper-icon" src="/assets/icons/stepper-plus-plum.svg" mode="aspectFit"/></button></view></view></view>
      <view wx:for="{{sheetMessages}}" wx:key="id" class="support-sheet__message support-sheet__message--{{item.senderType}}">
        <text>{{item.senderType==='system'?'系统':item.senderType==='user'?'我':item.senderType==='ai'?'AI 客服':'人工客服'}} · {{item.displayBody}}</text>
        <text wx:if="{{item.returnInstruction}}">{{sheetCase && item.returnInstruction.caseId===sheetCase.id?'退货信息请以上方本单指引为准。':'这是其他售后记录，展开会话可查看。'}}</text>
      </view>
      <view id="sheet-last"></view>
    </scroll-view>
    <view class="support-sheet__footer">
      <block wx:if="{{!sheetCase && !sheetConsulting && sheetHasRemaining}}">
        <picker range="{{sheetKindOptions}}" value="{{sheetKindIndex}}" bindchange="chooseSheetKind" disabled="{{sheetSubmitting||sheetAttempt}}"><view class="support-sheet__choice">{{sheetKindOptions[sheetKindIndex]}}</view></picker>
        <picker range="{{sheetBasisOptions}}" value="{{sheetBasisIndex}}" bindchange="chooseSheetBasis" disabled="{{sheetSubmitting||sheetAttempt}}"><view class="support-sheet__choice">{{sheetBasisOptions[sheetBasisIndex]}}</view></picker>
        <textarea aria-label="售后说明" value="{{sheetReason}}" placeholder="{{sheetBasisIndex===1?'补充说明（选填）':'简要说明问题'}}" maxlength="500" auto-height bindinput="editSheetReason" bindkeyboardheightchange="onSheetKeyboardHeightChange" disabled="{{sheetSubmitting||sheetAttempt}}"/>
        <button class="support-sheet__primary {{sheetSubmitting||sheetLoading||!sheetCasesReady||!sheetLinesReady?'control--disabled':''}}" bindtap="submitSheetAftersale" disabled="{{sheetSubmitting||sheetLoading||!sheetCasesReady||!sheetLinesReady}}" loading="{{sheetSubmitting}}">{{sheetAttempt?'重试原申请':'提交申请'}}</button>
      </block>
      <button wx:if="{{!sheetCase}}" class="support-sheet__mode {{sheetSubmitting||sheetSending||sheetAttempt||sheetSendAttempt?'control--disabled':''}}" bindtap="toggleSheetConsulting" disabled="{{sheetSubmitting||sheetSending||sheetAttempt||sheetSendAttempt}}">{{sheetConsulting?'返回售后申请':'先咨询客服'}}</button>
      <view wx:if="{{sheetCase || sheetConsulting}}" class="support-sheet__composer"><textarea aria-label="客服消息" value="{{sheetInput}}" placeholder="需要沟通？直接给客服留言" maxlength="4000" auto-height bindinput="editSheetInput" bindkeyboardheightchange="onSheetKeyboardHeightChange" disabled="{{sheetSending||sheetSendAttempt}}"/><button class="{{sheetSending||(!sheetInput&&!sheetSendAttempt)?'control--disabled':''}}" bindtap="sendSheetMessage" disabled="{{sheetSending||(!sheetInput&&!sheetSendAttempt)}}">{{sheetSendAttempt?'重试原消息':'发送'}}</button></view>
    </view>
  </view>
</page-container>
<view wx:if="{{order&&!coreReady}}" class="state">正在更新订单，稍后可继续操作。</view><block wx:if="{{order}}"><view class="order-hero"><text class="eyebrow">{{order.orderNumber}}</text><strong>{{order.statusLabel}}</strong><text wx:if="{{order.status==='pending_payment'&&runtimeMode==='formal'&&isolatedPayment}}">请主动确认微信付款；支付结果以服务端核验为准。订单到期 {{order.expiresLabel}}。</text><text wx:elif="{{order.status==='pending_payment'&&isolatedPayment}}">仅本机隔离协议测试；不会扣取真实款项。订单到期 {{order.expiresLabel}}。</text><text wx:elif="{{order.status==='pending_payment'&&paymentRecovery}}">新付款暂时关闭，仍可按原单核对已有支付结果。订单到期 {{order.expiresLabel}}。</text><text wx:elif="{{order.status==='pending_payment'}}">当前付款暂未开放；订单将在 {{order.expiresLabel}} 后由服务端超时处理。</text><text wx:elif="{{order.status==='paid'}}">付款成功，可在下方查看物流与售后。</text><text wx:else>这笔订单已结束，原记录仍可查看。</text></view>
<view class="detail-card"><view class="detail-heading">商品</view><view wx:for="{{order.lines}}" wx:key="id" class="line-item"><image src="{{item.image||'/assets/cisme/community-card-purple-bottle-v1.jpg'}}" mode="aspectFill"/><view><strong>{{item.productName}}</strong><text>{{item.skuLabel}} · ¥{{item.unitPriceYuan}} × {{item.quantity}}</text></view><strong>¥{{item.totalYuan}}</strong></view></view>
<button wx:if="{{order.status==='paid'}}" class="secondary {{busy||!coreReady||navigating?'control--disabled':''}}" bindtap="openAftersale" disabled="{{busy||!coreReady||navigating}}">售后服务</button>
<view class="detail-card" aria-live="polite"><view class="detail-heading">发货与物流</view>
<text wx:if="{{shipmentLoading}}" class="detail-copy">正在核对物流记录…</text>
<view wx:if="{{shipmentError}}" class="state state--error"><text>{{shipmentError}}</text><button class="text-button {{busy||!coreReady?'text-button--disabled':''}}" bindtap="loadShipment" disabled="{{busy||!coreReady}}">重试物流查询</button></view>
<block wx:if="{{shipment}}"><strong>{{shipment.stateLabel}}</strong><text wx:if="{{shipment.id}}" class="detail-copy" user-select>{{shipment.carrierName}} · {{shipment.trackingNumber}}</text><text wx:if="{{shipment.id&&!shipment.deliveredAt&&!shipment.receiptConfirmedAt}}" class="detail-copy">已记录交寄信息，签收以快递或你的确认记录为准。</text>
<button wx:if="{{shipment.id&&!shipment.receiptConfirmedAt}}" class="secondary {{busy||!coreReady||shipmentLoading?'secondary--disabled':''}}" bindtap="confirmReceipt" disabled="{{busy||!coreReady||shipmentLoading}}" loading="{{busy}}">确认已收到全部商品</button>
<view wx:if="{{shipment.id}}" class="tracking" aria-live="polite">
<button class="text-button {{busy||!coreReady||shipmentLoading||trackingLoading?'text-button--disabled':''}}" bindtap="loadTracking" disabled="{{busy||!coreReady||shipmentLoading||trackingLoading}}" loading="{{trackingLoading}}">{{trackingLoading?'正在查询轨迹':tracking?'刷新物流轨迹':trackingError?'重试物流轨迹':'查看物流轨迹'}}</button>
<text wx:if="{{trackingError}}" class="detail-copy">{{trackingError}}</text>
<block wx:if="{{tracking}}"><text class="detail-copy">微信物流助手 · 查询于 {{tracking.observedLabel}}</text>
<text wx:if="{{!tracking.events.length}}" class="detail-copy">承运商暂未返回轨迹，请稍后刷新；这不代表商品尚未交寄。</text>
<view wx:for="{{tracking.events}}" wx:key="index" class="tracking-row"><text class="detail-copy">{{item.timeLabel}}</text><text class="tracking-message">{{item.message}}</text></view></block>
</view></block></view>
<view wx:if="{{order.fulfillmentPolicy}}" class="detail-card"><view class="detail-heading">本单配送与售后承诺</view><text class="detail-copy">{{order.fulfillmentPolicy.shippingPromise}}</text><text class="detail-copy">{{order.fulfillmentPolicy.dispatchPromise}}</text><text class="detail-copy">{{order.fulfillmentPolicy.returnsPromise}}</text><text class="detail-copy">非质量原因退货运费由消费者承担；质量、错发、漏发及运输问题的合理费用由商家承担。</text></view>
<view class="detail-card"><view class="detail-heading">收货信息</view><block wx:if="{{order.address}}"><strong>{{order.address.recipientName}} · {{order.address.phone}}</strong><text class="detail-copy">{{order.addressSummary}}</text></block><text wx:else class="detail-copy">地址快照暂时无法读取，请联系客服。</text></view>
<view class="detail-card money-card"><view><text>商品小计</text><strong>¥{{order.subtotalYuan}}</strong></view><view><text>会员优惠</text><strong>− ¥{{order.discountYuan}}</strong></view><view><text>运费</text><strong>¥{{order.shippingYuan}}</strong></view><view class="money-total"><text>商品与运费合计</text><strong>¥{{order.totalYuan}}</strong></view><view wx:if="{{order.creditTenderCents>0}}"><text>{{runtimeMode==='test'?'购物权益 · 隔离测试':'购物权益抵扣'}}</text><strong>− ¥{{order.creditYuan}}</strong></view><view wx:if="{{order.creditTenderCents>0}}" class="money-total"><text>{{runtimeMode==='test'?'模拟渠道现金':'现金支付部分'}}</text><strong>¥{{order.cashYuan}}</strong></view></view>
<view class="detail-card"><view class="detail-heading">订单信息</view><text class="detail-copy">创建时间：{{order.createdLabel}}</text></view>
<view wx:if="{{order.status==='paid'||refunds.length>0}}" class="detail-card refund-card">
  <view class="detail-heading">退款记录与售后</view>
  <text class="refund-copy">{{runtimeMode==='test'?'测试环境，不会发生真实退款。':'退款进度更新在这里。有问题可从售后服务联系客服。'}}</text>
  <button wx:if="{{runtimeMode!=='formal'&&isolatedPayment&&!refundFormVisible}}" class="secondary" bindtap="showRefundForm">申请测试退款</button>
  <view wx:if="{{runtimeMode!=='formal'&&isolatedPayment&&refundFormVisible}}" class="refund-form">
    <text class="refund-label">申请金额（元）</text><input type="digit" value="{{refundAmount}}" placeholder="如 20.00" bindinput="editRefundAmount" maxlength="11"/>
    <text class="refund-label">退款原因</text><textarea value="{{refundReason}}" placeholder="简要说明原因" bindinput="editRefundReason" maxlength="500" auto-height/>
    <view class="refund-actions"><button class="secondary {{busy?'secondary--disabled':''}}" bindtap="closeRefundForm" disabled="{{busy}}">取消填写</button><button class="primary {{busy?'primary--disabled':''}}" bindtap="submitRefund" loading="{{busy}}" disabled="{{busy}}">提交申请</button></view>
  </view>
  <view class="refund-history"><text>{{refundCountLabel}}</text><text wx:if="{{refundLoading}}">正在读取…</text></view>
  <view wx:for="{{refunds}}" wx:key="id" class="refund-row"><view><strong>¥{{item.amountLabel}}</strong><text>{{item.stateLabel}}</text></view><text wx:if="{{item.cashRefundCents!==null}}">原路现金 ¥{{item.cashLabel}} · 原批次权益 ¥{{item.creditLabel}}</text><text>{{item.reason}}</text></view>
  <view wx:if="{{refundError}}" class="state state--error"><text class="state-error__copy">{{refundError}}</text><button class="text-button state-error__action" bindtap="retryRefunds">重试</button></view>
  <button wx:if="{{refundCursor}}" class="secondary {{refundMoreLoading?'secondary--disabled':''}}" bindtap="loadMoreRefunds" loading="{{refundMoreLoading}}" disabled="{{refundMoreLoading}}">加载更多退款记录</button>
</view>
<view wx:if="{{actionStatus}}" class="state" aria-live="polite">{{actionStatus}}</view>
<view wx:if="{{actionError}}" class="state state--error" aria-live="assertive">{{actionError}}</view>
<view wx:if="{{runtimeMode==='test'}}" class="payment-boundary"><image src="/assets/icons/shield-check-plum.svg"/><text>{{runtimeMode==='formal'?(isolatedPayment?'确认订单后主动发起微信支付。':'正式交易暂未开放，请保留原单稍后核对。'):isolatedPayment?'本机仅验证支付、退款协议和服务端状态；不会发生真实资金操作。':'正式微信支付尚未开放。订单状态以服务端记录为准。'}}</text></view>
<view wx:if="{{order.status==='pending_payment'&&(isolatedPayment||paymentRecovery)}}" class="payment-actions"><button wx:if="{{isolatedPayment}}" class="secondary {{busy?'secondary--disabled':''}}" bindtap="preparePayment" disabled="{{busy}}" loading="{{busy}}">{{runtimeMode==='formal'?'微信支付':'建立测试支付意图'}}</button><button wx:if="{{paymentRecovery}}" class="secondary {{busy?'secondary--disabled':''}}" bindtap="recheckPayment" disabled="{{busy}}">按原单核对</button></view>
<button wx:if="{{order.status==='pending_payment'&&(order.transactionSourceKind!=='verified_commerce'||isolatedPayment)}}" class="secondary danger-action {{busy?'secondary--disabled':''}}" bindtap="cancel" loading="{{busy}}" disabled="{{busy}}">取消订单</button></block></view><template wx:if="{{coreReady}}" is="recorded-commands" data="{{recordedGroups}}"/>
</view>
