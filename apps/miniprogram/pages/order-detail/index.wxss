.detail-page{background:#f7f2f8}.order-hero{display:flex;flex-direction:column;padding:30rpx 26rpx;border-radius:30rpx;color:#fff;background:linear-gradient(145deg,#69477a,#382346)}.order-hero .eyebrow{color:rgba(255,255,255,.72)}.order-hero strong{margin-top:18rpx;font:400 46rpx/1.2 "Songti SC","STSong",serif}.order-hero>text:last-child{margin-top:13rpx;color:rgba(255,255,255,.82);font-size:24rpx;line-height:1.55}.detail-card{margin-top:20rpx;padding:24rpx;border:1rpx solid var(--cisme-line);border-radius:26rpx;background:#fff}.detail-heading{margin-bottom:18rpx;color:var(--cisme-ink);font-size:28rpx;font-weight:500}.line-item{display:flex;align-items:center;gap:16rpx}.line-item image{width:112rpx;height:112rpx;flex:none;border-radius:18rpx}.line-item>view{display:flex;min-width:0;flex:1;flex-direction:column}.line-item strong{font-size:26rpx;font-weight:500}.line-item text,.detail-copy{display:block;margin-top:8rpx;color:var(--cisme-muted);font-size:23rpx;line-height:1.55}.line-item>strong{flex:none;font-variant-numeric:tabular-nums}.money-card view{display:flex;justify-content:space-between;padding:8rpx 0;color:var(--cisme-muted);font-size:24rpx}.money-card strong{color:var(--cisme-ink);font-weight:500;font-variant-numeric:tabular-nums}.money-card .money-total{margin-top:9rpx;padding-top:19rpx;border-top:1rpx solid var(--cisme-line);font-size:30rpx}.payment-boundary{display:flex;gap:14rpx;margin-top:22rpx;padding:20rpx;border-radius:22rpx;background:#eee6f0;color:#6d6171;font-size:23rpx;line-height:1.55}.payment-boundary image{width:30rpx;height:30rpx;flex:none}.danger-action{color:#8d3150}
