@import "../../styles/read-loading.wxss";
@import "../../styles/fulfillment-policy.wxss";
@import "../../styles/action-hierarchy.wxss";
@import "../../components/points-celebration/index.wxss";
.officer-task-moment .credit-moment__title{font-size:22px;font-weight:600}
.officer-task-moment.credit-moment--spinning{animation:credit-presence 160ms ease-out both,credit-leave 180ms 1640ms ease-in forwards}
.officer-task-moment.credit-moment--spinning .credit-moment__check{animation-delay:620ms}
@media(prefers-reduced-motion:reduce){.officer-task-moment.credit-moment--spinning{animation:none}}
.detail-page {
  padding-right: 36rpx;
  padding-left: 36rpx;
  background: var(--cisme-page);
}

.order-runtime {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0 16rpx;
  padding: 12rpx 0 8rpx;
  border-bottom: 1rpx solid var(--cisme-line);
  color: var(--cisme-muted);
  font-size: .8125rem;
  line-height: 1.5;
}

.order-runtime .text-button {
  flex: none;
  padding: 0;
}

.order-hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 38rpx 0 24rpx;
}

.order-hero__status {
  color: var(--cisme-ink);
  font-size: 1.875rem;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -.025em;
  overflow-wrap: anywhere;
}

.order-hero__copy,
.order-hero__number,
.detail-copy {
  display: block;
  margin-top: 8rpx;
  color: var(--cisme-muted);
  font-size: .8125rem;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.order-service {
  padding: 0 0 4rpx;
  border-top: 1rpx solid var(--cisme-line);
}

.shipment-card {
  padding: 25rpx 0;
}

.detail-heading {
  display: block;
  color: var(--cisme-ink);
  font-size: .9375rem;
  font-weight: 600;
  line-height: 1.45;
}

.order-support {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
  min-height: 50px;
  padding: 6rpx 0;
  border-top: 1rpx solid var(--cisme-line);
  border-radius: 0;
  background: transparent;
  color: var(--cisme-plum);
  font-size: .9375rem;
  text-align: left;
}

.order-support image {
  width: 28rpx;
  height: 28rpx;
  flex: none;
}

.order-receipt {
  margin-top: 22rpx;
  padding: 0 26rpx;
  border-radius: var(--cisme-radius-card);
  background: var(--cisme-card);
}

.line-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--cisme-line);
}

.line-item__image {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: var(--cisme-radius-control);
  background: var(--cisme-page);
}

.line-item__description {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
  overflow-wrap: anywhere;
}

.line-item__name,
.order-address__recipient {
  color: var(--cisme-ink);
  font-size: .875rem;
  font-weight: 500;
  line-height: 1.45;
}

.line-item__sku {
  color: var(--cisme-muted);
  font-size: .8125rem;
  line-height: 1.4;
}

.line-item__price,
.money-card strong {
  color: var(--cisme-ink);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.line-item__price {
  font-size: .875rem;
  overflow-wrap: anywhere;
  text-align: right;
}

.money-card {
  padding: 12rpx 0;
}

.money-card view {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 5rpx 0;
  color: var(--cisme-muted);
  font-size: .8125rem;
  line-height: 1.45;
}

.money-card .money-total {
  margin-top: 10rpx;
  padding: 14rpx 0 10rpx;
  border-top: 1rpx solid var(--cisme-line);
  color: var(--cisme-ink);
  font-size: .9375rem;
}

.money-total strong {
  font-size: 1.125rem;
  font-weight: 600;
}

.order-section {
  margin-top: 0;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--cisme-line);
}

.order-address {
  margin-top: 8rpx;
}

.order-address__recipient {
  display: block;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}

.order-address__empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-address__empty .detail-copy {
  margin: 0;
}

.order-address__help {
  flex: none;
  margin: 0;
  padding: 0;
  font-size: .8125rem;
}

.order-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8rpx 16rpx;
  padding: 22rpx 0 4rpx;
  color: var(--cisme-muted);
  font-size: .8125rem;
  line-height: 1.45;
}

.payment-boundary {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  color: var(--cisme-muted);
  font-size: .8125rem;
  line-height: 1.5;
}

.payment-boundary image { width: 30rpx; height: 30rpx; flex: none; }
@media (max-width: 345px) {
  .line-item__image { width: 92rpx; height: 92rpx; }
  .order-receipt { padding-right: 20rpx; padding-left: 20rpx; }
}

.refund-copy{display:block;margin-bottom:18rpx;color:var(--cisme-muted);font-size:24rpx;line-height:1.55}
.refund-form{display:flex;flex-direction:column;gap:12rpx;margin-top:18rpx}
.refund-label{font-size:25rpx;font-weight:600;color:var(--cisme-ink)}
.refund-form input,.refund-form textarea{box-sizing:border-box;width:100%;min-height:82rpx;padding:18rpx;border:1rpx solid var(--cisme-line);border-radius:18rpx;background:#fff;font-size:27rpx;color:var(--cisme-ink)}
.refund-form textarea{min-height:120rpx}
.refund-actions{display:flex;gap:12rpx;margin-top:14rpx}
.refund-actions button{flex:1;min-width:0;font-size:24rpx}
.refund-history{display:flex;justify-content:space-between;margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid var(--cisme-line);font-size:24rpx;color:var(--cisme-muted)}
.refund-row{display:flex;flex-direction:column;gap:8rpx;padding:16rpx 0;border-bottom:1rpx solid var(--cisme-line);font-size:24rpx;color:var(--cisme-muted)}
.refund-row view{display:flex;justify-content:space-between;color:var(--cisme-ink)}
.tracking{margin-top:18rpx;border-top:1rpx solid var(--cisme-line)}
.shipment-card__state{display:block;color:var(--cisme-ink);font-size:var(--cisme-text-action);font-weight:500;line-height:22px}
.shipment-card__heading{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}
.shipment-card__heading .shipment-card__state{color:var(--cisme-plum);font-size:var(--cisme-text-small);text-align:right}
.shipment-card__waybill{display:flex;align-items:center;gap:12rpx;margin-top:18rpx}
.shipment-card__waybill-copy{display:flex;flex:1;min-width:0;flex-direction:column;gap:4rpx}
.shipment-card__carrier{color:var(--cisme-muted);font-size:var(--cisme-text-small)}
.shipment-card__tracking{color:var(--cisme-ink);font-size:var(--cisme-text-action);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.shipment-card__copy{flex:none;min-height:var(--cisme-hit-target);color:var(--cisme-plum)}
.shipment-card__details{margin:6rpx 0 0;padding:0;justify-content:flex-start}
.receipt-status{display:flex;flex-direction:column;gap:4rpx;margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid var(--cisme-line);color:var(--cisme-ink);font-size:var(--cisme-text-body);line-height:22px}
.receipt-status__label{font-weight:500}
.receipt-status__error{display:block;color:#8d3150;font-size:var(--cisme-text-body);line-height:22px}
.receipt-status .detail-copy{margin-top:0}
.shipment-card__hint{margin-top:14rpx}
.shipment-card__primary{margin-top:12rpx}
.shipment-card__query{width:100%;margin-top:8rpx;justify-content:flex-start;text-align:left}
.tracking-row{padding:16rpx 0;border-bottom:1rpx solid var(--cisme-line)}
.tracking-message{display:block;margin-top:8rpx;color:var(--cisme-ink);font-size:24rpx;line-height:1.55;overflow-wrap:anywhere}
.support-sheet {
  position: relative;
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 30rpx 30rpx 0 0;
  background: var(--cisme-page);
}
.support-sheet button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: var(--cisme-hit-target);
  margin: 0;
  line-height: 1.35;
  white-space: normal;
}
.support-sheet__header, .support-sheet__order {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  gap: 12rpx;
}
.support-sheet__header { padding: 8rpx 22rpx 0 28rpx; color: var(--cisme-ink); }
.support-sheet__header strong { min-width: 0; font-size: 34rpx; font-weight: 600; }
.support-sheet__header button, .support-sheet .text-button {
  padding: 0 14rpx;
  color: var(--cisme-plum);
  background: transparent;
  font-size: var(--cisme-text-small);
}
.support-sheet__order {
  margin: 0 28rpx;
  padding: 2rpx 0 16rpx;
  border-bottom: 1rpx solid var(--cisme-line);
  color: var(--cisme-muted);
  font-size: var(--cisme-text-small);
}
.support-sheet__order-number { min-width: 0; overflow-wrap: anywhere; }
.support-sheet__order-status { flex: none; }
.support-sheet__body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 18rpx 28rpx;
}
.support-sheet__case, .support-sheet__selection, .support-sheet__application {
  box-sizing: border-box;
  margin: 0 0 16rpx;
  border: 1rpx solid var(--cisme-line);
  border-radius: var(--cisme-radius-card);
  background: var(--cisme-card);
  color: var(--cisme-ink);
  font-size: var(--cisme-text-body);
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.support-sheet__case, .support-sheet__selection { padding: 18rpx 22rpx; }
.support-sheet .support-sheet__summary {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8rpx;
  width: 100%;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--cisme-ink);
  font-size: var(--cisme-text-body);
  text-align: left;
}
.support-sheet__case-top, .support-sheet__view-case, .support-sheet__amount {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.support-sheet__case-status { min-width: 0; font-size: var(--cisme-text-action); font-weight: 600; }
.support-sheet__view-case { flex: none; color: var(--cisme-plum); font-size: var(--cisme-text-small); }
.support-sheet__view-case image, .support-sheet__field image { width: 24rpx; height: 24rpx; flex: none; }
.support-sheet__claim-line { display: flex; justify-content: space-between; gap: 12rpx; margin-top: 4rpx; }
.support-sheet__claim-quantity { flex: none; color: var(--cisme-muted); font-size: var(--cisme-text-small); }
.support-sheet__amount {
  padding-top: 9rpx;
  border-top: 1rpx solid var(--cisme-line);
  color: var(--cisme-muted);
  font-size: var(--cisme-text-small);
}
.support-sheet__amount strong { color: var(--cisme-ink); font-size: var(--cisme-text-action); font-variant-numeric: tabular-nums; }
.support-sheet__decision { display: block; margin-top: 12rpx; }
.support-sheet .support-sheet__case-main {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 22px;
  background: var(--cisme-lilac);
  color: var(--cisme-plum);
  font-size: var(--cisme-text-body);
}
.support-sheet__instruction {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 14rpx;
  padding: 14rpx 16rpx 2rpx;
  border-radius: var(--cisme-radius-control);
  background: var(--cisme-page);
}
.support-sheet__instruction .text-button { align-self: flex-start; padding: 0; }
.support-sheet__section-title { color: var(--cisme-ink); font-size: var(--cisme-text-body); font-weight: 600; }
.support-sheet__selection-row { display: flex; align-items: center; gap: 14rpx; margin-top: 12rpx; }
.support-sheet__product-image { width: 58rpx; height: 58rpx; flex: none; border-radius: 14rpx; background: var(--cisme-lilac); }
.support-sheet__product { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.support-sheet__product-quantity { color: var(--cisme-muted); font-size: var(--cisme-text-small); }
.support-sheet__stepper { display: flex; align-items: center; flex: none; }
.support-sheet__stepper button {
  width: var(--cisme-hit-target);
  min-width: var(--cisme-hit-target);
  flex: none;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.support-sheet__stepper text { min-width: 16px; text-align: center; font-variant-numeric: tabular-nums; }
.support-sheet__stepper-icon { width: 18px; height: 18px; flex: none; }
.support-sheet__application { padding: 4rpx 22rpx 16rpx; }
.support-sheet__field {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: var(--cisme-hit-target);
  border-bottom: 1rpx solid var(--cisme-line);
}
.support-sheet__field-label { flex: 1; }
.support-sheet__placeholder, .support-sheet__method, .support-sheet__notice { color: var(--cisme-muted); font-size: var(--cisme-text-small); }
.support-sheet__method, .support-sheet__notice { display: block; padding: 10rpx 0 0; }
.support-sheet__reason-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 16rpx;
}
.support-sheet__reason {
  display: block;
  width: 100%;
  height: 128px;
  box-sizing: border-box;
  padding: 10px 12px;
  border: 1rpx solid var(--cisme-line);
  border-radius: var(--cisme-radius-control);
  background: var(--cisme-page);
  color: var(--cisme-ink);
  font-size: var(--cisme-text-body);
  line-height: 1.55;
}
.support-sheet__reason--focused { border-color: var(--cisme-plum); }
@media (max-height: 640px) {
  .support-sheet__reason { height: 104px; }
}
.support-sheet__footer {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  max-height: 46%;
  min-height: 0;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 12rpx 28rpx calc(env(safe-area-inset-bottom) + 12rpx);
  border-top: 1rpx solid var(--cisme-line);
  background: var(--cisme-card);
}
.support-sheet .support-sheet__primary {
  width: 100%;
  min-height: 48px;
  border-radius: 24px;
  background: var(--cisme-plum);
  color: #fff;
  font-size: var(--cisme-text-action);
}
.support-sheet__contact { background: transparent; color: var(--cisme-plum); font-size: var(--cisme-text-body); }
.support-sheet__error { display: flex; align-items: center; gap: 8rpx; color: var(--cisme-danger); font-size: var(--cisme-text-small); }
.support-sheet__error-copy { flex: 1; min-width: 0; }
.support-sheet__error .text-button { flex: none; }

.detail-page--payable{padding-bottom:calc(env(safe-area-inset-bottom) + 130px)}

.order-payment-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0 16rpx;
}

.order-payment-actions .text-button {
  padding: 0;
  font-size: .8125rem;
}

.order-payment-actions__cancel {
  margin-left: auto;
  color: var(--cisme-danger);
}

.order-paymentbar{position:fixed;z-index:35;right:0;bottom:0;left:0;display:flex;align-items:center;gap:24rpx;padding:16rpx 28rpx calc(env(safe-area-inset-bottom) + 16rpx);border-top:1rpx solid var(--cisme-line);background:#faf7fb}
.order-paymentbar__amount{flex:none;color:var(--cisme-ink);font-size:23px;font-weight:500;line-height:1.35;font-variant-numeric:tabular-nums}
.order-paymentbar .primary{flex:1;min-width:0;margin:0;box-shadow:none}
.order-history__toggle{justify-content:flex-start;padding:0;color:var(--cisme-muted);font-size:.875rem}
