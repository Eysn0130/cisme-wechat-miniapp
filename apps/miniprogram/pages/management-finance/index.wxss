.finance-page{padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 56px));padding-bottom:calc(env(safe-area-inset-bottom) + 50rpx);background:#f7f2f8}.finance-tabs{display:flex;white-space:nowrap;margin:24rpx 0 18rpx}.finance-tab{display:inline-flex;align-items:center;justify-content:center;min-height:88rpx;margin:0 10rpx 0 0;padding:0 24rpx;border:1rpx solid #dfd2e3;border-radius:999rpx;background:#fff;color:#695772;font-size:25rpx}.finance-tab.is-active{background:#624674;border-color:#624674;color:#fff}.finance-count{display:block;margin:16rpx 0;color:#74667c;font-size:24rpx}.finance-row{margin-top:14rpx;padding:22rpx;border:1rpx solid #e9dfea;border-radius:22rpx;background:#fff}.finance-row__head{display:flex;justify-content:space-between;gap:20rpx}.finance-row__head strong{color:#45334e;font-size:27rpx;font-weight:600}.finance-row__head text{color:#807386;font-size:22rpx}.finance-amount{display:block;margin-top:13rpx;color:#56366b;font:38rpx Georgia,serif}.finance-copy{display:block;margin-top:12rpx;color:#54475a;font-size:25rpx;line-height:1.5;overflow-wrap:anywhere}.finance-id{display:block;margin-top:12rpx;color:#817789;font-size:20rpx;overflow-wrap:anywhere}.finance-actions{display:flex;gap:12rpx;margin-top:20rpx}.finance-action{display:flex;align-items:center;justify-content:center;flex:1;min-height:88rpx;margin:0;padding:0 12rpx;border:1rpx solid #d9c9df;border-radius:16rpx;background:#f8f3f9;color:#624674;font-size:24rpx}.finance-action--primary{background:#624674;border-color:#624674;color:#fff}.finance-feedback{margin-top:16rpx;padding:16rpx 20rpx;border-radius:16rpx;background:#eee7f2;color:#554262;font-size:23rpx;line-height:1.5}.finance-feedback--error{background:#fff2f1;color:#a14040}
.finance-bill-import{margin-top:18rpx;padding:22rpx;border:1rpx solid #e9dfea;border-radius:20rpx;background:#fff}.finance-bill-import>text:first-child{display:block;color:#55475e;font-size:25rpx}.finance-bill-date{display:flex;align-items:center;min-height:88rpx;margin-top:12rpx;padding:0 18rpx;border:1rpx solid #d9c9df;border-radius:14rpx;color:#4c365c;font-size:28rpx}.finance-bill-import .subtitle{display:block;margin-top:14rpx;line-height:1.5}
.finance-error{display:flex;flex-direction:column;align-items:flex-start;gap:16rpx;line-height:1.5}.finance-error .text-button{margin:0}
