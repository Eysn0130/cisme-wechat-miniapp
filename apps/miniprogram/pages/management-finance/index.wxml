<view class="management-shell" style="{{chromeStyle}}">
  <view class="topbar"><button class="topbar__back {{navigating?'control--disabled':''}}" bindtap="back" disabled="{{navigating}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">隔离资金核对</text></view>
  <view class="page page--stack finance-page">
    <view class="page-title">待处理事项</view>
    <text class="subtitle">仅供隔离测试。支付、退款和转账各自核验；渠道受理不等于资金完成。</text>
    <scroll-view wx:if="{{sections.length}}" class="finance-tabs" scroll-x enhanced show-scrollbar="false">
      <button wx:for="{{sections}}" wx:key="id" class="finance-tab {{section===item.id?'is-active':''}} {{busy?'control--disabled':''}}" data-section="{{item.id}}" bindtap="selectSection" disabled="{{busy}}">{{item.label}}</button>
    </scroll-view>
    <view wx:if="{{section==='bills'}}" class="finance-bill-import">
      <text>账单日期（次日生成）</text>
      <picker mode="date" value="{{billDate}}" end="{{latestBillDate}}" bindchange="chooseBillDate"><view class="finance-bill-date">{{billDate}} · 选择日期</view></picker>
      <view class="finance-actions"><button class="finance-action {{busy?'control--disabled':''}}" bindtap="importBill" data-type="SUCCESS" disabled="{{busy}}">核对支付账单</button><button class="finance-action {{busy?'control--disabled':''}}" bindtap="importBill" data-type="REFUND" disabled="{{busy}}">核对退款账单</button></view>
      <text class="subtitle">退款账单只证明渠道受理；退款成功仍以原单查询或可信回调为准。</text>
    </view>
    <view wx:if="{{actionStatus}}" class="finance-feedback">{{actionStatus}}</view>
    <view wx:if="{{actionError}}" class="finance-feedback finance-feedback--error">{{actionError}}</view>
    <view wx:if="{{loading}}" class="state">正在核验权限并读取待办…</view>
    <view wx:if="{{error}}" class="state state--error finance-error"><text>{{error}}</text><button class="text-button" bindtap="retry">重试</button></view>
    <text wx:if="{{!loading&&!error}}" class="finance-count">待处理 {{totalCount}} 项</text>
    <view wx:for="{{items}}" wx:key="id" class="finance-row">
      <view class="finance-row__head"><strong>{{section==='issues'?item.kindLabel:section==='refund'?'退款申请':section==='fulfillment'?'履约核验':section==='bills'?'交易账单':'结算申请'}}</strong><text>{{item.dateLabel}}</text></view>
      <text wx:if="{{section==='bills'}}" class="finance-copy">{{item.billDate}} · {{item.billType==='SUCCESS'?'支付':'退款受理'}} · {{item.rowCount}} 条中匹配 {{item.matchedCount}}，差异 {{item.exceptionCount}}</text>
      <text wx:if="{{item.amountLabel}}" class="finance-amount">¥{{item.amountLabel}}</text>
      <text wx:if="{{item.reason}}" class="finance-copy">{{item.reason}}</text>
      <text wx:if="{{item.sourceReference}}" class="finance-copy">凭据 {{item.sourceReference}} · 签收 {{item.deliveredAt}}</text>
      <text wx:if="{{item.code}}" class="finance-copy">{{item.code}} · 已尝试 {{item.attempts}} 次</text>
      <text class="finance-id">{{item.orderId||item.memberId||item.relatedId||item.id}}</text>
      <view wx:if="{{section!=='issues'&&section!=='bills'}}" class="finance-actions">
        <button class="finance-action {{busy?'control--disabled':''}}" data-id="{{item.id}}" data-decision="reject" bindtap="decide" disabled="{{busy}}">退回</button>
        <button wx:if="{{section==='fulfillment'}}" class="finance-action finance-action--primary {{busy?'control--disabled':''}}" data-id="{{item.id}}" data-decision="verify" bindtap="decide" disabled="{{busy}}">核验通过</button>
        <button wx:else class="finance-action finance-action--primary {{busy?'control--disabled':''}}" data-id="{{item.id}}" data-decision="approve" bindtap="decide" disabled="{{busy}}">核准</button>
      </view>
      <view wx:elif="{{section==='issues'&&item.kind!=='trade_bill'}}" class="finance-actions">
        <button class="finance-action {{busy?'control--disabled':''}}" data-id="{{item.id}}" data-action="recheck" bindtap="operateIssue" disabled="{{busy}}">查原单</button>
        <button wx:if="{{item.canRedrive}}" class="finance-action finance-action--primary {{busy?'control--disabled':''}}" data-id="{{item.id}}" data-action="redrive" bindtap="operateIssue" disabled="{{busy}}">核对后重驱</button>
      </view>
    </view>
    <view wx:if="{{!loading&&!error&&!items.length}}" class="state">这一类目前没有待办。</view>
    <view wx:if="{{moreError}}" class="finance-feedback finance-feedback--error">{{moreError}}</view>
    <button wx:if="{{nextCursor}}" class="secondary {{loadingMore?'secondary--disabled':''}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
  </view>
</view>
