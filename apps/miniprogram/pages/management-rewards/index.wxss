.reward-admin-filter{margin:0 0 8rpx}.reward-admin-filter picker>view{display:flex;align-items:center;gap:8rpx;min-height:44px}.reward-order-tools{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6rpx 16rpx;padding:10rpx 0 16rpx;border-bottom:1rpx solid var(--cisme-line)}.reward-date-range{display:flex;align-items:center;flex:1;gap:10rpx;min-width:0;color:var(--cisme-muted);font-size:12px}.reward-date-range picker{min-width:64px}.reward-date-range picker>view{display:flex;align-items:center;min-height:44px;color:#594865;white-space:nowrap}.reward-date-range .action-text{min-height:44px;margin:0;padding:0 6rpx;font-size:12px}.reward-order-actions{display:flex;align-items:center;gap:12rpx;margin-left:auto}.reward-order-actions .action-text{min-height:44px;margin:0;padding:0 6rpx}.reward-batch-action{display:flex;align-items:center;justify-content:center;min-height:44px;margin:0;padding:0 18rpx;border:0;border-radius:10px;color:#56336f;background:#e9dff0;font-size:13px;font-weight:600;line-height:1.5}
.reward-claims-list{display:flex;flex-direction:column;gap:18rpx;margin-top:22rpx}.reward-claim-card{display:block;width:100%;margin:0;padding:22rpx 24rpx 18rpx;border:0;border-radius:12px;background:#fff;box-shadow:0 5rpx 20rpx rgba(48,29,59,.04);text-align:left;white-space:normal}.reward-claim-card__head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.reward-claim-title{min-width:0;color:var(--cisme-ink);font-size:16px;font-weight:600;line-height:1.5}.reward-claim-status{flex:none;padding:5rpx 12rpx;border-radius:6px;color:#654379;background:#f0e8f5;font-size:12px;line-height:1.5}.reward-claim-card__body{display:flex;align-items:center;gap:16rpx;margin:12rpx 0}.reward-claim-card__body>image:first-child{flex:none;width:94rpx;height:108rpx}.reward-claim-card__body>view{min-width:0;flex:1}.reward-claim-member{display:block;color:#514359;font-size:13px;line-height:1.6;word-break:break-all}.reward-claim-member>text{color:var(--cisme-muted);font-size:12px}.reward-claim-spec{display:block;margin-top:7rpx;color:var(--cisme-muted);font-size:12px;line-height:1.5}.reward-claim-arrow{width:18px;height:18px;flex:none}.reward-claim-card__foot{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8rpx 14rpx;padding-top:14rpx;border-top:1rpx solid var(--cisme-line);color:var(--cisme-muted);font-size:11px;line-height:1.6;font-variant-numeric:tabular-nums}.reward-claims-skeleton{display:flex;flex-direction:column;gap:18rpx;margin-top:22rpx}.reward-claims-skeleton>view{height:250rpx;border-radius:12px;background:#eee7f2}.reward-admin-cold{padding-top:12rpx}.reward-admin-cold__heading{width:66%;height:86rpx;border-radius:8px;background:#eee7f2}.reward-admin-cold__controls{height:100rpx;margin-top:24rpx;border-radius:8px;background:#eee7f2}

.reward-voucher-filter,.reward-export-select{display:flex;align-items:center;gap:12rpx;min-height:44px}.reward-date-value{display:flex;align-items:center;min-height:44px;white-space:nowrap;color:#594865}
