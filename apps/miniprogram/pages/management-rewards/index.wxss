@import '../../styles/action-hierarchy.wxss';
@import '../../styles/read-loading.wxss';
.reward-admin{max-width:550px;margin:0 auto;padding-bottom:calc(env(safe-area-inset-bottom) + 55px)}.reward-admin-heading{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.reward-admin-heading picker{flex:1;min-width:0}.reward-admin-activity .reward-strong{display:block;font-size:23px;line-height:1.4;font-family:'Songti SC',serif;font-weight:500}.reward-admin-activity text{display:block;margin-top:18rpx;font-size:12px;color:var(--cisme-muted)}.reward-admin-tabs{display:flex;gap:30rpx;margin:34rpx 0}.reward-admin-tabs button{padding:10rpx 0;background:transparent;border-radius:0;color:var(--cisme-muted);font-size:15px}.reward-admin-tabs .selected,.reward-admin-actions .selected{color:var(--cisme-plum);font-weight:600}.reward-admin-tabs .selected{box-shadow:0 2rpx 0 var(--cisme-plum)}
.reward-admin-section{padding:18rpx 0 28rpx;margin-bottom:20rpx;border-bottom:1rpx solid var(--cisme-line)}.reward-admin-section .reward-strong{display:block;margin:14rpx 0 20rpx;font-size:16px;font-weight:600}.reward-admin-section text{display:block;margin-top:14rpx;color:var(--cisme-muted);font-size:14px;line-height:1.6}.reward-admin-section-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.reward-admin-section-head .reward-strong{font-size:16px;font-weight:600;line-height:1.5}.reward-admin-section-head .action-text{padding-right:0}.reward-admin-section-head text{font-size:12px;color:var(--cisme-plum)}.reward-admin-section-head .reward-small{font-size:12px;color:var(--cisme-muted)}.reward-stock-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:22rpx 0}.reward-stock-row view{display:flex;flex-direction:column;gap:12rpx}.reward-stock-row .reward-strong{font-size:14px;font-weight:500;line-height:1.4}.reward-stock-row text{font-size:12px;color:var(--cisme-muted)}
.reward-admin-filter{display:flex;align-items:center;justify-content:space-between;margin:22rpx 0;color:var(--cisme-muted);font-size:12px}.reward-admin-filter picker{min-height:44px;display:flex;align-items:center;color:var(--cisme-plum);font-size:14px}.reward-award-row{padding:20rpx 0;border-bottom:1rpx solid var(--cisme-line)}.reward-award-row text{display:block;margin-top:12rpx;font-size:12px;color:var(--cisme-muted);word-break:break-all}.reward-admin-id{font-family:ui-monospace,Menlo,monospace;font-size:11px!important}.reward-claim-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;width:100%;padding:26rpx 0;background:transparent;text-align:left;border-radius:0}.reward-claim-row view{display:flex;flex-direction:column;gap:14rpx;min-width:0}.reward-claim-row .reward-strong{font-size:15px;font-weight:600}.reward-claim-row text{font-size:12px;color:var(--cisme-plum);flex-shrink:0}.reward-claim-row view text,.reward-claim-row .reward-small{font-size:12px;word-break:break-all;color:var(--cisme-muted)}.reward-admin-empty{padding:80rpx 0;text-align:center;font-size:14px;color:var(--cisme-muted)}.reward-admin-export{display:flex;justify-content:space-between;align-items:center;margin-top:36rpx;padding-top:16rpx;border-top:1rpx solid var(--cisme-line);color:var(--cisme-plum)}.reward-admin-export picker{display:flex;align-items:center;min-height:44px;font-size:14px}
.reward-admin-error{padding:18rpx 0;color:var(--cisme-danger);font-size:14px;line-height:1.6}.reward-admin-pending{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:20rpx;background:#eee3f4;border-radius:20rpx}.reward-admin-pending .reward-strong{font-size:14px;font-weight:500}.reward-admin-muted{font-size:12px;line-height:1.7;color:var(--cisme-muted)}.reward-admin-mask{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-end;background:#2a193b66}.reward-admin-sheet{display:flex;flex-direction:column;gap:20rpx;width:100%;max-height:84vh;overflow:auto;padding:30rpx 34rpx calc(env(safe-area-inset-bottom) + 28rpx);border-radius:32rpx 32rpx 0 0;background:#fdfaff}.reward-admin-field{display:flex;flex-direction:column;gap:16rpx;margin-top:14rpx}.reward-admin-field text{font-size:13px;color:var(--cisme-muted)}.reward-admin-field input,.reward-admin-field textarea{width:100%;min-height:48px;padding:22rpx;border-radius:16rpx;background:#f2ebf6;color:var(--cisme-ink);font-size:16px;line-height:1.6}.reward-admin-field textarea{min-height:180rpx}.reward-admin-subtitle{display:block;margin-top:20rpx;font-size:15px;font-weight:600}.reward-product-check{display:flex;align-items:center;gap:18rpx;min-height:50px;font-size:14px}.reward-admin-actions{display:flex;align-items:center;justify-content:space-around;gap:24rpx}.reward-admin-sheet .primary{margin-top:22rpx}.reward-admin-detail{display:flex;flex-direction:column;gap:16rpx;word-break:break-all}.reward-admin-detail .reward-strong{font-size:15px;font-weight:600;line-height:1.5}.reward-admin-detail text{font-size:13px;color:var(--cisme-muted);line-height:1.7}
