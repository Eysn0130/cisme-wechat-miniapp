<page-meta root-font-size="system" page-style="{{sheet?'overflow:hidden;':''}}"/>
<view class="chrome-root" style="{{chromeStyle}}"><view class="topbar" aria-hidden="{{!!sheet}}"><button class="topbar__back" bindtap="back" aria-label="返回管理中心"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">活动奖励</text></view>
<view class="page page--stack reward-admin {{reducedMotion || !motionActive ? 'loading--still' : ''}}" aria-hidden="{{!!sheet}}"><view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在更新活动"><view class="page-read-loading__indicator"/></view>
 <view wx:if="{{error}}" class="reward-admin-error" aria-live="assertive">{{error}}<button class="action-text {{busy||loading?'control--disabled':''}}" bindtap="retryLoad" disabled="{{busy||loading}}">重试</button></view>
 <view wx:if="{{pending}}" class="reward-admin-pending"><text class="reward-strong">上次操作待核对</text><button class="action-text {{busy?'control--disabled':''}}" bindtap="reconcile" loading="{{busy}}" disabled="{{busy}}">核对结果</button></view>
 <view wx:if="{{loading && !manager}}" class="reward-admin-cold" aria-label="正在获取活动"><view class="reward-admin-cold__heading loading-bone"/><view class="reward-admin-cold__controls loading-bone"/><view class="reward-claims-skeleton"><view class="loading-bone"/><view class="loading-bone"/></view></view>
 <block wx:if="{{manager}}">
  <view class="reward-workspace-heading">
   <picker class="reward-activity-picker" range="{{manager.activities}}" range-key="title" value="{{activityIndex}}" bindchange="activityChange" disabled="{{busy || pending || loading}}">
    <view class="reward-activity-choice"><view><text class="reward-activity-name">{{activity.title || '创建第一个活动'}}</text><text class="reward-activity-status">{{!activity ? '未创建' : activity.state === 'published' ? '已发布' : activity.state === 'paused' ? '已暂停' : '草稿'}}</text></view><image src="/assets/icons/caret-right-muted.svg" class="reward-activity-chevron" aria-hidden="true"/></view>
   </picker>
   <button wx:if="{{manager.permissions.issue && activity.state === 'published'}}" class="reward-quick-share {{busy || pending || loading ? 'control--disabled' : ''}}" bindtap="openIssue" disabled="{{busy || pending || loading}}">分享礼遇</button>
  </view>
  <view class="page-section-tabs page-section-tabs--compact"><section-tabs id="page-tabs" items="{{[{id:'activity',label:'活动设置',hidden:!!targetMemberId},{id:'issue',label:'领券记录',hidden:!manager.permissions.issue},{id:'fulfill',label:'领取订单',hidden:!manager.permissions.fulfill}]}}" value="{{tab}}" label="活动奖励分类" bindchange="changeTab" disabled="{{busy}}"/></view>
  <block wx:if="{{tab === 'activity'}}">
   <view class="reward-rules-panel"><view class="reward-panel-heading"><text>领取规则</text><view><button wx:if="{{manager.permissions.configure && activity}}" class="action-text {{busy || pending || loading ? 'control--disabled' : ''}}" bindtap="openConfig" disabled="{{busy || pending || loading}}">编辑</button><button wx:if="{{manager.permissions.configure}}" class="action-text {{busy || pending || loading ? 'control--disabled' : ''}}" data-new="true" bindtap="openConfig" disabled="{{busy || pending || loading}}">新建活动</button></view></view><view class="reward-rule-lines"><text>每人1套 · 二选一 · 领券后30天内</text><text>大陆包邮 · 72小时发货 · 收货赠满198减20券</text></view></view>
   <view class="reward-panel-heading reward-stock-heading"><text>套装库存</text></view><view class="reward-stock-grid"><view wx:for="{{manager.bundles}}" wx:key="code" class="reward-bundle-stock"><image class="reward-bundle-image" src="{{item.code === 'moisture' ? './assets/travel-moisture-pair-v3.webp' : './assets/travel-dandruff-pair-v3.webp'}}" mode="aspectFit" aria-hidden="true"/><text class="reward-bundle-name">{{item.code === 'moisture' ? '净润洗护套' : '净屑洗护套'}}</text><text class="reward-bundle-volume">{{item.shampooMl}}mL + {{item.conditionerMl}}mL</text><view class="reward-stock-balance"><text>{{item.stockConfirmed ? item.availableQuantity : '—'}}</text><text>{{item.stockConfirmed ? '套可领' : '待入库'}}</text></view><text wx:if="{{item.reservedQuantity}}" class="reward-stock-reserved">已占用 {{item.reservedQuantity}} 套</text><button wx:if="{{manager.permissions.stock}}" class="action-text {{busy || pending || loading ? 'control--disabled' : ''}}" data-code="{{item.code}}" bindtap="openStock" disabled="{{busy || pending || loading}}">{{item.stockConfirmed ? '调整库存' : '登记入库'}}</button></view></view>
  </block>
  <block wx:elif="{{tab === 'issue'}}">
   <view class="reward-admin-filter"><picker range="{{filters}}" range-key="name" value="{{filterIndex}}" bindchange="filterChange" disabled="{{busy}}"><view class="reward-voucher-filter">{{filters[filterIndex].name}}<image src="/assets/icons/caret-right-muted.svg" class="reward-activity-chevron" aria-hidden="true"/></view></picker><text>{{manager.vouchers.length}}{{hasMore ? '+' : ''}} 张</text></view>
   <view wx:for="{{manager.vouchers}}" wx:key="id" class="reward-award-row"><view class="reward-admin-section-head"><text class="reward-strong">{{item.display_name || 'CISME会员'}}</text><text>{{item.label}}</text></view><view class="reward-admin-section-head"><text class="reward-small">有效至 {{item.date}}</text><button wx:if="{{item.state === 'unused' || item.state === 'expired'}}" class="action-text {{busy || pending ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="openRevoke" disabled="{{busy || pending}}">撤销</button></view></view>
   <view wx:if="{{!loading && !error && !manager.vouchers.length}}" class="reward-admin-empty">暂无对应兑换券</view><button wx:if="{{hasMore}}" class="action-text {{busy || loading ? 'control--disabled' : ''}}" bindtap="loadMore" disabled="{{busy || loading}}">加载更多</button>
   <view class="reward-admin-export"><picker range="{{exports}}" range-key="name" value="{{exportIndex}}" bindchange="exportChange"><view class="reward-export-select">{{exports[exportIndex].name}}<image src="/assets/icons/caret-right-muted.svg" class="reward-activity-chevron" aria-hidden="true"/></view></picker><button wx:if="{{!targetMemberId}}" class="action-text {{busy || !activity ? 'control--disabled' : ''}}" data-next="{{!!exportAfter && exportKind === exports[exportIndex].code}}" bindtap="export" loading="{{busy}}" disabled="{{busy || !activity}}">{{exportAfter ? '导出下一批' : '导出清单'}}</button></view>
  </block>
  <block wx:else>
   <view class="reward-order-status"><section-tabs items="{{fulfillTabs}}" value="{{filter}}" label="领取订单状态" bindchange="selectFulfillState" disabled="{{busy}}"/></view>
   <view class="reward-order-tools"><view class="reward-date-range"><picker mode="date" value="{{from}}" end="{{through}}" data-field="from" bindchange="selectDate" disabled="{{busy}}" aria-label="开始日期"><view class="reward-date-value">{{from || '开始日期'}}</view></picker><text>—</text><picker mode="date" value="{{through}}" start="{{from}}" data-field="through" bindchange="selectDate" disabled="{{busy}}" aria-label="结束日期"><view class="reward-date-value">{{through || '结束日期'}}</view></picker><button wx:if="{{from || through}}" class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="clearDates" disabled="{{busy}}">清除</button></view><view class="reward-order-actions"><button class="action-text {{busy || !activity ? 'control--disabled' : ''}}" bindtap="openExportMenu" disabled="{{busy || !activity}}">导出</button><button class="reward-batch-action {{busy || pending || !activity ? 'control--disabled' : ''}}" bindtap="openBulk" disabled="{{busy || pending || !activity}}">批量发货</button></view></view>
   <view wx:if="{{exportCount > 0}}" class="reward-export-progress"><text>{{exportKind === 'pending_dispatch' ? '待发货表' : '筛选结果'}} · 已导出 {{exportCount}} 笔</text><button wx:if="{{exportAfter}}" class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="exportNext" disabled="{{busy}}">导出下一批</button><text wx:elif="{{exportDone}}">已到末批</text></view>
   <view wx:if="{{loading && !manager.claims.length}}" class="reward-claims-skeleton" aria-label="正在更新领取订单"><view/><view/></view>
   <view class="reward-claims-list"><button wx:for="{{manager.claims}}" wx:key="id" class="reward-claim-card {{busy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="openDetail" disabled="{{busy}}"><view class="reward-claim-card__head"><text class="reward-claim-title">{{item.item.name}}</text><text class="reward-claim-status">{{item.label}}</text></view><view class="reward-claim-card__body"><image src="{{item.item.code === 'moisture' ? './assets/travel-moisture-pair-v3.webp' : './assets/travel-dandruff-pair-v3.webp'}}" mode="aspectFit" aria-hidden="true"/><view><text class="reward-claim-member">{{item.memberName || 'CISME会员'}}<text wx:if="{{item.cardNumber || item.userCode}}"> · {{item.cardNumber || item.userCode}}</text></text><text class="reward-claim-spec">{{item.item.shampooMl}}mL + {{item.item.conditionerMl}}mL · 1套</text></view><image class="reward-claim-arrow" src="/assets/icons/caret-right-muted.svg" aria-hidden="true"/></view><view class="reward-claim-card__foot"><text>{{item.claimNumber}}</text><text>{{item.date}}</text></view></button></view>
   <view wx:if="{{!loading && !error && !manager.claims.length}}" class="reward-admin-empty">暂无对应领取订单</view><button wx:if="{{hasMore}}" class="action-text {{busy || loading ? 'control--disabled' : ''}}" bindtap="loadMore" disabled="{{busy || loading}}">加载更多</button>
  </block>
 </block>
</view>
<view wx:if="{{sheet}}" class="reward-admin-mask" bindtap="closeSheet"><view class="reward-admin-sheet" catchtap="stop" aria-role="dialog" aria-modal="true" aria-label="{{sheet==='config'?'配置活动':sheet==='stock'?'库存入账':sheet==='share'?'分享洗护礼遇':sheet==='revoke'?'撤销兑换券':sheet==='batch'?'批量发货':'领取详情'}}"><view class="reward-admin-section-head"><text class="reward-strong">{{sheet==='config'?'配置活动':sheet==='stock'?stockLabel:sheet==='share'?'分享洗护礼遇':sheet==='revoke'?'撤销兑换券':sheet==='batch'?'批量发货':detailState||'领取详情'}}</text><button class="action-text {{busy?'control--disabled':''}}" bindtap="closeSheet" disabled="{{busy}}">关闭</button></view>
 <view wx:if="{{error}}" class="reward-admin-error" aria-live="assertive">{{error}}</view><view wx:if="{{pending}}" class="reward-admin-pending"><text>操作待核对</text><button class="action-text {{busy?'control--disabled':''}}" bindtap="reconcile" disabled="{{busy}}">核对结果</button></view>
 <block wx:if="{{sheet==='config'}}"><label class="reward-admin-field"><text>活动名称</text><input value="{{titleInput}}" data-field="titleInput" bindinput="editField" maxlength="80" disabled="{{busy||pending}}"/></label><text class="reward-admin-subtitle">收货赠券适用商品</text><checkbox-group bindchange="changeProducts"><label wx:for="{{products}}" wx:key="id" class="reward-product-check"><checkbox value="{{item.productId}}" checked="{{item.selected}}" color="#56306f" disabled="{{busy||pending}}"/><text>{{item.name}}</text></label></checkbox-group><button wx:if="{{productCursor}}" class="action-text" bindtap="loadProducts">更多商品</button><button class="primary {{busy||pending?'primary--disabled':''}}" data-action="publish" bindtap="saveConfig" loading="{{busy}}" disabled="{{busy||pending}}">确认并发布</button><view class="reward-admin-actions"><button class="action-text {{busy||pending?'control--disabled':''}}" data-action="save" bindtap="saveConfig" disabled="{{busy||pending}}">保存</button><button wx:if="{{editingId}}" class="action-text {{busy||pending?'control--disabled':''}}" data-action="pause" bindtap="saveConfig" disabled="{{busy||pending}}">暂停发券</button></view></block>
 <block wx:elif="{{sheet==='stock'}}"><view class="reward-admin-actions"><button class="action-text {{stockDirection===1?'selected':''}}" data-direction="1" bindtap="stockDirection">入库</button><button class="action-text {{stockDirection===-1?'selected':''}}" data-direction="-1" bindtap="stockDirection">减少</button></view><label class="reward-admin-field"><text>套数</text><input type="number" value="{{stockInput}}" data-field="stockInput" bindinput="editField" placeholder="填写实际套数" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending?'primary--disabled':''}}" bindtap="saveStock" loading="{{busy}}" disabled="{{busy||pending}}">确认数量</button></block>
 <block wx:elif="{{sheet==='share'&&share}}"><view class="reward-share-preview"><image src="/assets/cisme/travel-reward-share-v2.jpg" mode="aspectFit"/><text class="reward-share-title">一份洗护礼遇，分享给你。</text><text>净润 / 净屑 · 二选一</text><text>每位会员限领一套</text></view><button class="primary {{busy||pending?'primary--disabled':''}}" open-type="share" disabled="{{busy||pending}}">发给朋友</button></block>
 <block wx:elif="{{sheet==='revoke'}}"><label class="reward-admin-field"><text>撤销依据</text><textarea value="{{reasonInput}}" data-field="reasonInput" bindinput="editField" placeholder="填写撤销原因" maxlength="500" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending?'primary--disabled':''}}" bindtap="revoke" loading="{{busy}}" disabled="{{busy||pending}}">确认撤销</button></block>
 <block wx:elif="{{sheet==='batch'}}"><view class="reward-batch-tools"><button class="action-text {{busy || pending ? 'control--disabled' : ''}}" data-kind="pending_dispatch" bindtap="export" disabled="{{busy || pending}}">导出发货表</button><button class="action-text {{busy || pending ? 'control--disabled' : ''}}" bindtap="chooseBulkFile" loading="{{busy}}" disabled="{{busy || pending}}">{{importName ? '重新选择文件' : '选择XLSX文件'}}</button></view><text wx:if="{{!importName}}" class="reward-batch-hint">填写表中的承运商、物流单号后上传。每批最多500笔。</text><block wx:else><text class="reward-batch-filename">{{importName}}</text><view class="reward-batch-summary"><text>{{importReady}} 笔待登记</text><text wx:if="{{importRegistered}}">{{importRegistered}} 笔已登记</text><text wx:if="{{importErrors}}" class="reward-batch-error">{{importErrors}} 笔需修正</text></view><view class="reward-batch-rows"><view wx:for="{{importEntries}}" wx:key="claimNumber" class="reward-batch-row"><view><text class="reward-strong">{{item.claimNumber}}</text><text wx:if="{{item.name || item.item}}">{{item.name}}{{item.name && item.item ? ' · ' : ''}}{{item.item}}</text><text>{{item.carrierName}} · {{item.trackingNumber}}</text></view><text wx:if="{{item.problem || item.state === 'registered'}}" class="{{item.problem ? 'reward-batch-error' : ''}}">{{item.problem || '已登记'}}</text></view></view><text wx:if="{{importErrors}}" class="reward-batch-error">请修正以上记录后重新上传，本次尚未登记。</text></block><view wx:if="{{exportAfter}}" class="reward-export-progress"><text>发货表还有下一批</text><button class="action-text {{busy || pending ? 'control--disabled' : ''}}" bindtap="exportNext" disabled="{{busy || pending}}">导出下一批</button></view><button wx:if="{{importReady}}" class="primary {{busy || pending || importErrors ? 'primary--disabled' : ''}}" bindtap="confirmBulk" loading="{{busy}}" disabled="{{busy || pending || importErrors}}">确认登记 {{importReady}} 笔发货</button></block>
 <block wx:elif="{{detail}}"><view class="reward-admin-detail"><text class="reward-strong">{{detail.item.name}}</text><text>{{detail.item.shampoo}} {{detail.item.shampooMl}}mL</text><text>{{detail.item.conditioner}} {{detail.item.conditionerMl}}mL</text><text>{{detail.claimNumber}}</text><block wx:if="{{detail.address}}"><view class="reward-admin-copy"><text class="reward-strong">{{detail.address.recipientName}} · {{detail.address.phone}}</text><button class="action-text" bindtap="copyDelivery" aria-label="复制收件人、电话与地址">复制</button></view><text>{{detail.address.province}}{{detail.address.city}}{{detail.address.district}} {{detail.address.detail}}</text></block><view wx:if="{{detail.trackingNumber}}" class="reward-admin-copy"><text>{{detail.carrierName}} · {{detail.trackingNumber}}</text><button class="action-text" bindtap="copyTracking" aria-label="复制物流单号">复制</button></view><text wx:if="{{detail.aftersaleReason}}">{{detail.aftersaleReason}}</text></view>
 <block wx:if="{{detail.state==='placed'}}"><label class="reward-admin-field"><text>承运商</text><input value="{{carrierInput}}" data-field="carrierInput" bindinput="editField" disabled="{{busy||pending}}"/></label><label class="reward-admin-field"><text>物流单号</text><input value="{{trackingInput}}" data-field="trackingInput" bindinput="editField" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending?'primary--disabled':''}}" data-action="ship" bindtap="operate" loading="{{busy}}" disabled="{{busy||pending}}">确认发货</button></block>
 <block wx:if="{{detail.state==='aftersale_requested'}}"><label class="reward-admin-field"><text>处理依据</text><textarea value="{{reasonInput}}" data-field="reasonInput" bindinput="editField" disabled="{{busy||pending}}" maxlength="500"/></label><button class="primary {{busy||pending?'primary--disabled':''}}" data-action="resolve_return" bindtap="operate" loading="{{busy}}" disabled="{{busy||pending}}">确认售后完成</button><button class="action-text {{busy||pending?'control--disabled':''}}" data-action="reject_return" bindtap="operate" disabled="{{busy||pending}}">退回原状态</button></block></block>
</view></view></view>
