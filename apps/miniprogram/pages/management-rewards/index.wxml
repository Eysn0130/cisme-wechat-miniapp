<page-meta root-font-size="system" page-style="{{sheet?'overflow:hidden;':''}}"/>
<view class="chrome-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回管理中心"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">活动奖励</text></view>
<view class="page page--stack reward-admin"><view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在更新活动"><view class="page-read-loading__indicator"/></view>
 <view wx:if="{{error}}" class="reward-admin-error" aria-live="assertive">{{error}}<button class="action-text {{busy||loading?'control--disabled':''}}" bindtap="retryLoad" disabled="{{busy||loading}}">重试</button></view>
 <view wx:if="{{pending}}" class="reward-admin-pending"><text class="reward-strong">上次操作待核对</text><button class="action-text {{busy?'control--disabled':''}}" bindtap="reconcile" loading="{{busy}}" disabled="{{busy}}">核对结果</button></view>
 <block wx:if="{{manager}}"><view class="reward-admin-heading"><picker range="{{manager.activities}}" range-key="title" value="{{activityIndex}}" bindchange="activityChange" disabled="{{busy||pending}}"><view class="reward-admin-activity"><text class="reward-strong">{{activity.title||'创建第一个活动'}}</text><text>{{activity.state==='published'?'已发布':activity.state==='paused'?'已暂停':'草稿'}}⌄</text></view></picker><button wx:if="{{manager.permissions.configure}}" class="action-text {{busy||pending?'control--disabled':''}}" data-new="true" bindtap="openConfig" disabled="{{busy||pending}}">新建</button></view>
 <view class="reward-admin-tabs" aria-role="tablist"><button class="{{tab==='activity'?'selected':''}}" data-tab="activity" bindtap="changeTab" aria-role="tab" aria-selected="{{tab==='activity'}}">配置</button><button wx:if="{{manager.permissions.issue}}" class="{{tab==='issue'?'selected':''}}" data-tab="issue" bindtap="changeTab" aria-role="tab" aria-selected="{{tab==='issue'}}">发券</button><button wx:if="{{manager.permissions.fulfill}}" class="{{tab==='fulfill'?'selected':''}}" data-tab="fulfill" bindtap="changeTab" aria-role="tab" aria-selected="{{tab==='fulfill'}}">领取订单</button></view>
 <block wx:if="{{tab==='activity'}}"><view class="reward-admin-section"><view class="reward-admin-section-head"><text class="reward-strong">活动规则</text><button wx:if="{{manager.permissions.configure&&activity}}" class="action-text {{busy||pending?'control--disabled':''}}" bindtap="openConfig" disabled="{{busy||pending}}">编辑</button></view><text>一人一券 · 二选一 · 30天内可领</text><text>大陆包邮 · 72小时内发货</text><text>收货后发满198减20正装券</text></view><view class="reward-admin-section"><text class="reward-strong">组件库存</text><view wx:for="{{manager.inventory}}" wx:key="code" class="reward-stock-row"><view><text class="reward-strong">{{item.label}}</text><text>{{item.confirmed?'可发 '+item.available+' · 占用 '+item.reserved_quantity:'真实数量待确认'}}</text></view><button wx:if="{{manager.permissions.stock}}" class="action-text {{busy||pending?'control--disabled':''}}" data-code="{{item.code}}" bindtap="openStock" disabled="{{busy||pending}}">{{item.confirmed?'调整':'入库'}}</button></view></view></block>
 <block wx:elif="{{tab==='issue'}}"><view class="reward-admin-section-head"><text class="reward-strong">绑定获奖会员</text><button class="action-text {{busy||pending||activity.state!=='published'?'control--disabled':''}}" bindtap="openIssue" disabled="{{busy||pending||activity.state!=='published'}}">批量发券</button></view><view wx:if="{{activity.state!=='published'}}" class="reward-admin-muted">确认库存并发布活动后，即可发券</view><view class="reward-admin-filter"><picker range="{{filters}}" range-key="name" value="{{filterIndex}}" bindchange="filterChange"><view>{{filters[filterIndex].name}}⌄</view></picker><text>{{manager.vouchers.length}} 条已加载</text></view>
 <view wx:for="{{manager.vouchers}}" wx:key="id" class="reward-award-row"><view class="reward-admin-section-head"><text class="reward-strong">{{item.display_name||'CISME会员'}}</text><text>{{item.label}}</text></view><text class="reward-admin-id">{{item.member_id}}</text><text>{{item.batch_id}} · {{item.source_record_id}}</text><view class="reward-admin-section-head"><text class="reward-small">有效至 {{item.date}}</text><button wx:if="{{item.state==='unused'||item.state==='expired'}}" class="action-text {{busy||pending?'control--disabled':''}}" data-id="{{item.id}}" bindtap="openRevoke" disabled="{{busy||pending}}">撤销</button></view></view>
 <view wx:if="{{!manager.vouchers.length}}" class="reward-admin-empty">暂无对应兑换券</view><button wx:if="{{hasMore}}" class="action-text {{busy||loading?'control--disabled':''}}" bindtap="loadMore" disabled="{{busy||loading}}">加载更多</button>
 <view class="reward-admin-export"><picker range="{{exports}}" range-key="name" value="{{exportIndex}}" bindchange="exportChange"><view>{{exports[exportIndex].name}}⌄</view></picker><button class="action-text {{busy||!activity?'control--disabled':''}}" bindtap="export" loading="{{busy}}" disabled="{{busy||!activity}}">{{exportAfter?'导出下一批':'导出清单'}}</button></view></block>
 <block wx:else><view class="reward-admin-filter"><picker range="{{filters}}" range-key="name" value="{{filterIndex}}" bindchange="filterChange"><view>{{filters[filterIndex].name}}⌄</view></picker><text>{{manager.claims.length}} 条已加载</text></view><button wx:for="{{manager.claims}}" wx:key="id" class="reward-claim-row {{busy?'control--disabled':''}}" data-id="{{item.id}}" bindtap="openDetail" disabled="{{busy}}"><view><text class="reward-strong">{{item.item.name}}</text><text>{{item.claimNumber}}</text><text class="reward-small">{{item.date}}</text></view><text>{{item.label}} ›</text></button><view wx:if="{{!manager.claims.length}}" class="reward-admin-empty">暂无对应领取订单</view><button wx:if="{{hasMore}}" class="action-text {{busy||loading?'control--disabled':''}}" bindtap="loadMore" disabled="{{busy||loading}}">加载更多</button></block>
 </block>
</view>
<view wx:if="{{sheet}}" class="reward-admin-mask" bindtap="closeSheet"><view class="reward-admin-sheet" catchtap="stop" aria-role="dialog" aria-label="{{sheet==='config'?'配置活动':sheet==='stock'?'库存入账':sheet==='issue'?'发放奖励':sheet==='revoke'?'撤销兑换券':'领取详情'}}"><view class="reward-admin-section-head"><text class="reward-strong">{{sheet==='config'?'配置活动':sheet==='stock'?stockLabel:sheet==='issue'?'发放奖励':sheet==='revoke'?'撤销兑换券':detailState||'领取详情'}}</text><button class="action-text {{busy?'control--disabled':''}}" bindtap="closeSheet" disabled="{{busy}}">关闭</button></view>
 <view wx:if="{{error}}" class="reward-admin-error" aria-live="assertive">{{error}}</view><view wx:if="{{pending}}" class="reward-admin-pending"><text>操作待核对</text><button class="action-text {{busy?'control--disabled':''}}" bindtap="reconcile" disabled="{{busy}}">核对结果</button></view>
 <block wx:if="{{sheet==='config'}}"><label class="reward-admin-field"><text>活动名称</text><input value="{{titleInput}}" data-field="titleInput" bindinput="editField" maxlength="80" disabled="{{busy||pending}}"/></label><label class="reward-admin-field"><text>活动编号</text><input value="{{codeInput}}" data-field="codeInput" bindinput="editField" maxlength="64" disabled="{{busy||pending||editingId}}"/></label><strong class="reward-admin-subtitle">体验正装券适用商品</text><checkbox-group bindchange="changeProducts"><label wx:for="{{products}}" wx:key="id" class="reward-product-check"><checkbox value="{{item.productId}}" checked="{{item.selected}}" color="#56306f" disabled="{{busy||pending}}"/><text>{{item.name}}</text></label></checkbox-group><button wx:if="{{productCursor}}" class="action-text" bindtap="loadProducts">更多商品</button><label class="reward-admin-field"><text>操作依据</text><input value="{{reasonInput}}" data-field="reasonInput" bindinput="editField" placeholder="填写本次配置或发布依据" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending?'primary--disabled':''}}" data-action="publish" bindtap="saveConfig" loading="{{busy}}" disabled="{{busy||pending}}">确认并发布</button><view class="reward-admin-actions"><button class="action-text {{busy||pending?'control--disabled':''}}" data-action="save" bindtap="saveConfig" disabled="{{busy||pending}}">保存</button><button wx:if="{{editingId}}" class="action-text {{busy||pending?'control--disabled':''}}" data-action="pause" bindtap="saveConfig" disabled="{{busy||pending}}">暂停发券</button></view></block>
 <block wx:elif="{{sheet==='stock'}}"><view class="reward-admin-actions"><button class="action-text {{stockDirection===1?'selected':''}}" data-direction="1" bindtap="stockDirection">入库</button><button class="action-text {{stockDirection===-1?'selected':''}}" data-direction="-1" bindtap="stockDirection">减少</button></view><label class="reward-admin-field"><text>数量</text><input type="number" value="{{stockInput}}" data-field="stockInput" bindinput="editField" placeholder="填写实际数量" disabled="{{busy||pending}}"/></label><label class="reward-admin-field"><text>调整依据</text><input value="{{reasonInput}}" data-field="reasonInput" bindinput="editField" placeholder="入库单号或调整原因" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending?'primary--disabled':''}}" bindtap="saveStock" loading="{{busy}}" disabled="{{busy||pending}}">确认入账</button></block>
 <block wx:elif="{{sheet==='issue'}}"><label class="reward-admin-field"><text>发放批次</text><input value="{{batchInput}}" data-field="batchInput" bindinput="editField" placeholder="活动批次编号" disabled="{{busy||pending}}"/></label><label class="reward-admin-field"><text>获奖记录ID,会员ID</text><textarea value="{{issueInput}}" data-field="issueInput" bindinput="editField" placeholder="每行一位，使用逗号分隔" maxlength="100000" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending||!issueInput||!batchInput?'primary--disabled':''}}" bindtap="issue" loading="{{busy}}" disabled="{{busy||pending||!issueInput||!batchInput}}">绑定会员并发券</button></block>
 <block wx:elif="{{sheet==='revoke'}}"><label class="reward-admin-field"><text>撤销依据</text><textarea value="{{reasonInput}}" data-field="reasonInput" bindinput="editField" placeholder="填写撤销原因" maxlength="500" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending?'primary--disabled':''}}" bindtap="revoke" loading="{{busy}}" disabled="{{busy||pending}}">确认撤销</button></block>
 <block wx:elif="{{detail}}"><view class="reward-admin-detail"><text class="reward-strong">{{detail.item.name}}</text><text>{{detail.item.shampoo}} {{detail.item.shampooMl}}mL</text><text>{{detail.item.conditioner}} {{detail.item.conditionerMl}}mL</text><text>{{detail.claimNumber}}</text><block wx:if="{{detail.address}}"><text class="reward-strong">{{detail.address.recipientName}} · {{detail.address.phone}}</text><text>{{detail.address.province}}{{detail.address.city}}{{detail.address.district}} {{detail.address.detail}}</text></block><text wx:if="{{detail.trackingNumber}}">{{detail.carrierName}} · {{detail.trackingNumber}}</text><text wx:if="{{detail.aftersaleReason}}">{{detail.aftersaleReason}}</text></view>
 <block wx:if="{{detail.state==='placed'}}"><label class="reward-admin-field"><text>承运商</text><input value="{{carrierInput}}" data-field="carrierInput" bindinput="editField" disabled="{{busy||pending}}"/></label><label class="reward-admin-field"><text>物流单号</text><input value="{{trackingInput}}" data-field="trackingInput" bindinput="editField" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending?'primary--disabled':''}}" data-action="ship" bindtap="operate" loading="{{busy}}" disabled="{{busy||pending}}">确认发货</button></block>
 <block wx:if="{{detail.state==='aftersale_requested'}}"><label class="reward-admin-field"><text>处理依据</text><textarea value="{{reasonInput}}" data-field="reasonInput" bindinput="editField" disabled="{{busy||pending}}" maxlength="500"/></label><button class="primary {{busy||pending?'primary--disabled':''}}" data-action="resolve_return" bindtap="operate" loading="{{busy}}" disabled="{{busy||pending}}">确认售后完成</button><button class="action-text {{busy||pending?'control--disabled':''}}" data-action="reject_return" bindtap="operate" disabled="{{busy||pending}}">退回原状态</button></block></block>
</view></view></view>
