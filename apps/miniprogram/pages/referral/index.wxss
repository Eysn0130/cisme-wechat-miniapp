.referral-page{padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 56px));padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 50rpx);background:#f7f2f8}.referral-card{margin-top:28rpx;padding:30rpx;border:1rpx solid #eadfee;border-radius:30rpx;background:#fff}.referral-card>text{display:block;color:#6e5b76;font-size:24rpx}.referral-card input{height:94rpx;margin-top:14rpx;padding:0 20rpx;border:1rpx solid #decfe5;border-radius:16rpx;color:#453452;background:#fbf8fc;font:32rpx Georgia,serif;letter-spacing:3rpx}.referral-card .referral-help{margin:20rpx 0 24rpx;color:#756a79;font-size:23rpx;line-height:1.55}.referral-note{margin-top:22rpx;padding:22rpx;border-radius:18rpx;color:#766b7c;background:#eee7f1;font-size:22rpx;line-height:1.55}
