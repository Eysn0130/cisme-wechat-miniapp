.post-page { padding-right:0; padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 168rpx); padding-left:0; background:#f8f3f8; }.post-topbar__copy { display:flex; align-items:center; flex-direction:column; }.post-topbar__subtitle { margin-top:4rpx; color:#958a97; font-size:var(--cisme-text-small); line-height:1.5; }
.post-cover { width:100%; height:620rpx; background:#e9e0eb; }.post-content { position:relative; margin-top:-11rpx; padding:30rpx 27rpx 38rpx; border-radius:30rpx 30rpx 0 0; background:#f8f3f8; }.post-author { display:flex; align-items:center; gap:14rpx; padding-bottom:24rpx; border-bottom:1rpx solid rgba(78,47,91,.1); }.post-author__avatar { width:61rpx; height:61rpx; border-radius:50%; }.post-author__copy { flex:1; }.post-author__name,.post-author__meta { display:block; }.post-author__name { color:#413445; font-size:26rpx; font-weight:500; }.post-author__meta { margin-top:4rpx; color:#948996; font-size:var(--cisme-text-small); line-height:1.5; }.post-badge { padding:10rpx 17rpx; border:1rpx solid rgba(86,48,111,.15); border-radius:999rpx; color:#694577; background:rgba(255,255,255,.7); font-size:var(--cisme-text-small); line-height:1.5; }
.post-title { margin-top:28rpx; color:#372b3d; font-family:"Songti SC","STSong",serif; font-size:44rpx; line-height:1.42; }.post-copy { margin-top:15rpx; color:#665a6a; font-family:"Songti SC","STSong",serif; font-size:var(--cisme-text-body); line-height:1.72; }.post-tags { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:23rpx; }.post-tag { padding:10rpx 15rpx; border-radius:999rpx; color:#77677f; background:#eee5f1; font-size:var(--cisme-text-small); line-height:1.5; }
.post-provenance { display:flex; align-items:flex-start; gap:15rpx; margin-top:26rpx; padding:22rpx; border-radius:26rpx; background:rgba(234,223,239,.68); }.post-provenance__icon { flex:0 0 auto; width:30rpx; height:30rpx; }.post-provenance__title,.post-provenance__meta { display:block; }.post-provenance__title { color:#5c4a64; font-size:var(--cisme-text-small); font-weight:500; }.post-provenance__meta { margin-top:5rpx; color:#897e8c; font-size:var(--cisme-text-small); line-height:1.5; }
.post-actions { position:fixed; z-index:30; right:11px; bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 8px); left:11px; display:flex; min-height:58px; padding:4px; overflow:hidden; border:1rpx solid rgba(255,255,255,.88); border-radius:30px; background:rgba(255,255,255,.82); -webkit-backdrop-filter:blur(20rpx); box-shadow:0 13rpx 30rpx rgba(57,37,69,.12); }.post-action { display:flex; align-items:center; justify-content:center; flex:1; gap:5px; min-height:48px; padding:0; border:0; border-radius:24px; color:#66586c; background:transparent; font-size:var(--cisme-text-small); font-weight:400; line-height:1.5; }.post-action__icon { width:30rpx; height:30rpx; }.post-unavailable { min-height:520rpx; margin:18rpx 24rpx 0; padding:64rpx 34rpx 40rpx; border-radius:42rpx; color:#807482; text-align:center; }.post-error-action { margin-top:0; }
.post-page { padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 218rpx)); }

.post-topbar__copy { flex:1; min-width:0; flex-direction:row; justify-content:flex-start; gap:12rpx; }
