page,
.post-root {
  min-height:100%;
  color:#333333;
  background:#ffffff;
  font-family:system-ui,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol","Noto Color Emoji",-apple-system,"Segoe UI",Roboto,Ubuntu,Cantarell,"Noto Sans",sans-serif,BlinkMacSystemFont,"Helvetica Neue",Arial,"PingFang SC","PingFang TC","PingFang HK","Microsoft Yahei","Microsoft JhengHei";
}
.post-root button,
.post-root input,
.post-root textarea { font-family:inherit; }
.post-root button { transition:opacity 120ms ease-out; }
.post-control--pressed { opacity:.65; }

/* Native navigation uses the shared measured status bar and capsule reserves. */
.post-topbar { border-bottom:0; background:#ffffff; }
.post-back { border:0; background:transparent; }
.post-nav-title { font-family:inherit; font-size:1.125rem; line-height:1.575rem; letter-spacing:0; }
.post-authorbar { display:flex; align-items:center; min-height:56px; box-sizing:border-box; padding:0 16px; background:#ffffff; }
.post-topbar__copy { display:flex; flex:1; align-items:center; gap:12px; min-width:0; min-height:44px; margin:0; padding:0; color:rgba(51,51,51,.8); background:transparent; text-align:left; }
.post-topbar__avatar { flex:none; width:36px; height:36px; border:1px solid rgba(0,0,0,.08); border-radius:50%; }
.post-topbar__name { flex:1; min-width:0; overflow:hidden; font-size:0.875rem; font-weight:500; line-height:1.125rem; text-overflow:ellipsis; white-space:nowrap; }
.post-follow { display:flex; flex:none; align-items:center; justify-content:center; width:80px; height:44px; min-height:44px; margin:0 0 0 12px; padding:0; background:transparent; }
.post-follow__label { display:flex; align-items:center; justify-content:center; width:80px; height:32px; border:1px solid #ff2e4d; border-radius:100px; color:#ff2e4d; font-size:0.875rem; font-weight:500; line-height:1.00625rem; }
.post-follow.is-active .post-follow__label { border-color:rgba(51,51,51,.2); color:rgba(51,51,51,.6); }
.post-follow-error { display:block; margin-bottom:12px; color:#b33d4c; font-size:0.875rem; line-height:1.25rem; }

.post-page { min-height:100vh; padding:var(--cisme-topbar-height) 0 calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 72px + 2.5rem); color:#333333; background:#ffffff; }
.post-gallery { position:relative; width:100%; }
.post-swiper,
.post-cover,
.post-video { display:block; width:100%; height:1000rpx; }
.post-swiper,
.post-video-wrap { background:rgba(0,0,0,.03); }
.post-cover { background:transparent; }
.post-gallery-count { position:absolute; z-index:1; top:12px; right:12px; min-width:32px; padding:2px 8px; border-radius:14px; color:#ffffff; background:rgba(0,0,0,.4); font-size:0.75rem; line-height:1.125rem; text-align:center; pointer-events:none; }
.post-gallery-pagination { position:absolute; right:0; bottom:12px; left:0; display:flex; align-items:center; justify-content:center; height:6px; pointer-events:none; }
.post-gallery-dot { flex:none; width:6px; height:6px; margin:0 3px; border-radius:6px; background:rgba(51,51,51,.3); }
.post-gallery-dot.is-current { background:#ff2442; }
.post-video-wrap { width:100%; }

.post-content { padding:0 16px; }
.post-page .state { font-size:0.75rem; line-height:1.2rem; }
.post-page .text-button { font-size:0.875rem; line-height:1.25rem; }
.post-title { display:block; margin:0 0 8px; color:#333333; font-size:1.125rem; font-weight:500; line-height:1.75rem; word-break:break-word; }
.post-copy { display:block; margin:0; color:#333333; font-size:1rem; font-weight:400; line-height:1.625rem; white-space:pre-wrap; word-break:break-word; }
.post-copy__body,
.post-copy__heading { color:#333333; font-weight:400; }
.post-copy__topic { margin-right:2px; color:#133667; font-size:1rem; font-weight:400; line-height:1.625rem; }
.post-tags { display:flex; flex-wrap:wrap; margin-top:16px; }
.post-tag { margin-right:2px; color:#13386c; font-size:1rem; font-weight:400; line-height:1.5rem; }
.post-published { display:flex; align-items:center; min-height:20px; margin-top:12px; color:rgba(51,51,51,.3); font-size:0.875rem; font-weight:400; line-height:1.05rem; }
.post-ai-label { margin-left:8px; color:rgba(51,51,51,.6); font-size:.75rem; line-height:1.125rem; }
.post-more { display:flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; margin:0 0 0 auto; padding:0 4px; color:rgba(51,51,51,.6); background:transparent; font-size:.875rem; line-height:1.25rem; }

.post-comments { margin-top:16px; padding-top:24px; border-top:1px solid rgba(51,51,51,.1); }

.post-comments-count { margin:0; color:rgba(51,51,51,.6); font-size:0.875rem; line-height:1.25rem; }
.comment-entry { display:flex; align-items:flex-start; gap:12px; padding:12px 0; }
.comment-avatar { flex:none; width:40px; height:40px; border-radius:50%; background:rgba(0,0,0,.03); }
.comment-main { flex:1; min-width:0; }
.comment-author-name { color:rgba(51,51,51,.6); font-size:0.875rem; line-height:1.125rem; }
.comment-mine { margin-left:4px; color:rgba(51,51,51,.6); font-size:0.75rem; }
.comment-body { margin-top:4px; color:#333333; font-size:0.875rem; line-height:1.25rem; white-space:pre-wrap; word-break:break-word; }
.comment-mention { color:#13386c; }
.comment-meta { margin-top:8px; color:rgba(51,51,51,.4); font-size:0.75rem; line-height:1.125rem; }
.comment-date { display:flex; flex-wrap:wrap; gap:6px; }
.comment-inline-actions { display:flex; align-items:center; gap:4px; margin-left:-8px; }
.comment-text-action { display:inline-flex; align-items:center; min-height:44px; margin:0; padding:0 8px; color:rgba(51,51,51,.6); background:transparent; font-size:0.75rem; line-height:1.125rem; }
.comment-like { display:flex; flex:none; align-items:center; justify-content:center; gap:4px; min-width:44px; min-height:44px; margin:0; padding:0 8px; color:rgba(51,51,51,.6); background:transparent; font-size:0.75rem; }
.comment-like .post-interaction-icon { width:18px; height:18px; }
.comment-replies { margin-left:52px; }
.comment-entry--reply .comment-avatar { width:24px; height:24px; }
.comment-expand { min-height:44px; margin:0; padding:0 0 0 36px; color:#13386c; background:transparent; font-size:0.8125rem; }
.comment-empty { display:block; padding:16px 0; color:rgba(51,51,51,.6); font-size:0.875rem; line-height:1.25rem; }
.community-preview-note { display:block; margin-top:12px; color:rgba(51,51,51,.6); font-size:0.75rem; line-height:1.125rem; }

.post-bottom-wrap { position:fixed; z-index:35; right:0; bottom:0; left:0; padding:16px 16px calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 16px); border-top:1px solid rgba(51,51,51,.1); background:#ffffff; }
.post-bottom-actions { display:flex; align-items:center; height:2.5rem; min-height:40px; }
.post-comment-entry { display:flex; flex:1; align-items:center; min-width:0; min-height:44px; margin:0; padding:0; color:rgba(51,51,51,.6); background:transparent; font-size:0.875rem; font-weight:400; line-height:1.00625rem; text-align:left; }
.post-comment-entry__label { display:block; flex:1; min-width:0; overflow:hidden; font-size:0.875rem; line-height:1.00625rem; text-overflow:ellipsis; white-space:nowrap; }
.post-bottom-action { display:flex; flex:none; align-items:center; justify-content:center; min-width:44px; min-height:44px; margin:0 0 0 4px; padding:0 8px; color:#333333; background:transparent; font-weight:400; }
.post-interaction-icon { flex:none; width:24px; height:24px; }
.post-action-count { max-width:24px; overflow:hidden; margin-left:4px; color:#333333; font-size:0.875rem; font-weight:500; line-height:1.00625rem; text-overflow:ellipsis; white-space:nowrap; }
.post-comment-label { max-width:3.5em; margin-left:4px; color:#333333; font-size:0.875rem; font-weight:500; line-height:1.00625rem; }
.post-share-action { width:44px; padding:0 8px; }
.post-editorial-actions .post-bottom-action { margin-left:0; }
.post-editorial-actions .post-like-action { margin-left:4px; }
.post-editorial-actions .post-share-action { margin-right:-4px; padding-right:12px; padding-left:8px; }
.post-comment-input { flex:1; min-width:0; height:40px; padding:0; color:#333333; background:transparent; font-size:0.875rem; line-height:1.25rem; }
.post-send { display:flex; align-items:center; justify-content:center; min-width:62px; min-height:44px; margin:0 0 0 4px; padding:0 12px; border-radius:22px; color:#ffffff; background:#ff2442; font-size:0.875rem; }
.post-reply-context { display:flex; align-items:center; justify-content:space-between; color:rgba(51,51,51,.6); font-size:0.75rem; line-height:1.125rem; }
.post-social-error { width:100%; min-height:44px; margin:0; padding:0 0 8px; color:#b33d4c; background:transparent; font-size:0.875rem; line-height:1.25rem; text-align:left; }
.post-action { display:flex; align-items:center; justify-content:center; gap:4px; width:100%; min-height:44px; margin:0; padding:0; color:#333333; background:transparent; font-size:0.875rem; }
.post-action__icon { width:24px; height:24px; }
.post-unavailable { width:auto; min-height:260px; margin:16px; padding:32px 16px; color:rgba(51,51,51,.6); background:#ffffff; text-align:center; }
.post-error-action { margin-top:0; }
.post-unavailable .error-scene__title { font-family:inherit; font-size:1.25rem; line-height:1.75rem; }
.post-unavailable .error-scene__copy { font-family:inherit; font-size:0.875rem; line-height:1.5rem; }
.post-unavailable .post-error-action,
.post-unavailable .action-label { font-family:inherit; font-size:1rem; line-height:1.25rem; }

@media (max-width:360px) {
  .post-comment-label { display:none; }
}

.post-comments-header { display:flex; align-items:center; justify-content:space-between; min-height:44px; margin-bottom:8px; }
.comment-notice { display:block; padding:8px 0; color:#526857; font-size:.875rem; line-height:1.375rem; }
.comment-error { display:block; padding:8px 0; color:#b33d4c; font-size:.875rem; line-height:1.375rem; white-space:normal; }
.comment-load-more { display:flex; align-items:center; justify-content:center; width:100%; min-height:44px; margin:8px 0; padding:0 12px; color:#133667; background:transparent; font-size:.875rem; line-height:1.25rem; }
.post-composer-row { display:flex; align-items:flex-end; gap:4px; min-height:44px; }
.post-comment-textarea { flex:1; min-width:0; width:auto; min-height:40px; max-height:120px; padding:8px 0; box-sizing:border-box; color:#333; background:#fff; font-family:inherit; font-size:1rem; line-height:1.5rem; }
.post-composer-close { flex:none; padding:0 4px; }
.comment-inline-actions { flex-wrap:wrap; }
.post-published { flex-wrap:wrap; }

.post-sheet-mask { position:fixed; z-index:80; top:0; right:0; bottom:0; left:0; display:flex; align-items:flex-end; background:rgba(0,0,0,.4); }
.post-block-sheet { width:100%; max-height:75vh; padding:8px 16px calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 16px); box-sizing:border-box; border-radius:16px 16px 0 0; color:#333; background:#fff; }
.post-sheet-header { display:flex; align-items:center; justify-content:space-between; min-height:44px; font-size:1rem; line-height:1.5rem; font-weight:500; }
.post-block-scroll { height:50vh; }
.post-block-row { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:56px; border-bottom:1px solid rgba(51,51,51,.08); font-size:.875rem; line-height:1.25rem; }
.post-block-name { flex:1; min-width:0; word-break:break-word; }
.post-block-row button { flex:none; }

.post-draft-count { display:block; color:rgba(51,51,51,.6); font-size:.75rem; line-height:1.125rem; text-align:right; }
.post-draft-count.is-over-limit { color:#b33d4c; }
