<page-meta root-font-size="system"/>
<template name="community-comment">
  <view class="comment-entry {{nested ? 'comment-entry--reply' : ''}}">
    <image class="comment-avatar" src="{{comment.avatar || '/assets/icons/user-circle-plum.svg'}}" mode="aspectFill"/>
    <view class="comment-main"><view class="comment-author-name">{{comment.authorName}}<text wx:if="{{comment.isMine}}" class="comment-mine">我</text></view><view class="comment-body"><text wx:if="{{comment.replyToName && comment.status !== 'deleted'}}" class="comment-mention">回复 {{comment.replyToName}}：</text>{{comment.body}}</view><view class="comment-meta"><view class="comment-date"><text>{{comment.dateLabel}}</text><text wx:if="{{comment.statusLabel}}">{{comment.statusLabel}}</text></view><view class="comment-inline-actions"><button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" wx:if="{{comment.status === 'published' && (!editorial || commentsEnabled)}}" class="comment-like {{comment.liked ? 'is-active' : ''}} {{busy ? 'control--disabled' : ''}}" data-id="{{comment.id}}" bindtap="likeComment" disabled="{{busy}}" aria-label="{{comment.liked ? '取消赞这条评论' : '赞这条评论'}}"><image class="post-interaction-icon" src="{{comment.liked ? '/assets/icons/post-reference/liked.svg' : '/assets/icons/post-reference/like_b.svg'}}" mode="aspectFit"/><text>{{comment.likeCount || ''}}</text></button><button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" wx:if="{{comment.status === 'published' && (!editorial || commentsEnabled)}}" class="comment-text-action {{busy ? 'control--disabled' : ''}}" data-id="{{comment.id}}" bindtap="replyComment" disabled="{{busy}}">回复</button><button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" wx:if="{{comment.isMine && comment.status !== 'deleted'}}" class="comment-text-action {{busy ? 'control--disabled' : ''}}" data-id="{{comment.id}}" bindtap="deleteComment" disabled="{{busy}}">删除</button><button wx:if="{{editorial && !comment.isMine && comment.status === 'published'}}" class="comment-text-action {{busy ? 'control--disabled' : ''}}" data-id="{{comment.id}}" bindtap="commentMore" disabled="{{busy}}" aria-label="评论更多操作" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">更多</button></view></view></view>

  </view>
</template>
<view class="chrome-root post-root" style="{{chromeStyle}}">
<view class="topbar post-topbar">
  <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" class="topbar__back post-back {{leaving ? 'control--disabled' : ''}}" bindtap="back" disabled="{{leaving}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button>
  <text class="topbar__title post-nav-title">护理故事</text>
</view>
<view class="page page--stack post-page" style="{{editorialSource && composerOpen ? 'padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 320px + ' + keyboardHeight + 'px);' : ''}}" bindtouchstart="interruptReadingRestore">
  <view wx:if="{{loading}}" class="state" aria-live="polite">正在加载护理故事…</view>
  <view wx:if="{{item && video}}" class="post-video-wrap"><video id="editorial-video" data-video-identity="{{videoEventId}}" class="post-video" style="height:{{videoHeightRpx}}rpx" src="{{video.src}}" poster="{{video.poster}}" initial-time="{{videoInitialTime}}" autoplay="{{false}}" controls="{{true}}" object-fit="contain" show-center-play-btn="{{true}}" show-fullscreen-btn="{{true}}" enable-progress-gesture="{{true}}" bindtimeupdate="videoTimeChanged" bindended="videoEnded" binderror="videoFailed" aria-label="播放视频：{{item.title}}"/></view>
  <view wx:if="{{item && media.length}}" class="post-gallery"><swiper class="post-swiper" style="height:{{galleryHeight}}rpx" current="{{mediaIndex}}" data-image-identity="{{imageEventId}}" bindchange="onMediaChange" bindtouchstart="beginGalleryTouch" bindtouchmove="moveGalleryTouch" indicator-dots="{{false}}" autoplay="{{false}}" circular="{{false}}" duration="300" easing-function="easeOutCubic"><swiper-item wx:for="{{media}}" wx:key="*this"><image class="post-cover" style="height:{{galleryHeight}}rpx" src="{{item}}" mode="aspectFit" bindload="mediaLoaded" binderror="mediaFailed" data-image-identity="{{imageEventId}}" data-index="{{index}}" bindtap="previewMedia" data-src="{{item}}" aria-role="button" aria-label="查看第 {{index + 1}} 张大图"/></swiper-item></swiper><text wx:if="{{media.length > 1}}" class="post-gallery-count" aria-label="第 {{mediaIndex + 1}} 张，共 {{media.length}} 张">{{mediaIndex + 1}}/{{media.length}}</text><view wx:if="{{media.length > 1}}" class="post-gallery-pagination" aria-hidden="true"><view wx:for="{{media}}" wx:key="*this" class="post-gallery-dot {{index === mediaIndex ? 'is-current' : ''}}" aria-hidden="true"/></view></view>
  <view wx:if="{{editorialSource && mediaError}}" class="state state--error" aria-live="polite"><text>{{mediaError}}</text><button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" class="text-button" bindtap="load">重新加载</button></view>
<view wx:if="{{item}}" class="post-authorbar">
  <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" wx:if="{{editorialSource && item}}" class="post-topbar__copy post-author-link {{leaving ? 'control--disabled' : ''}}" bindtap="openAuthor" disabled="{{leaving}}" aria-label="查看作者 {{item.author}} 的公开主页"><image class="post-topbar__avatar" src="{{item.avatar}}" mode="aspectFill"/><text class="post-topbar__name">{{item.author}}</text></button>
  <view wx:else class="post-topbar__copy"><image wx:if="{{item.avatar}}" class="post-topbar__avatar" src="{{item.avatar}}" mode="aspectFill"/><text class="post-topbar__name">{{item ? item.author : '护理故事'}}</text></view>
  <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" wx:if="{{socialEnabled && authorId && (!editorialSource || !item.isMine)}}" class="post-follow {{following ? 'is-active' : ''}} {{followBusy ? 'control--disabled' : ''}}" bindtap="toggleFollow" disabled="{{followBusy}}" aria-label="{{following ? '取消关注作者' : '关注作者'}}"><text class="post-follow__label">{{followBusy ? '处理中' : following ? '已关注' : '关注'}}</text></button>
</view>
  <view wx:if="{{item}}" class="post-content">
    <text wx:if="{{socialEnabled && followError}}" class="post-follow-error state--error" aria-live="polite">{{followError}}</text>
    <text class="post-title" aria-role="heading" aria-level="1">{{item.title}}</text>
    <text wx:if="{{editorialSource}}" class="post-copy"><text wx:for="{{item.readingSegments}}" wx:key="id" class="post-copy__{{item.kind}}">{{item.text}}</text></text><text wx:else class="post-copy">{{item.excerpt}}</text>
    <view wx:if="{{!editorialSource}}" class="post-tags"><text class="post-tag">#真实护理</text><text class="post-tag">#护理记录</text><text class="post-tag">#头皮清洁</text></view>
    <view class="post-published"><text>{{editorialSource ? 'CISME 发布于 ' : ''}}{{item.publishedLabel}}</text><text wx:if="{{editorialSource && aiLabel}}" class="post-ai-label">{{aiLabel}}</text><button wx:if="{{editorialSource}}" class="post-more" bindtap="openPostMore" aria-label="文章更多操作" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">更多</button></view>
    <view wx:if="{{editorialSource}}" id="post-comments" class="post-comments">
      <view class="post-comments-header"><text class="post-comments-count">{{commentCount === null ? '评论' : '共 ' + commentCount + ' 条评论'}}</text><button class="comment-text-action {{commentsLoading || commentsBusy ? 'control--disabled' : ''}}" bindtap="loadEditorialComments" disabled="{{commentsLoading || commentsBusy}}" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">{{commentsLoading ? '刷新中' : '刷新'}}</button></view>
      <text wx:if="{{commentsEnabled === false}}" class="comment-empty">这篇文章已关闭评论，已有评论仍可阅读。</text>
      <view wx:if="{{commentsNotice}}" class="comment-notice" aria-live="polite">{{commentsNotice}}</view>
      <view wx:if="{{commentsError}}" class="comment-error" aria-live="assertive"><text>{{commentsError}}</text><button class="comment-text-action {{commentsLoading || commentsBusy ? 'control--disabled' : ''}}" bindtap="loadEditorialComments" disabled="{{commentsLoading || commentsBusy}}" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">重新加载评论</button></view>
      <text wx:if="{{commentsLoading && !threads.length}}" class="comment-empty" aria-live="polite">正在加载评论…</text>
      <view wx:for="{{threads}}" wx:key="id" class="comment-thread"><template is="community-comment" data="{{comment:item,nested:false,busy:commentsBusy,editorial:true,commentsEnabled:commentsEnabled}}"/><view class="comment-replies"><view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id"><template is="community-comment" data="{{comment:reply,nested:true,busy:commentsBusy,editorial:true,commentsEnabled:commentsEnabled}}"/></view><button wx:if="{{item.replyCount > 1}}" class="comment-expand" data-id="{{item.id}}" bindtap="expandReplies" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">{{item.expanded ? '收起回复' : '展开其余 ' + item.hiddenCount + ' 条回复'}}</button></view></view>
      <text wx:if="{{!commentsLoading && !commentsError && !threads.length}}" class="comment-empty">{{commentsEnabled ? '还没有评论，来聊聊吧' : '还没有评论'}}</text>
      <button wx:if="{{commentHasMore}}" class="comment-load-more {{commentsLoading || commentsBusy ? 'control--disabled' : ''}}" bindtap="loadMoreEditorialComments" disabled="{{commentsLoading || commentsBusy}}" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">{{commentsLoading ? '正在加载…' : '加载更多评论'}}</button>
      <button wx:if="{{canModerate}}" class="comment-text-action" bindtap="openCommentReview" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">管理评论</button>
      <button wx:if="{{lastBlockedAuthor}}" class="comment-text-action {{commentsBusy ? 'control--disabled' : ''}}" bindtap="undoEditorialBlock" disabled="{{commentsBusy}}" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">撤销屏蔽 {{lastBlockedName}}</button>
    </view>
    <view wx:if="{{socialEnabled && !editorialSource}}" id="post-comments" class="post-comments">
      <view class="post-comments-count">共 {{social.commentCount}} 条评论</view>
      <text wx:if="{{socialLoading}}" class="comment-empty">正在同步交流…</text>
      <view wx:for="{{threads}}" wx:key="id" class="comment-thread">
        <template is="community-comment" data="{{comment:item,nested:false,busy:socialBusy}}"/>
        <view class="comment-replies"><view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id"><template is="community-comment" data="{{comment:reply,nested:true,busy:socialBusy}}"/></view><button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" wx:if="{{item.replyCount > 1}}" class="comment-expand" data-id="{{item.id}}" bindtap="expandReplies">{{item.expanded ? '收起回复' : '展开其余 ' + item.hiddenCount + ' 条回复'}}</button></view>
      </view>
      <view wx:if="{{!socialLoading && !socialError && !threads.length}}" class="comment-empty">还没有评论，聊聊你的护理感受吧</view>
      <text wx:if="{{social.truncated}}" class="comment-empty">当前展示前 500 条交流</text>
      <text wx:if="{{previewRuntime}}" class="community-preview-note">互动测试预览 · 新评论审核后才会公开</text>
    </view>
  </view>
  <view wx:if="{{!item && error}}" class="glass error-scene post-unavailable" aria-live="assertive" aria-atomic="true"><view class="error-scene__icon"><image class="error-scene__icon-image" src="/assets/icons/lock-key-plum.svg" mode="aspectFit"/></view><text class="error-scene__title" aria-role="heading" aria-level="1">{{errorTitle}}</text><text class="error-scene__copy">{{error}}</text><view class="error-scene__actions"><button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" wx:if="{{errorKind === 'load'}}" class="primary post-error-action {{loading ? 'primary--disabled' : ''}}" bindtap="load" disabled="{{loading}}"><text class="action-label">重新加载</text></button><button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" class="post-error-action {{leaving ? 'control--disabled' : ''}} {{errorKind === 'missing' ? 'primary' : 'secondary'}}" bindtap="backToCommunity" disabled="{{leaving}}"><text class="action-label">返回社区</text></button></view></view>
</view>
<view wx:if="{{item}}" class="post-bottom-wrap" style="{{keyboardHeight ? 'bottom:' + keyboardHeight + 'px;padding-bottom:6px;' : ''}}">
  <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" wx:if="{{socialError}}" class="post-social-error {{socialBusy || socialLoading ? 'control--disabled' : ''}}" bindtap="loadSocial" disabled="{{socialBusy || socialLoading}}">{{socialError}}{{editorialSource ? ' · 重新核对' : ''}}</button>
  <view wx:if="{{replyToName && (!editorialSource || composerOpen)}}" class="post-reply-context"><text>回复 {{replyToName}}</text><button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" bindtap="cancelReply" class="comment-text-action {{editorialSource && (commentsBusy || commentSendUnknown) ? 'control--disabled' : ''}}" disabled="{{editorialSource && (commentsBusy || commentSendUnknown)}}">取消回复</button></view>
  <view wx:if="{{editorialSource && composerOpen}}" class="post-editorial-composer">
    <text wx:if="{{commentSendUnknown && !commentsBusy}}" class="comment-notice">发送结果尚未确认，内容和提交编号已保留。</text>
    <text class="post-draft-count {{draftLength > 180 ? 'is-over-limit' : ''}}" aria-live="polite">{{draftLength}}/180</text><view class="post-composer-row"><textarea class="post-comment-textarea {{commentsBusy || commentSendUnknown || commentsEnabled !== true ? 'control--disabled' : ''}}" value="{{draft}}" maxlength="360" auto-height="{{true}}" placeholder="{{replyToName ? '回复 ' + replyToName : '说点什么…'}}" focus="{{composerFocused}}" disabled="{{commentsBusy || commentSendUnknown || commentsEnabled !== true}}" bindinput="inputComment" bindfocus="focusComment" bindblur="blurComment" bindkeyboardheightchange="keyboardChanged" adjust-position="{{false}}" show-confirm-bar="{{false}}" cursor-spacing="16" aria-label="写评论"/><button class="post-send {{commentsBusy || commentsEnabled !== true || draftLength < 2 || draftLength > 180 ? 'control--disabled' : ''}}" bindtap="sendComment" disabled="{{commentsBusy || commentsEnabled !== true || draftLength < 2 || draftLength > 180}}" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">{{commentsBusy ? '发送中' : commentSendUnknown ? '核对发送' : '发送'}}</button><button class="comment-text-action post-composer-close" bindtap="closeComposer" aria-label="收起评论编辑" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">收起</button></view>
  </view>
  <view wx:elif="{{editorialSource}}" class="post-bottom-actions post-editorial-actions">
    <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" class="post-comment-entry" bindtap="startComment" aria-label="{{commentsEnabled !== true ? '查看评论' : draft ? '继续写评论' : '写评论'}}"><text class="post-comment-entry__label">{{commentsEnabled !== true ? '查看评论' : draft ? '继续编辑…' : '说点什么…'}}</text></button>
    <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" class="post-bottom-action post-like-action {{social.liked ? 'is-active' : ''}} {{socialBusy || !socialEnabled ? 'control--disabled' : ''}}" bindtap="toggleLike" disabled="{{socialBusy || !socialEnabled}}" aria-label="{{social.liked ? '取消点赞' : '点赞这篇精选'}}，{{social.likeCount}} 赞"><image class="post-interaction-icon" src="{{social.liked ? '/assets/icons/post-reference/liked.svg' : '/assets/icons/post-reference/like_b.svg'}}" mode="aspectFit"/><text class="post-action-count">{{social.likeCount}}</text></button>
    <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" class="post-bottom-action post-save-action {{social.saved ? 'is-active' : ''}} {{socialBusy || !socialEnabled ? 'control--disabled' : ''}}" bindtap="toggleSave" disabled="{{socialBusy || !socialEnabled}}" aria-label="{{social.saved ? '取消收藏' : '收藏这篇精选'}}，{{social.saveCount}} 收藏"><image class="post-interaction-icon" src="{{social.saved ? '/assets/icons/post-reference/collected.svg' : '/assets/icons/post-reference/collect.svg'}}" mode="aspectFit"/><text class="post-action-count">{{social.saveCount}}</text></button>
    <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" class="post-bottom-action post-comment-action" bindtap="showComments" aria-label="{{commentCount === null ? '查看评论' : '查看 ' + commentCount + ' 条评论'}}"><image class="post-interaction-icon" src="/assets/icons/post-reference/chat.svg" mode="aspectFit"/><text class="post-comment-label post-action-count">{{commentCount === null ? '评论' : commentCount}}</text></button>
    <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" class="post-bottom-action post-share-action" open-type="share" aria-label="微信分享这篇精选"><image class="post-interaction-icon" src="/assets/icons/post-reference/share_forward.svg" mode="aspectFit"/></button>
  </view>
  <view wx:elif="{{socialEnabled}}" class="post-bottom-actions">
    <input class="post-comment-input" value="{{draft}}" maxlength="180" placeholder="{{replyToName ? '回复 ' + replyToName : '说点什么…'}}" focus="{{composerFocused}}" bindinput="inputComment" bindfocus="focusComment" bindblur="blurComment" bindkeyboardheightchange="keyboardChanged" adjust-position="{{false}}" confirm-type="send" bindconfirm="sendComment" aria-label="写评论"/>
    <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" wx:if="{{draft || composerFocused}}" class="post-send {{socialBusy || socialLoading || draft.length < 2 ? 'control--disabled' : ''}}" bindtap="sendComment" disabled="{{socialBusy || socialLoading || draft.length < 2}}">{{socialBusy ? '发送中' : '发送'}}</button>
    <block wx:else>
      <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" class="post-bottom-action {{social.liked ? 'is-active' : ''}} {{socialBusy || socialLoading ? 'control--disabled' : ''}}" bindtap="toggleLike" disabled="{{socialBusy || socialLoading}}" aria-label="{{social.liked ? '取消点赞' : '点赞'}}"><image class="post-interaction-icon" src="{{social.liked ? '/assets/icons/post-reference/liked.svg' : '/assets/icons/post-reference/like_b.svg'}}" mode="aspectFit"/><text>{{social.likeCount}}</text></button>
      <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" class="post-bottom-action {{social.saved ? 'is-active' : ''}} {{socialBusy || socialLoading ? 'control--disabled' : ''}}" bindtap="toggleSave" disabled="{{socialBusy || socialLoading}}" aria-label="{{social.saved ? '取消收藏' : '收藏'}}"><image class="post-interaction-icon" src="{{social.saved ? '/assets/icons/post-reference/collected.svg' : '/assets/icons/post-reference/collect.svg'}}" mode="aspectFit"/><text>{{social.saveCount}}</text></button>
      <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" class="post-bottom-action" bindtap="showComments" aria-label="查看评论"><image class="post-interaction-icon" src="/assets/icons/post-reference/chat.svg" mode="aspectFit"/><text>{{social.commentCount}}</text></button>
    </block>
  </view>
  <button hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80" wx:else class="post-action post-action--share" open-type="share" aria-label="分享这篇护理故事"><image class="post-action__icon" src="/assets/icons/post-reference/share_forward.svg" mode="aspectFit"/><text>微信分享</text></button>
</view>
<view wx:if="{{blocksOpen}}" class="post-sheet-mask" bindtap="closeEditorialBlocks" catchtouchmove="holdOverlay"><view class="post-block-sheet" catchtap="holdOverlay"><view class="post-sheet-header"><text aria-role="heading">屏蔽管理</text><button bindtap="closeEditorialBlocks" class="comment-text-action" aria-label="关闭屏蔽管理" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">完成</button></view><scroll-view class="post-block-scroll" scroll-y="{{true}}"><text wx:if="{{blocksLoading && !blocks.length}}" class="comment-empty">正在加载…</text><view wx:if="{{blocksError}}" class="comment-error" aria-live="assertive"><text>{{blocksError}}</text><button class="comment-text-action {{blocksLoading || blocksBusy ? 'control--disabled' : ''}}" bindtap="loadEditorialBlocks" disabled="{{blocksLoading || blocksBusy}}" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">重新加载</button></view><text wx:if="{{!blocksLoading && !blocksError && !blocks.length}}" class="comment-empty">还没有屏蔽任何用户</text><view wx:for="{{blocks}}" wx:key="authorId" class="post-block-row"><text class="post-block-name">{{item.name}}</text><button class="comment-text-action {{blocksBusy ? 'control--disabled' : ''}}" data-id="{{item.authorId}}" bindtap="unblockEditorialAuthor" disabled="{{blocksBusy}}" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">解除屏蔽</button></view><button wx:if="{{blocksHasMore}}" class="comment-load-more {{blocksLoading || blocksBusy ? 'control--disabled' : ''}}" bindtap="loadMoreEditorialBlocks" disabled="{{blocksLoading || blocksBusy}}" hover-class="post-control--pressed" hover-start-time="0" hover-stay-time="80">{{blocksLoading ? '正在加载…' : '加载更多'}}</button></scroll-view></view></view>
</view>
