.commission-page{padding-bottom:calc(60rpx + env(safe-area-inset-bottom))}
.commission-hero{display:flex;flex-direction:column;gap:12rpx;padding:32rpx;border-radius:28rpx;background:linear-gradient(145deg,#69477a,#382346);color:#fff}
.commission-hero text{font-size:25rpx;opacity:.82}.commission-hero strong{font:400 56rpx/1.2 "Songti SC","STSong",serif;font-variant-numeric:tabular-nums}.commission-hero small{font-size:22rpx;line-height:1.5;opacity:.82}
.commission-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rpx;margin-top:18rpx;overflow:hidden;border:1rpx solid var(--cisme-line);border-radius:24rpx;background:var(--cisme-line)}
.commission-grid view{display:flex;flex-direction:column;gap:9rpx;padding:22rpx;background:#fff}.commission-grid text{font-size:23rpx;color:var(--cisme-muted)}.commission-grid strong{font-size:30rpx;color:var(--cisme-ink);font-variant-numeric:tabular-nums}
.commission-facts{display:flex;flex-direction:column;gap:8rpx;margin-top:18rpx;font-size:24rpx;color:var(--cisme-muted)}
.commission-note{margin-top:22rpx;padding:20rpx;border-radius:20rpx;background:#f2eaf4;color:#685b70;font-size:23rpx;line-height:1.55}
.commission-section{margin-top:24rpx;padding:24rpx;border:1rpx solid var(--cisme-line);border-radius:24rpx;background:#fff}
.commission-section__heading,.commission-history,.commission-request view{display:flex;justify-content:space-between;align-items:center;gap:12rpx}.commission-section__heading strong,.commission-history strong{font-size:29rpx;color:var(--cisme-ink)}.commission-section__heading text,.commission-history text{font-size:23rpx;color:var(--cisme-muted)}
.commission-section>.primary{margin-top:20rpx}.commission-muted{display:block;margin-top:18rpx;font-size:24rpx;color:var(--cisme-muted)}
.commission-form{display:flex;flex-direction:column;gap:12rpx;margin-top:22rpx}.commission-form>text{font-size:24rpx;font-weight:600;color:var(--cisme-ink)}
.commission-form input,.commission-form textarea{box-sizing:border-box;width:100%;min-height:82rpx;padding:18rpx;border:1rpx solid var(--cisme-line);border-radius:18rpx;font-size:27rpx;color:var(--cisme-ink)}.commission-form textarea{min-height:120rpx}
.commission-actions{display:flex;gap:12rpx;margin-top:12rpx}.commission-actions button{flex:1;min-width:0;font-size:24rpx}
.commission-history{margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid var(--cisme-line)}
.commission-request{padding:17rpx 0;border-bottom:1rpx solid var(--cisme-line)}.commission-request view strong{font-size:27rpx;color:var(--cisme-ink)}.commission-request view text{font-size:24rpx;color:#56306f}.commission-request small{display:block;margin-top:7rpx;font-size:21rpx;color:var(--cisme-muted)}
.commission-request__confirm{margin:14rpx 0 0;min-height:84rpx;font-size:24rpx}
