@import "../../styles/read-loading.wxss";
.points-page { padding-right:24rpx; padding-left:24rpx; background:linear-gradient(180deg,#f6f0f8,#fbf8fb); }.points-topbar__copy { display:flex; align-items:center; flex-direction:column; }.points-topbar__subtitle { margin-top:4rpx; color:#968b98; font-size:var(--cisme-text-small); line-height:1.5; }
.points-hero { position:relative; padding:38rpx; overflow:hidden; border:1rpx solid rgba(255,255,255,.25); border-radius:58rpx; color:#fff; background:radial-gradient(circle at 84% 6%,rgba(255,255,255,.22),transparent 31%),linear-gradient(145deg,#76588b,#3e2850 78%); box-shadow:0 24rpx 50rpx rgba(53,31,68,.2); }.points-hero__eyebrow { color:rgba(255,255,255,.74); font:24rpx Georgia,serif; letter-spacing:4rpx; }.points-hero__balance { display:block; margin-top:36rpx; overflow-wrap:anywhere; font:110rpx/.9 Georgia,"Times New Roman",serif; font-variant-numeric:lining-nums tabular-nums; font-weight:400; }.points-hero__balance--compact { font-size:76rpx; line-height:1; }.points-hero__label { display:block; margin-top:14rpx; color:rgba(255,255,255,.82); font-size:24rpx; }.points-divider { height:1rpx; margin:30rpx 0 24rpx; background:rgba(255,255,255,.18); }
.points-summary { display:flex; }.points-summary__stat { flex:1; }.points-summary__value,.points-summary__label { display:block; }.points-summary__value { font:28rpx Georgia,serif; font-weight:400; }.points-summary__label { margin-top:7rpx; color:rgba(255,255,255,.72); font-size:var(--cisme-text-small); line-height:1.5; }.points-profile { margin-top:24rpx; padding:17rpx 19rpx; border:1rpx solid rgba(255,255,255,.22); border-radius:999rpx; color:rgba(255,255,255,.82); font-size:var(--cisme-text-small); line-height:1.5; text-align:center; }
.points-notice { display:flex; align-items:flex-start; gap:13rpx; margin-top:23rpx; padding:20rpx 22rpx; border-radius:25rpx; color:#756a79; background:rgba(235,224,240,.66); font-size:var(--cisme-text-body); line-height:1.6; }.points-notice__icon { flex:0 0 auto; width:29rpx; height:29rpx; margin-top:1rpx; }
.points-shop { position:relative; z-index:1; display:flex; align-items:center; justify-content:center; width:100%; min-height:44px; margin-top:15px; padding:0 18px; border:1rpx solid rgba(255,255,255,.32); border-radius:22px; color:#fff; background:rgba(255,255,255,.12); font-size:var(--cisme-text-small); font-weight:400; line-height:1; }
.ledger-head { display:flex; align-items:center; justify-content:space-between; margin-top:38rpx; }.ledger-head__title { color:#3e3144; font-family:"Songti SC","STSong",serif; font-size:30rpx; }.ledger-head__count { color:#938896; font-size:var(--cisme-text-small); line-height:1.5; }
.ledger-list { margin-top:12rpx; }.ledger-row { display:flex; align-items:center; gap:16rpx; min-height:103rpx; border-bottom:1rpx solid rgba(78,47,91,.09); }.ledger-icon { display:flex; align-items:center; justify-content:center; width:49rpx; height:49rpx; border-radius:16rpx; background:#eee5f1; }.ledger-icon__image { width:28rpx; height:28rpx; }.ledger-copy { flex:1; min-width:0; }.ledger-copy__title,.ledger-copy__meta { display:block; }.ledger-copy__title { color:#4d3f52; font-size:var(--cisme-text-small); font-weight:500; }.ledger-copy__meta { margin-top:5rpx; overflow:hidden; color:#948a97; font-size:var(--cisme-text-small); line-height:1.5; text-overflow:ellipsis; white-space:nowrap; }.ledger-row__amount { color:#6d6172; font:var(--cisme-text-small) Georgia,serif; }.ledger-row__amount.is-positive { color:#56306f; }.ledger-empty { margin-top:20rpx; padding:56rpx 30rpx; border-radius:32rpx; text-align:center; }.ledger-empty__icon { width:54rpx; height:54rpx; margin:0 auto 17rpx; }.ledger-empty__title { color:#4e4053; font-family:"Songti SC","STSong",serif; font-size:29rpx; }.ledger-empty__meta { display:block; margin-top:9rpx; color:#928795; font-size:var(--cisme-text-small); line-height:1.5; }
.points-notice { align-items:center; }
.points-notice__icon { flex:0 0 36rpx; width:36rpx; height:36rpx; margin-top:0; }
.points-summary__value,.ledger-row__amount { font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif; font-variant-numeric:lining-nums tabular-nums; }
.points-rules-link{min-height:44px;margin:0;padding:8px;color:#56306f;background:transparent;font-size:var(--cisme-text-small);}
.points-expiry{display:block;margin-top:18px;color:#fff3d7;font-size:var(--cisme-text-small);line-height:1.7;}
.points-tabs{display:flex;margin-top:22px;border-bottom:1px solid #decfe4;}
.points-tab{flex:1;min-height:48px;margin:0;padding:10px 4px;border:0;border-radius:0;color:#807287;background:transparent;font-size:var(--cisme-text-body);}
.points-tab.is-current{border-bottom:3px solid #56306f;color:#56306f;font-weight:600;}
.club-card{margin-top:16px;padding:20px;border:1px solid #e6dcea;border-radius:22px;background:#fffcff;}
.club-card-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;line-height:1.7;}
.club-eyebrow{display:block;margin-bottom:8px;color:#87728f;font-size:.6875rem;letter-spacing:2px;}
.club-title{display:block;color:#352342;font-family:"Songti SC","STSong",serif;font-size:1.25rem;font-weight:600;line-height:1.6;}
.club-streak{flex:none;color:#6c4a7c;font-size:.8125rem;}
.club-copy{display:block;margin-top:7px;color:#796d80;font-size:.8125rem;line-height:1.8;overflow-wrap:anywhere;}
.club-primary{display:flex;align-items:center;justify-content:center;min-height:48px;width:100%;margin:16px 0 0;padding:12px 18px;border-radius:999px;color:#fff;background:#56306f;font-size:.9375rem;line-height:1.5;}
.club-primary--disabled{color:#fff;background:#a18baa;}
.club-text{display:flex;align-items:center;justify-content:center;min-height:44px;margin:0;padding:10px 8px;color:#56306f;background:transparent;font-size:.8125rem;line-height:1.6;}
.club-badge{display:block;margin-top:14px;color:#7b5c30;font-size:.8125rem;line-height:1.7;}
.club-task{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:80px;width:100%;margin:0;padding:16px 0;border-radius:0;border-bottom:1px solid #eee6f0;color:#56306f;background:transparent;text-align:left;font-size:.8125rem;line-height:1.7;}
.club-task view{flex:1;min-width:0;}.club-task-title{display:block;color:#3f2d4c;font-size:.9375rem;font-weight:600;line-height:1.7;}
.club-notice,.club-status{margin-top:16px;padding:14px 16px;border-radius:14px;color:#624570;background:#eee5f2;font-size:.8125rem;line-height:1.8;}
.club-error{display:block;margin:14px 0;color:#9c3754;font-size:.8125rem;line-height:1.8;}
.club-actions{display:flex;flex-wrap:wrap;gap:6px;}.club-picker{min-height:48px;margin-top:14px;padding:12px 14px;border:1px solid #d5c1df;border-radius:12px;color:#56306f;box-sizing:border-box;}
.club-totals{display:flex;flex-wrap:wrap;gap:12px;margin-top:18px;color:#7b6c82;font-size:.75rem;line-height:1.8;}
.club-filters{width:100%;margin-top:14px;white-space:nowrap;}.club-filter{display:inline-flex;align-items:center;justify-content:center;min-height:44px;margin:0 8px 0 0;padding:10px 14px;border-radius:999px;color:#796a81;background:#f0e8f3;font-size:.8125rem;line-height:1.4;}
.club-filter.is-current{color:#fff;background:#56306f;}.club-load-more{width:100%;margin-top:8px;}
.club-gifts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px;}
.club-gift{min-width:0;margin:0;padding:16px 12px;border:1px solid #e1d3e7;border-radius:18px;color:#3f2d4c;background:#fffcff;text-align:left;line-height:1.6;}
.club-gift-image{display:block;width:100%;height:100px;margin-bottom:12px;}.club-gift-price{display:block;margin-top:8px;color:#56306f;font-size:1rem;font-weight:600;line-height:1.7;}
.club-modal{position:fixed;inset:0;z-index:1100;color:#352342;}.club-modal-mask{position:absolute;inset:0;background:rgba(37,22,46,.3);}
.club-sheet{position:absolute;top:calc(var(--cisme-topbar-height,64px) + 12px);right:12px;bottom:calc(var(--cisme-safe-bottom,0px) + 10px);left:12px;display:flex;flex-direction:column;overflow:hidden;border-radius:26px;background:#fffcff;}
.club-sheet-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 16px 8px 22px;}.club-close{display:flex;align-items:center;justify-content:center;flex:none;width:44px;height:44px;margin:0;padding:0;border:0;border-radius:50%;color:#56306f;background:#f0e7f4;font-size:1.5rem;line-height:1;}
.club-sheet-scroll{flex:1;min-height:0;height:0;}.club-sheet-content{padding:8px 22px 22px;}.club-sheet-footer{padding:12px 22px 22px;}.club-sheet-footer .club-primary{margin-top:0;}
.club-products{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 22px;}.club-product{min-height:48px;margin:0;padding:12px 14px;border:1px solid #cdb6d8;border-radius:12px;color:#56306f;background:transparent;font-size:.875rem;line-height:1.5;}
.club-product.is-current{color:#fff;background:#56306f;}.club-note{width:100%;min-height:140px;margin-top:12px;padding:14px;border:1px solid #dac7e3;border-radius:14px;color:#352342;font-size:1rem;line-height:1.8;box-sizing:border-box;}
.club-rule{margin-bottom:22px;}.club-address{display:block;width:100%;min-height:64px;margin-top:12px;padding:14px;border:1px solid #dac7e3;border-radius:14px;color:#594361;background:transparent;text-align:left;font-size:.875rem;line-height:1.8;}.club-address text{display:block;}.club-address.is-current{border:2px solid #56306f;background:#f2eaf5;}

@media(max-width:350px){.club-gifts{grid-template-columns:minmax(0,1fr);}.club-card{padding:16px;}.club-streak{font-size:.75rem;}}

.club-stepper{display:inline-flex;align-items:center;gap:14px;margin:18px 0;padding:3px;border:1px solid #dac7e3;border-radius:999px;background:#f5eef8;}
.club-stepper .club-text{flex:none;width:44px;min-height:44px;padding:0;font-size:1.25rem;}
.club-stepper-value{min-width:56px;color:#3f2d4c;text-align:center;font-size:1rem;font-variant-numeric:tabular-nums;}
.club-sheet--gift{top:auto;height:560px;max-height:calc(100vh - var(--cisme-topbar-height,64px) - var(--cisme-safe-bottom,0px) - 24px);}
.club-sheet{animation:club-sheet-enter .18s ease-out both;}
.club-product{transition:background-color .14s,color .14s,transform .14s;}
.club-primary:active,.club-product:active{transform:scale(.985);}
@keyframes club-sheet-enter{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}
@media(prefers-reduced-motion:reduce){.club-sheet{animation:none;}.club-product{transition:none;}.club-primary:active,.club-product:active{transform:none;}}
