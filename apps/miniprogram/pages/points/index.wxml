<page-meta root-font-size="system"/>
<view class="chrome-root" style="{{chromeStyle}}">
<view aria-hidden="{{rulesOpen || giftSelected !== null}}">
<view class="topbar points-topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">我的积分</text><button class="points-rules-link" bindtap="openRules">积分规则</button></view>
<view class="page page--stack points-page">
 <view wx:if="{{loading && !points}}" class="page-read-loading" aria-role="status" aria-label="正在加载积分"><view class="page-read-loading__indicator"/></view>
 <view wx:if="{{points}}" class="points-hero">
  <text class="points-hero__eyebrow">CISME MEMBERS CLUB</text><text class="points-hero__balance {{balanceClass}}">{{points.projection.available}}</text><text class="points-hero__label">可用积分</text>
  <view class="points-divider"/><view class="points-summary"><view class="points-summary__stat"><text class="points-summary__value">{{points.projection.frozen}}</text><text class="points-summary__label">冻结中</text></view><view class="points-summary__stat"><text class="points-summary__value">{{points.projection.reserved}}</text><text class="points-summary__label">订单预占</text></view><view class="points-summary__stat"><text class="points-summary__value">{{points.projection.debt}}</text><text class="points-summary__label">待冲抵欠分</text></view></view>
  <text wx:if="{{points.expiring.points > 0}}" class="points-expiry">{{points.expiring.withinDays}} 天内到期 {{points.expiring.points}} 分 · 最早 {{expiryDate}}</text>
  <text wx:if="{{points.projection.debt > 0}}" class="points-expiry">后续获得的积分会先冲抵欠分，清偿前不能使用积分。</text>
 </view>
 <view class="points-tabs" aria-role="tablist"><button wx:for="{{sections}}" wx:key="id" class="points-tab {{section === item.id ? 'is-current' : ''}} {{busy ? 'control--disabled' : ''}}" bindtap="selectSection" data-id="{{item.id}}" aria-role="tab" aria-selected="{{section === item.id}}" disabled="{{busy}}">{{item.label}}</button></view>
 <view wx:if="{{actionStatus}}" class="club-status" aria-live="polite">{{actionStatus}}</view><view wx:if="{{actionError && !giftSelected}}" class="club-error" aria-live="assertive">{{actionError}}</view>
 <block wx:if="{{section === 'earn'}}">
  <text wx:if="{{club && !club.enabled}}" class="club-copy">新积分活动尚未生效，历史余额和记录仍可查询。</text>
  <view wx:if="{{club.pendingRewardSources > 0}}" class="club-notice" aria-live="polite">{{club.pendingRewardSources}} 项积分奖励待处理<button class="club-text {{loading || busy ? 'control--disabled' : ''}}" bindtap="load" disabled="{{loading || busy}}">刷新</button></view>
  <view wx:if="{{club.enabled}}" class="club-tasks"><button class="club-task" bindtap="openCommunity"><view><text class="club-task-title">分享与交流</text><text class="club-copy">原创笔记、有效互动，按规则计分</text></view><text>去社区</text></button><button class="club-task {{navigating ? 'control--disabled' : ''}}" bindtap="openShop" disabled="{{navigating}}"><view><text class="club-task-title">购物积分</text><text class="club-copy">购物后，确认收货得积分</text></view><text>去选购</text></button><button class="club-task club-task--last" bindtap="openInvite"><view><text class="club-task-title">邀请好友</text><text class="club-copy">好友注册并完成首购收货，双方得积分</text></view><text>去邀请</text></button></view>
  <view wx:if="{{clubError}}" class="club-error">{{clubError}}<button class="club-text" bindtap="load">重新加载活动</button></view>
 </block>
 <block wx:elif="{{section === 'ledger' && points}}">
  <view class="club-totals"><text>累计获得 {{points.lifetimeEarned}}</text><text>净使用 {{points.used}}</text><text>已失效 {{points.expired}}</text></view>
  <scroll-view scroll-x class="club-filters"><button wx:for="{{sources}}" wx:key="id" class="club-filter {{source === item.id ? 'is-current' : ''}} {{loading || loadingMore ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="selectSource" disabled="{{loading || loadingMore}}">{{item.label}}</button></scroll-view>
  <view class="ledger-head"><text class="ledger-head__title">{{source === 'all' ? '全部积分记录' : '筛选积分记录'}}</text><text class="ledger-head__count">共 {{points.totalCount}} 笔</text></view><view class="ledger-list"><view wx:for="{{points.entries}}" wx:key="id" class="ledger-row"><view class="ledger-icon"><image class="ledger-icon__image" src="/assets/icons/receipt-plum.svg" mode="aspectFit"/></view><view class="ledger-copy"><text class="ledger-copy__title">{{item.displayTitle}}</text><text class="ledger-copy__meta">{{item.displaySource}} · {{item.displayDate}}</text></view><text class="ledger-row__amount {{item.displayAmount[0] === '+' ? 'is-positive' : ''}}">{{item.displayAmount}}</text></view><view wx:if="{{!points.entries.length}}" class="ledger-empty"><text class="ledger-empty__title">还没有这类积分记录</text><text class="club-copy">以实际到账和使用情况为准。</text></view></view>
  <button wx:if="{{points.nextCursor}}" class="club-text club-load-more {{loadingMore || loading ? 'control--disabled' : ''}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore || loading}}">{{moreError ? '重新加载更多' : '加载更多记录'}}</button><text wx:if="{{moreError}}" class="club-error">{{moreError}}</text>
 </block>
 <block wx:elif="{{section === 'gifts'}}">
  <view wx:if="{{recoveryPending}}" class="club-notice"><text>上一笔礼品兑换结果尚待确认，请先核对。</text><view class="club-actions"><button class="club-text {{busy ? 'control--disabled' : ''}}" data-action="inspect" bindtap="recoverGift" disabled="{{busy}}">核对原兑换</button><button wx:if="{{recoveryRetryable}}" class="club-text {{busy ? 'control--disabled' : ''}}" data-action="retry" bindtap="recoverGift" disabled="{{busy}}">重试原操作</button><button wx:if="{{recoveryKey}}" class="club-text {{busy ? 'control--disabled' : ''}}" data-action="abandon" bindtap="recoverGift" disabled="{{busy}}">取消未受理操作</button></view></view>
  <text class="club-copy">纯积分兑换，无需现金支付。数量、库存以确认时为准。</text><view class="club-gifts"><button wx:for="{{gifts}}" wx:key="skuId" class="club-gift {{busy || recoveryPending || !club.enabled || item.availableQuantity < 1 ? 'control--disabled' : ''}}" data-id="{{item.skuId}}" bindtap="chooseGift" disabled="{{busy || recoveryPending || !club.enabled || item.availableQuantity < 1}}"><image wx:if="{{item.image}}" class="club-gift-image" src="{{item.image}}" mode="aspectFit"/><text class="club-task-title">{{item.name}}</text><text class="club-copy">{{item.label}}</text><text class="club-gift-price">{{item.points}} 积分</text><text class="club-copy">{{item.stockLabel}}</text></button></view>
  <view wx:if="{{!gifts.length && !giftError && !loading}}" class="ledger-empty"><text class="club-title">好礼正在准备中</text><text class="club-copy">有可兑换礼品时会在这里展示。</text></view><view wx:if="{{giftError}}" class="club-error">{{giftError}}<button class="club-text" bindtap="load">重新加载礼品与记录</button></view>
  <view class="ledger-head"><text class="ledger-head__title">我的兑换</text></view><view wx:for="{{redemptions}}" wx:key="id" class="club-card"><view class="club-card-heading"><text class="club-task-title">{{item.item.name}} × {{item.quantity}}</text><text>{{item.stateLabel}}</text></view><text class="club-copy">使用 {{item.pointsCost}} 积分</text><text wx:if="{{item.trackingNumber}}" class="club-copy">{{item.carrierName}} · {{item.trackingNumber}}</text><view class="club-actions"><button wx:if="{{item.state === 'placed'}}" class="club-text {{busy ? 'control--disabled' : ''}}" data-id="{{item.id}}" data-action="cancel" bindtap="giftAction" disabled="{{busy}}">取消兑换</button><button wx:if="{{item.state === 'shipped'}}" class="club-text {{busy ? 'control--disabled' : ''}}" data-id="{{item.id}}" data-action="receive" bindtap="giftAction" disabled="{{busy}}">确认收货</button><button wx:if="{{item.state === 'shipped' || item.state === 'received'}}" class="club-text {{busy ? 'control--disabled' : ''}}" data-id="{{item.id}}" data-action="request_return" bindtap="giftAction" disabled="{{busy}}">申请退货</button><button wx:if="{{item.state === 'return_requested'}}" class="club-text" bindtap="openSupport">联系客服处理退货</button></view></view>
 </block>
 <view wx:if="{{error}}" class="state state--error" aria-live="assertive"><text>{{error}}</text><button class="club-text {{loading ? 'control--disabled' : ''}}" bindtap="load" disabled="{{loading}}">重新查询积分</button></view>
</view></view>
<view wx:if="{{rulesOpen || giftSelected !== null}}" class="club-modal" catchtouchmove="stopPropagation" aria-role="dialog" aria-modal="true" aria-label="{{rulesOpen ? '积分规则' : '确认礼品兑换'}}">
 <view class="club-modal-mask"/><view class="club-sheet {{giftSelected ? 'club-sheet--gift' : ''}}"><view class="club-sheet-head"><text class="club-title">{{rulesOpen ? '积分规则' : '确认礼品兑换'}}</text><button class="club-close" wx:if="{{rulesOpen}}" bindtap="closeRules" aria-label="关闭积分规则">×</button><button class="club-close {{busy ? 'control--disabled' : ''}}" wx:else bindtap="closeGift" disabled="{{busy}}" aria-label="关闭兑换确认">×</button></view>
 <scroll-view class="club-sheet-scroll" scroll-y enhanced><view class="club-sheet-content">
  <block wx:if="{{rulesOpen}}"><view wx:for="{{upcomingRules}}" wx:key="version" wx:for-item="nextPolicy" class="club-notice"><text class="club-task-title">新规则公示 · {{nextPolicy.version}}</text><text class="club-copy">将于北京时间 {{nextPolicy.startsLabel}} 生效；历史批次按原权益处理。</text><view wx:for="{{nextPolicy.rows}}" wx:key="title" wx:for-item="rule"><text class="club-task-title">{{rule.title}}</text><text class="club-copy">{{rule.copy}}</text></view></view><text wx:if="{{!rulesRows.length}}" class="club-copy">新积分活动尚未生效。已获得积分按原有规则查询和处理。</text><view wx:for="{{rulesRows}}" wx:key="title" class="club-rule"><text class="club-task-title">{{item.title}}</text><text class="club-copy">{{item.copy}}</text></view></block>
  <block wx:else><text class="club-title">{{giftSelected.name}}</text><text class="club-copy">{{giftSelected.label}} · {{giftQuantity}} 份</text><text class="club-gift-price">使用 {{giftTotal}} 积分</text><text class="club-copy">确认后扣除积分。发货前可取消，积分按规则退回。</text><view class="club-actions club-stepper"><button class="club-text {{busy || giftQuantity === 1 ? 'control--disabled' : ''}}" data-delta="-1" bindtap="changeGiftQuantity" disabled="{{busy || giftQuantity === 1}}" aria-label="减少兑换数量">−</button><text class="club-stepper-value" aria-live="polite">{{giftQuantity}} 份</text><button class="club-text {{busy || giftQuantity >= 99 || giftQuantity >= giftSelected.availableQuantity ? 'control--disabled' : ''}}" data-delta="1" bindtap="changeGiftQuantity" disabled="{{busy || giftQuantity >= 99 || giftQuantity >= giftSelected.availableQuantity}}" aria-label="增加兑换数量">＋</button></view><text class="club-task-title">收货地址</text><button wx:for="{{addresses}}" wx:key="id" class="club-address {{selectedAddressId === item.id ? 'is-current' : ''}} {{busy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="chooseAddress" aria-role="radio" aria-checked="{{selectedAddressId === item.id}}" disabled="{{busy}}"><text>{{item.recipientName}} · {{item.phone}}</text><text>{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text></button><text wx:if="{{addressesState === 'loading'}}" class="club-copy">正在核对收货地址…</text><view wx:if="{{addressError}}" class="club-error">{{addressError}}<button class="club-text" bindtap="load">重新核对地址</button></view><button wx:if="{{!addresses.length && addressesState === 'ready'}}" class="club-text" bindtap="openAddresses">先添加收货地址</button></block>
  <text wx:if="{{actionError}}" class="club-error" aria-live="assertive">{{actionError}}</text>
 </view></scroll-view><view wx:if="{{giftSelected}}" class="club-sheet-footer"><button class="club-primary {{busy || !selectedAddressId || addressesState !== 'ready' ? 'control--disabled' : ''}}" bindtap="redeemGift" loading="{{busy}}" disabled="{{busy || !selectedAddressId || addressesState !== 'ready'}}">确认使用 {{giftTotal}} 积分兑换</button></view></view>
</view>
</view>
