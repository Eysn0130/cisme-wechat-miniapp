<view class="management-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">CISME 管理中心</text></view><view class="page page--stack management-page">
 <view class="page-title">今天需要处理什么？</view><text class="subtitle">按职责查看和处理待办。</text>
 <view wx:if="{{loading}}" class="state">正在核验管理权限…</view><view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="retry">重试</button></view>
 <view wx:if="{{hasFinanceCapability}}" class="state" aria-live="polite"><text>{{runtimeCopy}}</text><button wx:if="{{runtimeState==='error'}}" class="text-button {{navigating?'text-button--disabled':''}}" bindtap="retryRuntime" disabled="{{navigating}}">重试</button></view><view wx:if="{{authority && attention}}" class="management-attention" aria-live="polite">
  <text class="management-attention__title">待办摘要</text>
  <button wx:if="{{canSupport && attention.support && attention.support.count}}" plain="true" class="management-attention__row {{navigating?'control--disabled':''}}" bindtap="openSupport" disabled="{{navigating}}">客服待接管或未读 {{attention.support.count}} · 进入处理</button>
  <button wx:if="{{canAftersale && attention.newAftersales && attention.newAftersales.count}}" plain="true" class="management-attention__row {{navigating?'control--disabled':''}}" data-attention="requested" bindtap="openAftersale" disabled="{{navigating}}">售后待受理 {{attention.newAftersales.count}}</button>
  <button wx:if="{{canAftersale && attention.returnInstructions && attention.returnInstructions.count}}" plain="true" class="management-attention__row {{navigating?'control--disabled':''}}" data-attention="instruction" bindtap="openAftersale" disabled="{{navigating}}">退货指引待发送 {{attention.returnInstructions.count}}</button>
  <button wx:if="{{canAftersale && attention.oldRouteShipments && attention.oldRouteShipments.count}}" plain="true" class="management-attention__row {{navigating?'control--disabled':''}}" data-attention="old_route" bindtap="openAftersale" disabled="{{navigating}}">旧地址寄件待协助 {{attention.oldRouteShipments.count}}</button>
  <button wx:if="{{attention.returnsToReceive && attention.returnsToReceive.count}}" plain="true" class="management-attention__row {{navigating?'control--disabled':''}}" data-attention="receiving" bindtap="openAftersale" disabled="{{navigating}}">退货待收件 {{attention.returnsToReceive.count}}</button>
  <button wx:if="{{attention.returnsToInspect && attention.returnsToInspect.count}}" plain="true" class="management-attention__row {{navigating?'control--disabled':''}}" data-attention="inspection" bindtap="openAftersale" disabled="{{navigating}}">退货待质检 {{attention.returnsToInspect.count}}</button>
  <button wx:if="{{canFinance && attention.pendingRefunds && attention.pendingRefunds.count}}" plain="true" class="management-attention__row {{navigating?'control--disabled':''}}" bindtap="openFinance" disabled="{{navigating}}">退款待审批 {{attention.pendingRefunds.count}} · 进入处理</button>
  <button wx:if="{{canPrivacy && attention.privacyRequests && attention.privacyRequests.count}}" plain="true" class="management-attention__row {{navigating?'control--disabled':''}}" bindtap="openPrivacy" disabled="{{navigating}}">隐私请求待处理 {{attention.privacyRequests.count}}<text wx:if="{{attention.privacyOverdue && attention.privacyOverdue.count}}"> · 其中已到期 {{attention.privacyOverdue.count}}</text> · 进入处理</button>
  <text wx:if="{{!attentionHasItems}}">当前没有需要处理的新提醒</text>
 </view><view wx:if="{{authority && attentionError}}" class="state">待办摘要暂不可用，请进入对应工作台核对。</view><view wx:if="{{authority}}" class="management-grid"><button wx:if="{{canSupport}}" class="management-card {{navigating ? 'control--disabled' : ''}}" bindtap="openSupport" disabled="{{navigating}}"><view class="management-card__icon"><image src="/assets/icons/chat-circle-plum.svg"/></view><strong>客服工作台</strong><text>等待人工、未读和最近会话</text><view class="management-card__cta">进入处理</view></button><button wx:if="{{canCatalog}}" class="management-card {{navigating ? 'control--disabled' : ''}}" bindtap="openCatalog" disabled="{{navigating}}"><view class="management-card__icon"><image src="/assets/icons/storefront-plum.svg"/></view><strong>商品管理</strong><text>商品、资质、上架与库存分开确认</text><view class="management-card__cta">进入维护</view></button><button wx:if="{{canOrders}}" class="management-card {{navigating ? 'control--disabled' : ''}}" bindtap="openOrders" disabled="{{navigating}}"><view class="management-card__icon"><image src="/assets/icons/receipt-plum.svg"/></view><strong>订单管理</strong><text>核对待付、已付、取消与超时订单</text><view class="management-card__cta">进入查看</view></button><button wx:if="{{canFulfillment}}" class="management-card {{navigating ? 'control--disabled' : ''}}" bindtap="openFulfillment" disabled="{{navigating}}"><view class="management-card__icon"><image src="/assets/icons/receipt-plum.svg"/></view><strong>发货与履约</strong><text>筛选、拣货导出与物流批量登记</text><view class="management-card__cta">进入处理</view></button><button wx:if="{{canAftersale}}" class="management-card {{navigating?'control--disabled':''}}" bindtap="openAftersale" disabled="{{navigating}}"><view class="management-card__icon"><image src="/assets/icons/receipt-plum.svg"/></view><strong>售后管理</strong><text>受理、退货收件、质检与退款关联</text><view class="management-card__cta">进入处理</view></button><button wx:if="{{canMembers}}" class="management-card {{navigating ? 'control--disabled' : ''}}" bindtap="openMembers" disabled="{{navigating}}"><view class="management-card__icon"><image src="/assets/icons/user-circle-plum.svg"/></view><strong>会员管理</strong><text>成员资格、直接推荐与费率</text><view class="management-card__cta">进入查看</view></button><button wx:if="{{canPrivacy}}" class="management-card {{navigating ? 'control--disabled' : ''}}" bindtap="openPrivacy" disabled="{{navigating}}"><view class="management-card__icon"><image src="/assets/icons/shield-check-plum.svg"/></view><strong>隐私请求受理</strong><text>核验用户请求、处理状态与回复</text><view class="management-card__cta">进入受理</view></button><button wx:if="{{canFinance}}" class="management-card {{navigating ? 'control--disabled' : ''}}" bindtap="openFinance" disabled="{{navigating}}"><view class="management-card__icon"><image src="/assets/icons/receipt-plum.svg"/></view><strong>{{runtimeMode==='formal'?'资金核对':'资金核对 · 隔离测试'}}</strong><text>履约、退款、结算与异常查单</text><view class="management-card__cta">进入处理</view></button></view>
 <view wx:if="{{authority && !canSupport && !canCatalog && !canOrders && !canFulfillment && !canAftersale && !canMembers && !canPrivacy && !canFinance}}" class="state">当前能力已生效，但对应的移动管理入口尚未开放。</view>
 <view wx:if="{{authority}}" class="management-note"><image src="/assets/icons/shield-check-plum.svg"/><text>回复、接管和成员信息查看分别核验操作权限；每次提交仍由服务端确认。</text></view>
</view></view>
