<view class="management-shell management-ui" style="{{chromeStyle}}">
<view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">管理中心</text></view>
<view class="page page--stack management-page">
<view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在核验管理权限"><view class="page-read-loading__indicator"/></view>
<view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="retry">重试</button></view>
<block wx:if="{{authority}}">
<view class="management-section-heading"><text>待办</text><text class="management-section-hint">按当前权限显示</text></view>
<view wx:if="{{attention}}" class="management-attention">
<button wx:if="{{canSupport && attention.support.count}}" class="management-attention__row {{navigating ? 'control--disabled' : ''}}" bindtap="openSupport" data-attention="" disabled="{{navigating}}" hover-class="management-pressed"><view><text>客服待接待 / 未读</text></view><text class="management-attention__count">{{attention.support.count}}</text><image src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canAftersale && attention.newAftersales.count}}" class="management-attention__row {{navigating ? 'control--disabled' : ''}}" bindtap="openAftersale" data-attention="requested" disabled="{{navigating}}" hover-class="management-pressed"><view><text>新售后</text></view><text class="management-attention__count">{{attention.newAftersales.count}}</text><image src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canAftersale && attention.returnInstructions.count}}" class="management-attention__row {{navigating ? 'control--disabled' : ''}}" bindtap="openAftersale" data-attention="instruction" disabled="{{navigating}}" hover-class="management-pressed"><view><text>待发送退货指引</text></view><text class="management-attention__count">{{attention.returnInstructions.count}}</text><image src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canAftersale && attention.oldRouteShipments.count}}" class="management-attention__row {{navigating ? 'control--disabled' : ''}}" bindtap="openAftersale" data-attention="old_route" disabled="{{navigating}}" hover-class="management-pressed"><view><text>旧地址寄件待协助</text></view><text class="management-attention__count">{{attention.oldRouteShipments.count}}</text><image src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canAftersale && attention.returnsToReceive.count}}" class="management-attention__row {{navigating ? 'control--disabled' : ''}}" bindtap="openAftersale" data-attention="receiving" disabled="{{navigating}}" hover-class="management-pressed"><view><text>退货待收件</text></view><text class="management-attention__count">{{attention.returnsToReceive.count}}</text><image src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canAftersale && attention.returnsToInspect.count}}" class="management-attention__row {{navigating ? 'control--disabled' : ''}}" bindtap="openAftersale" data-attention="inspection" disabled="{{navigating}}" hover-class="management-pressed"><view><text>退货待质检</text></view><text class="management-attention__count">{{attention.returnsToInspect.count}}</text><image src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canFinance && attention.pendingRefunds.count}}" class="management-attention__row {{navigating ? 'control--disabled' : ''}}" bindtap="openFinance" data-attention="" disabled="{{navigating}}" hover-class="management-pressed"><view><text>退款待审批</text></view><text class="management-attention__count">{{attention.pendingRefunds.count}}</text><image src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canPrivacy && attention.privacyRequests.count}}" class="management-attention__row {{navigating ? 'control--disabled' : ''}}" bindtap="openPrivacy" data-attention="" disabled="{{navigating}}" hover-class="management-pressed"><view><text>隐私请求</text><text wx:if="{{attention.privacyOverdue.count}}" class="management-overdue">{{attention.privacyOverdue.count}} 项已到期</text></view><text class="management-attention__count">{{attention.privacyRequests.count}}</text><image src="/assets/icons/caret-right-muted.svg"/></button>
<text wx:if="{{!attentionHasItems}}" class="management-empty">暂无待办</text></view>
<view wx:elif="{{attentionError}}" class="management-inline-state">待办暂未更新，可进入各工作台查看。<button class="text-button" bindtap="retry">刷新</button></view>
<view wx:else class="management-inline-state" aria-role="status">正在读取待办…</view>
<block wx:if="{{canCatalog || canOrders || canFulfillment || canAftersale || canFinance}}"><view class="management-section-heading"><text>交易与履约</text></view><view class="management-group">
<button wx:if="{{canCatalog}}" class="management-row {{navigating ? 'control--disabled' : ''}}" bindtap="openCatalog" disabled="{{navigating}}" hover-class="management-pressed"><image class="management-row__icon" src="/assets/icons/storefront-plum.svg"/><text>商品与库存</text><image class="management-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canOrders}}" class="management-row {{navigating ? 'control--disabled' : ''}}" bindtap="openOrders" disabled="{{navigating}}" hover-class="management-pressed"><image class="management-row__icon" src="/assets/icons/receipt-plum.svg"/><text>订单管理</text><image class="management-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canFulfillment}}" class="management-row {{navigating ? 'control--disabled' : ''}}" bindtap="openFulfillment" disabled="{{navigating}}" hover-class="management-pressed"><image class="management-row__icon" src="/assets/icons/receipt-plum.svg"/><text>发货与履约</text><image class="management-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canAftersale}}" class="management-row {{navigating ? 'control--disabled' : ''}}" bindtap="openAftersale" disabled="{{navigating}}" hover-class="management-pressed"><image class="management-row__icon" src="/assets/icons/receipt-plum.svg"/><text>售后管理</text><image class="management-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canFinance}}" class="management-row {{navigating ? 'control--disabled' : ''}}" bindtap="openFinance" disabled="{{navigating}}" hover-class="management-pressed"><image class="management-row__icon" src="/assets/icons/receipt-plum.svg"/><text>资金核对<text wx:if="{{runtimeMode!=='formal'}}" class="management-section-hint"> · 隔离测试</text></text><image class="management-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
</view></block>
<block wx:if="{{canMembers || canPoints || canRewards}}"><view class="management-section-heading"><text>会员与积分</text></view><view class="management-group">
<button wx:if="{{canMembers}}" class="management-row {{navigating ? 'control--disabled' : ''}}" bindtap="openMembers" disabled="{{navigating}}" hover-class="management-pressed"><image class="management-row__icon" src="/assets/icons/user-circle-plum.svg"/><text>会员管理</text><image class="management-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canRewards}}" class="management-row {{navigating ? 'control--disabled' : ''}}" bindtap="openRewards" disabled="{{navigating}}" hover-class="management-pressed"><image class="management-row__icon" src="/assets/icons/gift-plum.svg"/><text>活动奖励</text><image class="management-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canPoints}}" class="management-row {{navigating ? 'control--disabled' : ''}}" bindtap="openPoints" disabled="{{navigating}}" hover-class="management-pressed"><image class="management-row__icon" src="/assets/icons/receipt-plum.svg"/><text>积分管理</text><image class="management-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
</view></block>
<block wx:if="{{canSupport || canEditorialComments || canPrivacy}}"><view class="management-section-heading"><text>服务与内容</text></view><view class="management-group">
<button wx:if="{{canSupport}}" class="management-row {{navigating ? 'control--disabled' : ''}}" bindtap="openSupport" disabled="{{navigating}}" hover-class="management-pressed"><image class="management-row__icon" src="/assets/icons/chat-circle-plum.svg"/><text>客服工作台</text><image class="management-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canEditorialComments}}" class="management-row {{navigating ? 'control--disabled' : ''}}" bindtap="openEditorialComments" disabled="{{navigating}}" hover-class="management-pressed"><image class="management-row__icon" src="/assets/icons/chat-circle-plum.svg"/><text>精选评论</text><image class="management-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
<button wx:if="{{canPrivacy}}" class="management-row {{navigating ? 'control--disabled' : ''}}" bindtap="openPrivacy" disabled="{{navigating}}" hover-class="management-pressed"><image class="management-row__icon" src="/assets/icons/shield-check-plum.svg"/><text>隐私请求</text><image class="management-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
</view></block>
<view wx:if="{{hasFinanceCapability && !canFinance}}" class="management-inline-state" aria-live="polite"><text>{{runtimeState==='loading'?'正在连接资金服务…':runtimeCopy}}</text><button wx:if="{{runtimeState==='error'}}" class="text-button" bindtap="retryRuntime">重试</button></view>
<view wx:if="{{!canSupport && !canCatalog && !canOrders && !canFulfillment && !canAftersale && !canMembers && !canPrivacy && !canEditorialComments && !canFinance && !canPoints}}" class="state">暂无可用的管理入口。</view>
</block></view></view>
