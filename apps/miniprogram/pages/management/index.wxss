@import "../../styles/read-loading.wxss";
@import "../../styles/management-workbench.wxss";
.management-shell{min-height:100vh}.management-page{background:#f7f3f8}
.management-section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin:34rpx 10rpx 14rpx;font-size:28rpx;font-weight:600;color:var(--cisme-ink)}
.management-section-heading:first-child{margin-top:8rpx}.management-section-hint{color:var(--cisme-muted);font-size:12px;font-weight:400}
.management-attention,.management-group{overflow:hidden;border-radius:24rpx;background:#fff}
.management-attention__row,.management-row{display:flex;align-items:center;gap:18rpx;width:100%;min-height:56px;margin:0;padding:18rpx 24rpx;border:0;border-radius:0;background:transparent;color:var(--cisme-ink);font-size:15px;line-height:1.5;text-align:left;white-space:normal}
.management-attention__row+.management-attention__row,.management-row+.management-row{border-top:1rpx solid var(--cisme-line)}
.management-attention__row>view,.management-row>text{flex:1;min-width:0}.management-attention__row image,.management-row__caret{flex:none;width:20rpx;height:24rpx;opacity:.7}
.management-attention__count{flex:none;color:var(--cisme-plum);font-size:20px;font-weight:500;font-variant-numeric:tabular-nums}
.management-row__icon{flex:none;width:36rpx;height:36rpx;opacity:.85}.management-overdue{display:block;margin-top:4rpx;color:var(--cisme-danger);font-size:12px}
.management-inline-state{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:18rpx 10rpx;color:var(--cisme-muted);font-size:12px;line-height:1.6}
.management-empty{display:block;padding:36rpx 24rpx;color:var(--cisme-muted);font-size:14px}.management-pressed{background:#f2ecf5;opacity:.85}
