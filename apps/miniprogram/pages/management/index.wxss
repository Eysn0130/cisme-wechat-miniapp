.management-shell{min-height:100vh}.management-page{background:radial-gradient(circle at 90% 4%,rgba(211,191,224,.48),transparent 28%),#f7f2f8}.management-grid{display:grid;gap:20rpx;margin-top:34rpx}.management-card{display:flex;align-items:flex-start;flex-direction:column;width:100%;min-height:260rpx;padding:30rpx;border:1rpx solid rgba(84,56,96,.08);border-radius:32rpx;color:#3c3041;background:rgba(255,255,255,.84);box-shadow:0 14rpx 40rpx rgba(54,35,65,.08);text-align:left}.management-card__icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border-radius:22rpx;background:#eee4f2}.management-card__icon image{width:38rpx;height:38rpx}.management-card strong{margin-top:22rpx;font-size:32rpx;font-weight:500}.management-card text{margin-top:8rpx;color:#817788;font-size:24rpx}.management-card__cta{margin-top:24rpx;color:#56306f;font-size:24rpx}.management-note{display:flex;gap:14rpx;margin-top:26rpx;padding:22rpx;border-radius:24rpx;color:#746a78;background:#ece5ef;font-size:23rpx;line-height:1.55}.management-note image{flex:none;width:30rpx;height:30rpx}
.management-attention{display:flex;flex-direction:column;gap:12rpx;margin-top:24rpx;padding:24rpx 28rpx;border:1rpx solid rgba(84,56,96,.1);border-radius:24rpx;background:#fff;color:#584360;font-size:25rpx;line-height:1.55}.management-attention__title{color:#3c3041;font-size:28rpx;font-weight:600}
.management-attention__row{width:100%;min-height:76rpx;margin:0;padding:14rpx 18rpx;border:0;border-radius:16rpx;background:#f5eff7;color:#4b3454;font-size:25rpx;line-height:1.5;text-align:left}
