@import "../../styles/section-tabs-layout.wxss";
@import '../../styles/action-hierarchy.wxss';
@import '../../styles/read-loading.wxss';
.rewards-page{padding-bottom:calc(env(safe-area-inset-bottom) + 142px);background:linear-gradient(160deg,#f1eaf5 0%,#faf7fb 54%,#f7f2f9 100%)}
.reward-body{max-width:500px;margin:0 auto}.reward-loading{position:fixed;z-index:50;top:var(--cisme-stack-top);right:26rpx;display:flex;align-items:center;gap:10rpx;padding:10rpx 18rpx;border-radius:99rpx;color:var(--cisme-muted);background:#faf6fd;font-size:12px}.reward-loading .read-loading__spinner{width:15px;height:15px}
.reward-error{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:20rpx 0;color:var(--cisme-danger);line-height:1.6}.reward-recovery{padding:24rpx;background:#fff9ff;border-radius:24rpx}.reward-recovery .primary{margin-top:16rpx}
.reward-ticket{position:relative;overflow:hidden;padding:38rpx 36rpx 24rpx;border-radius:28rpx;background:radial-gradient(ellipse at 95% 0%,#d1bfdf,transparent 68%),linear-gradient(130deg,#fdfaff,#eee3f4);box-shadow:0 12rpx 34rpx #4d2d6110;margin-bottom:28rpx;color:var(--cisme-ink-deep)}
.reward-ticket:before,.reward-ticket:after{content:'';position:absolute;bottom:94rpx;width:26rpx;height:26rpx;border-radius:100%;background:#f6eff9}.reward-ticket:before{left:-13rpx}.reward-ticket:after{right:-13rpx}.reward-ticket__brand{display:flex;justify-content:space-between;align-items:center;font-family:Georgia,serif;letter-spacing:5rpx;font-size:24rpx}.reward-ticket__brand text{font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;letter-spacing:0;font-size:12px}.reward-ticket__title{display:block;margin-top:38rpx;font-size:31px;font-family:'Songti SC',serif;line-height:1.3}.reward-ticket__choice{display:block;margin:18rpx 0 32rpx;color:#705b7c;font-size:14px}.reward-ticket__foot{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding-top:22rpx;border-top:1rpx dashed #ac92be66}.reward-ticket__foot text{font-size:12px;color:var(--cisme-muted)}.reward-ticket__cta{display:flex;align-items:center;gap:16rpx;min-height:44px;padding:12rpx 0 12rpx 18rpx;background:transparent;color:var(--cisme-plum);font-size:16px;font-weight:600}.reward-ticket__cta text{font-size:26px}.reward-ticket--quiet{box-shadow:none;background:#eee8f1;color:#786981}
.reward-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;min-height:380rpx;text-align:center;color:var(--cisme-muted)}.reward-empty image{width:76rpx;height:76rpx;opacity:.7}.reward-empty .reward-strong{font-weight:500;color:var(--cisme-ink);font-size:17px}.reward-empty text{max-width:290px;font-size:14px;line-height:1.7}.reward-section-title{margin:44rpx 0 18rpx;font-size:16px;font-weight:600}.reward-record{display:flex;align-items:center;gap:20rpx;width:100%;padding:20rpx 0;background:none;text-align:left}.reward-record image{width:112rpx;height:88rpx;border-radius:14rpx;flex-shrink:0}.reward-record view{display:flex;flex:1;flex-direction:column;gap:12rpx;min-width:0}.reward-record .reward-strong{font-weight:500}.reward-record view text{font-size:12px;color:var(--cisme-muted)}.reward-record__caret{color:var(--cisme-muted);font-size:24px}
.purchase-ticket{position:relative;display:flex;align-items:center;gap:24rpx;overflow:hidden;min-height:188rpx;margin:24rpx 0;padding:28rpx 26rpx;border-radius:24rpx;background:radial-gradient(ellipse at 12% 100%,#ddd0eb,transparent 74%),#fdfaff;box-shadow:0 8rpx 30rpx #5132620c}.purchase-ticket__value{display:flex;align-items:baseline;gap:5rpx;flex-shrink:0;color:var(--cisme-plum);white-space:nowrap}.purchase-ticket__currency{font-size:20px}.purchase-ticket__amount{font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:56px;line-height:1;font-weight:500;letter-spacing:-2rpx;font-variant-numeric:lining-nums tabular-nums}.purchase-ticket__copy{display:flex;flex:1;flex-direction:column;gap:12rpx;min-width:0}.purchase-ticket__copy .reward-strong{font-size:15px;line-height:1.4;font-weight:600}.purchase-ticket__copy text,.purchase-ticket__copy .reward-small{font-size:12px;color:var(--cisme-muted);line-height:1.5}.purchase-ticket__state{font-size:12px;color:var(--cisme-muted)}.purchase-ticket--quiet{opacity:.7;box-shadow:none}.reward-footnote{text-align:center;color:var(--cisme-muted);font-size:12px}
.reward-intro{margin:18rpx 0 36rpx}.reward-intro__brand{font-family:Georgia,serif;letter-spacing:6rpx;color:var(--cisme-plum);font-size:13px}.reward-intro .reward-strong{display:block;margin:22rpx 0 16rpx;font-family:'Songti SC',serif;font-weight:500;font-size:27px;line-height:1.35}.reward-intro__subtitle{color:var(--cisme-muted);font-size:14px}
.reward-choice-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.reward-choice{display:block;min-width:0;padding:0 0 24rpx;background:#fdfbff;text-align:left;border-radius:24rpx;overflow:hidden;box-shadow:0 10rpx 28rpx #4e2f5b08;transition:transform 120ms ease,background 180ms ease}.reward-choice--selected{background:#e4d5ee;box-shadow:0 10rpx 24rpx #6e3d8516}.reward-choice--pressed{transform:scale(.985)}.reward-choice--disabled{opacity:.58;box-shadow:none}.reward-choice__image{width:100%;height:246rpx;background:#e9dfed}.reward-choice__name{display:flex;align-items:center;justify-content:space-between;gap:6rpx;padding:22rpx 18rpx 0}.reward-choice__name .reward-strong{font-size:14px;font-weight:600;line-height:1.5}.reward-choice__check{flex-shrink:0;color:var(--cisme-plum);font-size:17px}.reward-choice__spec{display:flex;flex-direction:column;gap:8rpx;padding:14rpx 18rpx 0;font-size:12px;color:var(--cisme-muted)}.reward-choice__meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6rpx;padding:18rpx 18rpx 0;color:var(--cisme-plum);font-size:11px}
.reward-inline-actions{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12rpx;margin:14rpx 0 24rpx}.reward-inline-actions .action-text{padding-left:0;padding-right:0}.reward-address{padding:24rpx 0;border-bottom:1rpx solid var(--cisme-line)}.reward-section-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.reward-section-head .reward-strong{font-size:16px;font-weight:600;line-height:1.5}.reward-section-head .action-text{padding-right:0}.reward-address__selected{display:flex;align-items:center;gap:22rpx;min-height:68px;padding:8rpx 0}.reward-address__selected view{flex:1;display:flex;flex-direction:column;gap:12rpx;min-width:0}.reward-address__selected .reward-strong{font-size:14px;font-weight:500;line-height:1.5}.reward-address__selected text{font-size:13px;line-height:1.6;color:var(--cisme-muted);word-break:break-all}.reward-address__empty{display:flex;width:100%;justify-content:space-between;align-items:center;padding:20rpx 0;background:none;color:var(--cisme-plum);text-align:left}.reward-cost{display:flex;align-items:center;justify-content:space-between;margin:30rpx 0 20rpx}.reward-cost .reward-strong{font-size:22px;font-weight:600;font-variant-numeric:tabular-nums}.reward-delivery{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10rpx;color:var(--cisme-muted);font-size:12px;line-height:1.6}
.reward-footer{position:fixed;z-index:35;bottom:0;left:0;right:0;padding:24rpx 34rpx calc(env(safe-area-inset-bottom) + 20rpx);background:linear-gradient(180deg,#faf7fb88,#faf7fb 30%)}.reward-footer .primary{max-width:500px;margin:0 auto}.reward-footer .primary--disabled{background:#ded3e5;color:#796881;box-shadow:none}
.reward-order-status{padding:34rpx 8rpx 44rpx}.reward-order-status text{font-size:11px;letter-spacing:1rpx;color:var(--cisme-muted);word-break:break-all}.reward-order-status .reward-strong{display:block;font-family:'Songti SC',serif;font-size:32px;font-weight:500;margin:26rpx 0 18rpx}.reward-order-status .reward-small{font-size:14px;color:var(--cisme-muted)}.reward-order-item{display:flex;align-items:center;gap:24rpx;padding:24rpx 0;border-bottom:1rpx solid var(--cisme-line)}.reward-order-item image{width:220rpx;height:170rpx;border-radius:18rpx;flex-shrink:0}.reward-order-item view{display:flex;flex-direction:column;gap:13rpx;min-width:0}.reward-order-item .reward-strong{font-size:16px;font-weight:600;line-height:1.5}.reward-order-item text{font-size:12px;color:var(--cisme-muted);line-height:1.5}.reward-order-info{display:flex;flex-direction:column;gap:16rpx;padding:30rpx 0;border-bottom:1rpx solid var(--cisme-line);word-break:break-all}.reward-order-info .reward-strong{font-weight:500;line-height:1.5}.reward-order-info text{font-size:13px;line-height:1.7;color:var(--cisme-muted)}.reward-order-info--row{flex-direction:row;justify-content:space-between;gap:18rpx}
.reward-mask{position:fixed;z-index:100;inset:0;display:flex;align-items:flex-end;background:#2c1a3e66}.reward-sheet{display:flex;flex-direction:column;gap:20rpx;width:100%;max-height:82vh;overflow:auto;padding:30rpx 34rpx calc(env(safe-area-inset-bottom) + 30rpx);border-radius:32rpx 32rpx 0 0;background:#fdfaff;animation:reward-sheet-in 220ms cubic-bezier(.2,.7,.2,1)}.reward-sheet text{font-size:14px;line-height:1.7;color:var(--cisme-muted)}.reward-sheet textarea{width:100%;min-height:160rpx;padding:24rpx;border-radius:18rpx;background:#f2edf6;font-size:16px;line-height:1.6}.reward-sheet .primary{margin-top:10rpx}
.purchase-ticket--arrive{animation:reward-coupon-arrive 280ms cubic-bezier(.2,.7,.2,1)}
@keyframes reward-sheet-in{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}@keyframes reward-coupon-arrive{from{opacity:0;transform:translateY(8px) scale(.985)}to{opacity:1;transform:translateY(0) scale(1)}}
.rewards-page--still .purchase-ticket--arrive,.rewards-page--still .reward-sheet{animation:none}.rewards-page--still .reward-choice{transition:none}.rewards-page--still .reward-choice--pressed{transform:none}
@media(max-width:374px){.reward-intro .reward-strong{font-size:24px}.reward-choice__image{height:214rpx}.reward-choice__name{padding-left:14rpx;padding-right:14rpx}.reward-choice__name .reward-strong{font-size:13px}.purchase-ticket{gap:16rpx;padding:24rpx 20rpx}.purchase-ticket__amount{font-size:48px}.purchase-ticket__copy .reward-strong{font-size:14px}.reward-ticket__title{font-size:28px}}
@media(prefers-reduced-motion:reduce){.purchase-ticket--arrive,.reward-sheet{animation:none}.reward-choice{transition:none}.reward-choice--pressed{transform:none}}

.reward-ticket__brand,.reward-ticket__title,.reward-ticket__choice,.reward-ticket__foot,.purchase-ticket__value,.purchase-ticket__copy,.purchase-ticket__state,.purchase-ticket>.action-text{position:relative;z-index:2}
