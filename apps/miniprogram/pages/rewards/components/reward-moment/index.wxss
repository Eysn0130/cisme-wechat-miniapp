.reward-moment{position:fixed;inset:0;z-index:1500;display:flex;align-items:center;justify-content:center;color:#3c234b;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;}
.reward-moment__shade{position:absolute;inset:0;background:rgba(38,22,48,.32);animation:moment-presence 180ms ease-out both;}
.reward-moment__card{position:relative;box-sizing:border-box;width:636rpx;max-width:calc(100% - 56rpx);max-height:calc(100% - 80rpx);padding:0;overflow:hidden;border-radius:28rpx;background:#fbf6ff;text-align:center;box-shadow:0 24px 70px rgba(55,28,72,.25);animation:moment-arrive 340ms cubic-bezier(.16,1,.3,1) both;}
.reward-moment__scroll{height:min(790rpx,calc(100vh - 80rpx));}.reward-moment__card--redeemed .reward-moment__scroll{height:min(890rpx,calc(100vh - 80rpx));}.reward-moment__content{position:relative;box-sizing:border-box;min-height:100%;padding:42rpx 34rpx 26rpx;overflow:hidden;}.reward-moment__light{position:absolute;inset:-25%;pointer-events:none;background:radial-gradient(ellipse at 20% 15%,rgba(207,228,228,.55),transparent 46%),radial-gradient(ellipse at 85% 65%,rgba(210,181,227,.5),transparent 52%);transform:translateX(8%);animation:moment-lustre 900ms ease-out both;}
.reward-moment__seal{position:relative;width:172rpx;height:172rpx;margin:0 auto 20rpx;perspective:650px;}.reward-moment__pearl{width:100%;height:100%;}.reward-moment--spinning .reward-moment__pearl{animation:moment-spin 680ms cubic-bezier(.15,.5,.2,1) both;}.reward-moment__check{position:absolute;left:60rpx;top:60rpx;width:52rpx;height:52rpx;animation:moment-check 180ms ease-out both;}
.reward-moment__title{position:relative;display:block;font-size:40rpx;font-weight:600;line-height:1.4;letter-spacing:.01em;}.reward-moment__copy{position:relative;display:block;margin-top:12rpx;font-size:26rpx;line-height:1.5;color:#6e527c;}
.reward-moment__choices{position:relative;display:flex;gap:12rpx;margin:30rpx 0;}.reward-moment__choices image{display:block;width:calc(50% - 6rpx);height:172rpx;border-radius:12rpx;}.reward-moment__product{position:relative;display:block;width:100%;height:250rpx;margin:22rpx auto 12rpx;border-radius:16rpx;}.reward-moment__name{position:relative;display:block;margin:8rpx 0 26rpx;font-size:28rpx;line-height:1.5;}
.reward-moment__primary,.reward-moment__later{position:relative;display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-height:92rpx;width:100%;margin:0;padding:18rpx 24rpx;font-size:30rpx;line-height:1.4;font-weight:600;border:0;}.reward-moment__primary{color:#fff;background:#56306f;border-radius:999rpx;}.reward-moment__later{min-height:88rpx;margin-top:6rpx;color:#6b4b7d;background:transparent;font-weight:400;}
.reward-moment__glints{position:absolute;top:112rpx;left:50%;width:0;height:0;}.reward-moment__glint{position:absolute;width:3rpx;height:12rpx;border-radius:3rpx;background:#a688b6;opacity:0;animation:moment-glint 680ms 620ms ease-out both;--moment-x:118rpx;--moment-y:-54rpx;}.reward-moment__glint--1{--moment-x:-120rpx;--moment-y:-48rpx;}.reward-moment__glint--2{--moment-x:128rpx;--moment-y:40rpx;background:#879c9f;}.reward-moment__glint--3{--moment-x:-126rpx;--moment-y:42rpx;background:#b398af;}
@keyframes moment-presence{from{opacity:0;}to{opacity:1;}}@keyframes moment-arrive{from{opacity:.55;transform:translateY(16rpx) scale(.97);}to{opacity:1;transform:translateY(0) scale(1);}}@keyframes moment-spin{0%{transform:rotateY(0) rotate(-8deg);}72%{transform:rotateY(690deg) rotate(2deg);}100%{transform:rotateY(720deg) rotate(0);}}@keyframes moment-check{from{opacity:0;transform:scale(.65);clip-path:inset(0 100% 0 0);}to{opacity:1;transform:scale(1);clip-path:inset(0);}}@keyframes moment-lustre{from{transform:translateX(-10%);opacity:.5;}to{transform:translateX(8%);opacity:1;}}@keyframes moment-glint{0%{opacity:0;transform:scale(.4);}22%{opacity:.8;}100%{opacity:0;transform:translate(var(--moment-x),var(--moment-y)) rotate(35deg);}}
.reward-moment--still .reward-moment__card,.reward-moment--still .reward-moment__shade,.reward-moment--still .reward-moment__light,.reward-moment--still .reward-moment__pearl,.reward-moment--still .reward-moment__check{animation:none;}.reward-moment--still .reward-moment__glints{display:none;}
@media(prefers-reduced-motion:reduce){.reward-moment__card,.reward-moment__shade,.reward-moment__light,.reward-moment__pearl,.reward-moment__check{animation:none;}.reward-moment__glints{display:none;}}
@media(max-height:680px){.reward-moment__content{padding-top:24rpx;}.reward-moment__seal{width:128rpx;height:128rpx;}.reward-moment__check{left:44rpx;top:44rpx;width:40rpx;height:40rpx;}.reward-moment__choices{margin:20rpx 0;}.reward-moment__choices image{height:140rpx;}}
