<page-meta root-font-size="system" page-style="{{surveyOpen||rulesOpen||returnOpen||productsOpen?'overflow:hidden;':''}}"/>
<view class="page page--stack rewards-page {{reducedMotion?'rewards-page--still':''}}" style="{{chromeStyle}}">
 <view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">{{mode==='wallet'?'我的奖励':mode==='select'?'领取旅行洗护':'领取订单'}}</text></view>
 <view class="reward-body" aria-hidden="{{surveyOpen||rulesOpen||returnOpen||productsOpen}}">
 <view wx:if="{{loading}}" class="reward-loading" aria-live="polite"><view class="page-read-loading__indicator"></view><text>正在更新</text></view>
 <view wx:if="{{error}}" class="reward-error" aria-live="assertive"><text>{{error}}</text><button class="action-text {{busy||loading?'control--disabled':''}}" bindtap="load" disabled="{{busy||loading}}">重试</button></view>
 <view wx:if="{{unknown}}" class="reward-recovery"><text class="reward-strong">核对上次操作</text><button wx:if="{{pending.kind==='claim'}}" class="primary {{busy?'primary--disabled':''}}" bindtap="retryPending" loading="{{busy}}" disabled="{{busy}}">重试领取</button><button class="action-text {{busy?'control--disabled':''}}" bindtap="cancelPending" disabled="{{busy}}">核对或取消待确认操作</button></view>
 <block wx:if="{{mode==='wallet'&&wallet}}">
  <view class="page-section-tabs"><section-tabs id="page-tabs" items="{{[{id:'rewards',label:'活动奖励'},{id:'coupons',label:'正装优惠'}]}}" value="{{tab}}" label="我的奖励" bindchange="changeTab" disabled="{{busy}}"/></view>
  <block wx:if="{{tab==='rewards'}}">
   <view wx:for="{{wallet.vouchers}}" wx:key="id" class="reward-ticket {{item.state!=='unused'?'reward-ticket--quiet':''}}" data-foil-surface="award" bindtouchstart="beginFoil" bindtouchmove="moveFoil" bindtouchend="endFoil" bindtouchcancel="endFoil"><card-foil id="award-foil-{{index}}" tone="award" reduced="{{reducedMotion}}" active="{{foilSurface==='award'}}" x="{{foilX}}" y="{{foilY}}" quiet="{{item.state!=='unused'}}"/>
    <view class="reward-ticket__brand">CISME<text>{{item.label}}</text></view><text class="reward-ticket__title">旅行洗护套</text><text class="reward-ticket__choice">净润 / 净屑 · 二选一</text>
    <view class="reward-ticket__foot"><text>有效至 {{item.date}}</text><button wx:if="{{item.state==='unused'}}" class="reward-ticket__cta {{busy||unknown||navigating?'control--disabled':''}}" data-id="{{item.id}}" bindtap="openVoucher" disabled="{{busy||unknown||navigating}}">立即领取<text>›</text></button><button wx:elif="{{item.claimId}}" class="action-text" data-id="{{item.claimId}}" bindtap="openClaim">查看订单</button><button wx:else class="action-text" bindtap="support">联系客服</button></view>
   </view>
   <view wx:if="{{!wallet.vouchers.length}}" class="reward-empty"><image src="/assets/icons/gift-plum.svg"/><text class="reward-strong">还没有活动奖励</text><button class="action-text" bindtap="support">咨询客服</button></view>
   <block wx:if="{{wallet.claims.length}}"><view class="reward-section-title">领取记录</view><button wx:for="{{wallet.claims}}" wx:key="id" class="reward-record" data-id="{{item.id}}" bindtap="openClaim"><image src="{{item.item.image}}" mode="aspectFill"/><view><text class="reward-strong">{{item.item.name}}</text><text>{{item.date}} · {{item.label}}</text></view><text class="reward-record__caret">›</text></button><button wx:if="{{wallet.claimsNextCursor}}" class="action-text {{busy?'control--disabled':''}}" bindtap="loadMoreClaims" disabled="{{busy}}">加载更多</button></block>
  </block>
  <block wx:else>
   <view wx:for="{{wallet.coupons}}" wx:key="id" class="purchase-ticket {{item.state!=='available'?'purchase-ticket--quiet':''}}" data-foil-surface="coupon" bindtouchstart="beginFoil" bindtouchmove="moveFoil" bindtouchend="endFoil" bindtouchcancel="endFoil"><card-foil id="coupon-foil-{{index}}" active="{{foilSurface==='coupon'}}" x="{{foilX}}" y="{{foilY}}" quiet="{{item.state!=='available'}}" reduced="{{reducedMotion}}"/><view class="purchase-ticket__value"><text class="purchase-ticket__currency">¥</text><text class="purchase-ticket__amount">20</text></view><view class="purchase-ticket__copy"><text class="reward-strong">体验专属正装券</text><text>满 ¥198 可用</text><text class="reward-small">有效至 {{item.date}}</text></view><button wx:if="{{item.state==='available'}}" class="action-text" data-id="{{item.id}}" bindtap="useCoupon">去选购</button><text wx:else class="purchase-ticket__state">{{item.label}}</text></view>

   <view wx:if="{{!wallet.coupons.length}}" class="reward-empty"><image src="/assets/icons/gift-plum.svg"/><text class="reward-strong">还没有优惠券</text><text wx:if="{{wallet.vouchers.length||wallet.claims.length}}">旅行套装收货后发放</text></view>
  </block>
 </block>
 <block wx:if="{{mode==='select'&&selection}}">
  <view class="reward-intro"><text class="reward-intro__brand">CISME</text><text class="reward-strong">选一套旅行洗护。</text></view>
  <view class="reward-choice-grid"><button wx:for="{{selection.bundles}}" wx:key="code" class="reward-choice {{selectedBundle===item.code?'reward-choice--selected':''}} {{!item.stockConfirmed||item.availableQuantity<1?'reward-choice--disabled':''}} {{busy||unknown||!item.stockConfirmed||item.availableQuantity<1||selection.voucher.state!=='unused'?'control--disabled':''}}" data-code="{{item.code}}" bindtap="chooseBundle" disabled="{{busy||unknown||!item.stockConfirmed||item.availableQuantity<1||selection.voucher.state!=='unused'}}" aria-label="{{item.name}}，{{item.shampooMl}}加{{item.conditionerMl}}毫升，{{!item.stockConfirmed?'库存待确认':item.availableQuantity<1?'暂时兑完':selectedBundle===item.code?'已选':'可选'}}" hover-class="reward-choice--pressed">
   <image class="reward-choice__image" src="{{item.image}}" mode="aspectFit"/><view class="reward-choice__name"><text class="reward-strong">{{item.name}}</text><text class="reward-choice__check">{{selectedBundle===item.code?'✓':'○'}}</text></view><view class="reward-choice__spec"><text>洗发水 {{item.shampooMl}}mL</text><text>护发乳 {{item.conditionerMl}}mL</text></view><view class="reward-choice__meta"><text>共 {{item.totalMl}}mL</text><text wx:if="{{!item.stockConfirmed}}">待入库</text><text wx:elif="{{item.availableQuantity<1}}">暂时兑完</text><text wx:elif="{{selection.survey.recommendation===item.code}}">问卷建议</text></view>
  </button></view>
  <view class="reward-inline-actions"><button class="action-text {{busy||unknown?'control--disabled':''}}" bindtap="editSurvey" disabled="{{busy||unknown}}">{{selection.survey.completed?'修改问卷':'填写问卷'}}</button><button class="action-text" bindtap="openRules">领取说明</button></view>
  <view wx:if="{{selection.bundles[0].availableQuantity<1&&selection.bundles[1].availableQuantity<1}}" class="reward-error"><text>暂时兑完，兑换券已保留</text><button class="action-text" bindtap="support">联系客服</button></view>
  <view class="reward-address"><view class="reward-section-head"><text class="reward-strong">收货地址</text><button class="action-text {{busy||unknown?'control--disabled':''}}" bindtap="editAddress" disabled="{{busy||unknown}}">{{selectedAddress?'管理':'添加地址'}}</button></view>
   <picker wx:if="{{addresses.length}}" mode="selector" range="{{addresses}}" range-key="recipientName" bindchange="changeAddress" disabled="{{busy||unknown}}"><view class="reward-address__selected"><view><text class="reward-strong">{{selectedAddress.recipientName}} · {{selectedAddress.phone}}</text><text>{{selectedAddress.province}}{{selectedAddress.city}}{{selectedAddress.district}} {{selectedAddress.detail}}</text></view><text>›</text></view></picker>
   <button wx:else class="reward-address__empty" bindtap="editAddress">添加收货地址<text>›</text></button>
  </view>
  <view class="reward-cost"><text>商品与运费</text><text class="reward-strong">¥0.00</text></view><view class="reward-delivery"><text>大陆包邮 · 72小时内发货</text><text>有效至 {{expiryLabel}}</text></view>
  <view wx:if="{{selection.voucher.state!=='unused'}}" class="reward-error"><text>{{selection.voucher.state==='used'?'这张券已领取':selection.voucher.state==='expired'?'这张券已过期':'这张券当前不可领取'}}</text><button wx:if="{{selection.voucher.claimId}}" class="action-text" bindtap="openSelectedClaim">查看订单</button><button wx:else class="action-text" bindtap="support">联系客服</button></view>
 </block>
 <block wx:if="{{mode==='claim'&&claim}}">
  <view class="reward-order-status"><text>{{claim.claimNumber}}</text><text class="reward-strong">{{stateLabel}}</text><text class="reward-small">{{claim.state==='placed'?'72小时内为你发出':claim.state==='shipped'?'洗护心意正在路上':claim.state==='received'?'谢谢你，认真照顾自己。':''}}</text></view>
  <view class="reward-order-item"><image src="{{claim.item.image}}" mode="aspectFit"/><view><text class="reward-strong">{{claim.item.name}}</text><text>{{claim.item.shampoo}} {{claim.item.shampooMl}}mL</text><text>{{claim.item.conditioner}} {{claim.item.conditionerMl}}mL</text></view></view>
  <view wx:if="{{claim.trackingNumber}}" class="reward-order-info"><view class="reward-section-head"><text class="reward-strong">{{claim.carrierName}}</text><button class="action-text" bindtap="copyTracking">复制单号</button></view><text>{{claim.trackingNumber}}</text></view>
  <view wx:if="{{claim.address}}" class="reward-order-info"><text class="reward-strong">{{claim.address.recipientName}} · {{claim.address.phone}}</text><text>{{claim.address.province}}{{claim.address.city}}{{claim.address.district}} {{claim.address.detail}}</text></view>
  <view class="reward-order-info reward-order-info--row"><text>领取日期 {{claimDate}}</text><text class="reward-strong">实付 ¥0.00</text></view>
  <view wx:if="{{claim.couponId}}" class="purchase-ticket {{newCoupon?'purchase-ticket--arrive':''}}" data-foil-surface="coupon" bindtouchstart="beginFoil" bindtouchmove="moveFoil" bindtouchend="endFoil" bindtouchcancel="endFoil"><card-foil id="receipt-foil" intro="{{newCoupon}}" active="{{foilSurface==='coupon'}}" x="{{foilX}}" y="{{foilY}}" reduced="{{reducedMotion}}"/><view class="purchase-ticket__value"><text class="purchase-ticket__currency">¥</text><text class="purchase-ticket__amount">20</text></view><view class="purchase-ticket__copy"><text class="reward-strong">体验正装券已到账</text><text>满 ¥198 可用 · 30天有效</text></view><button class="action-text" bindtap="openCoupons">查看</button></view>
  <view class="reward-inline-actions"><button wx:if="{{claim.state==='placed'}}" class="action-text {{busy?'control--disabled':''}}" bindtap="cancelClaim" disabled="{{busy}}">取消领取</button><button wx:if="{{claim.state==='placed'||claim.state==='shipped'||claim.state==='received'}}" class="action-text {{busy?'control--disabled':''}}" bindtap="openReturn" disabled="{{busy}}">售后服务</button><button class="action-text" bindtap="support">联系客服</button></view>
 </block>
 </view>
 <view wx:if="{{mode==='select'&&selection&&!surveyOpen}}" class="reward-footer"><button class="primary {{busy||loading||unknown||navigating||!selectedBundle||!selectedAddress||!selection.survey.completed||selection.voucher.state!=='unused'?'primary--disabled':''}}" bindtap="confirm" loading="{{busy}}" disabled="{{busy||loading||unknown||navigating||!selectedBundle||!selectedAddress||!selection.survey.completed||selection.voucher.state!=='unused'}}"><text class="action-label">{{busy?'正在领取':'确认领取'}}</text></button></view>
 <view wx:if="{{mode==='claim'&&claim.state==='shipped'}}" class="reward-footer"><button class="primary {{busy?'primary--disabled':''}}" bindtap="receive" loading="{{busy}}" disabled="{{busy}}"><text class="action-label">确认收货</text></button></view>
 <view wx:if="{{rulesOpen}}" class="reward-mask" bindtap="closeRules"><view class="reward-sheet" catchtap="stop" aria-role="dialog" aria-label="领取说明"><view class="reward-section-head"><text class="reward-strong">领取说明</text><button class="action-text" bindtap="closeRules">关闭</button></view><text>每位获奖会员一张券，可选一套旅行洗护。</text><text>净润：洗发水100mL＋护发乳100mL。</text><text>净屑：洗发水50mL＋同款护发乳100mL。</text><text>发券后30天可领，大陆包邮，72小时内发货。</text><text>缺货保留资格；取消时已过期的券恢复为已过期。</text><text>确认收货后获赠满198减20正装券，30天有效，不叠加其他优惠券。</text><button class="action-text" bindtap="support">联系客服</button></view></view>
 <view wx:if="{{returnOpen}}" class="reward-mask" bindtap="closeReturn"><view class="reward-sheet" catchtap="stop" aria-role="dialog" aria-label="申请售后"><view class="reward-section-head"><text class="reward-strong">需要什么帮助？</text><button class="action-text {{busy?'control--disabled':''}}" bindtap="closeReturn" disabled="{{busy}}">关闭</button></view><textarea value="{{returnReason}}" bindinput="editReturn" maxlength="500" placeholder="简单说说遇到的问题" aria-label="售后问题" disabled="{{busy}}"/><button class="primary {{busy||returnReason.length<3?'primary--disabled':''}}" bindtap="submitReturn" loading="{{busy}}" disabled="{{busy||returnReason.length<3}}">提交售后</button></view></view>
 <view wx:if="{{productsOpen}}" class="reward-mask" bindtap="closeProducts"><view class="reward-sheet" catchtap="stop" aria-role="dialog" aria-label="适用正装"><view class="reward-section-head"><text class="reward-strong">适用商品</text><button class="action-text" bindtap="closeProducts">关闭</button></view><button wx:for="{{couponProducts}}" wx:key="id" class="reward-record" data-code="{{item.code}}" bindtap="openCouponProduct"><image src="{{item.image}}" mode="aspectFill"/><view><text class="reward-strong">{{item.name}}</text><text>¥{{item.priceCents/100}}</text></view><text class="reward-record__caret">›</text></button><view wx:if="{{!couponProducts.length}}" class="reward-empty"><text>适用商品暂未上架</text><button class="action-text" bindtap="support">联系客服</button></view></view></view>
 <care-onboarding wx:if="{{surveyOpen}}" required="{{false}}" bindcomplete="completeSurvey" bindclose="closeSurvey"/>
</view>
