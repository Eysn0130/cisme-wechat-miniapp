.shop-page { padding-right:24rpx; padding-left:24rpx; background:linear-gradient(180deg,#f6f0f8,#fbf8fb); }.shop-topbar__copy { display:flex; align-items:center; flex-direction:column; }.shop-topbar__subtitle { margin-top:4rpx; color:#958a97; font-size:var(--cisme-text-small); line-height:1.5; }
.shop-hero { position:relative; width:100%; height:452rpx; padding:0; overflow:hidden; border:0; border-radius:58rpx; color:#fff; background:#3d3043; text-align:left; box-shadow:0 20rpx 40rpx rgba(50,31,64,.16); }.shop-hero__image { width:100%; height:100%; }.shop-hero__shade { position:absolute; top:0; right:0; bottom:0; left:0; background:linear-gradient(90deg,rgba(42,25,53,.16),rgba(42,25,53,.82)); }.shop-hero__copy { position:absolute; top:72rpx; right:31rpx; width:49%; }.shop-hero__eyebrow { color:rgba(255,255,255,.78); font:24rpx Georgia,serif; letter-spacing:4rpx; }.shop-hero__title { display:block; margin-top:20rpx; font-family:"Songti SC","STSong",serif; font-size:39rpx; font-weight:400; line-height:1.42; }.shop-hero__meta { display:block; margin-top:13rpx; color:rgba(255,255,255,.82); font-size:24rpx; }.shop-hero__cta { display:inline-flex; align-items:center; justify-content:center; min-width:176rpx; min-height:88rpx; margin-top:24rpx; border:1rpx solid rgba(255,255,255,.46); border-radius:999rpx; font-size:24rpx; }
.shop-catalog-label { display:flex; align-items:center; justify-content:space-between; margin-top:25rpx; color:#4d3f52; }.shop-catalog-label__title { font-family:"Songti SC","STSong",serif; font-size:29rpx; }.shop-catalog-label__meta { color:#8d828f; font-size:var(--cisme-text-small); line-height:1.5; }
.shop-gate { display:flex; align-items:flex-start; gap:11rpx; margin-top:17rpx; padding:17rpx 19rpx; border-radius:23rpx; color:#776c7b; background:rgba(235,225,239,.64); font-size:var(--cisme-text-small); line-height:1.5; }.shop-gate__icon { flex:0 0 auto; width:25rpx; height:25rpx; margin-top:1rpx; }
.product-grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx 15rpx; margin-top:20rpx; }.product-card { overflow:hidden; margin:0; padding:0; border:1rpx solid rgba(255,255,255,.88); border-radius:44rpx; background:rgba(255,252,255,.84); text-align:left; box-shadow:0 15rpx 31rpx rgba(56,38,68,.07); }.product-card__image { width:100%; height:265rpx; }.product-card__body { padding:20rpx 18rpx 22rpx; }.product-card__eyebrow,.product-card__title,.product-card__subtitle { display:block; }.product-card__eyebrow { color:#907f98; font-size:var(--cisme-text-small); line-height:1.5; }.product-card__title { margin-top:7rpx; color:#403344; font-family:"Songti SC","STSong",serif; font-size:26rpx; font-weight:500; line-height:1.4; }.product-card__subtitle { margin-top:6rpx; color:#8d828f; font-size:var(--cisme-text-small); line-height:1.5; }.product-card__price { margin-top:15rpx; color:#3d3044; font:26rpx Georgia,serif; }
