@import "../../styles/read-loading.wxss";
.shop-page{--shop-card-radius:28rpx;--shop-card-shadow:0 8rpx 24rpx rgba(61,37,79,.07);min-height:100vh;padding:0 28rpx calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 166rpx);background:#f7f4f8;color:#352a3a}
.shop-head{position:sticky;z-index:20;top:0;margin:0 -28rpx;padding:var(--cisme-status-bar,20px) 36rpx 0;background:rgba(247,244,248,.97);-webkit-backdrop-filter:blur(16px)}
.shop-title-row{display:flex;align-items:baseline;gap:16rpx;min-height:var(--cisme-navbar-height,44px);padding-top:12rpx;padding-right:var(--cisme-nav-side,112rpx)}
.shop-wordmark{color:#2f2149;font:54rpx Georgia,serif;letter-spacing:5rpx}.shop-title{color:#2f2149;font:34rpx "Songti SC","STSong",serif;white-space:nowrap}
.shop-utility{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:48px}.shop-brand{font:28rpx "Songti SC","STSong",serif;color:#6f5c7c}.shop-orders{display:flex;align-items:center;justify-content:flex-end;gap:12rpx;flex:none;min-height:44px;margin:0;padding:0;border:0;background:transparent;color:#5d486a;font-size:25rpx;line-height:1.5}.shop-orders image{width:36rpx;height:36rpx}
.shop-content{padding-top:12rpx}.shop-hero{position:relative;height:314rpx;margin-bottom:36rpx;overflow:hidden;border-radius:var(--shop-card-radius);background:#eee8f4;box-shadow:var(--shop-card-shadow)}.shop-hero__swiper,.shop-hero__button{width:100%;height:100%}.shop-hero__button{position:relative;margin:0;padding:0;border:0;border-radius:0;background:transparent;text-align:left}.shop-hero__image{position:absolute;top:0;left:0;width:100%;height:100%}.shop-hero__copy{position:absolute;top:22rpx;bottom:50rpx;left:30rpx;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;width:47%}.shop-hero__line{display:block;color:#362443;font:42rpx/1.35 "Songti SC","STSong",serif}.shop-hero__subtitle{display:block;margin-top:16rpx;color:#70597f;font-size:21rpx;line-height:1.6}.shop-hero__progress{position:absolute;bottom:12rpx;left:30rpx;display:flex;align-items:center;gap:12rpx;min-height:20px;color:#685477;font-size:var(--cisme-text-micro);pointer-events:none}.hero-dot{width:8rpx;height:8rpx;border-radius:8rpx;background:#b9a6c9}.hero-dot--active{width:24rpx;background:#715282}
.shop-card{display:block;width:100%;margin:0 0 36rpx;padding:0;overflow:hidden;border:0;border-radius:var(--shop-card-radius);background:#fffcff;box-shadow:var(--shop-card-shadow);text-align:left}.shop-card__image{display:block;width:100%;height:520.5rpx;background:#eee8f3}.shop-card__caption{padding:30rpx 32rpx 32rpx}.shop-card__name{display:block;color:#352a3a;font:500 40rpx/1.45 "Songti SC","STSong",serif}.shop-card__subline{display:block;margin-top:10rpx;color:#796286;font-size:23rpx;line-height:1.7}.shop-card__bottom{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:24rpx}.shop-card__price{display:flex;align-items:baseline;flex-wrap:wrap;gap:4rpx;min-width:0;color:#56306f}.shop-card__qualifier{margin-right:4rpx;color:#7b6589;font-size:23rpx;line-height:1.5}.shop-card__yen{font-size:29rpx}.shop-card__amount{font-size:48rpx;line-height:1.2;font-weight:500;font-variant-numeric:tabular-nums}.shop-card__open{display:flex;align-items:center;justify-content:flex-end;flex:none;gap:6rpx;min-height:44px;color:#735b81;font-size:23rpx}.shop-card__open image{width:28rpx;height:28rpx}
.shop-sync{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:-14rpx 8rpx 22rpx;color:#70597f;font-size:23rpx;line-height:1.6}.shop-sync button{flex:none;min-height:44px;margin:0;padding:0 16rpx;background:transparent;color:#56306f;font-size:24rpx}.shop-sync--error{padding:16rpx;border-radius:18rpx;background:#eee4f2}
.shop-read-loading{position:absolute;top:16rpx;right:16rpx;left:auto;z-index:2}
