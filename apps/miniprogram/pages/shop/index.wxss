@import "../../styles/read-loading.wxss";

.shop-page {
  min-height: 100vh;
  padding: 0 36rpx calc(var(--cisme-safe-bottom, env(safe-area-inset-bottom)) + 166rpx);
  background: var(--cisme-page);
  color: var(--cisme-ink);
}

.shop-head {
  padding-top: var(--cisme-status-bar, 20px);
}

.shop-title-row {
  display: flex;
  align-items: center;
  min-height: var(--cisme-navbar-height, 44px);
  padding-right: var(--cisme-nav-side, 112rpx);
}

.shop-title {
  color: var(--cisme-ink);
  font-size: 1.625rem;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -.025em;
}

.shop-utility {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 50px;
  margin: 8rpx 0 18rpx;
  border-bottom: 1rpx solid var(--cisme-line);
}

.shop-brand {
  color: var(--cisme-muted);
  font-size: .8125rem;
  line-height: 1.4;
}

.shop-orders {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: none;
  min-height: var(--cisme-hit-target);
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--cisme-plum);
  font-size: .875rem;
}

.shop-orders image { width: 34rpx; height: 34rpx; flex: none; }

.shop-catalog { position: relative; }

.shop-product {
  position: relative;
  display: block;
  min-width: 0;
  min-height: var(--cisme-hit-target);
  width: 100%;
  margin: 0 0 22rpx;
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: var(--cisme-radius-card);
  background: var(--cisme-lilac);
  color: var(--cisme-ink);
  text-align: left;
}

.shop-product__media {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 50%;
  overflow: hidden;
  background: var(--cisme-lilac);
}

.shop-product__image { display: block; width: 100%; height: 100%; }

.shop-product--campaign .shop-product__media { width: 100%; }

.shop-product--campaign .shop-product__image {
  position: absolute;
  right: 0;
}

.shop-product__copy {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 50%;
  min-width: 0;
  min-height: 326rpx;
  padding: 28rpx 10rpx 26rpx 28rpx;
}

.shop-product__name {
  display: block;
  font-size: 1.0625rem;
  font-weight: 600;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.shop-product__subtitle {
  display: block;
  margin-top: 7rpx;
  color: #574863;
  font-size: .8125rem;
  line-height: 1.4;
}

.shop-product__bottom {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  margin-top: 12rpx;
}

.shop-product__offer {
  display: flex;
  flex-direction: column;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 4rpx;
}

.shop-product__price {
  color: var(--cisme-plum);
  font-size: 1.125rem;
  font-weight: 600;
  line-height: 1.25;
  font-variant-numeric: tabular-nums;
}

.shop-product__availability { color: #574863; font-size: .75rem; line-height: 1.4; }
.shop-product__arrow { width: 25rpx; height: 25rpx; flex: none; }

.shop-sync {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0 12rpx;
  margin-bottom: 16rpx;
  color: var(--cisme-muted);
  font-size: .8125rem;
}
.shop-sync button { padding: 0; }
.shop-read-loading { position: absolute; z-index: 1; top: 12rpx; right: 12rpx; left: auto; }
