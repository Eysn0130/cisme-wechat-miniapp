.invite-page { padding-right:28rpx; padding-left:28rpx; background:#f7f2f8; }
.invite-topbar-copy { display:flex; flex-direction:column; align-items:center; }
.invite-topbar-subtitle { margin-top:4rpx; color:#958a97; font-size:24rpx; line-height:1.5; }
.invite-card { margin-top:24rpx; padding:44rpx; border:1rpx solid rgba(255,255,255,.87); border-radius:62rpx; background:linear-gradient(160deg,rgba(255,255,255,.84),rgba(229,217,238,.75)); box-shadow:inset 0 2rpx 34rpx rgba(255,255,255,.9),0 26rpx 58rpx rgba(54,35,66,.12); text-align:center; }
.invite-eyebrow { color:#6e6278; font-size:22rpx; letter-spacing:4rpx; }
.invite-avatar { display:flex; align-items:center; justify-content:center; width:256rpx; height:256rpx; margin:28rpx auto; overflow:hidden; border:14rpx solid rgba(255,255,255,.72); border-radius:50%; background:#eee5f3; box-shadow:0 18rpx 50rpx rgba(66,40,82,.15); }
.invite-avatar-image { width:70%; height:70%; }
.invite-title { color:#392c40; font-family:"Songti SC","STSong",serif; font-size:40rpx; font-weight:400; line-height:1.5; }
.invite-code-label { display:block; margin:28rpx 0 4rpx; color:#958b98; font-size:24rpx; }
.invite-code { display:block; color:#493550; font:400 56rpx/1.2 -apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif; font-variant-numeric:lining-nums tabular-nums; letter-spacing:.08em; }
.invite-validity { display:block; margin-top:8rpx; color:#817587; font-size:24rpx; line-height:1.5; }
.invite-primary { display:flex; align-items:center; justify-content:center; gap:12rpx; width:82%; min-height:88rpx; margin:32rpx auto 0; padding:12rpx 16rpx; border:1rpx solid rgba(255,255,255,.83); border-radius:44rpx; color:white; background:linear-gradient(180deg,#6d4c88,#3b284d); font-size:24rpx; line-height:1.5; }
.invite-button-icon { flex:0 0 36rpx; width:36rpx; height:36rpx; }
.invite-history { margin-top:26rpx; padding:30rpx; border-radius:46rpx; }
.invite-history-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.invite-history-title { color:#493b50; font-family:"Songti SC","STSong",serif; font-size:30rpx; }
.invite-history-meta { color:#958b98; font-size:22rpx; }
.invite-empty,.invite-history-row { margin-top:26rpx; padding-top:20rpx; border-top:1rpx solid rgba(84,64,93,.08); color:#817587; font-size:24rpx; line-height:1.5; }
.invite-history-row { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.invite-history-code { font-variant-numeric:lining-nums tabular-nums; letter-spacing:.04em; }
.invite-history-date { font-size:22rpx; }
.invite-note { display:flex; align-items:center; gap:20rpx; margin-top:26rpx; padding:24rpx; border:1rpx solid rgba(255,255,255,.7); border-radius:34rpx; background:rgba(236,226,242,.56); color:#786b7e; }
.invite-note-icon { flex:0 0 36rpx; width:36rpx; height:36rpx; }
.invite-note-copy { flex:1; min-width:0; }
.invite-note-title,.invite-note-detail { display:block; font-size:24rpx; line-height:1.5; }
.invite-note-detail { margin-top:6rpx; }
.invite-title-line { display:block; }
