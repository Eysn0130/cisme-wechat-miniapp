<view class="chrome-root" style="{{chromeStyle}}">
<view class="topbar submit-topbar"><button class="topbar__back {{working || !!uploadingKind || savingDraft || resolvingDraftConflict || navigatingToProgress || confirmingExit ? 'control--disabled' : ''}}" bindtap="back" disabled="{{working || !!uploadingKind || savingDraft || resolvingDraftConflict || navigatingToProgress || confirmingExit}}" aria-label="{{working ? '投稿提交中，暂不能返回' : uploadingKind ? '图片上传中，暂不能返回' : savingDraft || resolvingDraftConflict ? '草稿核对与保存中，暂不能返回' : navigatingToProgress ? '正在打开审核进度，暂不能返回' : confirmingExit ? '正在确认如何处理未保存草稿' : '返回'}}"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><view class="submit-topbar__copy"><text class="topbar__title">提交发布证明</text><small class="submit-topbar__subtitle">{{draftState}}</small></view></view>
<view class="page page--stack submit-page">
  <view wx:if="{{loading}}" class="state" aria-live="polite">正在加载投稿草稿…</view>
  <view wx:elif="{{!submission}}" class="glass error-scene submit-error-scene" aria-live="assertive" aria-atomic="true"><view class="error-scene__icon"><image class="error-scene__icon-image" src="/assets/icons/images-plum.svg" mode="aspectFit"/></view><text class="error-scene__eyebrow">DRAFT UNAVAILABLE</text><strong class="error-scene__title">{{errorTitle || '投稿草稿暂时无法打开'}}</strong><text class="error-scene__copy">{{error}}</text><view class="error-scene__actions"><button wx:if="{{errorAction === 'load'}}" class="primary submit-error-action {{loading ? 'primary--disabled' : ''}}" bindtap="load" disabled="{{loading}}"><text class="action-label">重新加载投稿草稿</text></button><button class="submit-error-action {{errorAction === 'missing' ? 'primary' : 'secondary'}}" bindtap="back"><text class="action-label">返回投稿来源</text></button></view></view>
  <block wx:else>
  <view class="glass submission-id-card">
    <view class="submission-id-card__head"><image class="submission-id-card__icon" src="/assets/icons/check-circle-plum.svg" mode="aspectFit"/><text>任务已领取</text></view>
    <view class="submission-id-row"><text class="submission-id-row__label">投稿编号</text><strong class="submission-id-row__value">{{submissionId}}</strong><button class="submission-id-row__copy" bindtap="copySubmissionId" aria-label="复制投稿编号"><image class="submission-id-row__icon" src="/assets/icons/copy-plum.svg" mode="aspectFit"/></button></view>
    <view class="submission-id-card__meta">证据、补件、审核与申诉均沿用这一编号</view>
  </view>
  <view wx:if="{{error}}" id="submit-error-summary" class="submit-error-summary" aria-live="assertive" aria-atomic="true"><text class="submit-error-summary__copy">{{error}}</text><button wx:if="{{draftRecovery === 'retry'}}" class="text-button submit-error-summary__retry {{savingDraft ? 'text-button--disabled' : ''}}" bindtap="retryDraftSave" loading="{{savingDraft}}" disabled="{{savingDraft}}">重试保存草稿</button><button wx:elif="{{draftRecovery === 'conflict'}}" class="text-button submit-error-summary__retry {{savingDraft || resolvingDraftConflict ? 'text-button--disabled' : ''}}" bindtap="resolveDraftConflict" loading="{{resolvingDraftConflict}}" disabled="{{savingDraft || resolvingDraftConflict}}">核对最新版本并保存</button><button wx:elif="{{draftRecovery === 'edit'}}" class="text-button submit-error-summary__retry" bindtap="focusPostUrl">修改 HTTPS 内容链接</button><button wx:elif="{{draftRecovery === 'reload'}}" class="text-button submit-error-summary__retry {{loading ? 'text-button--disabled' : ''}}" bindtap="load" disabled="{{loading}}">重新加载投稿状态</button><button wx:elif="{{uploadRecovery === 'privacy'}}" class="text-button submit-error-summary__retry" bindtap="openMediaPrivacy">打开隐私保护指引</button><button wx:elif="{{uploadRecovery === 'settings'}}" class="text-button submit-error-summary__retry" bindtap="openMediaSettings">打开相册与相机设置</button><button wx:elif="{{uploadRecovery === 'reload'}}" class="text-button submit-error-summary__retry {{loading ? 'text-button--disabled' : ''}}" bindtap="load" disabled="{{loading}}">重新加载投稿与上传状态</button><button wx:elif="{{uploadRecovery === 'retry'}}" class="text-button submit-error-summary__retry {{working || !!uploadingKind || savingDraft ? 'text-button--disabled' : ''}}" data-kind="{{lastUploadKind}}" bindtap="chooseMedia" disabled="{{working || !!uploadingKind || savingDraft}}">重新选择图片</button><button wx:elif="{{submitRecovery === 'reload'}}" class="text-button submit-error-summary__retry {{loading ? 'text-button--disabled' : ''}}" bindtap="load" disabled="{{loading}}">重新加载权威投稿状态</button><button wx:elif="{{submitRecovery === 'edit'}}" class="text-button submit-error-summary__retry" bindtap="focusPostUrl">修改 HTTPS 内容链接</button><button wx:elif="{{submitRecovery === 'retry'}}" class="text-button submit-error-summary__retry {{working || savingDraft ? 'text-button--disabled' : ''}}" bindtap="submit" disabled="{{working || savingDraft}}">重试提交人工审核</button></view>
  <view wx:if="{{!editable}}" class="state submit-readonly-state" aria-live="polite">这份投稿已进入审核流程，当前字段与证据只读；请从底部打开审核进度查看结果、补件或申诉。</view>

  <view class="submit-section-head"><text class="submit-section-head__index">01</text><view class="submit-section-head__copy"><strong class="submit-section-head__title">原始素材</strong><small class="submit-section-head__meta">审核原图属性，仅审核团队可见</small></view><em class="submit-section-head__required">必填</em></view>
  <button class="glass evidence-upload {{originalReady ? 'is-ready' : ''}} {{!editable || working || !!uploadingKind || savingDraft ? 'control--disabled' : ''}}" data-kind="original" bindtap="chooseMedia" loading="{{uploadingKind === 'original'}}" disabled="{{!editable || working || !!uploadingKind || savingDraft}}">
    <image class="evidence-upload__status-icon" src="{{originalReady ? '/assets/icons/check-circle-plum.svg' : '/assets/icons/upload-simple-plum.svg'}}" mode="aspectFit"/>
    <view class="evidence-upload__copy"><strong class="evidence-upload__title">{{originalReady ? '原始素材已安全上传' : '上传 1 张可核验代表原图'}}</strong><small class="evidence-upload__meta">支持 JPG / PNG / WEBP，单张不超过 10MB</small></view>
    <image class="evidence-upload__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/>
  </button>

  <view class="submit-section-head"><text class="submit-section-head__index">02</text><view class="submit-section-head__copy"><strong class="submit-section-head__title">发布证明</strong><small class="submit-section-head__meta">发布后回来补齐可核验信息</small></view><em class="submit-section-head__required">必填</em></view>
  <button class="glass evidence-upload {{screenshotReady ? 'is-ready' : ''}} {{!editable || working || !!uploadingKind || savingDraft ? 'control--disabled' : ''}}" data-kind="screenshot" bindtap="chooseMedia" loading="{{uploadingKind === 'screenshot'}}" disabled="{{!editable || working || !!uploadingKind || savingDraft}}">
    <image class="evidence-upload__status-icon" src="{{screenshotReady ? '/assets/icons/check-circle-plum.svg' : '/assets/icons/upload-simple-plum.svg'}}" mode="aspectFit"/>
    <view class="evidence-upload__copy"><strong class="evidence-upload__title">{{screenshotReady ? '发布截图已安全上传' : '上传发布截图'}}</strong><small class="evidence-upload__meta">需包含账号、正文与发布时间</small></view>
    <image class="evidence-upload__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/>
  </button>

  <view class="glass submit-fields">
    <label class="submit-input-row"><image class="submit-input-row__icon" src="/assets/icons/user-circle-plum.svg" mode="aspectFit"/><text class="submit-input-row__label">平台账号</text><input class="submit-input-row__field" value="{{platformAccount}}" data-field="platformAccount" bindinput="updateField" disabled="{{!editable || working || !!uploadingKind}}" placeholder="平台名称与账号 ID" maxlength="120" cursor-spacing="24" /></label>
    <label class="submit-input-row"><image class="submit-input-row__icon" src="/assets/icons/link-simple-plum.svg" mode="aspectFit"/><text class="submit-input-row__label">内容链接</text><input class="submit-input-row__field" value="{{postUrl}}" data-field="postUrl" bindinput="updateField" focus="{{postUrlFocus}}" disabled="{{!editable || working || !!uploadingKind}}" placeholder="粘贴 https:// 公开访问链接" maxlength="500" cursor-spacing="24" /></label>
    <label class="submit-disclosure"><text class="submit-disclosure__label">利益关系披露</text><textarea class="submit-disclosure__field" value="{{disclosure}}" data-field="disclosure" bindinput="updateField" disabled="{{!editable || working || !!uploadingKind}}" placeholder="请如实说明参与活动、获赠或可能获得奖励等关系" maxlength="300" cursor-spacing="120" /></label>
  </view>

  <view class="submit-section-head"><text class="submit-section-head__index">03</text><view class="submit-section-head__copy"><strong class="submit-section-head__title">声明与授权</strong><small class="submit-section-head__meta">基础提交与品牌转载严格分开</small></view></view>
  <view class="glass consent-card">
    <view class="permission-row"><view class="permission-row__copy"><strong class="permission-row__title">安全存储投稿证据</strong><small class="permission-row__meta">完成审核、补件与申诉所必需</small></view><switch aria-label="允许安全存储投稿证据，必选" checked="{{permissions.content_storage}}" data-key="content_storage" bindchange="updatePermission" disabled="{{!editable || working || !!uploadingKind}}" color="#56306f" /></view>
    <view class="permission-row"><view class="permission-row__copy"><strong class="permission-row__title">人工审核与风险复核</strong><small class="permission-row__meta">完成资格判定所必需</small></view><switch aria-label="允许人工审核与风险复核，必选" checked="{{permissions.human_review}}" data-key="human_review" bindchange="updatePermission" disabled="{{!editable || working || !!uploadingKind}}" color="#56306f" /></view>
    <view class="permission-row"><view class="permission-row__copy"><strong class="permission-row__title">通过后只读精选展示 · 可选</strong><small class="permission-row__meta">默认关闭；不影响审核与基础奖励，可随时撤回</small></view><switch aria-label="允许通过后只读精选展示，可选" checked="{{permissions.feed_readonly}}" data-key="feed_readonly" bindchange="updatePermission" disabled="{{!editable || working || !!uploadingKind}}" color="#56306f" /></view>
  </view>

  <view class="submit-action" style="{{keyboardActionStyle}}"><button wx:if="{{editable}}" class="primary submit-action__button {{!canSubmit ? 'primary--disabled' : ''}}" loading="{{working}}" disabled="{{!canSubmit}}" bindtap="submit"><text class="action-label">提交人工审核</text></button><button wx:else class="primary submit-action__button {{navigatingToProgress ? 'primary--disabled' : ''}}" loading="{{navigatingToProgress}}" disabled="{{navigatingToProgress}}" bindtap="openProgress"><text class="action-label">打开审核进度</text></button></view>
  </block>
</view>
</view>
