.submit-page { padding-right:24rpx; padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 164rpx); padding-left:24rpx; background:linear-gradient(180deg,#f6f0f8,#fbf8fb); }
.submit-topbar { height:var(--cisme-topbar-height,calc(env(safe-area-inset-top) + 188rpx)); }
.submit-topbar__copy { display:flex; align-items:center; flex-direction:column; }
.submit-topbar__subtitle { margin-top:5rpx; color:#928795; font-size:var(--cisme-text-small); line-height:1.5; }
.submission-id-card { padding:27rpx 28rpx; border-radius:44rpx; background:rgba(233,220,239,.72); }
.submission-id-card__head { display:flex; align-items:center; gap:10rpx; color:#6f567a; font-size:var(--cisme-text-small); line-height:1.5; }
.submission-id-card__icon { width:28rpx; height:28rpx; }
.submission-id-row { display:flex; align-items:center; gap:8rpx; margin-top:12rpx; }
.submission-id-row__label { color:#766c7a; font-size:var(--cisme-text-small); }.submission-id-row__value { flex:1; overflow:hidden; color:#392b40; font:var(--cisme-text-small) Georgia,serif; letter-spacing:1rpx; text-overflow:ellipsis; white-space:nowrap; }.submission-id-row__copy { display:flex; align-items:center; justify-content:center; flex:0 0 auto; width:var(--cisme-hit-target); height:var(--cisme-hit-target); padding:0; border:0; border-radius:50%; background:transparent; }.submission-id-row__icon { width:30rpx; height:30rpx; }
.submission-id-card__meta { margin-top:17rpx; color:#867b8a; font-size:var(--cisme-text-small); line-height:1.5; }
.submit-error-summary { margin-top:18rpx; padding:22rpx 24rpx; border:1rpx solid rgba(135,76,92,.16); border-radius:24rpx; color:#74434f; background:rgba(249,232,237,.88); font-size:var(--cisme-text-body); line-height:1.6; }
.submit-error-summary__copy { display:block; }
.submit-error-summary__retry { margin:12rpx 0 0; }
.submit-readonly-state { margin-top:18rpx; border:1rpx solid rgba(86,48,111,.12); background:rgba(244,237,247,.78); }
.submit-section-head { display:flex; align-items:flex-start; gap:17rpx; margin-top:30rpx; padding:0 7rpx; }
.submit-section-head__index { display:flex; align-items:center; justify-content:center; width:43rpx; height:43rpx; border-radius:50%; color:#6a4a7a; background:#eee4f2; font:var(--cisme-text-micro) Georgia,serif; }.submit-section-head__copy { flex:1; }.submit-section-head__title,.submit-section-head__meta { display:block; }.submit-section-head__title { color:#433649; font-size:var(--cisme-text-small); font-weight:500; }.submit-section-head__meta { margin-top:4rpx; color:#968a99; font-size:var(--cisme-text-small); line-height:1.5; }.submit-section-head__required { color:#7d6787; font-size:var(--cisme-text-small); font-style:normal; }
.evidence-upload { display:flex; align-items:center; width:100%; min-height:136rpx; margin-top:14rpx; padding:19rpx 22rpx; border-radius:38rpx; background:rgba(255,252,255,.82); text-align:left; }.evidence-upload__status-icon { flex:0 0 auto; width:39rpx; height:39rpx; margin-right:17rpx; }.evidence-upload__copy { flex:1; }.evidence-upload__title,.evidence-upload__meta { display:block; }.evidence-upload__title { color:#443648; font-size:var(--cisme-text-small); font-weight:500; }.evidence-upload__meta { margin-top:6rpx; color:#928796; font-size:var(--cisme-text-small); line-height:1.5; }.evidence-upload__caret { width:27rpx; height:27rpx; }.evidence-upload.is-ready { background:rgba(238,228,242,.82); }
.submit-fields { margin-top:19rpx; padding:0 24rpx; border-radius:30rpx; }.submit-input-row { display:flex; align-items:center; min-height:88rpx; border-bottom:1rpx solid rgba(78,47,91,.1); }.submit-input-row__icon { width:31rpx; height:31rpx; margin-right:13rpx; }.submit-input-row__label { width:125rpx; color:#5b4c61; font-size:var(--cisme-text-small); }.submit-input-row__field { flex:1; color:#3b2e41; font-size:var(--cisme-text-small); text-align:right; }.submit-disclosure { display:block; padding:22rpx 0; }.submit-disclosure__label { display:block; margin-bottom:11rpx; color:#5b4c61; font-size:var(--cisme-text-small); }.submit-disclosure__field { box-sizing:border-box; width:100%; height:108rpx; min-height:108rpx; padding:17rpx; border-radius:19rpx; background:rgba(247,243,248,.8); font-size:var(--cisme-text-small); line-height:1.55; }
.consent-card { margin-top:15rpx; padding:0 25rpx; border-radius:42rpx; }.permission-row__copy { flex:1; }.permission-row__title,.permission-row__meta { display:block; }.permission-row__title { color:#453748; font-size:var(--cisme-text-small); font-weight:500; }.permission-row__meta { margin-top:5rpx; color:#928797; font-size:var(--cisme-text-small); line-height:1.5; }
.submit-action { position:fixed; z-index:30; right:20rpx; bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 16rpx); left:20rpx; padding:20rpx 0 0; background:linear-gradient(180deg,rgba(247,243,248,0),rgba(247,243,248,.97) 36%); }.submit-action__button { min-height:50px; margin:0; }
.submit-error-scene { min-height:520rpx; margin-top:18rpx; }
.submit-error-action { margin-top:0; }
