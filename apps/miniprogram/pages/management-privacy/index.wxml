<view style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">隐私请求受理</text></view>
<view class="page page--stack privacy-management"><view class="page-title">逐项核验，清楚回复</view><text class="subtitle">查询、导出、更正、撤回与注销请求统一受理。回复状态与实际数据操作分开记录。</text>
<view wx:if="{{loading}}" class="state" aria-live="polite">正在核验权限并同步请求…</view>
<view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="retry">重试</button></view>
<view wx:if="{{notice}}" class="state" aria-live="polite">{{notice}}</view><view wx:if="{{actionError}}" class="state state--error" aria-live="polite"><text>{{actionError}}</text><button wx:if="{{!coreReady}}" class="text-button" bindtap="retry">刷新并核对</button></view>
<block wx:if="{{coreReady && !selected}}"><text class="privacy-meta">按办理期限排列，可逐页查看后续请求。仅供授权受理人员使用。</text><view wx:if="{{!items.length}}" class="state">暂无隐私请求。可稍后刷新查看。</view><button wx:for="{{items}}" wx:key="id" class="privacy-row" data-id="{{item.id}}" bindtap="select"><view class="privacy-row__heading"><text>{{item.kindLabel}}</text><text class="privacy-badge">{{item.statusLabel}}</text></view><text class="privacy-preview">{{item.message}}</text><text class="privacy-meta">办理期限 {{item.dueLabel}} · 查看详情</text></button><view wx:if="{{moreError}}" class="state state--error" aria-live="polite">{{moreError}}</view><button wx:if="{{nextCursor}}" class="text-button {{moreBusy || busy ? 'text-button--disabled' : ''}}" bindtap="loadMore" loading="{{moreBusy}}" disabled="{{moreBusy || busy}}">{{moreBusy ? '正在加载后续请求…' : '加载更多请求'}}</button><button class="text-button {{busy ? 'text-button--disabled' : ''}}" bindtap="retry" disabled="{{busy}}">刷新请求</button></block>
<view wx:if="{{coreReady && selected}}" class="card privacy-detail"><view class="privacy-row__heading"><text>{{selected.kindLabel}}</text><text class="privacy-badge">{{selected.statusLabel}}</text></view><text class="privacy-meta">请求编号 {{selected.id}}</text><text class="privacy-meta">办理期限 {{selected.dueLabel}}</text><text class="privacy-body" selectable>{{selected.message}}</text><view wx:if="{{selected.replyHistory.length}}" class="privacy-note"><text>近期处理往来</text><view wx:for="{{selected.replyHistory}}" wx:for-item="entry" wx:key="version"><text selectable>{{entry.actor === 'member' ? '用户补充' : '工作人员'}}：{{entry.body}}</text></view></view><view class="privacy-note"><text wx:if="{{selected.execution}}">执行任务：{{selected.execution.type==='export'?'导出':'删除处理'}} · {{selected.execution.status}}</text><text wx:else>回复不会代替实际数据操作。</text></view>
<block wx:if="{{selected.editable}}"><text class="section-title">处理状态</text><picker range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatus" disabled="{{busy}}"><view class="privacy-picker">{{statusOptions[statusIndex]}} · 点击选择</view></picker><text class="section-title">回复用户</text><textarea class="privacy-input" value="{{response}}" bindinput="onResponse" maxlength="4000" auto-height adjust-position disabled="{{busy}}" placeholder="说明已核验的事实、待办事项及下一步。不要把受理写成已完成删除。"/><button class="primary {{busy ? 'primary--disabled' : ''}}" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{busy?'正在保存…':'保存回复'}}</button></block><block wx:else><text class="section-title">已保存回复</text><text class="privacy-body">{{selected.response || '暂无回复'}}</text><text class="privacy-meta">当前状态不可覆盖回复，请依据执行审计继续处理。</text></block><button class="text-button {{busy ? 'text-button--disabled' : ''}}" bindtap="closeDetail" disabled="{{busy}}">返回请求列表</button></view>
</view></view>
