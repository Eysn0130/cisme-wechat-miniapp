<view style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">隐私请求受理</text></view>
<view class="page page--stack privacy-management"><text class="subtitle">查看申请、补充信息和办理进度。</text>
<view wx:if="{{loading}}" class="state" aria-live="polite">正在加载申请…</view>
<view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="retry">重试</button></view>
<view wx:if="{{notice}}" class="state" aria-live="polite">{{notice}}</view><view wx:if="{{actionError}}" class="state state--error" aria-live="polite"><text>{{actionError}}</text><button wx:if="{{!coreReady}}" class="text-button" bindtap="retry">刷新并核对</button></view>
<block wx:if="{{coreReady && !selected}}"><view wx:if="{{!items.length}}" class="state">暂无待处理申请。</view><button wx:for="{{items}}" wx:key="id" class="privacy-row" data-id="{{item.id}}" bindtap="select"><view class="privacy-row__heading"><text>{{item.kindLabel}}</text><text class="privacy-badge">{{item.statusLabel}}</text></view><text class="privacy-preview">{{item.message}}</text><text class="privacy-meta">办理期限 {{item.dueLabel}} · 查看详情</text></button><view wx:if="{{moreError}}" class="state state--error" aria-live="polite">{{moreError}}</view><button wx:if="{{nextCursor}}" class="text-button {{moreBusy || busy ? 'text-button--disabled' : ''}}" bindtap="loadMore" loading="{{moreBusy}}" disabled="{{moreBusy || busy}}">{{moreBusy ? '正在加载后续请求…' : '加载更多请求'}}</button><button class="text-button {{busy ? 'text-button--disabled' : ''}}" bindtap="retry" disabled="{{busy}}">刷新请求</button></block>
<view wx:if="{{coreReady && selected}}" class="card privacy-detail"><view class="privacy-row__heading"><text>{{selected.kindLabel}}</text><text class="privacy-badge">{{selected.statusLabel}}</text></view><text class="privacy-meta">请求编号 {{selected.id}}</text><text class="privacy-meta">办理期限 {{selected.dueLabel}}</text><text class="privacy-body" selectable>{{selected.message}}</text><view wx:if="{{selected.replyHistory.length}}" class="privacy-note"><text>近期处理往来</text><view wx:for="{{selected.replyHistory}}" wx:for-item="entry" wx:key="version"><text selectable>{{entry.actor === 'member' ? '用户补充' : '工作人员'}}：{{entry.body}}</text></view></view><view class="privacy-note"><text wx:if="{{selected.execution}}">执行任务：{{selected.execution.type==='export'?'导出':'删除处理'}} · {{selected.executionLabel}}</text><text wx:else>回复不会代替实际数据操作。</text></view>
<block wx:if="{{selected.editable}}"><view wx:if="{{selected.kind === 'correct' && selected.correctionLabel && selected.profileVersion !== null}}" class="privacy-note"><text>可核验的更正目标：{{selected.correctionLabel}}</text><button class="secondary {{busy ? 'secondary--disabled' : ''}}" bindtap="executeCorrection" loading="{{busy}}" disabled="{{busy}}">更正并读回确认</button></view><text wx:if="{{selected.kind === 'correct' && !selected.correctionLabel}}" class="privacy-meta">请用户明确回复“昵称：新昵称”或“微信号：新微信号”后办理。</text><text class="section-title">处理状态</text><picker range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatus" disabled="{{busy}}"><view class="privacy-picker">{{statusOptions[statusIndex]}} · 点击选择</view></picker><text class="section-title">回复用户</text><textarea class="privacy-input" value="{{response}}" bindinput="onResponse" maxlength="4000" auto-height adjust-position disabled="{{busy}}" placeholder="向用户说明已处理的内容，或需要补充的信息。"/><button class="primary {{busy ? 'primary--disabled' : ''}}" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{busy?'正在保存…':'保存回复'}}</button></block><block wx:else><text class="section-title">已保存回复</text><text class="privacy-body">{{selected.response || '暂无回复'}}</text><text class="privacy-meta">这条回复已保存，请查看上方办理记录。</text></block><button class="text-button {{busy ? 'text-button--disabled' : ''}}" bindtap="closeDetail" disabled="{{busy}}">返回请求列表</button></view>
</view></view>
