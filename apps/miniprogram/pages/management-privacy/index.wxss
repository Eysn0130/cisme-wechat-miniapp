.privacy-management{padding-bottom:calc(32px + env(safe-area-inset-bottom))}.privacy-row{display:flex;flex-direction:column;gap:10px;text-align:left;width:100%;box-sizing:border-box;padding:18px;margin:0;background:#fff;border:1rpx solid var(--cisme-line);border-radius:16px;white-space:normal;line-height:1.6}.privacy-row__heading{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:16px;font-weight:600}.privacy-badge{flex-shrink:0;color:var(--cisme-plum);background:#f7f1f8;padding:3px 8px;border-radius:8px;font-size:12px}.privacy-preview{font-size:14px;line-height:1.7;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.privacy-meta{font-size:12px;color:var(--cisme-muted);line-height:1.7;word-break:break-all}.privacy-detail{display:flex;flex-direction:column;padding:20px;gap:16px}.privacy-body{font-size:14px;line-height:1.8;white-space:pre-wrap;word-break:break-all}.privacy-note{font-size:13px;line-height:1.7;padding:12px;background:#faf7fa;border-radius:12px;color:var(--cisme-muted)}.privacy-picker{min-height:var(--cisme-hit-target);display:flex;align-items:center;color:var(--cisme-plum);font-size:14px;border-bottom:1rpx solid var(--cisme-line)}.privacy-input{box-sizing:border-box;width:100%;min-height:144px;background:#faf7fa;border:1rpx solid var(--cisme-line);border-radius:12px;padding:12px;font-size:14px;line-height:1.8}
