@import "../../styles/read-loading.wxss";
.composer-page { min-height:100vh; padding:var(--cisme-stack-top,103px) 22px calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 32px); background:#fff; }
.composer-page--editing { padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 112px); }
.topbar { border-bottom:0; background:#fff; }
.topbar__back { border:0; background:transparent; }
.composer-drafts-shortcut { position:absolute; top:var(--cisme-back-top,var(--cisme-menu-top,env(safe-area-inset-top))); left:60px; display:flex; align-items:center; justify-content:center; min-width:54px; min-height:var(--cisme-hit-target); margin:0; padding:0 8px; border:0; background:transparent; color:var(--cisme-muted); font-size:var(--cisme-text-body); }
.composer-help { display:block; margin-top:8px; color:var(--cisme-muted); font-size:var(--cisme-text-body); line-height:1.6; }
.composer-notice { margin:0 0 12px; padding:0; border-radius:0; background:transparent; color:var(--cisme-muted); font-size:var(--cisme-text-body); }
.composer-status,.composer-recovery,.composer-result { margin:0 0 20px; padding:18px; border-radius:14px; background:#f7f4f9; color:var(--cisme-ink); font-size:var(--cisme-text-body); line-height:1.6; }
.composer-recovery { background:#faf3f5; }
.composer-handoff { display:flex; flex-direction:column; align-items:center; gap:18px; max-width:390px; margin:10px auto 20px; }
.composer-handoff__card { width:calc(75vh - 225px); min-width:150px; max-width:100%; }
.composer-handoff__frame { position:relative; width:100%; height:0; padding-top:133.333333%; overflow:hidden; border-radius:12px; background:#f7f4f9; }
.composer-handoff__image { position:absolute; top:0; left:0; width:100%; height:100%; }
.composer-handoff__waiting { display:flex; align-items:center; gap:8px; color:var(--cisme-muted); font-size:var(--cisme-text-body); line-height:1.6; }
.composer-handoff__spinner { width:16px; height:16px; border:2px solid var(--cisme-line); border-top-color:var(--cisme-plum); border-radius:50%; animation:composer-handoff-spin 900ms linear infinite; }
@keyframes composer-handoff-spin { to { transform:rotate(360deg); } }
.composer-result__title,.composer-recovery__title { display:block; color:var(--cisme-ink-deep); font-size:18px; font-weight:500; }
.composer-page .text-button { min-width:var(--cisme-hit-target); min-height:var(--cisme-hit-target); padding:8px 14px; font-size:var(--cisme-text-body); line-height:1.5; white-space:normal; word-break:break-word; }
.composer-result__actions { display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px; margin-top:14px; }
.composer-result__actions .text-button { margin:0; }
.composer-page .composer-action--primary { border-color:var(--cisme-plum); background:var(--cisme-plum); color:#fff; }
.composer-page .composer-action--quiet { border-color:transparent; background:transparent; }
.composer-list-head { display:flex; align-items:center; justify-content:space-between; gap:14px; margin:0 0 16px; }
.composer-new { flex:none; display:flex; align-items:center; justify-content:center; min-width:72px; min-height:var(--cisme-hit-target); margin:0; padding:0 16px; border:0; border-radius:24px; color:#fff; background:var(--cisme-plum); font-size:var(--cisme-text-body); }
.composer-filters { width:100%; margin-bottom:8px; white-space:nowrap; }
.composer-filter-row { display:inline-flex; gap:8px; align-items:center; padding:2px 0; }
.composer-filter { display:flex; align-items:center; justify-content:center; flex:none; min-height:var(--cisme-hit-target); margin:0; padding:0 14px; border:0; border-radius:24px; background:transparent; color:var(--cisme-muted); font-size:var(--cisme-text-body); }
.composer-filter--selected { color:var(--cisme-plum); background:var(--cisme-lilac); font-weight:500; }
.composer-list-total { display:block; color:var(--cisme-muted); font-size:var(--cisme-text-body); line-height:1.5; }
.composer-empty { padding:64px 0; color:var(--cisme-muted); font-size:var(--cisme-text-body); line-height:1.6; text-align:center; }
.composer-list-row { display:flex; align-items:center; gap:10px; padding:18px 0; border-bottom:1rpx solid var(--cisme-line); }
.composer-list-row__open { display:flex; align-items:center; justify-content:space-between; flex:1; gap:12px; min-width:0; min-height:var(--cisme-hit-target); margin:0; padding:0; border:0; background:transparent; text-align:left; }
.composer-list-row__copy { display:flex; flex-direction:column; flex:1; gap:7px; min-width:0; }
.composer-list-row__title { display:block; overflow:hidden; color:var(--cisme-ink); font-size:var(--cisme-text-action); line-height:1.5; text-overflow:ellipsis; white-space:nowrap; }
.composer-list-row__meta { display:block; color:var(--cisme-muted); font-size:var(--cisme-text-small); line-height:1.5; }
.composer-list-row__status { flex:none; color:var(--cisme-plum); font-size:var(--cisme-text-small); line-height:1.5; }
.composer-list-row__delete { flex:none; display:flex; align-items:center; justify-content:center; min-width:var(--cisme-hit-target); min-height:var(--cisme-hit-target); padding:0; border:0; background:transparent; color:var(--cisme-danger); font-size:var(--cisme-text-small); }
.composer-media-scroll { --composer-media-size:86px; width:100%; margin-bottom:10px; white-space:nowrap; }
.composer-media-grid { display:inline-flex; align-items:flex-start; gap:12px; padding:12px 12px 12px 0; vertical-align:top; }
.composer-readonly-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-bottom:24px; }
.composer-media { position:relative; flex:none; width:var(--composer-media-size); min-width:0; white-space:normal; }
.composer-media--shifting { transition:transform 160ms ease; }
.composer-media--dragging { opacity:.2; }
.composer-media__frame { position:relative; width:100%; height:var(--composer-media-size); }
.composer-media__image,.composer-media__placeholder { display:flex; align-items:center; justify-content:center; width:100%; height:var(--composer-media-size); border-radius:10px; background:#f3f0f5; color:var(--cisme-muted); font-size:var(--cisme-text-small); }
.composer-media__cover { position:absolute; z-index:1; top:6px; left:6px; padding:3px 6px; border-radius:5px; background:var(--cisme-plum-deep); color:#fff; font-size:var(--cisme-text-micro); line-height:1.4; }
.composer-media__state { display:block; margin-top:6px; color:var(--cisme-danger); font-size:var(--cisme-text-small); line-height:1.5; word-break:break-word; white-space:normal; }
.composer-media__actions { position:absolute; z-index:2; top:-10px; right:-10px; display:flex; }
.composer-media__actions button { flex:none; display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:44px; min-width:44px; height:44px; min-height:44px; margin:0; padding:0; border:0; border-radius:50%; background:transparent; color:var(--cisme-muted); font-size:var(--cisme-text-small); }
.composer-media__remove-icon { box-sizing:border-box; width:24px; height:24px; padding:5px; border-radius:50%; background:rgba(255,255,255,.96); box-shadow:0 1px 4px rgba(53,42,58,.12); }
.composer-media__remove--pressed .composer-media__remove-icon { background:#eee7f3; transform:scale(.94); }
.composer-drag-layer { position:fixed; z-index:90; top:0; right:0; bottom:0; left:0; pointer-events:none; }
.composer-drag-photo { position:absolute; top:0; left:0; overflow:hidden; border-radius:10px; background:#f3f0f5; box-shadow:0 8px 24px rgba(53,42,58,.25); }
.composer-drag-photo image,.composer-drag-photo__empty { width:100%; height:100%; }
.composer-drag-photo__empty { display:flex; align-items:center; justify-content:center; color:var(--cisme-muted); font-size:14px; }
.composer-drag-photo--dropping { box-shadow:0 2px 6px rgba(53,42,58,.1); transition:transform 180ms ease,box-shadow 180ms ease; }
.composer-media__retry { display:flex; align-items:center; justify-content:center; width:100%; min-height:var(--cisme-hit-target); margin-top:4px; padding:6px 5px; border:0; border-radius:8px; background:var(--cisme-lilac); color:var(--cisme-plum); font-size:var(--cisme-text-small); line-height:1.5; white-space:normal; word-break:break-word; }
.composer-add { flex:none; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:7px; width:var(--composer-media-size); height:var(--composer-media-size); min-height:var(--cisme-hit-target); margin:0; padding:8px; border:1rpx solid var(--cisme-line); border-radius:10px; background:#f6f4f7; color:var(--cisme-muted); font-size:var(--cisme-text-small); }
.composer-add__icon { width:30px; height:30px; opacity:.55; }
.composer-field { margin:0; padding:10px 0 12px; }
.composer-field--body { padding-top:0; }
.composer-title-input { box-sizing:border-box; width:100%; height:44px; margin:0; padding:0; border:0; color:var(--cisme-ink-deep); font-size:18px; line-height:1.5; }
.composer-body-input { box-sizing:border-box; width:100%; min-height:34vh; margin-top:0; padding:0; border:0; color:var(--cisme-ink); font-size:var(--cisme-text-action); line-height:1.7; }
.composer-placeholder { color:var(--cisme-muted); }
.composer-counter { display:block; flex:none; color:var(--cisme-muted); font-size:var(--cisme-text-small); text-align:right; line-height:1.5; }
.composer-actions { position:fixed; z-index:45; right:0; bottom:0; left:0; padding:12px 22px calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 12px); background:#fff; }
.composer-actions__buttons { display:flex; align-items:stretch; gap:12px; }
.composer-actions__buttons button { min-width:0; min-height:48px; height:auto; margin:0; padding:12px 14px; font-size:var(--cisme-text-action); line-height:1.5; white-space:normal; word-break:break-word; }
.composer-actions__buttons .composer-actions__save { flex:1; border:1rpx solid var(--cisme-line); border-radius:28px; background:#fff; }
.composer-actions__buttons .composer-actions__submit { flex:2; border:1rpx solid var(--cisme-plum); border-radius:28px; background:var(--cisme-plum); box-shadow:none; }
.composer-actions .primary--disabled { background:var(--cisme-plum) !important; box-shadow:none !important; }
.composer-actions--private .composer-actions__save { flex:1; border-color:var(--cisme-plum); background:var(--cisme-plum); color:#fff; }
.composer-actions__hint { display:block; margin-top:7px; color:var(--cisme-muted); font-size:var(--cisme-text-small); line-height:1.5; text-align:center; }
.composer-readonly { color:var(--cisme-ink); }
.composer-readonly__label { display:block; margin-bottom:16px; color:var(--cisme-muted); font-size:var(--cisme-text-small); }
.composer-readonly__title { display:block; margin-bottom:14px; font-size:18px; font-weight:500; line-height:1.6; word-break:break-word; }
.composer-readonly__body { display:block; margin-bottom:20px; font-size:var(--cisme-text-action); line-height:1.7; white-space:pre-wrap; word-break:break-word; }
.composer-readonly-media { min-width:0; }
.composer-readonly-media__image { width:100%; height:208rpx; border-radius:12px; }
.composer-hidden-summary { display:flex; flex-direction:column; gap:8px; margin-top:12px; font-size:var(--cisme-text-body); line-height:1.6; }
.control--disabled { opacity:.45; }
@media (max-width:374px) { .composer-media-scroll { --composer-media-size:82px; } .composer-actions { padding-right:18px; padding-left:18px; } .composer-actions__buttons { gap:10px; } .composer-actions__buttons button { padding:12px 10px; } }
@media (min-width:420px) { .composer-media-scroll { --composer-media-size:88px; } }
@media (prefers-reduced-motion: reduce) { .composer-media--shifting,.composer-drag-photo--dropping { transition:none; } .composer-handoff__spinner { animation:none; } }
