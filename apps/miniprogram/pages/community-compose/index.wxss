.composer-page{padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 56px));padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 64rpx);background:#f7f2f8}.composer-eyebrow{display:block;color:#8b718e;font-size:21rpx;letter-spacing:4rpx}.composer-intro{display:block;margin:16rpx 0 32rpx;color:#695d70;font-size:27rpx;line-height:1.55}.composer-new{width:100%;margin:18rpx 0 38rpx}.composer-list-title{margin:24rpx 0 10rpx;color:#44364f;font-size:30rpx;font-weight:600}.composer-list-row{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:108rpx;padding:18rpx 0;border-bottom:1rpx solid #e7dce9;background:transparent;text-align:left}.composer-list-row__copy{display:flex;flex-direction:column;gap:8rpx;min-width:0}.composer-list-row__title{overflow:hidden;max-width:500rpx;color:#3e3149;font-size:29rpx;text-overflow:ellipsis;white-space:nowrap}.composer-list-row__meta{color:#827487;font-size:23rpx}.composer-list-row__status{flex:none;margin-left:16rpx;color:#6e467a;font-size:23rpx}.composer-status,.composer-notice{margin:16rpx 0 24rpx;padding:20rpx 22rpx;border-radius:16rpx;background:#eee4f1;color:#684b72;font-size:25rpx;line-height:1.5}.composer-field{margin:26rpx 0}.composer-label{display:block;margin-bottom:14rpx;color:#45374e;font-size:27rpx;font-weight:600}.composer-optional{color:#817585;font-size:22rpx;font-weight:400}.composer-field input,.composer-field textarea{box-sizing:border-box;width:100%;padding:22rpx 24rpx;border:1rpx solid #ded1e3;border-radius:18rpx;background:#fff;color:#3d3344;font-size:29rpx;line-height:1.55}.composer-field input{height:92rpx}.composer-field textarea{min-height:180rpx}.composer-media-head{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx}.composer-media-head .composer-label{margin:0}.composer-add{min-width:136rpx;min-height:82rpx;padding:12rpx 22rpx;border:1rpx solid #bda9c7;border-radius:16rpx;background:#fff;color:#5e3971;font-size:25rpx}.composer-media-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin:18rpx 0 28rpx}.composer-media{min-width:0;padding:8rpx;border:1rpx solid #e6dbe9;border-radius:16rpx;background:#fff}.composer-media__image,.composer-media__placeholder{display:flex;align-items:center;justify-content:center;width:100%;height:220rpx;border-radius:10rpx;background:#eee8f0;color:#76687e;text-align:center;font-size:23rpx}.composer-media__state{display:block;min-height:38rpx;margin:8rpx 0;color:#65556d;font-size:21rpx}.composer-media__actions{display:flex;gap:2rpx}.composer-media__actions button{flex:1;min-width:0;min-height:88rpx;padding:4rpx 0;border:0;background:#f6f1f7;color:#61456c;font-size:20rpx}.composer-media__actions .control--disabled,.composer-media__retry.control--disabled{opacity:.45}.composer-media__retry{width:100%;min-height:88rpx;margin:0 0 8rpx;border:0;border-radius:10rpx;background:#ecdef0;color:#5e3971;font-size:24rpx}.composer-declaration{margin:30rpx 0 24rpx;padding:24rpx;border:1rpx solid #e5d9e8;border-radius:22rpx;background:#fff}.composer-picker{display:flex;justify-content:space-between;align-items:center;min-height:80rpx;color:#4f4058;font-size:26rpx}.composer-picker text{color:#785e82;font-size:23rpx}.composer-switch-row{display:flex;justify-content:space-between;align-items:center;gap:20rpx;min-height:96rpx;border-top:1rpx solid #f0e8f1;color:#4f4456;font-size:25rpx;line-height:1.45}.composer-switch-row text{flex:1}.composer-hint{display:block;margin-top:14rpx;color:#776b7d;font-size:23rpx;line-height:1.55}.composer-actions{display:flex;gap:16rpx;margin-top:28rpx}.composer-actions button{flex:1;min-height:88rpx;font-size:26rpx}
.composer-list-row__open{display:flex;align-items:center;justify-content:space-between;flex:1;min-width:0;min-height:88rpx;padding:0;border:0;background:transparent;text-align:left}.composer-list-row__delete{flex:none;min-width:88rpx;min-height:88rpx;margin-left:12rpx;border:0;background:transparent;color:#855267;font-size:23rpx}.composer-readonly{padding:24rpx;border-radius:20rpx;background:#fff;color:#493e50;white-space:pre-wrap;word-break:break-word}.composer-readonly>text{display:block;margin-bottom:16rpx;font-size:27rpx;line-height:1.6}.composer-readonly button{min-height:88rpx}
.composer-hidden-summary{display:flex;flex-direction:column;gap:8rpx;margin:16rpx 0;color:#493e50;font-size:25rpx;line-height:1.55}.composer-status .secondary{min-height:88rpx;margin:18rpx 0 0}
.composer-media-head__actions{display:flex;align-items:center;gap:10rpx}.composer-sort{min-height:88rpx;padding:8rpx 14rpx;border:1rpx solid #d4c3dd;border-radius:16rpx;background:#fff;color:#684c76;font-size:23rpx}.composer-add{min-height:88rpx}.composer-sort.control--disabled{opacity:.52}
