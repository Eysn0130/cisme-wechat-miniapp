.composer-settings-entry { display:flex; align-items:center; justify-content:space-between; gap:16px; width:100%; min-height:56px; margin:0; padding:12px 0; border:0; border-top:1rpx solid var(--cisme-line); border-radius:0; background:transparent; color:var(--cisme-ink); font-size:var(--cisme-text-action); text-align:left; }
