.composer-settings-mask { position:fixed; z-index:80; top:0; right:0; bottom:0; left:0; display:flex; align-items:flex-end; background:rgba(0,0,0,.4); }
.composer-settings-sheet { width:100%; padding:8px 22px calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 20px); border-radius:20px 20px 0 0; background:#fff; }
