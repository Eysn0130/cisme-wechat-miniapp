.composer-list-row__meta { display:block; color:var(--cisme-muted); font-size:var(--cisme-text-small); line-height:1.5; }
.composer-list-row__status { flex:none; color:var(--cisme-plum); font-size:var(--cisme-text-small); line-height:1.5; }
.composer-list-row__delete { flex:none; display:flex; align-items:center; justify-content:center; min-width:var(--cisme-hit-target); min-height:var(--cisme-hit-target); padding:0; border:0; background:transparent; color:var(--cisme-danger); font-size:var(--cisme-text-small); }
.composer-media-toolbar { display:flex; justify-content:flex-end; margin-top:-8px; }
