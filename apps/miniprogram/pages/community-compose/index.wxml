<view class="chrome-root" style="{{chromeStyle}}">
  <view class="topbar">
    <button class="topbar__back {{busy || uploadBusy || recoveryBusy ? 'control--disabled' : ''}}" bindtap="back" disabled="{{busy || uploadBusy || recoveryBusy}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button>
    <button wx:if="{{!listMode}}" class="composer-drafts-shortcut {{busy || uploadBusy || recoveryBusy ? 'control--disabled' : ''}}" bindtap="showMyPosts" disabled="{{busy || uploadBusy || recoveryBusy}}">我的投稿</button>
    <text wx:if="{{listMode}}" class="topbar__title">我的投稿</text>
  </view>
  <view class="page page--stack composer-page {{!listMode ? 'composer-page--editing' : ''}}">
    <view wx:if="{{loading}}" class="state" aria-live="polite">正在加载…</view>
    <view wx:if="{{error}}" class="state state--error" aria-live="assertive">{{error}}</view>
    <view wx:if="{{imageEditRecovery && !uploadBusy}}" class="composer-recovery" aria-live="polite"><text>图片修改尚未应用，原图仍保留。</text><view class="composer-result__actions"><button class="text-button composer-action--primary {{busy || uploadBusy || recoveryBusy || writeRecovery ? 'control--disabled' : ''}}" data-key="{{imageEditRecoveryKey}}" bindtap="retryPendingImageEdit" disabled="{{busy || uploadBusy || recoveryBusy || writeRecovery}}">重试应用修改</button><button class="text-button composer-action--quiet {{busy || uploadBusy || recoveryBusy || writeRecovery ? 'control--disabled' : ''}}" data-key="{{imageEditRecoveryKey}}" bindtap="discardPendingImageEdit" disabled="{{busy || uploadBusy || recoveryBusy || writeRecovery}}">放弃图片修改</button></view></view>
    <button wx:if="{{mediaRecovery === 'settings'}}" class="text-button {{busy || uploadBusy || recoveryBusy || writeRecovery ? 'control--disabled' : ''}}" bindtap="openComposerMediaSettings" disabled="{{busy || uploadBusy || recoveryBusy || writeRecovery}}">去设置</button>
    <button wx:if="{{mediaRecovery === 'privacy' || mediaRecovery === 'retry'}}" class="text-button {{busy || uploadBusy || recoveryBusy || writeRecovery ? 'control--disabled' : ''}}" bindtap="retryChoosingMedia" disabled="{{busy || uploadBusy || recoveryBusy || writeRecovery}}">{{mediaRecovery === 'privacy' ? '重新授权' : '重新选择'}}</button>
    <view wx:if="{{notice && state !== 'pending_review' && state !== 'awaiting_publication' && !((state === 'deleted' || state === 'hidden') && dirty)}}" class="state composer-notice" aria-live="polite">{{notice}}</view>
    <button wx:if="{{error && !loading && !postId && !writeRecovery}}" class="secondary composer-retry {{busy ? 'secondary--disabled' : ''}}" bindtap="retryLoad" disabled="{{busy}}">重试加载</button>
    <view wx:if="{{writeRecovery}}" class="composer-recovery" aria-live="polite">
      <text class="composer-recovery__title">{{writeRecovery === 'conflict' ? '这篇内容已有更新' : '正在核对上次操作结果'}}</text>
      <text class="composer-help">{{writeRecovery === 'conflict' ? '保留当前修改，核对后再决定使用哪个版本。' : '你的输入仍保留，确认结果后再继续，避免重复提交。'}}</text>
      <view class="composer-result__actions"><button class="text-button composer-action--primary {{recoveryBusy ? 'control--disabled' : ''}}" bindtap="verifyWriteResult" disabled="{{recoveryBusy}}" loading="{{recoveryBusy}}">核对最新状态</button>
      <button wx:if="{{writeRecovery === 'conflict'}}" class="text-button composer-action--quiet {{recoveryBusy ? 'control--disabled' : ''}}" bindtap="reloadRemoteDraft" disabled="{{recoveryBusy}}">重新加载内容</button></view>
    </view>
    <block wx:if="{{listMode && !loading}}">
      <view class="composer-list-head">
        <text class="composer-list-total">共 {{listTotal}} 篇</text>
        <button wx:if="{{draftsEnabled}}" class="composer-new {{busy || recoveryBusy ? 'control--disabled' : ''}}" bindtap="startNew" disabled="{{busy || recoveryBusy}}" loading="{{operation === 'creating'}}">写一篇</button>
      </view>
      <scroll-view class="composer-filters" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" aria-label="按投稿状态筛选">
        <view class="composer-filter-row"><button wx:for="{{draftFilters}}" wx:key="value" class="composer-filter {{draftFilter === item.value ? 'composer-filter--selected' : ''}} {{busy || recoveryBusy ? 'control--disabled' : ''}}" data-state="{{item.value}}" bindtap="selectDraftFilter" disabled="{{busy || recoveryBusy}}" aria-label="{{item.label}}，{{draftFilter === item.value ? '当前筛选' : '未选中'}}" aria-pressed="{{draftFilter === item.value}}">{{item.label}}</button></view>
      </scroll-view>
      <view wx:if="{{!drafts.length && !error}}" class="composer-empty"><text>{{draftFilter === 'all' ? '还没有投稿或草稿' : '这个分类下还没有内容'}}</text></view>
      <view wx:for="{{drafts}}" wx:key="id" class="composer-list-row">
        <button class="composer-list-row__open {{busy || recoveryBusy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="openDraft" disabled="{{busy || recoveryBusy}}" aria-label="{{item.title || '未命名护理故事'}}，{{item.status}}">
          <view class="composer-list-row__copy"><text class="composer-list-row__title">{{item.title || (item.imageCount ? '图片护理故事' : '未命名草稿')}}</text><text class="composer-list-row__meta">{{item.imageCount ? item.imageCount + ' 张图片' : '文字分享'}}{{item.publicVersionActive && item.state !== 'published' ? (publicGateEnabled ? ' · 旧版仍公开' : publicGateUnknown ? ' · 公开状态待核对' : ' · 已发布版本保留') : ''}}</text></view>
          <text class="composer-list-row__status">{{item.status}}</text>
        </button>
        <button wx:if="{{(item.state === 'draft' || item.state === 'rejected') && !item.publicVersionActive}}" class="composer-list-row__delete {{busy || recoveryBusy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="deleteListDraft" disabled="{{busy || recoveryBusy}}" aria-label="删除{{item.title || '未命名草稿'}}">删除</button>
      </view>
      <button wx:if="{{listCursor}}" class="text-button {{listLoadingMore ? 'control--disabled' : ''}}" bindtap="loadMoreList" disabled="{{listLoadingMore}}" loading="{{listLoadingMore}}">加载更多</button>
      <text wx:if="{{listMoreError}}" class="state state--error">{{listMoreError}}</text>
    </block>
    <block wx:if="{{!listMode && !loading && postId}}">
      <view wx:if="{{state === 'deleted'}}" class="composer-status"><text>这篇内容已删除</text><text class="composer-help">已停止公开展示，不能继续编辑或提交。</text><text wx:if="{{dirty}}" class="composer-help">修改暂留本页，请先复制需要的文字或查看图片；离开后无法从投稿列表找回。</text></view>
      <view wx:if="{{state === 'pending_review' || state === 'awaiting_publication'}}" class="composer-result" aria-live="polite">
        <text class="composer-result__title">{{state === 'awaiting_publication' ? '内容审核已通过' : '已提交审核'}}</text>
        <text class="composer-help">{{state === 'awaiting_publication' ? '正在等待发布复核，完成前新内容不会公开。' : '审核期间暂不能修改，处理结果会保留在我的投稿中。'}}</text>
        <text wx:if="{{publicVersionActive}}" class="composer-help">{{publicGateEnabled ? '旧版本仍在公开展示，新版通过发布复核后才会替换。' : publicGateUnknown ? '旧版本已保留，公开状态待核对。' : '旧版本已保留，公开展示暂未开放。'}}</text>
        <view class="composer-result__actions"><button class="text-button composer-action--primary" bindtap="showMyPosts">我的投稿</button><button class="text-button composer-action--quiet" bindtap="returnToCommunity">返回社区</button></view>
      </view>
      <view wx:elif="{{publicVersionActive}}" class="composer-status"><text>{{publicGateEnabled ? '当前公开版本仍在展示。修改内容仅自己可见，审核发布后才会替换原版本。' : publicGateUnknown ? '已发布版本已保留，公开状态待核对。修改内容仅自己可见。' : '已发布版本已保留，公开展示暂未开放。修改内容仅自己可见。'}}</text><button wx:if="{{publicGateEnabled}}" class="text-button {{busy || uploadBusy || recoveryBusy || writeRecovery ? 'control--disabled' : ''}}" bindtap="openPublishedPost" disabled="{{busy || uploadBusy || recoveryBusy || writeRecovery}}">查看当前公开版本</button></view>
      <view wx:if="{{state === 'hidden'}}" class="composer-status">这篇内容已下架。{{hiddenReason ? '处理依据：' + hiddenReason : '请查看处理记录。'}}
        <view wx:if="{{hiddenPublished}}" class="composer-hidden-summary"><text>被下架的公开版本</text><text>{{hiddenPublished.title || '图片护理故事'}}</text><text wx:if="{{hiddenPublished.body}}">{{hiddenPublished.body}}</text></view>
        <text wx:if="{{appeal}}">{{appeal.state === 'received' ? '申诉已收到，等待另一名工作人员复核。' : appeal.state === 'resolved' ? '申诉通过，内容已恢复。' : '申诉未通过。'}}{{appeal.decisionReason ? ' · ' + appeal.decisionReason : ''}}</text>
        <text wx:if="{{dirty}}" class="composer-help">申诉与本页修改独立。请先复制需要的文字或查看图片；这些修改暂留本页，离开后无法从投稿列表找回。重新打开后可申请申诉。</text>
        <button wx:if="{{!appeal}}" class="secondary {{busy || recoveryBusy || dirty ? 'secondary--disabled' : ''}}" bindtap="submitAppeal" disabled="{{busy || recoveryBusy || dirty}}" loading="{{operation === 'appealing'}}">申请内容申诉</button>
      </view>
      <view wx:if="{{state === 'rejected'}}" class="composer-status"><text>需要修改后重新提交</text><text class="composer-help">{{reviewNote || '请核对内容说明并修改后，再提交审核。'}}{{reviewedLabel ? ' · ' + reviewedLabel : ''}}</text></view>
      <view wx:if="{{state === 'pending_review' || state === 'awaiting_publication' || ((state === 'deleted' || state === 'hidden') && dirty)}}" class="composer-readonly">
        <text class="composer-readonly__label">{{dirty ? '本机尚未保存的修改' : '本次提交的内容'}}</text><text wx:if="{{title}}" class="composer-readonly__title" selectable="{{dirty}}">{{title}}</text><text wx:if="{{body}}" class="composer-readonly__body" selectable="{{dirty}}">{{body}}</text>
        <view class="composer-readonly-grid"><view wx:for="{{files}}" wx:key="id" class="composer-readonly-media"><image wx:if="{{item.previewUrl || item.localPath}}" class="composer-readonly-media__image" src="{{(state === 'pending_review' || state === 'awaiting_publication') ? (item.previewUrl || item.localPath) : (item.localPath || item.previewUrl)}}" mode="aspectFill" data-id="{{item.id}}" data-epoch="{{epoch}}" data-preview="{{(state === 'pending_review' || state === 'awaiting_publication') ? (item.previewUrl || item.localPath) : (item.localPath || item.previewUrl)}}" bindtap="previewImage" binderror="previewFailed" aria-label="查看图片{{index + 1}}"/><text wx:else class="composer-help">图片 {{index + 1}} · {{item.error || ((state === 'deleted' || state === 'hidden') ? '图片暂时无法预览' : '正在加载预览')}}</text><button wx:if="{{item.state === 'uploaded' && item.error}}" class="text-button" data-id="{{item.id}}" bindtap="retryPreview">重试预览</button></view></view>
      </view>
      <block wx:if="{{state === 'draft' || state === 'rejected' || state === 'published'}}">
        <scroll-view class="composer-media-scroll {{sorting ? 'composer-media-scroll--sorting' : ''}}" scroll-x="{{!sorting}}" enhanced="{{true}}" show-scrollbar="{{false}}" aria-label="{{sorting ? '图片排序，可按行查看并前移后移' : '已选照片，可左右滑动查看'}}">
        <view class="composer-media-grid {{sorting ? 'composer-media-grid--sorting' : ''}}">
          <view wx:for="{{files}}" wx:key="id" class="composer-media">
            <image wx:if="{{item.localPath || item.previewUrl}}" src="{{item.localPath || item.previewUrl}}" mode="aspectFill" class="composer-media__image" data-id="{{item.id}}" data-epoch="{{epoch}}" data-preview="{{item.localPath || item.previewUrl}}" bindtap="openPhotoEditorForImage" bindlongpress="openImageActions" binderror="previewFailed" aria-label="图片{{index + 1}}，点击编辑，长按预览或设为首图"/>
            <view wx:else class="composer-media__placeholder">图片 {{index + 1}}</view>
            <text wx:if="{{index === 0}}" class="composer-media__cover">首图</text>
            <text wx:if="{{item.state === 'uploading' || item.state === 'failed' || item.error}}" class="composer-media__state" aria-live="polite">{{item.state === 'uploading' ? '上传中 ' + item.progress + '%' : item.error || '上传失败'}}</text>
            <text wx:if="{{uploadBusy && imageEditingId === item.id}}" class="composer-media__state" aria-live="polite">正在处理编辑后的图片…</text>
            <button wx:if="{{item.state === 'failed'}}" class="composer-media__retry {{uploadBusy || busy || recoveryBusy || writeRecovery ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="retryImage" disabled="{{uploadBusy || busy || recoveryBusy || writeRecovery}}">重试上传</button>
            <button wx:if="{{item.state === 'uploaded' && item.error}}" class="composer-media__retry {{busy || recoveryBusy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="retryPreview" disabled="{{busy || recoveryBusy}}">重试预览</button>
            <view class="composer-media__actions"><button wx:if="{{sorting}}" class="{{index === 0 || uploadBusy || busy || recoveryBusy || writeRecovery ? 'control--disabled' : ''}}" data-id="{{item.id}}" data-direction="-1" bindtap="moveImage" disabled="{{index === 0 || uploadBusy || busy || recoveryBusy || writeRecovery}}" aria-label="向前移动图片 {{index + 1}}">前移</button><button wx:if="{{sorting}}" data-id="{{item.id}}" data-direction="1" class="{{index === files.length - 1 || uploadBusy || busy || recoveryBusy || writeRecovery ? 'control--disabled' : ''}}" bindtap="moveImage" disabled="{{index === files.length - 1 || uploadBusy || busy || recoveryBusy || writeRecovery}}" aria-label="向后移动图片 {{index + 1}}">后移</button><button data-id="{{item.id}}" class="{{uploadBusy || busy || recoveryBusy || writeRecovery ? 'control--disabled' : ''}}" bindtap="removeImage" disabled="{{uploadBusy || busy || recoveryBusy || writeRecovery}}" aria-label="移除图片 {{index + 1}}"><image wx:if="{{!sorting}}" class="composer-media__remove-icon" src="/assets/icons/close-plum.svg" mode="aspectFit" aria-hidden="true"/><text wx:else>移除</text></button></view>
          </view>
          <button wx:if="{{files.length < 9}}" class="composer-add {{uploadBusy || busy || recoveryBusy || writeRecovery ? 'control--disabled' : ''}}" bindtap="addContent" disabled="{{uploadBusy || busy || recoveryBusy || writeRecovery}}" aria-label="添加照片或文字卡片，还可添加{{9 - files.length}}张"><image class="composer-add__icon" src="/assets/icons/stepper-plus-plum.svg" mode="aspectFit" aria-hidden="true"/></button>
        </view>
        </scroll-view>
        <view wx:if="{{files.length > 1}}" class="composer-media-toolbar"><button class="composer-sort {{uploadBusy || busy || recoveryBusy || writeRecovery ? 'control--disabled' : ''}}" bindtap="toggleSorting" disabled="{{uploadBusy || busy || recoveryBusy || writeRecovery}}">{{sorting ? '完成排序' : '调整顺序'}}</button></view>
        <view class="composer-field composer-field--title"><input class="composer-title-input" confirm-type="done" value="{{title}}" bindinput="editTitle" bindkeyboardheightchange="onKeyboardHeightChange" adjust-position="{{true}}" cursor-spacing="20" disabled="{{busy || uploadBusy || recoveryBusy || writeRecovery}}" maxlength="120" placeholder="添加标题" placeholder-class="composer-placeholder" aria-label="标题，选填，最多120字"/><text wx:if="{{title.length >= 100}}" class="composer-counter">{{title.length}}/120</text></view>
        <view class="composer-field composer-field--body"><textarea class="composer-body-input" value="{{body}}" focus="{{bodyFocused}}" bindinput="editBody" bindkeyboardheightchange="onKeyboardHeightChange" adjust-position="{{true}}" cursor-spacing="20" disabled="{{busy || uploadBusy || recoveryBusy || writeRecovery}}" maxlength="5000" auto-height="{{true}}" show-confirm-bar="{{true}}" confirm-type="done" placeholder="分享此刻的想法…" placeholder-class="composer-placeholder" aria-label="护理故事正文，文字和图片至少一种，最多5000字"/><text wx:if="{{body.length >= 4800}}" class="composer-counter">{{body.length}}/5000</text></view>
        <button class="composer-settings-entry {{busy || uploadBusy || recoveryBusy || writeRecovery ? 'control--disabled' : ''}}" bindtap="togglePublishSettings" disabled="{{busy || uploadBusy || recoveryBusy || writeRecovery}}" aria-label="发布设置，{{rightsConfirmed && publicConsentConfirmed ? '已确认' : '未确认'}}" aria-expanded="{{settingsExpanded}}"><text>发布设置</text><view class="composer-settings-entry__value"><text>{{rightsConfirmed && publicConsentConfirmed ? '已确认' : ''}}</text><text>›</text></view></button>
      </block>
      <view wx:if="{{state === 'hidden' || state === 'deleted'}}" class="composer-result__actions"><button class="text-button composer-action--primary" bindtap="showMyPosts">我的投稿</button><button class="text-button composer-action--quiet" bindtap="returnToCommunity">返回社区</button></view>
    </block>
  </view>
  <view wx:if="{{!listMode && !loading && postId && (state === 'draft' || state === 'rejected' || state === 'published') && !keyboardVisible}}" class="composer-actions {{!publicGateEnabled ? 'composer-actions--private' : ''}}">
    <view class="composer-actions__buttons"><button class="secondary composer-actions__save {{busy || uploadBusy || recoveryBusy || writeRecovery || imageEditRecovery ? 'secondary--disabled' : ''}}" bindtap="saveDraft" disabled="{{busy || uploadBusy || recoveryBusy || writeRecovery || imageEditRecovery}}" loading="{{operation === 'saving'}}">存草稿</button><button wx:if="{{publicGateEnabled}}" class="primary composer-actions__submit {{busy || uploadBusy || recoveryBusy || writeRecovery || imageEditRecovery || !publicGateEnabled ? 'primary--disabled' : ''}}" bindtap="submit" disabled="{{busy || uploadBusy || recoveryBusy || writeRecovery || imageEditRecovery || !publicGateEnabled}}" loading="{{operation === 'submitting'}}">发布</button></view>
    <text wx:if="{{uploadBusy || writeRecovery || imageEditRecovery}}" class="composer-actions__hint">{{uploadBusy ? '图片上传中' : writeRecovery ? '请先核对上次操作结果' : '请先重试或放弃本次图片修改'}}</text>
  </view>
  <view wx:if="{{settingsExpanded && !listMode && (state === 'draft' || state === 'rejected' || state === 'published')}}" class="composer-settings-mask" catchtap="togglePublishSettings" catchtouchmove="holdPublishSettings">
    <view class="composer-settings-sheet" catchtap="holdPublishSettings" aria-role="dialog" aria-label="发布设置" aria-modal="{{true}}"><view class="composer-settings-handle"></view><view class="composer-settings-head"><text>发布设置</text><button class="text-button composer-action--quiet" bindtap="togglePublishSettings" aria-label="完成发布设置">完成</button></view>
      <text wx:if="{{error}}" class="state state--error" aria-live="assertive">{{error}}</text>
      <view class="composer-switch-row"><view class="composer-switch-copy"><text>内容权利</text><text class="composer-help">文字和图片已获得所需授权</text></view><switch checked="{{rightsConfirmed}}" disabled="{{busy || uploadBusy || recoveryBusy || writeRecovery}}" color="#6b417b" bindchange="changeRights" aria-label="确认内容权利"/></view>
      <view class="composer-switch-row"><view class="composer-switch-copy"><text>公开展示</text><text class="composer-help">同意审核通过后在社区展示</text></view><switch checked="{{publicConsentConfirmed}}" disabled="{{busy || uploadBusy || recoveryBusy || writeRecovery}}" color="#6b417b" bindchange="changeConsent" aria-label="确认公开展示"/></view>
    </view>
  </view>
  <community-text-card id="communityTextCard" visible="{{textCardVisible}}" initial-text="{{textCardText}}" initial-template="{{textCardTemplate}}" context-key="{{textCardContext}}" bind:change="textCardChanged" bind:confirm="confirmTextCard" bind:cancel="cancelTextCard"/>
  <community-image-editor id="communityImageEditor" visible="{{photoEditorVisible}}" additional="{{photoEditorAdditional}}" initial-files="{{photoEditorFiles}}" context-key="{{photoEditorContext}}" bind:change="photoEditorChanged" bind:confirm="photoEditorConfirmed" bind:cancel="photoEditorCancelled" bind:nativebegin="photoEditorNativeBegin" bind:nativeend="photoEditorNativeEnd"/>
</view>
