<view class="management-ui manager-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">积分管理</text></view><view class="page page--stack">
<view wx:if="{{loading}}" class="state" aria-role="status">正在核对积分业务…</view><view wx:if="{{error}}" class="state state--error" aria-live="assertive"><text>{{error}}</text><button class="text-button" bindtap="load">刷新核对</button></view><view wx:if="{{notice}}" class="state" aria-live="polite">{{notice}}</view>
<view wx:if="{{commandPending}}" class="state command-recovery" aria-live="polite"><text>上次操作结果待核对</text><button class="text-button {{busy || loading || !authority ? 'control--disabled' : ''}}" bindtap="retryCommand" disabled="{{busy || loading || !authority}}" loading="{{busy}}">重试原操作</button></view><block wx:if="{{authority}}"><view wx:if="{{canFulfill}}" class="points-intro"><text class="title">积分兑换</text><text>所有在售商品按现价与积分比例兑换。</text></view>
<block wx:if="{{canFulfill}}"><view class="filters"><button wx:for="{{states}}" wx:key="id" class="text-button {{loading || busy || commandPending ? 'control--disabled' : ''}} {{state === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectState" disabled="{{loading || busy || commandPending}}">{{item.label}}</button></view>
<button wx:for="{{items}}" wx:key="id" class="card order {{busy || commandPending ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="choose" disabled="{{busy || commandPending}}"><text class="title">{{item.item.name}} × {{item.quantity}}</text><text>{{item.stateLabel}} · {{item.pointsCost}} 积分</text><text>{{item.address.recipientName}} · {{item.address.phone}}</text><text>{{item.address.province}}{{item.address.city}}{{item.address.district}}{{item.address.detail}}</text><text wx:if="{{item.trackingNumber}}">{{item.carrierName}} · {{item.trackingNumber}}</text></button><view wx:if="{{!loading && !items.length}}" class="state">当前筛选下没有兑换记录。</view><button wx:if="{{nextCursor}}" class="text-button {{loading || busy || commandPending ? 'control--disabled' : ''}}" bindtap="more" disabled="{{loading || busy || commandPending}}">更多兑换记录</button></block>
<view wx:if="{{canProduct&&!targetMemberId}}" class="card"><text class="title">购物积分</text><text>商品倍率 × 生日当月首单双倍；旧订单不变。</text><view wx:for="{{offers}}" wx:key="skuId" class="policy"><text>{{item.name}} · {{item.label}}</text><text>{{item.publicationLabel}} · 当前 {{item.shoppingPointsMultiplier}} 倍</text><view class="filters"><button class="text-button {{item.shoppingPointsMultiplier === 1 ? 'is-current' : ''}} {{busy || commandPending ? 'control--disabled' : ''}}" bindtap="multiplier" data-id="{{item.productId}}" data-multiplier="1" aria-pressed="{{item.shoppingPointsMultiplier === 1}}" disabled="{{busy || commandPending}}">1 倍</button><button class="text-button {{item.shoppingPointsMultiplier === 3 ? 'is-current' : ''}} {{busy || commandPending ? 'control--disabled' : ''}}" bindtap="multiplier" data-id="{{item.productId}}" data-multiplier="3" aria-pressed="{{item.shoppingPointsMultiplier === 3}}" disabled="{{busy || commandPending}}">3 倍</button></view></view></view><view wx:if="{{canPolicy&&!targetMemberId}}" class="card"><text class="title">积分规则与公示</text><view wx:if="{{reconciliation.length}}" class="state state--error"><text>有 {{reconciliation.length}} 个账户出现账本差异，请按审计事实核查。</text><text wx:for="{{reconciliation}}" wx:key="member_id">{{item.member_id}} · {{item.checked_at}}</text></view><view wx:for="{{policies}}" wx:key="version" class="policy"><text>{{item.version}} · {{item.stateLabel}}</text><text>生效 {{item.startsLabel}}</text><text wx:for="{{item.monthly_issuance}}" wx:key="month" wx:for-item="issuance">{{issuance.month}} 累计发放 {{issuance.issued}} 分{{issuance.overReminder ? ' · 达到预算提醒值，不影响应得奖励' : ''}}</text><text>护理 {{item.rules.daily}} · 7天 {{item.rules.streak7}} · 30天 {{item.rules.streak30}} · 每元 {{item.rules.pointsPerYuan}} 积分</text><button wx:if="{{item.state === 'draft'}}" class="text-button {{busy || commandPending ? 'control--disabled' : ''}}" bindtap="approve" data-id="{{item.version}}" disabled="{{busy || commandPending}}">复核此版本</button><button class="text-button policy-disclosure" bindtap="togglePolicy" data-id="{{item.version}}" aria-expanded="{{expandedPolicy === item.version}}">{{expandedPolicy === item.version ? '收起规则' : '查看全部规则'}}</button><view wx:if="{{expandedPolicy === item.version}}" class="rule-values"><text wx:for="{{ruleFields}}" wx:key="id" wx:for-item="rule">{{rule.label}}：{{item.rules[rule.id]}}</text></view></view><button class="text-button {{busy || commandPending ? 'control--disabled' : ''}}" bindtap="openPolicy" disabled="{{busy || commandPending}}">起草未来规则</button></view>
<view wx:if="{{canFeature&&!targetMemberId}}" class="card"><text class="title">体验笔记精选加分</text><input placeholder="填写已公开笔记编号" value="{{postId}}" data-field="postId" bindinput="input" maxlength="36" disabled="{{busy || commandPending}}"/><textarea placeholder="至少4字，填写精选依据" value="{{featureReason}}" data-field="featureReason" bindinput="input" maxlength="500" disabled="{{busy || commandPending}}"/><button class="text-button {{busy || commandPending ? 'control--disabled' : ''}}" bindtap="feature" disabled="{{busy || commandPending}}">确认精选</button></view></block>
</view><view wx:if="{{selected || policyOpen}}" class="sheet"><scroll-view scroll-y class="sheet-scroll"><button class="text-button {{busy || commandPending ? 'control--disabled' : ''}}" bindtap="close" disabled="{{busy || commandPending}}">关闭</button><text wx:if="{{error}}" class="state state--error">{{error}}</text><block wx:if="{{selected}}"><text class="title">{{selected.item.name}} · {{selected.stateLabel}}</text><block wx:if="{{selected.state === 'placed'}}"><input placeholder="真实承运商名称" value="{{carrier}}" data-field="carrier" bindinput="input" disabled="{{busy || commandPending}}"/><input placeholder="真实运单号" value="{{tracking}}" data-field="tracking" bindinput="input" disabled="{{busy || commandPending}}"/></block><textarea wx:if="{{selected.state === 'placed' || selected.state === 'return_requested'}}" placeholder="至少4字，填写交接或退货核对说明" value="{{reason}}" data-field="reason" bindinput="input" disabled="{{busy || commandPending}}"/><button wx:if="{{selected.state === 'placed' || selected.state === 'return_requested'}}" class="primary {{busy || commandPending ? 'primary--disabled' : ''}}" bindtap="fulfill" disabled="{{busy || commandPending}}">{{selected.state === 'placed' ? '登记发货' : '确认退货并退回积分'}}</button></block>
<block wx:if="{{policyOpen}}"><text class="title">起草积分规则</text><input placeholder="规则版本，至少8位英文/数字" value="{{policyVersion}}" data-field="policyVersion" bindinput="input" disabled="{{busy || commandPending}}"/><input placeholder="生效北京时间 YYYY-MM-DD HH:mm" value="{{startsAt}}" data-field="startsAt" bindinput="input" disabled="{{busy || commandPending}}"/><view wx:for="{{ruleFields}}" wx:key="id" class="rule-row"><text>{{item.label}}</text><input type="number" value="{{item.value}}" data-id="{{item.id}}" bindinput="ruleInput" disabled="{{busy || commandPending || item.id === 'pointsPerYuan'}}"/></view><button class="primary {{busy || commandPending ? 'primary--disabled' : ''}}" bindtap="propose" disabled="{{busy || commandPending}}">提交复核</button></block></scroll-view></view></view>
