.manager-root{min-height:100vh;padding-top:var(--chrome-top,0px);background:#f7f1f8;color:#392940;}.card{display:flex;flex-direction:column;gap:16rpx;padding:32rpx;border-radius:24rpx;background:#fff;text-align:left;font-size:26rpx;line-height:1.6;word-break:break-all;}.title{font-size:32rpx;font-weight:600;}.order{width:100%;border:0;}.filters{display:flex;gap:12rpx;flex-wrap:wrap;}.selected{background:#ece0ef;}.policy{padding:20rpx 0;border-bottom:1rpx solid #e9e0ed;display:flex;flex-direction:column;gap:10rpx;}.rule-values{display:flex;flex-direction:column;font-size:24rpx;color:#726579;}.sheet{position:fixed;inset:0;background:#f7f1f8;z-index:100;display:flex;flex-direction:column;padding-top:calc(env(safe-area-inset-top) + 36px);}.sheet-scroll{height:100%;box-sizing:border-box;}.rule-row{padding:20rpx 32rpx;display:flex;flex-direction:column;gap:12rpx;}.primary{margin:24rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);min-height:96rpx;background:#684071;color:#fff;border-radius:20rpx;}input,textarea{box-sizing:border-box;width:100%;min-height:96rpx;padding:20rpx;background:#fff;border:1rpx solid #d9cddd;border-radius:16rpx;font-size:28rpx;}.sheet .title{display:block;padding:20rpx 32rpx;}.sheet input,.sheet textarea{margin-bottom:16rpx;}.text-button{min-height:96rpx;}
