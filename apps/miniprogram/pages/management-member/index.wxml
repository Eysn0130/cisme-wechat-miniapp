<view class="member-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">成员详情</text></view>
  <view class="page page--stack member-page"><view wx:if="{{loading}}" class="state" aria-live="polite">正在加载成员详情…</view><view wx:if="{{error}}" class="state state--error" aria-live="assertive"><text>{{error}}</text><button class="text-button" bindtap="load">重新加载</button></view>
    <block wx:if="{{detail && !loading}}"><view class="member-hero"><text class="eyebrow">CISME MEMBER</text><text class="ux-strong">{{detail.member.displayName}}</text><text class="ux-small">{{detail.member.commercialEligible?'商业会员':detail.member.membershipState==='active'?'资格未生效或不可用':detail.member.membershipState==='suspended'?'资格暂停':detail.member.membershipState==='expired'?'资格到期':'普通用户'}} · {{detail.member.accountStatus==='active'?'账号正常':'账号受限'}}</text></view>
      <view class="member-tabs" aria-role="tablist" aria-label="成员详情分类"><button wx:for="{{sections}}" wx:key="id" data-section="{{item.id}}" bindtap="selectSection" class="{{section===item.id?'is-active':''}}" aria-role="tab" aria-selected="{{section===item.id}}">{{item.label}}</button></view>
      <view wx:if="{{section==='overview'}}" class="member-panel"><view class="member-fact"><text>商业资格</text><text class="ux-strong">{{detail.member.commercialEligible?'有效':detail.member.membershipState==='none'?'未开通':detail.member.membershipState==='suspended'?'已暂停':'未生效或已到期'}}</text></view><view wx:if="{{detail.scope.referrals}}" class="member-fact"><text>推荐码</text><text class="ux-strong">{{detail.member.referralCode||'尚未生成'}}</text></view><view wx:if="{{detail.rate}}" class="member-fact"><text>当前费率</text><text class="ux-strong">{{detail.rate.basisPoints/100}}%</text></view><text wx:if="{{detail.rate}}" class="member-caveat">费率在订单创建时快照；历史订单不会随调整重算。</text><view wx:if="{{canManageMembership || canManageRate}}" class="member-actions"><button wx:if="{{canManageMembership}}" data-state="active" class="{{busy ? 'control--disabled' : ''}}" bindtap="changeMembership" disabled="{{busy}}">授予／续期一年</button><button wx:if="{{canManageMembership}}" data-state="suspended" class="{{busy || detail.member.membershipState!=='active' ? 'control--disabled' : ''}}" bindtap="changeMembership" disabled="{{busy || detail.member.membershipState!=='active'}}">暂停资格</button><button wx:if="{{canManageRate}}" class="{{busy ? 'control--disabled' : ''}}" bindtap="proposeRate" disabled="{{busy}}">提议调整费率</button></view></view>
      <view wx:elif="{{section==='referrals'}}" class="member-panel"><text class="member-panel__title ux-strong">直接推荐 · {{referrals.length}}</text><text wx:if="{{!referrals.length}}" class="member-empty">尚无已确认的直接推荐关系。</text><view wx:for="{{referrals}}" wx:key="id" class="member-list-row"><text class="ux-strong">{{item.displayName}}</text><text class="ux-small">{{item.orderCount}} 笔归因订单 · 不展示电话、地址和私聊</text></view></view>
      <view wx:elif="{{section==='orders'}}" class="member-panel"><text class="member-panel__title ux-strong">归因订单</text><text class="member-caveat">待支付、取消和合成订单均不形成可结算佣金。</text><text wx:if="{{!orders.length}}" class="member-empty">暂无归因订单。</text><view wx:for="{{orders}}" wx:key="id" class="member-list-row"><text class="ux-strong">{{item.productName||'商品'}} · {{item.amount}}</text><text class="ux-small">{{item.orderNumber}} · {{item.status==='pending_payment'?'待支付':item.status==='cancelled'?'已取消':item.status==='paid'?'已支付，待履约':'已超时'}}</text></view></view>
      <view wx:else class="member-panel"><text class="member-panel__title ux-strong">公开内容</text><text wx:if="{{!posts.length}}" class="member-empty">暂无公开护理故事。</text><view wx:for="{{posts}}" wx:key="id" class="member-list-row"><text class="ux-strong">{{item.title}}</text><text class="ux-small">已公开 · 审核内容需另行授权查看</text></view></view>
      <view wx:if="{{actionStatus}}" class="state" aria-live="polite">{{actionStatus}}</view><view wx:if="{{actionError}}" class="state state--error" aria-live="assertive">{{actionError}}</view>
    </block>
  </view></view>
