.member-page{padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 56px));padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 50rpx);background:#f7f2f8}.member-hero{padding:28rpx;border-radius:28rpx;color:#fff;background:linear-gradient(145deg,#765a87,#43334e)}.member-hero text,.member-hero .ux-strong,.member-hero .ux-small{display:block}.member-hero .eyebrow{color:#e2d3e7}.member-hero .ux-strong{margin-top:12rpx;font:42rpx/1.3 Songti SC,serif}.member-hero .ux-small{margin-top:10rpx;color:#eadfec;font-size:23rpx}.member-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:4rpx;margin:24rpx 0 14rpx;padding:5rpx;border-radius:18rpx;background:#eee6f1}.member-tabs button{min-height:88rpx;padding:0;border:0;border-radius:14rpx;color:#746a78;background:transparent;font-size:24rpx}.member-tabs .is-active{color:#533b62;background:#fff;box-shadow:0 4rpx 12rpx rgba(70,44,80,.08)}.member-panel{padding:24rpx;border:1rpx solid #ece4ee;border-radius:26rpx;background:#fff}.member-panel__title{color:#46374d;font-size:29rpx}.member-fact{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:90rpx;border-bottom:1rpx solid #eee7f0}.member-fact text{color:#776d7b;font-size:24rpx}.member-fact .ux-strong{min-width:0;overflow-wrap:anywhere;color:#46374d;font-size:26rpx;font-weight:500;text-align:right}.member-caveat,.member-empty{display:block;margin-top:18rpx;color:#756a79;font-size:22rpx;line-height:1.55}.member-actions{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:24rpx}.member-actions button{display:flex;align-items:center;justify-content:center;min-height:88rpx;padding:10rpx 16rpx;border:1rpx solid #d9c9df;border-radius:18rpx;color:#563c67;background:#f5eef7;font-size:23rpx;line-height:1.3}.member-actions button:first-child{color:#fff;background:#624674}.member-actions button:disabled{opacity:.45}.member-list-row{padding:22rpx 0;border-bottom:1rpx solid #eee7f0}.member-list-row:last-child{border:0}.member-list-row .ux-strong,.member-list-row .ux-small{display:block}.member-list-row .ux-strong{color:#46374d;font-size:26rpx;font-weight:500;line-height:1.4}.member-list-row .ux-small{margin-top:8rpx;color:#817687;font-size:22rpx;line-height:1.5}
.member-list-button{display:block;width:100%;min-height:88rpx;margin:0;padding:22rpx 0;border-left:0;border-right:0;border-top:0;border-radius:0;background:transparent;text-align:left}.member-order-modes{display:flex;gap:12rpx;margin-bottom:22rpx}.member-order-modes button{flex:1;min-height:88rpx;border:1rpx solid #d9c9df;border-radius:16rpx;background:#f7f2f8;color:#5b4a64;font-size:24rpx}.member-order-modes .is-active{background:#624674;color:#fff}
.rate-form-backdrop{position:fixed;inset:0;z-index:1000;background:rgba(31,20,38,.48)}.rate-form-sheet{position:fixed;right:0;bottom:0;left:0;z-index:1001;box-sizing:border-box;padding:0 28rpx calc(env(safe-area-inset-bottom) + 22rpx);border-radius:30rpx 30rpx 0 0;background:#fff;box-shadow:0 -12rpx 48rpx rgba(37,21,46,.18)}.rate-form-heading{display:flex;align-items:center;justify-content:space-between;min-height:104rpx;border-bottom:1rpx solid #eee7f0;color:#43334e;font-size:32rpx;font-weight:600}.rate-form-heading button{display:flex;align-items:center;justify-content:center;min-width:88rpx;min-height:88rpx;margin:0;padding:0;color:#6c5c70;background:transparent;font-size:24rpx;line-height:1.2}.rate-form-scroll{max-height:55vh}.rate-form-member,.rate-form-current,.rate-form-label,.rate-form-hint{display:block}.rate-form-member{margin-top:24rpx;color:#43334e;font-size:29rpx;font-weight:600}.rate-form-current{margin-top:6rpx;color:#756b78;font-size:24rpx;line-height:1.5}.rate-form-label{margin:26rpx 0 10rpx;color:#574a5e;font-size:24rpx;font-weight:600}.rate-form-modes,.rate-form-time{display:flex;gap:12rpx}.rate-form-modes button{flex:1;min-height:88rpx;margin:0;border:1rpx solid #d8c9dd;border-radius:16rpx;background:#fbf9fc;color:#594964;font-size:25rpx}.rate-form-modes .is-active{border-color:#725582;background:#f1e9f4;color:#51345f}.rate-form-input,.rate-form-picker,.rate-form-sheet textarea{box-sizing:border-box;width:100%;min-height:88rpx;padding:18rpx 20rpx;border:1rpx solid #d8c9dd;border-radius:16rpx;background:#fff;color:#46374d;font-size:27rpx}.rate-form-input{display:flex;align-items:center;gap:12rpx}.rate-form-input input{flex:1;min-width:0;height:52rpx;font-size:27rpx}.rate-form-time picker{flex:1;min-width:0}.rate-form-picker{display:flex;align-items:center}.rate-form-sheet textarea{min-height:140rpx;line-height:1.5}.rate-form-hint{margin:12rpx 0 16rpx;color:#756b78;font-size:23rpx;line-height:1.5}.rate-form-footer{display:flex;gap:12rpx;padding-top:14rpx}.rate-form-footer button{flex:1;min-height:88rpx;margin:0;border-radius:17rpx;font-size:26rpx}.rate-form-cancel{border:1rpx solid #d8c9dd;background:#fff;color:#5d4b65}.rate-form-submit{background:#624674;color:#fff}
.rate-form-scroll{padding-bottom:12rpx}

.member-page .state--error .text-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;min-height:44px;margin:12px 0 0;padding:10px 16px;border:1rpx solid #d8c9dd;border-radius:12px;background:#fff;color:#56306f;font-size:14px;line-height:1.4;text-align:center;white-space:normal}

.member-tabs button,.member-order-modes button,.rate-form-modes button,.rate-form-footer button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:0;min-height:44px;margin:0;padding:10px 6px;line-height:1.4;white-space:normal}
