.member-page{padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 56px));padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 50rpx);background:#f7f2f8}.member-hero{padding:28rpx;border-radius:28rpx;color:#fff;background:linear-gradient(145deg,#765a87,#43334e)}.member-hero text,.member-hero .ux-strong,.member-hero .ux-small{display:block}.member-hero .eyebrow{color:#e2d3e7}.member-hero .ux-strong{margin-top:12rpx;font:42rpx/1.3 Songti SC,serif}.member-hero .ux-small{margin-top:10rpx;color:#eadfec;font-size:23rpx}.member-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:4rpx;margin:24rpx 0 14rpx;padding:5rpx;border-radius:18rpx;background:#eee6f1}.member-tabs button{min-height:76rpx;padding:0;border:0;border-radius:14rpx;color:#746a78;background:transparent;font-size:24rpx}.member-tabs .is-active{color:#533b62;background:#fff;box-shadow:0 4rpx 12rpx rgba(70,44,80,.08)}.member-panel{padding:24rpx;border:1rpx solid #ece4ee;border-radius:26rpx;background:#fff}.member-panel__title{color:#46374d;font-size:29rpx}.member-fact{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:90rpx;border-bottom:1rpx solid #eee7f0}.member-fact text{color:#776d7b;font-size:24rpx}.member-fact .ux-strong{min-width:0;overflow-wrap:anywhere;color:#46374d;font-size:26rpx;font-weight:500;text-align:right}.member-caveat,.member-empty{display:block;margin-top:18rpx;color:#756a79;font-size:22rpx;line-height:1.55}.member-actions{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:24rpx}.member-actions button{display:flex;align-items:center;justify-content:center;min-height:88rpx;padding:10rpx 16rpx;border:1rpx solid #d9c9df;border-radius:18rpx;color:#563c67;background:#f5eef7;font-size:23rpx;line-height:1.3}.member-actions button:first-child{color:#fff;background:#624674}.member-actions button:disabled{opacity:.45}.member-list-row{padding:22rpx 0;border-bottom:1rpx solid #eee7f0}.member-list-row:last-child{border:0}.member-list-row .ux-strong,.member-list-row .ux-small{display:block}.member-list-row .ux-strong{color:#46374d;font-size:26rpx;font-weight:500;line-height:1.4}.member-list-row .ux-small{margin-top:8rpx;color:#817687;font-size:22rpx;line-height:1.5}
