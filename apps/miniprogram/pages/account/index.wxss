@import "../../styles/action-hierarchy.wxss";

.account-root{min-height:100vh;background:#faf7fb}
.account-topbar{border:0;background:transparent;pointer-events:none}
.account-topbar__back{border-color:rgba(255,255,255,.42);background:rgba(40,19,51,.22);pointer-events:auto}
.account-page{display:flex;flex-direction:column;min-height:100vh;padding:0 0 calc(env(safe-area-inset-bottom) + 24px);background:#faf7fb;text-align:left}

.account-hero{position:relative;flex:none;width:100%;height:100vw;overflow:hidden;background:#321538}
.account-hero__art{position:absolute;top:0;left:0;width:100%;height:100%}
.account-hero__halo{position:absolute;top:47%;right:2%;width:28%;height:28%;border-radius:50%;background:radial-gradient(circle,rgba(255,238,255,.42),rgba(231,185,250,.12) 42%,rgba(231,185,250,0) 72%);opacity:0;pointer-events:none}
.account-hero__copy{position:absolute;top:calc(var(--cisme-topbar-height, 72px) - 6px);right:24rpx;left:24rpx;display:flex;align-items:center;flex-direction:column;color:#fff;text-align:center;text-shadow:0 1px 10px rgba(35,12,46,.22)}
.account-hero__brand{padding-left:7px;font-family:"Times New Roman","Songti SC",serif;font-size:21px;font-weight:300;letter-spacing:7px;line-height:1.2}
.account-hero__rule{width:28px;height:1px;margin-top:14px;background:rgba(255,244,255,.8)}
.account-hero__title{display:block;margin-top:19px;font-family:"Songti SC","STSong",serif;font-size:80rpx;font-weight:400;letter-spacing:2rpx;line-height:1.3;white-space:nowrap}
.account-hero__description{display:flex;align-items:center;flex-direction:column;margin-top:18px;color:rgba(245,225,247,.86);font-size:15px;line-height:1.65;white-space:nowrap}
.account-hero--animated .account-hero__copy{animation:account-hero-enter .65s cubic-bezier(.22,.8,.22,1) both}
.account-hero--animated .account-hero__halo{animation:account-hero-breathe 5.4s ease-in-out .7s infinite}

.account-content{box-sizing:border-box;width:100%;min-height:calc(100vh - 100vw);padding:0 26rpx;background:linear-gradient(180deg,#f3e8f8,#faf7fb 180px)}
.account-consent{width:100%;margin-top:2px;padding:0 8rpx}
.account-agreement__selector{width:100%}
.account-agreement__label{display:flex;align-items:center;gap:14rpx;min-height:44px}
.account-checkbox{flex:0 0 auto;width:44rpx;height:44rpx;transform:none}
.account-checkbox .wx-checkbox-input{box-sizing:border-box;width:40rpx;height:40rpx;margin:2rpx;border-color:#b8a9c0;border-radius:8rpx;background:rgba(255,255,255,.8)}
.account-row__title{color:#45304f;font-size:30rpx;font-weight:600;line-height:22px}
.account-legal-links{display:flex;flex-wrap:wrap;gap:0 20rpx;margin-left:58rpx}
.account-legal-entry{display:flex;align-items:center;justify-content:flex-start;flex:0 0 auto;min-height:44px;margin:0;padding:0 2rpx;border:0;border-radius:0;color:#4f206c;background:transparent;font-size:28rpx;font-weight:600;line-height:20px;white-space:nowrap;text-decoration:underline;text-underline-offset:4rpx}
.account-row__meta{display:block;margin:0 0 0 58rpx;color:#827489;font-size:24rpx;line-height:20px}
.account-cross-border{margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid var(--cisme-line)}
.account-cross-border>.account-legal-entry{margin-left:58rpx}
.account-phone-note{display:block;width:100%;margin-top:34rpx;padding:0;color:#82748a;font-size:26rpx;line-height:20px;text-align:left}
.account-login{flex:none;width:100%;height:auto;min-height:50px;margin-top:20rpx;padding:12rpx 24rpx;border-radius:999px}
.account-login .action-label{font-size:31rpx;font-weight:600}
.account-login.primary--disabled{border-color:#ded4e2!important;color:#796b80!important;background:linear-gradient(90deg,#e9e1ec,#e4d9e8)!important;box-shadow:inset 0 1px 3px rgba(73,42,82,.05)!important}
.account-login.primary--disabled .action-label{color:#796b80}
.account-browse{flex:none;width:100%;height:auto;min-height:44px;margin-top:10rpx;color:#51216d}
.account-browse .action-label{font-size:29rpx;font-weight:600}
.account-avatar{display:flex;align-items:center;justify-content:center;width:96rpx;height:96rpx;margin:0 auto 16rpx;border-radius:50%;background:#eee5f0}
.account-avatar__image{width:70rpx;height:70rpx}
.account-avatar-canvas{position:fixed;left:-9999px;top:0;width:256px;height:256px;pointer-events:none}
.account-notice{width:100%;margin-top:18rpx;color:#796a80;font-size:26rpx;line-height:1.6;text-align:left}
.account-help,.account-legal-retry{width:100%;min-height:44px;margin-top:12rpx}
.account-legal-status--error{color:#873954}

@keyframes account-hero-enter{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes account-hero-breathe{0%,100%{opacity:.16;transform:scale(.96)}50%{opacity:.45;transform:scale(1.05)}}
@media (max-height:700px){
  .account-phone-note{margin-top:20rpx}
  .account-login{margin-top:12rpx}
}
@media (max-width:340px){
  .account-hero__description{margin-top:12px;font-size:13px}
  .account-legal-links{gap:0 8rpx}
  .account-legal-entry{font-size:25rpx}
  .account-row__title{font-size:27rpx}
}
@media (prefers-reduced-motion:reduce){
  .account-hero--animated .account-hero__copy,.account-hero--animated .account-hero__halo{animation:none}
}
