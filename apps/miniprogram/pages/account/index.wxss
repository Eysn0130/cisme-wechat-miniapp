.account-page { display:flex; align-items:center; flex-direction:column; min-height:100vh; padding-right:30rpx; padding-left:30rpx; background:radial-gradient(circle at 88% 4%,rgba(226,210,234,.52),transparent 28%),linear-gradient(180deg,#f7f1f8,#fbf8fb); text-align:center; }.account-topbar__copy { display:flex; align-items:center; flex-direction:column; }.account-topbar__subtitle { margin-top:4rpx; color:#968b98; font-size:var(--cisme-text-small); line-height:1.5; }
.account-icon { display:flex; align-items:center; justify-content:center; width:152rpx; height:152rpx; margin-top:28rpx; border:1rpx solid rgba(255,255,255,.94); border-radius:50%; background:rgba(236,225,243,.72); box-shadow:inset 0 4rpx 24rpx rgba(255,255,255,.85),0 20rpx 50rpx rgba(55,36,67,.11); }.account-icon__image { width:76rpx; height:76rpx; }.account-eyebrow { margin-top:30rpx; color:#806c8a; font:600 var(--cisme-text-small) -apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif; letter-spacing:6rpx; }.account-title { margin-top:26rpx; color:#3b2e41; font-family:"Songti SC","STSong",serif; font-size:50rpx; font-weight:400; line-height:1.5; }.account-title__line { display:block; }.account-subtitle { max-width:620rpx; margin-top:20rpx; color:#807584; font-size:var(--cisme-text-body); line-height:1.7; }
.account-card { width:100%; margin-top:48rpx; padding:8rpx 28rpx; overflow:hidden; border-radius:48rpx; text-align:left; }.account-row { display:flex; align-items:center; gap:18rpx; min-height:104rpx; border-bottom:1rpx solid rgba(78,47,91,.1); }.account-row__copy { flex:1; min-width:0; }.account-row__title,.account-row__meta { display:block; }.account-row__title { color:#493b4d; font-size:var(--cisme-text-small); font-weight:400; line-height:1.5; }.account-row__meta { margin-top:8rpx; color:#8e8492; font-size:var(--cisme-text-small); line-height:1.5; }.account-row__qualifier { color:#795a85; font-size:var(--cisme-text-small); font-style:normal; }.account-row__icon { display:flex; align-items:center; justify-content:center; flex:0 0 auto; width:60rpx; height:60rpx; border:1rpx solid rgba(86,48,111,.14); border-radius:50%; color:#6d4b7c; background:#ece2f1; font:var(--cisme-text-micro) Georgia,serif; }.account-row__glyph { width:32rpx; height:32rpx; }.account-row__icon.is-primary { background:#68447d; }.account-row__icon.is-primary .account-row__glyph { filter:brightness(0) invert(1); }.account-gate { flex:0 0 auto; padding:10rpx 14rpx; border-radius:22rpx; color:#735a7c; background:#eee5f2; font-size:var(--cisme-text-small); line-height:1; }.account-agreement { gap:12rpx; }.account-agreement__selector { flex:1; min-width:0; }.account-agreement__label { display:flex; align-items:center; gap:18rpx; width:100%; min-height:128rpx; }.account-checkbox { flex:0 0 auto; width:60rpx; height:60rpx; transform:none; }.account-checkbox .wx-checkbox-input { width:38rpx; height:38rpx; margin:10rpx; border-radius:12rpx; }.account-legal-entry { display:flex; align-items:center; justify-content:center; flex:0 0 auto; min-width:88rpx; min-height:44px; margin:0; padding:0 8rpx; border:0; color:#6f517b; background:transparent; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif; font-size:var(--cisme-text-small); font-weight:400; line-height:20px; text-decoration:underline; }
.account-safety { display:flex; align-items:flex-start; gap:18rpx; width:100%; margin-top:26rpx; padding:26rpx; border-radius:38rpx; color:#776b7b; background:rgba(236,228,241,.64); font-size:var(--cisme-text-body); line-height:1.6; text-align:left; }.account-safety__icon { flex:0 0 auto; width:36rpx; height:36rpx; margin-top:1rpx; }.account-login { flex:0 0 50px; height:50px; margin-top:36rpx; padding-top:0; padding-bottom:0; font-size:var(--cisme-text-action); line-height:20px; }.account-browse { flex:0 0 50px; height:50px; margin-top:18rpx; padding-top:0; padding-bottom:0; font-size:var(--cisme-text-action); line-height:20px; }

@media (max-height:820px) {
  .account-card { margin-top:32rpx; }
  .account-row__meta { margin-top:4rpx; line-height:1.4; }
  .account-safety { margin-top:18rpx; padding:20rpx; line-height:1.5; }
  .account-login { margin-top:24rpx; }
  .account-browse { margin-top:12rpx; }
}

.account-row { min-height:152rpx; padding:24rpx 0; box-sizing:border-box; }
.account-agreement__label { min-height:0; }
.account-safety { align-items:center; }
.account-safety__icon { width:18px; height:18px; margin-top:0; }
