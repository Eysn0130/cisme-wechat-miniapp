<view class="chrome-root" style="{{chromeStyle}}">
<view class="topbar account-topbar"><button class="topbar__back {{leavePromptOpen || leaving || avatarBusy ? 'control--disabled' : ''}}" bindtap="back" disabled="{{leavePromptOpen || leaving || avatarBusy}}" aria-label="{{leaving ? '正在返回来源页面' : loading ? '停止等待并返回' : '返回'}}"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><view class="account-topbar__copy"><text class="topbar__title">会员账号</text><small class="account-topbar__subtitle">登录 / 注册</small></view></view>
<view class="page page--stack account-page">
  <view class="account-icon"><image class="account-icon__image" src="{{avatarUrl}}" mode="aspectFit"/></view>
  <text class="account-eyebrow">CISME MEMBER</text>
  <view class="account-title"><text class="account-title__line">留住每次护理</text></view>
  <view class="account-subtitle">{{loginStage === 'avatar' ? '登录成功。选择微信头像后自动保存，也可稍后设置。' : phoneBindingEnabled ? '首次登录自动注册，微信弹窗确认所选手机号。' : '首次登录自动注册，也可先浏览公开社区。'}}</view>

  <view wx:if="{{loginStage === 'login'}}" class="glass account-card">
    <view class="account-row"><view class="account-row__icon">1</view><view class="account-row__copy"><strong class="account-row__title">微信身份登录</strong><small class="account-row__meta">阅读并勾选协议后，点击下方登录</small></view></view>
    <view class="account-row account-agreement {{loading || leaving || !legalTextsReady ? 'control--disabled' : ''}}"><checkbox-group class="account-agreement__selector" bindchange="toggleAgreement"><label class="account-agreement__label"><checkbox class="account-checkbox" value="accepted" checked="{{agreementAccepted}}" disabled="{{loading || leaving || !legalTextsReady}}" color="#56306f" /><view class="account-row__copy"><strong class="account-row__title">我已阅读并同意必选协议 <em class="account-row__qualifier">必选</em></strong><small class="account-row__meta">{{identityCommitStarted ? '身份请求已提交，本次同意在结果返回前不可更改' : localLegalFixture ? '仅供本地测试，正式协议尚未发布' : legalTextsReady ? '基础服务协议不捆绑公开展示或营销授权' : legalLoading ? '正在读取当前协议…' : '当前协议暂不可用，请稍后重试'}}</small></view></label></checkbox-group><button class="account-legal-entry {{loading || leaving ? 'control--disabled' : ''}}" bindtap="openLegalDocuments" disabled="{{loading || leaving}}" aria-label="选择查看用户协议或隐私保护指引">查看协议</button></view>
    <view wx:if="{{crossBorderRequired}}" class="account-row account-agreement"><checkbox-group class="account-agreement__selector" bindchange="toggleCrossBorder"><label class="account-agreement__label"><checkbox class="account-checkbox" value="accepted" checked="{{crossBorderAccepted}}" disabled="{{loading || leaving}}" color="#56306f"/><view class="account-row__copy"><strong class="account-row__title">同意个人信息境外存储</strong><small class="account-row__meta">单独选择；不同意可继续浏览公开社区</small></view></label></checkbox-group><button class="account-legal-entry {{loading || leaving ? 'control--disabled' : ''}}" bindtap="openCrossBorder" disabled="{{loading || leaving}}">查看告知</button></view>

  </view>

  <view class="account-safety"><image class="account-safety__icon" src="/assets/icons/shield-check-plum.svg" mode="aspectFit"/><text>使用微信身份保存护理记录，无需提供手机号。</text></view>
  <button wx:if="{{!legalLoading && !legalTextsReady}}" class="text-button account-legal-retry" bindtap="syncLegalDocuments">重试读取协议</button>
  <view wx:if="{{notice}}" class="account-notice" aria-live="polite">{{notice}}</view>
  <canvas type="2d" id="member-avatar-canvas" class="account-avatar-canvas" aria-hidden="true"/>
  <view wx:if="{{error}}" id="account-error-summary" class="state state--error" aria-live="assertive" aria-atomic="true"><text class="state-error__copy">{{error}}</text></view>
  <button wx:if="{{accountHelpAvailable}}" class="text-button account-help {{accountHelpBusy ? 'text-button--disabled' : ''}}" bindtap="openAccountHelp" loading="{{accountHelpBusy}}" disabled="{{accountHelpBusy}}">继续处理历史隐私请求</button>
  <button class="primary account-login {{loading || leaving || avatarBusy || (!pendingDestination && (!legalTextsReady || !agreementAccepted || (crossBorderRequired && !crossBorderAccepted))) ? 'primary--disabled' : ''}}" loading="{{loading || avatarBusy}}" disabled="{{loading || leaving || avatarBusy || (!pendingDestination && (!legalTextsReady || !agreementAccepted || (crossBorderRequired && !crossBorderAccepted)))}}" open-type="{{loginStage === 'avatar' ? 'chooseAvatar' : phoneBindingEnabled && !pendingDestination ? 'getPhoneNumber' : ''}}" bindtap="loginTap" bindgetphonenumber="loginWithPhone" bindchooseavatar="chooseLoginAvatar"><text class="action-label">{{loginStage === 'avatar' ? '使用微信头像并继续' : pendingDestination ? '继续使用' : legalTextsReady ? '登录' : legalLoading ? '正在读取协议…' : '协议暂不可用'}}</text></button>
  <button class="secondary account-browse {{leavePromptOpen || leaving || avatarBusy ? 'secondary--disabled' : ''}}" bindtap="browseCommunity" disabled="{{leavePromptOpen || leaving || avatarBusy}}"><text class="action-label">{{loginStage === 'avatar' ? '稍后设置，继续使用' : identityCommitStarted ? '身份请求已发送，仍然离开' : loading ? '停止等待，浏览公开社区' : '暂不登录，浏览公开社区'}}</text></button>
</view>
</view>
