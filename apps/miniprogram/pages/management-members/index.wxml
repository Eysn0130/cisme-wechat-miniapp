<view class="chrome-root users-root" style="{{chromeStyle}}">
 <view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">用户管理</text></view>
 <view class="users-page">
  <view class="users-between users-summary"><text class="users-count">{{administratorSelecting?'选择会员':resultReady?'共 '+total+' 人':'用户'}}</text><view class="users-actions"><button wx:if="{{scope.administrators}}" class="action-text" bindtap="administratorSelect">{{administratorSelecting?'取消':'新增管理员'}}</button><button wx:if="{{scope}}" class="action-text" bindtap="commercial">商业会员与费率</button></view></view>
  <view class="users-search"><input value="{{q}}" bindinput="editSearch" bindconfirm="search" confirm-type="search" placeholder="{{scope.contact?'昵称 / 编号 / 手机号':'昵称 / 编号'}}" maxlength="80" aria-label="搜索用户"/><button class="action-text {{filtered?'is-active':''}} {{!scope||exporting?'control--disabled':''}}" bindtap="openFilter" disabled="{{!scope||exporting}}">筛选{{filtered?' ·':''}}</button></view>
  <section-tabs items="{{tabs}}" value="{{query.view}}" bindchange="changeView" label="用户管理维度"/>
  <view class="users-between users-toolbar"><text class="users-muted">{{sortLabel}}</text><view class="users-actions"><button wx:if="{{scope.export}}" class="action-text" bindtap="toggleSelect">{{selecting?'取消选择':'选择'}}</button><button class="action-text {{!scope?'control--disabled':''}}" bindtap="openFields" disabled="{{!scope}}">字段</button><button wx:if="{{scope.export}}" class="action-text {{exporting||loading||!total?'control--disabled':''}}" bindtap="exportUsers" disabled="{{exporting||loading||!total}}" loading="{{exporting}}">导出</button></view></view>
  <view wx:if="{{error}}" class="users-error" aria-role="alert"><text>{{error}}</text><button class="action-text" bindtap="retry">重试</button></view>
  <view wx:if="{{loading&&!items.length}}" class="users-skeleton" aria-role="status" aria-label="加载用户"><view wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this"/></view>
  <scroll-view wx:if="{{items.length}}" class="users-table" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
   <view class="users-table-inner"><view class="users-table-row users-table-head"><view class="users-identity">用户</view><view wx:for="{{fields}}" wx:key="id" class="users-cell" style="width:{{item.width}}px">{{item.label}}</view><view class="users-cell users-detail-cell"/></view>
    <view wx:for="{{items}}" wx:key="id" class="users-table-row {{item.selected?'users-row-selected':''}}">
     <button class="users-identity users-person" bindtap="tapPerson" data-id="{{item.id}}" aria-label="{{selecting?'选择':'查看'}}{{item.displayName}}"><text wx:if="{{selecting}}" class="users-check {{item.selected?'checked':''}}">{{item.selected?'✓':''}}</text><image wx:else class="users-avatar" src="{{item.avatar||'/assets/icons/user-circle-plum.svg'}}" mode="aspectFill"/><view class="users-person-copy"><text class="users-name">{{item.displayName}}</text><text class="users-number">{{item.cardNumber||'编号待生成'}}</text><text wx:if="{{item.administrator}}" class="users-role">{{item.highestAdministrator?'最高管理员':'管理员'}}</text></view></button>
     <view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="id" class="users-cell {{cell.id==='points'||cell.id==='paid'||cell.id==='net'?'users-numeric':''}}" style="width:{{cell.width}}px">{{cell.value}}</view>
     <button class="users-cell users-detail-cell action-text" data-id="{{item.id}}" bindtap="inspect">{{administratorSelecting?'设置':'详情'}}</button>
    </view>
   </view>
  </scroll-view>
  <view wx:if="{{!loading&&!error&&!items.length}}" class="users-empty">{{query.q||filtered?'没有匹配的用户':'暂无用户'}}</view>
  <view wx:if="{{selecting}}" class="users-selection">已选 {{selected.length}} 人<button class="action-text {{!selected.length||exporting?'control--disabled':''}}" bindtap="exportUsers" disabled="{{!selected.length||exporting}}">导出所选</button></view>
  <view wx:if="{{moreError}}" class="users-error"><text>{{moreError}}</text><button class="action-text" bindtap="more">重试</button></view>
  <button wx:if="{{nextCursor}}" class="action-text users-more {{loadingMore?'control--disabled':''}}" bindtap="more" disabled="{{loadingMore}}" loading="{{loadingMore}}">查看更多</button>
 </view>
 <member-inspector id="memberInspector" visible="{{inspectorVisible}}" active="{{inspectorVisible&&pageVisible}}" member-id="{{selectedMember}}" administrator-mode="{{administratorSelecting}}" bindclose="closeInspector" bindadministratorupdated="administratorUpdated"/>
 <view wx:if="{{sheet}}" class="users-mask" bindtap="close"><view class="users-sheet" catchtap="stop"><view class="users-sheet-handle"/><view class="users-between"><text class="users-sheet-title">{{sheet==='filter'?'筛选与排序':'显示字段'}}</text><button class="action-text" bindtap="close">关闭</button></view>
  <block wx:if="{{sheet==='filter'}}"><picker range="{{accounts}}" value="{{accountIndex}}" data-key="accountIndex" bindchange="pick"><view class="users-form-row"><text>账号</text><text>{{accounts[accountIndex]}} ›</text></view></picker><picker range="{{onboardings}}" value="{{onboardingIndex}}" data-key="onboardingIndex" bindchange="pick"><view class="users-form-row"><text>建档</text><text>{{onboardings[onboardingIndex]}} ›</text></view></picker><picker wx:if="{{scope.sharing}}" range="{{officers}}" value="{{officerIndex}}" data-key="officerIndex" bindchange="pick"><view class="users-form-row"><text>分享官</text><text>{{officers[officerIndex]}} ›</text></view></picker><picker range="{{sorts}}" value="{{sortIndex}}" data-key="sortIndex" bindchange="pick"><view class="users-form-row"><text>排序</text><text>{{sorts[sortIndex]}} ›</text></view></picker><picker range="{{directions}}" value="{{directionIndex}}" data-key="directionIndex" bindchange="pick"><view class="users-form-row"><text>顺序</text><text>{{directions[directionIndex]}} ›</text></view></picker><view class="users-sheet-actions"><button class="action-text" bindtap="resetFilter">重置</button><button class="users-primary" bindtap="applyFilter">查看结果</button></view></block>
  <block wx:else><button wx:for="{{fieldOptions}}" wx:key="id" class="users-form-row users-field" data-id="{{item.id}}" bindtap="toggleField" aria-pressed="{{item.checked}}"><text>{{item.label}}</text><text class="users-check {{item.checked?'checked':''}}">{{item.checked?'✓':''}}</text></button><button class="users-primary" bindtap="applyFields">完成</button></block>
 </view></view>
</view>
