<view class="members-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">会员管理</text></view>
  <view class="page page--stack members-page">
    <view class="members-summary"><view><text class="ux-strong">{{summary.all}}</text><text class="ux-small">全部</text></view><view><text class="ux-strong">{{summary.members}}</text><text class="ux-small">商业会员</text></view><view><text class="ux-strong">{{summary.ordinary}}</text><text class="ux-small">普通用户</text></view></view>
    <view wx:if="{{canReadCommission || canManageRate}}" class="members-global-rate"><view><text class="ux-small">全局默认费率</text><text class="ux-strong">{{globalRateLabel||'待加载'}}</text></view><button wx:if="{{canManageRate && globalRate}}" bindtap="openGlobalRateForm">提议调整</button></view>
    <text wx:if="{{globalRateError}}" class="state state--error" aria-live="assertive">{{globalRateError}}</text><text wx:if="{{globalRateStatus}}" class="state" aria-live="polite">{{globalRateStatus}}</text>
    <view wx:if="{{canApprove}}" class="members-rate-queue"><button class="members-rate-toggle" bindtap="togglePending" aria-expanded="{{pendingVisible}}"><text>待复核费率 · {{pendingTotal}} 项</text><text>{{pendingVisible?'收起':'查看'}}</text></button><block wx:if="{{pendingVisible}}"><text class="ux-small">已加载 {{pending.length}} 项</text><view wx:for="{{pending}}" wx:key="id" class="members-rate-row"><text>{{item.displayName}} · {{item.rateLabel}}</text><text class="ux-small">{{item.reason}}</text><view><button data-id="{{item.id}}" data-decision="rejected" class="{{reviewBusy ? 'control--disabled' : ''}}" bindtap="reviewRate" disabled="{{reviewBusy}}">退回</button><button data-id="{{item.id}}" data-decision="active" class="{{reviewBusy ? 'control--disabled' : ''}}" bindtap="reviewRate" disabled="{{reviewBusy}}">批准</button></view></view><button wx:if="{{pendingCursor}}" class="text-button {{pendingLoadingMore ? 'control--disabled' : ''}}" bindtap="loadMoreRates" disabled="{{pendingLoadingMore}}" loading="{{pendingLoadingMore}}">加载更多待办</button><text wx:if="{{pendingMoreError}}" class="state state--error">{{pendingMoreError}}</text></block></view>
    <view class="members-search"><input value="{{q}}" bindinput="editSearch" bindconfirm="search" confirm-type="search" placeholder="搜索昵称、编号或推荐码" aria-label="搜索成员"/><button bindtap="search">搜索</button></view>
    <view class="members-filters" aria-role="tablist" aria-label="成员筛选"><button wx:for="{{filters}}" wx:key="id" data-filter="{{item.id}}" bindtap="selectFilter" class="{{filter===item.id?'is-active':''}}" aria-role="tab" aria-selected="{{filter===item.id}}">{{item.label}}</button></view>
    <view wx:if="{{loading}}" class="state" aria-live="polite">正在加载成员…</view><view wx:if="{{error}}" class="state state--error" aria-live="assertive"><text>{{error}}</text><button class="text-button" bindtap="load">重新加载</button></view>
    <view wx:if="{{!loading && !error && !items.length}}" class="state">没有符合条件的成员，请调整搜索或筛选。</view>
    <text wx:if="{{!loading && !error}}" class="members-count">符合条件 {{matchingTotal}} 人 · 已加载 {{loadedCount}} 人</text>
    <view wx:if="{{!loading && !error}}" class="members-list"><button wx:for="{{items}}" wx:key="id" class="members-row {{navigating?'control--disabled':''}}" data-id="{{item.id}}" bindtap="openMember" disabled="{{navigating}}" aria-label="查看{{item.displayName}}的成员详情"><view class="members-row__avatar">{{item.initial}}</view><view class="members-row__copy"><text class="ux-strong">{{item.displayName}}</text><text class="ux-small">{{item.commercialEligible?'商业会员':item.membershipState==='active'?'资格未生效或不可用':item.membershipState==='suspended'?'资格暂停':item.membershipState==='expired'?'资格到期':'普通用户'}}{{item.commercialEligible?' · 至 '+item.expiresLabel:''}}<text wx:if="{{canReadCommission}}"> · 直接推荐 {{item.directReferralCount}}</text></text></view><image src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button></view>
    <button wx:if="{{!loading && !error && nextCursor}}" class="text-button {{loadingMore ? 'control--disabled' : ''}}" bindtap="loadMore" disabled="{{loadingMore}}" loading="{{loadingMore}}">加载更多成员</button>
    <view wx:if="{{moreError}}" class="state state--error" aria-live="assertive">{{moreError}}</view>
    <view wx:if="{{reviewError}}" class="state state--error" aria-live="assertive">{{reviewError}}</view>
    <view class="members-note">订单与推荐金额仅作当前事实核对。真实支付、佣金结算和提现尚未开放。</view>
  </view>
  <block wx:if="{{globalRateFormVisible && globalRate}}"><view class="global-rate-backdrop" bindtap="closeGlobalRateForm" aria-label="关闭全局费率表单"></view><view class="global-rate-sheet" aria-role="dialog" aria-label="全局费率提议">
    <view class="global-rate-heading"><text>全局费率提议</text><button bindtap="closeGlobalRateForm">关闭</button></view>
    <scroll-view scroll-y class="global-rate-scroll"><text class="ux-small">当前 {{globalRateLabel}} · 新规则仅用于生效后的订单</text>
      <text class="global-rate-label">新费率（%）</text><input wx:if="{{globalRate.policyKind!=='engineering_fixture'}}" class="global-rate-input" type="digit" maxlength="6" value="{{globalRateForm.percent}}" bindinput="editGlobalRate" placeholder="如 25.00" aria-label="输入全局费率百分比"/><picker wx:else mode="selector" range="{{rateOptions}}" value="{{globalRateFormIndex}}" bindchange="selectGlobalRate" aria-label="选择全局费率"><view class="global-rate-input">{{rateOptions[globalRateFormIndex]}}</view></picker>
      <text class="global-rate-label">计划生效</text><view class="global-rate-time"><picker mode="date" value="{{globalRateForm.date}}" bindchange="changeGlobalDate"><view>{{globalRateForm.date}}</view></picker><picker mode="time" value="{{globalRateForm.time}}" bindchange="changeGlobalTime"><view>{{globalRateForm.time}}</view></picker></view>
      <text class="global-rate-label">变更依据</text><textarea value="{{globalRateForm.reason}}" bindinput="editGlobalReason" maxlength="300" auto-height placeholder="填写供另一名管理者复核的依据" aria-label="全局费率变更依据"/>
      <text class="ux-small">需另一名授权管理者批准。旧订单不重算。</text>
    </scroll-view><view class="global-rate-footer"><button class="{{globalRateBusy?'control--disabled':''}}" bindtap="closeGlobalRateForm" disabled="{{globalRateBusy}}">取消</button><button class="global-rate-submit {{globalRateBusy?'control--disabled':''}}" bindtap="submitGlobalRateForm" disabled="{{globalRateBusy}}" loading="{{globalRateBusy}}">提交复核</button></view>
  </view></block>
</view>
