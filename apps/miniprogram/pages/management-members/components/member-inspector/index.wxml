<view wx:if="{{visible}}" class="inspector-host {{full?'inspector-full':'inspector-mask'}}" bindtap="{{full?'stop':'close'}}">
 <view class="inspector-panel" catchtap="stop"><view wx:if="{{!full}}" class="inspector-grip"/><view class="inspector-heading"><text class="inspector-title">用户详情</text><view class="inspector-heading-actions"><button wx:if="{{!full&&member}}" class="action-text" bindtap="expand">展开</button><button wx:if="{{!full}}" class="action-text" bindtap="close">关闭</button></view></view>
 <view wx:if="{{member}}" class="inspector-identity"><image class="inspector-avatar" src="{{member.avatar||'/assets/icons/user-circle-plum.svg'}}" mode="aspectFill"/><view class="inspector-identity-copy"><text class="inspector-name">{{member.displayName}}</text><text class="inspector-number">{{member.cardNumber||'编号待生成'}}<text class="inspector-status"> · {{memberStatus}}</text></text></view></view>
 <section-tabs wx:if="{{member}}" items="{{tabs}}" value="{{tab}}" bindchange="tabChange" label="用户详情分类"/>
 <scroll-view class="inspector-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" bindscrolltolower="more">
  <view wx:if="{{loading}}" class="inspector-loading" aria-role="status">加载中</view>
  <view wx:if="{{error}}" class="inspector-error" aria-role="alert"><text>{{error}}</text><button class="action-text" bindtap="retry">重试</button></view>
  <block wx:if="{{member&&tab==='overview'}}"><view wx:if="{{metrics.length}}" class="inspector-metrics {{wideMetrics?'inspector-metrics--two':''}}"><button wx:for="{{metrics}}" wx:key="section" class="inspector-metric" data-section="{{item.section}}" bindtap="selectSection"><text class="inspector-label">{{item.label}}</text><text class="inspector-value {{item.section==='orders'?'inspector-value--money':''}}">{{item.value}}</text></button></view>
   <view class="inspector-facts"><view class="inspector-fact"><text>手机</text><text class="inspector-fact-value">{{member.phoneMasked||'未绑定'}}</text><button wx:if="{{scope.contact&&member.phoneMasked}}" class="action-text" bindtap="phone">查看</button></view><view wx:for="{{facts}}" wx:key="label" class="inspector-fact"><text>{{item.label}}</text><text class="inspector-fact-value">{{item.value}}</text></view></view>
   <view class="inspector-links"><button wx:for="{{sections}}" wx:key="id" class="inspector-section-link" data-section="{{item.id}}" bindtap="selectSection"><text>{{item.label}}</text><text class="inspector-chevron">›</text></button></view><button wx:if="{{scope.manage}}" class="action-text inspector-manage" bindtap="management">管理操作</button>
  </block>
  <block wx:elif="{{member&&tab==='profile'&&profile}}"><view wx:for="{{profileRows}}" wx:key="label" class="inspector-profile-row"><text class="inspector-label inspector-profile-label">{{item.label}}</text><text class="inspector-answer">{{item.value}}</text></view><button wx:if="{{scope.contact}}" class="action-text" data-section="addresses" bindtap="selectSection">查看收货地址</button></block>
  <block wx:elif="{{member&&(tab==='business'||tab==='logs')}}">
   <section-tabs wx:if="{{tab==='business'}}" items="{{sections}}" value="{{section}}" bindchange="businessChange" label="用户业务分类"/>
   <view wx:if="{{day}}" class="inspector-day">{{day}}</view>
   <block wx:if="{{section==='sharing'&&tab==='business'&&sectionData}}"><view wx:for="{{sharingRows}}" wx:key="label" class="inspector-profile-row"><text class="inspector-label inspector-profile-label">{{item.label}}</text><text class="inspector-answer">{{item.value}}</text></view><view class="inspector-heading-actions"><button wx:if="{{scope.commission}}" class="action-text" data-section="sharing-orders" bindtap="selectSection">推广订单</button><button wx:if="{{scope.commission}}" class="action-text" data-section="settlements" bindtap="selectSection">月结记录</button><button wx:if="{{scope.manage}}" class="action-text" bindtap="management">管理</button></view></block>
   <block wx:else><view wx:for="{{records}}" wx:key="id" class="inspector-record"><view class="inspector-record-head"><text class="inspector-record-title">{{item.title}}</text><text wx:if="{{item.amount}}" class="inspector-record-amount">{{item.amount}}</text></view><text wx:if="{{item.stateLabel}}" class="inspector-record-state">{{item.stateLabel}}</text><text class="inspector-record-meta">{{item.meta}}</text><text wx:if="{{item.body}}" class="inspector-record-body">{{item.body}}</text><text wx:if="{{item.actor}}" class="inspector-record-meta">{{item.actor}}</text><text wx:for="{{item.details}}" wx:for-item="detail" wx:key="*this" class="inspector-record-meta">{{detail}}</text><text wx:if="{{item.reply}}" class="inspector-record-body">回复：{{item.reply}}</text><button wx:if="{{item.navigable}}" class="action-text inspector-record-link" bindtap="openRecord" data-id="{{item.id}}">{{item.kind==='address'?'查看':'查看来源'}} ›</button></view><view wx:if="{{!loading&&!error&&!records.length}}" class="inspector-empty">暂无记录</view></block>
   <button wx:if="{{nextCursor}}" class="action-text inspector-more {{moreLoading?'control--disabled':''}}" bindtap="more" loading="{{moreLoading}}" disabled="{{moreLoading}}">继续加载</button>
  </block>
 </scroll-view>
 <view wx:if="{{reveal}}" class="inspector-contact-mask" catchtap="closeContact"><view class="inspector-contact" catchtap="stop"><view class="inspector-heading"><text class="inspector-title">{{contactTitle}}</text><button class="action-text" bindtap="closeContact">关闭</button></view><text wx:if="{{contactText}}" class="inspector-contact-text">{{contactText}}</text><block wx:else><input class="inspector-reason" value="{{reason}}" bindinput="editReason" placeholder="查看用途" maxlength="200" aria-label="查看用途"/><text wx:if="{{contactError}}" class="inspector-error">{{contactError}}</text><button class="inspector-primary {{contactBusy?'control--disabled':''}}" bindtap="revealContact" loading="{{contactBusy}}" disabled="{{contactBusy}}">确认查看</button></block></view></view>
 </view>
</view>
