<view wx:if="{{visible}}" class="inspector-host {{full?'inspector-full':'inspector-mask'}}" bindtap="{{full?'stop':'close'}}">
 <view class="inspector-panel" catchtap="stop"><view wx:if="{{!full}}" class="inspector-grip"/><view class="inspector-heading"><text class="inspector-title">用户详情</text><view class="inspector-heading-actions"><button wx:if="{{!full&&member}}" class="action-text" bindtap="expand">展开</button><button wx:if="{{!full}}" class="action-text" bindtap="close">关闭</button></view></view>
 <view wx:if="{{member}}" class="inspector-identity"><image class="inspector-avatar" src="{{member.avatar||'/assets/icons/user-circle-plum.svg'}}" mode="aspectFill"/><view class="inspector-identity-copy"><text class="inspector-name">{{member.displayName}}</text><text class="inspector-number">{{member.cardNumber||'编号待生成'}}<text class="inspector-status"> · {{memberStatus}}</text></text></view></view>
 <view wx:if="{{!member}}" class="inspector-identity inspector-identity-placeholder" aria-hidden="true"><view class="inspector-avatar"/><view class="inspector-identity-copy"><view class="inspector-placeholder-line"/><view class="inspector-placeholder-line inspector-placeholder-line--short"/></view></view>
 <section-tabs wx:if="{{member}}" items="{{tabs}}" value="{{tab}}" bindchange="tabChange" label="用户详情分类"/>
 <view wx:if="{{!member}}" class="inspector-tabs-placeholder" aria-hidden="true"><view wx:for="{{[1,2,3,4]}}" wx:key="*this"/></view>
 <scroll-view class="inspector-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" bindscrolltolower="more">
  <view wx:if="{{loading&&(!member||tab==='profile'&&!profile)}}" class="inspector-skeleton" aria-role="status" aria-label="正在读取用户资料"><view class="inspector-skeleton-line"/><view class="inspector-skeleton-line inspector-skeleton-line--short"/><view class="inspector-skeleton-line inspector-skeleton-line--medium"/></view>
  <view wx:if="{{error}}" class="inspector-error" aria-role="alert"><text>{{error}}</text><button class="action-text" bindtap="retry">重试</button></view>
  <block wx:if="{{member&&tab==='overview'}}"><view wx:if="{{metrics.length}}" class="inspector-metrics {{wideMetrics?'inspector-metrics--two':''}}"><button wx:for="{{metrics}}" wx:key="section" class="inspector-metric" data-section="{{item.section}}" bindtap="selectSection"><text class="inspector-label">{{item.label}}</text><text class="inspector-value {{item.section==='orders'?'inspector-value--money':''}}">{{item.value}}</text></button></view>
   <view class="inspector-facts"><view class="inspector-fact"><text>手机</text><text class="inspector-fact-value">{{phoneText||member.phoneMasked||'未绑定'}}</text><button wx:if="{{scope.contact&&(phoneText||member.phoneMasked)}}" class="action-text {{copyBusy?'control--disabled':''}}" bindtap="phone" disabled="{{copyBusy}}" aria-label="复制手机号">复制</button></view><view wx:for="{{facts}}" wx:key="label" class="inspector-fact"><text>{{item.label}}</text><text class="inspector-fact-value">{{item.value}}</text></view></view>
   <view class="inspector-links"><button wx:for="{{sections}}" wx:key="id" class="inspector-section-link" data-section="{{item.id}}" bindtap="selectSection"><text>{{item.label}}</text><text class="inspector-chevron">›</text></button></view><button wx:if="{{scope.administrators}}" class="action-text inspector-manage" bindtap="openAdministrator">管理权限</button><button wx:if="{{scope.manage}}" class="action-text inspector-manage" bindtap="management">管理操作</button>
  </block>
  <block wx:elif="{{member&&tab==='profile'&&profile}}"><view wx:for="{{profileRows}}" wx:key="label" class="inspector-profile-row"><text class="inspector-label inspector-profile-label">{{item.label}}</text><text class="inspector-answer">{{item.value}}</text><button wx:if="{{item.copy}}" class="action-text {{copyBusy?'control--disabled':''}}" bindtap="copyProfile" disabled="{{copyBusy}}" aria-label="复制微信号">复制</button></view><button wx:if="{{scope.contact}}" class="action-text" data-section="addresses" bindtap="selectSection">查看收货地址</button></block>
  <block wx:elif="{{member&&(tab==='business'||tab==='logs')}}">
   <section-tabs wx:if="{{tab==='business'}}" items="{{sections}}" value="{{section}}" bindchange="businessChange" label="用户业务分类"/>
   <view wx:if="{{loading&&!sectionData&&!records.length}}" class="inspector-skeleton" aria-role="status" aria-label="正在读取业务记录"><view class="inspector-skeleton-line"/><view class="inspector-skeleton-line inspector-skeleton-line--short"/><view class="inspector-skeleton-line inspector-skeleton-line--medium"/></view>
   <view wx:if="{{day}}" class="inspector-day">{{day}}</view>
   <block wx:if="{{section==='sharing'&&tab==='business'&&sectionData}}"><view wx:for="{{sharingRows}}" wx:key="label" class="inspector-profile-row"><text class="inspector-label inspector-profile-label">{{item.label}}</text><text class="inspector-answer">{{item.value}}</text></view><view class="inspector-heading-actions"><button wx:if="{{scope.commission}}" class="action-text" data-section="sharing-orders" bindtap="selectSection">推广订单</button><button wx:if="{{scope.commission}}" class="action-text" data-section="settlements" bindtap="selectSection">月结记录</button><button wx:if="{{scope.manage}}" class="action-text" bindtap="management">管理</button></view></block>
   <block wx:else><view wx:for="{{records}}" wx:key="id" class="inspector-record"><view class="inspector-record-head"><text class="inspector-record-title">{{item.title}}</text><text wx:if="{{item.amount}}" class="inspector-record-amount">{{item.amount}}</text></view><text wx:if="{{item.stateLabel}}" class="inspector-record-state">{{item.stateLabel}}</text><text class="inspector-record-meta">{{item.meta}}</text><text wx:if="{{item.body}}" class="inspector-record-body">{{item.body}}</text><text wx:if="{{item.actor}}" class="inspector-record-meta">{{item.actor}}</text><text wx:for="{{item.details}}" wx:for-item="detail" wx:key="*this" class="inspector-record-meta">{{detail}}</text><text wx:if="{{item.reply}}" class="inspector-record-body">回复：{{item.reply}}</text><button wx:if="{{item.navigable}}" class="action-text inspector-record-link" bindtap="openRecord" data-id="{{item.id}}">{{item.kind==='address'?'复制':'查看来源 ›'}}</button></view><view wx:if="{{!loading&&!error&&!records.length}}" class="inspector-empty">暂无记录</view></block>
   <button wx:if="{{nextCursor}}" class="action-text inspector-more {{moreLoading?'control--disabled':''}}" bindtap="more" loading="{{moreLoading}}" disabled="{{moreLoading}}">查看更多</button>
  </block>
 </scroll-view>
 <view wx:if="{{roleSheet}}" class="administrator-sheet" catchtap="stop">
  <view class="inspector-heading"><text class="inspector-title">管理权限</text><button class="action-text" bindtap="closeAdministrator">关闭</button></view>
  <text class="administrator-subject">{{member.displayName}} · {{member.cardNumber}}<text wx:if="{{roleRootOwner}}"> · 最高管理员</text></text>
  <view wx:if="{{roleError}}" class="inspector-error"><text>{{roleError}}</text><button class="action-text {{roleBusy?'control--disabled':''}}" disabled="{{roleBusy}}" bindtap="openAdministrator">重新读取</button></view>
  <scroll-view class="administrator-options" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
   <view wx:if="{{roleLoading}}" class="inspector-skeleton" aria-role="status" aria-label="正在读取管理权限"><view class="inspector-skeleton-line"/><view class="inspector-skeleton-line inspector-skeleton-line--short"/></view>
   <view wx:for="{{roleGroups}}" wx:key="label" class="administrator-group"><text class="administrator-group-title">{{item.label}}</text><view class="administrator-grid">
    <button wx:for="{{item.items}}" wx:for-item="permission" wx:key="capability" class="administrator-option {{roleBusy||permission.fixed||roleLocked?'control--disabled':''}}" disabled="{{roleBusy||permission.fixed||roleLocked}}" data-capability="{{permission.capability}}" bindtap="toggleAdministratorCapability" aria-pressed="{{permission.checked}}"><text class="administrator-check {{permission.checked?'is-checked':''}}">{{permission.checked?'✓':''}}</text><text>{{permission.label}}</text></button>
   </view></view>
  </scroll-view>
  <view wx:if="{{!roleLoading&&roleVersion}}" class="administrator-footer"><button class="action-text {{roleBusy||roleLocked?'control--disabled':''}}" disabled="{{roleBusy||roleLocked}}" bindtap="clearAdministratorCapabilities">{{roleRootOwner?'仅保留基础':'清空'}}</button><button class="administrator-save {{roleBusy||(!roleOriginal.length&&!roleSelected.length)?'control--disabled':''}}" disabled="{{roleBusy||(!roleOriginal.length&&!roleSelected.length)}}" bindtap="saveAdministrator">{{roleOriginal.length?'保存权限':'新增管理员'}}</button></view>
 </view>
 </view>
</view>
