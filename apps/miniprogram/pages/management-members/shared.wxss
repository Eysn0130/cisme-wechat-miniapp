.users-root{min-height:100vh;background:#f9f6fb;color:#352a3a}.users-between{display:flex;align-items:center;justify-content:space-between;gap:10px}.users-actions{display:flex;align-items:center;gap:10px}.users-muted{font-size:12px;color:#75697a}.users-error{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;color:#7e3e55;font-size:13px;white-space:normal}.users-empty{padding:45px 10px;text-align:center;color:#75697a;font-size:14px}.users-mask{position:fixed;inset:0;z-index:100;background:rgba(29,17,38,.35);display:flex;align-items:flex-end}.users-sheet{width:100%;max-height:86vh;overflow-y:auto;box-sizing:border-box;background:#fcfaff;border-radius:24px 24px 0 0;padding:10px 20px calc(env(safe-area-inset-bottom) + 22px);box-shadow:0 -12px 50px rgba(40,20,55,.12)}.users-sheet-handle{width:32px;height:4px;background:#dbd0e2;border-radius:2px;margin:0 auto 10px}.users-sheet-title{font-size:19px;font-weight:600}.users-form-row{min-height:52px;display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid #ece3f0;font-size:14px}.users-form-value{color:#56306f;text-align:right}.users-primary{display:flex;align-items:center;justify-content:center;height:46px;margin:18px 0 0;padding:0 22px;border:0;border-radius:25px;background:#56306f;color:#fff;font-size:15px;font-weight:600;line-height:1.3}.action-text{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 4px;margin:0;border:0;border-radius:0;background:transparent;line-height:1.4;color:#56306f;font-size:13px;flex-shrink:0}
