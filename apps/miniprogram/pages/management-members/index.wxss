.members-page{padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 56px));padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 50rpx);background:#f7f2f8}.members-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:28rpx;padding:22rpx;border-radius:24rpx;background:#fff}.members-summary view{text-align:center;border-right:1rpx solid #eee7f0}.members-summary view:last-child{border:0}.members-summary .ux-strong,.members-summary .ux-small{display:block}.members-summary .ux-strong{color:#493654;font:38rpx Georgia,serif}.members-summary .ux-small{margin-top:7rpx;color:#817687;font-size:22rpx}.members-search{display:flex;gap:12rpx;margin-top:22rpx}.members-search input{flex:1;min-width:0;height:44px;padding:0 22rpx;border:1rpx solid #e4d9e8;border-radius:18rpx;background:#fff;color:#403545;font-size:26rpx}.members-search button{display:flex;align-items:center;justify-content:center;min-width:52px;height:44px;padding:0 16rpx;border:0;border-radius:18rpx;background:#624674;color:#fff;font-size:25rpx}.members-filters{display:flex;gap:12rpx;margin:18rpx 0}.members-filters button{display:flex;align-items:center;justify-content:center;min-width:110rpx;min-height:88rpx;padding:0 18rpx;border:1rpx solid #e4d9e8;border-radius:999rpx;color:#6d5d75;background:#fff;font-size:23rpx}.members-filters .is-active{color:#fff;background:#624674;border-color:#624674}.members-list{overflow:hidden;border-radius:26rpx;background:#fff}.members-row{display:flex;align-items:center;gap:18rpx;width:100%;min-height:116rpx;padding:18rpx 22rpx;border:0;border-bottom:1rpx solid #eee8f0;border-radius:0;background:transparent;text-align:left}.members-row__avatar{display:flex;align-items:center;justify-content:center;flex:none;width:68rpx;height:68rpx;border-radius:50%;color:#56306f;background:#efe6f2;font:27rpx Songti SC,serif}.members-row__copy{flex:1;min-width:0}.members-row__copy .ux-strong,.members-row__copy .ux-small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.members-row__copy .ux-strong{color:#403545;font-size:28rpx;font-weight:500}.members-row__copy .ux-small{margin-top:7rpx;color:#817687;font-size:22rpx}.members-row image{width:24rpx;height:24rpx}.members-rate-queue{margin-top:30rpx;padding:24rpx;border-radius:24rpx;background:#fff}.members-rate-queue>.ux-strong{color:#403545;font-size:28rpx}.members-rate-row{padding:18rpx 0;border-top:1rpx solid #eee8f0}.members-rate-row text,.members-rate-row .ux-small{display:block}.members-rate-row text{color:#46374c;font-size:25rpx}.members-rate-row .ux-small{margin-top:8rpx;color:#756a79;font-size:22rpx;line-height:1.5}.members-rate-row view{display:flex;justify-content:flex-end;gap:12rpx;margin-top:12rpx}.members-rate-row button{display:flex;align-items:center;justify-content:center;min-width:96rpx;height:88rpx;padding:0 18rpx;border:1rpx solid #d9c9df;border-radius:16rpx;color:#56306f;background:#f7f2f8;font-size:24rpx}.members-note{margin-top:24rpx;padding:20rpx;border-radius:18rpx;color:#756a79;background:#eee7f1;font-size:22rpx;line-height:1.5}

