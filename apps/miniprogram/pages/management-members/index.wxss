@import "./shared.wxss";
.users-page{padding:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 56px)) 14px calc(env(safe-area-inset-bottom) + 26px)}.users-summary{margin:8px 0 12px}.users-count{font-size:18px;font-weight:600}.users-search{display:flex;align-items:center;gap:10px;margin-bottom:10px}.users-search input{height:42px;min-width:0;flex:1;background:#eee6f2;border-radius:12px;padding:0 13px;font-size:14px}.users-toolbar{height:48px}.users-table{width:100%;border-top:1px solid #e5dbe9}.users-table-inner{display:inline-block;min-width:100%}.users-table-row{display:flex;align-items:stretch;min-height:65px;border-bottom:1px solid #e6dce9;white-space:nowrap;background:#f9f6fb}.users-table-head{min-height:40px;color:#75697a;font-size:12px}.users-identity{position:sticky;left:0;z-index:1;display:flex;align-items:center;flex:2 0 128px;min-width:128px;width:128px;box-sizing:border-box;background:inherit;padding:0 6px;text-align:left}.users-person{gap:9px;border:0;border-radius:0;line-height:1.35;color:#352a3a}.users-avatar{width:32px;height:32px;flex:none;border-radius:50%;background:#ece2f1}.users-person-copy{min-width:0;flex:1}.users-name{display:block;overflow:hidden;text-overflow:ellipsis;font-size:14px;font-weight:600}.users-number{display:block;font-size:11px;letter-spacing:.2px;color:#75697a;margin-top:4px;font-variant-numeric:tabular-nums}.users-cell{display:flex;align-items:center;justify-content:flex-end;flex:1 0 auto;min-width:0;box-sizing:border-box;padding:0 7px;font-size:13px;font-variant-numeric:tabular-nums}.users-table-head .users-cell{font-size:12px}.users-detail-cell{flex:0 0 44px;justify-content:flex-end;width:44px!important;padding:0 3px!important}.users-numeric{font-weight:600;color:#56306f}.users-row-selected{background:#ede2f3}.users-selection{display:flex;align-items:center;justify-content:space-between;padding:8px 0;color:#56306f;font-size:13px}.users-skeleton view{height:64px;border-bottom:1px solid #e6dce9;background:#f0eaf4}.users-more{margin:10px auto}.users-field{width:100%;background:transparent;color:#352a3a;text-align:left;border:0;border-radius:0}.users-check{display:flex;align-items:center;justify-content:center;flex:none;width:19px;height:19px;box-sizing:border-box;border-radius:50%;background:#e6ddeb;color:#fff;font-size:12px}.users-check.checked{background:#56306f}.is-active{font-weight:600}.users-sheet-actions{display:flex;align-items:center;gap:20px;margin-top:18px}.users-sheet-actions .users-primary{flex:1}

.users-role{display:block;font-size:10px;line-height:12px;color:#6e4a86;font-weight:500}
