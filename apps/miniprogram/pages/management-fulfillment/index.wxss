.fulfillment-shell{min-height:100vh;background:#f7f2f8}.section-card{padding:28rpx;border:1rpx solid var(--cisme-line);border-radius:24rpx;background:#fff;display:flex;flex-direction:column;gap:20rpx}.section-title{font-size:32rpx;font-weight:500}.filter-choice{min-height:72rpx;display:flex;align-items:center;font-size:28rpx}input{box-sizing:border-box;height:88rpx;padding:0 18rpx;border:1rpx solid var(--cisme-line);border-radius:12rpx;min-height:88rpx;font-size:26rpx}textarea{width:100%;min-height:240rpx;box-sizing:border-box;padding:18rpx;background:#faf7fb;border:1rpx solid var(--cisme-line);border-radius:12rpx;font-size:25rpx}.order{display:flex;flex-direction:column;gap:10rpx;padding:20rpx 0;border-top:1rpx solid var(--cisme-line);font-size:25rpx;overflow-wrap:anywhere}.order-number{font-weight:500}.muted,.hint{color:var(--cisme-muted);font-size:24rpx;line-height:1.65}.confirmation{display:flex;align-items:center;gap:12rpx;font-size:25rpx;line-height:1.6}.primary,.secondary{width:100%;min-height:88rpx;border-radius:18rpx;font-size:27rpx;display:flex;align-items:center;justify-content:center}.primary{background:#705278;color:#fff}.secondary{background:#f1eaf3;color:#61486c}.control--disabled{opacity:.45}
