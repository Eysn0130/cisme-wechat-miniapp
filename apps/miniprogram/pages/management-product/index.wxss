.product-admin{background:#f7f2f8}.status-strip{display:flex;flex-wrap:wrap;gap:10rpx}.status-strip text{padding:8rpx 14rpx;border-radius:999rpx;background:#e9e0ed;color:#5f4869;font-size:20rpx}.form-section{display:grid;gap:20rpx;margin-top:24rpx;padding:28rpx;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 36rpx rgba(54,35,65,.06)}.form-section__title{font-size:30rpx;font-weight:600;color:#3d3042}.form-section label{display:grid;gap:10rpx;color:#6f6573;font-size:23rpx}.form-section input,.form-section textarea,.picker-value{box-sizing:border-box;width:100%;min-height:82rpx;padding:20rpx;border:1rpx solid #ddd1e2;border-radius:18rpx;background:#fbf9fc;color:#342b38;font-size:27rpx}.form-section textarea{min-height:140rpx}.form-section small,.form-hint{color:#8b818e;font-size:21rpx;line-height:1.55}.image-preview{width:100%;height:280rpx;border-radius:22rpx;background:#eee7ef}.button-row{display:flex;flex-wrap:wrap;gap:14rpx}.button-row button{flex:1;min-width:180rpx;border:1rpx solid #d4c5da;border-radius:18rpx;background:#f5eff7;color:#56306f;font-size:24rpx}
