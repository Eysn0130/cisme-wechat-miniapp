<view class="management-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">{{product ? '维护商品' : '新建商品'}}</text></view><view class="page page--stack product-admin">
  <view wx:if="{{loading}}" class="state">正在读取商品…</view><view wx:if="{{refreshing}}" class="state">正在核对远端版本，本地草稿保持不变…</view><view wx:if="{{error}}" class="state state--error">{{error}}</view>
  <view wx:if="{{conflict}}" class="draft-conflict" aria-live="assertive"><strong>发现较新的远端版本</strong><text>本地草稿没有被覆盖。选择保留草稿并基于最新版继续，或载入远端内容。</text><view><button bindtap="keepLocalDraft">保留本地草稿</button><button bindtap="loadRemoteDraft">载入远端版本</button></view></view>
  <block wx:if="{{!loading && (!error || product || dirty)}}"><view class="status-strip" wx:if="{{product}}"><text>{{product.sourceKind === 'synthetic_test' ? '合成测试商品' : product.sourceKind === 'admin' ? '运营商品' : '历史预览商品'}}</text><text>资质 {{product.qualificationStatus === 'eligible' ? '已确认' : product.qualificationStatus === 'blocked' ? '已阻止' : '待核验'}}</text><text>{{product.publicationStatus === 'published' ? '已上架' : product.publicationStatus === 'unpublished' ? '已下架' : '草稿'}}</text></view>
  <view class="form-section"><text class="form-section__title">基础资料</text><label>商品编码<input value="{{code}}" bindinput="codeChange" disabled="{{!!product || !canProduct}}" placeholder="lowercase-code"/></label><label>商品名称<input value="{{name}}" bindinput="nameChange" disabled="{{!canProduct}}" maxlength="120"/></label><label>副标题<input value="{{subtitle}}" bindinput="subtitleChange" disabled="{{!canProduct}}" maxlength="240"/></label><label>商品说明<textarea value="{{description}}" bindinput="descriptionChange" disabled="{{!canProduct}}" maxlength="4000" auto-height/></label><label>打包图片<picker range="{{images}}" bindchange="imageChange" disabled="{{!canProduct}}"><view class="picker-value">{{imagePath}}</view></picker></label><image class="image-preview" src="{{imagePath}}" mode="aspectFill"/></view>
  <view class="form-section"><text class="form-section__title">默认 SKU 与定价</text><label>SKU 编码<input value="{{skuCode}}" bindinput="skuCodeChange" disabled="{{!canProduct}}" placeholder="CARE_SERUM_30"/></label><label>规格名称<input value="{{skuLabel}}" bindinput="skuLabelChange" disabled="{{!canProduct}}"/></label><label>人民币元<input value="{{priceYuan}}" bindinput="priceChange" disabled="{{!canProduct}}" type="digit" placeholder="269.00"/><small>金额最多保留两位小数。</small></label><button class="primary {{!canProduct || saving || conflict ? 'primary--disabled' : ''}}" bindtap="save" loading="{{saving}}" disabled="{{!canProduct || saving || conflict}}">保存商品</button></view>
  <view wx:if="{{product && canQualify}}" class="form-section"><text class="form-section__title">商品资质</text><label>判断理由<input value="{{qualificationReason}}" bindinput="qualificationReasonChange" maxlength="1000"/></label><label>证据引用<input value="{{qualificationEvidence}}" bindinput="qualificationEvidenceChange" maxlength="500" placeholder="确认 eligible 时必填"/></label><view class="button-row"><button class="{{saving ? 'control--disabled' : ''}}" data-status="eligible" bindtap="qualify" disabled="{{saving}}">确认可售</button><button class="{{saving ? 'control--disabled' : ''}}" data-status="blocked" bindtap="qualify" disabled="{{saving}}">阻止销售</button><button class="{{saving ? 'control--disabled' : ''}}" data-status="pending" bindtap="qualify" disabled="{{saving}}">回到待核验</button></view></view>
  <view wx:if="{{product && canProduct}}" class="form-section"><text class="form-section__title">发布状态</text><label>操作理由<input value="{{publicationReason}}" bindinput="publicationReasonChange" maxlength="500"/></label><text class="form-hint">只有资质已确认的商品可以上架；实际购买还取决于订单能力与可售库存。</text><view class="button-row"><button class="{{saving ? 'control--disabled' : ''}}" data-action="publish" bindtap="publication" disabled="{{saving}}">上架</button><button class="{{saving ? 'control--disabled' : ''}}" data-action="unpublish" bindtap="publication" disabled="{{saving}}">下架</button></view></view>
  <view wx:if="{{product && canInventory}}" class="form-section"><text class="form-section__title">库存调整</text><text class="form-hint">当前库存 {{product.stockOnHand}}。输入正数入库、负数出库。</text><label>调整数量<input value="{{stockDelta}}" bindinput="stockDeltaChange" type="number"/></label><label>调整原因<input value="{{stockReason}}" bindinput="stockReasonChange" maxlength="500"/></label><button class="secondary {{saving ? 'control--disabled' : ''}}" bindtap="inventory" disabled="{{saving}}">记录库存调整</button></view>
  </block>
</view></view>
