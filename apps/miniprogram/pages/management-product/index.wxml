<view class="management-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">{{product ? '维护商品' : '新建商品'}}</text></view><view class="page page--stack product-admin">
  <view wx:if="{{loading}}" class="state">正在读取商品…</view><view wx:if="{{refreshing}}" class="state">正在核对最新内容，当前草稿会保留…</view><view wx:if="{{error}}" class="state state--error">{{error}}</view>
  <view wx:if="{{conflict}}" class="draft-conflict" aria-live="assertive"><strong>商品有新的更新</strong><text>当前草稿已保留。你可以继续编辑草稿，或加载最新保存的内容。</text><view><button bindtap="keepLocalDraft">保留当前草稿</button><button bindtap="loadRemoteDraft">加载最新内容</button></view></view>
  <block wx:if="{{!loading && (!error || product || dirty)}}"><view class="status-strip" wx:if="{{product}}"><text>{{product.sourceKind === 'synthetic_test' ? '测试商品' : product.sourceKind === 'admin' ? '运营商品' : '历史预览商品'}}</text><text>资质 {{product.qualificationStatus === 'eligible' ? '已确认' : product.qualificationStatus === 'blocked' ? '已阻止' : '待核验'}}</text><text>{{product.publicationStatus === 'published' ? '已上架' : product.publicationStatus === 'unpublished' ? '已下架' : '草稿'}}</text></view>
  <view class="form-section"><text class="form-section__title">基础资料</text><label>商品编码<input value="{{code}}" bindinput="codeChange" disabled="{{!!product || !canProduct}}" placeholder="小写商品编码，如 care-set"/></label><label>商品名称<input value="{{name}}" bindinput="nameChange" disabled="{{!canProduct}}" maxlength="120"/></label><label>副标题<input value="{{subtitle}}" bindinput="subtitleChange" disabled="{{!canProduct}}" maxlength="240"/></label><label>商品说明<textarea value="{{description}}" bindinput="descriptionChange" disabled="{{!canProduct}}" maxlength="4000" auto-height/></label><view class="catalog-image-field"><text>商品展示图</text><text>{{originalImageRetained ? '历史原图暂不展示' : imagePath === '/assets/icons/spray-bottle-plum.svg' ? '当前使用品牌图标' : '当前商品图'}}</text></view><image class="image-preview" src="{{imagePath}}" mode="aspectFit"/><text wx:if="{{originalImageRetained}}" class="form-hint">此处暂用品牌图标。保存商品不会更改原有图片。</text></view>
  <view class="form-section"><text class="form-section__title">默认 SKU 与定价</text><label>SKU 编码<input value="{{skuCode}}" bindinput="skuCodeChange" disabled="{{!canProduct}}" placeholder="CARE_SERUM_30"/></label><label>规格名称<input value="{{skuLabel}}" bindinput="skuLabelChange" disabled="{{!canProduct}}"/></label><label>人民币元<input value="{{priceYuan}}" bindinput="priceChange" disabled="{{!canProduct}}" type="digit" placeholder="269.00"/><small>金额最多保留两位小数。</small></label><button class="primary {{!canProduct || saving || conflict ? 'primary--disabled' : ''}}" bindtap="save" loading="{{saving}}" disabled="{{!canProduct || saving || conflict}}">保存商品</button></view>
  <view wx:if="{{product && canQualify}}" class="form-section"><text class="form-section__title">商品资质</text><label>判断理由<input value="{{qualificationReason}}" bindinput="qualificationReasonChange" maxlength="1000"/></label><label>证据引用<input value="{{qualificationEvidence}}" bindinput="qualificationEvidenceChange" maxlength="500" placeholder="确认 eligible 时必填"/></label><view class="button-row"><button class="{{saving ? 'control--disabled' : ''}}" data-status="eligible" bindtap="qualify" disabled="{{saving}}">确认可售</button><button class="{{saving ? 'control--disabled' : ''}}" data-status="blocked" bindtap="qualify" disabled="{{saving}}">阻止销售</button><button class="{{saving ? 'control--disabled' : ''}}" data-status="pending" bindtap="qualify" disabled="{{saving}}">回到待核验</button></view></view>
  <view wx:if="{{product && canProduct}}" class="form-section"><text class="form-section__title">发布状态</text><label>操作理由<input value="{{publicationReason}}" bindinput="publicationReasonChange" maxlength="500"/></label><text class="form-hint">商品须先确认资质，再上架展示。下单功能开放且库存充足时，用户才可购买。</text><view class="button-row"><button class="{{saving ? 'control--disabled' : ''}}" data-action="publish" bindtap="publication" disabled="{{saving}}">上架</button><button class="{{saving ? 'control--disabled' : ''}}" data-action="unpublish" bindtap="publication" disabled="{{saving}}">下架</button></view></view>
  <view wx:if="{{product && canInventory}}" class="form-section"><text class="form-section__title">库存调整</text><text class="form-hint">当前库存 {{product.stockOnHand}}。输入正数入库、负数出库。</text><label>调整数量<input value="{{stockDelta}}" bindinput="stockDeltaChange" type="number"/></label><label>调整原因<input value="{{stockReason}}" bindinput="stockReasonChange" maxlength="500"/></label><button class="secondary {{saving ? 'control--disabled' : ''}}" bindtap="inventory" disabled="{{saving}}">记录库存调整</button></view>
  </block>
</view></view>
