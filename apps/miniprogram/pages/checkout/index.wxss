.checkout-page{padding-bottom:calc(env(safe-area-inset-bottom) + 190rpx)}.checkout-card{margin-top:24rpx;padding:24rpx;border:1rpx solid var(--cisme-line);border-radius:28rpx;background:#fff}.checkout-item{display:flex;gap:20rpx}.checkout-item image{width:132rpx;height:132rpx;flex:none;border-radius:20rpx;background:#eee7ef}.checkout-item view{display:flex;min-width:0;flex-direction:column}.checkout-item strong{font-size:30rpx;font-weight:500;line-height:1.35}.checkout-item small,.checkout-item text{margin-top:9rpx;color:var(--cisme-muted);font-size:24rpx}.section-title{margin-top:32rpx;color:var(--cisme-ink);font-size:28rpx;font-weight:500}.section-headline{display:flex;align-items:center;justify-content:space-between}.section-headline .text-button{margin-top:24rpx}.option-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-top:15rpx}.option{display:flex;align-items:flex-start;flex-direction:column;min-height:92rpx;padding:16rpx 18rpx;border:1rpx solid var(--cisme-line);border-radius:20rpx;background:#fff;text-align:left}.option strong{font-size:26rpx;font-weight:500}.option small{margin-top:5rpx;color:var(--cisme-muted);font-size:22rpx}.option--active{border-color:#7a5a88;background:#f0e7f3}.option--disabled{opacity:.48}.quantity{display:flex;align-items:center;gap:18rpx;margin-top:15rpx}.quantity button{width:44px;height:44px;padding:0;border:1rpx solid var(--cisme-line);border-radius:50%;background:#fff;font-size:32rpx}.quantity strong{min-width:56rpx;text-align:center;font-size:30rpx}.quantity text{margin-left:auto;color:var(--cisme-muted);font-size:22rpx}.address-options{display:grid;gap:12rpx;margin-top:15rpx}.address-option{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:104rpx;padding:18rpx;border:1rpx solid var(--cisme-line);border-radius:22rpx;background:#fff;text-align:left}.address-option view{display:flex;min-width:0;flex-direction:column}.address-option strong{font-size:25rpx;font-weight:500}.address-option view text{margin-top:7rpx;color:var(--cisme-muted);font-size:22rpx;line-height:1.5}.address-option>text{flex:none;margin-left:14rpx;color:var(--cisme-plum);font-size:22rpx}.address-option--active{border-color:#765284;background:#f3ebf5}.quote-card view{display:flex;justify-content:space-between;padding:8rpx 0;color:var(--cisme-muted);font-size:25rpx}.quote-card strong{color:var(--cisme-ink);font-weight:500;font-variant-numeric:tabular-nums}.quote-card .quote-total{margin-top:8rpx;padding-top:20rpx;border-top:1rpx solid var(--cisme-line);font-size:29rpx}.quote-card small{display:block;margin-top:16rpx;color:var(--cisme-muted);font-size:21rpx}.payment-note{display:flex;gap:14rpx;margin-top:22rpx;padding:20rpx;border-radius:22rpx;background:#eee7f0;color:#6d6171;font-size:23rpx;line-height:1.55}.payment-note image{width:30rpx;height:30rpx;flex:none}.checkout-action{position:fixed;z-index:35;right:20rpx;bottom:calc(env(safe-area-inset-bottom) + 16rpx);left:20rpx}.checkout-action .primary{margin:0}
.credit-option{display:flex;flex-direction:column;gap:12rpx}.credit-option strong{font-size:27rpx;font-weight:500}.credit-option text{font-size:23rpx;line-height:1.55;color:var(--cisme-muted)}.credit-option input{box-sizing:border-box;width:100%;height:80rpx;padding:0 18rpx;border:1rpx solid var(--cisme-line);border-radius:18rpx;background:#fff;color:var(--cisme-ink);font-size:28rpx}
