@import "../../styles/read-loading.wxss";
@import "../../styles/fulfillment-policy.wxss";
.checkout-page{padding-bottom:calc(env(safe-area-inset-bottom) + 190rpx)}.checkout-card{margin-top:24rpx;padding:24rpx;border:1rpx solid var(--cisme-line);border-radius:28rpx;background:#fff}.checkout-item{display:flex;gap:20rpx}.checkout-item image{width:132rpx;height:132rpx;flex:none;border-radius:20rpx;background:#eee7ef}.checkout-item view{display:flex;min-width:0;flex-direction:column}.checkout-item .coupon-heading{font-size:16px;font-weight:500;line-height:1.35}.checkout-item small,.checkout-item text{margin-top:9rpx;color:var(--cisme-muted);font-size:13px}.section-title{margin-top:32rpx;color:var(--cisme-ink);font-size:16px;font-weight:500}.section-headline{display:flex;align-items:center;justify-content:space-between}.section-headline .text-button{margin-top:24rpx}.option-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-top:15rpx}.option{display:flex;align-items:flex-start;flex-direction:column;min-height:92rpx;padding:16rpx 18rpx;border:1rpx solid var(--cisme-line);border-radius:20rpx;background:#fff;text-align:left}.option .coupon-heading{font-size:14px;font-weight:500}.option small{margin-top:5rpx;color:var(--cisme-muted);font-size:12px}.option--active{border-color:#7a5a88;background:#f0e7f3}.option--disabled{opacity:.48}.quantity{display:flex;align-items:center;gap:18rpx;margin-top:15rpx}.quantity button{width:44px;height:44px;padding:0;border:0;border-radius:0;background:transparent;font-size:32rpx}.quantity .coupon-heading{min-width:56rpx;text-align:center;font-size:16px}.quantity text{margin-left:auto;color:var(--cisme-muted);font-size:12px}.address-options{display:grid;gap:12rpx;margin-top:15rpx}.address-option{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:104rpx;padding:18rpx;border:1rpx solid var(--cisme-line);border-radius:22rpx;background:#fff;text-align:left}.address-option view{display:flex;min-width:0;flex-direction:column}.address-option .coupon-heading{font-size:14px;font-weight:500}.address-option view text{margin-top:7rpx;color:var(--cisme-muted);font-size:12px;line-height:1.5}.address-option>text{flex:none;margin-left:14rpx;color:var(--cisme-plum);font-size:12px}.address-option--active{border-color:#765284;background:#f3ebf5}.quote-card view{display:flex;justify-content:space-between;padding:8rpx 0;color:var(--cisme-muted);font-size:14px}.quote-card .coupon-heading{color:var(--cisme-ink);font-weight:500;font-variant-numeric:tabular-nums}.quote-card .quote-total{margin-top:8rpx;padding-top:20rpx;border-top:1rpx solid var(--cisme-line);font-size:16px}.quote-card small{display:block;margin-top:16rpx;color:var(--cisme-muted);font-size:12px}.payment-note{display:flex;gap:14rpx;margin-top:22rpx;padding:20rpx;border-radius:22rpx;background:#eee7f0;color:#6d6171;font-size:13px;line-height:1.55}.payment-note image{width:30rpx;height:30rpx;flex:none}.checkout-action{position:fixed;z-index:35;right:20rpx;bottom:calc(env(safe-area-inset-bottom) + 16rpx);left:20rpx}.checkout-action .primary{margin:0}
.credit-option{display:flex;flex-direction:column;gap:12rpx}.credit-option .coupon-heading{font-size:15px;font-weight:500}.credit-option text{font-size:13px;line-height:1.55;color:var(--cisme-muted)}.credit-option input{box-sizing:border-box;width:100%;height:80rpx;padding:0 18rpx;border:1rpx solid var(--cisme-line);border-radius:18rpx;background:#fff;color:var(--cisme-ink);font-size:16px}



/* Center the vector within the 44 px tap target, independent of the font baseline. */
.quantity button{display:flex;align-items:center;justify-content:center;flex:none;line-height:1}
.quantity__icon{width:18px;height:18px;flex:none}

.points-option__head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10rpx;margin-bottom:18rpx}
.points-option__head .coupon-heading{font-size:var(--cisme-text-action);font-weight:500}
.points-option__head text{color:var(--cisme-muted);font-size:var(--cisme-text-small)}
.points-choices{display:flex;gap:16rpx}
.points-choice{display:flex;align-items:center;justify-content:center;flex:1;min-width:0;min-height:48px;box-sizing:border-box;gap:8rpx;padding:8rpx 12rpx;border:1rpx solid var(--cisme-line);border-radius:18rpx;color:var(--cisme-ink);background:#fff;font-size:var(--cisme-text-body)}
.points-choice--selected{border-color:var(--cisme-plum);background:#f3ebf5}
.points-choice radio{flex:none;transform:scale(.8)}
.points-choice--disabled{opacity:.55}
.points-option__result{display:block;margin-top:16rpx;color:var(--cisme-plum);font-size:var(--cisme-text-body);font-variant-numeric:tabular-nums}
.shopping-points{margin:20rpx 8rpx 0;color:var(--cisme-muted);font-size:var(--cisme-text-small);line-height:1.6}
 .checkout-coupon{margin:24rpx 0;padding:10rpx 24rpx;border-radius:24rpx;background:#fff}.checkout-coupon__row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:52px;width:100%;padding:12rpx 0;background:transparent;text-align:left}.checkout-coupon__row .coupon-heading{font-size:14px;font-weight:600}.checkout-coupon__row>view{display:flex;align-items:center;gap:12rpx;color:var(--cisme-plum)}.checkout-coupon__row image{width:22rpx;height:22rpx}.checkout-coupon__error{display:flex;justify-content:space-between;align-items:center;gap:16rpx;color:var(--cisme-danger);font-size:12px;line-height:1.6}.checkout-coupon-mask{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-end;background:#2d193b66}.checkout-coupon-sheet{width:100%;max-height:80vh;overflow:auto;padding:28rpx 34rpx calc(env(safe-area-inset-bottom) + 30rpx);border-radius:32rpx 32rpx 0 0;background:#fdfaff}.checkout-coupon-head{display:flex;justify-content:space-between;align-items:center;gap:20rpx}.checkout-coupon-head .coupon-heading{font-size:18px;font-weight:600}.checkout-coupon-choice{display:flex;justify-content:space-between;align-items:center;width:100%;min-height:62px;margin-top:14rpx;padding:22rpx 20rpx;border:0;border-radius:18rpx;text-align:left;color:var(--cisme-ink);background:#f4eef7;font-size:15px}.checkout-coupon-choice--selected{background:#e9ddf1;color:var(--cisme-plum)}.checkout-coupon-choice>view{display:flex;flex-direction:column;gap:12rpx}.checkout-coupon-choice .coupon-heading{font-size:17px;font-weight:600}.checkout-coupon-choice>view text{font-size:12px;color:var(--cisme-muted)}.checkout-coupon-help{display:block;margin-top:22rpx;font-size:12px;color:var(--cisme-muted);line-height:1.6}
