.reward-checkout{display:block;}.reward-checkout__cover{position:relative;flex-shrink:0;width:128rpx;height:150rpx;overflow:hidden;background:#f2eaf6;border-radius:12rpx;}.reward-checkout__cover image{width:100%;height:100%;}.reward-checkout__cover .reward-checkout__pair,.reward-bundle-art .reward-checkout__pair--moisture{left:0;}.reward-checkout__selector{display:flex;justify-content:space-between;align-items:center;gap:20rpx;width:100%;min-height:88rpx;padding:16rpx 10rpx;background:transparent;color:var(--cisme-plum);font-size:28rpx;text-align:left;}.reward-checkout__selector image{width:24rpx;height:24rpx;}.reward-checkout__delivery{display:flex;justify-content:space-between;gap:20rpx;margin:20rpx 8rpx;color:var(--cisme-muted);font-size:23rpx;line-height:1.6;}

.reward-bundle-mask{position:fixed;inset:0;z-index:1000;display:flex;align-items:flex-end;justify-content:center;}
.reward-bundle-backdrop{position:absolute;inset:0;background:rgba(37,22,45,.35);}
.reward-bundle-sheet{position:relative;width:100%;max-width:520px;overflow:hidden;border-radius:32rpx 32rpx 0 0;background:#fdfaff;box-shadow:0 -12px 40px rgba(43,24,56,.15);animation:reward-picker-arrive 260ms cubic-bezier(.16,1,.3,1) both;}
.reward-bundle-handle{width:70rpx;height:7rpx;margin:16rpx auto 4rpx;background:#d7c9df;border-radius:4rpx;}
.reward-bundle-head{display:flex;align-items:center;justify-content:center;gap:24rpx;min-height:88rpx;padding:12rpx 120rpx;position:relative;}
.reward-bundle-head>text{font-size:36rpx;font-weight:600;color:var(--cisme-ink);white-space:nowrap;}
.reward-bundle-head>.text-button{position:absolute;right:28rpx;top:50%;transform:translateY(-50%);}
.reward-bundle-scroll{height:min(1000rpx,calc(86vh - 230rpx - env(safe-area-inset-bottom)));}
.reward-bundle-content{padding:12rpx 28rpx 24rpx;}
.reward-bundle-options,.reward-bundle-skeleton{display:flex;flex-direction:column;gap:32rpx;}
.reward-bundle-skeleton view{height:370rpx;background:#eee5f3;border-radius:24rpx;}
.reward-bundle-option{position:relative;box-sizing:border-box;overflow:hidden;display:block;padding:10rpx 24rpx 0;border:1rpx solid #e9e0e8;border-radius:24rpx;color:#302037;background:#fcf9fb;transition:background-color 160ms ease,border-color 160ms ease;}
.reward-bundle-option--selected{border-color:#dfd0e6;background:#f1e8f5;}
.reward-bundle-surface{position:absolute;inset:0;width:100%;height:100%;opacity:.24;pointer-events:none;transition:opacity 160ms ease;}
.reward-bundle-option--selected .reward-bundle-surface{opacity:.9;}
.reward-bundle-card-head{position:relative;display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:76rpx;}
.reward-bundle-name{font-size:34rpx;font-weight:600;line-height:1.5;}
.reward-bundle-detail{position:relative;z-index:3;flex-shrink:0;display:flex;align-items:center;justify-content:flex-end;gap:8rpx;min-width:120rpx;min-height:88rpx;padding:0;background:transparent;color:#59316d;font-size:26rpx;line-height:1.4;}
.reward-bundle-detail image{width:24rpx;height:24rpx;}
.reward-bundle-card-body{position:relative;display:flex;align-items:center;gap:18rpx;min-height:280rpx;}
.reward-bundle-art{position:relative;flex-shrink:0;width:44%;height:280rpx;overflow:hidden;margin:0;padding:0;background:transparent;border-radius:0;}
.reward-bundle-photo{display:block;width:100%;height:100%;}
.reward-bundle-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:12rpx;justify-content:center;min-height:196rpx;padding:8rpx 0 8rpx 20rpx;border-left:1rpx solid #d8c5e1;color:#5e4968;font-size:26rpx;line-height:1.65;}
.reward-bundle-benefit{margin-bottom:8rpx;color:#4d285f;font-size:30rpx;font-weight:600;line-height:1.55;}
.reward-bundle-meta{position:relative;display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:88rpx;border-top:1rpx solid rgba(79,42,104,.12);color:#65516f;font-size:25rpx;}
.reward-bundle-select{display:flex;align-items:center;justify-content:flex-end;gap:14rpx;min-width:88rpx;min-height:88rpx;padding:0;background:transparent;color:#4d285f;font-size:26rpx;line-height:1.5;}
.reward-bundle-radio{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:44rpx;height:44rpx;border:2rpx solid #9876a8;border-radius:50%;}
.reward-bundle-radio--selected{background:#613477;border-color:#613477;}
.reward-bundle-radio image{width:30rpx;height:30rpx;}
.reward-bundle-soldout{position:absolute;inset:0;z-index:2;display:flex;align-items:center;justify-content:center;pointer-events:none;background:rgba(210,208,216,.78);color:#49424f;}
.reward-bundle-soldout text{font-size:32rpx;font-weight:600;letter-spacing:.05em;}
.reward-bundle-footer{padding:18rpx 30rpx calc(env(safe-area-inset-bottom) + 24rpx);}
.reward-bundle-footer .primary{margin:0;}
@keyframes reward-picker-arrive{from{opacity:.55;transform:translateY(24rpx);}to{opacity:1;transform:translateY(0);}}
@media(prefers-reduced-motion:reduce){.reward-bundle-sheet{animation:none;}.reward-bundle-option,.reward-bundle-surface{transition:none;}}
@media(max-width:374px){.reward-bundle-content{padding-left:22rpx;padding-right:22rpx;}.reward-bundle-option{padding-left:20rpx;padding-right:20rpx;}.reward-bundle-head>text{font-size:34rpx;}.reward-bundle-card-body{gap:14rpx;}.reward-bundle-art{width:44%;height:276rpx;}.reward-bundle-name{font-size:32rpx;}.reward-bundle-copy{padding-left:16rpx;font-size:25rpx;}.reward-bundle-benefit{font-size:28rpx;}}
