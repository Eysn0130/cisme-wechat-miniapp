.reward-checkout{display:block;}.reward-checkout__cover{position:relative;flex-shrink:0;width:128rpx;height:150rpx;overflow:hidden;background:#f2eaf6;border-radius:12rpx;}.reward-checkout__cover image{width:100%;height:100%;}.reward-checkout__cover .reward-checkout__pair,.reward-bundle-art .reward-checkout__pair{position:absolute;top:0;width:200%;max-width:none;height:100%;}.reward-checkout__pair--moisture{left:0;}.reward-checkout__pair--dandruff{left:-100%;}.reward-checkout__selector{display:flex;justify-content:space-between;align-items:center;gap:20rpx;width:100%;min-height:88rpx;padding:16rpx 10rpx;background:transparent;color:var(--cisme-plum);font-size:28rpx;text-align:left;}.reward-checkout__selector image{width:24rpx;height:24rpx;}.reward-checkout__delivery{display:flex;justify-content:space-between;gap:20rpx;margin:20rpx 8rpx;color:var(--cisme-muted);font-size:23rpx;line-height:1.6;}
.reward-bundle-mask{position:fixed;inset:0;z-index:1000;display:flex;align-items:flex-end;justify-content:center;}.reward-bundle-backdrop{position:absolute;inset:0;background:rgba(37,22,45,.35);}.reward-bundle-sheet{position:relative;width:100%;max-width:520px;overflow:hidden;border-radius:32rpx 32rpx 0 0;background:#fdfaff;box-shadow:0 -12px 40px rgba(43,24,56,.15);animation:reward-picker-arrive 260ms cubic-bezier(.16,1,.3,1) both;}.reward-bundle-handle{width:70rpx;height:7rpx;margin:16rpx auto 4rpx;background:#d7c9df;border-radius:4rpx;}.reward-bundle-head{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:12rpx 32rpx;}.reward-bundle-head text{font-size:34rpx;font-weight:600;color:var(--cisme-ink);}.reward-bundle-scroll{height:min(560rpx,calc(80vh - 250rpx));}.reward-bundle-content{padding:12rpx 30rpx 28rpx;}.reward-bundle-options,.reward-bundle-skeleton{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;}.reward-bundle-skeleton view{height:390rpx;background:#eee5f3;border-radius:16rpx;}.reward-bundle-option{position:relative;box-sizing:border-box;overflow:hidden;display:block;padding:18rpx 18rpx 20rpx;border:1rpx solid transparent;border-radius:16rpx;color:var(--cisme-ink);background:#f1eaf5;text-align:left;}.reward-bundle-option--selected{border-color:var(--cisme-plum);background:#e9dff0;}.reward-bundle-art{position:relative;height:258rpx;overflow:hidden;margin:0 -10rpx 12rpx;}.reward-bundle-name{display:block;font-size:28rpx;font-weight:600;line-height:1.5;}.reward-bundle-spec{display:block;margin-top:6rpx;color:var(--cisme-muted);font-size:24rpx;line-height:1.5;}.reward-bundle-meta{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10rpx;margin-top:18rpx;font-size:22rpx;color:var(--cisme-muted);}.reward-bundle-soldout{position:absolute;inset:0;z-index:2;display:flex;align-items:center;justify-content:center;background:rgba(210,208,216,.78);color:#49424f;}.reward-bundle-soldout text{font-size:32rpx;font-weight:600;letter-spacing:.05em;}.reward-bundle-check{position:absolute;right:16rpx;top:16rpx;width:32rpx;height:32rpx;}.reward-bundle-footer{padding:18rpx 30rpx calc(env(safe-area-inset-bottom) + 24rpx);}.reward-bundle-footer .primary{margin:0;}@keyframes reward-picker-arrive{from{opacity:.55;transform:translateY(24rpx);}to{opacity:1;transform:translateY(0);}}@media(prefers-reduced-motion:reduce){.reward-bundle-sheet{animation:none;}}@media(max-width:374px){.reward-bundle-content{padding-left:22rpx;padding-right:22rpx;}.reward-bundle-art{height:230rpx;}.reward-bundle-name{font-size:26rpx;}.reward-bundle-options{gap:14rpx;}}

.reward-bundle-option.control--disabled{opacity:1;}
