.reward-checkout{display:block;}.reward-checkout__cover{position:relative;flex-shrink:0;width:128rpx;height:150rpx;overflow:hidden;background:#f2eaf6;border-radius:12rpx;}.reward-checkout__cover image{width:100%;height:100%;}.reward-checkout__cover .reward-checkout__pair,.reward-bundle-art .reward-checkout__pair{position:absolute;top:0;width:200%;max-width:none;height:100%;}.reward-checkout__pair--moisture{left:0;}.reward-checkout__pair--dandruff{left:-100%;}.reward-checkout__selector{display:flex;justify-content:space-between;align-items:center;gap:20rpx;width:100%;min-height:88rpx;padding:16rpx 10rpx;background:transparent;color:var(--cisme-plum);font-size:28rpx;text-align:left;}.reward-checkout__selector image{width:24rpx;height:24rpx;}.reward-checkout__delivery{display:flex;justify-content:space-between;gap:20rpx;margin:20rpx 8rpx;color:var(--cisme-muted);font-size:23rpx;line-height:1.6;}

.reward-bundle-mask{position:fixed;inset:0;z-index:1000;display:flex;align-items:flex-end;justify-content:center;}
.reward-bundle-backdrop{position:absolute;inset:0;background:rgba(37,22,45,.35);}
.reward-bundle-sheet{position:relative;width:100%;max-width:520px;overflow:hidden;border-radius:32rpx 32rpx 0 0;background:#fdfaff;box-shadow:0 -12px 40px rgba(43,24,56,.15);animation:reward-picker-arrive 260ms cubic-bezier(.16,1,.3,1) both;}
.reward-bundle-handle{width:70rpx;height:7rpx;margin:16rpx auto 4rpx;background:#d7c9df;border-radius:4rpx;}
.reward-bundle-head{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:12rpx 32rpx;}
.reward-bundle-head>text{font-size:34rpx;font-weight:600;color:var(--cisme-ink);}
.reward-bundle-scroll{height:min(800rpx,calc(84vh - 230rpx - env(safe-area-inset-bottom)));}
.reward-bundle-content{padding:12rpx 28rpx 24rpx;}
.reward-bundle-options,.reward-bundle-skeleton{display:flex;flex-direction:column;gap:24rpx;}
.reward-bundle-skeleton view{height:370rpx;background:#eee5f3;border-radius:24rpx;}
.reward-bundle-option{position:relative;box-sizing:border-box;overflow:hidden;display:block;padding:10rpx 24rpx 0;border-radius:24rpx;color:#302037;background:#f6f1f6;box-shadow:0 3px 12px rgba(51,29,64,.06);}
.reward-bundle-option--selected{background:#ede1f3;box-shadow:0 3px 14px rgba(78,42,99,.12);}
.reward-bundle-card-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:76rpx;}
.reward-bundle-name{font-size:32rpx;font-weight:600;line-height:1.5;}
.reward-bundle-detail{position:relative;z-index:3;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:88rpx;min-height:88rpx;padding:0;background:transparent;color:#59316d;font-size:26rpx;line-height:1.4;}
.reward-bundle-card-body{display:flex;align-items:center;gap:20rpx;min-height:252rpx;}
.reward-bundle-art{position:relative;flex-shrink:0;width:39%;height:250rpx;overflow:hidden;margin:0;padding:0;background:transparent;border-radius:0;}
.reward-bundle-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:12rpx;padding:8rpx 0;color:#5e4968;font-size:25rpx;line-height:1.65;}
.reward-bundle-benefit{margin-bottom:8rpx;color:#4d285f;font-size:28rpx;font-weight:600;line-height:1.55;}
.reward-bundle-meta{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:88rpx;border-top:1rpx solid rgba(79,42,104,.12);color:#65516f;font-size:25rpx;}
.reward-bundle-select{display:flex;align-items:center;justify-content:flex-end;gap:14rpx;min-width:150rpx;min-height:88rpx;padding:0;background:transparent;color:#4d285f;font-size:26rpx;line-height:1.5;}
.reward-bundle-radio{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:36rpx;height:36rpx;border:2rpx solid #9876a8;border-radius:50%;}
.reward-bundle-radio--selected{background:#613477;border-color:#613477;}
.reward-bundle-radio image{width:24rpx;height:24rpx;}
.reward-bundle-soldout{position:absolute;inset:0;z-index:2;display:flex;align-items:center;justify-content:center;pointer-events:none;background:rgba(210,208,216,.78);color:#49424f;}
.reward-bundle-soldout text{font-size:32rpx;font-weight:600;letter-spacing:.05em;}
.reward-bundle-footer{padding:18rpx 30rpx calc(env(safe-area-inset-bottom) + 24rpx);}
.reward-bundle-footer .primary{margin:0;}
@keyframes reward-picker-arrive{from{opacity:.55;transform:translateY(24rpx);}to{opacity:1;transform:translateY(0);}}
@media(prefers-reduced-motion:reduce){.reward-bundle-sheet{animation:none;}}
@media(max-width:374px){.reward-bundle-content{padding-left:22rpx;padding-right:22rpx;}.reward-bundle-option{padding-left:20rpx;padding-right:20rpx;}.reward-bundle-card-body{gap:14rpx;}.reward-bundle-art{width:36%;height:246rpx;}.reward-bundle-name{font-size:30rpx;}.reward-bundle-copy{font-size:24rpx;}.reward-bundle-benefit{font-size:26rpx;}}
