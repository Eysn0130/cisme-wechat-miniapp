<view class="chrome-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back {{busy||navigating?'control--disabled':''}}" bindtap="back" disabled="{{busy||navigating}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">确认订单</text></view><view class="page page--stack checkout-page">
  <text class="eyebrow">订单信息</text><view class="page-title">核对商品和地址</view><text class="subtitle">确认后查看本单费用。</text>
  <view wx:if="{{loading}}" class="state">正在同步商品与收货信息…</view><view wx:if="{{syncError}}" class="state state--error" aria-live="assertive">{{syncError}}</view><view wx:if="{{error}}" class="state state--error" aria-live="assertive">{{error}}</view>
  <block wx:if="{{product&&selectedSku}}"><view class="checkout-card checkout-item"><image src="{{product.image||'/assets/cisme/community-card-purple-bottle-v1.jpg'}}" mode="aspectFill"/><view><strong>{{product.name}}</strong><small>{{selectedSku.label}} · ¥{{unitPriceYuan}}</small><text>{{selectedSku.availableQuantity>0?'当前可用 '+selectedSku.availableQuantity:'当前缺货'}}</text></view></view>
    <view class="section-title">选择规格</view><view class="option-grid"><button wx:for="{{product.variants}}" wx:key="id" data-id="{{item.id}}" bindtap="selectSku" class="option {{selectedSku.id===item.id?'option--active':''}} {{!item.active||!item.inStock?'option--disabled':''}} {{busy||!item.active||!item.inStock?'control--disabled':''}}" disabled="{{busy||!item.active||!item.inStock}}"><strong>{{item.label}}</strong><small>¥{{item.priceCents/100}} · {{item.inStock?'可选':'缺货'}}</small></button></view>
    <view class="section-title">购买数量</view><view class="quantity"><button class="{{busy||quantity<=1?'control--disabled':''}}" bindtap="decrease" disabled="{{busy||quantity<=1}}" aria-label="减少数量"><image class="quantity__icon" src="/assets/icons/stepper-minus-plum.svg" mode="aspectFit"/></button><strong>{{quantity}}</strong><button class="{{busy||quantity>=selectedSku.availableQuantity||quantity>=99?'control--disabled':''}}" bindtap="increase" disabled="{{busy||quantity>=selectedSku.availableQuantity||quantity>=99}}" aria-label="增加数量"><image class="quantity__icon" src="/assets/icons/stepper-plus-plum.svg" mode="aspectFit"/></button><text>{{selectedSku.availableQuantity<99 ? '最多 '+selectedSku.availableQuantity+' 件' : '最多 99 件'}}</text></view>
    <view class="section-headline"><view class="section-title">收货地址</view><button class="text-button {{busy||navigating?'text-button--disabled':''}}" bindtap="editAddresses" disabled="{{busy||navigating}}">管理地址</button></view>
    <view wx:if="{{addresses.length}}" class="address-options"><button wx:for="{{addresses}}" wx:key="id" data-id="{{item.id}}" bindtap="selectAddress" disabled="{{busy}}" class="address-option {{selectedAddressId===item.id?'address-option--active':''}} {{busy?'control--disabled':''}}"><view><strong>{{item.recipientName}} · {{item.phone}}</strong><text>{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</text></view><text>{{selectedAddressId===item.id?'已选择':''}}</text></button></view><view wx:else class="state">尚未保存收货地址。请先前往设置新增；返回本页后规格和数量仍会保留。</view>
    <view wx:if="{{creditEnabled}}" class="checkout-card credit-option"><strong>购物权益 · 仅本机隔离测试</strong><text>当前可下单 ¥{{creditAvailableYuan}}；争议来源不计入，提交时仍会逐单复核。自愿输入使用金额；它不是优惠、积分或微信现金。</text><input type="digit" value="{{creditInput}}" placeholder="不使用请留空，例如 5.00" maxlength="11" bindinput="editCredit" disabled="{{busy}}" aria-label="本单使用购物权益金额，单位元"/></view>
    <view wx:if="{{creditReadError}}" class="state state--error">{{creditReadError}}</view>
    <view wx:if="{{quote}}" class="checkout-card quote-card"><view><text>商品小计</text><strong>¥{{subtotalYuan}}</strong></view><view><text>会员优惠</text><strong>− ¥{{discountYuan}}</strong></view><view><text>运费</text><strong>¥{{shippingYuan}}</strong></view><view class="quote-total"><text>商品与运费合计</text><strong>¥{{totalYuan}}</strong></view><view wx:if="{{quote.creditTenderCents>0}}"><text>购物权益 · 隔离测试</text><strong>− ¥{{creditYuan}}</strong></view><view wx:if="{{quote.creditTenderCents>0}}" class="quote-total"><text>模拟渠道现金</text><strong>¥{{cashYuan}}</strong></view><small wx:if="{{quoteExpired}}">费用已过期，请重新确认。</small><small wx:else>价格有效期 {{countdown}}，下单时仍会核价</small></view>
    <view wx:if="{{quote.fulfillmentPolicy}}" class="checkout-card fulfillment-policy"><strong>配送与售后承诺</strong><text>{{quote.fulfillmentPolicy.shippingPromise}}</text><text>{{quote.fulfillmentPolicy.dispatchPromise}}</text><text>{{quote.fulfillmentPolicy.returnsPromise}}</text><text>非质量原因退货运费由消费者承担；质量、错发、漏发及运输问题的合理费用由商家承担。</text></view>
    <view class="payment-note"><image src="/assets/icons/lock-key-plum.svg"/><text>{{formalPayment?'保存订单后，请确认微信付款；付款成功后会更新订单状态。':isolatedPayment?'本机隔离测试仅模拟微信支付，不会扣取真实款项。':'暂时无法付款。可先保存订单，稍后从订单页继续。'}}</text></view>
  </block>
</view><view wx:if="{{product&&selectedSku}}" class="checkout-action"><button wx:if="{{!quote}}" class="primary {{busy||!addresses.length||!selectedSku.purchaseEnabled?'primary--disabled':''}}" bindtap="requestQuote" loading="{{busy}}" disabled="{{busy||!addresses.length||!selectedSku.purchaseEnabled}}"><text class="action-label">{{busy?'正在确认':'查看费用'}}</text></button><button wx:elif="{{quoteExpired}}" class="primary {{busy?'primary--disabled':''}}" bindtap="refreshQuote" loading="{{busy}}" disabled="{{busy}}"><text class="action-label">{{busy?'正在重新确认':'重新查看费用'}}</text></button><button wx:else class="primary {{busy?'primary--disabled':''}}" bindtap="confirmOrder" loading="{{busy}}" disabled="{{busy}}"><text class="action-label">{{busy?'正在保存订单':'保存待支付订单'}}</text></button></view></view>
