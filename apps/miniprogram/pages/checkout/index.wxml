<import src="../../templates/fulfillment-policy.wxml"/>
<view class="chrome-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back {{busy||navigating?'control--disabled':''}}" bindtap="back" disabled="{{busy||navigating}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">确认订单</text></view><view class="page page--stack checkout-page">
  <view wx:if="{{loading && !product}}" class="page-read-loading" aria-role="status" aria-label="正在加载商品与地址…"><view class="page-read-loading__indicator"/></view><view wx:if="{{syncError}}" class="state state--error" aria-live="assertive">{{syncError}}<button class="text-button {{loading||busy||navigating?'text-button--disabled':''}}" bindtap="retryLoad" disabled="{{loading||busy||navigating}}">{{missingProduct?'查看商品':authenticationRequired?'重新登录':'重新加载'}}</button></view><view wx:if="{{error}}" class="state state--error" aria-live="assertive">{{error}}</view>
  <block wx:if="{{product&&selectedSku}}"><view class="checkout-card checkout-item"><image src="{{product.image||'/assets/icons/spray-bottle-plum.svg'}}" mode="aspectFill"/><view><strong>{{product.name}}</strong><small>{{selectedSku.label}} · ¥{{unitPriceYuan}}</small><text wx:if="{{selectedSku.availableQuantity<=0}}">当前缺货</text></view></view>
    <view class="section-title">选择规格</view><view class="option-grid"><button wx:for="{{product.variants}}" wx:key="id" data-id="{{item.id}}" bindtap="selectSku" class="option {{selectedSku.id===item.id?'option--active':''}} {{!item.active||!item.inStock?'option--disabled':''}} {{busy||loading||syncError||navigating||!item.active||!item.inStock?'control--disabled':''}}" disabled="{{busy||loading||syncError||navigating||!item.active||!item.inStock}}"><strong>{{item.label}}</strong><small>¥{{item.priceCents/100}} · {{item.inStock?'可选':'缺货'}}</small></button></view>
    <view class="section-title">购买数量</view><view class="quantity"><button class="{{busy||loading||syncError||navigating||quantity<=1?'control--disabled':''}}" bindtap="decrease" disabled="{{busy||loading||syncError||navigating||quantity<=1}}" aria-label="减少数量"><image class="quantity__icon" src="/assets/icons/stepper-minus-plum.svg" mode="aspectFit"/></button><strong>{{quantity}}</strong><button class="{{busy||loading||syncError||navigating||quantity>=selectedSku.availableQuantity||quantity>=99?'control--disabled':''}}" bindtap="increase" disabled="{{busy||loading||syncError||navigating||quantity>=selectedSku.availableQuantity||quantity>=99}}" aria-label="增加数量"><image class="quantity__icon" src="/assets/icons/stepper-plus-plum.svg" mode="aspectFit"/></button><text>{{selectedSku.availableQuantity<99 ? '最多 '+selectedSku.availableQuantity+' 件' : '最多 99 件'}}</text></view>
    <view class="section-headline"><view class="section-title">收货地址</view><button class="text-button {{busy||navigating?'text-button--disabled':''}}" bindtap="editAddresses" disabled="{{busy||navigating}}">管理地址</button></view>
    <view wx:if="{{addresses.length}}" class="address-options"><button wx:for="{{addresses}}" wx:key="id" data-id="{{item.id}}" bindtap="selectAddress" disabled="{{busy||loading||syncError||navigating}}" class="address-option {{selectedAddressId===item.id?'address-option--active':''}} {{busy||loading||syncError||navigating?'control--disabled':''}}"><view><strong>{{item.recipientName}} · {{item.phone}}</strong><text>{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</text></view><text>{{selectedAddressId===item.id?'已选择':''}}</text></button></view><view wx:else class="state">添加收货地址后即可下单。</view>
    <view wx:if="{{creditEnabled}}" class="checkout-card credit-option"><strong>测试购物权益</strong><text>可用测试权益 ¥{{creditAvailableYuan}}，仅用于模拟结算。</text><input type="digit" value="{{creditInput}}" placeholder="不使用请留空，例如 5.00" maxlength="11" bindinput="editCredit" disabled="{{busy||loading||syncError||navigating}}" aria-label="本单使用购物权益金额，单位元"/></view>
    <view wx:if="{{!loading&&!syncError&&!runtimeEnabled}}" class="state">下单暂未开放，可先查看商品。<button class="text-button {{busy?'text-button--disabled':''}}" bindtap="retryLoad" disabled="{{busy}}">重新加载</button></view>
    <view wx:if="{{creditReadError}}" class="state state--error">{{creditReadError}}</view>
    <view wx:if="{{quoteView}}" class="checkout-card quote-card"><view><text>商品小计</text><strong>{{quote?'¥' + subtotalYuan:'—'}}</strong></view><view wx:if="{{quoteView.memberDiscountCents>0}}"><text>{{quoteView.pointsSpent > 0 ? '积分抵扣（' + quoteView.pointsSpent + '分）' : '会员优惠'}}</text><strong>{{quote?'− ¥' + discountYuan:'—'}}</strong></view><view><text>运费</text><strong>{{quote?'¥' + shippingYuan:'—'}}</strong></view><view class="quote-total"><text>合计</text><strong>{{quote?'¥' + totalYuan:'—'}}</strong></view><view wx:if="{{quoteView.creditTenderCents>0}}"><text>测试购物权益</text><strong>{{quote?'− ¥' + creditYuan:'—'}}</strong></view><view wx:if="{{quoteView.creditTenderCents>0}}" class="quote-total"><text>模拟支付金额</text><strong>{{quote?'¥' + cashYuan:'—'}}</strong></view><small wx:if="{{quoteExpired}}">金额已过期，请重新确认。</small></view>
    <view wx:if="{{pointsMaximum!==null&&!quoteView.creditTenderCents}}" class="checkout-card points-option">
      <view class="points-option__head"><strong>积分抵扣</strong><text wx:if="{{busy}}" aria-live="polite">正在更新金额…</text><text wx:elif="{{pointsMaximum>0}}">本单可用 {{pointsMaximum}} 分</text><text wx:else>暂无可用积分</text></view>
      <radio-group class="points-choices" bindchange="selectPoints" aria-label="选择是否使用积分">
        <label class="points-choice {{pointsInput===0?'points-choice--selected':''}} {{busy||loading||navigating||syncError||quoteExpired?'points-choice--disabled':''}}"><radio value="none" checked="{{pointsInput===0}}" color="#56316f" disabled="{{busy||loading||navigating||syncError||quoteExpired}}"/><text>不用积分</text></label>
        <label class="points-choice {{pointsInput>0?'points-choice--selected':''}} {{busy||loading||navigating||syncError||quoteExpired||!pointsMaximum?'points-choice--disabled':''}}"><radio value="use" checked="{{pointsInput>0}}" color="#56316f" disabled="{{busy||loading||navigating||syncError||quoteExpired||!pointsMaximum}}"/><text>使用积分</text></label>
      </radio-group>
      <text wx:if="{{quote.pointsSpent>0}}" class="points-option__result" aria-live="polite">{{quote.pointsSpent}} 分抵 {{quote?'¥' + discountYuan:'—'}}</text>
    </view>
    <view wx:if="{{quoteView.shoppingPointsMultiplier}}" class="shopping-points"><text>商品积分 {{quoteView.shoppingPointsMultiplier}} 倍 · 收货后到账</text></view>
    <view wx:if="{{quoteView.fulfillmentPolicy}}" class="checkout-card"><template is="fulfillment-policy" data="{{policy:quoteView.fulfillmentPolicy,open:fulfillmentOpen}}"/></view>
    <view wx:if="{{!loading&&!syncError&&runtimeEnabled&&!formalPayment}}" class="payment-note"><image src="/assets/icons/lock-key-plum.svg"/><text>{{isolatedPayment?'测试订单，不会实际扣款。':'暂时无法付款，可保存订单后重试。'}}</text></view>
  </block>
</view><view wx:if="{{product&&selectedSku}}" class="checkout-action"><button wx:if="{{!quote}}" class="primary {{busy||loading||syncError||navigating||!runtimeEnabled||!addresses.length||!selectedSku.purchaseEnabled?'primary--disabled':''}}" bindtap="requestQuote" loading="{{busy}}" disabled="{{busy||loading||syncError||navigating||!runtimeEnabled||!addresses.length||!selectedSku.purchaseEnabled}}"><text class="action-label">{{busy?'正在确认':'确认金额'}}</text></button><button wx:elif="{{quoteExpired}}" class="primary {{busy||loading||syncError||navigating||!runtimeEnabled?'primary--disabled':''}}" bindtap="refreshQuote" loading="{{busy}}" disabled="{{busy||loading||syncError||navigating||!runtimeEnabled}}"><text class="action-label">{{busy?'正在重新确认':'重新确认金额'}}</text></button><button wx:else class="primary {{busy||loading||syncError||navigating||!runtimeEnabled?'primary--disabled':''}}" bindtap="confirmOrder" loading="{{busy}}" disabled="{{busy||loading||syncError||navigating||!runtimeEnabled}}"><text class="action-label">{{busy?'正在保存订单':'提交订单'}}</text></button></view></view>
