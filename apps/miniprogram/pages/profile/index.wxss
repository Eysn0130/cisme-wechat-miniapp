.profile-page{padding-top:calc(var(--cisme-menu-top,env(safe-area-inset-top)) + var(--cisme-menu-height,32px) + 22rpx);padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 166rpx);background:radial-gradient(circle at 88% 0,rgba(215,197,226,.42),transparent 27%),#f7f2f8}.profile-sync-status{min-height:30rpx;margin-bottom:10rpx;color:#817687;font-size:22rpx;text-align:right}.profile-identity{display:flex;align-items:center;gap:20rpx;min-height:126rpx}.profile-avatar-button{flex:none;width:100rpx;height:100rpx;padding:0;border:0;border-radius:50%;background:transparent}.profile-avatar{width:96rpx;height:96rpx;border:3rpx solid rgba(255,255,255,.9);border-radius:50%;box-shadow:0 8rpx 24rpx rgba(50,31,62,.11)}.profile-identity__copy{flex:1;min-width:0}.profile-identity__eyebrow,.profile-identity__title,.profile-identity__meta{display:block}.profile-identity__eyebrow{color:#817788;font:22rpx Georgia,serif;letter-spacing:3rpx}.profile-identity__title{margin-top:5rpx;overflow-wrap:anywhere;color:#3c3041;font-size:40rpx;font-weight:500;line-height:1.25}.profile-identity__meta{margin-top:5rpx;color:#6f6474;font-size:25rpx}.profile-settings{display:flex;align-items:center;justify-content:center;flex:none;width:44px;height:44px;padding:0;border:1rpx solid rgba(94,65,107,.08);border-radius:50%;background:rgba(255,255,255,.72)}.profile-settings image{width:38rpx;height:38rpx}
.care-status{display:block;width:100%;margin-top:24rpx;padding:32rpx;border:0;border-radius:30rpx;color:#fff;background:linear-gradient(145deg,#705586,#493558 64%,#34283d);box-shadow:0 22rpx 48rpx rgba(53,34,64,.17);text-align:left}.care-status__head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.care-status__label,.care-status__title,.care-status__copy{display:block}.care-status__label{color:rgba(255,255,255,.72);font-size:22rpx}.care-status__title{margin-top:8rpx;font-family:"Songti SC","STSong",serif;font-size:38rpx;font-weight:400}.care-status__caret{width:28rpx;height:28rpx}.care-status__copy{margin-top:12rpx;color:rgba(255,255,255,.8);font-size:25rpx;line-height:1.5}.care-progress{height:8rpx;margin-top:22rpx;overflow:hidden;border-radius:8rpx;background:rgba(255,255,255,.17)}.care-progress__bar{height:100%;border-radius:inherit;background:#e7d9ee}.care-status__stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid rgba(255,255,255,.14)}.care-status__stats view{min-width:0;padding:0 18rpx;border-left:1rpx solid rgba(255,255,255,.14)}.care-status__stats view:first-child{padding-left:0;border-left:0}.care-status__stats strong,.care-status__stats small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.care-status__stats strong{font:32rpx/1.2 Georgia,serif}.care-status__stats strong.pass-stat__value--compact{overflow:visible;font-size:25rpx;overflow-wrap:anywhere;white-space:normal}.care-status__stats small{margin-top:7rpx;color:rgba(255,255,255,.72);font-size:21rpx}
.profile-label{margin:30rpx 12rpx 12rpx;color:#827786;font-size:24rpx}.profile-group{overflow:hidden;border:1rpx solid rgba(80,54,92,.08);border-radius:28rpx;background:rgba(255,255,255,.82);box-shadow:0 8rpx 28rpx rgba(64,41,74,.05)}.profile-row{display:flex;align-items:center;gap:18rpx;width:100%;min-height:112rpx;padding:0 26rpx;border:0;border-bottom:1rpx solid rgba(78,47,91,.09);border-radius:0;color:inherit;background:transparent;text-align:left}.profile-row--last{border-bottom:0}.profile-row__icon{flex:none;width:34rpx;height:34rpx}.profile-row__copy{flex:1;min-width:0}.profile-row__copy strong,.profile-row__copy small{display:block}.profile-row__copy strong{color:#403545;font-size:27rpx;font-weight:500}.profile-row__copy small{margin-top:6rpx;overflow:hidden;color:#817687;font-size:23rpx;line-height:1.45;text-overflow:ellipsis;white-space:nowrap}.profile-row__caret{width:24rpx;height:24rpx}.commerce-note{display:flex;align-items:flex-start;gap:14rpx;margin-top:24rpx;padding:20rpx 22rpx;border-radius:22rpx;color:#776d7b;background:#ece5ef;font-size:23rpx;line-height:1.55}.commerce-note image{flex:none;width:30rpx;height:30rpx;margin-top:2rpx}.care-status:active,.profile-row:active,.profile-settings:active{opacity:.74}.profile-skeleton{padding-top:20rpx}.skeleton-line,.skeleton-block{border-radius:18rpx;background:linear-gradient(90deg,#eee7f0,#f8f4f9,#eee7f0);background-size:200% 100%;animation:profile-shimmer 1.2s ease-in-out infinite}.skeleton-line{height:70rpx}.skeleton-line--short{width:52%}.skeleton-block{height:300rpx;margin-top:28rpx}.skeleton-block--list{height:340rpx}@keyframes profile-shimmer{from{background-position:120% 0}to{background-position:-80% 0}}@media(prefers-reduced-motion:reduce){.skeleton-line,.skeleton-block{animation:none}.care-status,.profile-row,.profile-settings{transition:none}}
