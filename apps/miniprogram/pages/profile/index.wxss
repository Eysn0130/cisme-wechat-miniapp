/* A single member card; the whole surface opens the same points ledger. */
.member-card {
  position: relative;
  display: block;
  width: 100%;
  margin: 22rpx 0 0;
  padding: 20px;
  overflow: hidden;
  border: 1px solid rgba(238, 220, 249, .7);
  border-radius: 16px;
  color: #fbf6ff;
  background: radial-gradient(ellipse at 96% 0, rgba(206, 181, 229, .04), transparent 55%), linear-gradient(125deg, #665077, #4b355b 58%, #37273f);
  text-align: left;
  line-height: 1.5;
  transition: opacity var(--cisme-motion-press);
}
.member-card__contour {
  position: absolute;
  top: -145px;
  right: -96px;
  width: 240px;
  height: 240px;
  border: 1px solid rgba(237, 221, 250, .09);
  border-radius: 50%;
  pointer-events: none;
}
.member-card__head, .member-card__body, .member-card__footer { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.member-card__head { flex-wrap: wrap; }
.member-card__brand { font: 23px/1.2 Georgia, serif; letter-spacing: 4px; }
.member-card__identity { color: #fff; font-size: .8125rem; line-height: 1.5; }
.member-card__body { align-items: flex-end; flex-wrap: wrap; margin-top: 14px; }
.member-card__points { flex: 1 1 144px; min-width: 0; max-width: 100%; }
.member-card__label { display: block; color: #fff; font-size: .75rem; }
.member-card__balance { display: block; margin-top: 3px; color: #fff; font: 400 2.375rem/1.1 -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", sans-serif; font-variant-numeric: lining-nums tabular-nums; overflow-wrap: anywhere; white-space: normal; }
.member-card__balance.pass-stat__value--compact { font-size: 1.75rem; }
.member-card__entry { display: flex; align-items: center; gap: 4px; padding-bottom: 4px; color: #fff; font-size: .75rem; }
.member-card__entry image { flex: none; width: 16px; height: 16px; }
.member-card__footer { align-items: flex-start; flex-wrap: wrap; margin-top: 12px; padding-top: 9px; border-top: 1px solid rgba(237, 221, 250, .2); color: #dfd0e7; font-size: .6875rem; line-height: 1.5; }
.member-card__number { max-width: 100%; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; letter-spacing: .08em; }
.member-card--pressed { opacity: .94; }
@media (max-width: 340px) { .member-card { padding: 20px; } }
@media (prefers-reduced-motion: reduce) { .member-card { transition: none; } }
