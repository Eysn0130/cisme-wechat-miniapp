.profile-page { padding-top:calc(var(--cisme-menu-top,env(safe-area-inset-top)) + var(--cisme-menu-height,32px) + 22rpx); padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 166rpx); }
.profile-identity { display:flex; align-items:center; gap:22rpx; min-height:150rpx; padding:0 4rpx; }.profile-avatar { width:104rpx; height:104rpx; border:4rpx solid rgba(255,255,255,.9); border-radius:50%; box-shadow:0 10rpx 24rpx rgba(50,31,62,.12); }.profile-identity__copy { flex:1; min-width:0; }.profile-identity__eyebrow,.profile-identity__title,.profile-identity__meta { display:block; }.profile-identity__eyebrow { color:#817788; font:24rpx Georgia,serif; letter-spacing:4rpx; }.profile-identity__title { margin-top:6rpx; font-family:"Songti SC","STSong",serif; font-size:44rpx; font-weight:400; line-height:1.22; overflow-wrap:anywhere; white-space:normal; }.profile-identity__meta { margin-top:4rpx; color:#62586a; font-size:28rpx; line-height:1.45; white-space:normal; }
.profile-bell { display:flex; align-items:center; justify-content:center; width:44px; height:44px; padding:0; border:1rpx solid rgba(255,255,255,.82); border-radius:50%; background:rgba(255,255,255,.65); }.profile-bell__icon { width:20px; height:20px; }
.member-pass { position:relative; margin-top:28rpx; overflow:hidden; padding:38rpx 38rpx 32rpx; border:1rpx solid rgba(255,255,255,.55); border-radius:60rpx; color:#fff; background:linear-gradient(145deg,#73598a,#493459 62%,#30243a); box-shadow:inset 0 2rpx 8rpx rgba(255,255,255,.35),0 26rpx 60rpx rgba(47,29,58,.2); }.member-pass__glow { position:absolute; top:-150rpx; right:-50rpx; width:420rpx; height:420rpx; border-radius:50%; background:radial-gradient(circle at 42% 44%,rgba(226,199,249,.54),rgba(143,97,174,.19) 32%,transparent 68%); }
.member-pass__head,.member-pass__title,.member-pass__copy,.member-progress,.pass-stats { position:relative; }.member-pass__head { color:rgba(255,255,255,.82); font:22rpx Georgia,serif; line-height:1.45; letter-spacing:3rpx; }.member-pass__title { margin-top:42rpx; font-family:"Songti SC","STSong",serif; font-size:46rpx; font-weight:400; }.member-pass__copy { margin-top:10rpx; color:rgba(255,255,255,.82); font-size:28rpx; line-height:1.6; }
.member-progress { height:10rpx; margin:26rpx 0 30rpx; overflow:hidden; border-radius:10rpx; background:rgba(255,255,255,.18); }.member-progress__bar { height:100%; border-radius:inherit; background:linear-gradient(90deg,#d8c0ec,#fff); }
.pass-stats { display:flex; padding-top:28rpx; border-top:1rpx solid rgba(255,255,255,.14); }.pass-stat { display:flex; justify-content:center; flex:1; flex-direction:column; min-width:0; min-height:88rpx; padding:0 24rpx; border-left:1rpx solid rgba(255,255,255,.14); }.pass-stat--first { padding-left:0; border-left:0; }.pass-stat__value,.pass-stat__label { display:block; }.pass-stat__value { overflow:hidden; font:44rpx/1 Georgia,serif; font-variant-numeric:lining-nums tabular-nums; text-overflow:ellipsis; white-space:nowrap; }.pass-stat--balance .pass-stat__value { font-size:50rpx; }.pass-stat--balance .pass-stat__value--compact { overflow:visible; font-size:32rpx; text-overflow:clip; }.pass-stat--milestone .pass-stat__value { font-size:46rpx; }.pass-stat--share .pass-stat__value { font-size:40rpx; }.pass-stat__label { margin-top:10rpx; color:rgba(255,255,255,.82); font-size:24rpx; line-height:1.45; }
.profile-shortcuts { display:grid; grid-template-columns:repeat(3,1fr); gap:16rpx; margin-top:28rpx; }.profile-shortcut { display:flex; align-items:center; flex-direction:column; min-width:0; min-height:192rpx; padding:22rpx 6rpx 16rpx; border:1rpx solid rgba(255,255,255,.82); border-radius:42rpx; background:rgba(255,255,255,.66); font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif; line-height:1; }.shortcut-icon { display:flex; align-items:center; justify-content:center; width:78rpx; height:78rpx; border-radius:50%; background:#eee5f2; }.shortcut-icon__image { width:38rpx; height:38rpx; }.profile-shortcut__title { margin-top:12rpx; font-size:var(--cisme-text-small); font-weight:400; }.profile-shortcut__meta { max-width:100%; margin-top:6rpx; overflow:hidden; color:#62586a; font-size:var(--cisme-text-micro); line-height:1.5; text-overflow:ellipsis; white-space:nowrap; }
.profile-gate { display:grid; grid-template-columns:52rpx 1fr; align-items:start; gap:18rpx; margin-top:26rpx; padding:30rpx; border-radius:46rpx; }.profile-gate__icon { width:32rpx; height:32rpx; margin-top:4rpx; }.profile-gate__title,.profile-gate__copy { display:block; }.profile-gate__title { color:#5e4868; font-size:26rpx; font-weight:500; }.profile-gate__copy { margin-top:10rpx; color:#62586a; font-size:22rpx; line-height:1.55; }
.profile-menu { margin-top:26rpx; padding:8rpx 28rpx; border-radius:46rpx; }.menu-row { display:flex; align-items:center; width:100%; min-height:114rpx; padding:0; border:0; border-bottom:1rpx solid rgba(78,47,91,.1); border-radius:0; background:transparent; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif; text-align:left; }.menu-row--last { border-bottom:0; }.menu-row__icon { width:36rpx; height:36rpx; margin-right:18rpx; }.menu-row__copy { flex:1; }.menu-row__title,.menu-row__meta { display:block; }.menu-row__title { font-size:var(--cisme-text-small); font-weight:400; }.menu-row__meta { margin-top:6rpx; color:#62586a; font-size:var(--cisme-text-small); line-height:1.5; }.menu-caret { width:28rpx; height:28rpx; margin:0; }
