<page-meta root-font-size="system"/>
<view class="page profile-page" style="{{chromeStyle}}">
  <view wx:if="{{loading && !member}}" class="profile-skeleton" aria-live="polite"><view class="skeleton-line skeleton-line--short"></view><view class="skeleton-block"></view><view class="skeleton-block skeleton-block--list"></view></view>
  <block wx:if="{{member && points}}">
    <view class="profile-identity">
      <view class="profile-avatar-wrap"><button class="profile-avatar-button {{navigating ? 'control--disabled' : ''}}" bindtap="openAccount" aria-label="前往设置修改头像与昵称{{commercialEligible ? '，CISME 商业会员' : ''}}" disabled="{{navigating}}"><image class="profile-avatar" src="{{memberAvatar}}" mode="aspectFill"/></button><image wx:if="{{commercialEligible}}" class="profile-member-seal" src="/assets/icons/member-seal-plum.svg" mode="aspectFit" aria-hidden="true"/></view>
      <view class="profile-identity__copy"><text class="profile-identity__eyebrow">CISME 会员</text><strong class="profile-identity__title">{{member.display_name || 'CISME 会员'}}</strong></view>
      <button class="profile-settings {{navigating ? 'control--disabled' : ''}}" bindtap="openSettings" disabled="{{navigating}}" aria-label="打开设置"><image src="/assets/icons/gear-plum.svg" mode="aspectFit"/></button>
    </view>

    <button class="member-card {{navigating ? 'control--disabled' : ''}}" bindtap="openPoints" disabled="{{navigating}}" hover-class="member-card--pressed" aria-label="{{commercialState === 'ready' || (retainingSnapshot && commercialState === 'loading') ? (commercialEligible ? '商业会员' : 'CISME 会员') : commercialState === 'error' ? '身份待更新' : '身份同步中'}}会员卡，可用积分 {{points.projection.available}} 分，查看积分明细与兑换">
      <view class="member-card__contour" aria-hidden="true"></view>
      <view class="member-card__head">
        <text class="member-card__brand">CISME</text>
        <text class="member-card__identity">{{commercialState === 'ready' || (retainingSnapshot && commercialState === 'loading') ? (commercialEligible ? '商业会员' : 'CISME 会员') : commercialState === 'error' ? '身份待更新' : '身份同步中'}}</text>
      </view>
      <view class="member-card__body">
        <view class="member-card__points"><text class="member-card__label">会员积分 · 可用</text><text class="member-card__balance {{pointsBalanceClass}}">{{points.projection.available}}</text></view>
        <view class="member-card__entry"><text>积分明细与兑换</text><image src="/assets/icons/caret-right-white.svg" mode="aspectFit" aria-hidden="true"/></view>
      </view>
      <view class="member-card__footer"><text>会员卡</text><text>冻结 {{points.projection.frozen}} · 预占 {{points.projection.reserved}}</text></view>
      <text wx:if="{{points.expiring && points.expiring.points > 0}}" class="member-card__notice">{{points.expiring.withinDays}} 天内到期 {{points.expiring.points}} 分</text>
      <text wx:if="{{points.projection.debt > 0}}" class="member-card__notice">待冲抵欠分 {{points.projection.debt}}，后续所得优先冲抵</text>
    </button>
  </block>

  <view wx:if="{{error}}" class="state state--error" aria-live="assertive"><text wx:if="{{error}}">{{error}}</text><button class="text-button" bindtap="load">重新加载</button></view>

  <block wx:if="{{member || coreUnavailable}}">
    <view class="profile-label">常用服务</view>
    <view class="profile-group">
      <button class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openSupport" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/chat-circle-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>客服</strong><small>{{supportState === 'loading' && supportUnread === null ? '正在查看未读消息' : supportUnread === null ? '进入客服查看回复' : supportUnread ? supportUnread + ' 条未读回复' : '咨询护理、账号与服务问题'}}</small></view><text wx:if="{{supportUnread}}" style="display:flex;align-items:center;justify-content:center;min-width:34rpx;height:34rpx;padding:0 9rpx;border-radius:999rpx;color:#fff;background:#8d3150;font-size:20rpx">{{supportUnread > 99 ? '99+' : supportUnread}}</text><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openOrders" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/receipt-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>我的订单</strong><small>查看订单、物流与售后</small></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button class="profile-row profile-row--last {{navigating ? 'control--disabled' : ''}}" bindtap="openInvite" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/gift-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>邀请与分享</strong><small>分享给朋友，查看邀请记录</small></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button wx:if="{{commercialAccessible}}" class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openCommission" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/wallet-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>商业资格与佣金</strong><small>查看推荐记录与佣金</small></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
    </view>

    <view wx:if="{{(!retainingSnapshot && (authorityState !== 'ready' || commercialState !== 'ready')) || authorityState === 'error' || commercialState === 'error'}}" class="profile-sync-status" aria-live="polite">{{authorityState === 'loading' || commercialState === 'loading' ? '正在更新账号状态…' : '部分账号信息暂未加载，请重试。'}}<button wx:if="{{authorityState === 'error' || commercialState === 'error'}}" class="text-button" bindtap="retryAuxiliary">重试</button></view>
    <block wx:if="{{authority.managementAvailable && managementEntryAvailable}}"><view class="profile-label">管理服务</view><view class="profile-group"><button class="profile-row profile-row--last {{navigating || authorityState !== 'ready' ? 'control--disabled' : ''}}" bindtap="openManagement" disabled="{{navigating || authorityState !== 'ready'}}"><image class="profile-row__icon" src="/assets/icons/shield-check-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>管理中心</strong><small>处理订单、客服与运营事项</small></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button></view></block>

    <view class="profile-label">账号与活动</view>
    <view class="profile-group">
      <button class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openCommunityActivity" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/chat-circle-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>我的社区</strong></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openMyPosts" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/note-pencil-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>投稿与草稿</strong><small>查看已发布内容与草稿</small></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button class="profile-row profile-row--last {{navigating ? 'control--disabled' : ''}}" bindtap="openSettings" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/gear-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>设置</strong><small>昵称、收货地址、隐私、会员编号</small></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
    </view>

  </block>
</view>
