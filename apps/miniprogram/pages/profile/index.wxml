<page-meta root-font-size="system"/>
<view class="page profile-page" style="{{chromeStyle}}">
  <view wx:if="{{loading && !member}}" class="profile-skeleton" aria-live="polite"><view class="skeleton-line skeleton-line--short"></view><view class="skeleton-block"></view><view class="skeleton-block skeleton-block--list"></view></view>
  <block wx:if="{{member && points}}">
    <view class="profile-identity">
      <view class="profile-avatar-wrap"><button class="profile-avatar-button {{navigating ? 'control--disabled' : ''}}" bindtap="openAccount" aria-label="前往设置修改头像与昵称{{commercialEligible ? '，CISME 商业会员' : ''}}" disabled="{{navigating}}"><image class="profile-avatar" src="{{memberAvatar}}" mode="aspectFill"/></button><image wx:if="{{commercialEligible}}" class="profile-member-seal" src="/assets/icons/member-seal-plum.svg" mode="aspectFit" aria-hidden="true"/></view>
      <view class="profile-identity__copy"><button class="profile-identity__edit {{navigating ? 'control--disabled' : ''}}" bindtap="openAccount" disabled="{{navigating}}" aria-label="{{member.completed_at ? '修改微信头像与昵称' : '设置微信头像与昵称'}}"><text class="profile-identity__title">{{member.display_name && (member.completed_at || member.display_name !== 'CISME 会员') ? member.display_name : '设置头像与昵称'}}</text></button></view>
      <button class="profile-settings {{navigating ? 'control--disabled' : ''}}" bindtap="openSettings" disabled="{{navigating}}" aria-label="打开设置"><image src="/assets/icons/gear-plum.svg" mode="aspectFit"/></button>
    </view>

    <button class="member-card {{navigating ? 'control--disabled' : ''}}" bindtap="openPoints" bindlongpress="revealCardSpark" data-foil-surface="member" bindtouchstart="beginFoil" bindtouchmove="moveFoil" bindtouchend="endFoil" bindtouchcancel="endFoil" disabled="{{navigating}}" hover-class="member-card--pressed" aria-label="会员卡，{{commercialState === 'ready' || (retainingSnapshot && commercialState === 'loading') ? (commercialEligible ? '商业会员' : 'CISME 会员') : commercialState === 'error' ? '身份待更新' : '身份同步中'}}{{member.card_number ? '，会员编号 No. ' + member.card_number : ''}}，可用积分 {{points.projection.available}} 分，查看积分明细与兑换">
      <card-foil id="member-foil" tone="member" active="{{foilSurface==='member'}}" x="{{foilX}}" y="{{foilY}}" intro="{{true}}" flash="{{cardSparkActive}}"/>
      <view class="member-card__contour" aria-hidden="true"></view>
      <view class="member-card__head">
        <text class="member-card__brand">CISME</text>
        <text class="member-card__identity">{{commercialState === 'ready' || (retainingSnapshot && commercialState === 'loading') ? (commercialEligible ? '商业会员' : 'CISME 会员') : commercialState === 'error' ? '身份待更新' : '身份同步中'}}</text>
      </view>
      <view class="member-card__body">
        <view class="member-card__points"><text class="member-card__label">可用积分</text><text class="member-card__balance {{pointsBalanceClass}}">{{points.projection.available}}</text></view>
        <view class="member-card__entry"><text>积分明细与兑换</text><image src="/assets/icons/caret-right-white.svg" mode="aspectFit" aria-hidden="true"/></view>
      </view>
      <view class="member-card__footer"><text>会员卡</text><text wx:if="{{member.card_number}}" class="member-card__number">No. {{member.card_number}}</text></view>
    </button>
  </block>

  <view wx:if="{{error}}" class="state state--error" aria-live="assertive"><text wx:if="{{error}}">{{error}}</text><button class="text-button" bindtap="load">重新加载</button></view>

  <block wx:if="{{member || coreUnavailable}}">
    <view class="profile-label">常用服务</view>
    <view class="profile-group">
      <button class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openSupport" disabled="{{navigating}}" aria-label="{{supportUnread?'客服，'+supportUnread+'条未读':'客服'}}"><image class="profile-row__icon" src="/assets/icons/chat-circle-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>客服</strong></view><text wx:if="{{supportUnread}}" style="display:flex;align-items:center;justify-content:center;min-width:34rpx;height:34rpx;padding:0 9rpx;border-radius:999rpx;color:#fff;background:#8d3150;font-size:20rpx">{{supportUnread > 99 ? '99+' : supportUnread}}</text><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openOrders" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/receipt-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>我的订单</strong></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openSharingOfficer" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/gift-plum.svg"/><view class="profile-row__copy"><strong>分享官</strong></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
      <button class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openMyReferrer" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/user-circle-plum.svg"/><view class="profile-row__copy"><strong>我的推荐人</strong></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg"/></button>
      <button class="profile-row profile-row--last {{navigating ? 'control--disabled' : ''}}" bindtap="openInvite" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/gift-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>邀请与分享</strong></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button wx:if="{{commercialAccessible}}" class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openCommission" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/wallet-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>商业资格与佣金</strong></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
    </view>

    <view wx:if="{{(!retainingSnapshot && (authorityState !== 'ready' || commercialState !== 'ready')) || authorityState === 'error' || commercialState === 'error'}}" class="profile-sync-status" aria-live="polite">{{authorityState === 'loading' || commercialState === 'loading' ? '正在更新账号状态…' : '部分账号信息暂未加载，请重试。'}}<button wx:if="{{authorityState === 'error' || commercialState === 'error'}}" class="text-button" bindtap="retryAuxiliary">重试</button></view>
    <block wx:if="{{authority.managementAvailable && managementEntryAvailable}}"><view class="profile-label">管理服务</view><view class="profile-group"><button class="profile-row profile-row--last {{navigating || authorityState !== 'ready' ? 'control--disabled' : ''}}" bindtap="openManagement" disabled="{{navigating || authorityState !== 'ready'}}"><image class="profile-row__icon" src="/assets/icons/shield-check-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>管理中心</strong></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button></view></block>

    <view class="profile-label">账号与活动</view>
    <view class="profile-group">
      <button class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openRewards" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/gift-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>我的奖励</strong></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openCommunityActivity" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/chat-circle-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>我的社区</strong></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button class="profile-row {{navigating ? 'control--disabled' : ''}}" bindtap="openMyPosts" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/note-pencil-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>投稿与草稿</strong></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button class="profile-row profile-row--last {{navigating ? 'control--disabled' : ''}}" bindtap="openSettings" disabled="{{navigating}}"><image class="profile-row__icon" src="/assets/icons/gear-plum.svg" mode="aspectFit"/><view class="profile-row__copy"><strong>设置</strong></view><image class="profile-row__caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
    </view>

  </block>
</view>
<points-celebration id="onboarding-credit" owner="{{member.id || ''}}" enabled="{{!loading}}"/>
