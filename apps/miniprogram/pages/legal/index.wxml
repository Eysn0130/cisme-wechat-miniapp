<view class="chrome-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">{{type === 'privacy' ? '隐私保护指引' : type === 'cross_border' ? '境外存储告知' : '用户协议'}}</text></view><view class="page page--stack"><view wx:if="{{loading}}" class="state">正在加载协议…</view><view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="load">重试</button></view><view wx:if="{{legalDoc}}"><view class="legal-title">{{legalDoc.title}}</view><view class="legal-meta">版本 {{legalDoc.version}}</view><view class="legal-meta">运营主体：{{legalDoc.operator_name}}</view><text class="legal-body" user-select="true">{{legalDoc.body}}</text><view class="legal-meta">联系渠道：{{legalDoc.contact}}</view><button class="secondary" bindtap="privacyRights">隐私咨询与数据权利</button></view></view></view>
