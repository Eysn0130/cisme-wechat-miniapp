<view class="chrome-root" style="{{chromeStyle}}">
<view class="topbar">
<button class="topbar__back" bindtap="back" aria-label="返回">
<image aria-hidden="true" class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/>
</button>
<text class="topbar__title">协议与隐私</text>
</view>
<view class="page page--stack legal-page">
<section-tabs items="{{documentTabs}}" value="{{type}}" bindchange="changeDocument" label="协议类型"/>
<view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在加载协议">
<view class="page-read-loading__indicator"/>
</view>
<view wx:if="{{error}}" class="state state--error" aria-live="polite">
<text>{{error}}</text>
<button class="text-button" bindtap="load">重新加载</button>
</view>
<view wx:if="{{legalDoc}}" class="legal-document">
<view class="legal-title">{{legalDoc.title}}</view>
<view class="legal-meta">版本 {{legalDoc.version}}</view>
<view class="legal-meta">运营主体：{{legalDoc.operator_name}}</view>
<view class="legal-body">
<text wx:for="{{legalBlocks}}" wx:key="id" class="legal-block legal-block--{{item.kind}} legal-block--level{{item.level}}" user-select="true">{{item.text}}</text>
</view>
<view class="legal-meta">联系渠道：{{legalDoc.contact}}</view>
<button class="secondary legal-rights" bindtap="privacyRights">数据与账号权利</button>
</view>
</view>
</view>
