.management-order-detail{background:#f7f2f8}.admin-detail-card{display:flex;flex-direction:column;gap:14rpx;margin-top:22rpx;padding:24rpx;border:1rpx solid var(--cisme-line);border-radius:26rpx;background:#fff}.admin-detail-card>strong{font-size:28rpx;font-weight:500}.admin-detail-card>text{color:var(--cisme-muted);font-size:24rpx;line-height:1.55}.admin-line,.admin-total{display:flex;justify-content:space-between;gap:18rpx;color:var(--cisme-muted);font-size:24rpx}.admin-line text{min-width:0;flex:1}.admin-line strong,.admin-total strong{flex:none;color:var(--cisme-ink);font-weight:500;font-variant-numeric:tabular-nums}.admin-total{margin-top:4rpx;padding-top:18rpx;border-top:1rpx solid var(--cisme-line);font-size:29rpx}.privacy-note{display:flex;gap:14rpx;margin-top:22rpx;padding:20rpx;border-radius:22rpx;background:#eee7f0;color:#6d6171;font-size:23rpx;line-height:1.55}.privacy-note image{width:30rpx;height:30rpx;flex:none}
