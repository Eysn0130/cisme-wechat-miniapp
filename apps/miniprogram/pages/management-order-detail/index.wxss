@import "../../styles/management-workbench.wxss";
@import "../../styles/read-loading.wxss";
.management-order-detail{background:#f7f2f8}.admin-detail-card{display:flex;flex-direction:column;gap:14rpx;margin-top:22rpx;padding:24rpx;border:1rpx solid var(--cisme-line);border-radius:26rpx;background:#fff}.admin-detail-card>strong{font-size:28rpx;font-weight:500}.admin-detail-card>text{color:var(--cisme-muted);font-size:24rpx;line-height:1.55}

.shipment-card label{display:flex;flex-direction:column;gap:12rpx;font-size:24rpx;color:var(--cisme-ink)}.shipment-card input{box-sizing:border-box;min-height:92rpx;padding:20rpx;border:1rpx solid var(--cisme-line);border-radius:18rpx;font-size:28rpx;background:var(--cisme-bg,#f7f2f8)}.shipment-picker-field{min-height:88rpx;display:flex;align-items:center;padding:0 20rpx;border:1rpx solid var(--cisme-line);border-radius:18rpx;font-size:26rpx}.shipment-card button{width:100%;margin:0;white-space:normal}

.shipment-picker-field{justify-content:space-between;background:var(--cisme-page)}.shipment-carrier-error{display:flex;align-items:center;gap:16rpx;color:var(--cisme-muted);font-size:var(--cisme-text-small)}.shipment-carrier-error text{flex:1}.shipment-carrier-error button{flex:none;width:auto;min-width:var(--cisme-hit-target)}

.shipment-admin__heading{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}
.shipment-admin__heading strong{font-size:var(--cisme-text-action);font-weight:500}
.shipment-admin__status{color:var(--cisme-plum);font-size:var(--cisme-text-small);text-align:right}
.shipment-admin__waybill{display:flex;flex-direction:column;gap:5rpx;padding:16rpx 0;border-block:1rpx solid var(--cisme-line);color:var(--cisme-muted);font-size:var(--cisme-text-small)}
.shipment-admin__number{color:var(--cisme-ink);font-size:var(--cisme-text-action);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.shipment-admin__error{display:flex;align-items:center;gap:10rpx;color:var(--cisme-danger)}
.shipment-admin__error text{flex:1;min-width:0}

.order-aftersale__heading,.order-aftersale__footer{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
}
.order-aftersale button{width:auto;margin:0;min-height:var(--cisme-hit-target)}
.order-aftersale .text-button{padding:0}
.order-aftersale__reason{white-space:pre-wrap;overflow-wrap:anywhere}
.order-aftersale__actions{display:flex;flex-wrap:wrap;align-items:center;gap:16rpx}
.management-ui .order-aftersale__actions .primary-button,
.management-ui .shipment-card .shipment-submit{
  flex:1;
  min-width:180rpx;
  min-height:var(--cisme-hit-target);
  border-radius:var(--cisme-radius-control);
  background:var(--cisme-plum);
  color:#fff;
  font-weight:500;
}
.order-aftersale .order-aftersale__reject{padding:0 14rpx;color:var(--cisme-danger)}
.order-aftersale__hint{color:var(--cisme-muted);font-size:var(--cisme-text-small)}

.manage-order-overview {
  color: var(--cisme-ink);
}
.manage-order-status {
  font-size: 1.625rem;
  font-weight: 600;
  line-height: 1.25;
}
.manage-order-number,
.manage-order-subtle,
.manage-order-date {
  color: var(--cisme-muted);
  font-size: .8125rem;
  line-height: 1.4;
}
.manage-order-number {
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
.manage-order-value {
  color: var(--cisme-ink);
  font-weight: 600;
  font-size: .9375rem;
  font-variant-numeric: tabular-nums;
}
.manage-order-details {
  margin-top: 24rpx;
  color: var(--cisme-ink);
}
.manage-order-section {
  padding: 18rpx 4rpx;
  border-top: 1rpx solid var(--cisme-line);
}
.manage-order-section__title {
  color: var(--cisme-ink);
  font-weight: 600;
  font-size: .9375rem;
}
.manage-order-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding: 9rpx 0;
  font-size: .875rem;
  line-height: 1.4;
}
.manage-order-row--product { padding: 18rpx 0; }
.manage-order-row--total { padding-top: 14rpx; border-top: 1rpx solid var(--cisme-line); }
.manage-order-product,
.manage-order-destination {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}
.manage-order-product__name { font-weight: 500; }
.manage-order-destination,
.manage-order-date { text-align: right; flex: 1; }
.manage-order-review .order-aftersale__heading,
.manage-order-review .order-aftersale__footer {
  min-height: var(--cisme-hit-target);
}


.manage-order-overview {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8rpx 16rpx;
  align-items: end;
  padding: 21rpx 0 25rpx;
}
.manage-order-status { grid-column: 1; grid-row: 1; }
.manage-order-number { grid-column: 1; grid-row: 2; }
.manage-order-overview__amount {
  grid-column: 2;
  grid-row: 1 / span 2;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}
.manage-order-overview__amount .manage-order-value { color: var(--cisme-plum); font-size: 1.5rem; }
.manage-order-review {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 24rpx 0;
  border-radius: var(--cisme-radius-card);
  background: var(--cisme-card);
}
.manage-order-review .order-aftersale__heading { align-items: center; border-bottom: 1rpx solid var(--cisme-line); }
.manage-order-review .order-aftersale__reason { color: var(--cisme-ink); font-size: .9375rem; line-height: 1.5; }
.manage-order-review .order-aftersale__actions { margin-top: 7rpx; }
.manage-order-review .order-aftersale__footer { border-top: 1rpx solid var(--cisme-line); }
