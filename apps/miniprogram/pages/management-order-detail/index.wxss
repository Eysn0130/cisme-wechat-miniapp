@import "../../styles/management-workbench.wxss";
@import "../../styles/read-loading.wxss";
.management-order-detail{background:#f7f2f8}.admin-detail-card{display:flex;flex-direction:column;gap:14rpx;margin-top:22rpx;padding:24rpx;border:1rpx solid var(--cisme-line);border-radius:26rpx;background:#fff}.admin-detail-card>strong{font-size:28rpx;font-weight:500}.admin-detail-card>text{color:var(--cisme-muted);font-size:24rpx;line-height:1.55}.admin-line,.admin-total{display:flex;justify-content:space-between;gap:18rpx;color:var(--cisme-muted);font-size:24rpx}.admin-line text{min-width:0;flex:1}.admin-line strong,.admin-total strong{flex:none;color:var(--cisme-ink);font-weight:500;font-variant-numeric:tabular-nums}.admin-total{margin-top:4rpx;padding-top:18rpx;border-top:1rpx solid var(--cisme-line);font-size:29rpx}.privacy-note{display:flex;gap:14rpx;margin-top:22rpx;padding:20rpx;border-radius:22rpx;background:#eee7f0;color:#6d6171;font-size:23rpx;line-height:1.55}.privacy-note image{width:30rpx;height:30rpx;flex:none}

.shipment-card label{display:flex;flex-direction:column;gap:12rpx;font-size:24rpx;color:var(--cisme-ink)}.shipment-card input{box-sizing:border-box;min-height:92rpx;padding:20rpx;border:1rpx solid var(--cisme-line);border-radius:18rpx;font-size:28rpx;background:var(--cisme-bg,#f7f2f8)}.shipment-picker-field{min-height:88rpx;display:flex;align-items:center;padding:0 20rpx;border:1rpx solid var(--cisme-line);border-radius:18rpx;font-size:26rpx}.shipment-card button{width:100%;margin:0;white-space:normal}

.shipment-picker-field{justify-content:space-between;background:var(--cisme-page)}.shipment-carrier-error{display:flex;align-items:center;gap:16rpx;color:var(--cisme-muted);font-size:var(--cisme-text-small)}.shipment-carrier-error text{flex:1}.shipment-carrier-error button{flex:none;width:auto;min-width:var(--cisme-hit-target)}

.shipment-admin__heading{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}
.shipment-admin__heading strong{font-size:var(--cisme-text-action);font-weight:500}
.shipment-admin__status{color:var(--cisme-plum);font-size:var(--cisme-text-small);text-align:right}
.shipment-admin__waybill{display:flex;flex-direction:column;gap:5rpx;padding:16rpx 0;border-block:1rpx solid var(--cisme-line);color:var(--cisme-muted);font-size:var(--cisme-text-small)}
.shipment-admin__number{color:var(--cisme-ink);font-size:var(--cisme-text-action);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.shipment-admin__error{display:flex;align-items:center;gap:10rpx;color:var(--cisme-danger)}
.shipment-admin__error text{flex:1;min-width:0}

.order-aftersale button{width:100%;margin:0;min-height:var(--cisme-hit-target)}
.order-aftersale__actions{display:flex;flex-wrap:wrap;gap:14rpx}
.order-aftersale__actions button{flex:1;min-width:180rpx}
.order-aftersale__reject{color:var(--cisme-danger)}
