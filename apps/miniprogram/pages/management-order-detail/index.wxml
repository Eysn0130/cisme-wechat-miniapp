<view class="management-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back {{navigating?'control--disabled':''}}" bindtap="back" disabled="{{navigating}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">订单核对</text></view><view class="page page--stack management-order-detail"><view wx:if="{{loading}}" class="state">正在读取最新订单与权限…</view><view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="load">重试</button></view><block wx:if="{{order}}"><text class="eyebrow">{{order.orderNumber}}</text><view class="page-title">{{order.statusLabel}}</view><text class="subtitle">创建于 {{order.createdLabel}} · 版本 {{order.version}}</text><view class="admin-detail-card"><strong>商品与金额</strong><view wx:for="{{order.lines}}" wx:key="id" class="admin-line"><text>{{item.productName}} · {{item.skuLabel}} × {{item.quantity}}</text><strong>¥{{item.totalYuan}}</strong></view><view class="admin-total"><text>订单合计</text><strong>¥{{order.totalYuan}}</strong></view></view><view class="admin-detail-card"><strong>脱敏收货信息</strong><block wx:if="{{order.address}}"><text>{{order.address.recipientNameMasked}} · {{order.address.phoneMasked}}</text><text>{{addressSummary}}</text></block><text wx:else>地址快照暂时不可读</text></view><view class="privacy-note"><image src="/assets/icons/lock-key-plum.svg"/><text>commerce.order.read 不授予完整地址读取。本页不含发货、付款确认或退款动作。</text></view></block></view></view>
