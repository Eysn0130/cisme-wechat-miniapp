.settings-page{display:flex;flex-direction:column;min-height:100vh;padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 56px));padding-right:var(--cisme-page-gutter);padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + var(--cisme-space-3));padding-left:var(--cisme-page-gutter);background:var(--cisme-page)}.settings-topbar__copy{display:flex;align-items:center;flex-direction:column}.settings-topbar__subtitle{margin-top:4rpx;color:var(--cisme-muted);font-size:var(--cisme-text-small)}.settings-operation-status{margin:0 0 16rpx;color:var(--cisme-plum);font-size:var(--cisme-text-body);text-align:center}.settings-label{margin:var(--cisme-space-6) var(--cisme-space-3) var(--cisme-space-2);color:var(--cisme-muted);font-size:var(--cisme-text-small);font-weight:500;line-height:1.5}.settings-label--first{margin-top:var(--cisme-space-2)}.settings-group,.settings-detail{flex-shrink:0;overflow:hidden;border:1rpx solid var(--cisme-line);border-radius:var(--cisme-radius-card);background:var(--cisme-card)}
