.settings-page { padding-right:24rpx; padding-left:24rpx; background:linear-gradient(180deg,#f6f0f8,#fbf8fb); }.settings-operation-status { margin:0 0 18rpx; color:#5d416f; font-size:var(--cisme-text-small); line-height:1.5; text-align:center; }.settings-topbar__copy { display:flex; align-items:center; flex-direction:column; }.settings-topbar__subtitle { margin-top:4rpx; color:#62586a; font-size:24rpx; }
.settings-label { margin:27rpx 10rpx 12rpx; color:#756a79; font-size:24rpx; letter-spacing:1rpx; }.settings-label--first { margin-top:4rpx; }.settings-group { padding:0 25rpx; border-radius:44rpx; }.settings-row { display:flex; align-items:center; gap:15rpx; min-height:104rpx; border-bottom:1rpx solid rgba(78,47,91,.1); }.settings-row--last { border-bottom:0; }.settings-row__icon { flex:0 0 auto; width:32rpx; height:32rpx; }.settings-row__copy { flex:1; }.settings-row__title,.settings-row__subtitle { display:block; }.settings-row__title { color:#493b4e; font-size:24rpx; font-weight:500; }.settings-row__subtitle { margin-top:5rpx; color:#62586a; font-size:24rpx; line-height:1.45; }.settings-caret { width:27rpx; height:27rpx; }.settings-empty { padding:42rpx 0; color:#62586a; font-size:24rpx; text-align:center; }.consent-row__revoke { min-width:88rpx; min-height:88rpx; padding:0 14rpx; }
.settings-principle { display:flex; align-items:flex-start; gap:13rpx; margin-top:24rpx; padding:21rpx 23rpx; border-radius:38rpx; color:#786d7c; background:rgba(235,225,239,.65); font-size:24rpx; line-height:1.58; }.settings-principle__icon { flex:0 0 auto; width:28rpx; height:28rpx; margin-top:2rpx; }.settings-logout { margin-top:27rpx; }
