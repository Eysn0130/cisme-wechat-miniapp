.settings-page{padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 56px));padding-right:24rpx;padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 48rpx);padding-left:24rpx;background:#f6f2f7}.settings-topbar__copy{display:flex;align-items:center;flex-direction:column}.settings-topbar__subtitle{margin-top:4rpx;color:#746a78;font-size:22rpx}.settings-operation-status{margin:0 0 16rpx;color:#5d416f;font-size:24rpx;text-align:center}.settings-label{margin:30rpx 12rpx 12rpx;color:#827786;font-size:24rpx}.settings-label--first{margin-top:4rpx}.settings-group,.settings-detail{overflow:hidden;border:1rpx solid rgba(80,54,92,.08);border-radius:28rpx;background:rgba(255,255,255,.86);box-shadow:0 8rpx 28rpx rgba(64,41,74,.05)}
.settings-row{display:flex;align-items:center;gap:18rpx;width:100%;min-height:112rpx;padding:0 26rpx;border:0;border-bottom:1rpx solid rgba(78,47,91,.09);border-radius:0;color:inherit;background:transparent;text-align:left}.settings-row--last{border-bottom:0}.settings-row__icon{flex:none;width:34rpx;height:34rpx}.settings-row__copy{flex:1;min-width:0}.settings-row__title,.settings-row__subtitle{display:block}.settings-row__title{color:#403545;font-size:27rpx;font-weight:500;line-height:1.4}.settings-row__subtitle{margin-top:5rpx;color:#817687;font-size:23rpx;line-height:1.45}.settings-row__value{flex:none;color:#6b4b77;font-size:24rpx}.settings-caret{width:24rpx;height:24rpx}.settings-row:active,.inline-action:active,.address-main:active,.address-actions button:active{opacity:.72}
.settings-detail{margin-top:14rpx;padding:28rpx}.detail-head,.phone-block,.setting-toggle,.about-row{display:flex;align-items:center;justify-content:space-between;gap:22rpx}.detail-head{align-items:flex-start}.detail-head__title,.detail-head__copy{display:block}.detail-head__title{color:#403545;font-size:29rpx}.detail-head__copy{margin-top:6rpx;color:#827786;font-size:23rpx;line-height:1.5}.settings-inline-state{padding:34rpx 0;color:#817687;font-size:24rpx;text-align:center}.inline-action{flex:none;min-width:92rpx;min-height:64rpx;padding:0 20rpx;border:1rpx solid rgba(86,48,111,.16);border-radius:16rpx;color:#5c3b6d;background:#f1eaf4;font-size:24rpx}
.account-avatar-row{display:flex;align-items:center;gap:24rpx;margin:28rpx 0}.account-avatar-button{flex:none;width:132rpx;padding:0;border:0;background:transparent}.account-avatar{display:block;width:112rpx;height:112rpx;margin:auto;border-radius:50%;background:#eee5f2}.account-avatar-edit{display:block;margin-top:8rpx;color:#694577;font-size:23rpx}.account-avatar-copy{flex:1;color:#796f7e;font-size:24rpx;line-height:1.55}.account-avatar-copy .text-button{padding-left:0}.field-label{display:block;margin-top:24rpx;color:#5e5263;font-size:25rpx;line-height:1.5}.field-input{box-sizing:border-box;width:100%;min-height:84rpx;margin-top:10rpx;padding:18rpx 20rpx;border:1rpx solid rgba(86,48,111,.14);border-radius:16rpx;color:#352d39;background:#fbf9fb;font-size:27rpx;line-height:1.45}.field-textarea{min-height:112rpx}.picker-value{color:#403545}.picker-value--empty{color:#9a919e}.setting-toggle{margin-top:26rpx;padding-top:24rpx;border-top:1rpx solid rgba(78,47,91,.09)}.setting-toggle switch{flex:none}.settings-note{margin-top:14rpx;color:#756a79;font-size:23rpx;line-height:1.5}.detail-save{margin-top:26rpx}.phone-block{margin-top:26rpx;padding-top:24rpx;border-top:1rpx solid rgba(78,47,91,.09)}.phone-remove{margin-top:8rpx;padding-left:0}.account-avatar-canvas{position:fixed;top:0;left:-9999px;width:256px;height:256px;pointer-events:none}
.settings-empty{padding:34rpx 12rpx 10rpx;text-align:center}.settings-empty image{display:block;width:52rpx;height:52rpx;margin:0 auto 14rpx}.settings-empty strong,.settings-empty small{display:block}.settings-empty strong{color:#493c4f;font-size:28rpx}.settings-empty small{margin-top:8rpx;color:#817687;font-size:23rpx}.settings-empty .secondary{margin-top:22rpx}.address-list{margin-top:22rpx}.address-item{padding:22rpx 0;border-top:1rpx solid rgba(78,47,91,.09)}.address-main{width:100%;padding:0;border:0;background:transparent;text-align:left}.address-head{display:flex;align-items:center;gap:12rpx;flex-wrap:wrap;color:#473b4c;font-size:24rpx}.address-head strong{font-size:28rpx}.address-tag,.address-default{padding:4rpx 10rpx;border-radius:8rpx;color:#654775;background:#eee6f1;font-size:20rpx}.address-default{color:#fff;background:#644675}.address-summary{display:block;margin-top:10rpx;color:#746a78;font-size:24rpx;line-height:1.55}.address-actions{display:flex;justify-content:flex-end;gap:8rpx;margin-top:10rpx}.address-actions button{min-height:60rpx;padding:0 16rpx;border:0;color:#74557f;background:transparent;font-size:22rpx}
.address-actions button{display:flex;align-items:center;justify-content:center;height:44px;min-height:44px;padding:0 12px;line-height:20px}.address-recovery{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:18rpx;padding:20rpx;border:1rpx solid rgba(86,48,111,.12);border-radius:18rpx;background:#f1e8f4}.address-recovery__copy{flex:1;min-width:0}.address-recovery strong,.address-recovery small{display:block}.address-recovery strong{color:#50385a;font-size:25rpx}.address-recovery small{margin-top:5rpx;color:#7d6d82;font-size:21rpx;line-height:1.45}.address-recovery__actions{display:flex;gap:6rpx}.address-recovery__actions button{display:flex;align-items:center;justify-content:center;height:44px;min-width:44px;padding:0 10px;border:0;color:#75517f;background:transparent;font-size:23rpx;line-height:20px}.address-recovery__actions text{line-height:20px}.address-recovery__actions .address-recovery__primary{border-radius:15rpx;color:#fff;background:#644675}
.consent-list{padding:8rpx 26rpx}.consent-item{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:96rpx;border-bottom:1rpx solid rgba(78,47,91,.09)}.consent-item:last-child{border-bottom:0}.consent-item strong,.consent-item small{display:block}.consent-item strong{color:#473b4c;font-size:25rpx}.consent-item small{margin-top:4rpx;color:#817687;font-size:22rpx}.about-detail{padding:8rpx 28rpx}.about-row{min-height:92rpx;border-bottom:1rpx solid rgba(78,47,91,.09)}.about-row small,.about-row strong{display:block}.about-row small{color:#817687;font-size:22rpx}.about-row strong{max-width:540rpx;margin-top:5rpx;overflow-wrap:anywhere;color:#493c4f;font-size:24rpx}.about-note{display:block;padding:22rpx 0;color:#7d7281;font-size:22rpx;line-height:1.55}.settings-principle{display:flex;align-items:flex-start;gap:14rpx;margin-top:26rpx;padding:22rpx;border-radius:22rpx;color:#776d7b;background:#ece5ef;font-size:23rpx;line-height:1.55}.settings-principle__icon{flex:none;width:30rpx;height:30rpx;margin-top:2rpx}.settings-logout{margin-top:24rpx}.state.state--error{margin-top:18rpx}.state.state--error .text-button,.state.state--error .primary{margin-top:12rpx}
