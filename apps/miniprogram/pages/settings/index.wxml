<view class="chrome-root" style="{{chromeStyle}}">
  <view class="topbar settings-topbar">
    <button class="topbar__back {{leaving || !!workingConsentId || confirmingLogout || loggingOut || profileBusy || avatarBusy || phoneBusy || addressBusy || leavePromptOpen ? 'control--disabled' : ''}}" bindtap="back" disabled="{{leaving || !!workingConsentId || confirmingLogout || loggingOut || profileBusy || avatarBusy || phoneBusy || addressBusy || leavePromptOpen}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button>
    <view class="settings-topbar__copy"><text class="topbar__title">设置</text><small class="settings-topbar__subtitle">资料、配送与账号管理</small></view>
  </view>
  <view class="page page--stack settings-page">
    <view wx:if="{{operationStatus}}" class="settings-operation-status" aria-live="polite" aria-atomic="true">{{operationStatus}}</view>
    <view class="settings-label settings-label--first">个人资料</view>
    <view class="settings-group">
      <button class="settings-row {{profileBusy || avatarBusy || phoneBusy || addressBusy ? 'control--disabled' : ''}}" bindtap="openAccount" disabled="{{profileBusy || avatarBusy || phoneBusy || addressBusy}}" aria-expanded="{{editingProfile}}"><image class="settings-row__icon" src="/assets/icons/user-circle-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><strong class="settings-row__title">头像与昵称</strong><small class="settings-row__subtitle">{{displayName || '管理会员称呼与社区展示'}}</small></view><text class="settings-row__value">{{editingProfile ? '收起' : '修改'}}</text></button>
      <button class="settings-row settings-row--last {{addressBusy ? 'control--disabled' : ''}}" bindtap="openAddresses" disabled="{{addressBusy}}" aria-expanded="{{editingAddresses}}"><image class="settings-row__icon" src="/assets/icons/package-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><strong class="settings-row__title">收货地址</strong><small class="settings-row__subtitle">{{addressesLoading ? '正在同步地址簿' : addresses.length ? addresses.length + ' 个地址，可用于隔离订单验证' : '保存地址后可在结算页选择'}}</small></view><text class="settings-row__value">{{editingAddresses ? '收起' : '管理'}}</text></button>
    </view>
    <view wx:if="{{editingProfile}}" class="settings-detail" aria-label="会员资料编辑区">
      <view class="detail-head"><view><strong class="detail-head__title">会员资料</strong><small class="detail-head__copy">保存后用于小程序内称呼。社区展示仍需单独开启并审核。</small></view></view>
      <view wx:if="{{!profileReady && !profileError}}" class="settings-inline-state">正在读取已保存资料...</view>
      <form wx:if="{{profileReady}}" bindsubmit="saveProfile">
        <view class="account-avatar-row"><button class="account-avatar-button {{profileBusy || avatarBusy || phoneBusy ? 'control--disabled' : ''}}" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{profileBusy || avatarBusy || phoneBusy}}" aria-label="选择或更换会员头像"><image class="account-avatar" src="{{avatarUrl}}" mode="aspectFill"/><text class="account-avatar-edit">{{avatarBusy ? '处理中' : '更换头像'}}</text></button><view class="account-avatar-copy"><text>使用微信头像或从相册选择</text><button wx:if="{{avatarUrl !== '/assets/icons/user-circle-plum.svg'}}" class="text-button {{profileBusy || avatarBusy ? 'text-button--disabled' : ''}}" bindtap="removeAvatar" disabled="{{profileBusy || avatarBusy}}">恢复默认头像</button></view></view>
        <label class="field-label">昵称<input class="field-input" type="nickname" name="nickname" value="{{displayName}}" bindinput="editDisplayName" bindblur="editDisplayName" bindnicknamereview="reviewNickname" maxlength="40" disabled="{{profileBusy}}" placeholder="填写昵称" /></label>
        <label class="field-label">微信号（选填）<input class="field-input" value="{{wechatHandle}}" bindinput="editWechatHandle" maxlength="20" disabled="{{profileBusy}}" placeholder="仅用于必要的私下联系" /></label>
        <view class="setting-toggle"><view class="settings-row__copy"><strong class="settings-row__title">在社区展示头像与昵称</strong><small class="settings-row__subtitle">开启后需审核。电话、微信号和地址始终不公开。</small></view><switch checked="{{communityVisible}}" bindchange="changeCommunityVisibility" disabled="{{profileBusy}}" color="#56306f" aria-label="是否在社区展示头像与昵称"/></view>
        <view wx:if="{{publicStatus === 'pending'}}" class="settings-note">社区展示审核中。</view><view wx:elif="{{publicStatus === 'approved'}}" class="settings-note">当前头像与昵称已通过社区展示审核。</view><view wx:elif="{{publicStatus === 'rejected'}}" class="settings-note">社区展示未通过：{{publicReviewNote || '请修改后重新保存'}}。</view>
        <button class="primary detail-save {{profileBusy || avatarBusy || nicknameInvalid ? 'primary--disabled' : ''}}" form-type="submit" loading="{{profileBusy || avatarBusy}}" disabled="{{profileBusy || avatarBusy || nicknameInvalid}}">保存会员资料</button>
      </form>
      <view class="phone-block"><view><strong class="settings-row__title">联系电话（选填）</strong><small class="settings-row__subtitle">{{phoneLoading ? '正在读取状态' : phoneBound ? phoneMasked + '，已验证' : phoneEnabled ? '需要联系时再单独授权' : '当前未开放手机号授权'}}</small></view><button wx:if="{{phoneEnabled}}" class="inline-action {{phoneBusy || profileBusy || avatarBusy ? 'control--disabled' : ''}}" open-type="getPhoneNumber" bindgetphonenumber="bindPhone" loading="{{phoneBusy}}" disabled="{{phoneBusy || profileBusy || avatarBusy}}">{{phoneBound ? '更换' : '绑定'}}</button></view>
      <button wx:if="{{phoneBound}}" class="text-button phone-remove {{phoneBusy || profileBusy || avatarBusy ? 'text-button--disabled' : ''}}" bindtap="unbindPhone" disabled="{{phoneBusy || profileBusy || avatarBusy}}">解除联系电话绑定</button>
      <view wx:if="{{profileError || phoneError}}" class="state state--error" aria-live="polite">{{profileError || phoneError}}<button wx:if="{{profileError}}" class="text-button" bindtap="reloadProfile">重新加载资料</button></view>
    </view>
    <canvas type="2d" id="member-avatar-canvas" class="account-avatar-canvas" aria-hidden="true"/>
    <view wx:if="{{editingAddresses}}" class="settings-detail" aria-label="收货地址管理区">
      <view class="detail-head"><view><strong class="detail-head__title">地址簿</strong><small class="detail-head__copy">{{addresses.length >= 10 ? '已达 10 个地址上限，删除旧地址后可新增。' : '地址采用加密存储，仅供本人管理；真实支付与配送仍未开放。'}}</small></view><button wx:if="{{addressesEnabled && !addressEditorOpen}}" class="inline-action {{addressBusy || addresses.length >= 10 ? 'control--disabled' : ''}}" bindtap="newAddress" disabled="{{addressBusy || addresses.length >= 10}}">新增</button></view>
      <view wx:if="{{addressesLoading && !addressesReady}}" class="settings-inline-state" aria-live="polite">正在安全读取地址...</view>
      <view wx:if="{{addressesError}}" class="state state--error" aria-live="assertive"><text>{{addressesError}}</text><button wx:if="{{!addressEditorOpen}}" class="text-button {{addressesLoading ? 'text-button--disabled' : ''}}" bindtap="loadAddresses" disabled="{{addressesLoading}}">重新同步</button></view>
      <view wx:if="{{addressRecoveryAvailable && !addressEditorOpen}}" class="address-recovery" aria-live="polite"><view class="address-recovery__copy"><strong>发现未保存的地址草稿</strong><small>{{addressRecoveryTime}} 保存在本机，仅当前会员可恢复。</small></view><view class="address-recovery__actions"><button bindtap="discardRecoveredAddressDraft"><text>丢弃</text></button><button class="address-recovery__primary" bindtap="restoreAddressDraft"><text>恢复</text></button></view></view>
      <view wx:if="{{addressesReady && !addresses.length && !addressEditorOpen}}" class="settings-empty"><image src="/assets/icons/package-plum.svg" mode="aspectFit"/><strong>尚未保存收货地址</strong><small>可手动填写，或从微信收货地址中选择。</small><button class="secondary {{!addressesEnabled ? 'secondary--disabled' : ''}}" bindtap="newAddress" disabled="{{!addressesEnabled}}">新增收货地址</button></view>
      <view wx:if="{{!addressEditorOpen}}" class="address-list"><view wx:for="{{addresses}}" wx:key="id" class="address-item"><button class="address-main {{addressBusy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="editAddress" disabled="{{addressBusy}}" aria-label="编辑 {{item.recipientName}} 的收货地址"><view class="address-head"><strong>{{item.recipientName}}</strong><text>{{item.phone}}</text><text class="address-tag">{{item.labelText}}</text><text wx:if="{{item.isDefault}}" class="address-default">默认</text></view><text class="address-summary">{{item.summary}}</text></button><view class="address-actions"><button wx:if="{{!item.isDefault}}" class="{{addressBusy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="setDefaultAddress" disabled="{{addressBusy}}" aria-label="将 {{item.recipientName}} 的地址设为默认">设为默认</button><button class="{{addressBusy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="deleteAddress" disabled="{{addressBusy}}" aria-label="删除 {{item.recipientName}} 的收货地址">删除</button></view></view></view>
      <address-editor wx:if="{{addressEditorOpen}}" draft="{{addressDraft}}" busy="{{addressBusy}}" parsing="{{addressParsing}}" quick-input="{{addressQuickInput}}" parse-status="{{addressParseStatus}}" parse-summary="{{addressParseSummary}}" parse-warnings="{{addressParseWarnings}}" field-errors="{{addressFieldErrors}}" conflict="{{addressConflict}}" can-save-as-new="{{addresses.length < 10}}" bindquickinput="editAddressQuickInput" bindrecognize="recognizeAddressText" bindpaste="pasteAndRecognizeAddress" bindwechat="importWechatAddress" bindfieldchange="editAddressField" bindregionchange="changeAddressRegion" bindlabelchange="selectAddressLabel" binddefaultchange="changeAddressDefault" bindcancel="cancelAddressEdit" bindsave="saveAddress" bindloadserver="loadConflictedAddress" bindsaveasnew="saveConflictedAsNew"/>
    </view>
    <view class="settings-label">隐私与许可</view>
    <view class="settings-group"><view class="settings-row"><image class="settings-row__icon" src="/assets/icons/shield-check-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><strong class="settings-row__title">会员会话</strong><small class="settings-row__subtitle">{{loading ? '正在验证' : sessionStatus === 'valid' ? '当前会话有效' : sessionStatus === 'invalid' ? '会话已失效' : '当前会话状态暂时无法确认'}}</small></view></view><view class="settings-row settings-row--last"><image class="settings-row__icon" src="/assets/icons/images-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><strong class="settings-row__title">投稿用途许可</strong><small class="settings-row__subtitle">{{loading ? '正在读取许可' : consents.length ? consents.length + ' 项许可，可逐项撤回' : '尚无投稿用途许可'}}</small></view></view></view>
    <view wx:if="{{consents.length}}" class="settings-detail consent-list"><view wx:for="{{consents}}" wx:key="id" class="consent-item"><view><strong>{{item.purposeLabel}}</strong><small>{{item.revoked_at ? '已撤回，不再新增使用' : '当前有效'}}</small></view><button wx:if="{{!item.revoked_at}}" class="text-button {{!!workingConsentId || addressBusy ? 'text-button--disabled' : ''}}" data-id="{{item.id}}" data-purpose="{{item.purposeLabel}}" bindtap="revoke" loading="{{workingConsentId === item.id}}" disabled="{{!!workingConsentId || addressBusy}}" aria-label="撤回{{item.purposeLabel}}用途许可">撤回</button></view></view>
    <view class="settings-label">账号与服务</view>
    <view class="settings-group">
      <button class="settings-row" bindtap="openLegal"><image class="settings-row__icon" src="/assets/icons/lock-key-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><strong class="settings-row__title">隐私政策与用户协议</strong><small class="settings-row__subtitle">查看当前版本和联系渠道</small></view><image class="settings-caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button class="settings-row" bindtap="openPrivacyRights"><image class="settings-row__icon" src="/assets/icons/receipt-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><strong class="settings-row__title">数据与账号权利</strong><small class="settings-row__subtitle">申请查阅、更正、删除或注销</small></view><image class="settings-caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
      <button class="settings-row settings-row--last" bindtap="toggleAbout" aria-expanded="{{aboutOpen}}"><image class="settings-row__icon" src="/assets/icons/note-pencil-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><strong class="settings-row__title">关于 CISME</strong><small class="settings-row__subtitle">会员编号、版本和服务说明</small></view><text class="settings-row__value">{{aboutOpen ? '收起' : '查看'}}</text></button>
    </view>
    <view wx:if="{{aboutOpen}}" class="settings-detail about-detail"><view class="about-row"><view><small>会员编号</small><strong>{{memberId || '正在读取'}}</strong></view><button class="inline-action {{!memberId ? 'control--disabled' : ''}}" bindtap="copyMemberId" disabled="{{!memberId}}">复制</button></view><view class="about-row"><view><small>当前环境</small><strong>{{runtimeLabel}}</strong></view></view><text class="about-note">会员编号仅用于客服核验和数据权利申请，请勿公开发布。待支付订单仅用于隔离验证，真实支付未开放。</text></view>
    <view class="settings-principle"><image class="settings-principle__icon" src="/assets/icons/shield-check-plum.svg" mode="aspectFit"/><text>地址和联系方式仅供本人管理。撤回许可后停止新增使用，必要的安全与审计记录按适用规则保留。</text></view>
    <button class="secondary settings-logout {{!!workingConsentId || confirmingLogout || loggingOut || profileBusy || avatarBusy || phoneBusy || addressBusy || leavePromptOpen ? 'secondary--disabled' : ''}}" bindtap="logout" loading="{{loggingOut}}" disabled="{{!!workingConsentId || confirmingLogout || loggingOut || profileBusy || avatarBusy || phoneBusy || addressBusy || leavePromptOpen}}">{{confirmingLogout ? '等待退出确认' : '退出当前账号'}}</button>
    <view wx:if="{{error}}" id="settings-error-summary" class="state state--error" aria-live="assertive" aria-atomic="true"><text>{{error}}</text><button wx:if="{{errorAction === 'auth'}}" class="primary" bindtap="reauthenticate">重新登录并返回本页</button><button wx:else class="text-button" bindtap="load">{{errorAction === 'revoke' ? '刷新许可状态后重新选择撤回' : '重新加载许可记录'}}</button></view>
  </view>
</view>
