<view class="chrome-root" style="{{chromeStyle}}">
<view class="topbar settings-topbar"><button class="topbar__back {{leaving || !!workingConsentId || confirmingLogout || loggingOut ? 'control--disabled' : ''}}" bindtap="back" disabled="{{leaving || !!workingConsentId || confirmingLogout || loggingOut}}" aria-label="{{loggingOut ? '正在退出，暂不能返回' : confirmingLogout ? '退出确认中，暂不能返回' : workingConsentId ? '许可撤回确认中，暂不能返回' : '返回'}}"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><view class="settings-topbar__copy"><text class="topbar__title">设置与隐私</text><small class="settings-topbar__subtitle">必要授权与可选授权分开管理</small></view></view>
<view class="page page--stack settings-page">
  <view class="settings-label settings-label--first">会员与许可</view>
  <view wx:if="{{operationStatus}}" class="settings-operation-status" aria-live="polite" aria-atomic="true">{{operationStatus}}</view>
  <view class="glass settings-group">
    <view class="settings-row"><image class="settings-row__icon" src="/assets/icons/user-circle-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><strong class="settings-row__title">微信会员身份</strong><small class="settings-row__subtitle">{{loading ? '正在验证当前会话…' : sessionStatus === 'valid' ? '当前会话验证有效' : sessionStatus === 'invalid' ? '当前会话已失效，请重新登录' : '当前会话状态暂时无法确认'}}</small></view><image class="settings-caret" src="/assets/icons/shield-check-plum.svg" mode="aspectFit"/></view>
    <view class="settings-row settings-row--last"><image class="settings-row__icon" src="/assets/icons/images-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><strong class="settings-row__title">我的内容与授权</strong><small class="settings-row__subtitle">{{consents.length}} 项投稿用途许可记录 · 在下方逐项管理</small></view></view>
  </view>

  <view class="settings-label">投稿用途授权</view>
  <view class="glass settings-group">
    <view wx:if="{{loading}}" class="settings-empty" aria-live="polite">正在加载许可记录…</view>
    <view wx:for="{{consents}}" wx:key="id" class="settings-row consent-row {{index === consents.length - 1 ? 'settings-row--last' : ''}}"><image class="settings-row__icon" src="/assets/icons/share-network-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><strong class="settings-row__title">{{item.purposeLabel}}</strong><small class="settings-row__subtitle">{{item.revoked_at ? '撤回处理中，不再产生新增使用' : '当前有效，可单独撤回'}}</small></view><button wx:if="{{!item.revoked_at}}" class="text-button consent-row__revoke {{!!workingConsentId || confirmingLogout || loggingOut ? 'text-button--disabled' : ''}}" data-id="{{item.id}}" data-purpose="{{item.purposeLabel}}" aria-label="撤回{{item.purposeLabel}}用途许可" bindtap="revoke" loading="{{workingConsentId === item.id}}" disabled="{{!!workingConsentId || confirmingLogout || loggingOut}}">撤回</button></view>
    <view wx:if="{{!loading && sessionStatus === 'valid' && !consents.length}}" class="settings-empty">尚无投稿用途许可。</view>
  </view>

  <view class="settings-label">账号与数据</view>
  <view class="glass settings-group">
    <view class="settings-row"><image class="settings-row__icon" src="/assets/icons/lock-key-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><strong class="settings-row__title">隐私政策与用户协议</strong><small class="settings-row__subtitle">正式协议尚未发布，暂不能查看</small></view></view>
    <view class="settings-row settings-row--last"><image class="settings-row__icon" src="/assets/icons/package-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><strong class="settings-row__title">数据导出与删除</strong><small class="settings-row__subtitle">受理服务尚未开放</small></view><image class="settings-caret" src="/assets/icons/lock-key-plum.svg" mode="aspectFit"/></view>
  </view>
  <view class="settings-principle"><image class="settings-principle__icon" src="/assets/icons/shield-check-plum.svg" mode="aspectFit"/><text>撤回授权后将停止新增使用；已有审核、账本与安全记录按适用规则保留。</text></view>
  <button class="secondary settings-logout {{!!workingConsentId || confirmingLogout || loggingOut ? 'secondary--disabled' : ''}}" bindtap="logout" loading="{{loggingOut}}" disabled="{{!!workingConsentId || confirmingLogout || loggingOut}}"><text class="action-label">{{confirmingLogout ? '等待退出确认' : '退出当前账号'}}</text></button>
  <view wx:if="{{error}}" id="settings-error-summary" class="state state--error" aria-live="assertive" aria-atomic="true"><text class="state-error__copy">{{error}}</text><button wx:if="{{errorAction === 'auth'}}" class="primary state-error__action" bindtap="reauthenticate"><text class="action-label">重新登录并返回本页</text></button><button wx:else class="text-button state-error__action {{!!workingConsentId || confirmingLogout || loggingOut ? 'text-button--disabled' : ''}}" bindtap="load" disabled="{{!!workingConsentId || confirmingLogout || loggingOut}}">{{errorAction === 'revoke' ? '刷新许可状态后重新选择撤回' : '重新加载许可记录'}}</button></view>
</view>
</view>
