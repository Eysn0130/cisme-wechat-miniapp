<view class="chrome-root" style="{{chromeStyle}}">
  <view class="topbar settings-topbar">
    <button class="topbar__back {{leaving || !!workingConsentId || confirmingLogout || loggingOut || profileBusy || avatarBusy || phoneBusy || addressBusy || leavePromptOpen ? 'control--disabled' : ''}}" bindtap="back" disabled="{{leaving || !!workingConsentId || confirmingLogout || loggingOut || profileBusy || avatarBusy || phoneBusy || addressBusy || leavePromptOpen}}" aria-label="返回"><image aria-hidden="true" class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button>
    <view class="settings-topbar__copy"><text class="topbar__title">设置</text></view>
  </view>
  <view class="page page--stack settings-page">
    <view wx:if="{{operationStatus}}" class="settings-operation-status" aria-live="polite" aria-atomic="true">{{operationStatus}}</view>
    <view class="settings-label settings-label--first">个人资料</view>
    <view class="settings-group">
      <button class="settings-row settings-row--copy {{!memberCode ? 'control--disabled' : ''}}" bindtap="copyMemberId" disabled="{{!memberCode}}" aria-label="复制用户编号">
        <image aria-hidden="true" class="settings-row__icon" src="/assets/icons/copy-plum.svg" mode="aspectFit"/>
        <view class="settings-row__copy"><text class="settings-row__title">用户编号</text><text class="settings-row__subtitle settings-user-code" user-select>{{memberCode || (loading ? '正在读取' : '暂未读取')}}</text></view>
        <text class="settings-row__value">复制</text>
      <view class="settings-row__separator" aria-hidden="true"/></button>
      <button class="settings-row {{leaving || !!workingConsentId || confirmingLogout || loggingOut || leavePromptOpen || profileBusy || avatarBusy || phoneBusy || addressBusy ? 'control--disabled' : ''}}" bindtap="openAccount" disabled="{{leaving || !!workingConsentId || confirmingLogout || loggingOut || leavePromptOpen || profileBusy || avatarBusy || phoneBusy || addressBusy}}" aria-expanded="{{editingProfile}}"><image aria-hidden="true" class="settings-row__icon" src="/assets/icons/user-circle-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><text class="settings-row__title">头像与昵称</text><text class="settings-row__subtitle">{{displayName || (loading ? '正在读取资料' : profileReady ? '尚未设置昵称' : '资料暂未读取')}}</text></view><image aria-hidden="true" class="settings-caret {{editingProfile ? 'settings-caret--open' : ''}}" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/><view class="settings-row__separator" aria-hidden="true"/></button>
      <button class="settings-row {{leaving || !!workingConsentId || confirmingLogout || loggingOut || leavePromptOpen || profileBusy || avatarBusy || phoneBusy || addressBusy ? 'control--disabled' : ''}}" bindtap="openCareProfile" disabled="{{leaving || !!workingConsentId || confirmingLogout || loggingOut || leavePromptOpen || profileBusy || avatarBusy || phoneBusy || addressBusy}}"><image aria-hidden="true" class="settings-row__icon" src="/assets/icons/clipboard-text-muted.svg" mode="aspectFit"/><view class="settings-row__copy"><text class="settings-row__title">护理档案</text></view><image aria-hidden="true" class="settings-caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/><view class="settings-row__separator" aria-hidden="true"/></button>
      <button class="settings-row settings-row--last {{leaving || !!workingConsentId || confirmingLogout || loggingOut || leavePromptOpen || profileBusy || avatarBusy || phoneBusy || addressBusy ? 'control--disabled' : ''}}" bindtap="openAddresses" disabled="{{leaving || !!workingConsentId || confirmingLogout || loggingOut || leavePromptOpen || profileBusy || avatarBusy || phoneBusy || addressBusy}}" aria-expanded="{{editingAddresses}}"><image aria-hidden="true" class="settings-row__icon" src="/assets/icons/package-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><text class="settings-row__title">收货地址</text><text class="settings-row__subtitle">{{addressesLoading ? (addressesReady ? '正在更新地址' : '正在读取地址') : addressesError ? '地址暂未更新，请重试' : addressesReady ? (addresses.length ? addresses.length + ' 个常用地址' : '尚未添加收货地址') : '地址尚未读取'}}</text></view><image aria-hidden="true" class="settings-caret {{editingAddresses ? 'settings-caret--open' : ''}}" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
    </view>
    <view wx:if="{{editingProfile}}" class="settings-detail" aria-label="会员资料编辑区">
      <view class="detail-head"><view><text class="detail-head__title">会员资料</text><text class="detail-head__copy">公开发帖和评论会显示你的头像与昵称。电话、微信号和地址不公开。</text></view></view>
      <view wx:if="{{!profileReady && !profileError}}" class="settings-inline-state">正在读取已保存资料...</view>
      <form wx:if="{{profileReady}}" bindsubmit="saveProfile">
        <view class="account-avatar-row"><button class="account-avatar-button {{profileBusy || avatarBusy || phoneBusy ? 'control--disabled' : ''}}" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{profileBusy || avatarBusy || phoneBusy}}" aria-label="选择或更换会员头像"><image aria-hidden="true" class="account-avatar" src="{{avatarUrl}}" mode="aspectFill"/><text class="account-avatar-edit">{{avatarBusy ? '处理中' : '更换头像'}}</text></button><view wx:if="{{avatarUrl !== '/assets/icons/user-circle-plum.svg'}}" class="account-avatar-copy"><button class="text-button {{profileBusy || avatarBusy || phoneBusy ? 'text-button--disabled' : ''}}" bindtap="removeAvatar" disabled="{{profileBusy || avatarBusy || phoneBusy}}">恢复默认头像</button></view></view>
        <label class="field-label">昵称<input class="field-input" type="nickname" aria-label="昵称" name="nickname" value="{{displayName}}" bindinput="editDisplayName" bindblur="editDisplayName" bindnicknamereview="reviewNickname" maxlength="40" disabled="{{profileBusy}}" /></label>
        <label class="field-label">微信号（选填）<input class="field-input" aria-label="微信号，选填" value="{{wechatHandle}}" bindinput="editWechatHandle" maxlength="20" disabled="{{profileBusy}}" /></label>
        <view wx:if="{{birthdaySupported}}" class="field-label">生日（选填月日）<picker mode="multiSelector" range="{{birthdayRanges}}" value="{{birthdayIndex}}" bindcolumnchange="birthdayColumn" bindchange="chooseBirthday" aria-label="生日，选填月日" disabled="{{profileBusy || avatarBusy}}"><view class="field-input profile-birthday {{birthday ? '' : 'profile-birthday--empty'}}"><text>{{birthday ? birthdayLabel : '选择生日月日'}}</text><image src="/assets/icons/caret-right-muted.svg" class="settings-caret" mode="aspectFit" aria-hidden="true"/></view></picker><button wx:if="{{birthday}}" class="text-button {{profileBusy || avatarBusy ? 'control--disabled' : ''}}" bindtap="clearBirthday" disabled="{{profileBusy || avatarBusy}}">清空生日</button></view>
        <button class="primary detail-save {{profileBusy || avatarBusy || phoneBusy || nicknameInvalid ? 'primary--disabled' : ''}}" form-type="submit" loading="{{profileBusy || avatarBusy}}" disabled="{{profileBusy || avatarBusy || phoneBusy || nicknameInvalid}}">保存会员资料</button>
      </form>
      <view wx:if="{{phoneBound}}" class="phone-block"><view><text class="settings-row__title">已绑定的联系电话</text><text class="settings-row__subtitle">{{phoneMasked}}</text></view></view>
      <button wx:if="{{phoneBound}}" class="text-button phone-remove {{phoneBusy || profileBusy || avatarBusy ? 'text-button--disabled' : ''}}" bindtap="unbindPhone" disabled="{{phoneBusy || profileBusy || avatarBusy}}">解除联系电话绑定</button>
      <view wx:if="{{profileError || phoneError}}" class="state state--error" aria-live="polite">{{profileError || phoneError}}<button wx:if="{{profileError}}" class="text-button" bindtap="reloadProfile">重新加载资料</button></view>
    </view>
    <canvas type="2d" id="member-avatar-canvas" class="account-avatar-canvas" aria-hidden="true"/>
    <view wx:if="{{editingAddresses}}" class="settings-detail" aria-label="收货地址管理区">
      <view wx:if="{{!addressEditorOpen}}" class="detail-head"><view><text class="detail-head__title">地址簿</text><text wx:if="{{addresses.length >= 10}}" class="detail-head__copy">已达 10 个地址上限，删除旧地址后可新增。</text></view><button wx:if="{{addressesEnabled && !addressEditorOpen}}" class="inline-action {{addressBusy || addresses.length >= 10 ? 'control--disabled' : ''}}" bindtap="newAddress" disabled="{{addressBusy || addresses.length >= 10}}">新增</button></view>
      <view wx:if="{{addressesLoading && !addressesReady}}" class="settings-inline-state" aria-live="polite">正在加载地址…</view>
      <view wx:if="{{addressesError}}" class="state state--error" aria-live="assertive"><text>{{addressesError}}</text><button wx:if="{{!addressEditorOpen}}" class="text-button {{addressesLoading ? 'text-button--disabled' : ''}}" bindtap="loadAddresses" disabled="{{addressesLoading}}">重新加载</button></view>
      <view wx:if="{{addressRecoveryAvailable && !addressEditorOpen}}" class="address-recovery" aria-live="polite"><view class="address-recovery__copy"><text class="settings-strong">未保存的地址草稿</text><text wx:if="{{addressRecoveryTime}}" class="settings-caption">{{addressRecoveryTime}}</text></view><view class="address-recovery__actions"><button bindtap="discardRecoveredAddressDraft"><text>丢弃</text></button><button class="address-recovery__primary" bindtap="restoreAddressDraft"><text>恢复</text></button></view></view>
      <view wx:if="{{addressesReady && !addresses.length && !addressEditorOpen}}" class="settings-empty"><image aria-hidden="true" src="/assets/icons/package-plum.svg" mode="aspectFit"/><text class="settings-strong">尚未保存收货地址</text><button class="secondary {{!addressesEnabled ? 'secondary--disabled' : ''}}" bindtap="newAddress" disabled="{{!addressesEnabled}}">新增收货地址</button></view>
      <view wx:if="{{!addressEditorOpen}}" class="address-list"><view wx:for="{{addresses}}" wx:key="id" class="address-item"><button class="address-main {{addressBusy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="editAddress" disabled="{{addressBusy}}" aria-label="编辑 {{item.recipientName}} 的收货地址"><view class="address-head"><text class="settings-strong">{{item.recipientName}}</text><text>{{item.phone}}</text><text class="address-tag">{{item.labelText}}</text><text wx:if="{{item.isDefault}}" class="address-default">默认</text></view><text class="address-summary">{{item.summary}}</text></button><view class="address-actions"><button wx:if="{{!item.isDefault}}" class="{{addressBusy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="setDefaultAddress" disabled="{{addressBusy}}" aria-label="将 {{item.recipientName}} 的地址设为默认">设为默认</button><button class="address-action--delete {{addressBusy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="deleteAddress" disabled="{{addressBusy}}" aria-label="删除 {{item.recipientName}} 的收货地址">删除</button></view></view></view>
      <address-editor wx:if="{{addressEditorOpen}}" draft="{{addressDraft}}" busy="{{addressBusy}}" parsing="{{addressParsing}}" quick-input="{{addressQuickInput}}" parse-status="{{addressParseStatus}}" parse-summary="{{addressParseSummary}}" parse-warnings="{{addressParseWarnings}}" field-errors="{{addressFieldErrors}}" conflict="{{addressConflict}}" can-save-as-new="{{addresses.length < 10}}" bindquickinput="editAddressQuickInput" bindrecognize="recognizeAddressText" bindpaste="pasteAndRecognizeAddress" bindwechat="importWechatAddress" bindfieldchange="editAddressField" bindregionchange="changeAddressRegion" bindlabelchange="selectAddressLabel" binddefaultchange="changeAddressDefault" bindcancel="cancelAddressEdit" bindsave="saveAddress" bindloadserver="loadConflictedAddress" bindsaveasnew="saveConflictedAsNew"/>
    </view>
    <view class="settings-label">隐私与账号</view>
    <view class="settings-group">
      <view class="settings-row settings-row--status">
        <image aria-hidden="true" class="settings-row__icon" src="/assets/icons/images-plum.svg" mode="aspectFit"/>
        <view class="settings-row__copy"><text class="settings-row__title">投稿使用授权</text><text class="settings-row__subtitle" aria-live="polite">{{loading ? '正在读取授权记录' : sessionStatus === 'valid' ? (consents.length ? consents.length + ' 项授权记录' : '尚无投稿使用授权') : '授权记录暂未确认'}}</text></view>
        <view class="settings-row__separator" aria-hidden="true"/>
      </view>
      <view wx:if="{{consents.length}}" class="consent-list">
        <view wx:for="{{consents}}" wx:key="id" class="consent-item">
          <view class="consent-item__copy"><text class="settings-strong">{{item.purposeLabel}}</text><text class="settings-caption">{{item.revoked_at ? '已撤回' : '有效'}}</text></view>
          <button wx:if="{{!item.revoked_at}}" class="text-button {{!!workingConsentId || addressBusy ? 'text-button--disabled' : ''}}" data-id="{{item.id}}" data-purpose="{{item.purposeLabel}}" bindtap="revoke" loading="{{workingConsentId === item.id}}" disabled="{{!!workingConsentId || addressBusy}}" aria-label="撤回{{item.purposeLabel}}用途许可">撤回</button>
        </view>
      </view>
      <button class="settings-row {{leaving || !!workingConsentId || confirmingLogout || loggingOut || leavePromptOpen || profileBusy || avatarBusy || phoneBusy || addressBusy ? 'control--disabled' : ''}}" disabled="{{leaving || !!workingConsentId || confirmingLogout || loggingOut || leavePromptOpen || profileBusy || avatarBusy || phoneBusy || addressBusy}}" bindtap="openLegal"><image aria-hidden="true" class="settings-row__icon" src="/assets/icons/lock-key-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><text class="settings-row__title">隐私政策与用户协议</text></view><image aria-hidden="true" class="settings-caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/><view class="settings-row__separator" aria-hidden="true"/></button>
      <button class="settings-row {{leaving || !!workingConsentId || confirmingLogout || loggingOut || leavePromptOpen || profileBusy || avatarBusy || phoneBusy || addressBusy ? 'control--disabled' : ''}}" disabled="{{leaving || !!workingConsentId || confirmingLogout || loggingOut || leavePromptOpen || profileBusy || avatarBusy || phoneBusy || addressBusy}}" bindtap="openPrivacyRights"><image aria-hidden="true" class="settings-row__icon" src="/assets/icons/receipt-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><text class="settings-row__title">数据与账号权利</text></view><image aria-hidden="true" class="settings-caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/><view class="settings-row__separator" aria-hidden="true"/></button>
      <button class="settings-row settings-row--last" bindtap="toggleAbout" aria-expanded="{{aboutOpen}}"><image aria-hidden="true" class="settings-row__icon" src="/assets/icons/note-pencil-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><text class="settings-row__title">关于 CISME</text></view><image aria-hidden="true" class="settings-caret {{aboutOpen ? 'settings-caret--open' : ''}}" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button>
    </view>
    <view wx:if="{{aboutOpen}}" class="settings-detail about-detail"><view wx:if="{{memberCardNumber}}" class="about-row"><view><text class="settings-caption">会员编号</text><text class="settings-strong">No. {{memberCardNumber}}</text></view></view><view class="about-row about-row--last"><view><text class="settings-caption">运行环境</text><text class="settings-strong">{{runtimeLabel}}</text></view></view></view>
    <block wx:if="{{canManageMembers}}"><view class="settings-label">管理工具</view><view class="settings-group"><button class="settings-row settings-row--last {{leaving || !!workingConsentId || confirmingLogout || loggingOut || leavePromptOpen || profileBusy || avatarBusy || phoneBusy || addressBusy ? 'control--disabled' : ''}}" disabled="{{leaving || !!workingConsentId || confirmingLogout || loggingOut || leavePromptOpen || profileBusy || avatarBusy || phoneBusy || addressBusy}}" bindtap="openMemberManagement"><image aria-hidden="true" class="settings-row__icon" src="/assets/icons/shield-check-plum.svg" mode="aspectFit"/><view class="settings-row__copy"><text class="settings-row__title">会员管理</text></view><image aria-hidden="true" class="settings-caret" src="/assets/icons/caret-right-muted.svg" mode="aspectFit"/></button></view></block>
    <view class="settings-footer">
      <button class="secondary settings-logout {{!!workingConsentId || confirmingLogout || loggingOut || profileBusy || avatarBusy || phoneBusy || addressBusy || leavePromptOpen ? 'secondary--disabled' : ''}}" bindtap="logout" loading="{{loggingOut}}" disabled="{{!!workingConsentId || confirmingLogout || loggingOut || profileBusy || avatarBusy || phoneBusy || addressBusy || leavePromptOpen}}">{{confirmingLogout ? '等待退出确认' : '退出当前账号'}}</button>
      <view wx:if="{{error}}" id="settings-error-summary" class="state state--error" aria-live="assertive" aria-atomic="true"><text>{{error}}</text><button wx:if="{{errorAction === 'auth'}}" class="primary" bindtap="reauthenticate">重新登录并返回本页</button><button wx:else class="text-button" bindtap="load">{{errorAction === 'revoke' ? '刷新许可状态后重新选择撤回' : '重新加载许可记录'}}</button></view>
    </view>
  </view>
  <care-onboarding wx:if="{{careProfileOpen}}" bindclose="closeCareProfile" bindcomplete="closeCareProfile"/>
</view>

<points-celebration owner="{{memberId}}" auto-receipts="{{true}}" enabled="{{profileReady && !profileBusy && !avatarBusy}}"/>
