<page-meta root-font-size="system"/>
<view class="operator-shell" style="{{chromeStyle}}">
  <view class="topbar operator-topbar">
    <button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button>
    <view class="operator-heading">
      <view wx:if="{{conversation && (canViewContext || canManageAftersale && (aftersaleCases.length || aftersaleError) || canReturnToQueue && !sendAttempt || assignedToMe && canReply && conversation.status === 'human_active' && (!caseContact && humanRequest.anchorKnown || !sendAttempt && (!caseContact || replyTarget.aftersale && !contactCaseUnavailable)))}}" class="operator-menu-slot">
        <button class="operator-more {{loading || busy ? 'control--disabled' : ''}}" bindtap="openConversationMenu" disabled="{{loading || busy}}" aria-label="会话操作">···</button>
      </view>
      <view class="operator-title">
        <text class="topbar__title">{{memberDisplayName}}</text>
        <view wx:if="{{statusLabel}}" class="operator-status operator-status--{{statusTone}}" aria-label="{{statusLabel}}">
          <text class="operator-status__dot">●</text><text class="operator-status__label">{{statusLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="support-chat-layout {{keyboardHeight ? 'support-chat-layout--with-keyboard' : ''}}" style="{{keyboardHeight ? 'bottom:' + keyboardHeight + 'px' : ''}}">
  <view class="support-chat-history">
  <scroll-view class="operator-thread" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{anchor}}" bindscroll="onThreadScroll" bindscrolltolower="onThreadBottom" lower-threshold="36">
    <view class="operator-thread__content">
    <view wx:if="{{loading && !conversation}}" class="operator-state" aria-live="polite">正在加载聊天记录…</view>
    <button wx:if="{{olderCursor !== null}}" class="text-button {{loading || loadingOlder ? 'text-button--disabled' : ''}}" bindtap="loadOlder" disabled="{{loading || loadingOlder}}" loading="{{loadingOlder}}">查看更早消息</button>

    <view wx:if="{{aftersalePreview || contactCaseUnavailable}}" class="operator-case-preview">
      <view class="operator-case-preview__row">
        <button wx:if="{{aftersalePreview}}" class="operator-case-preview__toggle" bindtap="toggleAftersalePreview" aria-expanded="{{aftersaleExpanded}}">
          <text class="operator-case-preview__title">{{aftersalePreview.label}}</text>
          <text class="operator-case-preview__control">{{aftersaleExpanded ? '收起' : '展开'}}</text>
        </button>
        <button wx:if="{{contactCaseUnavailable}}" class="text-button operator-case-preview__link" bindtap="retry">重新关联</button>
      </view>
      <view wx:if="{{aftersaleExpanded && aftersalePreview}}">
        <view class="operator-case-preview__facts">
          <text wx:if="{{aftersalePreview.orderNumberTail}}" class="operator-case-preview__order">订单尾号 {{aftersalePreview.orderNumberTail}}</text>
          <text wx:if="{{aftersalePreview.amount}}" class="operator-case-preview__amount">¥{{aftersalePreview.amount}}</text>
        </view>
        <text wx:if="{{aftersalePreview.summary}}" class="operator-case-preview__body">{{aftersalePreview.summary}}</text>
        <text wx:if="{{aftersalePreview.reason}}" class="operator-case-preview__body">{{aftersalePreview.reason}}</text>
        <button class="text-button operator-case-preview__link" data-id="{{aftersalePreview.id}}" bindtap="openManageAftersale">查看售后</button>
      </view>
    </view>
    <view wx:if="{{conversation && !loading && !error && !messages.length}}" class="operator-state" aria-live="polite">当前对话暂无消息</view>

    <block wx:for="{{messages}}" wx:key="id">
      <view wx:if="{{item.timeSeparatorLabel}}" class="operator-time-separator"><text>{{item.timeSeparatorLabel}}</text></view>
      <view wx:if="{{item.senderType === 'system'}}" id="operator-{{item.sequence}}" class="operator-system"><text>{{item.body}}</text>
        <view wx:if="{{item.returnInstruction}}" class="return-card">
          <strong>本案退货指引 · 第 {{item.returnInstruction.version}} 版</strong>
          <text>{{item.returnInstruction.recipientName}} · {{item.returnInstruction.phone}}</text>
          <text>{{item.returnInstruction.region}} {{item.returnInstruction.address}}</text>
          <text>退货寄件运费：{{item.returnInstruction.freightPayer==='merchant'?'商家承担':item.returnInstruction.freightPayer==='member'?'用户承担':'待确认'}}</text>
          <text wx:if="{{item.returnInstruction.instructions}}">{{item.returnInstruction.instructions}}</text>
        </view>
      </view>
      <view wx:else id="operator-{{item.sequence}}" class="operator-message operator-message--{{item.senderType}} {{item.groupStart ? 'operator-message--group-start' : 'operator-message--grouped'}}">
        <view class="operator-avatar-slot">
          <view wx:if="{{item.groupStart}}" class="operator-avatar-wrap"><view class="operator-avatar operator-avatar--{{item.avatarKind}} {{item.senderType === 'ai' || item.avatarPath !== '/assets/icons/user-circle-plum.svg' ? 'operator-avatar--photo' : ''}}"><image src="{{item.senderType === 'ai' ? '/assets/cisme/cisme-ai-avatar-v1.png' : item.avatarPath}}" mode="aspectFill" data-ai="{{item.senderType === 'ai'}}" data-key="{{item.sender.key}}" binderror="onAvatarError" aria-label="{{item.senderLabel}}的头像"/></view><identity-badge wx:if="{{item.sender.identityBadge}}" kind="{{item.sender.identityBadge}}" size="{{26}}"/></view>
        </view>
        <view class="operator-message__content">
          <text wx:if="{{item.groupStart}}" class="operator-message__sender">{{item.senderLabel}}</text>
          <text wx:if="{{item.replyReferenceLabel}}" class="operator-reply-reference support-chat-quote">{{item.replyReferenceLabel}}</text>
          <button wx:if="{{!caseContact && item.senderType === 'user' && canReply && assignedToMe && conversation.status === 'human_active'}}" class="operator-bubble operator-bubble--question {{replyTarget && replyTarget.id === item.id ? 'operator-bubble--selected' : ''}} {{busy || sendAttempt ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="selectReplyTarget" aria-label="{{replyTarget && replyTarget.id === item.id ? '当前回复的问题：' : '选择回复这个问题：'}}{{item.body || '图片或订单咨询'}}" disabled="{{busy || sendAttempt}}">{{item.body || '图片或订单咨询'}}</button>
          <view wx:elif="{{item.body}}" class="operator-bubble">{{item.body}}</view>
          <view wx:if="{{item.attachments.length}}" class="operator-media-grid">
            <button wx:for="{{item.attachments}}" wx:for-item="media" wx:key="id" class="operator-media" data-media-id="{{media.id}}" bindtap="previewImage" aria-label="预览会员图片">
              <image src="{{media.localPath || '/assets/icons/images-plum.svg'}}" mode="aspectFill" lazy-load="true"/>
              <text wx:if="{{!media.localPath}}">图片加载中</text>
            </button>
          </view>
          <button wx:if="{{item.orderCard}}" class="operator-order-card" data-id="{{item.orderCard.orderId}}" bindtap="openOrder" aria-label="打开订单尾号 {{item.orderCard.orderNumberTail}}">
            <image class="operator-order-card__image" src="{{item.orderCard.productImage || '/assets/icons/package-plum.svg'}}" mode="aspectFill"/>
            <view class="operator-order-card__content"><small>订单 · 尾号 {{item.orderCard.orderNumberTail}}</small><strong>{{item.orderCard.productName}}</strong><text>{{item.orderCard.statusLabel}} · ¥{{item.orderCard.totalYuan}}</text></view>
            <image class="operator-order-card__arrow" src="/assets/icons/caret-right-muted.svg"/>
          </button>
          <view wx:if="{{item.groupEnd}}" class="operator-message__meta"><text>{{item.timeLabel}}</text><text wx:if="{{item.senderType === 'admin' && item.deliveryLabel}}"> · {{item.deliveryLabel}}</text></view>
        </view>
      </view>
    </block>

    <view wx:if="{{pendingMessage}}" class="operator-message operator-message--admin operator-message--pending">
      <view class="operator-avatar-slot"><view class="operator-avatar-wrap"><view class="operator-avatar {{ownAvatar !== '/assets/icons/user-circle-plum.svg' ? 'operator-avatar--photo' : ''}}"><image src="{{ownAvatar}}" mode="aspectFill" binderror="onAvatarError" aria-label="你的头像"/></view><identity-badge wx:if="{{assignedToMe && identityAgentKey ? agentBadge : ownBadge}}" kind="{{assignedToMe && identityAgentKey ? agentBadge : ownBadge}}" size="{{26}}"/></view></view>
      <view class="operator-message__content">
        <text wx:if="{{pendingMessage.replyReferenceLabel}}" class="operator-reply-reference support-chat-quote">{{pendingMessage.replyReferenceLabel}}</text>
        <view class="operator-bubble">{{pendingMessage.body}}</view>
        <view class="operator-message__meta operator-message__meta--{{pendingMessage.deliveryLabel === '发送失败' ? 'failed' : 'pending'}}">
          <text>{{pendingMessage.timeLabel}} · {{pendingMessage.deliveryLabel}}</text>
          <button wx:if="{{pendingMessage.deliveryLabel === '发送失败' || pendingMessage.deliveryLabel === '结果待核对'}}" class="{{busy || !canReply ? 'control--disabled' : ''}}" bindtap="retrySend" disabled="{{busy || !canReply}}">{{canReply ? '重试核对' : '需要回复权限'}}</button>
        </view>
      </view>
    </view>

    <view wx:if="{{presence.memberTyping}}" class="operator-typing" aria-live="polite">
      <view class="operator-avatar-wrap"><view class="operator-avatar operator-avatar--member {{memberAvatar !== '/assets/icons/user-circle-plum.svg' ? 'operator-avatar--photo' : ''}}"><image src="{{memberAvatar}}" mode="aspectFill" data-key="{{identityMemberKey}}" binderror="onAvatarError"/></view><identity-badge wx:if="{{memberBadge}}" kind="{{memberBadge}}" size="{{26}}"/></view>
      <view class="operator-typing__body"><view class="operator-typing__dots"><view class="operator-typing__dot"></view><view class="operator-typing__dot operator-typing__dot--two"></view><view class="operator-typing__dot operator-typing__dot--three"></view></view><text class="operator-typing__copy">{{memberDisplayName}}正在输入…</text></view>
    </view>
    <view wx:if="{{error}}" class="operator-error" aria-live="assertive"><text>{{error}}</text><button bindtap="retry">刷新</button></view>
      <view class="operator-end"></view>
    </view>
  </scroll-view>

  <button wx:if="{{newMessagesBelowCount > 0}}" class="operator-new-message" bindtap="jumpToLatest" aria-label="查看 {{newMessagesBelowCount}} 条新消息">↓ {{newMessagesBelowCount}} 条新消息</button>
  </view>

  <view wx:if="{{conversation.status === 'human_active' && assignedToMe && canReply && (!caseContact || !contactCaseUnavailable && (replyTarget.aftersale || sendAttempt))}}" class="support-composer">
    <view class="support-composer__surface {{composerFocused ? 'support-composer__surface--focused' : ''}}">
      <view wx:if="{{replyTarget && !replyTarget.aftersale && !replyTargetNeedsRefresh}}" class="operator-reply-target" aria-live="polite">
        <text class="operator-reply-target__label">引用</text><text class="operator-reply-target__summary">{{replyTarget.summary}}</text>
      </view>
      <view class="support-composer__controls {{composerLineCount > 1 ? 'support-composer__controls--multiline' : ''}}">
        <textarea class="operator-input support-input {{composerCapped ? 'support-input--capped' : ''}}" aria-label="回复消息" value="{{input}}" bindinput="updateInput" bindfocus="onComposerFocus" bindblur="onComposerBlur" bindlinechange="onComposerLineChange" bindkeyboardheightchange="onKeyboardHeightChange" maxlength="4000" auto-height="{{!composerCapped}}" fixed="true" adjust-position="{{false}}" hold-keyboard="true" disable-default-padding="true" confirm-type="done" cursor-spacing="16" placeholder="{{sendAttempt ? '请先核对上条回复' : replyTargetNeedsRefresh ? '刷新后回复' : replyTarget ? '输入消息' : '选择消息后回复'}}" placeholder-class="support-input__placeholder" disabled="{{loading || busy || sendAttempt || !replyTarget || replyTargetNeedsRefresh}}"/>
        <view class="support-composer__tools support-chat-tools">
          <button class="support-tool support-tool--send {{loading || !composerSendEnabled || busy || sendAttempt || !replyTarget || replyTargetNeedsRefresh ? 'control--disabled' : ''}} {{composerSendEnabled && !loading && !busy && !sendAttempt && replyTarget && !replyTargetNeedsRefresh ? 'support-tool--send-active' : 'support-tool--send-disabled'}}" bindtap="send" disabled="{{loading || !composerSendEnabled || busy || sendAttempt || !replyTarget || replyTargetNeedsRefresh}}" aria-label="{{busy ? '正在发送回复' : '发送回复'}}"><image src="{{composerSendEnabled && !loading && !busy && !sendAttempt && replyTarget && !replyTargetNeedsRefresh ? '/assets/icons/composer-send-white.svg' : '/assets/icons/composer-send-muted.svg'}}"/></button>
        </view>
      </view>
    </view>
  </view>
  <view wx:elif="{{conversation.status === 'waiting_human' && canAssign && canReply || input && !assignedToMe}}" class="support-composer">
    <view wx:if="{{input && !assignedToMe}}" class="operator-draft-notice">未发送的草稿已保留，接管后可继续编辑</view>
    <button wx:if="{{conversation.status === 'waiting_human' && canAssign && canReply}}" class="operator-claim {{loading || busy || sendAttempt ? 'control--disabled' : ''}}" bindtap="claim" disabled="{{loading || busy || sendAttempt}}">接管会话</button>
  </view>
  </view>

  <view wx:if="{{contextOpen && !loading}}" class="context-mask" catchtap="closeContext" catchtouchmove="stopPropagation">
    <view class="context-sheet" catchtap="stopPropagation">
      <view class="context-handle"></view>
      <strong class="context-title">必要用户信息</strong>

      <view class="context-row"><small>昵称</small><text>{{memberContext.displayName}}</text></view>
      <view class="context-row"><small>会员状态</small><text>{{memberContext.memberStatus === 'active' ? '正常' : memberContext.memberStatus}}</text></view>
      <view class="context-row"><small>手机号</small><text>{{memberContext.maskedPhone || '未绑定'}}</text></view>
      <view class="context-row"><small>加入时间</small><text>{{memberContext.memberSince}}</text></view>
      <button class="context-done" bindtap="closeContext">完成</button>
    </view>
  </view>
  <view wx:if="{{aftersaleOpen && !loading}}" class="context-mask" catchtap="closeAftersales" catchtouchmove="stopPropagation">
    <scroll-view class="context-sheet aftersale-sheet" scroll-y enhanced show-scrollbar="{{false}}" catchtap="stopPropagation">
      <view class="context-handle"></view><strong class="context-title">本会话售后</strong>
      <text class="context-note">退货与退款请在售后单处理</text>
      <text wx:if="{{aftersaleError}}" class="aftersale-sheet__error" aria-live="polite">{{aftersaleError}}</text>
      <text wx:if="{{!aftersaleCases.length}}" class="context-note">暂无关联售后申请。</text>
      <view wx:for="{{aftersaleCases}}" wx:key="id" class="aftersale-sheet__case">
        <text>案件 {{item.id}} · {{item.state==='requested'?'待处理':item.state==='awaiting_instruction'?'待发送退货指引':item.state==='awaiting_return'?'待用户寄回':item.state}}</text>
        <button wx:if="{{assignedToMe && item.kind==='return_refund' && item.state==='requested' && !returnAttempt}}" class="{{busy?'control--disabled':''}}" data-id="{{item.id}}" bindtap="approveReturn" disabled="{{busy}}">确认需退货核对</button>
        <button wx:if="{{assignedToMe && item.kind==='return_refund' && (item.state==='awaiting_instruction'||item.state==='awaiting_return')}}" class="{{busy||returnAttempt?'control--disabled':''}}" data-id="{{item.id}}" bindtap="selectReturnCase" disabled="{{busy||returnAttempt}}">{{item.state==='awaiting_return'?'发送新版本指引':'填写退货指引'}}</button>
        <button wx:if="{{assignedToMe && (item.claimBasis==='delivery_issue'||item.claimBasis==='missing_item'||item.kind==='return_refund')}}" class="{{busy||returnAttempt?'control--disabled':''}}" data-id="{{item.id}}" bindtap="openManageAftersale" disabled="{{busy||returnAttempt}}">核对例外与退款</button>
      </view>
      <view wx:if="{{returnFormCaseId}}" class="aftersale-sheet__form">
        <text>本案收件信息</text>
        <input aria-label="收件人" placeholder="收件人" maxlength="80" value="{{returnForm.recipientName}}" data-field="recipientName" bindinput="editReturnField" disabled="{{busy||returnAttempt}}"/>
        <input aria-label="收件电话" placeholder="收件电话" maxlength="20" value="{{returnForm.phone}}" data-field="phone" bindinput="editReturnField" disabled="{{busy||returnAttempt}}"/>
        <input aria-label="地区" placeholder="省市区" maxlength="100" value="{{returnForm.region}}" data-field="region" bindinput="editReturnField" disabled="{{busy||returnAttempt}}"/>
        <textarea aria-label="详细地址" placeholder="详细地址" maxlength="300" value="{{returnForm.address}}" data-field="address" bindinput="editReturnField" disabled="{{busy||returnAttempt}}"/>
        <picker range="{{freightOptions}}" bindchange="chooseFreight" disabled="{{busy||returnAttempt}}"><view class="choice">运费：{{returnForm.freightPayer==='merchant'?'商家承担':returnForm.freightPayer==='member'?'用户承担':'请选择承担方'}}</view></picker>
        <textarea aria-label="寄回说明" placeholder="必要的寄回说明（选填）" maxlength="500" value="{{returnForm.instructions}}" data-field="instructions" bindinput="editReturnField" disabled="{{busy||returnAttempt}}"/>
        <button class="context-done {{busy?'control--disabled':''}}" bindtap="sendReturnInstruction" disabled="{{busy}}">{{returnAttempt?'重试发送':'确认并发送退货指引'}}</button>
      </view>
      <button class="context-done {{busy?'control--disabled':''}}" bindtap="closeAftersales" disabled="{{busy}}">关闭</button>
    </scroll-view>
  </view>
</view>
