<view class="operator-shell" style="{{chromeStyle}}">
  <view class="topbar operator-topbar">
    <button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button>
    <view class="operator-title">
      <text class="topbar__title">{{memberDisplayName}}</text>
      <view class="operator-status operator-status--{{statusTone}}" aria-label="{{statusLabel}}">
        <text class="operator-status__dot">●</text><text class="operator-status__label">{{statusLabel}}</text>
      </view>
    </view>
    <button wx:if="{{canViewContext}}" class="operator-more {{busy ? 'control--disabled' : ''}}" bindtap="openContext" disabled="{{busy}}" aria-label="查看必要用户信息">···</button>
  </view>

  <scroll-view class="operator-thread" style="{{threadBottomStyle}}" scroll-y enhanced show-scrollbar="true" scroll-into-view="{{anchor}}" bindscroll="onThreadScroll" bindscrolltolower="onThreadBottom" lower-threshold="36">
    <view class="operator-thread__content">
    <view wx:if="{{loading}}" class="operator-state" aria-live="polite">正在同步会话…</view>
    <button wx:if="{{!loading && olderCursor !== null}}" class="text-button {{loadingOlder ? 'text-button--disabled' : ''}}" bindtap="loadOlder" disabled="{{loadingOlder}}" loading="{{loadingOlder}}">查看更早消息</button>

    <block wx:for="{{messages}}" wx:key="id">
      <view wx:if="{{item.timeSeparatorLabel}}" class="operator-time-separator"><text>{{item.timeSeparatorLabel}}</text></view>
      <view wx:if="{{item.senderType === 'system'}}" id="operator-{{item.sequence}}" class="operator-system"><text>{{item.body}}</text>
        <view wx:if="{{item.returnInstruction}}" class="return-card">
          <strong>本案退货指引 · 第 {{item.returnInstruction.version}} 版</strong>
          <text>{{item.returnInstruction.recipientName}} · {{item.returnInstruction.phone}}</text>
          <text>{{item.returnInstruction.region}} {{item.returnInstruction.address}}</text>
          <text>运费：{{item.returnInstruction.freightPayer==='merchant'?'商家承担':'用户承担'}}</text>
          <text wx:if="{{item.returnInstruction.instructions}}">{{item.returnInstruction.instructions}}</text>
        </view>
      </view>
      <view wx:else id="operator-{{item.sequence}}" class="operator-message operator-message--{{item.senderType}} {{item.groupStart ? 'operator-message--group-start' : 'operator-message--grouped'}}">
        <view wx:if="{{item.senderType !== 'admin'}}" class="operator-avatar-slot">
          <view wx:if="{{item.groupStart}}" class="operator-avatar operator-avatar--{{item.avatarKind}}"><image src="{{item.senderType === 'ai' ? '/assets/icons/star-active.svg' : '/assets/icons/user-circle-plum.svg'}}"/></view>
        </view>
        <view class="operator-message__content">
          <text wx:if="{{item.groupStart && item.senderType !== 'admin'}}" class="operator-message__sender">{{item.senderLabel}}</text>
          <view wx:if="{{item.body}}" class="operator-bubble">{{item.body}}</view>
          <view wx:if="{{item.attachments.length}}" class="operator-media-grid">
            <button wx:for="{{item.attachments}}" wx:for-item="media" wx:key="id" class="operator-media" data-media-id="{{media.id}}" bindtap="previewImage" aria-label="预览会员图片">
              <image src="{{media.localPath || '/assets/icons/images-plum.svg'}}" mode="aspectFill" lazy-load="true"/>
              <text wx:if="{{!media.localPath}}">安全加载中</text>
            </button>
          </view>
          <button wx:if="{{item.orderCard}}" class="operator-order-card" data-id="{{item.orderCard.orderId}}" bindtap="openOrder" aria-label="打开订单尾号 {{item.orderCard.orderNumberTail}}">
            <image class="operator-order-card__image" src="{{item.orderCard.productImage || '/assets/icons/package-plum.svg'}}" mode="aspectFill"/>
            <view class="operator-order-card__content"><small>订单 · 尾号 {{item.orderCard.orderNumberTail}}</small><strong>{{item.orderCard.productName}}</strong><text>{{item.orderCard.statusLabel}} · ¥{{item.orderCard.totalYuan}}</text></view>
            <image class="operator-order-card__arrow" src="/assets/icons/caret-right-muted.svg"/>
          </button>
          <view wx:if="{{item.groupEnd}}" class="operator-message__meta"><text>{{item.timeLabel}}</text><text wx:if="{{item.senderType === 'admin' && item.deliveryLabel}}"> · {{item.deliveryLabel}}</text></view>
        </view>
      </view>
    </block>

    <view wx:if="{{pendingMessage}}" class="operator-message operator-message--admin operator-message--pending">
      <view class="operator-message__content">
        <view class="operator-bubble">{{pendingMessage.body}}</view>
        <view class="operator-message__meta operator-message__meta--{{pendingMessage.deliveryLabel === '发送失败' ? 'failed' : 'pending'}}">
          <text>{{pendingMessage.timeLabel}} · {{pendingMessage.deliveryLabel}}</text>
          <button wx:if="{{pendingMessage.deliveryLabel === '发送失败'}}" bindtap="retrySend">重试</button>
        </view>
      </view>
    </view>

    <view wx:if="{{presence.memberTyping}}" class="operator-typing" aria-live="polite">
      <view class="operator-avatar operator-avatar--member"><image src="/assets/icons/user-circle-plum.svg"/></view>
      <view class="operator-typing__body"><view class="operator-typing__dots"><view class="operator-typing__dot"></view><view class="operator-typing__dot operator-typing__dot--two"></view><view class="operator-typing__dot operator-typing__dot--three"></view></view><text class="operator-typing__copy">{{memberDisplayName}}正在输入…</text></view>
    </view>
    <view wx:if="{{error}}" class="operator-error" aria-live="assertive"><text>{{error}}</text><button bindtap="retry">刷新</button></view>
      <view class="operator-end"></view>
    </view>
  </scroll-view>

  <button wx:if="{{newMessagesBelowCount > 0}}" class="operator-new-message" style="{{newMessageBottomStyle}}" bindtap="jumpToLatest" aria-label="查看 {{newMessagesBelowCount}} 条新消息">↓ {{newMessagesBelowCount}} 条新消息</button>

  <view wx:if="{{!loading}}" class="operator-actions {{composerFocused ? 'operator-actions--focused' : ''}}">
    <button wx:if="{{canManageAftersale}}" class="operator-aftersale-entry {{busy?'control--disabled':''}}" bindtap="openAftersales" disabled="{{busy}}">本会话售后</button>
    <button wx:if="{{conversation && conversation.status === 'waiting_human' && canAssign}}" class="operator-claim {{busy ? 'control--disabled' : ''}}" bindtap="claim" disabled="{{busy}}">接管会话</button>
    <view wx:elif="{{conversation && conversation.status === 'human_active' && !assignedToMe}}" class="operator-owned">这次会话正由其他客服处理</view>
    <view wx:elif="{{conversation && conversation.status === 'resolved'}}" class="operator-owned">本次服务已结束，等待会员再次发起</view>
    <block wx:if="{{assignedToMe && conversation.status === 'human_active'}}">
      <view class="operator-ai-row">
        <button wx:if="{{aiProviderAvailable}}" class="{{busy ? 'control--disabled' : ''}}" bindtap="suggest" disabled="{{busy}}">AI 建议</button>
        <text wx:else class="operator-ai-status">AI 建议未接入</text>
        <text class="operator-ai-row__helper">仅生成草稿，需人工确认发送</text>
      </view>
      <view class="operator-compose {{composerFocused ? 'operator-compose--focused' : ''}}">
        <textarea class="operator-input {{composerCapped ? 'operator-input--capped' : ''}}" value="{{input}}" bindinput="updateInput" bindfocus="onComposerFocus" bindblur="onComposerBlur" bindlinechange="onComposerLineChange" bindkeyboardheightchange="onKeyboardHeightChange" maxlength="4000" auto-height="{{!composerCapped}}" fixed="true" adjust-position="true" hold-keyboard="true" disable-default-padding="true" confirm-type="send" confirm-hold="true" bindconfirm="send" cursor-spacing="16" placeholder="以人工客服身份回复" placeholder-class="operator-input__placeholder"/>
        <view class="operator-compose__tools">
          <button class="operator-send {{!composerSendEnabled || busy ? 'control--disabled' : ''}} {{composerSendEnabled && !busy ? 'operator-send--active' : 'operator-send--disabled'}}" bindtap="send" disabled="{{!composerSendEnabled || busy}}" aria-label="{{busy ? '正在发送回复' : '发送回复'}}"><image src="{{composerSendEnabled && !busy ? '/assets/icons/composer-send-white.svg' : '/assets/icons/composer-send-muted.svg'}}"/></button>
        </view>
      </view>
      <button class="operator-resolve {{busy ? 'control--disabled' : ''}}" bindtap="resolve" disabled="{{busy}}">标记已解决</button>
    </block>
  </view>

  <view wx:if="{{contextOpen && !loading}}" class="context-mask" catchtap="closeContext" catchtouchmove="stopPropagation">
    <view class="context-sheet" catchtap="stopPropagation">
      <view class="context-handle"></view>
      <strong class="context-title">必要用户信息</strong>
      <text class="context-note">仅用于当前客服处理，本次查看已审计。</text>
      <view class="context-row"><small>昵称</small><text>{{memberContext.displayName}}</text></view>
      <view class="context-row"><small>会员状态</small><text>{{memberContext.memberStatus === 'active' ? '正常' : memberContext.memberStatus}}</text></view>
      <view class="context-row"><small>手机号</small><text>{{memberContext.maskedPhone || '未绑定'}}</text></view>
      <view class="context-row"><small>加入时间</small><text>{{memberContext.memberSince}}</text></view>
      <button class="context-done" bindtap="closeContext">完成</button>
    </view>
  </view>
  <view wx:if="{{aftersaleOpen && !loading}}" class="context-mask" catchtap="closeAftersales" catchtouchmove="stopPropagation">
    <scroll-view class="context-sheet aftersale-sheet" scroll-y catchtap="stopPropagation">
      <view class="context-handle"></view><strong class="context-title">本会话售后</strong>
      <text class="context-note">申请时间由服务端记录。聊天说明不改变案件、收件或退款事实。</text>
      <text wx:if="{{aftersaleError}}" class="aftersale-sheet__error" aria-live="polite">{{aftersaleError}}</text>
      <text wx:if="{{!aftersaleCases.length}}" class="context-note">暂无关联售后申请。</text>
      <view wx:for="{{aftersaleCases}}" wx:key="id" class="aftersale-sheet__case">
        <text>案件 {{item.id}} · {{item.state==='requested'?'待处理':item.state==='awaiting_instruction'?'待发送退货指引':item.state==='awaiting_return'?'待用户寄回':item.state}}</text>
        <button wx:if="{{assignedToMe && item.kind==='return_refund' && item.state==='requested' && !returnAttempt}}" class="{{busy?'control--disabled':''}}" data-id="{{item.id}}" bindtap="approveReturn" disabled="{{busy}}">确认需退货核对</button>
        <button wx:if="{{assignedToMe && item.kind==='return_refund' && (item.state==='awaiting_instruction'||item.state==='awaiting_return')}}" class="{{busy||returnAttempt?'control--disabled':''}}" data-id="{{item.id}}" bindtap="selectReturnCase" disabled="{{busy||returnAttempt}}">{{item.state==='awaiting_return'?'发送新版本指引':'填写退货指引'}}</button>
        <button wx:if="{{assignedToMe && (item.claimBasis==='delivery_issue'||item.claimBasis==='missing_item'||item.kind==='return_refund')}}" class="{{busy||returnAttempt?'control--disabled':''}}" data-id="{{item.id}}" bindtap="openManageAftersale" disabled="{{busy||returnAttempt}}">核对例外与退款</button>
      </view>
      <view wx:if="{{returnFormCaseId}}" class="aftersale-sheet__form">
        <text>本案收件信息</text>
        <input aria-label="收件人" placeholder="收件人" maxlength="80" value="{{returnForm.recipientName}}" data-field="recipientName" bindinput="editReturnField" disabled="{{busy||returnAttempt}}"/>
        <input aria-label="收件电话" placeholder="收件电话" maxlength="20" value="{{returnForm.phone}}" data-field="phone" bindinput="editReturnField" disabled="{{busy||returnAttempt}}"/>
        <input aria-label="地区" placeholder="省市区" maxlength="100" value="{{returnForm.region}}" data-field="region" bindinput="editReturnField" disabled="{{busy||returnAttempt}}"/>
        <textarea aria-label="详细地址" placeholder="详细地址" maxlength="300" value="{{returnForm.address}}" data-field="address" bindinput="editReturnField" disabled="{{busy||returnAttempt}}"/>
        <picker range="{{freightOptions}}" bindchange="chooseFreight" disabled="{{busy||returnAttempt}}"><view class="choice">运费：{{returnForm.freightPayer==='merchant'?'商家承担':returnForm.freightPayer==='member'?'用户承担':'请选择承担方'}}</view></picker>
        <textarea aria-label="寄回说明" placeholder="必要的寄回说明（选填）" maxlength="500" value="{{returnForm.instructions}}" data-field="instructions" bindinput="editReturnField" disabled="{{busy||returnAttempt}}"/>
        <button class="context-done {{busy?'control--disabled':''}}" bindtap="sendReturnInstruction" disabled="{{busy}}">{{returnAttempt?'重试原请求':'确认并发送退货指引'}}</button>
      </view>
      <button class="context-done {{busy?'control--disabled':''}}" bindtap="closeAftersales" disabled="{{busy}}">关闭</button>
    </scroll-view>
  </view>
</view>
