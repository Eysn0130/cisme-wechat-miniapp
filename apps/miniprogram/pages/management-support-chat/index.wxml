<view class="operator-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><view class="operator-title"><text class="topbar__title">{{memberDisplayName}}</text><small>{{statusLabel}}</small></view><button wx:if="{{canViewContext}}" class="operator-more {{busy ? 'control--disabled' : ''}}" bindtap="openContext" disabled="{{busy}}" aria-label="查看必要用户信息">···</button></view>
<scroll-view class="operator-thread" scroll-y enhanced show-scrollbar="false" scroll-into-view="{{anchor}}"><view wx:if="{{loading}}" class="state">正在同步会话…</view><button wx:if="{{!loading && olderCursor !== null}}" class="text-button {{loadingOlder ? 'text-button--disabled' : ''}}" bindtap="loadOlder" disabled="{{loadingOlder}}" loading="{{loadingOlder}}">查看更早消息</button><view wx:if="{{!loading}}" wx:for="{{messages}}" wx:key="id" id="operator-{{item.sequence}}" class="operator-message operator-message--{{item.senderType}}"><text>{{item.senderLabel}}</text><view>{{item.body}}</view></view><view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="retry">刷新</button></view><view class="operator-end"></view></scroll-view>
<view wx:if="{{!loading}}" class="operator-actions"><button wx:if="{{conversation && conversation.status === 'waiting_human' && canAssign}}" class="operator-claim {{busy ? 'control--disabled' : ''}}" bindtap="claim" disabled="{{busy}}">接管会话</button><view wx:elif="{{conversation && conversation.status === 'human_active' && !assignedToMe}}" class="operator-owned">这次会话正由其他客服处理</view><view wx:elif="{{conversation && conversation.status === 'resolved'}}" class="operator-owned">已解决 · 等待用户再次发起</view><block wx:if="{{assignedToMe && conversation.status === 'human_active'}}"><view class="operator-ai-row"><button class="{{!aiProviderAvailable || busy ? 'control--disabled' : ''}}" bindtap="suggest" disabled="{{!aiProviderAvailable || busy}}">{{aiProviderAvailable ? '生成建议回复' : 'AI Provider 待接入'}}</button><text>仅生成待审核草稿 · 不自动发送</text></view><view class="operator-compose"><textarea value="{{input}}" bindinput="updateInput" maxlength="4000" auto-height confirm-type="send" bindconfirm="send" placeholder="以人工客服身份回复"/><button class="{{!input || busy ? 'control--disabled' : ''}}" bindtap="send" disabled="{{!input || busy}}" loading="{{busy}}">发送</button></view><button class="operator-resolve {{busy ? 'control--disabled' : ''}}" bindtap="resolve" disabled="{{busy}}">标记已解决</button></block></view>
<view wx:if="{{contextOpen && !loading}}" class="context-mask" catchtap="closeContext"><view class="context-sheet" catchtap="stopPropagation"><view class="context-handle"></view><strong>必要用户信息</strong><text>仅用于当前客服处理，本次查看已审计。</text><view class="context-row"><small>昵称</small><text>{{memberContext.displayName}}</text></view><view class="context-row"><small>会员状态</small><text>{{memberContext.memberStatus === 'active' ? '正常' : memberContext.memberStatus}}</text></view><view class="context-row"><small>手机号</small><text>{{memberContext.maskedPhone || '未绑定'}}</text></view><view class="context-row"><small>加入时间</small><text>{{memberContext.memberSince}}</text></view><button bindtap="closeContext">完成</button></view></view></view>
