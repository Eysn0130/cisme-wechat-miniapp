.operator-shell{min-height:100vh;background:#f7f2f8}.operator-title{display:flex;align-items:center;flex-direction:column}.operator-title small{color:#75697a;font-size:20rpx}.operator-more{position:absolute;top:var(--cisme-back-top,var(--cisme-menu-top,env(safe-area-inset-top)));right:calc(var(--cisme-menu-width,88px) + 12px);width:44px;height:44px;padding:0;color:#56306f;background:transparent;font-size:30rpx}.operator-thread{position:fixed;top:var(--cisme-topbar-height,calc(env(safe-area-inset-top) + 44px));right:0;bottom:calc(env(safe-area-inset-bottom) + 150rpx);left:0;width:100%;padding:24rpx 28rpx}.operator-message{display:flex;align-items:flex-start;flex-direction:column;width:100%;min-width:0;margin:20rpx 0}.operator-message--admin{align-items:flex-end}.operator-message>text{margin:0 10rpx 7rpx;color:#766b79;font-size:20rpx}.operator-message>view{max-width:80%;padding:19rpx 23rpx;border-radius:8rpx 27rpx 27rpx;color:#403545;background:#fff;font-size:28rpx;line-height:1.55;overflow-wrap:anywhere;word-break:break-word}.operator-message--admin>view{border-radius:27rpx 8rpx 27rpx 27rpx;color:#fff;background:#563b69}.operator-end{height:40rpx}.operator-new-message{position:fixed;z-index:26;right:24rpx;bottom:calc(env(safe-area-inset-bottom) + 172rpx);min-height:44px;padding:0 24rpx;border-radius:999rpx;color:#fff;background:#563b69;font-size:24rpx}.operator-actions{position:fixed;z-index:25;right:0;bottom:0;left:0;padding:14rpx 22rpx calc(env(safe-area-inset-bottom) + 14rpx);border-top:1rpx solid rgba(78,47,91,.1);background:rgba(250,247,251,.97)}.operator-claim{width:100%;color:#fff;background:#563b69;border-radius:24rpx}.operator-owned{display:flex;align-items:center;justify-content:center;min-height:44px;color:#6f6473;font-size:24rpx}.operator-ai-row{display:flex;align-items:center;gap:12rpx;min-width:0}.operator-ai-row button{flex:none}.operator-ai-row text{min-width:0;color:#6f6473;font-size:22rpx;line-height:1.4}.operator-compose{display:grid;grid-template-