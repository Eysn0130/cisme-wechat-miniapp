.operator-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at 92% 10%, rgba(238, 228, 242, .72), transparent 34%),
    #f7f2f8;
}

.operator-topbar {
  background: rgba(248, 244, 249, .94);
}

.operator-title {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 0;
  line-height: 1;
}

.operator-title .topbar__title {
  max-width: 330rpx;
  font-size: 17px;
}

.operator-status {
  display: flex;
  align-items: center;
  max-width: 360rpx;
  margin-top: 5rpx;
  color: #75697a;
  font-size: 20rpx;
  line-height: 1.15;
}

.operator-status__label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.operator-status__dot {
  flex: none;
  margin-right: 8rpx;
  color: #876998;
  font-size: 20rpx;
}

.operator-status--online .operator-status__dot {
  color: #2f7d5a;
}

.operator-status--waiting .operator-status__dot {
  color: #a66518;
}

.operator-status--resolved .operator-status__dot {
  color: #8b858e;
}

.operator-more {
  position: absolute;
  top: var(--cisme-back-top, var(--cisme-menu-top, env(safe-area-inset-top)));
  right: calc(var(--cisme-menu-width, 88px) + 12px);
  width: 44px;
  height: 44px;
  padding: 0;
  color: #56306f;
  background: transparent;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.control--disabled {
  opacity: .42;
}

.operator-thread {
  position: fixed;
  top: var(--cisme-topbar-height, calc(env(safe-area-inset-top) + 44px));
  right: 3rpx;
  bottom: calc(env(safe-area-inset-bottom) + 150rpx);
  left: 0;
  width: auto;
}

.operator-thread__content {
  padding: 24rpx 23rpx 10rpx 26rpx;
}

.operator-end {
  height: 32rpx;
}

.operator-state {
  padding: 34rpx 24rpx;
  color: #75697a;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.text-button {
  width: 100%;
  min-height: 44px;
  padding: 0;
  color: #745b80;
  background: transparent;
  font-size: 23rpx;
}

.text-button--disabled {
  opacity: .48;
}

.operator-time-separator {
  display: flex;
  justify-content: center;
  margin: 30rpx 0 22rpx;
}

.operator-time-separator text {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #85798a;
  background: rgba(238, 228, 242, .66);
  font-size: 20rpx;
  line-height: 1.25;
}

.operator-system {
  display: flex;
  justify-content: center;
  width: 100%;
  margin: 28rpx 0;
}

.operator-system text {
  max-width: 580rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #6d6271;
  background: rgba(231, 224, 234, .84);
  font-size: 21rpx;
  line-height: 1.45;
  text-align: center;
}

.operator-message {
  display: flex;
  align-items: flex-start;
  width: 100%;
  min-width: 0;
  margin-top: 10rpx;
}

.operator-message--group-start {
  margin-top: 26rpx;
}

.operator-message--admin {
  justify-content: flex-end;
}

.operator-avatar-slot {
  flex: none;
  width: 82rpx;
  min-height: 68rpx;
  margin-right: 12rpx;
}

.operator-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  overflow: hidden;
  border: 1rpx solid rgba(86, 48, 111, .1);
  border-radius: 50%;
  background: #fffaff;
  box-shadow: 0 7rpx 16rpx rgba(62, 39, 76, .08);
}

.operator-avatar image {
  width: 35rpx;
  height: 35rpx;
}

.operator-avatar--ai {
  background: #eee4f2;
}

.operator-avatar--member {
  background: #fff;
}

.operator-message__content {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  min-width: 0;
  max-width: 74%;
}

.operator-message--admin .operator-message__content {
  align-items: flex-end;
}

.operator-message__sender {
  margin: 0 10rpx 8rpx;
  color: #75697a;
  font-size: 20rpx;
  line-height: 1.25;
}

.operator-bubble {
  max-width: 100%;
  padding: 19rpx 23rpx;
  border: 1rpx solid rgba(78, 47, 91, .09);
  border-radius: 8rpx 27rpx 27rpx;
  color: #3f3444;
  background: #fff;
  font-size: 28rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
  word-break: break-word;
  box-shadow: 0 8rpx 22rpx rgba(53, 35, 64, .055);
}

.operator-message--ai .operator-bubble {
  border-color: rgba(86, 48, 111, .07);
  background: #f0e7f3;
  box-shadow: none;
}

.operator-message--admin .operator-bubble {
  border-color: #56306f;
  border-radius: 27rpx 8rpx 27rpx 27rpx;
  color: #fff;
  background: #56306f;
}

.operator-message__meta {
  display: flex;
  align-items: center;
  min-height: 28rpx;
  margin: 7rpx 9rpx 0;
  color: #8b808e;
  font-size: 20rpx;
  line-height: 1.25;
}

.operator-message__meta--pending {
  color: #786b7d;
}

.operator-message__meta--failed {
  color: #9a3151;
}

.operator-message__meta button {
  min-width: 44px;
  min-height: 36px;
  margin-left: 8rpx;
  padding: 0 10rpx;
  color: #8d3150;
  background: transparent;
  font-size: 21rpx;
}

.operator-message--pending {
  opacity: .92;
}

.operator-media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  width: 100%;
  margin-top: 8rpx;
}

.operator-media {
  position: relative;
  width: 248rpx;
  height: 204rpx;
  min-height: 0;
  padding: 0;
  overflow: hidden;
  border: 1rpx solid rgba(86, 48, 111, .1);
  border-radius: 24rpx;
  background: #eee7f0;
}

.operator-media image {
  width: 100%;
  height: 100%;
}

.operator-media text {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 12rpx;
  color: #6d6271;
  background: rgba(255, 252, 255, .88);
  font-size: 20rpx;
}

.operator-order-card {
  display: grid;
  grid-template-columns: 82rpx minmax(0, 1fr) 28rpx;
  align-items: center;
  gap: 16rpx;
  width: 500rpx;
  max-width: 100%;
  min-height: 116rpx;
  margin-top: 8rpx;
  padding: 15rpx;
  border: 1rpx solid rgba(78, 47, 91, .11);
  border-radius: 24rpx;
  color: #352a3a;
  background: #fffafd;
  text-align: left;
  box-shadow: 0 8rpx 22rpx rgba(53, 35, 64, .05);
}

.operator-order-card__image {
  width: 82rpx;
  height: 82rpx;
  border-radius: 18rpx;
  background: #eee4f2;
}

.operator-order-card__content {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.operator-order-card__content small {
  color: #75697a;
  font-size: 20rpx;
}

.operator-order-card__content strong {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.operator-order-card__content text {
  margin-top: 5rpx;
  color: #6e6073;
  font-size: 20rpx;
}

.operator-order-card__arrow {
  width: 24rpx;
  height: 24rpx;
}

.operator-typing {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.operator-typing__body {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  margin-left: 14rpx;
}

.operator-typing__copy {
  margin-top: 7rpx;
  color: #75697a;
  font-size: 20rpx;
}

.operator-typing__dots {
  display: flex;
  align-items: center;
  gap: 7rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 8rpx 24rpx 24rpx;
  background: #fff;
}

.operator-typing__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #8e759c;
  animation: operator-typing 720ms ease-in-out infinite alternate;
}

.operator-typing__dot--two {
  animation-delay: 120ms;
}

.operator-typing__dot--three {
  animation-delay: 240ms;
}

@keyframes operator-typing {
  from { opacity: .38; transform: translateY(2rpx); }
  to { opacity: 1; transform: translateY(-3rpx); }
}

.operator-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 24rpx 8rpx;
  padding: 16rpx 18rpx 16rpx 22rpx;
  border: 1rpx solid rgba(141, 49, 80, .12);
  border-radius: 22rpx;
  color: #8d3150;
  background: #f8e8ed;
  font-size: 22rpx;
  line-height: 1.5;
}

.operator-error text {
  flex: 1;
}

.operator-error button {
  flex: none;
  min-height: 40px;
  padding: 0 16rpx;
  color: #8d3150;
  background: transparent;
  font-size: 22rpx;
}

.operator-new-message {
  position: fixed;
  z-index: 31;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 172rpx);
  min-height: 44px;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, .35);
  border-radius: 999rpx;
  color: #fff;
  background: #56306f;
  font-size: 23rpx;
  box-shadow: 0 10rpx 26rpx rgba(58, 31, 77, .2);
}

.operator-actions {
  position: fixed;
  z-index: 30;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 14rpx 20rpx calc(env(safe-area-inset-bottom) + 14rpx);
  border-top: 1rpx solid rgba(78, 47, 91, .1);
  background: rgba(250, 247, 251, .97);
  box-shadow: 0 -12rpx 34rpx rgba(55, 34, 67, .055);
  -webkit-backdrop-filter: blur(20rpx);
}

.operator-actions--focused {
  background: rgba(255, 252, 255, .985);
}

.operator-claim {
  width: 100%;
  min-height: 50px;
  border-radius: 25px;
  color: #fff;
  background: #56306f;
  font-size: 27rpx;
}

.operator-owned {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 50px;
  color: #6f6473;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.operator-ai-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  margin-bottom: 10rpx;
}

.operator-ai-row button {
  flex: none;
  min-height: 40px;
  padding: 0 17rpx;
  border-radius: 20px;
  color: #56306f;
  background: #eee4f2;
  font-size: 21rpx;
}

.operator-ai-row text {
  min-width: 0;
  color: #75697a;
  font-size: 20rpx;
  line-height: 1.4;
}

.operator-compose {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(78, 47, 91, .13);
  border-radius: 30rpx;
  background: #fff;
  transition: border-color 180ms ease, box-shadow 180ms ease;
}

.operator-compose--focused {
  border-color: rgba(86, 48, 111, .44);
  box-shadow: 0 0 0 4rpx rgba(86, 48, 111, .075);
}

.operator-input {
  display: block;
  width: 100%;
  min-height: 224rpx;
  max-height: 344rpx;
  padding: 22rpx 22rpx 104rpx;
  overflow-y: auto;
  border: 0;
  color: #352a3a;
  background: transparent;
  font-size: 28rpx;
  line-height: 40rpx;
}

.operator-input--capped {
  height: 344rpx;
}

.operator-input__placeholder {
  color: #918596;
  font-size: 28rpx;
  font-weight: 400;
}

.operator-compose__tools {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  display: flex;
  align-items: center;
}

.operator-send {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  border-radius: 50%;
  transition: opacity 120ms ease, transform 120ms ease, background-color 160ms ease;
}

.operator-send image {
  width: 22px;
  height: 22px;
}

.operator-send--active {
  background: #56306f;
  box-shadow: 0 6rpx 16rpx rgba(70, 38, 91, .18);
}

.operator-send--active:active {
  background: #432458;
  transform: scale(.96);
}

.operator-send--disabled {
  background: #eee8f0;
}

.operator-resolve {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-height: 44px;
  margin: 1rpx 0 -8rpx;
  padding: 0;
  color: #72557f;
  background: transparent;
  font-size: 21rpx;
}

.context-mask {
  position: fixed;
  z-index: 80;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(35, 24, 39, .32);
  animation: context-mask-in 220ms ease-out both;
}

.context-sheet {
  width: 100%;
  padding: 18rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx);
  border-radius: 34rpx 34rpx 0 0;
  background: #fffcff;
  box-shadow: 0 -20rpx 60rpx rgba(48, 29, 57, .16);
  animation: context-sheet-in 220ms cubic-bezier(.2, .8, .2, 1) both;
}

@keyframes context-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes context-sheet-in {
  from { opacity: .6; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.context-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 8rpx;
  background: #d9cedd;
}

.context-title {
  display: block;
  color: #352a3a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 400;
}

.context-note {
  display: block;
  margin: 8rpx 0 22rpx;
  color: #75697a;
  font-size: 22rpx;
  line-height: 1.5;
}

.context-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(78, 47, 91, .1);
}

.context-row small {
  color: #75697a;
  font-size: 22rpx;
}

.context-row text {
  font-size: 24rpx;
  text-align: right;
}

.context-done {
  width: 100%;
  min-height: 50px;
  margin-top: 18rpx;
  border-radius: 25px;
  color: #fff;
  background: #56306f;
}
