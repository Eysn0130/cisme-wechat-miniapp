.progress-page { padding-right:24rpx; padding-left:24rpx; background:linear-gradient(180deg,#f7f2f8,#fbf8fb); }
.progress-status { display:flex; align-items:center; flex-direction:column; padding:33rpx 20rpx 62rpx; text-align:center; }
.progress-status__orb { display:flex; align-items:center; justify-content:center; width:84rpx; height:84rpx; border:3rpx solid #725381; border-radius:50%; box-shadow:0 0 0 14rpx rgba(108,78,123,.06); }.progress-status__icon { width:42rpx; height:42rpx; }
.progress-status__title { margin-top:40rpx; color:#3b2e41; font-family:"Songti SC","STSong",serif; font-size:39rpx; }.progress-status__subtitle { margin-top:8rpx; color:#948995; font-size:var(--cisme-text-small); line-height:1.5; }
.submission-summary { display:flex; align-items:center; flex-direction:column; padding:42rpx 23rpx; border-radius:40rpx; background:rgba(236,227,240,.68); }.submission-summary__label { color:#8a7e8d; font-size:var(--cisme-text-small); line-height:1.5; }.submission-summary__id { max-width:90%; margin-top:8rpx; overflow:hidden; color:#413446; font:var(--cisme-text-small) Georgia,serif; letter-spacing:1rpx; text-overflow:ellipsis; white-space:nowrap; }.submission-summary__meta { margin-top:5rpx; color:#928795; font-size:var(--cisme-text-small); line-height:1.5; }
.progress-timeline { margin-top:24rpx; padding:9rpx 27rpx; border-radius:44rpx; }
.progress-row { position:relative; display:flex; align-items:center; gap:17rpx; min-height:138rpx; border-bottom:1rpx solid rgba(78,47,91,.09); }.progress-row--last { border-bottom:0; }.progress-row__copy { flex:1; }.progress-row__title,.progress-row__meta { display:block; }.progress-row__title { color:#4b3d50; font-size:var(--cisme-text-small); font-weight:500; }.progress-row__meta { margin-top:5rpx; color:#948995; font-size:var(--cisme-text-small); line-height:1.5; }.progress-row__state { color:#8c818f; font-size:var(--cisme-text-small); line-height:1.5; }
.progress-dot { display:flex; align-items:center; justify-content:center; width:45rpx; height:45rpx; border:1rpx solid rgba(86,48,111,.18); border-radius:50%; background:#f3edf5; }.progress-dot__icon { width:25rpx; height:25rpx; }.progress-dot--done { background:#68427e; }.progress-dot--current { box-shadow:0 0 0 7rpx rgba(86,48,111,.08); }.progress-dot--alert { border-color:rgba(141,49,80,.4); background:#f8e8ed; }.progress-row__state--alert { color:#8d3150; }
.progress-note { margin-top:22rpx; padding:24rpx; border-radius:27rpx; color:#67596c; background:rgba(235,225,239,.67); font-size:var(--cisme-text-body); line-height:1.65; }.progress-action-card { margin-top:22rpx; padding:27rpx; border-radius:31rpx; }.progress-actions { display:grid; gap:14rpx; margin-top:32rpx; }.progress-back,.progress-community { display:flex; align-items:center; justify-content:center; width:100%; min-height:50px; padding:0 24rpx; border-radius:999rpx; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif; }.progress-back { border:0; color:#fff; background:linear-gradient(180deg,#6d4b89,#3b274e); }.progress-community { border:1rpx solid rgba(255,255,255,.9); color:#5d4b64; background:rgba(255,255,255,.72); }.progress-error-scene { min-height:520rpx; margin-top:18rpx; }.progress-error-action { margin-top:0; }.progress-appeal-error__title,.progress-appeal-error__copy,.progress-revise-error__title,.progress-revise-error__copy { display:block; }.progress-appeal-error__retry,.progress-revise-error__retry { display:flex; width:100%; margin:14rpx auto 0; }
.progress-appeal-label { display:block; margin-bottom:10rpx; color:#5b4c61; font-size:var(--cisme-text-small); }
