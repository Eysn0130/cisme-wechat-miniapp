<view class="chrome-root" style="{{chromeStyle}}">
  <view class="topbar"><button class="topbar__back {{working || navigatingToRevision || navigatingAway ? 'control--disabled' : ''}}" bindtap="back" disabled="{{working || navigatingToRevision || navigatingAway}}" aria-label="{{working ? '申诉提交中，暂不能返回' : navigatingToRevision ? '正在打开补件页面，暂不能返回' : navigatingAway ? '正在返回投稿来源' : '返回投稿来源'}}"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">审核进度</text></view>
<view class="page page--stack progress-page">
  <view wx:if="{{loading}}" class="state" aria-live="polite">正在加载审核进度…</view>
  <view wx:elif="{{submission}}" class="progress-status" aria-live="polite" aria-atomic="true">
    <view class="progress-status__orb"><image class="progress-status__icon" src="{{submission.status === 'approved' ? '/assets/icons/check-plum.svg' : '/assets/icons/clock-plum.svg'}}" mode="aspectFit"/></view>
    <view class="progress-status__title">{{statusTitle}}</view>
    <view class="progress-status__subtitle">{{statusSubtitle}}</view>
  </view>

  <view wx:if="{{submission}}" class="submission-summary">
    <text class="submission-summary__label">投稿编号</text><strong class="submission-summary__id">{{submissionId}}</strong><small class="submission-summary__meta">版本 {{submission.version}} · {{statusLabel}}</small>
  </view>

  <view wx:if="{{submission}}" class="glass progress-timeline">
    <view class="progress-row is-done"><view class="progress-dot progress-dot--done"><image class="progress-dot__icon" src="/assets/icons/check-white.svg" mode="aspectFit"/></view><view class="progress-row__copy"><strong class="progress-row__title">领取任务</strong><small class="progress-row__meta">已领取，可继续投稿</small></view><text class="progress-row__state">完成</text></view>
    <view class="progress-row {{timeline.materialDone ? 'is-done' : 'is-current'}}"><view class="progress-dot {{timeline.materialDone ? 'progress-dot--done' : 'progress-dot--current'}}"><image class="progress-dot__icon" src="{{timeline.materialDone ? '/assets/icons/check-white.svg' : '/assets/icons/upload-simple-plum.svg'}}" mode="aspectFit"/></view><view class="progress-row__copy"><strong class="progress-row__title">材料提交</strong><small class="progress-row__meta">原图、截图、链接与许可</small></view><text class="progress-row__state">{{timeline.materialState}}</text></view>
    <view class="progress-row {{timeline.reviewRowClass}}"><view class="progress-dot {{timeline.reviewDotClass}}"><image class="progress-dot__icon" src="{{timeline.reviewRowClass === 'is-done' ? '/assets/icons/check-white.svg' : '/assets/icons/clock-plum.svg'}}" mode="aspectFit"/></view><view class="progress-row__copy"><strong class="progress-row__title">内容审核</strong><small class="progress-row__meta">真实性、完整度与披露由人工核验</small></view><text class="progress-row__state {{submission.status === 'rejected' ? 'progress-row__state--alert' : ''}}">{{timeline.reviewState}}</text></view>
    <view class="progress-row progress-row--last {{timeline.resultRowClass}}"><view class="progress-dot {{timeline.resultDotClass}}"><image class="progress-dot__icon" src="{{timeline.resultRowClass === 'is-done' ? '/assets/icons/check-white.svg' : '/assets/icons/wallet-plum.svg'}}" mode="aspectFit"/></view><view class="progress-row__copy"><strong class="progress-row__title">结果处理</strong><small class="progress-row__meta">奖励与展示按活动规则分别处理</small></view><text class="progress-row__state {{submission.status === 'rejected' ? 'progress-row__state--alert' : ''}}">{{timeline.resultState}}</text></view>
  </view>

  <view wx:if="{{submission && submission.status === 'needs_changes'}}" class="glass progress-action-card"><view class="card-title">审核需要补件</view><view class="subtitle">{{reviewReason || '请按审核说明补充材料。'}}</view><view class="subtitle">补充资料后，我们会继续审核原投稿。</view><button class="primary {{navigatingToRevision || navigatingAway ? 'primary--disabled' : ''}}" loading="{{navigatingToRevision}}" disabled="{{navigatingToRevision || navigatingAway}}" bindtap="revise"><text class="action-label">按补件要求修改</text></button><view wx:if="{{errorAction === 'revise' && error}}" id="progress-error-summary" class="inline-action-error" aria-live="assertive" aria-atomic="true"><strong class="progress-revise-error__title">{{errorTitle}}</strong><text class="progress-revise-error__copy">{{error}}</text><button class="text-button progress-revise-error__retry {{navigatingToRevision || navigatingAway ? 'text-button--disabled' : ''}}" bindtap="revise" disabled="{{navigatingToRevision || navigatingAway}}">再次打开补件页面</button></view></view>
  <view wx:if="{{submission && submission.status === 'rejected'}}" class="glass progress-action-card"><view class="card-title">申请人工复核</view><view class="subtitle">{{reviewReason || '本次材料未满足活动规则，可补充说明并申请复核。'}}</view><label class="field"><text class="progress-appeal-label">申诉理由</text><textarea aria-label="申诉理由" value="{{appealReason}}" bindinput="updateAppeal" disabled="{{working}}" placeholder="说明需要重新审核的理由" cursor-spacing="120" /></label><button class="primary {{!appealValid || working || appealBlocked ? 'primary--disabled' : ''}}" loading="{{working}}" disabled="{{!appealValid || working || appealBlocked}}" bindtap="appeal"><text class="action-label">提交申诉</text></button><view wx:if="{{errorAction === 'appeal' && error}}" id="progress-error-summary" class="inline-action-error" aria-live="assertive" aria-atomic="true"><strong class="progress-appeal-error__title">{{errorTitle}}</strong><text class="progress-appeal-error__copy">{{error}}</text><button class="text-button progress-appeal-error__retry {{loading || working ? 'text-button--disabled' : ''}}" bindtap="load" disabled="{{loading || working}}">刷新审核状态后重试申诉</button></view></view>
  <view wx:if="{{submission && submission.status === 'approved' && submission.reward_enabled}}" class="progress-note">审核通过。积分奖励只生成一次并先冻结；历史证据保持可审计。</view>
  <view wx:elif="{{submission && submission.status === 'approved'}}" class="progress-note">审核通过。本环境未启用积分资产，不会产生虚构积分流水。</view>
  <view wx:if="{{submission}}" class="progress-actions"><button class="progress-back {{working || navigatingToRevision || navigatingAway ? 'control--disabled' : ''}}" bindtap="back" disabled="{{working || navigatingToRevision || navigatingAway}}"><text class="action-label">返回投稿来源</text></button><button class="progress-community {{working || navigatingToRevision || navigatingAway ? 'control--disabled' : ''}}" bindtap="goCommunity" disabled="{{working || navigatingToRevision || navigatingAway}}"><text class="action-label">返回社区首页</text></button></view>
  <view wx:if="{{!submission && error}}" id="progress-error-summary" class="glass error-scene progress-error-scene" aria-live="assertive" aria-atomic="true"><view class="error-scene__icon"><image class="error-scene__icon-image" src="/assets/icons/lock-key-plum.svg" mode="aspectFit"/></view><text class="error-scene__eyebrow">STATUS UNAVAILABLE</text><strong class="error-scene__title">{{errorTitle}}</strong><text class="error-scene__copy">{{error}}</text><view class="error-scene__actions"><button wx:if="{{errorAction === 'load'}}" class="primary progress-error-action {{loading || working || navigatingAway ? 'primary--disabled' : ''}}" bindtap="load" disabled="{{loading || working || navigatingAway}}"><text class="action-label">重新加载审核进度</text></button><button class="progress-error-action {{errorAction === 'missing' ? 'primary' : 'secondary'}} {{working || navigatingAway ? 'control--disabled' : ''}}" bindtap="back" disabled="{{working || navigatingAway}}"><text class="action-label">返回投稿来源</text></button><button class="text-button progress-error-action {{working || navigatingAway ? 'text-button--disabled' : ''}}" bindtap="goCommunity" disabled="{{working || navigatingAway}}">返回社区首页</button></view></view>
</view>
</view>
