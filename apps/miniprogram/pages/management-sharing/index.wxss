@import '../../styles/sharing-officer.wxss';
.officer-picker{min-height:44px;display:flex;align-items:center}.officer-month{width:220rpx;height:48px;font-size:16px;color:var(--cisme-ink);font-variant-numeric:tabular-nums}.officer-private{display:flex;flex-direction:column;gap:14rpx;background:#efe7f3;padding:28rpx;border-radius:20rpx;font-size:14px;margin:20rpx 0 32rpx;word-break:break-all}.officer-audit{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16rpx;font-size:13px;padding:22rpx 0;border-bottom:1rpx solid #e8e0ed}.officer-audit .officer-muted{width:100%;word-break:break-all}
