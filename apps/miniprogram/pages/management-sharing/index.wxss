@import '../../styles/sharing-officer.wxss';
.officer-review-name{color:var(--cisme-ink);font-size:18px;font-weight:600;line-height:1.4;min-width:0;overflow-wrap:anywhere}
.officer-field--approval{margin:16px 0}
.officer-field--approval textarea{height:60px}
.officer-review-state{flex:none;padding:4px 9px;border-radius:99px;background:var(--cisme-lilac);color:var(--cisme-plum);font-size:var(--cisme-text-small)}
.officer-review-actions{display:flex;flex-direction:column;align-items:stretch;gap:2px}
.officer-review-actions .action-text{align-self:center;min-height:var(--cisme-hit-target)}

.officer-review-day{margin:15px 0 21px}
.officer-review-day-head{display:flex;align-items:center;gap:10px;margin:0 2px 10px;color:var(--cisme-plum);font-size:15px;font-weight:600}
.officer-review-day-rule{flex:1;height:1rpx;background:var(--cisme-line)}
.officer-person-card{display:flex;align-items:center;gap:10px;width:100%;min-height:64px;padding:10px 12px;margin:0 0 9px;box-sizing:border-box;border:1rpx solid var(--cisme-line);border-radius:var(--cisme-radius-card);background:var(--cisme-card);color:var(--cisme-ink);text-align:left;line-height:1.35}
.officer-review-avatar{position:relative;flex:none;width:40px;height:40px;border-radius:50%;background:var(--cisme-lilac)}
.officer-review-avatar>image{display:block;width:100%;height:100%;border-radius:50%}
.officer-review-avatar--detail{width:47px;height:47px}
.officer-review-person{display:flex;flex:1;flex-direction:column;gap:3px;min-width:0}
.officer-person-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:16px;font-weight:600}
.officer-review-caption{color:var(--cisme-muted);font-size:var(--cisme-text-small);font-variant-numeric:tabular-nums;line-height:1.4;overflow-wrap:anywhere}
.officer-review-tail{display:flex;flex:none;flex-direction:column;align-items:flex-end;gap:3px}
.officer-person-points,.officer-review-result{font-size:15px;font-weight:600;font-variant-numeric:tabular-nums}
.officer-review-result{color:var(--cisme-muted)}
.officer-review-result--active{color:var(--cisme-plum)}
.officer-review-caret{flex:none;width:14px;height:14px}

.officer-sheet--review{display:flex;flex-direction:column;height:85vh;max-height:89vh;padding-top:10px;background:#fbf8fc}
.officer-sheet--review .officer-sheet-head{flex:none;margin-bottom:12px}
.officer-sheet--review .officer-sheet-scroll{flex:1;min-height:0;max-height:none}
.officer-review-identity{display:flex;align-items:center;gap:11px;margin:3px 0 17px}
.officer-review-section{display:block;margin:17px 0 9px;font-size:16px;font-weight:600;color:var(--cisme-plum)}
.officer-review-card{padding:0 12px;border:1rpx solid var(--cisme-line);border-radius:var(--cisme-radius-card);background:var(--cisme-card);overflow:hidden}
.officer-review-fact{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:38px;padding:8px 0;box-sizing:border-box;font-size:var(--cisme-text-body);line-height:1.45;color:var(--cisme-ink)}
.officer-review-fact+.officer-review-fact{border-top:1rpx solid var(--cisme-line)}
.officer-review-fact--meta{min-height:32px;color:var(--cisme-muted);font-size:var(--cisme-text-small)}
.officer-review-trigger{width:100%;min-height:var(--cisme-hit-target);margin:0;border-radius:0;background:transparent;text-align:left}
.officer-review-value{display:flex;align-items:center;gap:6px;text-align:right}
.officer-review-trigger--open .officer-review-caret{transform:rotate(90deg)}
.officer-review-expanded{margin:0 -12px;padding:2px 12px 8px;background:#f6f1f8}
.officer-review-expanded .officer-review-fact{min-height:30px;font-size:var(--cisme-text-small)}
.officer-review-snippet{display:flex;flex-direction:column;gap:3px;padding:9px 0;font-size:13px;line-height:1.45;overflow-wrap:anywhere}
.officer-review-note{display:flex;flex-direction:column;gap:5px;padding:10px 0;color:var(--cisme-ink);font-size:13px;line-height:1.55;overflow-wrap:anywhere}
.officer-review-note--section{margin-top:13px}
.officer-review-history{margin:7px 0}
.officer-review-footer{flex:none;padding:10px 0 2px}
.officer-review-caution,.officer-danger-text{color:var(--cisme-danger)}
.officer-management-links{justify-content:center;gap:16px}
.officer-qualification-actions{justify-content:center;gap:10px;border-top:1rpx solid var(--cisme-line)}
.officer-customer-toolbar{min-height:var(--cisme-hit-target);margin-bottom:8px;gap:12px}
.officer-customer-pause{display:block;margin-bottom:12px}
.officer-customer-card .action-text{flex:none;padding:0 2px}
.officer-picker{min-height:44px;display:flex;align-items:center}.officer-month{width:220rpx;height:48px;font-size:16px;color:var(--cisme-ink);font-variant-numeric:tabular-nums}.officer-private{display:flex;flex-direction:column;gap:14rpx;background:#efe7f3;padding:28rpx;border-radius:20rpx;font-size:14px;margin:20rpx 0 32rpx;word-break:break-all}.officer-audit{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16rpx;font-size:13px;padding:22rpx 0;border-bottom:1rpx solid #e8e0ed}.officer-audit .officer-muted{width:100%;word-break:break-all}
