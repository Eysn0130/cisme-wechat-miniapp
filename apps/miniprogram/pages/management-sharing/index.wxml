<view class="chrome-root officer-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">分享官管理</text></view>
<view class="page page--stack officer-page">
 <view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在加载"><view class="page-read-loading__indicator"/></view>
 <section-tabs items="{{tabs}}" value="{{tab}}" bindchange="changeTab" disabled="{{busy||pending}}" label="分享官管理分类"/>
 <view wx:if="{{error&&!sheet}}" class="officer-error"><text>{{error}}</text><button class="action-text {{busy||loading ? 'control--disabled' : ''}}" bindtap="retry" disabled="{{busy||loading}}">重试</button></view>
 <view wx:if="{{pending}}" class="officer-recovery"><text>上次操作待确认</text><view class="officer-actions"><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="recover" disabled="{{busy}}">查询结果</button><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="recover" data-abandon="{{true}}" disabled="{{busy}}">结束这次请求</button></view></view>
 <block wx:if="{{tab==='officers'&&scope}}"><view class="officer-between officer-section"><text>申请与资格</text><picker range="{{filters}}" value="{{filterIndex}}" bindchange="filterChange" disabled="{{busy||pending}}"><view class="officer-link officer-picker">{{filters[filterIndex]}}⌄</view></picker></view>
  <button wx:for="{{items}}" wx:key="memberId" class="officer-record {{busy||pending||!scope.manage ? 'control--disabled' : ''}}" data-id="{{item.memberId}}" bindtap="selectOfficer" disabled="{{busy||pending||!scope.manage}}"><view class="officer-between"><text class="officer-strong">{{item.displayName}}</text><text class="officer-link">{{item.label}}</text></view><view class="officer-between officer-muted"><text>{{item.referralCode}}</text><text>{{item.date}}</text></view><text wx:if="{{item.applicationNote}}" class="officer-note">{{item.applicationNote}}</text></button>
 </block>
 <block wx:elif="{{tab==='policy'&&policy}}"><view class="officer-between officer-section"><text>当前规则</text><button class="action-text {{busy||pending ? 'control--disabled' : ''}}" bindtap="openPolicy" disabled="{{busy||pending}}">修改</button></view><view class="officer-detail-row"><text>申请与推广</text><text>{{policy.enabled?'已开放':'已暂停'}}</text></view><view class="officer-detail-row"><text>佣金</text><text>{{policy.basisPoints/100}}% · 商品实付</text></view><view class="officer-detail-row"><text>客户归属</text><text>{{policy.attributionDays===null?'永久':policy.attributionDays+' 天'}}</text></view><view class="officer-detail-row"><text>多人推荐</text><text>{{policy.priority==='first'?'首次推荐':'最近一次推荐'}}</text></view><view class="officer-detail-row"><text>自购</text><text>不计佣</text></view><view class="officer-detail-row"><text>可结算时间</text><text>收货满 {{policy.releaseDays}} 天</text></view><text class="officer-note">进行中售后暂不结算。修改只影响后续新建订单；已有客户归属按建立时规则保留。</text></block>
 <block wx:elif="{{tab==='orders'&&scope}}"><button wx:for="{{items}}" wx:key="id" class="officer-record {{busy||pending ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="order" disabled="{{busy||pending}}"><view class="officer-between"><text class="officer-strong">{{item.productName}}</text><text class="officer-link">¥{{item.cash}}</text></view><text class="officer-note">{{item.orderNumber}} · {{item.officerCode}}</text><text wx:if="{{item.outstandingRecoveryCents}}" class="officer-warning">待核对冲回 ¥{{item.recovery}}</text></button></block>
 <block wx:elif="{{tab==='batches'&&scope}}"><block wx:if="{{!batchId}}"><view wx:if="{{!targetMemberId}}" class="officer-between officer-section"><input class="officer-month" value="{{period}}" data-field="period" bindinput="edit" placeholder="2026-10" maxlength="7" disabled="{{busy||pending}}"/><button class="action-text {{busy||pending ? 'control--disabled' : ''}}" data-action="prepare_month" bindtap="operate" disabled="{{busy||pending}}">生成月结</button></view><button wx:for="{{items}}" wx:key="id" class="officer-record {{busy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="selectBatch" disabled="{{busy}}"><view class="officer-between"><text class="officer-strong">{{item.period}} 月结</text><text class="officer-link">{{item.lineCount}} 人 ›</text></view></button></block>
  <block wx:else><view class="officer-between officer-section"><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="closeBatch" disabled="{{busy}}">{{batchPeriod}} 月结 ‹</button><button class="action-text {{busy||pending ? 'control--disabled' : ''}}" wx:if="{{!targetMemberId}}" bindtap="exportBatch" disabled="{{busy||pending}}">导出</button></view><button wx:if="{{continuePrepare&&!targetMemberId}}" class="action-text officer-more {{busy||pending ? 'control--disabled' : ''}}" data-action="prepare_month" bindtap="operate" disabled="{{busy||pending}}">继续生成</button>
   <button wx:for="{{items}}" wx:key="id" class="officer-record {{busy||pending ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="selectLine" disabled="{{busy||pending}}"><view class="officer-between"><text class="officer-strong">{{item.displayName}}</text><text class="officer-link">{{item.label}}</text></view><view class="officer-between officer-muted"><text>税前 ¥{{item.gross}}</text><text>扣税 {{item.taxCents===null?'待审核':'¥'+item.tax}}</text></view><view wx:if="{{item.taxCents!==null}}" class="officer-muted">{{item.state==='paid'?'实际到账':'预计实付'}} ¥{{item.net}}</view></button>
  </block>
 </block>
 <view wx:if="{{!loading&&!items.length&&tab!=='policy'&&scope}}" class="officer-empty">暂无记录</view><button wx:if="{{hasMore}}" class="action-text officer-more {{busy||loading ? 'control--disabled' : ''}}" bindtap="more" disabled="{{busy||loading}}">加载更多</button>
</view>
<view wx:if="{{sheet}}" class="officer-mask" bindtap="close"><view class="officer-sheet" catchtap="stop"><view class="officer-sheet-head"><text>{{sheet==='policy'?'修改规则':sheet==='officer'?'分享官资格':sheet==='decision'?decisionLabel:sheet==='line'?'结算明细':'推广订单'}}</text><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="close" disabled="{{busy}}">关闭</button></view><scroll-view class="officer-sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
 <block wx:if="{{sheet==='policy'}}"><view class="officer-detail-row"><text>开放申请与推广</text><switch checked="{{enabled}}" bindchange="toggle" color="#593377" disabled="{{busy||pending}}"/></view><label class="officer-field"><text>佣金比例（%）</text><input type="digit" value="{{rate}}" data-field="rate" bindinput="edit" disabled="{{busy||pending}}"/></label><label class="officer-field"><text>确认收货后等待天数</text><input type="number" value="{{days}}" data-field="days" bindinput="edit" disabled="{{busy||pending}}"/></label><view class="officer-detail-row"><text>客户归属</text><picker range="{{durations}}" value="{{durationIndex}}" data-field="durationIndex" bindchange="pick" disabled="{{busy||pending}}"><text class="officer-link">{{durations[durationIndex]}}⌄</text></picker></view><label wx:if="{{durationIndex===1}}" class="officer-field"><text>归属天数</text><input type="number" value="{{attributionDays}}" data-field="attributionDays" bindinput="edit" disabled="{{busy||pending}}"/></label><view class="officer-detail-row"><text>多人推荐</text><picker range="{{priorities}}" value="{{priorityIndex}}" data-field="priorityIndex" bindchange="pick" disabled="{{busy||pending}}"><text class="officer-link">{{priorities[priorityIndex]}}⌄</text></picker></view><label class="officer-field"><text>修改依据</text><textarea value="{{reason}}" data-field="reason" bindinput="edit" maxlength="300" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending||!rate||!days||!reason ? 'primary--disabled' : ''}}" data-action="policy" bindtap="operate" disabled="{{busy||pending||!rate||!days||!reason}}" loading="{{busy}}">保存新规则</button></block>
 <block wx:elif="{{sheet==='officer'&&selected}}"><text class="officer-strong">{{selected.displayName}}</text><text class="officer-note">{{selected.referralCode}} · {{selected.label}}</text><text class="officer-copy">{{selected.applicationNote}}</text><view class="officer-actions"><block wx:if="{{selected.state==='pending'}}"><button class="action-text" data-state="active" data-label="通过申请" bindtap="chooseDecision">通过</button><button class="action-text" data-state="rejected" data-label="拒绝申请" bindtap="chooseDecision">拒绝</button></block><button wx:if="{{selected.state==='active'}}" class="action-text" data-state="suspended" data-label="暂停资格" bindtap="chooseDecision">暂停资格</button><button wx:if="{{selected.state==='suspended'}}" class="action-text" data-state="active" data-label="恢复资格" bindtap="chooseDecision">恢复资格</button><button wx:if="{{selected.state==='active'||selected.state==='suspended'}}" class="action-text" data-state="terminated" data-label="终止资格" bindtap="chooseDecision">终止资格</button></view></block>
 <block wx:elif="{{sheet==='decision'}}"><text class="officer-strong">{{selected.displayName}} · {{selected.referralCode}}</text><label class="officer-field"><text>处理依据</text><textarea value="{{reason}}" data-field="reason" bindinput="edit" maxlength="300" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending||!reason ? 'primary--disabled' : ''}}" data-action="officer_state" bindtap="operate" loading="{{busy}}" disabled="{{busy||pending||!reason}}">确认{{decisionLabel}}</button></block>
 <block wx:elif="{{sheet==='line'&&selected}}"><text class="officer-strong">{{selected.displayName}} · {{selected.label}}</text><view class="officer-detail-row"><text>税前佣金</text><text>¥{{selected.gross}}</text></view><view class="officer-detail-row"><text>扣税</text><text>{{selected.taxCents===null?'待审核':'¥'+selected.tax}}</text></view><view class="officer-detail-row"><text>{{selected.state==='paid'?'实际到账':'预计实付'}}</text><text>{{selected.taxCents===null?'待审核':'¥'+selected.net}}</text></view><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="readPayee" disabled="{{busy}}">查看收款资料</button><button class="action-text {{busy||historyLoading ? 'control--disabled' : ''}}" bindtap="loadLineOrders" disabled="{{busy||historyLoading}}">查看来源订单</button><button wx:for="{{sourceOrders}}" wx:key="id" class="officer-record {{busy ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="order" disabled="{{busy}}"><view class="officer-between"><text>{{item.productName}}</text><text>¥{{item.cash}}</text></view><text class="officer-note">{{item.orderNumber}}</text></button><button wx:if="{{sourceMore}}" class="action-text {{busy||historyLoading ? 'control--disabled' : ''}}" bindtap="moreLineOrders" disabled="{{busy||historyLoading}}">更多来源订单</button><view wx:if="{{payee}}" class="officer-private"><text>{{payee.legalName}}</text><text>{{payee.channel}}</text><text user-select>{{payee.account}}</text></view>
  <block wx:if="{{selected.state==='prepared'||selected.state==='reviewed'}}"><label class="officer-field"><text>财务审核扣税（元）</text><input type="digit" value="{{tax}}" data-field="tax" bindinput="edit" disabled="{{busy||pending}}"/></label><label class="officer-field"><text>税务处理依据</text><textarea value="{{taxNote}}" data-field="taxNote" bindinput="edit" maxlength="500" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending||tax===''||!taxNote ? 'primary--disabled' : ''}}" data-action="review_line" bindtap="operate" loading="{{busy}}" disabled="{{busy||pending||tax===''||!taxNote}}">确认审核</button></block>
  <block wx:if="{{selected.state==='reviewed'}}"><label class="officer-field"><text>实际付款时间（北京时间）</text><input value="{{paidAt}}" data-field="paidAt" bindinput="edit" disabled="{{busy||pending}}"/></label><label class="officer-field"><text>付款流水号</text><input value="{{reference}}" data-field="reference" bindinput="edit" maxlength="160" disabled="{{busy||pending}}"/></label><label class="officer-field"><text>付款记录</text><textarea value="{{paymentNote}}" data-field="paymentNote" bindinput="edit" maxlength="500" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending||!reference||!paymentNote||!paidAt ? 'primary--disabled' : ''}}" data-action="record_payment" bindtap="operate" loading="{{busy}}" disabled="{{busy||pending||!reference||!paymentNote||!paidAt}}">登记已付款</button></block>
  <block wx:if="{{selected.state==='prepared'||selected.state==='reviewed'}}"><label class="officer-field"><text>撤销依据</text><input value="{{reason}}" data-field="reason" bindinput="edit" maxlength="300" disabled="{{busy||pending}}"/></label><button class="action-text {{busy||pending||!reason ? 'control--disabled' : ''}}" data-action="void_line" bindtap="operate" disabled="{{busy||pending||!reason}}">撤销本条，释放预占</button></block><text wx:if="{{selected.paymentReference}}" class="officer-note">付款流水：{{selected.paymentReference}}</text></block>
 <block wx:elif="{{sheet==='order'&&selected}}"><text class="officer-strong">{{selected.productName}}</text><text class="officer-note">{{selected.orderNumber}}</text><view class="officer-detail-row"><text>商品实付</text><text>¥{{selected.cash}}</text></view><view wx:if="{{selected.outstandingRecoveryCents}}" class="officer-warning">已结算后退款 · 待核对冲回 ¥{{selected.recovery}}</view>
  <view class="officer-section">佣金记录</view><view wx:if="{{historyLoading}}" class="officer-note" aria-role="status">正在加载</view>
<view wx:for="{{history}}" wx:key="id" class="officer-history-record"><view class="officer-between"><text class="officer-strong">{{item.label}}</text><text wx:if="{{item.kind!=='payment_record'}}" class="officer-link">¥{{item.amount}}</text><text wx:else class="officer-link">{{item.stateLabel}}</text></view><text class="officer-muted">{{item.date}}</text>
 <block wx:if="{{item.kind==='payment_record'}}"><text class="officer-note">本单税前佣金 ¥{{item.orderGrossCents/100}} · {{item.period}} 月结</text><text class="officer-note">整笔月结税前 ¥{{item.gross}} · 扣税 {{item.settlementTaxCents===null?'待审核':'¥'+item.tax}} · {{item.state==='paid'?'实付':'预计实付'}} {{item.settlementNetCents===null?'待审核':'¥'+item.net}}</text></block>
 <text wx:if="{{item.kind==='recovery_record'}}" class="officer-note">实收 ¥{{item.received}} · 财务税务调整 ¥{{item.taxAdjustment}}</text><text wx:if="{{item.reference}}" class="officer-reference" user-select>{{item.reference}}</text>
</view><button wx:if="{{historyMore}}" class="action-text officer-more {{historyLoading ? 'control--disabled' : ''}}" bindtap="moreHistory" disabled="{{historyLoading}}">更早的记录</button>

  <block wx:if="{{scope.finance&&selected.outstandingRecoveryCents}}"><label class="officer-field"><text>核对冲回税前佣金（元）</text><input type="digit" value="{{recoveryAmount}}" data-field="recoveryAmount" bindinput="edit" disabled="{{busy||pending}}"/></label><label class="officer-field"><text>实际收回（元）</text><input type="digit" value="{{receivedAmount}}" data-field="receivedAmount" bindinput="edit" disabled="{{busy||pending}}"/></label><label class="officer-field"><text>财务税务调整（元，可为负）</text><input value="{{taxAdjustment}}" data-field="taxAdjustment" bindinput="edit" disabled="{{busy||pending}}"/></label><label class="officer-field"><text>回收流水号</text><input value="{{reference}}" data-field="reference" bindinput="edit" disabled="{{busy||pending}}"/></label><label class="officer-field"><text>财务核对记录</text><textarea value="{{reason}}" data-field="reason" bindinput="edit" maxlength="500" disabled="{{busy||pending}}"/></label><button class="primary {{busy||pending||!recoveryAmount||receivedAmount===''||taxAdjustment===''||!reference||!reason ? 'primary--disabled' : ''}}" data-action="record_recovery" bindtap="operate" disabled="{{busy||pending||!recoveryAmount||receivedAmount===''||taxAdjustment===''||!reference||!reason}}" loading="{{busy}}">登记已收回</button></block>
 </block>
 <text wx:if="{{error}}" class="officer-error">{{error}}</text><view wx:if="{{pending}}" class="officer-actions"><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="recover" disabled="{{busy}}">查询上次操作</button><button class="action-text {{busy ? 'control--disabled' : ''}}" bindtap="recover" data-abandon="{{true}}" disabled="{{busy}}">结束这次请求</button></view>
</scroll-view></view></view></view>
