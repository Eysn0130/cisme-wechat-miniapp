<page-meta root-font-size="system"/>
<view wx:if="{{editorialSource}}" class="chrome-root management-ui" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">评论管理</text></view>
  <view class="page page--stack review-page {{editorialSource ? 'review-page--editorial' : ''}}">
    <view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在加载评论…"><view class="page-read-loading__indicator"/></view>
    <view wx:if="{{error}}" class="state state--error" aria-live="assertive"><text>{{error}}</text><button wx:if="{{(!editorialSource && !postId) || permissionDenied}}" class="text-button" bindtap="back">返回</button><button wx:else class="text-button" bindtap="load">重新加载</button></view>
    <view wx:if="{{notice}}" class="state" aria-live="polite">{{notice}}</view>
    <button wx:if="{{handled}}" class="text-button" bindtap="back">返回</button>
    <block wx:if="{{editorialSource}}">
      <view class="page-section-tabs"><section-tabs id="page-tabs" items="{{queueTabs}}" value="{{queueState}}" label="评论分类" bindchange="selectEditorialQueue" disabled="{{busy}}"/></view>
      <text wx:if="{{!loading && !error && !queueItems.length}}" class="review-comment-empty">当前没有{{queueState === 'pending' ? '待审核的' : queueState === 'reported' ? '被举报的' : ''}}评论</text>
      <view wx:for="{{queueItems}}" wx:key="id" class="review-comment-card">
        <button class="review-comment-article" data-article-id="{{item.articleId}}" bindtap="openEditorialArticle" hover-class="review-control--pressed" hover-start-time="0" hover-stay-time="80">{{item.articleTitle}}</button>
        <view class="review-comment-author"><view class="review-comment-identity"><image class="review-comment-avatar" src="{{item.avatar}}" mode="aspectFill"/><text>{{item.authorName}}</text></view><text>{{item.statusLabel}}</text></view>
        <text class="review-comment-body">{{item.body}}</text>
        <text wx:if="{{item.parentId}}" class="review-comment-meta">这是一条回复</text>
        <text class="review-comment-meta">{{item.dateLabel}} · 安全检查：{{item.safetyLabel}}{{item.reportCount ? ' · ' + item.reportCount + ' 条举报' : ''}}</text>
        <view class="review-comment-actions"><block wx:if="{{item.status === 'pending'}}"><button data-id="{{item.id}}" data-decision="reject" bindtap="reviewEditorial" disabled="{{busy || loading}}" hover-class="review-control--pressed {{busy || loading ? 'control--disabled' : ''}} {{busy || loading?'control--disabled':''}}" hover-start-time="0" hover-stay-time="80" class="{{busy || loading ? 'control--disabled' : ''}}">退回</button><button data-id="{{item.id}}" data-decision="approve" class="review-comment-approve {{busy || loading || item.safetyState !== 'safe' ? 'control--disabled' : ''}} {{busy || loading || item.safetyState !== 'safe'?'control--disabled':''}}" bindtap="reviewEditorial" disabled="{{busy || loading || item.safetyState !== 'safe'}}" hover-class="review-control--pressed" hover-start-time="0" hover-stay-time="80">通过审核</button></block><button wx:if="{{item.status === 'published'}}" data-id="{{item.id}}" data-decision="hide" bindtap="reviewEditorial" disabled="{{busy || loading}}" hover-class="review-control--pressed {{busy || loading ? 'control--disabled' : ''}} {{busy || loading?'control--disabled':''}}" hover-start-time="0" hover-stay-time="80" class="{{busy || loading ? 'control--disabled' : ''}}">隐藏评论</button><button class="review-comment-delete {{busy || loading ? 'control--disabled' : ''}} {{busy || loading?'control--disabled':''}}" data-id="{{item.id}}" bindtap="deleteEditorial" disabled="{{busy || loading}}" hover-class="review-control--pressed" aria-label="删除 {{item.authorName}} 的评论">删除</button></view>
      </view>
      <button wx:if="{{queueHasMore}}" class="review-comment-more {{loading || busy ? 'control--disabled' : ''}} {{loading || busy?'control--disabled':''}}" bindtap="loadMoreEditorialQueue" disabled="{{loading || busy}}" hover-class="review-control--pressed" hover-start-time="0" hover-stay-time="80">{{loading ? '正在加载…' : '加载更多评论'}}</button>
    </block>
  </view>
</view>
<view wx:if="{{moderationSource}}" class="chrome-root management-ui" style="{{chromeStyle}}">
  <view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回帖子管理"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">举报与申诉</text></view>
  <view class="page page--stack review-governance-page">
    <section-tabs items="{{[{id:'reports',label:'举报'},{id:'appeals',label:'申诉'}]}}" value="{{governanceTab}}" label="社区治理分类" bindchange="selectGovernance" disabled="{{busy}}"/>
    <view class="governance-heading"><text wx:if="{{governanceTotal!==null}}">{{governanceTotal}} 条</text><text wx:else> </text><button class="text-button {{busy||loading?'control--disabled':''}}" bindtap="loadGovernance" disabled="{{busy||loading}}">刷新</button></view>
    <view wx:if="{{loading}}" class="page-read-loading" aria-role="status" aria-label="正在读取治理记录"><view class="page-read-loading__indicator"/></view>
    <view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button {{busy?'control--disabled':''}}" bindtap="loadGovernance" disabled="{{busy}}">重试</button></view>
    <view wx:if="{{!loading&&!error&&!governanceItems.length}}" class="governance-empty">{{governanceTab==='reports'?'暂无待处理举报':'暂无可复核申诉'}}</view>
    <view wx:for="{{governanceItems}}" wx:key="id" class="governance-row">
      <block wx:if="{{governanceTab==='reports'}}"><text class="governance-title">{{item.targetSummary||'内容当前不可见'}}</text><text class="governance-meta">{{item.targetType==='post'?'帖子举报':item.targetType==='comment'?'评论举报':'账号举报'}}</text><text wx:if="{{item.description}}" class="governance-copy">{{item.description}}</text>
        <view class="governance-actions"><button wx:if="{{item.postId}}" class="text-button {{busy?'control--disabled':''}}" data-id="{{item.id}}" bindtap="openGovernanceTarget" disabled="{{busy}}">查看原帖</button><button class="text-button {{busy||loading?'control--disabled':''}}" data-id="{{item.id}}" data-decision="dismiss" bindtap="decideGovernance" disabled="{{busy||loading}}">驳回举报</button><button wx:if="{{item.targetType==='post'||item.targetType==='comment'}}" class="text-button governance-danger {{busy||loading?'control--disabled':''}}" data-id="{{item.id}}" data-decision="{{item.targetType==='post'?'hide_post':'remove_comment'}}" bindtap="decideGovernance" disabled="{{busy||loading}}">{{item.targetType==='post'?'下架帖子':'移除评论'}}</button></view>
      </block>
      <block wx:else><text class="governance-title">{{item.title||'图片帖子'}}</text><text wx:if="{{item.body}}" class="governance-copy">{{item.body}}</text><view class="governance-evidence"><text class="governance-meta">申诉说明</text><text class="governance-copy">{{item.reason}}</text><text class="governance-meta">下架依据</text><text class="governance-copy">{{item.hiddenReason}}</text></view>
        <view class="governance-actions"><button class="text-button {{busy||loading?'control--disabled':''}}" data-id="{{item.id}}" data-decision="uphold" bindtap="decideGovernance" disabled="{{busy||loading}}">维持下架</button><button class="text-button {{busy||loading||!governancePublicEnabled||item.postState!=='hidden'?'control--disabled':''}}" data-id="{{item.id}}" data-decision="restore" bindtap="decideGovernance" disabled="{{busy||loading||!governancePublicEnabled||item.postState!=='hidden'}}">恢复公开</button></view><text wx:if="{{!governancePublicEnabled||item.postState!=='hidden'}}" class="governance-meta">当前暂不能恢复公开，请刷新核对</text>
      </block>
    </view>
    <button wx:if="{{governanceCursor}}" class="text-button {{busy||loading?'control--disabled':''}}" bindtap="moreGovernance" disabled="{{busy||loading}}">查看更多</button>
  </view>
</view>
