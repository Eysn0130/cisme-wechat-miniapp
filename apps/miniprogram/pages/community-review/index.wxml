<page-meta root-font-size="system"/>
<view class="chrome-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">{{editorialSource ? '评论管理' : '社区内容审核'}}</text></view>
  <view class="page page--stack review-page {{editorialSource ? 'review-page--editorial' : ''}}">
    <view wx:if="{{loading}}" class="state" aria-live="polite">{{editorialSource ? '正在加载评论…' : '正在加载待审核内容…'}}</view>
    <view wx:if="{{error}}" class="state state--error" aria-live="assertive"><text>{{error}}</text><button wx:if="{{(!editorialSource && !postId) || permissionDenied}}" class="text-button" bindtap="back">返回</button><button wx:else class="text-button" bindtap="load">重新加载</button></view>
    <view wx:if="{{notice}}" class="state" aria-live="polite">{{notice}}</view>
    <button wx:if="{{handled}}" class="text-button" bindtap="back">返回</button>
    <block wx:if="{{editorialSource}}">
      <scroll-view class="review-comment-tabs" scroll-x="{{true}}"><view class="review-comment-tabs__row"><button wx:for="{{queueTabs}}" wx:key="id" data-state="{{item.id}}" bindtap="selectEditorialQueue" class="review-comment-tab {{queueState === item.id ? 'is-current' : ''}}" aria-label="{{item.label}}评论" aria-pressed="{{queueState === item.id}}" hover-class="review-control--pressed" hover-start-time="0" hover-stay-time="80">{{item.label}}</button></view></scroll-view>
      <text wx:if="{{!loading && !error && !queueItems.length}}" class="review-comment-empty">当前没有{{queueState === 'pending' ? '待审核的' : queueState === 'reported' ? '被举报的' : ''}}评论</text>
      <view wx:for="{{queueItems}}" wx:key="id" class="review-comment-card">
        <button class="review-comment-article" data-article-id="{{item.articleId}}" bindtap="openEditorialArticle" hover-class="review-control--pressed" hover-start-time="0" hover-stay-time="80">{{item.articleTitle}}</button>
        <view class="review-comment-author"><view class="review-comment-identity"><image class="review-comment-avatar" src="{{item.avatar}}" mode="aspectFill"/><text>{{item.authorName}}</text></view><text>{{item.statusLabel}}</text></view>
        <text class="review-comment-body">{{item.body}}</text>
        <text wx:if="{{item.parentId}}" class="review-comment-meta">这是一条回复</text>
        <text class="review-comment-meta">{{item.dateLabel}} · 安全检查：{{item.safetyLabel}}{{item.reportCount ? ' · ' + item.reportCount + ' 条举报' : ''}}</text>
        <view class="review-comment-actions"><block wx:if="{{item.status === 'pending'}}"><button data-id="{{item.id}}" data-decision="reject" bindtap="reviewEditorial" disabled="{{busy || loading}}" hover-class="review-control--pressed" hover-start-time="0" hover-stay-time="80" class="{{busy || loading ? 'control--disabled' : ''}}">退回</button><button data-id="{{item.id}}" data-decision="approve" class="review-comment-approve {{busy || loading || item.safetyState !== 'safe' ? 'control--disabled' : ''}}" bindtap="reviewEditorial" disabled="{{busy || loading || item.safetyState !== 'safe'}}" hover-class="review-control--pressed" hover-start-time="0" hover-stay-time="80">通过审核</button></block><button wx:if="{{item.status === 'published'}}" data-id="{{item.id}}" data-decision="hide" bindtap="reviewEditorial" disabled="{{busy || loading}}" hover-class="review-control--pressed" hover-start-time="0" hover-stay-time="80" class="{{busy || loading ? 'control--disabled' : ''}}">隐藏评论</button><button class="review-comment-delete {{busy || loading ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="deleteEditorial" disabled="{{busy || loading}}" hover-class="review-control--pressed" aria-label="删除 {{item.authorName}} 的评论">删除</button></view>
      </view>
      <button wx:if="{{queueHasMore}}" class="review-comment-more {{loading || busy ? 'control--disabled' : ''}}" bindtap="loadMoreEditorialQueue" disabled="{{loading || busy}}" hover-class="review-control--pressed" hover-start-time="0" hover-stay-time="80">{{loading ? '正在加载…' : '加载更多评论'}}</button>
    </block>
    <block wx:if="{{candidate}}"><text class="review-eyebrow">版本 {{candidate.revision}}</text><view class="page-title">内容审核与发布复核</view>
      <view class="review-status">{{candidate.moderationState === 'approved' ? '内容已通过，待另一名审核员发布' : candidate.state === 'pending_review' ? '等待审核' : '当前状态：' + (candidateStateLabels[candidate.state] || '状态待核对')}}</view>
      <view wx:if="{{candidate.title}}" class="review-title">{{candidate.title}}</view><view wx:if="{{candidate.body}}" class="review-body">{{candidate.body}}</view>
      <view wx:if="{{!candidate.body && !media.length}}" class="state state--error">内容为空，不能通过审核。</view>
      <view wx:for="{{media}}" wx:key="id" class="review-media"><image wx:if="{{item.src}}" src="{{item.src}}" mode="widthFix" data-src="{{item.src}}" bindtap="preview" aria-label="查看待审核图片 {{index + 1}}"/><view wx:else class="review-media__missing">图片预览失败，请重试。</view>
        <text class="review-media__state">图片状态：{{mediaStateLabels[item.state] || '状态待核对'}} · 安全检测：{{item.scanVerdict === 'safe' ? '已通过' : item.scanVerdict === 'pending' ? '待完成' : '未通过'}}</text>
        <view wx:if="{{item.state === 'uploaded' || item.state === 'scanning'}}" class="review-media__actions"><button data-id="{{item.id}}" data-decision="approve" class="{{busy || item.scanVerdict !== 'safe' ? 'control--disabled' : ''}}" bindtap="reviewMedia" disabled="{{busy || item.scanVerdict !== 'safe'}}">通过图片</button><button data-id="{{item.id}}" data-decision="reject" class="{{busy ? 'control--disabled' : ''}}" bindtap="reviewMedia" disabled="{{busy}}">退回图片</button></view>
      </view>
      <view class="review-declarations"><text>AI 使用：{{candidate.aiUsage === 'none' ? '未使用' : candidate.aiUsage === 'assisted' ? '辅助' : candidate.aiUsage === 'generated' ? '生成' : '尚不明确'}}</text><text>内容权利：{{candidate.rightsConfirmed ? '作者已确认' : '未确认'}}</text><text>公开许可：{{candidate.publicConsentConfirmed ? '作者已确认' : '未确认'}}</text></view>
      <view wx:if="{{candidate.lastAction}}" class="review-last">最近处理：{{reviewDecisionLabels[candidate.lastAction.decision] || '待核对'}} · {{candidate.lastAction.reason}}</view>
      <view wx:if="{{candidate.moderationState === 'pending'}}" class="review-actions"><button data-decision="reject" class="{{busy ? 'control--disabled' : ''}}" bindtap="reviewPost" disabled="{{busy}}">退回修改</button><button class="primary {{busy ? 'primary--disabled' : ''}}" data-decision="approve" bindtap="reviewPost" disabled="{{busy}}">通过内容</button></view>
      <button wx:if="{{candidate.moderationState === 'approved' && candidate.revision !== candidate.publishedRevision}}" class="primary review-publish {{busy ? 'primary--disabled' : ''}}" bindtap="publish" disabled="{{busy}}">复核并公开</button>
      <text class="review-hint">图片须通过安全检测和人工审核。另一名审核员完成发布复核后，内容才会公开。</text>
    </block>
  </view>
</view>
