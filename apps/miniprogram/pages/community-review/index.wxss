.review-page{padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 56px));padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 70rpx);background:#f7f2f8}.review-eyebrow{display:block;color:#8b738f;font-size:21rpx;letter-spacing:4rpx}.review-status{margin:18rpx 0 28rpx;padding:18rpx 20rpx;border-radius:16rpx;background:#eee5f0;color:#654e70;font-size:25rpx}.review-title{color:#413249;font-size:37rpx;font-weight:600;line-height:1.4}.review-body{margin:20rpx 0;color:#4c4153;font-size:28rpx;line-height:1.7;white-space:pre-wrap;word-break:break-word}.review-media{overflow:hidden;margin:20rpx 0;padding:12rpx;border:1rpx solid #e4d7e8;border-radius:20rpx;background:#fff}.review-media image{display:block;width:100%;border-radius:12rpx}.review-media__missing{display:flex;align-items:center;justify-content:center;min-height:220rpx;color:#876b80;font-size:24rpx}.review-media__state{display:block;margin:16rpx 4rpx;color:#5d4d65;font-size:24rpx}.review-media__actions,.review-actions{display:flex;gap:14rpx}.review-media__actions button,.review-actions button{flex:1;min-height:84rpx;border:1rpx solid #d9c7df;border-radius:14rpx;background:#f8f3f9;color:#674b72;font-size:25rpx}.review-media__actions .control--disabled{opacity:.5}.review-declarations{display:flex;flex-direction:column;gap:12rpx;margin:30rpx 0;padding:24rpx;border-radius:18rpx;background:#fff;color:#66556e;font-size:25rpx}.review-last{margin-bottom:20rpx;color:#786a7d;font-size:23rpx;line-height:1.5}.review-actions .primary,.review-publish{background:#6b417b;color:#fff}.review-publish{width:100%;min-height:88rpx;margin:26rpx 0}.review-hint{display:block;margin-top:20rpx;color:#776b7d;font-size:23rpx;line-height:1.55}

.review-page .state--error .text-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;min-height:44px;margin:12px 0 0;padding:10px 16px;border:1rpx solid #d8c9dd;border-radius:12px;background:#fff;color:#56306f;font-size:14px;line-height:1.4;text-align:center;white-space:normal}

.review-media__actions button,.review-actions button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:0;min-height:44px;margin:0;padding:10px 12px;line-height:1.4;white-space:normal}
