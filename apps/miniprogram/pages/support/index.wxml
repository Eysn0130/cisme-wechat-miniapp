<view class="support-shell" style="{{chromeStyle}}">
  <view class="topbar support-topbar">
    <button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button>
    <view class="support-title">
      <text class="topbar__title">{{closedRights?'历史订单客服':'CISME 客服'}}</text>
      <view class="support-presence support-presence--{{statusTone}}" aria-label="{{statusLabel}}"><text class="support-presence__dot">●</text><text class="support-presence__label">{{statusLabel}}</text></view>
    </view>
  </view>

  <scroll-view class="support-thread" style="{{threadBottomStyle}}" scroll-y enhanced show-scrollbar="true" scroll-into-view="{{anchor}}" bindscroll="onThreadScroll" bindscrolltolower="onThreadBottom" lower-threshold="36">
    <view class="support-thread__content">
    <view wx:if="{{loading}}" class="support-state" aria-live="polite">正在同步会话…</view>
    <button wx:if="{{!loading && olderCursor !== null}}" class="text-button {{loadingOlder ? 'text-button--disabled' : ''}}" bindtap="loadOlder" disabled="{{loadingOlder}}" loading="{{loadingOlder}}">查看更早消息</button>
    <view wx:if="{{!loading && !messages.length && !pendingMessage}}" class="support-welcome">
      <image src="/assets/icons/chat-circle-plum.svg"/>
      <strong>你好，这里是 CISME 客服</strong>
      <text>护理、账号或订单有问题？请在这里留言。</text>
    </view>

    <block wx:for="{{messages}}" wx:key="id">
      <view wx:if="{{item.timeSeparatorLabel}}" class="support-time-separator"><text>{{item.timeSeparatorLabel}}</text></view>
      <view wx:if="{{item.senderType === 'system'}}" id="support-{{item.sequence}}" class="support-system"><text>{{item.displayBody}}</text>
        <view wx:if="{{item.returnInstruction}}" class="return-card">
          <strong>发送时的退货指引 · 第 {{item.returnInstruction.version}} 版</strong>
          <text>{{item.returnInstruction.recipientName}} · {{item.returnInstruction.phone}}</text>
          <text>{{item.returnInstruction.region}} {{item.returnInstruction.address}}</text>
          <text>退货寄件运费：{{item.returnInstruction.freightPayer==='merchant'?'商家承担':item.returnInstruction.freightPayer==='member'?'你承担':'请与客服确认'}}</text>
          <text wx:if="{{item.returnInstruction.instructions}}">{{item.returnInstruction.instructions}}</text>
          <view class="return-card__actions"><button data-id="{{item.returnInstruction.caseId}}" bindtap="openAftersaleCase">核对当前指引并登记物流</button></view>
        </view>
      </view>
      <view wx:else id="support-{{item.sequence}}" class="support-message support-message--{{item.senderType}} {{item.groupStart ? 'support-message--group-start' : 'support-message--grouped'}}">
        <view wx:if="{{item.senderType !== 'user'}}" class="support-avatar-slot">
          <view wx:if="{{item.groupStart}}" class="support-avatar support-avatar--{{item.avatarKind}}"><image src="{{item.avatarKind === 'ai' ? '/assets/icons/star-active.svg' : '/assets/icons/chat-circle-plum.svg'}}"/></view>
        </view>
        <view class="support-message__content">
          <text wx:if="{{item.groupStart && item.senderType !== 'user'}}" class="support-message__sender">{{item.senderLabel}}</text>
          <view wx:if="{{item.body}}" class="support-bubble">{{item.body}}</view>
          <view wx:if="{{item.attachments.length}}" class="support-media-grid">
            <button wx:for="{{item.attachments}}" wx:for-item="media" wx:key="id" class="support-media" data-media-id="{{media.id}}" bindtap="previewImage" aria-label="预览客服图片">
              <image src="{{media.localPath || '/assets/icons/images-plum.svg'}}" mode="aspectFill" lazy-load="true"/>
              <text wx:if="{{!media.localPath}}">安全加载中</text>
            </button>
          </view>
          <button wx:if="{{item.orderCard}}" class="support-order-card" data-id="{{item.orderCard.orderId}}" bindtap="openOrder" aria-label="查看订单尾号 {{item.orderCard.orderNumberTail}}">
            <image class="support-order-card__image" src="{{item.orderCard.productImage || '/assets/icons/package-plum.svg'}}" mode="aspectFill"/>
            <view class="support-order-card__content"><small>订单 · 尾号 {{item.orderCard.orderNumberTail}}</small><strong>{{item.orderCard.productName}}</strong><text>{{item.orderCard.statusLabel}} · ¥{{item.orderCard.totalYuan}}</text></view>
            <image class="support-order-card__arrow" src="/assets/icons/caret-right-muted.svg"/>
          </button>
          <view wx:if="{{item.groupEnd}}" class="support-message__meta"><text>{{item.timeLabel}}</text><text wx:if="{{item.senderType === 'user' && item.deliveryLabel}}"> · {{item.deliveryLabel}}</text></view>
        </view>
      </view>
    </block>

    <view wx:if="{{pendingMessage}}" class="support-message support-message--user support-message--pending">
      <view class="support-message__content">
        <view wx:if="{{pendingMessage.body}}" class="support-bubble">{{pendingMessage.body}}</view>
        <view wx:if="{{pendingMessage.attachments.length}}" class="support-media-grid"><view class="support-media"><image src="{{pendingMessage.attachments[0].localPath}}" mode="aspectFill"/></view></view>
        <view wx:if="{{pendingMessage.orderCard}}" class="support-order-card support-order-card--static"><image class="support-order-card__image" src="{{pendingMessage.orderCard.productImage || '/assets/icons/package-plum.svg'}}" mode="aspectFill"/><view class="support-order-card__content"><small>订单 · 尾号 {{pendingMessage.orderCard.orderNumberTail}}</small><strong>{{pendingMessage.orderCard.productName}}</strong><text>{{pendingMessage.orderCard.statusLabel}} · ¥{{pendingMessage.orderCard.totalYuan}}</text></view></view>
        <view class="support-message__meta support-message__meta--{{pendingMessage.deliveryLabel === '发送失败' ? 'failed' : 'pending'}}"><text>{{pendingMessage.timeLabel}} · {{pendingMessage.deliveryLabel}}</text><button wx:if="{{pendingMessage.deliveryLabel === '发送失败'||pendingMessage.deliveryLabel === '结果待核对'}}" bindtap="retrySend">核对原消息</button></view>
      </view>
    </view>

    <view wx:if="{{presence.operatorTyping}}" class="support-typing" aria-live="polite">
      <view class="support-avatar support-avatar--human"><image src="/assets/icons/chat-circle-plum.svg"/></view>
      <view class="support-typing__body"><view class="support-typing__dots"><view class="support-typing__dot"></view><view class="support-typing__dot support-typing__dot--two"></view><view class="support-typing__dot support-typing__dot--three"></view></view><text class="support-typing__copy">{{presence.agentDisplayName}}正在输入…</text></view>
    </view>
    <view wx:if="{{error}}" class="support-error" aria-live="assertive"><text>{{error}}</text><button wx:if="{{errorAction === 'sync'}}" bindtap="retry">重试</button><button wx:elif="{{errorAction === 'handoff'}}" bindtap="retryHandoff">重新提交</button></view>
      <view class="support-thread__end"></view>
    </view>
  </scroll-view>

  <button wx:if="{{newMessagesBelowCount > 0}}" class="new-message" style="{{newMessageBottomStyle}}" bindtap="jumpToLatest" aria-label="查看 {{newMessagesBelowCount}} 条新消息">↓ {{newMessagesBelowCount}} 条新消息</button>

  <view class="support-composer {{composerFocused ? 'support-composer--focused' : ''}}">
    <view class="support-composer__surface {{composerFocused ? 'support-composer__surface--focused' : ''}}">
      <view wx:if="{{selectedImage || selectedOrder}}" class="support-draft-attachments">
        <view wx:if="{{selectedImage}}" class="support-draft-media">
          <image class="support-draft__image" src="{{selectedImage.localPath}}" mode="aspectFill"/>
          <view class="support-draft__content"><strong wx:if="{{selectedImage.status === 'ready'}}">图片已添加</strong><strong wx:elif="{{selectedImage.status === 'failed'}}">图片上传失败</strong><strong wx:else>正在上传 {{selectedImage.progress}}%</strong><text>{{selectedImage.status === 'failed' ? selectedImage.error : '发送前可以移除'}}</text></view>
          <button wx:if="{{selectedImage.status === 'failed'}}" bindtap="retryImageUpload">重传</button><button bindtap="removeImage" aria-label="移除图片"><image class="support-draft__remove-icon" src="/assets/icons/close-plum.svg" mode="aspectFit"/></button>
        </view>
        <view wx:if="{{selectedOrder}}" class="support-draft-order"><image class="support-draft__image" src="{{selectedOrder.productImage || '/assets/icons/package-plum.svg'}}" mode="aspectFill"/><view class="support-draft__content"><strong>{{selectedOrder.productName}}</strong><text>订单尾号 {{selectedOrder.orderNumberTail}} · {{selectedOrder.statusLabel}}</text></view><button wx:if="{{!closedRights}}" bindtap="removeOrder" aria-label="移除订单"><image class="support-draft__remove-icon" src="/assets/icons/close-plum.svg" mode="aspectFit"/></button></view>
      </view>
      <textarea class="support-input {{composerCapped ? 'support-input--capped' : ''}}" value="{{input}}" bindinput="updateInput" bindfocus="onComposerFocus" bindblur="onComposerBlur" bindlinechange="onComposerLineChange" bindkeyboardheightchange="onKeyboardHeightChange" maxlength="4000" auto-height="{{!composerCapped}}" fixed="true" adjust-position="true" hold-keyboard="true" disable-default-padding="true" confirm-type="send" confirm-hold="true" bindconfirm="send" cursor-spacing="16" placeholder="{{sendAttempt?'请先核对上条消息':'输入你的问题…'}}" placeholder-class="support-input__placeholder" disabled="{{sending||sendAttempt}}"/>
      <view class="support-composer__tools">
        <button wx:if="{{!closedRights}}" class="support-tool {{sending || sendAttempt || uploadBusy ? 'control--disabled' : ''}}" bindtap="openImageSheet" disabled="{{sending || sendAttempt || uploadBusy}}" aria-label="添加图片或拍照"><image src="/assets/icons/composer-image-plum.svg"/></button>
        <button wx:if="{{!closedRights}}" class="support-tool {{sending || sendAttempt || uploadBusy ? 'control--disabled' : ''}}" bindtap="openAttachmentSheet" disabled="{{sending || sendAttempt || uploadBusy}}" aria-label="关联订单附件"><image src="/assets/icons/composer-paperclip-plum.svg"/></button>
        <button class="support-tool support-tool--send {{!composerSendEnabled || sending || sendAttempt || uploadBusy ? 'control--disabled' : ''}} {{composerSendEnabled && !sending && !sendAttempt && !uploadBusy ? 'support-tool--send-active' : 'support-tool--send-disabled'}}" bindtap="send" disabled="{{!composerSendEnabled || sending || sendAttempt || uploadBusy}}" aria-label="{{sending ? '正在发送消息' : sendAttempt ? '请先核对上条消息' : '发送消息'}}"><image src="{{composerSendEnabled && !sending && !sendAttempt && !uploadBusy ? '/assets/icons/composer-send-white.svg' : '/assets/icons/composer-send-muted.svg'}}"/></button>
      </view>
    </view>
    <button wx:if="{{!closedRights && conversation && conversation.status === 'ai_active'}}" class="support-human {{handoffBusy ? 'control--disabled' : ''}}" bindtap="requestHuman" disabled="{{handoffBusy}}">需要真人帮助</button>
  </view>

  <view wx:if="{{attachmentSheetOpen}}" class="support-sheet-mask" catchtap="closeAttachmentSheet" catchtouchmove="stopPropagation">
    <view class="support-sheet" catchtap="stopPropagation"><view class="support-sheet__handle"></view><strong class="support-sheet__title">{{attachmentSheetMode === 'image' ? '添加图片' : '关联附件'}}</strong><text class="support-sheet__note">{{attachmentSheetMode === 'image' ? '选择图片后可先预览，再决定是否发送。' : '选择要咨询的订单。'}}</text><view class="support-sheet__options {{attachmentSheetMode === 'attachment' ? 'support-sheet__options--single' : ''}}">
      <block wx:if="{{attachmentSheetMode === 'image'}}"><button data-source="album" bindtap="chooseImage"><image src="/assets/icons/composer-image-plum.svg"/><text>从相册选择</text></button><button data-source="camera" bindtap="chooseImage"><image src="/assets/icons/camera-plum.svg"/><text>拍照</text></button></block>
      <button wx:else bindtap="openOrderPicker"><image src="/assets/icons/package-plum.svg"/><text>选择订单</text></button>
    </view><button class="support-sheet__cancel" bindtap="closeAttachmentSheet">取消</button></view>
  </view>

  <view wx:if="{{orderPickerOpen}}" class="support-sheet-mask" catchtap="closeOrderPicker" catchtouchmove="stopPropagation">
    <view class="support-sheet support-order-picker" catchtap="stopPropagation"><view class="support-sheet__handle"></view><strong class="support-sheet__title">选择订单</strong><text class="support-sheet__note">请选择要咨询的订单。</text>
      <view wx:if="{{orderPickerLoading}}" class="support-picker-state">正在同步订单…</view><view wx:elif="{{orderPickerError}}" class="support-picker-state support-picker-state--error">{{orderPickerError}}</view><view wx:elif="{{!orderChoices.length}}" class="support-picker-state">还没有可选择的订单</view>
      <scroll-view wx:else class="support-order-list" scroll-y><button wx:for="{{orderChoices}}" wx:key="id" class="support-order-choice" data-id="{{item.id}}" bindtap="selectOrder"><image class="support-order-choice__image" src="{{item.productImage || '/assets/icons/package-plum.svg'}}" mode="aspectFill"/><view class="support-order-choice__content"><small class="support-order-choice__tail">订单尾号 {{item.orderNumberTail}}</small><strong class="support-order-choice__name">{{item.productName}}</strong><text class="support-order-choice__status">{{item.statusLabel}} · ¥{{item.totalYuan}}</text></view><image class="support-order-choice__arrow" src="/assets/icons/caret-right-muted.svg"/></button></scroll-view>
      <button class="support-sheet__cancel" bindtap="closeOrderPicker">取消</button>
    </view>
  </view>
</view>
