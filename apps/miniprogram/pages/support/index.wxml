<page-meta root-font-size="system"/>
<view capture-bind:tap="dismissNativeKeyboardOnTap" class="support-shell" style="{{chromeStyle}}">
  <view class="topbar support-topbar">
    <button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button>
    <view class="support-title">
      <text class="topbar__title">{{closedRights?'历史订单客服':aftersaleView?'售后对话':'CISME 客服'}}</text>
      <view class="support-presence support-presence--{{aftersaleView && aftersale.refundCompleted ? 'resolved' : statusTone}}">
        <view wx:if="{{!consultationView && !(aftersaleView && aftersale.refundCompleted) && conversation.status === 'human_active' && identityAgentKey}}" class="support-handler-avatar-wrap"><view class="support-handler-avatar {{agentAvatar !== '/assets/icons/user-circle-plum.svg' ? 'support-handler-avatar--photo' : ''}}"><image src="{{agentAvatar}}" data-key="{{identityAgentKey}}" mode="aspectFill" binderror="onAvatarError" aria-hidden="true"/></view><identity-badge wx:if="{{agentBadge}}" kind="{{agentBadge}}" size="{{18}}"/></view>
        <text wx:else class="support-presence__dot" aria-hidden="true">●</text>
        <text class="support-presence__label">{{aftersaleView && aftersale.refundCompleted ? '已办结' : !consultationView && conversation.status === 'human_active' && agentDisplayName ? agentDisplayName + ' · 接待中' : statusLabel}}</text>
      </view>
    </view>
  </view>

  <view class="support-chat-layout {{keyboardHeight ? 'support-chat-layout--with-keyboard' : ''}} {{aftersaleView && aftersale.refundCompleted ? 'support-chat-layout--archive' : ''}}" style="{{keyboardHeight ? 'bottom:' + keyboardHeight + 'px' : ''}}">
  <button wx:if="{{consultationView && aftersale.active}}" class="support-case-resume {{sending || sendAttempt || uploadBusy || newTopicBusy || newTopicAttempt ? 'control--disabled' : ''}}" bindtap="resumeAftersale"
    hover-class="support-text-action--pressed" disabled="{{sending || sendAttempt || uploadBusy || newTopicBusy || newTopicAttempt}}"
    aria-label="返回订单尾号 {{aftersale.orderNumberTail}} 的售后对话">
    <image class="support-case-resume__icon" src="/assets/icons/package-plum.svg" aria-hidden="true"/>
    <view class="support-case-resume__copy">
      <text class="support-case-resume__title">售后处理中</text>
      <text class="support-case-resume__order">{{aftersale.productName ? aftersale.productName + ' · ' : ''}}尾号 {{aftersale.orderNumberTail}}</text>
    </view>
    <image class="support-case-resume__arrow" src="/assets/icons/caret-right-muted.svg" aria-hidden="true"/>
  </button>
  <view class="support-chat-history" bindtap="dismissComposerKeyboard">
  <scroll-view class="support-thread" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{anchor}}" bindscroll="onThreadScroll" bindscrolltolower="onThreadBottom" lower-threshold="36">
    <view class="support-thread__content">
    <view wx:if="{{loading}}" class="support-state" aria-live="polite">正在加载聊天记录…</view>
    <button wx:if="{{!loading && olderCursor !== null}}" class="text-button {{loadingOlder ? 'text-button--disabled' : ''}}" bindtap="loadOlder" disabled="{{loadingOlder}}" loading="{{loadingOlder}}">查看更早消息</button>
    <view wx:if="{{historyLoaded && historyStartLoaded && !closedRights && !aftersaleView}}" class="support-message support-message--{{supportAiAvailable ? 'ai' : 'admin'}} support-message--group-start support-welcome-message">
      <view class="support-avatar-slot"><view class="support-avatar support-avatar--{{supportAiAvailable ? 'ai' : 'human'}}"><image src="{{supportAiAvailable ? '/assets/cisme/cisme-ai-avatar-v1.png' : '/assets/icons/chat-circle-plum.svg'}}" mode="aspectFit" aria-hidden="true"/></view></view>
      <view class="support-message__content"><text class="support-message__sender">{{supportAiAvailable ? 'CISME AI 客服' : 'CISME 客服'}}</text><view class="support-bubble">{{supportAiAvailable ? '可以问我护理和小程序使用问题。' : '请留下你要咨询的问题。'}}</view></view>
    </view>

    <view wx:if="{{!closedRights && !consultationView && !(aftersaleView && aftersale.refundCompleted) && conversation && conversation.status === 'waiting_human'}}" class="support-queue-notice">人工客服 09:00–22:00（北京时间）</view>

    <block wx:for="{{messages}}" wx:key="id">
      <view wx:if="{{item.timeSeparatorLabel}}" class="support-time-separator"><text>{{item.timeSeparatorLabel}}</text></view>
      <view wx:if="{{item.senderType === 'system'}}" id="support-{{item.sequence}}" class="support-system">
        <button wx:if="{{item.aftersaleCard}}" class="support-aftersale-card" data-id="{{item.aftersaleCard.id}}" bindtap="openAftersaleCase">
          <view class="support-aftersale-card__head"><strong>{{item.aftersaleCard.refundCompleted?'售后已办结':item.aftersaleCard.kind==='refund_only'?'退款申请':'退货退款申请'}}</strong><text>订单尾号 {{item.aftersaleCard.orderNumberTail}}</text></view>
          <view wx:for="{{item.aftersaleCard.lines}}" wx:for-item="line" wx:key="lineId" class="support-aftersale-card__line"><text class="support-aftersale-card__product">{{line.productName}}</text><text class="support-aftersale-card__quantity">{{line.skuLabel ? line.skuLabel + ' · ' : ''}}{{line.quantity}} 件</text></view>
          <text wx:if="{{item.aftersaleCard.moreLines}}" class="support-aftersale-card__more">另 {{item.aftersaleCard.moreLines}} 项</text>
          <view class="support-aftersale-card__foot"><strong>¥{{item.aftersaleCard.amountLabel}}</strong><text>{{item.aftersaleCard.refundCompleted?'查看售后':'查看进度'}}</text><image src="/assets/icons/caret-right-muted.svg" aria-hidden="true"/></view>
        </button>
        <text wx:elif="{{!item.returnInstruction}}" class="support-system__notice">{{item.displayBody}}</text>
        <view wx:if="{{item.returnInstruction}}" class="return-card">
          <view class="return-card__header">
            <text class="return-card__title">退货指引</text>
            <text class="return-card__version">第 {{item.returnInstruction.version}} 版</text>
          </view>
          <view wx:if="{{expandedReturnMessageId === item.id}}" class="return-card__body">
            <text>{{item.returnInstruction.recipientName}} · {{item.returnInstruction.phone}}</text>
            <text>{{item.returnInstruction.region}} {{item.returnInstruction.address}}</text>
            <text>{{item.returnInstruction.freightPayer==='merchant'?'商家承担退货运费':item.returnInstruction.freightPayer==='member'?'你承担退货运费':'请与客服确认退货运费'}}</text>
            <text wx:if="{{item.returnInstruction.instructions}}">{{item.returnInstruction.instructions}}</text>
          </view>
          <view class="return-card__actions">
            <button wx:if="{{expandedReturnMessageId === item.id}}" class="text-button return-card__action" data-id="{{item.returnInstruction.caseId}}" data-shipment="{{true}}" bindtap="openAftersaleCase"><text class="return-card__action-label">查看当前指引</text></button>
            <button class="text-button return-card__action return-card__toggle" data-id="{{item.id}}" bindtap="toggleReturnInstruction" aria-expanded="{{expandedReturnMessageId === item.id}}" aria-label="{{expandedReturnMessageId === item.id ? '收起退货指引' : '展开退货指引'}}"><text class="return-card__action-label">{{expandedReturnMessageId === item.id ? '收起' : '更多'}}</text></button>
          </view>
        </view>
      </view>
      <view wx:else id="support-{{item.sequence}}" class="support-message support-message--{{item.senderType}} {{item.groupStart ? 'support-message--group-start' : 'support-message--grouped'}}">
        <view class="support-avatar-slot">
          <view wx:if="{{item.groupStart}}" class="support-avatar-wrap"><view class="support-avatar support-avatar--{{item.avatarKind}} {{item.avatarKind === 'ai' || item.avatarPath !== '/assets/icons/user-circle-plum.svg' ? 'support-avatar--photo' : ''}}"><image src="{{item.avatarKind === 'ai' ? '/assets/cisme/cisme-ai-avatar-v1.png' : item.avatarPath}}" mode="aspectFill" data-ai="{{item.avatarKind === 'ai'}}" data-key="{{item.sender.key}}" binderror="onAvatarError" aria-label="{{item.senderLabel}}的头像"/></view><identity-badge wx:if="{{item.sender.identityBadge}}" kind="{{item.sender.identityBadge}}" size="{{26}}"/></view>
        </view>
        <view class="support-message__content">
          <text wx:if="{{item.groupStart && item.senderType !== 'user'}}" class="support-message__sender">{{item.senderLabel}}</text>
          <text wx:if="{{item.replyReferenceLabel}}" class="support-reply-reference support-chat-quote">{{item.replyReferenceLabel}}</text>
          <view wx:if="{{item.body}}" class="support-bubble">{{item.body}}</view>
          <button wx:if="{{item.helpLabel}}" class="support-help {{helpNavigating ? 'control--disabled' : ''}}" data-id="{{item.id}}" bindtap="openHelp" disabled="{{helpNavigating}}">{{item.helpLabel}}</button>
          <view wx:if="{{item.attachments.length}}" class="support-media-grid">
            <button wx:for="{{item.attachments}}" wx:for-item="media" wx:key="id" class="support-media" data-media-id="{{media.id}}" bindtap="previewImage" aria-label="预览客服图片">
              <image src="{{media.localPath || '/assets/icons/images-plum.svg'}}" mode="aspectFill" lazy-load="true"/>
              <text wx:if="{{!media.localPath}}">图片加载中</text>
            </button>
          </view>
          <button wx:if="{{item.orderCard}}" class="support-order-card" data-id="{{item.orderCard.orderId}}" bindtap="openOrder" aria-label="查看订单尾号 {{item.orderCard.orderNumberTail}}">
            <image class="support-order-card__image" src="{{item.orderCard.productImage || '/assets/icons/package-plum.svg'}}" mode="aspectFill"/>
            <view class="support-order-card__content"><small>订单 · 尾号 {{item.orderCard.orderNumberTail}}</small><strong>{{item.orderCard.productName}}</strong><text>{{item.orderCard.statusLabel}} · ¥{{item.orderCard.totalYuan}}</text></view>
            <image class="support-order-card__arrow" src="/assets/icons/caret-right-muted.svg"/>
          </button>
          <view wx:if="{{item.groupEnd}}" class="support-message__meta"><text>{{item.timeLabel}}</text><text wx:if="{{item.senderType === 'user' && item.deliveryLabel}}"> · {{item.deliveryLabel}}</text></view>
        </view>
      </view>
    </block>

    <view wx:if="{{pendingMessage}}" class="support-message support-message--user support-message--pending">
      <view class="support-avatar-slot"><view class="support-avatar-wrap"><view class="support-avatar {{ownAvatar !== '/assets/icons/user-circle-plum.svg' ? 'support-avatar--photo' : ''}}"><image src="{{ownAvatar}}" mode="aspectFill" binderror="onAvatarError" aria-label="你的头像"/></view><identity-badge wx:if="{{identityMemberKey ? memberBadge : ownBadge}}" kind="{{identityMemberKey ? memberBadge : ownBadge}}" size="{{26}}"/></view></view>
      <view class="support-message__content">
        <view wx:if="{{pendingMessage.body}}" class="support-bubble">{{pendingMessage.body}}</view>
        <view wx:if="{{pendingMessage.attachments.length}}" class="support-media-grid"><view class="support-media"><image src="{{pendingMessage.attachments[0].localPath}}" mode="aspectFill"/></view></view>
        <view wx:if="{{pendingMessage.orderCard}}" class="support-order-card support-order-card--static"><image class="support-order-card__image" src="{{pendingMessage.orderCard.productImage || '/assets/icons/package-plum.svg'}}" mode="aspectFill"/><view class="support-order-card__content"><small>订单 · 尾号 {{pendingMessage.orderCard.orderNumberTail}}</small><strong>{{pendingMessage.orderCard.productName}}</strong><text>{{pendingMessage.orderCard.statusLabel}} · ¥{{pendingMessage.orderCard.totalYuan}}</text></view></view>
        <view class="support-message__meta support-message__meta--{{pendingMessage.deliveryLabel === '发送失败' ? 'failed' : 'pending'}}"><text>{{pendingMessage.timeLabel}} · {{pendingMessage.deliveryLabel}}</text><button wx:if="{{pendingMessage.deliveryLabel === '发送失败'||pendingMessage.deliveryLabel === '结果待核对'}}" bindtap="retrySend">核对原消息</button></view>
      </view>
    </view>

    <view wx:if="{{aiReplyWaiting || presence.operatorTyping}}" id="support-ai-wait" class="support-typing {{aiReplyWaiting ? 'support-typing--ai' : ''}}" aria-live="polite">
      <view class="support-avatar-wrap"><view class="support-avatar support-avatar--{{aiReplyWaiting ? 'ai' : 'human'}} {{aiReplyWaiting || agentAvatar !== '/assets/icons/user-circle-plum.svg' ? 'support-avatar--photo' : ''}}"><image src="{{aiReplyWaiting ? '/assets/cisme/cisme-ai-avatar-v1.png' : agentAvatar}}" mode="aspectFill" data-ai="{{aiReplyWaiting}}" data-key="{{identityAgentKey}}" binderror="onAvatarError" aria-hidden="true"/></view><identity-badge wx:if="{{!aiReplyWaiting && agentBadge}}" kind="{{agentBadge}}" size="{{26}}"/></view>
      <view class="support-typing__body"><view class="support-typing__dots" aria-hidden="true"><view class="support-typing__dot"></view><view class="support-typing__dot support-typing__dot--two"></view><view class="support-typing__dot support-typing__dot--three"></view></view><text class="support-typing__copy">{{aiReplyWaiting ? '正在思考…' : presence.agentDisplayName + '正在输入…'}}</text></view>
    </view>
    <view wx:if="{{error}}" class="support-error" aria-live="assertive"><text>{{error}}</text><button wx:if="{{errorAction === 'sync'}}" bindtap="retry">重试</button><button wx:elif="{{errorAction === 'handoff'}}" class="{{handoffBusy || newTopicBusy || newTopicAttempt ? 'control--disabled' : ''}}" bindtap="retryHandoff" disabled="{{handoffBusy || newTopicBusy || newTopicAttempt}}">{{handoffFailed ? '重试申请' : '申请人工'}}</button></view>
      <view id="support-chat-end" class="support-thread__end" aria-hidden="true"></view>
    </view>
  </scroll-view>

  <button wx:if="{{newMessagesBelowCount > 0}}" class="new-message" bindtap="jumpToLatest" aria-label="查看 {{newMessagesBelowCount}} 条新消息">↓ {{newMessagesBelowCount}} 条新消息</button>
  </view>

  <view wx:if="{{!aftersaleView || aftersale && !aftersale.refundCompleted}}" class="support-composer">
    <view wx:if="{{!closedRights && !keyboardHeight}}" class="support-composer__actions">
      <button wx:if="{{(!consultationView || aftersale.active === false) && !loading && errorAction !== 'handoff' && (!conversation || conversation.status === 'ai_active' || conversation.status === 'resolved')}}" class="support-human {{handoffBusy || newTopicBusy || newTopicAttempt ? 'control--disabled' : ''}}" hover-class="support-text-action--pressed" bindtap="requestHuman" disabled="{{handoffBusy || newTopicBusy || newTopicAttempt}}"><text>{{handoffBusy ? '正在申请人工…' : '申请人工'}}</text></button>
      <button wx:if="{{newTopicAttempt || historyLoaded && !loading && (aftersale.active || newTopicAvailable && (!conversation || conversation.status === 'ai_active' || conversation.status === 'resolved'))}}" class="support-human support-topic {{newTopicBusy || sending || sendAttempt || uploadBusy || handoffBusy ? 'control--disabled' : ''}}" hover-class="support-text-action--pressed" bindtap="startNewTopic" disabled="{{newTopicBusy || sending || sendAttempt || uploadBusy || handoffBusy}}" aria-label="{{newTopicAttempt ? '重试开启新对话' : '开启新对话'}}"><text>{{newTopicBusy ? '正在开启…' : newTopicAttempt ? '重试新对话' : '新对话'}}</text></button>
    </view>
    <view class="support-composer__surface {{composerFocused ? 'support-composer__surface--focused' : ''}}">
      <view wx:if="{{selectedImage || selectedOrder}}" class="support-draft-attachments">
        <view wx:if="{{selectedImage}}" class="support-draft-media">
          <image class="support-draft__image" src="{{selectedImage.localPath}}" mode="aspectFill"/>
          <view class="support-draft__content"><strong wx:if="{{selectedImage.status === 'failed'}}">图片上传失败</strong><strong wx:elif="{{selectedImage.status === 'uploading'}}">{{selectedImage.uploadPhase === 'confirming' ? '正在确认' : selectedImage.uploadPhase === 'assembling' ? '正在整理' : selectedImage.progressKnown ? '上传 ' + selectedImage.progress + '%' : '正在上传'}}</strong><text wx:if="{{selectedImage.status === 'failed'}}">{{selectedImage.error}}</text></view>
          <button wx:if="{{selectedImage.status === 'failed'}}" bindtap="retryImageUpload">重传</button><button bindtap="removeImage" aria-label="移除图片"><image class="support-draft__remove-icon" src="/assets/icons/close-plum.svg" mode="aspectFit"/></button>
        </view>
        <view wx:if="{{selectedOrder}}" class="support-draft-order"><image class="support-draft__image" src="{{selectedOrder.productImage || '/assets/icons/package-plum.svg'}}" mode="aspectFill"/><view class="support-draft__content"><strong>{{selectedOrder.productName}}</strong><text>订单尾号 {{selectedOrder.orderNumberTail}} · {{selectedOrder.statusLabel}}</text></view><button wx:if="{{!closedRights}}" bindtap="removeOrder" aria-label="移除订单"><image class="support-draft__remove-icon" src="/assets/icons/close-plum.svg" mode="aspectFit"/></button></view>
      </view>
      <view class="support-composer__controls {{composerLineCount > 1 ? 'support-composer__controls--multiline' : ''}}">
        <textarea data-keyboard-field="input" hold-keyboard="{{false}}" show-confirm-bar="{{false}}" confirm-type="return" class="support-input {{composerCapped ? 'support-input--capped' : ''}}" aria-label="客服消息" value="{{input}}" focus="{{composerFocused}}" bindinput="updateInput" bindfocus="onComposerFocus" bindblur="onComposerBlur" bindlinechange="onComposerLineChange" bindkeyboardheightchange="onKeyboardHeightChange" maxlength="4000" auto-height="{{!composerCapped}}" fixed="true" adjust-position="{{false}}" disable-default-padding="true" placeholder="{{newTopicAttempt?'请先确认新对话':sendAttempt?'请先核对上条消息':'输入消息'}}" placeholder-class="support-input__placeholder" disabled="{{sending||sendAttempt||newTopicBusy||newTopicAttempt}}"/>
        <view class="support-composer__tools">
        <button wx:if="{{!closedRights}}" class="support-tool {{sending || sendAttempt || uploadBusy || newTopicBusy || newTopicAttempt ? 'control--disabled' : ''}}" bindtap="openAttachmentSheet" disabled="{{sending || sendAttempt || uploadBusy || newTopicBusy || newTopicAttempt}}" aria-label="添加附件"><image src="/assets/icons/composer-paperclip-plum.svg"/></button>
        <button class="support-tool support-tool--send {{!composerSendEnabled || sending || sendAttempt || uploadBusy || newTopicBusy || newTopicAttempt ? 'control--disabled' : ''}} {{composerSendEnabled && !sending && !sendAttempt && !uploadBusy && !newTopicBusy && !newTopicAttempt ? 'support-tool--send-active' : 'support-tool--send-disabled'}}" bindtap="send" disabled="{{!composerSendEnabled || sending || sendAttempt || uploadBusy || newTopicBusy || newTopicAttempt}}" aria-label="{{sending ? '正在发送消息' : sendAttempt ? '请先核对上条消息' : '发送消息'}}"><image src="{{composerSendEnabled && !sending && !sendAttempt && !uploadBusy && !newTopicBusy && !newTopicAttempt ? '/assets/icons/composer-send-white.svg' : '/assets/icons/composer-send-muted.svg'}}"/></button>
        </view>
      </view>
    </view>
  </view>
  </view>

  <view wx:if="{{attachmentSheetOpen}}" class="support-sheet-mask" catchtap="closeAttachmentSheet" catchtouchmove="stopPropagation">
    <view class="support-sheet" catchtap="stopPropagation"><view class="support-sheet__handle"></view><strong class="support-sheet__title">添加附件</strong><view class="support-sheet__options">
      <button data-source="album" bindtap="chooseImage"><image src="/assets/icons/composer-image-plum.svg"/><text>相册</text></button>
      <button data-source="camera" bindtap="chooseImage"><image src="/assets/icons/camera-plum.svg"/><text>拍照</text></button>
      <button wx:if="{{!aftersaleView}}" bindtap="openOrderPicker"><image src="/assets/icons/package-plum.svg"/><text>订单</text></button>
    </view><button class="support-sheet__cancel" bindtap="closeAttachmentSheet">取消</button></view>
  </view>

  <view wx:if="{{orderPickerOpen}}" class="support-sheet-mask" catchtap="closeOrderPicker" catchtouchmove="stopPropagation">
    <view class="support-sheet support-order-picker" catchtap="stopPropagation"><view class="support-sheet__handle"></view><strong class="support-sheet__title">选择订单</strong>
      <view wx:if="{{orderPickerLoading}}" class="support-picker-state">正在加载订单…</view><view wx:elif="{{!orderChoices.length && !orderPickerError}}" class="support-picker-state">暂无可选择的订单</view>
      <scroll-view wx:if="{{orderChoices.length}}" class="support-order-list" scroll-y enhanced show-scrollbar="{{false}}"><button wx:for="{{orderChoices}}" wx:key="id" class="support-order-choice" data-id="{{item.id}}" bindtap="selectOrder"><image class="support-order-choice__image" src="{{item.productImage || '/assets/icons/package-plum.svg'}}" mode="aspectFill"/><view class="support-order-choice__content"><small class="support-order-choice__tail">订单尾号 {{item.orderNumberTail}}</small><strong class="support-order-choice__name">{{item.productName}}</strong><text class="support-order-choice__status">{{item.statusLabel}} · ¥{{item.totalYuan}}</text></view><image class="support-order-choice__arrow" src="/assets/icons/caret-right-muted.svg"/></button><view wx:if="{{orderPickerError}}" class="support-picker-state support-picker-state--error">{{orderPickerError}}</view><button wx:if="{{orderPickerNextCursor}}" class="support-order-more {{orderPickerMoreBusy ? 'text-button--disabled' : ''}}" bindtap="loadMoreOrders" loading="{{orderPickerMoreBusy}}" disabled="{{orderPickerMoreBusy}}">{{orderPickerMoreBusy ? '正在加载…' : '查看更多订单'}}</button></scroll-view>
      <view wx:if="{{!orderChoices.length && orderPickerError}}" class="support-picker-state support-picker-state--error">{{orderPickerError}}<button class="support-order-more" bindtap="openOrderPicker">重试</button></view>
      <button class="support-sheet__cancel" bindtap="closeOrderPicker">取消</button>
    </view>
  </view>
</view>
