<view class="support-shell" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><view class="support-title"><text class="topbar__title">CISME 客服</text><small>{{statusLabel}}</small></view></view>
<scroll-view class="support-thread" style="{{threadBottomStyle}}" scroll-y enhanced show-scrollbar="false" scroll-into-view="{{anchor}}" bindscroll="onThreadScroll" bindscrolltolower="onThreadBottom" lower-threshold="36">
 <view wx:if="{{loading}}" class="support-state" aria-live="polite">正在同步会话…</view>
 <button wx:if="{{!loading && olderCursor !== null}}" class="text-button {{loadingOlder ? 'text-button--disabled' : ''}}" bindtap="loadOlder" disabled="{{loadingOlder}}" loading="{{loadingOlder}}">查看更早消息</button>
 <view wx:if="{{!loading && !messages.length}}" class="support-welcome"><image src="/assets/icons/chat-circle-plum.svg"/><strong>你好，这里是 CISME 客服</strong><text>可以直接描述护理、账号或服务问题。当前默认由人工处理；AI 回复未接入时不会冒充真人。</text></view>
 <view wx:for="{{messages}}" wx:key="id" id="support-{{item.sequence}}" class="support-message support-message--{{item.senderType}}"><text class="support-message__sender">{{item.senderLabel}}</text><view class="support-bubble">{{item.body}}</view></view>
 <view wx:if="{{error}}" class="support-error" aria-live="assertive"><text>{{error}}</text><button bindtap="retry">重试同步</button></view><view class="support-thread__end"></view>
</scroll-view>
<button wx:if="{{newMessagesBelow}}" class="new-message" style="{{newMessageBottomStyle}}" bindtap="jumpToLatest" aria-label="查看新消息">有新消息</button>
<view class="support-composer"><button class="support-plus control--disabled" disabled aria-label="附件将在后续版本开放">＋</button><textarea value="{{input}}" bindinput="updateInput" bindlinechange="onComposerLineChange" maxlength="4000" auto-height confirm-type="send" bindconfirm="send" placeholder="输入你的问题"/><button class="support-send {{!input || sending ? 'control--disabled' : ''}}" bindtap="send" disabled="{{!input || sending}}" loading="{{sending}}">发送</button><button wx:if="{{conversation && conversation.status !== 'human_active'}}" class="support-human {{handoffBusy ? 'control--disabled' : ''}}" bindtap="requestHuman" disabled="{{handoffBusy}}">转人工</button></view></view>
