.support-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at 8% 12%, rgba(238, 228, 242, .72), transparent 34%),
    #f7f2f8;
}

.support-topbar {
  background: rgba(248, 244, 249, .94);
}

.support-title {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 0;
  line-height: 1;
}

.support-title .topbar__title {
  font-size: 17px;
}

.support-presence {
  display: flex;
  align-items: center;
  max-width: 360rpx;
  margin-top: 5rpx;
  color: #75697a;
  font-size: 20rpx;
  line-height: 1.15;
}

.support-presence__label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.support-presence__dot {
  flex: none;
  margin-right: 8rpx;
  color: #876998;
  font-size: 20rpx;
}

.support-presence--online .support-presence__dot {
  color: #2f7d5a;
}

.support-presence--waiting .support-presence__dot {
  color: #a66518;
}

.support-presence--resolved .support-presence__dot {
  color: #8b858e;
}

.support-thread {
  position: fixed;
  top: var(--cisme-topbar-height, calc(env(safe-area-inset-top) + 44px));
  right: 3rpx;
  bottom: calc(env(safe-area-inset-bottom) + 132rpx);
  left: 0;
  width: auto;
}

.support-thread__content {
  padding: 24rpx 23rpx 10rpx 26rpx;
}

.support-thread__end {
  height: 30rpx;
}

.support-state,
.support-picker-state {
  padding: 34rpx 24rpx;
  color: #75697a;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.text-button {
  width: 100%;
  min-height: 44px;
  padding: 0;
  color: #745b80;
  background: transparent;
  font-size: 23rpx;
}

.text-button--disabled {
  opacity: .48;
}

.support-welcome {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin: 60rpx 18rpx 34rpx;
  padding: 46rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, .92);
  border-radius: 36rpx;
  background: rgba(255, 252, 255, .76);
  box-shadow: 0 18rpx 48rpx rgba(53, 35, 64, .07);
}

.support-welcome image {
  width: 66rpx;
  height: 66rpx;
}

.support-welcome strong {
  margin-top: 22rpx;
  color: #352a3a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 400;
}

.support-welcome text {
  max-width: 540rpx;
  margin-top: 14rpx;
  color: #75697a;
  font-size: 24rpx;
  line-height: 1.65;
  text-align: center;
}

.support-time-separator {
  display: flex;
  justify-content: center;
  margin: 30rpx 0 22rpx;
}

.support-time-separator text {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #85798a;
  background: rgba(238, 228, 242, .66);
  font-size: 20rpx;
  line-height: 1.25;
}

.support-system {
  display: flex;
  justify-content: center;
  width: 100%;
  margin: 28rpx 0;
}

.support-system text {
  max-width: 580rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #6d6271;
  background: rgba(231, 224, 234, .84);
  font-size: 21rpx;
  line-height: 1.45;
  text-align: center;
}

.support-message {
  display: flex;
  align-items: flex-start;
  width: 100%;
  min-width: 0;
  margin-top: 10rpx;
}

.support-message--group-start {
  margin-top: 26rpx;
}

.support-message--user {
  justify-content: flex-end;
}

.support-avatar-slot {
  flex: none;
  width: 82rpx;
  min-height: 68rpx;
  margin-right: 12rpx;
}

.support-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  overflow: hidden;
  border: 1rpx solid rgba(86, 48, 111, .1);
  border-radius: 50%;
  background: #fffaff;
  box-shadow: 0 7rpx 16rpx rgba(62, 39, 76, .08);
}

.support-avatar image {
  width: 34rpx;
  height: 34rpx;
}

.support-avatar--ai {
  background: #eee4f2;
}

.support-avatar--human {
  background: #fff;
}

.support-message__content {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  min-width: 0;
  max-width: 74%;
}

.support-message--user .support-message__content {
  align-items: flex-end;
}

.support-message__sender {
  margin: 0 10rpx 8rpx;
  color: #75697a;
  font-size: 20rpx;
  line-height: 1.25;
}

.support-bubble {
  max-width: 100%;
  padding: 19rpx 23rpx;
  border: 1rpx solid rgba(78, 47, 91, .08);
  border-radius: 8rpx 27rpx 27rpx;
  color: #3f3444;
  background: #fff;
  font-size: 28rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
  word-break: break-word;
  box-shadow: 0 8rpx 22rpx rgba(53, 35, 64, .055);
}

.support-message--ai .support-bubble {
  border-color: rgba(86, 48, 111, .07);
  background: #f0e7f3;
  box-shadow: none;
}

.support-message--user .support-bubble {
  border-color: #56306f;
  border-radius: 27rpx 8rpx 27rpx 27rpx;
  color: #fff;
  background: #56306f;
}

.support-message__meta {
  display: flex;
  align-items: center;
  min-height: 28rpx;
  margin: 7rpx 9rpx 0;
  color: #8b808e;
  font-size: 20rpx;
  line-height: 1.25;
}

.support-message__meta--pending {
  color: #786b7d;
}

.support-message__meta--failed {
  color: #9a3151;
}

.support-message__meta button {
  min-width: 44px;
  min-height: 36px;
  margin-left: 8rpx;
  padding: 0 10rpx;
  color: #8d3150;
  background: transparent;
  font-size: 21rpx;
}

.support-message--pending {
  opacity: .92;
}

.support-media-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
  width: 100%;
  margin-top: 8rpx;
}

.support-media {
  position: relative;
  width: 248rpx;
  height: 204rpx;
  min-height: 0;
  padding: 0;
  overflow: hidden;
  border: 1rpx solid rgba(86, 48, 111, .1);
  border-radius: 24rpx;
  background: #eee7f0;
}

.support-media image {
  width: 100%;
  height: 100%;
}

.support-media text {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 12rpx;
  color: #6d6271;
  background: rgba(255, 252, 255, .88);
  font-size: 20rpx;
}

.support-order-card,
.support-order-card--static {
  display: grid;
  grid-template-columns: 82rpx minmax(0, 1fr) 28rpx;
  align-items: center;
  gap: 16rpx;
  width: 500rpx;
  max-width: 100%;
  min-height: 116rpx;
  margin-top: 8rpx;
  padding: 15rpx;
  border: 1rpx solid rgba(78, 47, 91, .11);
  border-radius: 24rpx;
  color: #352a3a;
  background: #fffafd;
  text-align: left;
  box-shadow: 0 8rpx 22rpx rgba(53, 35, 64, .05);
}

.support-order-card--static {
  grid-template-columns: 82rpx minmax(0, 1fr);
}

.support-order-card__image {
  width: 82rpx;
  height: 82rpx;
  border-radius: 18rpx;
  background: #eee4f2;
}

.support-order-card__content {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.support-order-card small,
.support-order-card--static small {
  color: #75697a;
  font-size: 20rpx;
}

.support-order-card strong,
.support-order-card--static strong {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.support-order-card text,
.support-order-card--static text {
  margin-top: 5rpx;
  color: #6e6073;
  font-size: 20rpx;
}

.support-order-card__arrow {
  width: 24rpx;
  height: 24rpx;
}

.support-typing {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.support-typing__body {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  margin-left: 14rpx;
}

.support-typing__copy {
  margin-top: 7rpx;
  color: #75697a;
  font-size: 20rpx;
}

.support-typing__dots {
  display: flex;
  align-items: center;
  gap: 7rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 8rpx 24rpx 24rpx;
  background: #fff;
}

.support-typing__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #8e759c;
  animation: support-typing 720ms ease-in-out infinite alternate;
}

.support-typing__dot--two {
  animation-delay: 120ms;
}

.support-typing__dot--three {
  animation-delay: 240ms;
}

@keyframes support-typing {
  from { opacity: .38; transform: translateY(2rpx); }
  to { opacity: 1; transform: translateY(-3rpx); }
}

.support-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 24rpx 8rpx;
  padding: 16rpx 18rpx 16rpx 22rpx;
  border: 1rpx solid rgba(141, 49, 80, .12);
  border-radius: 22rpx;
  color: #8d3150;
  background: #f8e8ed;
  font-size: 22rpx;
  line-height: 1.5;
}

.support-error text {
  flex: 1;
}

.support-error button {
  flex: none;
  min-height: 40px;
  padding: 0 16rpx;
  color: #8d3150;
  background: transparent;
  font-size: 22rpx;
}

.new-message {
  position: fixed;
  z-index: 31;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 154rpx);
  min-height: 44px;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, .35);
  border-radius: 999rpx;
  color: #fff;
  background: #56306f;
  font-size: 23rpx;
  box-shadow: 0 10rpx 26rpx rgba(58, 31, 77, .2);
}

.support-composer {
  position: fixed;
  z-index: 30;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 14rpx 20rpx calc(env(safe-area-inset-bottom) + 14rpx);
  border-top: 1rpx solid rgba(78, 47, 91, .1);
  background: rgba(250, 247, 251, .97);
  box-shadow: 0 -12rpx 34rpx rgba(55, 34, 67, .055);
  -webkit-backdrop-filter: blur(20rpx);
}

.support-composer--focused {
  background: rgba(255, 252, 255, .985);
}

.support-composer__surface {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(78, 47, 91, .13);
  border-radius: 30rpx;
  background: #fff;
  transition: border-color 180ms ease, box-shadow 180ms ease;
}

.support-composer__surface--focused {
  border-color: rgba(86, 48, 111, .44);
  box-shadow: 0 0 0 4rpx rgba(86, 48, 111, .075);
}

.support-input {
  display: block;
  width: 100%;
  min-height: 224rpx;
  max-height: 344rpx;
  padding: 22rpx 22rpx 104rpx;
  overflow-y: auto;
  border: 0;
  color: #352a3a;
  background: transparent;
  font-size: 28rpx;
  line-height: 40rpx;
}

.support-input--capped {
  height: 344rpx;
}

.support-input__placeholder {
  color: var(--cisme-muted);
  font-size: 28rpx;
  font-weight: 400;
}

.support-composer__tools {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.support-tool {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  transition: opacity 120ms ease, transform 120ms ease, background-color 160ms ease;
}

.support-tool image {
  width: 22px;
  height: 22px;
}

.support-tool:active {
  background: #f1e9f3;
  transform: scale(.96);
}

.support-tool--disabled {
  opacity: .38;
}

.support-tool--send {
  margin-left: 4rpx;
}

.support-tool--send-active {
  background: #56306f;
  box-shadow: 0 6rpx 16rpx rgba(70, 38, 91, .18);
}

.support-tool--send-active:active {
  background: #432458;
}

.support-tool--send-disabled {
  background: #eee8f0;
}

.control--disabled {
  opacity: .42;
}

.support-human {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-height: 44px;
  margin: 3rpx 8rpx -8rpx;
  padding: 0;
  color: #72557f;
  background: transparent;
  font-size: 21rpx;
}

.support-draft-attachments {
  display: grid;
  gap: 10rpx;
  margin: 12rpx 12rpx 0;
}

.support-draft-media,
.support-draft-order {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 13rpx;
  padding: 11rpx 12rpx;
  border: 1rpx solid rgba(78, 47, 91, .09);
  border-radius: 22rpx;
  background: #fbf7fc;
}

.support-draft-order {
  grid-template-columns: 76rpx minmax(0, 1fr) auto;
}

.support-draft__image {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: #eee4f2;
}

.support-draft__content {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.support-draft-media strong,
.support-draft-order strong {
  overflow: hidden;
  color: #49384f;
  font-size: 23rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.support-draft-media text,
.support-draft-order text {
  margin-top: 4rpx;
  color: #75697a;
  font-size: 20rpx;
  line-height: 1.35;
}

.support-draft-media button,
.support-draft-order button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: var(--cisme-hit-target);
  min-height: var(--cisme-hit-target);
  padding: 0 12rpx;
  color: #72557f;
  background: #f1e9f3;
  font-size: 21rpx;
}

.support-sheet-mask {
  position: fixed;
  z-index: 80;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(35, 24, 39, .32);
  animation: support-mask-in 220ms ease-out both;
}

.support-sheet {
  width: 100%;
  padding: 18rpx 26rpx calc(env(safe-area-inset-bottom) + 24rpx);
  border-radius: 34rpx 34rpx 0 0;
  background: #fffcff;
  box-shadow: 0 -20rpx 60rpx rgba(48, 29, 57, .16);
  animation: support-sheet-in 220ms cubic-bezier(.2, .8, .2, 1) both;
}

@keyframes support-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes support-sheet-in {
  from { opacity: .6; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.support-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 8rpx;
  background: #d9cedd;
}

.support-sheet__title {
  display: block;
  color: #352a3a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 400;
}

.support-sheet__note {
  display: block;
  margin-top: 8rpx;
  color: #75697a;
  font-size: 22rpx;
  line-height: 1.5;
}

.support-sheet__options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 26rpx;
}

.support-sheet__options--single {
  grid-template-columns: minmax(0, 1fr);
}

.support-sheet__options button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 132rpx;
  border-radius: 24rpx;
  color: #56306f;
  background: #f2eaf4;
  font-size: 22rpx;
}

.support-sheet__options image {
  width: 38rpx;
  height: 38rpx;
  margin-bottom: 12rpx;
}

.support-sheet__cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 50px;
  margin-top: 18rpx;
  border-radius: 22rpx;
  color: #625668;
  background: #f4eff5;
  line-height: 1.25;
}

.support-order-picker {
  max-height: 78vh;
}

.support-order-list {
  max-height: 50vh;
  margin-top: 20rpx;
}

.support-order-choice {
  display: grid;
  grid-template-columns: 82rpx minmax(0, 1fr) 26rpx;
  align-items: center;
  gap: 15rpx;
  width: 100%;
  min-height: 120rpx;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid rgba(78, 47, 91, .09);
  color: #352a3a;
  background: transparent;
  text-align: left;
}

.support-order-choice__image {
  width: 82rpx;
  height: 82rpx;
  border-radius: 17rpx;
  background: #eee4f2;
}

.support-order-choice__content {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.support-order-choice__tail {
  color: #75697a;
  font-size: 20rpx;
}

.support-order-choice__name {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.support-order-choice__status {
  margin-top: 4rpx;
  color: #75697a;
  font-size: 20rpx;
}

.support-order-choice__arrow {
  width: 24rpx;
  height: 24rpx;
}

.support-picker-state--error {
  color: #8d3150;
}
.return-card{display:flex;flex-direction:column;gap:10rpx;margin-top:14rpx;padding:22rpx;border-radius:20rpx;background:#fff;text-align:left;color:#3f3447;font-size:25rpx;line-height:1.5}
.return-card strong{font-size:27rpx;font-weight:600;color:#56306f}
.return-card__actions{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:10rpx}
.return-card__actions button{min-height:44px;margin:0;padding:0 18rpx;border-radius:22px;background:#efe7f2;color:#56306f;font-size:24rpx}
