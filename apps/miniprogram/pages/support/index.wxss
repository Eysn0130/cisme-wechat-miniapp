.support-shell{min-height:100vh;background:#f7f2f8}.support-title{display:flex;align-items:center;flex-direction:column}.support-title small{margin-top:2rpx;color:#817788;font-size:20rpx}.support-thread{position:fixed;top:var(--cisme-topbar-height,calc(env(safe-area-inset-top) + 44px));right:0;bottom:calc(env(safe-area-inset-bottom) + 132rpx);left:0;padding:24rpx 28rpx}.support-thread__end{height:32rpx}.support-state,.support-welcome{margin:40rpx 20rpx;color:#817788;text-align:center}.support-welcome{display:flex;align-items:center;flex-direction:column;padding:42rpx 34rpx;border-radius:32rpx;background:rgba(255,255,255,.72)}.support-welcome image{width:64rpx;height:64rpx}.support-welcome strong{margin-top:22rpx;color:#3e3144;font-size:30rpx}.support-welcome text{margin-top:12rpx;font-size:24rpx;line-height:1.65}.support-message{display:flex;align-items:flex-start;flex-direction:column;margin:22rpx 0}.support-message--user{align-items:flex-end}.support-message__sender{margin:0 10rpx 7rpx;color:#8b808e;font-size:20rpx}.support-bubble{max-width:78%;padding:20rpx 24rpx;border-radius:8rpx 28rpx 28rpx 28rpx;color:#413646;background:#fff;font-size:28rpx;line-height:1.58;overflow-wrap:anywhere;box-shadow:0 8rpx 22rpx rgba(53,35,64,.06)}.support-message--user .support-bubble{border-radius:28rpx 8rpx 28rpx 28rpx;color:#fff;background:#563b69}.support-message--system{align-items:center}.support-message--system .support-bubble{padding:10rpx 18rpx;border-radius:999rpx;color:#776d7b;background:#ece5ef;font-size:22rpx;box-shadow:none}.support-error{margin:20rpx;padding:18rpx;border-radius:22rpx;color:#8d3150;background:#f8e8ed;text-align:center}.support-error button{margin:12rpx auto 0;color:#56306f;background:transparent;font-size:24rpx}.support-composer{position:fixed;z-index:30;right:0;bottom:0;left:0;display:grid;grid-template-columns:44px minmax(0,1fr) auto;align-items:end;gap:12rpx;padding:16rpx 22rpx calc(env(safe-area-inset-bottom) + 16rpx);border-top:1rpx solid rgba(78,47,91,.1);background:rgba(250,247,251,.97)}.support-composer textarea{width:100%;min-height:44px;max-height:180rpx;padding:19rpx 22rpx;border-radius:25rpx;background:#fff;font-size:28rpx;line-height:1.45}.support-plus,.support-send{height:44px;padding:0;border-radius:22px}.support-plus{color:#8b808e;background:#eee8f0;font-size:36rpx}.support-send{min-width:104rpx;padding:0 22rpx;color:#fff;background:#563b69}.support-human{grid-column:2/4;min-height:30px;height:30px;color:#6f557c;background:transparent;font-size:22rpx;text-align:left}
