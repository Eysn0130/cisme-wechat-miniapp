.story-page{padding-top:var(--cisme-stack-top,calc(env(safe-area-inset-top) + 56px));padding-bottom:calc(var(--cisme-safe-bottom,env(safe-area-inset-bottom)) + 80rpx);background:#f7f2f8}.story-author{display:flex;align-items:center;gap:18rpx;margin:6rpx 0 30rpx}.story-author__avatar{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;border-radius:50%;background:#e8dbea;color:#745880;font-family:Georgia,serif;font-size:34rpx}.story-author__copy{display:flex;flex-direction:column;gap:6rpx}.story-author__name{color:#46374d;font-size:28rpx;font-weight:600}.story-author__date{color:#8b7c8e;font-size:22rpx}.story-title{margin-bottom:20rpx;color:#3d3045;font-family:serif;font-size:40rpx;font-weight:600;line-height:1.35}.story-body{margin-bottom:28rpx;color:#4b4152;font-size:29rpx;line-height:1.75;white-space:pre-wrap;word-break:break-word}.story-media{overflow:hidden;margin:12rpx 0;border-radius:20rpx;background:#ede6ef}.story-media image{display:block;width:100%}.story-media__fallback{display:flex;align-items:center;justify-content:center;min-height:280rpx;color:#796b80;font-size:25rpx}.story-ai{margin-top:18rpx;color:#75687a;font-size:22rpx}.story-actions{display:flex;gap:16rpx;margin:34rpx 0;padding-bottom:26rpx;border-bottom:1rpx solid #e4d9e7}.story-actions button{flex:1;min-height:84rpx;border:1rpx solid #dbcce1;border-radius:16rpx;background:#fff;color:#654b70;font-size:26rpx}.story-section-title{margin:18rpx 0 20rpx;color:#483750;font-size:32rpx;font-weight:600}.story-empty{padding:30rpx 0;color:#7d7182;font-size:25rpx}.story-comment{display:flex;flex-direction:column;gap:8rpx;padding:22rpx 0;border-bottom:1rpx solid #ece4ee}.story-comment__author{color:#6e4f79;font-size:23rpx;font-weight:600}.story-comment__body{color:#4b4051;font-size:27rpx;line-height:1.55;word-break:break-word}.story-comment-box{display:flex;gap:12rpx;margin:30rpx 0}.story-comment-box input{flex:1;height:86rpx;min-width:0;padding:0 22rpx;border:1rpx solid #dfd2e3;border-radius:16rpx;background:#fff;color:#48394f;font-size:26rpx}.story-comment-box button{min-width:106rpx;min-height:86rpx;border-radius:16rpx;background:#6a417a;color:#fff;font-size:26rpx}.story-comment-box .control--disabled{opacity:.52}.story-tools{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:40rpx}.story-tools button{min-height:78rpx;padding:12rpx 22rpx;border:1rpx solid #e0d5e4;border-radius:14rpx;background:#fff;color:#6b5b71;font-size:23rpx}.story-notice{margin-bottom:20rpx;background:#eee5f1;color:#664d72}
.story-author__copy{flex:1;min-width:0}.story-author__name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.story-author__follow{min-width:112rpx;min-height:88rpx;padding:0 18rpx;border:1rpx solid #ccb7d4;border-radius:20rpx;background:#fff;color:#6a417a;font-size:25rpx}.story-author__follow.control--disabled{opacity:.55}
.story-author__profile{flex:1;min-width:0;min-height:88rpx;display:flex;align-items:center;gap:18rpx;padding:0;border:0;background:transparent;text-align:left;color:#46374d}
.story-author__profile.control--disabled{opacity:.55}
