<view class="chrome-root" style="{{chromeStyle}}">
  <view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回社区"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">护理故事</text></view>
  <view class="page page--stack story-page">
    <view wx:if="{{loading}}" class="state" aria-live="polite">正在加载护理故事…</view>
    <view wx:if="{{error}}" class="state state--error" aria-live="assertive"><text>{{error}}</text><button wx:if="{{!postId}}" class="text-button" bindtap="back">返回社区</button><button wx:else class="text-button" bindtap="load">重新加载</button></view>
    <view wx:if="{{notice}}" class="state story-notice" aria-live="polite">{{notice}}</view>
    <block wx:if="{{post}}">
      <view class="story-author"><button class="story-author__profile {{authorNavigating ? 'control--disabled' : ''}}" bindtap="openAuthor" disabled="{{authorNavigating}}" aria-label="查看 {{post.author}} 的公开故事"><image wx:if="{{post.avatar}}" src="{{post.avatar}}" class="story-author__avatar" mode="aspectFill"/><view wx:else class="story-author__avatar story-author__avatar--empty">C</view><view class="story-author__copy"><text class="story-author__name">{{post.author}}</text><text class="story-author__date">查看公开故事</text></view></button><button wx:if="{{!post.isMine}}" class="story-author__follow {{busy ? 'control--disabled' : ''}}" bindtap="toggleFollow" disabled="{{busy}}" aria-label="{{post.following ? '取消关注作者' : '关注作者'}}">{{post.following ? '已关注' : '关注'}}</button></view>
      <view wx:if="{{post.title}}" class="story-title">{{post.title}}</view>
      <view wx:if="{{post.body}}" class="story-body">{{post.body}}</view>
      <view wx:for="{{images}}" wx:key="id" class="story-media"><image wx:if="{{item.src}}" src="{{item.src}}" mode="widthFix" data-src="{{item.src}}" bindtap="previewImage" aria-label="查看第 {{item.index}} 张故事图片"/><view wx:else class="story-media__fallback">图片暂时无法加载</view></view>
      <view wx:if="{{post.aiUsage === 'assisted' || post.aiUsage === 'generated'}}" class="story-ai">{{post.aiUsage === 'generated' ? '含 AI 生成内容' : '含 AI 辅助内容'}}</view>
      <view class="story-actions"><button data-kind="like" class="{{busy ? 'control--disabled' : ''}}" bindtap="toggleReaction" disabled="{{busy}}" aria-label="{{post.liked ? '取消点赞' : '点赞'}}">{{post.liked ? '已赞' : '点赞'}} · {{post.likeCount}}</button><button data-kind="save" class="{{busy ? 'control--disabled' : ''}}" bindtap="toggleReaction" disabled="{{busy}}" aria-label="{{post.saved ? '取消收藏' : '收藏'}}">{{post.saved ? '已收藏' : '收藏'}} · {{post.saveCount}}</button></view>
      <view class="story-section-title">评论 · {{post.commentsTotal}} 条（已加载 {{post.comments.length}}）</view>
      <view wx:if="{{signedIn && (myComments.length || myCommentsError)}}" class="story-own-comments"><text>我的评论状态</text><text wx:if="{{myCommentsError}}">{{myCommentsError}}</text>
        <view wx:for="{{myComments}}" wx:key="id" class="story-own-comment"><text class="story-own-comment__status">{{item.stateLabel}}</text><text>{{item.body || '评论正文已删除'}}</text></view></view>
      <button wx:if="{{signedIn}}" class="text-button story-own-comments-link" bindtap="openMyComments">查看我的全部评论</button>
      <view wx:if="{{!post.comments.length}}" class="story-empty">还没有公开评论，写下你的想法吧。</view>
      <view wx:for="{{post.comments}}" wx:key="id" class="story-comment"><text class="story-comment__author">{{item.author}}</text><text class="story-comment__body">{{item.body}}</text><button class="text-button" data-id="{{item.id}}" bindtap="chooseReply">回复</button></view>
      <button wx:if="{{post.commentsNextCursor}}" class="text-button {{commentsLoadingMore?'control--disabled':''}}" bindtap="loadMoreComments" disabled="{{commentsLoadingMore}}" loading="{{commentsLoadingMore}}">加载更多评论</button><text wx:if="{{commentsError}}" class="state state--error">{{commentsError}}</text>
      <view wx:if="{{replyTo}}" class="story-comment-reply"><text>回复 {{replyTo.author}}</text><button class="text-button" bindtap="cancelReply">取消回复</button></view>
      <view class="story-comment-box"><input value="{{comment}}" bindinput="editComment" maxlength="1000" disabled="{{busy}}" placeholder="{{replyTo?'写下回复':'写下你的想法'}}" aria-label="评论内容"/><button class="{{busy || !comment.length ? 'control--disabled' : ''}}" bindtap="sendComment" disabled="{{busy || !comment.length}}">发送</button></view>
      <view class="story-tools"><button wx:if="{{post.isMine}}" bindtap="editOwn">编辑</button><button wx:if="{{post.isMine}}" bindtap="deleteOwn">删除</button><button wx:else bindtap="blockAuthor">屏蔽作者</button><button bindtap="report">举报内容</button></view>
    </block>
  </view>
</view>
