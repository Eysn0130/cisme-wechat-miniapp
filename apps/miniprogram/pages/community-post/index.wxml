<view class="chrome-root" style="{{chromeStyle}}">
  <view class="topbar"><button class="topbar__back" bindtap="back" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg" mode="aspectFit"/></button><text class="topbar__title">护理故事</text></view>
  <view class="page page--stack"><view wx:if="{{error}}" class="state state--error" aria-live="assertive">{{error}}<button class="text-button" bindtap="open">重新打开</button></view><view wx:else class="page-read-loading" aria-role="status" aria-label="正在打开帖子"><view class="page-read-loading__indicator"/></view></view>
</view>
