.orders-page{background:#f7f2f8}.order-list{display:grid;gap:18rpx;margin-top:28rpx}.order-card{width:100%;padding:24rpx;border:1rpx solid var(--cisme-line);border-radius:28rpx;background:#fff;text-align:left}.order-card__head,.order-card__foot{display:flex;align-items:center;justify-content:space-between}.order-card__head>text{color:var(--cisme-muted);font-size:22rpx}.order-status{padding:7rpx 14rpx;border-radius:999rpx;color:#694a75;background:#efe6f2;font-size:22rpx;font-weight:500}.order-status--cancelled,.order-status--expired{color:#716a74;background:#eee9ef}.order-card__number{margin-top:16rpx;color:var(--cisme-muted);font-size:21rpx;letter-spacing:1rpx}.order-card__summary{display:-webkit-box;overflow:hidden;margin-top:12rpx;color:var(--cisme-ink);font-size:26rpx;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.order-card__foot{margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid var(--cisme-line)}.order-card__foot text{color:var(--cisme-muted);font-size:23rpx}.order-card__foot strong{margin-left:auto;color:var(--cisme-ink);font-size:32rpx;font-weight:500;font-variant-numeric:tabular-nums}.order-card__foot image{width:26rpx;height:26rpx;margin-left:12rpx}
