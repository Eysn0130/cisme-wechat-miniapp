<view class="chrome-root" style="{{chromeStyle}}"><view class="topbar"><button class="topbar__back {{navigating?'control--disabled':''}}" bindtap="back" disabled="{{navigating}}" aria-label="返回"><image class="topbar__back-icon" src="/assets/icons/arrow-left-ink.svg"/></button><text class="topbar__title">我的订单</text></view><view class="page page--stack orders-page"><text class="eyebrow">订单记录</text><view class="page-title">待支付与历史订单</view><text class="subtitle">支付正在开通；这里不会把尚未付款的订单显示为已付款。</text>
<view wx:if="{{loading}}" class="state">正在同步订单…</view><view wx:if="{{error}}" class="state state--error"><text>{{error}}</text><button class="text-button" bindtap="load">重试</button></view>
<view class="order-list"><button wx:for="{{items}}" wx:key="id" class="order-card {{navigating?'control--disabled':''}}" data-id="{{item.id}}" bindtap="open" disabled="{{navigating}}"><view class="order-card__head"><text>{{item.createdLabel}}</text><strong class="order-status order-status--{{item.status}}">{{item.statusLabel}}</strong></view><view class="order-card__number">{{item.orderNumber}}</view><text class="order-card__summary">{{item.summary}}</text><view class="order-card__foot"><text>合计</text><strong>¥{{item.totalYuan}}</strong><image src="/assets/icons/caret-right-muted.svg"/></view></button></view>
<view wx:if="{{!loading&&!error&&!items.length}}" class="glass error-scene"><view class="error-scene__icon"><image class="error-scene__icon-image" src="/assets/icons/receipt-plum.svg"/></view><strong class="error-scene__title">还没有订单</strong><text class="error-scene__copy">当前仅在明确开启的隔离环境创建待支付订单。</text><button class="secondary" bindtap="openShop">浏览商品</button></view>
<button wx:if="{{nextCursor}}" class="secondary {{loadingMore?'secondary--disabled':''}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button></view></view>
