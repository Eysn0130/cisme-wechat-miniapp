@import "../../styles/management-workbench.wxss";
@import "../../styles/read-loading.wxss";
.posts-page{min-height:100vh;background:#f7f3f8}.posts-body{padding:calc(var(--cisme-topbar-height) + 12rpx) 28rpx calc(env(safe-area-inset-bottom) + 40rpx)}
.posts-search{display:flex;align-items:center;gap:12rpx;margin:8rpx 0 14rpx}.posts-search input{flex:1;min-width:0;min-height:44px;box-sizing:border-box;padding:16rpx 20rpx;border-radius:16rpx;background:#ede6f1;color:var(--cisme-ink)}
.posts-search .text-button{flex:none;min-width:44px;padding-right:0}.posts-summary{display:flex;align-items:center;justify-content:space-between;min-height:44px;color:var(--cisme-muted);font-size:12px}.posts-summary .text-button{padding-right:0}
.posts-error{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:12rpx 0;color:var(--cisme-danger);font-size:14px;line-height:1.6}.posts-empty{padding:100rpx 20rpx;color:var(--cisme-muted);text-align:center;font-size:14px}
.post-row{padding:24rpx 0 8rpx;border-bottom:1rpx solid var(--cisme-line)}.post-row__content{display:flex;align-items:flex-start;gap:20rpx;min-height:112rpx}.post-row__cover{flex:none;width:132rpx;height:148rpx;border-radius:12rpx;background:#ede6f1}.post-row__copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:10rpx}
.post-row__title{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;color:var(--cisme-ink);font-size:16px;line-height:1.5;font-weight:600;overflow-wrap:anywhere}.post-row__excerpt{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;color:var(--cisme-muted);font-size:13px;line-height:1.6;overflow-wrap:anywhere}
.post-row__author{display:flex;align-items:center;gap:10rpx;min-height:24px;color:var(--cisme-muted);font-size:12px}.post-row__author image{flex:none;width:36rpx;height:36rpx;border-radius:50%;background:#ede6f1}.post-row__name{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.post-row__date{flex:none;font-size:11px}
.post-row__footer{display:flex;align-items:center;justify-content:space-between;gap:8rpx;min-height:44px}.post-row__stats{flex:none;color:var(--cisme-muted);font-size:11px;font-variant-numeric:tabular-nums}.post-row__actions{display:flex;align-items:center;gap:0;min-width:0}.management-ui .post-row__actions .text-button{padding:10rpx 10rpx;font-size:12px;min-width:44px}.management-ui .post-row__actions .post-row__delete{color:var(--cisme-danger);padding-right:0}
.posts-more{display:flex;align-items:center;justify-content:center;min-height:52px}.posts-skeleton__row{display:flex;gap:20rpx;min-height:210rpx;padding:24rpx 0 8rpx;border-bottom:1rpx solid var(--cisme-line)}.posts-skeleton__image{width:132rpx;height:148rpx;border-radius:12rpx;background:#ece5ef}.posts-skeleton__copy{flex:1;padding-top:8rpx}.posts-skeleton__copy view{height:24rpx;margin-bottom:22rpx;border-radius:4rpx;background:#ece5ef}.posts-skeleton__copy .posts-skeleton__line--short{width:64%}
.post-detail-mask{position:fixed;inset:0;z-index:1200;display:flex;align-items:flex-end;background:rgba(31,19,40,.32)}.post-detail{display:flex;flex-direction:column;width:100%;max-height:82vh;box-sizing:border-box;padding:12rpx 28rpx calc(env(safe-area-inset-bottom) + 12rpx);border-radius:28rpx 28rpx 0 0;background:#fcf9fd;box-shadow:0 -4px 24px rgba(50,28,66,.1)}
.post-detail__head{flex:none;display:flex;align-items:center;justify-content:space-between;min-height:52px;color:var(--cisme-ink);font-size:18px;font-weight:600}.post-detail__scroll{flex:auto;min-height:0;max-height:60vh}.post-detail__body{padding:12rpx 0 28rpx}.post-detail__title{display:block;font-size:20px;line-height:1.5;font-weight:600;overflow-wrap:anywhere}.post-detail__author{display:block;margin:16rpx 0 24rpx;color:var(--cisme-muted);font-size:13px}.post-detail__image{display:block;width:100%;height:320rpx;margin-bottom:24rpx;border-radius:16rpx;background:#ede6f1}.post-detail__text{display:block;white-space:pre-wrap;overflow-wrap:anywhere;font-size:15px;line-height:1.8}.post-detail__state{display:block;margin-top:20rpx;color:var(--cisme-muted);font-size:14px}.post-detail__original{flex:none}
@media(max-width:350px){.post-row__date{display:none}.post-row__cover{width:112rpx;height:136rpx}.management-ui .post-row__actions .text-button{padding-left:6rpx;padding-right:6rpx}.post-row__stats{font-size:11px}}
