.chrome {
  position: fixed;
  z-index: 60;
  right: 0;
  bottom: 0;
  left: 0;
  height: calc(var(--cisme-safe-bottom, env(safe-area-inset-bottom)) + 142px);
  opacity: 1;
  pointer-events: none;
  transform: translate3d(0, 0, 0);
  transition: transform 280ms cubic-bezier(.22, 1, .36, 1), opacity 180ms ease-out;
}
.chrome--hidden {
  opacity: .08;
  transform: translate3d(0, calc(100% + 12px), 0);
}
.bar {
  --bar-solid-background: #f6f4f8;
  position: absolute;
  right: 11px;
  bottom: calc(var(--cisme-safe-bottom, env(safe-area-inset-bottom)) + 1px);
  left: 11px;
  display: flex;
  align-items: center;
  height: 70px;
  padding: 5px;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(255,255,255,.76);
  border-radius: 42px;
  background: var(--bar-solid-background);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.8), inset 0 -1px 0 rgba(69,48,86,.06), 0 6px 24px rgba(35,25,45,.1), 0 1px 3px rgba(35,25,45,.06);
  pointer-events: auto;
}
@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .bar {
    background: linear-gradient(180deg, rgba(255,255,255,.84), rgba(248,247,250,.82));
    -webkit-backdrop-filter: blur(20px) saturate(135%);
    backdrop-filter: blur(20px) saturate(135%);
  }
}
.community-fab {
  position: absolute;
  z-index: 2;
  left: 50%;
  bottom: calc(var(--cisme-safe-bottom, env(safe-area-inset-bottom)) + 50px);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62px;
  height: 62px;
  min-height: 62px;
  margin: 0;
  padding: 0;
  overflow: visible;
  border: 1rpx solid rgba(255,255,255,.94);
  border-radius: 50%;
  background: radial-gradient(circle at 34% 20%, rgba(222,198,240,.98), rgba(107,64,139,.95) 46%, #48275f 84%);
  box-shadow: inset 0 5rpx 15rpx rgba(255,255,255,.78), inset 0 -16rpx 24rpx rgba(35,14,51,.34), 0 16rpx 38rpx rgba(53,31,72,.3), 0 0 0 8rpx rgba(255,255,255,.46);
  opacity: 0;
  pointer-events: none;
  transform: translate3d(-50%, 18px, 0) scale(.58);
  transform-origin: 50% 100%;
  transition: transform 120ms ease-out;
}
.community-fab::after { border: 0; }
.community-fab--visible {
  opacity: 1;
  pointer-events: auto;
  transform: translate3d(-50%, 0, 0) scale(1);
  animation: community-fab-grow 420ms cubic-bezier(.22, .8, .3, 1) backwards;
}
.community-fab--visible:active { transform: translate3d(-50%, 1px, 0) scale(.94); }
.community-fab.control--disabled { opacity: .48; pointer-events: none; }
.community-fab__halo { position:absolute; inset:-9rpx; border:1rpx solid rgba(255,255,255,.5); border-radius:50%; }
.community-fab__icon { position:relative; z-index:1; width:31px; height:31px; }
.community-fab--visible .community-fab__icon {
  animation: community-fab-symbol 240ms cubic-bezier(.22, 1, .36, 1) 80ms backwards;
}
@keyframes community-fab-grow {
  0% { opacity:0; transform:translate3d(-50%, 24px, 0) scale(.24); }
  18% { opacity:1; }
  72% { opacity:1; transform:translate3d(-50%, -1px, 0) scale(1.025); }
  100% { opacity:1; transform:translate3d(-50%, 0, 0) scale(1); }
}
@keyframes community-fab-symbol {
  from { opacity:0; transform:translate3d(0, 3px, 0) scale(.72); }
  to { opacity:1; transform:translate3d(0, 0, 0) scale(1); }
}
.bar__lens-track {
  position: absolute;
  z-index: 0;
  top: 5px;
  bottom: 5px;
  left: 5px;
  width: calc((100% - 10px) / 4);
  pointer-events: none;
  transform: translate3d(var(--lens-position), 0, 0) scaleX(1);
  transform-origin: var(--lens-origin) center;
}
.bar__lens {
  position: absolute;
  inset: 1px 3px;
  border: 1px solid #755186;
  border-top-color: #77538a;
  border-bottom-color: #694579;
  border-radius: 35px;
  /* The bar supplies the filtered backdrop. The rim lighting simulates edge depth. */
  background: #6d4782;
  background-image:
    radial-gradient(ellipse at 28% 0%, rgba(255,255,255,.1), transparent 75%),
    linear-gradient(164deg, #79558f, #624076);
  background-clip: padding-box;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.3), inset 0 -1px 1px rgba(41,19,57,.18), 0 1px 2px rgba(40,25,53,.12);
}
@media (prefers-reduced-motion: no-preference) {
  .bar__lens-track--moving { animation: bar-lens-glide 280ms; }
  /* Keep readable ordinary ink until the moving lens reaches its destination.
     The same revision restarts the ink on cached tabs; static defaults are white. */
  .bar__item--moving.is-active .bar__icon-selected { animation: bar-selected-icon 280ms linear; }
  .bar__item--moving.is-active .bar__label { animation: bar-selected-ink 280ms steps(1, end); }
}
@keyframes bar-selected-icon {
  0%, 71% { opacity: 0; }
  92%, 100% { opacity: 1; }
}
@keyframes bar-selected-ink {
  0% { color: #554b5b; }
  71%, 100% { color: #fff; }
}
@keyframes bar-lens-glide {
  0% {
    transform: translate3d(calc(var(--lens-position) + var(--lens-offset)), 0, 0) scaleX(1);
    animation-timing-function: cubic-bezier(.22,.49,.58,.8);
  }
  40% {
    transform: translate3d(calc(var(--lens-position) + var(--lens-offset) * .32), 0, 0) scaleX(1.22);
    animation-timing-function: cubic-bezier(.22,.17,.35,1);
  }
  71% {
    transform: translate3d(var(--lens-position), 0, 0) scaleX(.94);
    animation-timing-function: ease-in-out;
  }
  86% {
    transform: translate3d(var(--lens-position), 0, 0) scaleX(1.035);
    animation-timing-function: ease-out;
  }
  100% { transform: translate3d(var(--lens-position), 0, 0) scaleX(1); }
}
.bar__item--pressed .bar__icon-frame { transform:scale(.9); }
.bar__icon-frame { position:relative; width:25px; height:25px; flex:none; transition:transform 120ms ease-out; }
.bar__icon-selected { position:absolute; inset:0; width:25px; height:25px; opacity:1; pointer-events:none; }
.bar__item { position:relative; z-index:1; flex:1; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:4px; height:60px; min-height:60px; margin:0; padding:0; border:0; border-radius:35px; color:#554b5b; background:transparent; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif; font-size:13px; font-weight:400; line-height:1; }
.bar__item::after { border:0; }
.bar__icon { width:25px; height:25px; }
.bar__item.is-active { color:#fff; font-weight:600; }
.bar__item.control--disabled { color:#746979; background:transparent; opacity:.58; }
.bar__item.is-active.control--disabled { color:#fff; opacity:1; }
.chrome--reduced-motion,
.chrome--reduced-motion .community-fab,
.chrome--reduced-motion .bar__icon-frame { transition:none; }
.chrome--reduced-motion .bar__item--pressed .bar__icon-frame { transform:none; }
.chrome--reduced-motion .community-fab,
.chrome--reduced-motion .community-fab__icon,
.chrome--reduced-motion .bar__lens-track { animation:none; }

@media (prefers-reduced-motion: reduce) {
  .chrome,
  .community-fab,
  .bar__icon-frame { transition:none; }
  .bar__item--pressed .bar__icon-frame { transform:none; }
  .community-fab,
  .community-fab--visible .community-fab__icon { animation:none; }
}

.chrome--reduced-motion .bar {
  background: var(--bar-solid-background);
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}
.chrome--reduced-motion .bar__lens { background: #6d4782; }
@media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
  .bar {
    background: var(--bar-solid-background);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .bar__lens { background: #6d4782; }
}
@media (prefers-contrast: more) {
  .bar { border-color: #746979; box-shadow:none; }
  .bar__lens { border-color:#56306f; box-shadow:none; }
}
