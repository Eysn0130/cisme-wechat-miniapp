.chrome {
  position: fixed;
  z-index: 60;
  right: 0;
  bottom: 0;
  left: 0;
  height: calc(var(--cisme-safe-bottom, env(safe-area-inset-bottom)) + 142px);
  opacity: 1;
  pointer-events: none;
  transform: translate3d(0, 0, 0);
  transition: transform 280ms cubic-bezier(.22, 1, .36, 1), opacity 180ms ease-out;
}
.chrome--hidden {
  opacity: .08;
  transform: translate3d(0, calc(100% + 12px), 0);
}
.bar {
  position: absolute;
  right: 11px;
  bottom: calc(var(--cisme-safe-bottom, env(safe-area-inset-bottom)) + 1px);
  left: 11px;
  display: flex;
  align-items: center;
  height: 70px;
  padding: 5px;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(255,255,255,.88);
  border-radius: 42px;
  background: rgba(246,242,248,.76);
  -webkit-backdrop-filter: blur(24rpx) saturate(145%);
  backdrop-filter: blur(24rpx) saturate(145%);
  box-shadow: inset 0 3rpx 18rpx rgba(255,255,255,.8), 0 20rpx 44rpx rgba(41,24,55,.19), 0 1rpx 0 rgba(92,65,108,.1);
  pointer-events: auto;
}
.community-fab {
  position: absolute;
  z-index: 2;
  left: 50%;
  bottom: calc(var(--cisme-safe-bottom, env(safe-area-inset-bottom)) + 50px);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62px;
  height: 62px;
  min-height: 62px;
  margin: 0;
  padding: 0;
  overflow: visible;
  border: 1rpx solid rgba(255,255,255,.94);
  border-radius: 50%;
  background: radial-gradient(circle at 34% 20%, rgba(222,198,240,.98), rgba(107,64,139,.95) 46%, #48275f 84%);
  box-shadow: inset 0 5rpx 15rpx rgba(255,255,255,.78), inset 0 -16rpx 24rpx rgba(35,14,51,.34), 0 16rpx 38rpx rgba(53,31,72,.3), 0 0 0 8rpx rgba(255,255,255,.46);
  opacity: 0;
  pointer-events: none;
  transform: translate3d(-50%, 18px, 0) scale(.58);
  transform-origin: 50% 100%;
  transition: transform 360ms cubic-bezier(.2, 1.28, .32, 1), opacity 180ms ease-out;
}
.community-fab::after { border: 0; }
.community-fab--visible { opacity: 1; pointer-events: auto; transform: translate3d(-50%, 0, 0) scale(1); }
.community-fab--visible:active { transform: translate3d(-50%, 1px, 0) scale(.94); }
.community-fab.control--disabled { opacity: .48; pointer-events: none; }
.community-fab__halo { position:absolute; inset:-9rpx; border:1rpx solid rgba(255,255,255,.5); border-radius:50%; }
.community-fab__icon { position:relative; z-index:1; width:31px; height:31px; }
.bar__lens {
  position: absolute;
  z-index: 0;
  top: 5px;
  left: 5px;
  width: calc((100% - 10px) / 4);
  height: calc(100% - 10px);
  overflow: hidden;
  border: 1rpx solid rgba(255,255,255,.9);
  border-radius: 35px;
  background: rgba(221,207,234,.4);
  box-shadow: inset 0 2rpx 16rpx rgba(255,255,255,.9), inset 0 -14rpx 22rpx rgba(80,48,104,.1), 0 6rpx 18rpx rgba(55,32,72,.1);
  transition:none;
}
.bar--settling .bar__lens { transition:transform .26s cubic-bezier(.22,1,.36,1); }
.bar__item--pressed .bar__icon { transform:scale(.9); }
.bar__icon { transition:transform 120ms ease-out; }
.bar--1 .bar__lens { transform: translateX(100%); }
.bar--2 .bar__lens { transform: translateX(200%); }
.bar--3 .bar__lens { transform: translateX(300%); }
.bar__shine { position:absolute; top:3px; left:14%; width:72%; height:17px; border-radius:50%; background:rgba(255,255,255,.6); filter:blur(16rpx); }
.bar__item { position:relative; z-index:1; flex:1; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:4px; height:60px; min-height:60px; margin:0; padding:0; border:0; border-radius:35px; color:#655e68; background:transparent; font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif; font-size:13px; font-weight:400; line-height:1; }
.bar__item::after { border:0; }
.bar__icon { width:25px; height:25px; }
.bar__item.is-active { color:#3f2358; }
.bar__item.control--disabled { color:#746979; background:transparent; opacity:.58; }
.chrome--reduced-motion,
.chrome--reduced-motion .community-fab,
.bar--reduced-motion .bar__lens, .bar--reduced-motion .bar__icon { transition:none; }
.bar--reduced-motion .bar__item--pressed .bar__icon { transform:none; }

@media (prefers-reduced-motion: reduce) {
  .chrome,
  .community-fab,
  .bar__lens { transition:none; }
}
