<template name="recorded-commands">
  <view class="state" aria-live="polite">
    <view>历史处理记录</view>
    <view>记录为空不代表操作失败，付款、退款或到账情况请核对订单和收款账户。</view>
    <view wx:for="{{recordedGroups}}" wx:key="kind" wx:for-item="group">
      <view>{{group.title}}</view>
      <view wx:for="{{group.rows}}" wx:key="id" wx:for-item="fact"><view>{{fact.createdLabel}} · {{fact.label}}</view><text selectable="{{true}}">记录编号 {{fact.id}}</text></view>
      <text wx:if="{{group.loading}}">正在核对…</text>
      <text wx:elif="{{group.error}}">{{group.error}}</text>
      <text wx:elif="{{!group.rows.length}}">暂无记录。</text>
      <button wx:if="{{group.nextCursor}}" class="text-button" data-kind="{{group.kind}}" bindtap="moreRecordedCommands" disabled="{{group.loading}}">继续查看{{group.title}}</button>
    </view>
    <button class="text-button" bindtap="refreshRecordedCommands">刷新历史记录</button>
  </view>
</template>
