@import './action-hierarchy.wxss';
@import './section-tabs-layout.wxss';
@import './read-loading.wxss';
.officer-root{min-height:100vh;background:#f6f1f8;color:var(--cisme-ink)}.officer-page{max-width:540px;margin:0 auto;padding-bottom:calc(72rpx + env(safe-area-inset-bottom))}.officer-intro{padding:36rpx 0 42rpx}.officer-overline{font-size:11px;letter-spacing:3rpx;color:#6e5a7c}.officer-heading{display:block;font-size:30px;line-height:1.45;font-weight:500;letter-spacing:1rpx;margin:28rpx 0}.officer-heading-line{display:block}.officer-copy{display:block;font-size:14px;line-height:1.8;color:var(--cisme-muted);margin:20rpx 0}.officer-between{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.officer-status{font-size:12px;color:var(--cisme-plum)}.officer-code{font-size:13px;letter-spacing:2rpx;font-variant-numeric:tabular-nums}.officer-metrics{display:flex;justify-content:space-between;padding:32rpx 0 40rpx;border-top:1rpx solid #e4dbe9}.officer-metrics>view{display:flex;flex-direction:column;gap:14rpx;font-size:11px;color:var(--cisme-muted)}.officer-money{font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:23px;line-height:1.1;letter-spacing:-.5px;font-weight:500;color:var(--cisme-plum);font-variant-numeric:tabular-nums}.officer-section{padding:36rpx 0 10rpx;font-size:15px;font-weight:500}.officer-muted{color:var(--cisme-muted);font-size:12px;line-height:1.6}.officer-strong{font-size:15px;font-weight:500;line-height:1.6}.officer-product{display:flex;align-items:center;gap:24rpx;text-align:left;width:100%;padding:28rpx 0;background:transparent;border-radius:0;border-bottom:1rpx solid #e6deec}.officer-product::after,.officer-record::after{border:0}.officer-product>image{width:116rpx;height:130rpx;border-radius:20rpx;background:#eee5f3;flex-shrink:0}.officer-product>view{display:flex;flex-direction:column;gap:14rpx;flex:1;min-width:0}.officer-link{font-size:13px;line-height:1.5;color:#593377;flex-shrink:0}.officer-record{display:block;padding:32rpx 0;background:transparent;text-align:left;width:100%;border-radius:0;border-bottom:1rpx solid #e4dbe9}.officer-record>.officer-between+.officer-between{margin-top:16rpx}.officer-record .officer-strong{flex:1;min-width:0}.officer-note{display:block;margin:24rpx 0;color:var(--cisme-muted);font-size:12px;line-height:1.8}.officer-more{display:block;margin:20rpx auto;min-height:44px}.officer-empty{padding:80rpx 0;text-align:center;font-size:14px;color:var(--cisme-muted)}.officer-error{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:13px;line-height:1.6;color:#8b335b;margin:20rpx 0;white-space:pre-wrap}.officer-warning,.officer-recovery{padding:22rpx 26rpx;background:#f0e5ef;border-radius:20rpx;font-size:13px;line-height:1.6;margin-bottom:24rpx}.officer-actions{display:flex;gap:24rpx;flex-wrap:wrap}.officer-mask{position:fixed;z-index:100;inset:0;background:rgba(32,19,44,.28);display:flex;align-items:flex-end}.officer-sheet{width:100%;max-height:86vh;border-radius:40rpx 40rpx 0 0;background:#fcf9fd;padding:34rpx 34rpx calc(32rpx + env(safe-area-inset-bottom));box-sizing:border-box;animation:officer-sheet-in 220ms cubic-bezier(.22,.68,.2,1)}.officer-sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:26rpx;font-weight:500;font-size:18px}.officer-sheet-scroll{max-height:65vh}.officer-field{display:block;font-size:14px;margin:18rpx 0 34rpx}.officer-field>text{display:block;margin-bottom:18rpx}.officer-field input,.officer-field textarea{box-sizing:border-box;width:100%;min-height:48px;padding:18rpx 20rpx;background:#f1eaf5;border-radius:16rpx;font-size:15px;line-height:1.6}.officer-field textarea{height:168rpx}.officer-qr{display:block;width:430rpx;height:430rpx;margin:30rpx auto;max-width:100%}.officer-detail-row{display:flex;justify-content:space-between;gap:24rpx;padding:22rpx 0;font-size:14px;border-bottom:1rpx solid #e9e2ed;font-variant-numeric:tabular-nums}.officer-referrer{padding:30rpx 0}.officer-referrer>text{display:block;line-height:1.8}.officer-intro .primary{margin-top:34rpx}.officer-page .primary,.officer-sheet .primary{min-height:48px}.officer-root .action-text{border:0;background:transparent;min-height:44px}.officer-root .action-text::after{border:0}@keyframes officer-sheet-in{from{opacity:0;transform:translateY(36rpx)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.officer-sheet{animation:none}}

.officer-history-record{padding:24rpx 0;border-bottom:1rpx solid #e6deec}.officer-history-record>.officer-muted{display:block;margin-top:10rpx}.officer-history-record .officer-note{margin:12rpx 0}.officer-reference{display:block;color:var(--cisme-muted);font-size:11px;line-height:1.5;word-break:break-all;margin-top:12rpx}
