.support-chat-layout {
  --cisme-chat-safe-bottom: env(safe-area-inset-bottom);
  position: fixed;
  top: var(--cisme-topbar-height, calc(env(safe-area-inset-top) + 44px));
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
}

.support-chat-layout--with-keyboard {
  --cisme-chat-safe-bottom: 0px;
}

.support-chat-history {
  position: relative;
  flex: 1;
  min-height: 0;
}

.support-chat-tools {
  display: flex;
  justify-content: flex-end;
  align-items: flex-end;
  min-height: 104rpx;
  padding: 0 10rpx 10rpx;
}

.support-chat-quote {
  display: block;
  min-width: 0;
  max-width: 100%;
  margin-bottom: 8rpx;
  padding: 6rpx 12rpx;
  overflow: hidden;
  border-radius: 10rpx;
  color: var(--cisme-muted);
  background: #efedf0;
  font-size: var(--cisme-text-small);
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}
