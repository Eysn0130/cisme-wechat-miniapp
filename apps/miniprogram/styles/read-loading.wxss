page{--cisme-load-bone:#eee7f2;--cisme-load-sweep:1500ms;--cisme-load-progress:600ms;--cisme-load-arrival:200ms;--cisme-load-spin:800ms;--cisme-load-ease:cubic-bezier(.33,1,.68,1)}
.page-read-loading{position:fixed;top:calc(var(--cisme-topbar-height,88px) + 24px);left:0;right:0;display:flex;justify-content:center;pointer-events:none}
.page-read-loading__indicator{width:18px;height:18px;border:2px solid var(--cisme-line,rgba(78,47,91,.12));border-top-color:var(--cisme-plum,#56306f);border-radius:50%;animation:page-read-spin var(--cisme-load-spin,800ms) linear infinite}
@keyframes page-read-spin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.page-read-loading__indicator{animation:none}}

.loading-bone{position:relative;overflow:hidden;background:var(--cisme-load-bone,#eee7f2)}
.loading-bone::after{position:absolute;inset:0;content:"";pointer-events:none;background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent);transform:translateX(-100%);animation:cisme-loading-sweep var(--cisme-load-sweep,1500ms) linear infinite}
@keyframes cisme-loading-sweep{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
.loading--still .loading-bone::after{display:none}.loading--still .page-read-loading__indicator{animation:none}
@media(prefers-reduced-motion:reduce){.loading-bone::after{display:none}}
