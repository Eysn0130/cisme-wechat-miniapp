APP_ENV=development
PORT=3100
DATABASE_URL=postgres://cisme:cisme-dev-only@127.0.0.1:55432/cisme
ALLOW_DEV_ADAPTERS=true
DEV_CLOCK=2026-08-07T12:00:00+08:00
WECHAT_APP_ID=wx4eac2d4fb11d299b
WECHAT_APP_SECRET=
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_PROFILE=
S3_ENDPOINT=http://127.0.0.1:58333
S3_REGION=us-east-1
S3_BUCKET=cisme-dev
# Production account closure requires a standard private COS bucket, distinct
# from any Lighthouse COS media bucket (lhcos-xxxxx-APPID).
# PRIVACY_SUPPRESSION_BUCKET=cisme-privacy-APPID
S3_ACCESS_KEY_ID=cisme-dev
S3_SECRET_ACCESS_KEY=cisme-dev-secret-change-me
UPLOAD_TOKEN_SECRET=cisme-dev-upload-secret-change-me
APP_SESSION_SECRET=cisme-dev-session-secret-change-me
# Legacy ADMIN_API_TOKEN is ignored. Operator identity must be a signed session.
SELECTED_TRANSACTION_PROFILE=
POINTS_REDEMPTION_ENABLED=false
POINTS_REDEMPTION_APPROVAL_ID=
POINTS_REDEMPTION_APPROVAL_EXPIRES_AT=
POINTS_PREPARE_READY=false
POINTS_COMMIT_READY=false
POINTS_RELEASE_READY=false
POINTS_REFUND_ALLOCATION_READY=false
UGC_GO_LIVE_GATE=false
COMMERCE_ORDER_FLOW_ENABLED=false
COMMERCE_QUOTE_TTL_MINUTES=10
COMMERCE_PENDING_ORDER_TTL_MINUTES=30
POINTS_RULES_ENABLED=false
POINTS_RULE_IDS=
POINTS_FINANCE_APPROVAL_ID=
POINTS_FINANCE_APPROVAL_EXPIRES_AT=
POINTS_MAKER_CHECKER_READY=false
POINTS_HOLD_DAYS=0
POINTS_EXPIRY_DAYS=0
CARE_PAUSE_POLICY_VERSION=
CARE_PAUSE_MAX_DAYS=0
CARE_PAUSE_REASON_CODES=
UGC_PROVENANCE_READY=false
UGC_CONTENT_SAFETY_READY=false
UGC_MODERATION_READY=false
UGC_LEGAL_APPROVAL_ID=
BUY_VENDOR_PROFILE_ID=
BUY_SIGNED_WEBHOOK_READY=false
BUY_ACTIVE_PULL_READY=false
BUY_REFUND_READY=false
BUY_SHIPPING_READY=false
BUY_EXPORT_READY=false
BUY_SANDBOX_RECONCILE_READY=false
MAKE_APPROVAL_ID=
MAKE_PAYMENT_READY=false
MAKE_REFUND_READY=false
MAKE_SHIPPING_READY=false
MAKE_EXPORT_READY=false
MAKE_SANDBOX_RECONCILE_READY=false
ADMIN_BOOTSTRAP_PRINCIPAL=admin-reviewer

# Separate 32-byte hex keys for encrypted phone storage and HMAC lookup; server only.
CONTACT_ENCRYPTION_KEY=
CONTACT_HASH_KEY=
CONTACT_KEY_VERSION=v1

# Separate 32-byte hex key for short-lived, private member data copies.
PRIVACY_FORMAL_EXPORT_KEY=

# Tencent COS uses the same S3_* credential/bucket fields with its native SDK.
# OBJECT_STORAGE_DRIVER=cos_gateway
# OBJECT_STORAGE_PROFILE=tencent-cos-shanghai-private
# S3_REGION=ap-shanghai
# S3_BUCKET=your-private-bucket-appid
# Direct PUT removes API/CloudBase payload relay. Keep false until the exact COS
# upload domain is in the WeChat request-domain allowlist and CORS is verified.
COS_DIRECT_UPLOAD_ENABLED=false

# Every instance must stay within the explicitly budgeted global connection cap.
DATABASE_POOL_MAX=10
SERVICE_INSTANCE_COUNT=1
DATABASE_GLOBAL_CONNECTION_BUDGET=40
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=2500
DATABASE_LOCK_TIMEOUT_MS=750
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=5000
DATABASE_TRANSACTION_DEADLINE_MS=4000
DATABASE_TRANSACTION_MAX_ATTEMPTS=6
# Receive deadline is distinct from cooperative business processing budget.
API_RECEIVE_TIMEOUT_MS=30000
API_ROUTE_DEADLINE_MS=8000
LOG_LEVEL=info

# Enable only after WeChat capability eligibility and phone privacy declaration are verified.
# Optional phone binding stays closed while regular WeChat membership remains available.
WECHAT_PHONE_BINDING_ENABLED=false

# Optional private-CA mutual TLS for the Shanghai database; all three are required together.
DATABASE_TLS_CA_BASE64=
DATABASE_TLS_CERT_BASE64=
DATABASE_TLS_KEY_BASE64=
