{
  "name": "cisme-wechat-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/admin",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.14 <25"
  },
  "scripts": {
    "build": "npm run typecheck && tsup services/api/src/server.ts services/worker/src/main.ts --format esm --splitting --out-dir dist/services && vite build --config apps/admin/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/miniprogram/tsconfig.json",
    "dev:api": "tsx services/api/src/server.ts",
    "dev:worker": "tsx services/worker/src/main.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:rollback": "tsx scripts/migrate.ts down",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset:test": "tsx scripts/reset-test-db.ts",
    "test": "vitest run tests/unit --exclude 'dist/**'",
    "test:integration": "vitest run tests/integration --exclude 'dist/**' --pool=forks --maxWorkers=1",
    "test:all": "npm run test && npm run test:integration",
    "test:storage-contract": "vitest run tests/integration/storage-contract.test.ts --pool=forks --maxWorkers=1",
    "perf:smoke": "tsx scripts/performance-smoke.ts",
    "perf:capacity": "tsx scripts/capacity-benchmark.ts",
    "perf:worker-capacity": "tsx scripts/worker-capacity-benchmark.ts",
    "lint:contracts": "tsx scripts/validate-contracts.ts",
    "miniprogram:package-gate": "tsx scripts/check-miniprogram-package.ts",
    "miniprogram:route-audit": "tsx scripts/audit-native-routes.ts",
    "design:qa:status": "tsx scripts/check-design-qa.ts",
    "design:qa:gate": "tsx scripts/check-design-qa.ts --require-passed",
    "visual:review-pack": "tsx scripts/generate-visual-review-pack.ts",
    "visual:capture:healthy": "tsx scripts/capture-miniprogram-review.ts",
    "miniprogram:acceptance": "tsx scripts/miniprogram-acceptance.ts --reset",
    "package:commercial-delivery": "node scripts/package-commercial-delivery.mjs",
    "sbom": "cyclonedx-npm --output-file docs/evidence/sbom.cdx.json --output-format JSON --spec-version 1.6",
    "license:report": "tsx scripts/license-report.ts",
    "assets:sync": "tsx scripts/sync-prototype-assets.ts && tsx scripts/sync-miniprogram-icons.ts",
    "wechat:preflight:local": "tsx scripts/wechat-release.ts preflight local",
    "wechat:preflight:preview": "tsx scripts/wechat-release.ts preflight preview",
    "wechat:preflight:trial": "tsx scripts/wechat-release.ts preflight trial",
    "wechat:device-debug:configure": "tsx scripts/configure-wechat-device-debug.ts",
    "wechat:preview": "tsx scripts/wechat-release.ts preview",
    "wechat:upload": "tsx scripts/wechat-release.ts upload",
    "wechat:ci:isolated": "tsx scripts/miniprogram-ci.ts",
    "backup": "bash scripts/backup.sh",
    "restore:verify": "bash scripts/restore-verify.sh",
    "authority:manage": "tsx scripts/authority-grants.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1110.0",
    "@aws-sdk/s3-presigned-post": "3.1110.0",
    "@fastify/cors": "11.2.0",
    "@fastify/multipart": "9.3.0",
    "@fastify/rate-limit": "11.2.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "fastify": "5.12.3",
    "jpeg-js": "^0.4.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "js-yaml": "^4.3.2",
    "jsdom": "^27.0.0",
    "miniprogram-api-typings": "5.2.3",
    "miniprogram-simulate": "^1.6.2",
    "tsup": "8.5.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.1.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "miniprogram-simulate": {
      "less": "4.9.1",
      "postcss": "8.5.28"
    }
  }
}
