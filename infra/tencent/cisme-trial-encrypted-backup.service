[Unit]
Description=CISME isolated trial database-only encrypted off-server backup
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
ConditionPathExists=/etc/cisme-trial-backup/backup-aes256.key
ConditionPathExists=/etc/cisme-trial-backup/cos.json

[Service]
Type=oneshot
User=cisme-trial
Group=cisme-trial
UMask=0077
ExecStart=/opt/cisme-maintenance/bin/python /usr/local/lib/cisme/cisme-trial-encrypted-backup.py backup
TimeoutStartSec=1800
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/cisme-trial-encrypted
InaccessiblePaths=/opt/cisme /etc/cisme /var/lib/cisme /var/backups/cisme /var/backups/cisme-encrypted /var/backups/cisme-predeploy
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=32
